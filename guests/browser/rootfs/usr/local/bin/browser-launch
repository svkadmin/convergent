#!/bin/sh
# ARCHITECTURE 3.5
# Host supplies filtered socket inodes accessible to guest UID 1000.
# Wayland: deny capture, input injection, other surfaces and privileged globals.
# Pulse: playback only; no recording or monitor capture.
# Host waits for exit, stops/reaps instances, closes portal rules/Grafana.
set -eu
umask 077
die() { echo "browser-launch: $*" >&2; exit 1; }
[ "$(id -u)" = 1000 ] || die "run as browser (UID 1000)"
[ -f /run/browser-ready ] || die "role setup incomplete"
role=$(cat /run/browser-role)
case $role in def|tmp|int) ;; *) die "invalid role" ;; esac
case $role in
    int)
        [ "$#" = 0 ] || die "int accepts no URL arguments"
        set -- http://100.80.2.10:3000/ ;;
    *)
        for url do
            case $url in http://*|https://*) ;; *) die "expected HTTP(S) URL" ;; esac
        done ;;
esac
if [ -f /run/browser-portal ]; then
    [ "$role" = tmp ] && [ "$#" = 1 ] || die "portal requires a tmp browser and URL"
    set -- --disable-gpu "$@"
fi
[ -S /mnt/browser/wayland-0 ] || die "missing restricted Wayland socket"
[ -S /mnt/browser/pipewire-0 ] || die "missing restricted Pulse socket"
cd /home/browser
# The host allows one launcher per role; a lock left by a renamed or killed container names another host.
rm -f profile/SingletonLock profile/SingletonSocket profile/SingletonCookie

exec env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/browser USER=browser LOGNAME=browser \
    LANG=C.UTF-8 XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=/mnt/browser/wayland-0 \
    PULSE_SERVER=unix:/mnt/browser/pipewire-0 GTK_USE_PORTAL=0 NO_AT_BRIDGE=1 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent \
    LIBVA_DRIVER_NAME=iHD \
    /usr/bin/chromium --ozone-platform=wayland --class="convergent-$role" \
    --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL \
    --user-data-dir=/home/browser/profile --password-store=basic --no-first-run \
    --disable-background-networking --disable-component-update --disable-breakpad "$@"
