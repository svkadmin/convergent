#!/bin/sh
set -eu
umask 022
die() { echo "browser-setup: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "root required"
# The host narrows an Incus UI session to the Incus origin before its launcher runs.
if [ "$#" = 1 ] && [ "$1" = incus-ui ]; then
    [ "$(cat /run/browser-role)" = int ] && [ -f /run/incus-ui-ready ] || die "not a prepared int container"
    jq -e '.incus | select(type == "object")' /usr/share/convergent-browser/int/policies.json \
        >/etc/chromium/policies/managed/browser.json.new
    mv /etc/chromium/policies/managed/browser.json.new /etc/chromium/policies/managed/browser.json
    exit 0
fi
[ "$#" = 0 ] || die "usage: browser-setup [incus-ui]"
role=$BROWSER_ROLE
case ${BROWSER_PORTAL:-0}:$role in
    0:*) ;;
    1:tmp) ;;
    *) die "portal mode requires tmp" ;;
esac
case $role in
    def) address=100.80.3.10; prefix=24; gateway=100.80.3.1; resolver=$gateway ;;
    tmp)
        address=$BROWSER_IPV4
        prefix=24; gateway=100.80.3.1; resolver=$gateway
        if [ "${BROWSER_PORTAL:-0}" = 1 ]; then
            [ "$address" = 100.80.3.11 ] || die "portal requires 100.80.3.11"
            resolver=100.80.0.10
        else
            case $address in 100.80.3.[2-9][0-9]) ;; *) die "tmp requires 100.80.3.20..99" ;; esac
        fi ;;
    int) address=100.80.4.10; prefix=28; gateway=100.80.4.1; resolver=$gateway ;;
    *) die "BROWSER_ROLE must be def, tmp or int" ;;
esac
rm -f /run/browser-ready /run/browser-portal /run/incus-ui-ready
mode=normal
[ "$role" != int ] || mode=grafana
if [ "${BROWSER_PORTAL:-0}" = 1 ]; then
    mode=portal
    touch /run/browser-portal
fi
jq -e --arg role "$role" --arg mode "$mode" \
    'if $role == "def" then . else .[$mode] end | select(type == "object")' \
    "/usr/share/convergent-browser/$role/policies.json" >/etc/chromium/policies/managed/browser.json
printf 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet static\n    address %s/%s\n    gateway %s\n' \
    "$address" "$prefix" "$gateway" >/etc/network/interfaces
printf 'nameserver %s\noptions timeout:2 attempts:2\n' "$resolver" >/etc/resolv.conf
downloads=/home/browser/Downloads/$role
for path in /home/browser /home/browser/profile /home/browser/Downloads "$downloads"; do
    [ ! -L "$path" ] && { [ ! -e "$path" ] || [ -d "$path" ]; } || die "invalid state directory: $path"
done
mkdir -p /run/user/1000 /home/browser
chown 1000:1000 /run/user/1000 /home/browser
chmod 700 /run/user/1000 /home/browser
for path in /home/browser/profile /home/browser/Downloads "$downloads"; do
    if [ ! -d "$path" ]; then
        mkdir -m 700 "$path"
    fi
    chown 1000:1000 "$path"
done
# Mask both persistent Chromium NSS locations for every int session.
if [ "$role" = int ]; then
    for path in /home/browser/.pki /home/browser/.pki/nssdb /home/browser/.local \
        /home/browser/.local/share /home/browser/.local/share/pki /home/browser/.local/share/pki/nssdb; do
        [ ! -L "$path" ] && { [ ! -e "$path" ] || [ -d "$path" ]; } || die "invalid NSS directory: $path"
        mkdir -p "$path"
        chown 1000:1000 "$path"
        chmod 700 "$path"
    done
    # Per boot, so per session: also an Incus session's Chromium profile.
    mkdir -p /run/incus-ui
    mount -t tmpfs -o size=256m,mode=0700,nosuid,nodev,noexec tmpfs /run/incus-ui
    chown 1000:1000 /run/incus-ui
    mkdir -m 700 /run/incus-ui/nssdb
    chown 1000:1000 /run/incus-ui/nssdb
    certutil -N -d sql:/run/incus-ui/nssdb --empty-password
    chown 1000:1000 /run/incus-ui/nssdb/*
    chmod 600 /run/incus-ui/nssdb/*
    mount -o bind /run/incus-ui/nssdb /home/browser/.pki/nssdb
    mount -o bind /run/incus-ui/nssdb /home/browser/.local/share/pki/nssdb
    touch /run/incus-ui-ready
fi
printf '%s\n' "$role" >/run/browser-role
touch /run/browser-ready
