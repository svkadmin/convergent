{
  "normal": {
    "DownloadDirectory": "/home/browser/Downloads/tmp",
    "ExtensionSettings": {"*": {"installation_mode": "blocked"}},
    "IncognitoModeAvailability": 2
  },
  "portal": {
    "DownloadDirectory": "/home/browser/Downloads/tmp",
    "RestoreOnStartupURLs": ["http://neverssl.com/"],
