    "ExtensionSettings": {"*": {"installation_mode": "blocked"}},
    "AudioCaptureAllowed": false, "VideoCaptureAllowed": false,
    "DefaultSearchProviderEnabled": false,
    "HttpsOnlyMode": "disallowed",
    "HttpsUpgradesEnabled": false
  }
}
