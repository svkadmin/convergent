#!/bin/sh
# ARCHITECTURE 6
# guests/fw/build <output-dir>
# Requires KVM, OVMF and loopback port 80.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/pins"

die() { echo "build: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is needed"; }
console_value() {
	awk -v tag="$1" '$1 == tag { sub(/\r$/, ""); sub(/^[^ ]+ /, ""); print; n++ } END { if (n != 1) exit 1 }' "$2"
}

out=${1:-}
[ -n "$out" ] || die "usage: build <output-dir>"
for t in qemu-system-x86_64 qemu-img curl python3 tar sha256sum awk timeout; do need "$t"; done
signify=$(command -v signify || command -v signify-openbsd || true)
[ -n "$signify" ] || die "signify is needed"

# UEFI firmware.
ovmf_code=${OVMF_CODE:-}
ovmf_vars=${OVMF_VARS:-}
for d in /usr/share/edk2/OvmfX64 /usr/share/edk2/ovmf /usr/share/OVMF /usr/share/edk2-ovmf /usr/share/qemu; do
	for f in OVMF_CODE.fd OVMF_CODE_4M.fd; do
		[ -n "$ovmf_code" ] || { [ -f "$d/$f" ] && ovmf_code=$d/$f; } || true
	done
	for f in OVMF_VARS.fd OVMF_VARS_4M.fd; do
		[ -n "$ovmf_vars" ] || { [ -f "$d/$f" ] && ovmf_vars=$d/$f; } || true
	done
done
{ [ -f "$ovmf_code" ] && [ -f "$ovmf_vars" ]; } || die "OVMF firmware not found; set OVMF_CODE and OVMF_VARS"

ver=$OPENBSD_VERSION
v=$(printf '%s' "$ver" | tr -d .)
base=$OPENBSD_MIRROR/$ver/amd64
nodes="fw1 fw2"
domain=$(sed -n 's/^DOMAIN=//p' "$here/site/etc/convergent/net")
[ -n "$domain" ] || die "no DOMAIN in site/etc/convergent/net"

mkdir -p "$out"
work=$(mktemp -d)
www=$work/www
tftp=$work/tftp
dl=$work/dl
mkdir -p "$www/sets" "$www/pkg" "$tftp/etc" "$dl"

httppid=
qemupid=
cleanup() {
	[ -z "$qemupid" ] || kill "$qemupid" 2>/dev/null || true
	[ -z "$httppid" ] || kill "$httppid" 2>/dev/null || true
	rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

# Verify sets with the pinned release key before serving them.
echo "build: fetching OpenBSD $ver"
curl -fsS --proto =https --tlsv1.2 -o "$dl/key.pub" "$OPENBSD_KEY_MIRROR/$ver/openbsd-$v-base.pub"
seen=$(sha256sum "$dl/key.pub" | awk '{print $1}')
[ "$seen" = "${OPENBSD_KEY_SHA256:-}" ] ||
	die "openbsd-$v-base.pub has SHA256 $seen, pinned: '${OPENBSD_KEY_SHA256:-}'; check it, then set OPENBSD_KEY_SHA256 in pins"
files="BUILDINFO bsd bsd.mp bsd.rd base$v.tgz BOOTX64.EFI"
for f in SHA256 SHA256.sig $files; do
	curl -fsS --proto =https --tlsv1.2 -o "$dl/$f" "$base/$f"
done
(cd "$dl" && "$signify" -C -q -p key.pub -x SHA256.sig $files) || die "signify: the downloaded files do not verify"
echo "build: sets verified"

# UEFI netboot with serial console.
cp "$dl/BOOTX64.EFI" "$tftp/auto_install"
cp "$dl/bsd.rd" "$tftp/bsd.rd"
cat >"$tftp/etc/boot.conf" <<'BOOTCONF'
stty com0 115200
set tty com0
boot tftp:/bsd.rd
BOOTCONF

cp "$dl/SHA256" "$dl/SHA256.sig" "$dl/BUILDINFO" "$dl/bsd" "$dl/bsd.mp" "$dl/base$v.tgz" "$www/sets/"

# Fetch release packages and dependencies; pkg_add verifies signatures.
pkgbase=$OPENBSD_MIRROR/$ver/packages/amd64
curl -fsS --proto =https --tlsv1.2 -o "$dl/pkg-index.txt" "$pkgbase/index.txt"
pkgnames=
fetchpkg() {
	[ ! -f "$www/pkg/$1" ] || return 0
	curl -fsS --proto =https --tlsv1.2 -o "$www/pkg/$1" "$pkgbase/$1"
	tar -xzOf "$www/pkg/$1" +CONTENTS | awk -F: '/^@depend/ { print $3 ".tgz" }' |
		while read -r dep; do fetchpkg "$dep"; done
}
for p in $FW_PACKAGES; do
	f=$(awk -v p="$p" '{ n = $NF } n ~ ("^" p "-[0-9][^/]*\\.tgz$") { print n }' "$dl/pkg-index.txt" | sort | tail -n 1)
	[ -n "$f" ] || die "package $p not found in $pkgbase"
	fetchpkg "$f"
	pkgnames="$pkgnames ${f%.tgz}"
done

# 3. The site set: this tree, plus what is made fresh for this build.
site=$work/site
cp -R "$here/site" "$site"
find "$site" -type d -exec chmod 755 {} +
find "$site" -type f -exec chmod 644 {} +
chmod 755 "$site/install.site" "$site/usr/local/libexec/convergent/fw-facts"
cat >"$site/etc/convergent/build" <<BUILDVARS
PKG_URL=http://10.0.2.2/pkg
PKGS="${pkgnames# }"
BUILDVARS
printf '%s\n' "$OPENBSD_MIRROR" >"$site/etc/installurl"
tar -C "$site" -czf "$www/sets/site$v.tgz" --owner=0 --group=0 --numeric-owner .
(cd "$www/sets" && ls -l >index.txt)

for n in $nodes; do
	sed -e "s|@HOSTNAME@|$n.$domain|" -e "s|@DOMAIN@|$domain|" \
		-e "s|@V@|$v|" "$here/install.conf" >"$www/$n-install.conf"
done

python3 -I -m http.server 80 --bind 127.0.0.1 --directory "$www" >"$work/http.log" 2>&1 &
httppid=$!
sleep 1
kill -0 "$httppid" 2>/dev/null || die "cannot serve on 127.0.0.1:80 ($(tail -n 1 "$work/http.log"))"

# Unattended install; reboot ends QEMU.
for n in $nodes; do
	log=$out/$n.console.log
	img=$out/$n.qcow2
	rm -f "$img"
	qemu-img create -q -f qcow2 "$img" "$FW_DISK"
	cp "$ovmf_vars" "$work/$n.vars.fd"
	echo "build: installing $n (console log: $log)"
	timeout 1800 qemu-system-x86_64 -machine q35,accel=kvm -cpu host -smp 2 -m "$INSTALL_RAM" \
		-display none -monitor none -serial "file:$log" -no-reboot \
		-drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf_code" \
		-drive "if=pflash,format=raw,unit=1,file=$work/$n.vars.fd" \
		-drive "file=$img,if=virtio,format=qcow2" \
		-netdev "user,id=n0,net=10.0.2.0/24,ipv6=off,hostname=$n,tftp=$tftp,bootfile=auto_install" \
		-device virtio-net-pci,netdev=n0 || die "$n: QEMU failed or timed out; see $log"
	grep -q "CONVERGENT-INSTALL-SITE-OK $n" "$log" || die "$n: install.site did not finish; see $log"

	# Patch the real kernel with a build-only DHCP NIC before the offline smoke boot.
	log=$out/$n.syspatch.log
	echo "build: patching $n (console log: $log)"
	timeout 3600 qemu-system-x86_64 -machine q35,accel=kvm -cpu host -smp 2 -m "$INSTALL_RAM" \
		-display none -monitor none -serial "file:$log" -no-reboot \
		-drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf_code" \
		-drive "if=pflash,format=raw,unit=1,file=$work/$n.vars.fd" \
		-drive "file=$img,if=virtio,format=qcow2" \
		-netdev user,id=patch,net=10.0.2.0/24,ipv6=off \
		-device e1000,netdev=patch || die "$n: patch boot failed or timed out; see $log"
	[ "$(console_value CONVERGENT-SYSPATCH-OK "$log")" = "$n" ] || die "$n: syspatch did not finish; see $log"
done

# Smoke-boot overlays with the seven production NICs.
for n in $nodes; do
	log=$out/$n.boot.log
	: >"$log"
	qemu-img create -q -f qcow2 -b "$out/$n.qcow2" -F qcow2 "$work/$n.smoke.qcow2"
	cp "$ovmf_vars" "$work/$n.smoke.vars.fd"
	nics=
	i=0
	while [ "$i" -lt 7 ]; do
		nics="$nics -netdev user,id=s$i,net=10.0.$((i + 10)).0/24,ipv6=off -device virtio-net-pci,netdev=s$i"
		i=$((i + 1))
	done
	# shellcheck disable=SC2086
	qemu-system-x86_64 -machine q35,accel=kvm -cpu host -smp 1 -m 384 \
		-display none -monitor none -serial "file:$log" -no-reboot \
		-drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf_code" \
		-drive "if=pflash,format=raw,unit=1,file=$work/$n.smoke.vars.fd" \
		-drive "file=$work/$n.smoke.qcow2,if=virtio,format=qcow2" $nics &
	qemupid=$!
	t=0
	until grep -q 'login: ' "$log" 2>/dev/null; do
		t=$((t + 5))
		[ "$t" -le 600 ] || die "$n: no login prompt after 10 minutes; see $log"
		kill -0 "$qemupid" 2>/dev/null || die "$n: QEMU exited during the smoke boot; see $log"
		sleep 5
	done
	kill "$qemupid" 2>/dev/null || true
	wait "$qemupid" 2>/dev/null || true
	qemupid=
	# A ruleset or interface file that did not load shows on the console.
	if grep -E 'pf\.conf:[0-9]+|pfctl: |hostname\.[a-z0-9]+: ' "$log" >/dev/null; then
		die "$n: configuration errors at boot; see $log"
	fi
	patchlog=$out/$n.syspatch.log
	patches=$(console_value CONVERGENT-SYSPATCH "$patchlog") || die "$n: missing patch inventory"
	bootpatches=$(console_value CONVERGENT-SYSPATCH "$log") || die "$n: missing boot patch inventory"
	[ "$patches" = "$bootpatches" ] || die "$n: boot patch inventory differs"
	for required in 018 054 062; do
		case " $patches " in
			*" ${required}_"*) ;;
			*) die "$n: missing required 7.8 erratum $required" ;;
		esac
	done
	kernel=$(console_value CONVERGENT-KERNEL-SHA256 "$patchlog") || die "$n: missing patched kernel digest"
	bootkernel=$(console_value CONVERGENT-KERNEL-SHA256 "$log") || die "$n: missing booted kernel digest"
	[ "$kernel" = "$bootkernel" ] || die "$n: did not boot the patched kernel"
	oldversion=$(console_value CONVERGENT-KERNEL "$patchlog") || die "$n: missing original kernel version"
	version=$(console_value CONVERGENT-KERNEL "$log") || die "$n: missing booted kernel version"
	[ "$version" != "$oldversion" ] || die "$n: kernel version did not change"
	printf '%s\n' "$patches" >"$out/$n.syspatch"
	for kind in pf rules; do
		awk -v k="$kind" '$1 == "CONVERGENT-HASH" && $2 == k {gsub(/\r/, ""); print $3}' "$log" >"$out/$n.$kind.sha256"
		[ "$(wc -l <"$out/$n.$kind.sha256")" = 1 ] || die "$n: missing $kind digest"
	done
	echo "build: $n boots"
done

for n in $nodes; do
	(cd "$out" && sha256sum "$n.qcow2" >"$n.qcow2.sha256")
done
echo "build: done: $out/fw1.qcow2 $out/fw2.qcow2"
