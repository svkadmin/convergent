#!/bin/sh
# build: builds fw1.qcow2 and fw2.qcow2 (ARCHITECTURE section 6, step 5) by running the OpenBSD
# installer unattended in QEMU: UEFI netboot, the response file, the install sets and the site
# set all served by a local HTTP server that only the guest's user-net reaches (10.0.2.2 is the
# host's loopback as the guest sees it). The sets' SHA256.sig is verified here with signify
# before anything is served.
#   ROOT_SSH_PUBKEY=<file> SVC_CA=<file> guests/fw/build <output-dir>
# ROOT_SSH_PUBKEY: the host's SSH public key, the only way into the firewalls. SVC_CA: the CA
# that signed the certificate of svc's syslog receiver. Neither is in the repository.
# Needs: qemu-system-x86_64 (KVM), qemu-img, OVMF, curl, signify, python3, tar, openssl.
# Binds 127.0.0.1:80 for the length of the build (the installer asks for its response file on
# port 80), so it needs root or CAP_NET_BIND_SERVICE. Both nodes are built in one run because
# they share one CARP password, made fresh each time.
# Optional: OVMF_CODE, OVMF_VARS (firmware files), WORK (scratch directory), KEEP=1 (keep it).
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/pins"

die() { echo "build: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is needed"; }

out=${1:-}
[ -n "$out" ] || die "usage: build <output-dir>"
[ -f "${ROOT_SSH_PUBKEY:-}" ] || die "set ROOT_SSH_PUBKEY to the host's SSH public key file"
[ -s "${SVC_CA:-}" ] || die "set SVC_CA to the CA certificate of svc's syslog receiver"
for t in qemu-system-x86_64 qemu-img curl python3 tar openssl sha256sum awk timeout; do need "$t"; done
signify=$(command -v signify || command -v signify-openbsd || true)
[ -n "$signify" ] || die "signify is needed"
grep -q '^ssh-' "$ROOT_SSH_PUBKEY" || die "ROOT_SSH_PUBKEY does not look like an SSH public key"
[ "$(wc -l <"$ROOT_SSH_PUBKEY")" -le 1 ] || die "ROOT_SSH_PUBKEY must be a single line"
case $(cat "$ROOT_SSH_PUBKEY") in *'|'* | *'&'* | *'\'*) die "ROOT_SSH_PUBKEY holds a character the response file cannot take (| & \\)" ;; esac
openssl x509 -in "$SVC_CA" -noout 2>/dev/null || die "SVC_CA is not a PEM certificate"

# Firmware: UEFI, because Incus boots the VM that way.
ovmf_code=${OVMF_CODE:-}
ovmf_vars=${OVMF_VARS:-}
for d in /usr/share/edk2/OvmfX64 /usr/share/edk2/ovmf /usr/share/OVMF /usr/share/edk2-ovmf /usr/share/qemu; do
	for f in OVMF_CODE.fd OVMF_CODE_4M.fd; do
		[ -n "$ovmf_code" ] || { [ -f "$d/$f" ] && ovmf_code=$d/$f; } || true
	done
	for f in OVMF_VARS.fd OVMF_VARS_4M.fd; do
		[ -n "$ovmf_vars" ] || { [ -f "$d/$f" ] && ovmf_vars=$d/$f; } || true
	done
done
{ [ -f "$ovmf_code" ] && [ -f "$ovmf_vars" ]; } || die "OVMF firmware not found; set OVMF_CODE and OVMF_VARS"

ver=$OPENBSD_VERSION
v=$(printf '%s' "$ver" | tr -d .)               # 7.8 -> 78
base=$OPENBSD_MIRROR/$ver/amd64
nodes="fw1 fw2"
domain=$(sed -n 's/^DOMAIN=//p' "$here/site/etc/convergent/net")
[ -n "$domain" ] || die "no DOMAIN in site/etc/convergent/net"

mkdir -p "$out"
work=${WORK:-$(mktemp -d)}
mkdir -p "$work"
www=$work/www
tftp=$work/tftp
dl=$work/dl
mkdir -p "$www/sets" "$www/pkg" "$tftp/etc" "$dl"

httppid=
qemupid=
cleanup() {
	[ -z "$qemupid" ] || kill "$qemupid" 2>/dev/null || true
	[ -z "$httppid" ] || kill "$httppid" 2>/dev/null || true
	[ -n "${KEEP:-}" ] || rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

# 1. The release's signing key, pinned; then the files, verified before use.
echo "build: fetching OpenBSD $ver"
curl -fsS --proto =https --tlsv1.2 -o "$dl/key.pub" "$OPENBSD_KEY_MIRROR/$ver/openbsd-$v-base.pub"
seen=$(sha256sum "$dl/key.pub" | awk '{print $1}')
[ "$seen" = "${OPENBSD_KEY_SHA256:-}" ] ||
	die "openbsd-$v-base.pub has SHA256 $seen, pinned: '${OPENBSD_KEY_SHA256:-}'; check it, then set OPENBSD_KEY_SHA256 in pins"
files="bsd bsd.mp bsd.rd base$v.tgz BOOTX64.EFI"
for f in SHA256 SHA256.sig $files; do
	curl -fsS --proto =https --tlsv1.2 -o "$dl/$f" "$base/$f"
done
(cd "$dl" && "$signify" -C -q -p key.pub -x SHA256.sig $files) || die "signify: the downloaded files do not verify"
echo "build: sets verified"

# Netboot tree: the EFI loader under the name DHCP hands out, the installer kernel, and a
# boot.conf that boots it on the serial console.
cp "$dl/BOOTX64.EFI" "$tftp/auto_install"
cp "$dl/bsd.rd" "$tftp/bsd.rd"
cat >"$tftp/etc/boot.conf" <<'BOOTCONF'
stty com0 115200
set tty com0
boot tftp:/bsd.rd
BOOTCONF

# Sets for the installer's HTTP step: the verified originals, then the site set and a listing.
cp "$dl/SHA256" "$dl/SHA256.sig" "$dl/bsd" "$dl/bsd.mp" "$dl/base$v.tgz" "$www/sets/"

# 2. Packages for install.site, with their dependencies, from the release's directory.
pkgbase=$OPENBSD_MIRROR/$ver/packages/amd64
curl -fsS --proto =https --tlsv1.2 -o "$dl/pkg-index.txt" "$pkgbase/index.txt"
pkgnames=
fetchpkg() {  # fetchpkg <file name>
	[ ! -f "$www/pkg/$1" ] || return 0
	curl -fsS --proto =https --tlsv1.2 -o "$www/pkg/$1" "$pkgbase/$1"
	tar -xzOf "$www/pkg/$1" +CONTENTS | awk -F: '/^@depend/ { print $3 ".tgz" }' |
		while read -r dep; do fetchpkg "$dep"; done
}
for p in $FW_PACKAGES; do
	f=$(awk -v p="$p" '{ n = $NF } n ~ ("^" p "-[0-9][^/]*\\.tgz$") { print n }' "$dl/pkg-index.txt" | sort | tail -n 1)
	[ -n "$f" ] || die "package $p not found in $pkgbase"
	fetchpkg "$f"
	pkgnames="$pkgnames ${f%.tgz}"
done

# 3. The site set: this tree, plus what is made fresh for this build.
site=$work/site
cp -R "$here/site" "$site"
find "$site" -type d -exec chmod 755 {} +
find "$site" -type f -exec chmod 644 {} +
chmod 755 "$site/install.site" "$site/usr/local/libexec/convergent/fw-facts"
mkdir -p "$site/etc/ssl"
cp "$SVC_CA" "$site/etc/ssl/convergent-ca.pem"
carppass=$(openssl rand -hex 16)
cat >"$site/etc/convergent/build" <<BUILDVARS
CARPPASS=$carppass
PKG_URL=http://10.0.2.2/pkg
PKGS="${pkgnames# }"
BUILDVARS
tar -C "$site" -czf "$www/sets/site$v.tgz" --owner=0 --group=0 --numeric-owner .
(cd "$www/sets" && ls -l >index.txt)

# 4. One response file per node, found by the host name the user-net's DHCP gives.
key=$(cat "$ROOT_SSH_PUBKEY")
for n in $nodes; do
	sed -e "s|@HOSTNAME@|$n.$domain|" -e "s|@DOMAIN@|$domain|" \
		-e "s|@ROOT_SSH_KEY@|$key|" "$here/install.conf" >"$www/$n-install.conf"
done

# 5. The HTTP server: the user-net's host address reaches this loopback listener.
python3 -I -m http.server 80 --bind 127.0.0.1 --directory "$www" >"$work/http.log" 2>&1 &
httppid=$!
sleep 1
kill -0 "$httppid" 2>/dev/null || die "cannot serve on 127.0.0.1:80 ($(tail -n 1 "$work/http.log"))"

machine=q35
cpu=max
if [ -w /dev/kvm ]; then machine=q35,accel=kvm; cpu=host; else echo "build: no /dev/kvm, this will be slow" >&2; fi

# 6. Install each node: netboot into the installer, which reads the response file, unpacks the
#    sets, runs install.site and reboots; -no-reboot turns that reboot into QEMU's exit.
for n in $nodes; do
	log=$work/$n.console.log
	img=$out/$n.qcow2
	rm -f "$img"
	qemu-img create -q -f qcow2 "$img" "$FW_DISK"
	cp "$ovmf_vars" "$work/$n.vars.fd"
	echo "build: installing $n (console log: $log)"
	timeout 1800 qemu-system-x86_64 -machine "$machine" -cpu "$cpu" -smp 2 -m "$INSTALL_RAM" \
		-display none -monitor none -serial "file:$log" -no-reboot \
		-drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf_code" \
		-drive "if=pflash,format=raw,unit=1,file=$work/$n.vars.fd" \
		-drive "file=$img,if=virtio,format=qcow2" \
		-netdev "user,id=n0,net=10.0.2.0/24,ipv6=off,hostname=$n,tftp=$tftp,bootfile=auto_install" \
		-device virtio-net-pci,netdev=n0 || die "$n: QEMU failed or timed out; see $log (set KEEP=1)"
	grep -q "CONVERGENT-INSTALL-SITE-OK $n" "$log" || die "$n: install.site did not finish; see $log (set KEEP=1)"
	grep "^CONVERGENT-HOSTKEY $n " "$log" | tail -n 1 | tr -d '\r' >"$out/$n.hostkey"
done

# 7. Smoke boot of each image on a throwaway overlay, with the seven NICs of the real
#    instance (vio0 transit, vio1 sync, vio2 host, vio3 svc, vio4 web, vio5 admin, vio6 guests).
for n in $nodes; do
	log=$work/$n.boot.log
	: >"$log"
	qemu-img create -q -f qcow2 -b "$out/$n.qcow2" -F qcow2 "$work/$n.smoke.qcow2"
	cp "$ovmf_vars" "$work/$n.smoke.vars.fd"
	nics=
	i=0
	while [ "$i" -lt 7 ]; do
		nics="$nics -netdev user,id=s$i,net=10.0.$((i + 10)).0/24,ipv6=off -device virtio-net-pci,netdev=s$i"
		i=$((i + 1))
	done
	# shellcheck disable=SC2086
	qemu-system-x86_64 -machine "$machine" -cpu "$cpu" -smp 1 -m 384 \
		-display none -monitor none -serial "file:$log" -no-reboot \
		-drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf_code" \
		-drive "if=pflash,format=raw,unit=1,file=$work/$n.smoke.vars.fd" \
		-drive "file=$work/$n.smoke.qcow2,if=virtio,format=qcow2" $nics &
	qemupid=$!
	t=0
	until grep -q 'login: ' "$log" 2>/dev/null; do
		t=$((t + 5))
		[ "$t" -le 600 ] || die "$n: no login prompt after 10 minutes; see $log (set KEEP=1)"
		kill -0 "$qemupid" 2>/dev/null || die "$n: QEMU exited during the smoke boot; see $log (set KEEP=1)"
		sleep 5
	done
	kill "$qemupid" 2>/dev/null || true
	wait "$qemupid" 2>/dev/null || true
	qemupid=
	# A ruleset or interface file that did not load shows on the console.
	if grep -E 'pf\.conf:[0-9]+|pfctl: |hostname\.[a-z0-9]+: ' "$log" >/dev/null; then
		die "$n: configuration errors at boot; see $log (set KEEP=1)"
	fi
	echo "build: $n boots"
done

for n in $nodes; do
	(cd "$out" && sha256sum "$n.qcow2" >"$n.qcow2.sha256")
done
echo "build: done: $out/fw1.qcow2 $out/fw2.qcow2 (host keys in $out/*.hostkey)"
