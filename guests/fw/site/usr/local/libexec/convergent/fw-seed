#!/bin/sh
# FAT16 CVSEED is a whole disk; CARP templates stay inactive without it.
set -eu
umask 077
node=$(hostname -s)
[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
announce() { echo; echo "CONVERGENT-HOSTKEY $node $(cat /var/db/convergent-seeded) $(ssh-keygen -E sha256 -lf /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $2}')"; }
[ ! -f /var/db/convergent-seeded ] || { announce; exit 0; }
seed=/mnt/cvseed
mkdir -p "$seed"
found=
for disk in $(sysctl -n hw.disknames | tr ',' ' '); do
    disk=${disk%%:*}
    case $disk in sd*|wd*) ;; *) continue ;; esac
    [ "$(dd if="/dev/r${disk}c" bs=512 count=1 2>/dev/null | dd bs=1 skip=43 count=11 2>/dev/null | tr -d ' ')" = CVSEED ] || continue
    mount_msdos -o ro,nodev,nosuid "/dev/${disk}c" "$seed"
    found=1
    break
done
if [ -z "$found" ]; then
    echo; echo "CONVERGENT-HOSTKEY $node unseeded $(ssh-keygen -E sha256 -lf /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $2}')"
    echo 'seed: no CVSEED; CARP remains disabled'
    exit 0
fi
stage=$(mktemp -d /etc/convergent/seed.XXXXXXXX)
trap 'umount "$seed"; rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
for file in seed-id management.pub syslog-ca.crt carp-pass; do [ -s "$seed/$file" ]; done
id=$(cat "$seed/seed-id")
pass=$(cat "$seed/carp-pass")
[ "${#id}" = 32 ] && [ "${#pass}" = 32 ]
case $id$pass in *[!0-9a-f]*) exit 1 ;; esac
ssh-keygen -lf "$seed/management.pub" >/dev/null
openssl x509 -in "$seed/syslog-ca.crt" -noout >/dev/null
for file in seed-id management.pub syslog-ca.crt; do install -m 600 "$seed/$file" "$stage/$file"; done
[ ! -f "$seed/demote" ] || touch "$stage/demote"
interfaces=$(awk -v mode=interfaces -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments)
set -- /etc/convergent/carp/hostname.carp*
[ "$#" = "$(awk -v mode=count -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments)" ]
for iface in $interfaces; do
    file=/etc/convergent/carp/hostname.$iface
    {
        echo 'group upgrade'
        [ "${file##*/}" != hostname.carp0 ] || echo '!test ! -f /etc/convergent/seeded/demote || ifconfig -g upgrade carpdemote 128'
        echo '!test ! -f /etc/convergent/seeded/maintenance || ifconfig $if group sysmaint'
        [ "${file##*/}" != hostname.carp0 ] || echo '!test ! -f /etc/convergent/seeded/maintenance || ifconfig -g sysmaint carpdemote 128'
        sed "s/@CARPPASS@/$pass/g" "$file"
    } >"$stage/${file##*/}"
    if grep -q '@' "$stage/${file##*/}"; then exit 1; fi
done
set -- "$stage"/hostname.carp*
[ "$#" = "$(awk -v mode=count -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments)" ]
# Restore before either CARP or the allocator can serve clients.
if [ -f "$seed/dhcpd.leases" ]; then
    install -m 600 "$seed/dhcpd.leases" /var/db/dhcpd.leases.new
    mv /var/db/dhcpd.leases.new /var/db/dhcpd.leases
fi
services="unbound wan_watch sshd"
[ -f "$seed/dhcpd.hold" ] || services="$services dhcpd"
rcctl enable $services
rcctl set dhcpd flags $(cat /etc/convergent/dhcpd.flags)
rcctl set syslogd flags -h -C /etc/ssl/convergent-ca.pem
sync
mv "$stage" /etc/convergent/seeded
sync
sh /etc/netstart $interfaces
rcctl restart syslogd
rcctl start $services
announce
