#!/bin/sh
# Own 128 of wanwatch's demotion: two lost rounds demote, three good rounds recover.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
die() { logger -t wan-watch "$*"; echo "wan-watch: $*" >&2; exit 1; }
read_owned() {
	info=$(ifconfig -g wanwatch) || die "cannot read wanwatch demotion"
	owned=$(printf '%s\n' "$info" | sed -n 's/^wanwatch: carp demote count \([0-9][0-9]*\)$/\1/p')
	case $owned in ''|*[!0-9]*) die "invalid wanwatch demotion: $info" ;; esac
}

wan=${1:?wan address required}
# Probe from our own transit address: CARP-address replies follow the role this probe decides.
src=
while [ -z "$src" ]; do
	src=$(ifconfig | awk -v net="${wan%.*}." '/^[a-z]/ {carp = $1 ~ /^carp/} $1 == "inet" && !carp && index($2, net) == 1 {print $2; exit}')
	[ -n "$src" ] || sleep 1
done
read_owned
case $owned in 0|128) ;; *) logger -t wan-watch "reconciling unexpected wanwatch demotion: $owned" || : ;; esac
good=0 lost=0 dns_lost=0
metrics_at=0
while :; do
	probe=
	probe_up=0
	want=$owned
	case $want in 0|128) ;; *) want=128 ;; esac
	# -w waits after the last probe; SIGINT preserves success on any reply.
	# Local DNS or forwarding failure demotes after ten rounds; brief reloads do not.
	if ! forwarding=$(sysctl -n net.inet.ip.forwarding) || [ "$forwarding" != 1 ] ||
		! timeout -k 1 3 host -W 2 -t A svc.convergent.internal 127.0.0.1 >/dev/null 2>&1; then
		# No WAN probe ran: a stale lost=1 would skip the sleep and burn ten rounds in a second.
		good=0 lost=0 dns_lost=$((dns_lost + 1))
		[ "$dns_lost" -lt 10 ] || want=128
	else
		dns_lost=0
		if probe=$(timeout -p -s INT 1 ping -q -n -I "$src" -c 3 -i 0.3 -w 1 "$wan" 2>/dev/null); then
			probe_up=1
			lost=0
			[ "$good" -ge 3 ] || good=$((good + 1))
			[ "$good" -lt 3 ] || want=0
		else
			# One lost round may be a busy second; two in a row demote.
			good=0 lost=$((lost + 1))
			[ "$lost" -lt 2 ] || want=128
		fi
	fi
	# Reuse this round's probes; publish only once per minute.
	now=$(date +%s)
	if [ $((now - metrics_at)) -ge 60 ]; then
		metrics=/var/node_exporter/textfile
		if {
			echo "convergent_wan_watch_probe_timestamp_seconds $now"
			echo "convergent_wan_watch_probe_up $probe_up"
			printf '%s\n' "$probe" | awk -f /usr/local/libexec/convergent/wan-probe.awk
		} >"$metrics/.wan-watch.$$" && chmod 644 "$metrics/.wan-watch.$$" &&
			mv "$metrics/.wan-watch.$$" "$metrics/wan-watch.prom"; then metrics_at=$now; fi
	fi
	if [ "$want" != "$owned" ]; then
		step=$((want - owned))
		if [ "$step" -gt 0 ]; then op=carpdemote; else op=-carpdemote; step=$((-step)); fi
		[ "$step" -le 128 ] || step=128
		if ! ifconfig -g wanwatch "$op" "$step"; then
			read_owned
			sleep 1
			continue
		fi
		read_owned
		logger -t wan-watch "wanwatch $op $step" || :
	fi
	# After a first loss, the next round runs at once; a good round's probes took 0.6 s of its second.
	if [ "$good" -ne 0 ]; then sleep 0.4; elif [ "$lost" != 1 ]; then sleep 1; fi
done
