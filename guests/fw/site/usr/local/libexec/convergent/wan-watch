#!/bin/sh
# Own 128 of wanwatch's demotion, with three good rounds to recover.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
die() { logger -t wan-watch "$*"; echo "wan-watch: $*" >&2; exit 1; }
read_owned() {
	info=$(ifconfig -g wanwatch) || die "cannot read wanwatch demotion"
	owned=$(printf '%s\n' "$info" | sed -n 's/^wanwatch: carp demote count \([0-9][0-9]*\)$/\1/p')
	case $owned in ''|*[!0-9]*) die "invalid wanwatch demotion: $info" ;; esac
}

wan=${1:?wan address required}
read_owned
case $owned in 0|128) ;; *) logger -t wan-watch "reconciling unexpected wanwatch demotion: $owned" || : ;; esac
good=0
while :; do
	want=$owned
	case $want in 0|128) ;; *) want=128 ;; esac
	# -w waits after the last probe; SIGINT preserves success on any reply.
	if pgrep -x unbound >/dev/null &&
	    timeout -p -s INT 1 ping -q -n -c 3 -i 0.3 -w 1 "$wan" >/dev/null 2>&1; then
		[ "$good" -ge 3 ] || good=$((good + 1))
		[ "$good" -lt 3 ] || want=0
	else
		good=0
		want=128
	fi
	if [ "$want" != "$owned" ]; then
		step=$((want - owned))
		if [ "$step" -gt 0 ]; then op=carpdemote; else op=-carpdemote; step=$((-step)); fi
		[ "$step" -le 128 ] || step=128
		if ! ifconfig -g wanwatch "$op" "$step"; then
			read_owned
			sleep 1
			continue
		fi
		read_owned
		logger -t wan-watch "wanwatch $op $step" || :
	fi
	[ "$good" -ne 0 ] || sleep 1
done
