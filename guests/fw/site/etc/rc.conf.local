pf=YES
pflogd_flags=
ntpd_flags=
sshd_flags=
unbound_flags=
syslogd_flags="-h -C /etc/ssl/convergent-ca.pem"
node_exporter_flags="--web.listen-address=@NET@.2.@ME@:9100 --collector.textfile.directory=/var/node_exporter/textfile --web.disable-exporter-metrics"
pkg_scripts="node_exporter pflog_stream"
# Every address is static and the resolver is local.
dhcpleased_flags=NO
slaacd_flags=NO
resolvd_flags=NO
smtpd_flags=NO
sndiod_flags=NO
check_quotas=NO
multicast=NO
dhcpd_flags=NO
