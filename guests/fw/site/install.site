#!/bin/sh
# Apply this node's templates after installing the sets.
set -eu
export LC_ALL=C
umask 022

die() { echo "install.site: $*" >&2; exit 1; }

cd /etc/convergent
node=$(sed 's/\..*//' /etc/myname)
[ -f "node.$node" ] || die "no node.$node for host '$node'"
for f in net packages "node.$node"; do [ -f "$f" ] || die "missing /etc/convergent/$f"; done

# Restore files the installer rewrites after unpacking sets.
for f in late/etc/*; do cp -p "$f" "/etc/${f##*/}"; done

# One KEY=value per line becomes one sed rule.
subst=/tmp/convergent.sed
: >"$subst"
for f in net "node.$node"; do
	grep -E '^[A-Z0-9_]+=' "$f" | while IFS="=" read -r k v; do
		printf 's|@%s@|%s|g\n' "$k" "$v"
	done >>"$subst"
done

templates="
	/etc/pf.conf /etc/rc.d/wan_watch /etc/ntpd.conf /etc/syslog.conf /etc/sysctl.conf
	/etc/rc.conf.local /etc/mygate /etc/resolv.conf /etc/ssh/sshd_config
	/etc/hostname.vio0 /etc/hostname.vio1 /etc/hostname.vio2 /etc/hostname.vio3
	/etc/hostname.vio4 /etc/hostname.vio5 /etc/hostname.vio6
	/etc/hostname.carp0 /etc/hostname.carp1 /etc/hostname.carp2 /etc/hostname.carp3
	/etc/hostname.carp4 /etc/hostname.carp5 /etc/hostname.pfsync0
	/var/unbound/etc/unbound.conf /var/unbound/etc/local-names.conf
"
for f in $templates; do
	[ -f "$f" ] || die "missing template $f"
	sed -f "$subst" "$f" >"$f.new"
	mv "$f.new" "$f"
	if sed 's/@CARPPASS@//g' "$f" | grep -qE '@[A-Z0-9_]+@'; then die "unfilled value in $f"; fi
done
rm -f "$subst"

# Modes: the secrets private, the rest as the system expects.
chown root:wheel /etc/pf.conf /etc/hostname.* /etc/ssh/sshd_config /etc/rc.d/wan_watch
chmod 0600 /etc/pf.conf /etc/hostname.*
chmod 0755 /etc/rc.d/wan_watch
chmod 0644 /etc/ssh/sshd_config /etc/convergent/update_src
chmod 0640 /etc/convergent/pf.guests
chmod 0644 /var/unbound/etc/*.conf /var/unbound/etc/blocklist.rpz
chmod 0755 /usr/local/libexec/convergent/fw-facts /usr/local/libexec/convergent/wan-watch /usr/local/libexec/convergent/fw-seed

# Nobody sits at a firewall's console: a failed preen repairs with -y and reboots, as -p does after fixing root.
sed -i 's/echo "Automatic file system check failed; help!"/echo "Automatic file system check failed; repairing."; fsck -y "$@"; case $? in 0|4) echo Rebooting...; reboot ;; *) false ;; esac/' /etc/rc
grep -qF 'fsck -y "$@"; case $? in 0|4) echo Rebooting...; reboot ;; *) false ;; esac' /etc/rc || die '/etc/rc has no unattended fsck repair'

# No CARP interfaces or dependent daemons until the seed is installed.
mkdir -p /etc/convergent/carp
mv /etc/hostname.carp* /etc/convergent/carp/
for f in /etc/convergent/carp/hostname.carp*; do
	ln -s "convergent/seeded/${f##*/}" "/etc/${f##*/}"
done
mkdir -p /root/.ssh
chmod 700 /root/.ssh
ln -sf /etc/convergent/seeded/management.pub /root/.ssh/authorized_keys
ln -sf /etc/convergent/seeded/syslog-ca.crt /etc/ssl/convergent-ca.pem
ln -s /etc/convergent/seeded/seed-id /var/db/convergent-seeded
rcctl disable unbound wan_watch sshd
rcctl set syslogd flags ''

# pkg_add verifies packages from the build host.
set --
while IFS= read -r pkg; do
	case $pkg in
		*[!A-Za-z0-9._+-]*|.tgz) die "invalid package basename" ;;
		*.tgz) set -- "$@" "http://10.0.2.2/pkg/$pkg" ;;
		*) die "invalid package basename" ;;
	esac
done <packages
[ "$#" -gt 0 ] || die "empty package list"
PKG_PATH=http://10.0.2.2/pkg pkg_add -I "$@"
install -d -m 0755 -o root -g wheel /var/node_exporter /var/node_exporter/textfile

grep -qs fw-facts /etc/crontab || cat /etc/convergent/crontab >>/etc/crontab   # none on a fresh install
chmod 600 /etc/crontab

# Check what can be checked without the interfaces and the other node.
rm -f /etc/ssh/ssh_host_*
# The DNSSEC root anchor unbound expects; built-in if the fetch fails.
unbound-anchor -a /var/unbound/db/root.key || [ -s /var/unbound/db/root.key ] || die "no DNSSEC root anchor"
chown _unbound /var/unbound/db/root.key
unbound-checkconf /var/unbound/etc/unbound.conf >/dev/null || die "unbound-checkconf failed"
sh -n /usr/local/libexec/convergent/fw-facts || die "fw-facts does not parse"
sh -n /usr/local/libexec/convergent/wan-watch || die "wan-watch does not parse"
sh -n /etc/rc.d/wan_watch || die "wan_watch does not parse"

. ./net
echo "$node.$DOMAIN" >/etc/myname
# syspatch selects the running kernel; bsd.rd cannot relink the installed /bsd.
cat >/etc/rc.firsttime <<'SYSPATCH'
#!/bin/sh
set -eu
export LC_ALL=C
exec >/dev/console 2>&1
trap 'echo CONVERGENT-SYSPATCH-FAILED; halt -p' 0
trap 'exit 1' HUP INT TERM
echo "CONVERGENT-KERNEL $(sysctl -n kern.version | sed -n '1p')"
cp -p /etc/resolv.conf /etc/resolv.conf.syspatch
pfctl -d
route -n delete default || true
dhcpleased
ifconfig em0 inet autoconf
t=0
until ifconfig em0 | grep -q 'inet 10\.0\.2\.'; do
	t=$((t + 1))
	[ "$t" -le 60 ]
	sleep 1
done
echo 'nameserver 10.0.2.3' >/etc/resolv.conf
# Unpack KARL objects if the installer's initial relink did not finish.
[ ! -f /usr/share/relink/kernel.tgz ] || /usr/libexec/reorder_kernel
# Exit 2 also requests a retry after syspatch updates itself.
while :; do
	before=$(syspatch -l)
	rc=0
	syspatch || rc=$?
	case $rc in
		0) break ;;
		2) after=$(syspatch -l); [ "$after" != "$before" ] || break ;;
		*) exit "$rc" ;;
	esac
done
missing=$(syspatch -c)
[ -z "$missing" ]
patches=$(syspatch -l)   # the build checks the release's required errata (pins)
pkg_add -u -I || exit $?
# Finish KARL synchronously before recording the next boot's kernel.
/usr/libexec/reorder_kernel
kernel=$(sha256 -q /bsd)
echo "CONVERGENT-KERNEL-SHA256 $kernel"
echo "CONVERGENT-SYSPATCH $(printf '%s\n' "$patches" | paste -sd ' ' -)"
pkill -x dhcpleased
mv /etc/resolv.conf.syspatch /etc/resolv.conf
rm -f /var/db/dhcpleased/em0 /etc/rc.firsttime /etc/rc.firsttime.run
rm -f /etc/ssh/ssh_host_* /etc/isakmpd/private/local.key /etc/iked/private/local.key /etc/soii.key
# Rollback archives do not travel with the image; syspatch -l counts patches by these files, so they stay empty.
for f in /var/syspatch/*/rollback.tgz; do [ ! -f "$f" ] || : >"$f"; done
# Every mounted install filesystem, including the auto layout's separate /usr trees.
filesystems=$(mount -t ffs)
[ -n "$filesystems" ]
printf '%s\n' "$filesystems" | awk '{print $3}' | while read -r fs; do
	zero=$(mktemp "${fs%/}/.convergent-zero.XXXXXXXXXX")
	# A full filesystem is expected; other write errors must fail the build.
	rc=0
	error=$(dd if=/dev/zero of="$zero" bs=1m 2>&1) || rc=$?
	sync
	rm -f "$zero"
	sync
	[ "$rc" = 0 ] || printf '%s\n' "$error" | grep -q 'No space left on device'
done
sync
echo "CONVERGENT-SYSPATCH-OK $(hostname -s)"
trap - 0
halt -p
SYSPATCH
cat >/etc/rc.local <<'FIRSTBOOT'
#!/bin/sh
set -eu
echo "CONVERGENT-KERNEL $(sysctl -n kern.version | sed -n '1p')"
kernel=$(sha256 -q /bsd.booted)
echo "CONVERGENT-KERNEL-SHA256 $kernel"
patches=$(syspatch -l)
echo "CONVERGENT-SYSPATCH $(printf '%s\n' "$patches" | paste -sd ' ' -)"
/usr/local/libexec/convergent/fw-seed
echo "CONVERGENT-HASH pf $(sha256 -q /etc/pf.conf)"
echo "CONVERGENT-HASH rules $(pfctl -sr | sed 's/__automatic_[0-9a-f_]*/__automatic/g' | sha256 -q)"
FIRSTBOOT

# What is left is only for the build.
cp "node.$node" node
rm -rf /etc/convergent/late /etc/convergent/packages /etc/convergent/crontab /etc/convergent/node.fw1 \
	/etc/convergent/node.fw2 /install.site
echo "CONVERGENT-INSTALL-SITE-OK $node"
