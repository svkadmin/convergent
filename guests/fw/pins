# Firewall build pins.

# OpenBSD amd64 release and mirror.
OPENBSD_VERSION=7.9
OPENBSD_MIRROR=https://cdn.openbsd.org/pub/OpenBSD
# Key hash: ftp.openbsd.org, openbsd/src and openbsd.org/79.html agreed on 2026-10-17.
OPENBSD_KEY_MIRROR=https://ftp.openbsd.org/pub/OpenBSD
OPENBSD_KEY_SHA256=b7ee8e7981549a1f707a4ed05115a99959a5f9e34b9bed9f9a098be17dd7e4b1
# Errata the build refuses to ship without (7.9: shmat overflow, kernel refcount use-after-free).
REQUIRED_ERRATA="018 026"

# pkg_add verifies package signatures.
FW_PACKAGES="node_exporter"

# Image size and the installer's memory (the firewalls run in 1 GiB).
FW_DISK=4G
INSTALL_RAM=1024
