# Firewall build pins.

# OpenBSD amd64 release and mirror.
OPENBSD_VERSION=7.8
OPENBSD_MIRROR=https://cdn.openbsd.org/pub/OpenBSD
# Key hash: ftp.openbsd.org, openbsd/src and openbsd.org/78.html agreed on 2026-10-16.
OPENBSD_KEY_MIRROR=https://ftp.openbsd.org/pub/OpenBSD
OPENBSD_KEY_SHA256=d4d29f8838834c4ad71e712f7e884ee87b227bea728923d3b8f99562e71a7db8

# pkg_add verifies package signatures.
FW_PACKAGES="node_exporter"

# Image size and the installer's memory (the firewalls run in 384 MiB).
FW_DISK=4G
INSTALL_RAM=1024
