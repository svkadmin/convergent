#!/bin/sh
# Offline pflogd process-state fixtures, including a live but suspended child.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
# Recovery docs must describe the bounded rotation, not preservation as .bad.
sed -n '/^pflog_stream forwards /,/^$/p' "$here/../../ARCHITECTURE.md" |
	tr '\n' ' ' >"$work/docs"
grep -qF 'For an absent or suspended writer, or a pflog file at least 1 MiB' "$work/docs"
grep -qF 'stops pflogd, removes any existing `pflog.bad`, rotates through newsyslog and restarts pflogd' "$work/docs"
grep -qF 'Ordinary rotation retains three compressed archives, as enforced by install.site' "$work/docs"
sed -n '/if capture pflogd /,/^	fi$/p' \
	"$here/site/usr/local/libexec/convergent/fw-facts" >"$work/check"
[ -s "$work/check" ]
sh -n "$work/check"
grep -qxF '	:filesize-cur=1M:\' "$here/site/etc/login.conf.d/pflogd"
grep -qxF '	:filesize-max=1M:\' "$here/site/etc/login.conf.d/pflogd"
grep -qxF '	:coredumpsize=0:\' "$here/site/etc/login.conf.d/pflogd"
capture() { data=$sample; }
# Stop before rotating, then start only if rotation succeeded.
size=24
fail=
stat() { echo "$size"; }
rcctl() { echo "rcctl $*" >>"$work/repair"; [ "$fail" != "$1" ]; }
rm() {
	if [ "$*" = '-f /var/log/pflog.bad' ]; then
		echo "rm $*" >>"$work/repair"; [ "$fail" != discard ]
	else command rm "$@"; fi
}
newsyslog() { echo "newsyslog $*" >>"$work/repair"; [ "$fail" != rotate ]; }
logger() { :; }
check() {
	ok=1
	: >"$work/repair"
	. "$work/check" >"$work/out"
	[ "$ok" = "$1" ]
	grep -qx "convergent_pflogd_up $1" "$work/out"
	grep -qx "convergent_pflogd_suspended $2" "$work/out"
	if [ "$1" = 0 ] || [ "$size" -ge 1048576 ]; then
		printf '%s\n' 'rcctl stop pflogd' 'rm -f /var/log/pflog.bad' \
			'newsyslog -F /var/log/pflog' 'rcctl start pflogd' >"$work/expected"
		cmp "$work/expected" "$work/repair"
	else
		[ ! -s "$work/repair" ]
	fi
}
sample='pflogd: [priv] (pflogd)
 pflogd: [running] -s 160 -i pflog0 -f /var/log/pflog (pflogd)'
check 1 0
size=1048576
check 1 0
for fail in stop discard rotate start; do
	ok=1
	: >"$work/repair"
	. "$work/check" >"$work/out"
	[ "$ok" = 0 ]
	case $fail in
	stop) [ "$(wc -l <"$work/repair")" = 1 ] ;;
	discard) [ "$(wc -l <"$work/repair")" = 2 ] ;;
	rotate) [ "$(wc -l <"$work/repair")" = 3 ] ;;
	start) [ "$(wc -l <"$work/repair")" = 4 ] ;;
	esac
done
fail=
size=24
sample='pflogd: [priv] (pflogd)
pflogd: [suspended] -s 160 -i pflog0 -f /var/log/pflog (pflogd)'
check 0 1
sample="$sample
pflogd: [running] -s 160 -i pflog0 -f /var/log/pflog (pflogd)"
check 0 1
sample='pflogd: [initializing] (pflogd)'
check 0 0
sample='sh -c echo pflogd: [running] -s 160'
check 0 0
sample=
check 0 0
capture() { ok=0; return 1; }
ok=1
. "$work/check"
[ "$ok" = 0 ]
echo 'fw-facts: pflogd running, suspended, absent and failed-query fixtures passed'
# Run the whole publisher; each blocked command must still replace old facts.
cat >"$work/mocks" <<'SH'
timeout() {
	[ "$1:$2:$3" = '-k:1:5' ] || exit 1
	shift 3
	echo "$*" >>"$calls"
	if [ "$*" = "$failed" ]; then echo partial; return 124; fi
	case $1 in unbound-control) shift; unbound_control "$@" ;; *) "$@" ;; esac
}
carp_groups=${carp_groups:-carp wanwatch upgrade}
ifconfig() {
	case $* in
	'') printf 'carp0: flags=41<UP,RUNNING>\n groups: %s\n carp: MASTER carpdev vio0 vhid 1 advskew 0\n' "$carp_groups" ;;
	# As on OpenBSD, a group without members does not exist.
	'-g '*) case " $carp_groups " in *" $2 "*) echo "$2: carp demote count 0" ;; *) return 1 ;; esac ;;
	pfsync0) printf 'pfsync0: flags=41<UP,RUNNING>\n defer: on\n' ;;
	esac
}
sysctl() { echo 1; }
rcctl() { return 0; }
pfctl() {
	case $1 in
	-si) printf 'Status: Enabled\n current entries 12\nCounters\n  match 12\n' ;;
	-sm) echo 'states hard limit 10000' ;;
	-sr) echo pass ;;
	esac
}
sha256() { [ "$#" != 0 ] || cat >/dev/null; echo abc; }
route() { echo 'default 100.80.0.10'; }
unbound_control() {
	[ "$1" != status ] || return 0
	printf 'total.num.queries=1\ntotal.num.cachehits=0\nnum.answer.rcode.SERVFAIL=0\nnum.answer.rcode.NXDOMAIN=0\ntotal.recursion.time.avg=0.01\n'
}
stat() { if [ "$2" = %z ]; then echo 24; else echo 2000000000; fi; }
netstat() { printf 'Name Mtu Network Address Ibytes Obytes\nvio0 1500 <Link> aa:bb 123 456\n'; }
ps() { echo 'pflogd: [running] -s 160'; }
SH
echo 'carp0 1 vio0 host 100.80.1.0/28 100.80.1.1 system' >"$work/segments"
sed -e "s|/var/node_exporter/textfile|$work|g" \
	-e "s|/usr/local/libexec/convergent/carp.awk|$here/../../rootfs/usr/lib/convergent/incus/carp.awk|g" \
	-e "s|/usr/local/libexec/convergent/|$here/site/usr/local/libexec/convergent/|g" \
	-e "s|/etc/convergent/segments|$work/segments|g" \
	-e "s|/var/unbound/etc/blocklist.rpz|$work/blocklist.rpz|g" \
	"$here/site/usr/local/libexec/convergent/fw-facts" >"$work/publisher"
cat "$work/mocks" "$work/publisher" >"$work/run"
sh -n "$work/mocks"
sh -n "$work/run"
sh -n "$work/mocks"
sh -n "$work/run"
echo '; convergent-source-refreshed-seconds 1000' >"$work/blocklist.rpz"
for failed in '' 'unbound-control status' 'unbound-control stats_noreset' 'pfctl -si' 'pfctl -sm' 'pfctl -sr'; do
	: >"$work/calls"
	echo stale >"$work/convergent_fw.prom"
	failed=$failed calls=$work/calls sh "$work/run"
	[ "$(wc -l <"$work/calls")" = 5 ]
	if [ -z "$failed" ]; then want=1; else want=0; fi
	grep -qx "convergent_fw_facts_success $want" "$work/convergent_fw.prom"
	if [ "$failed" = 'unbound-control status' ]; then want=0; else want=1; fi
	grep -qx "convergent_unbound_up $want" "$work/convergent_fw.prom"
	grep -qx 'convergent_dns_source_refreshed_seconds 1000' "$work/convergent_fw.prom"
	if grep -q partial "$work/convergent_fw.prom"; then exit 1; fi
done
for stamp in '' bad 0 -1 999999999999999999999 '1000 extra'; do
	printf '; convergent-source-refreshed-seconds %s\n' "$stamp" >"$work/blocklist.rpz"
	failed= calls=$work/calls sh "$work/run"
	grep -qx 'convergent_dns_source_refreshed_seconds 0' "$work/convergent_fw.prom"
	grep -qx 'convergent_fw_facts_success 0' "$work/convergent_fw.prom"
done
for kind in absent not-last; do
	if [ "$kind" = absent ]; then rm "$work/blocklist.rpz"
	else printf '; convergent-source-refreshed-seconds 1000\nads.example CNAME .\n' >"$work/blocklist.rpz"; fi
	failed= calls=$work/calls sh "$work/run"
	grep -qx 'convergent_dns_source_refreshed_seconds 0' "$work/convergent_fw.prom"
done
# A handback leaves fw1 without the upgrade group: its facts still succeed.
echo '; convergent-source-refreshed-seconds 1000' >"$work/blocklist.rpz"
carp_groups='carp wanwatch' failed= calls=$work/calls sh "$work/run"
grep -qx 'convergent_fw_facts_success 1' "$work/convergent_fw.prom"
grep -qx 'convergent_carp_group_present{group="upgrade"} 0' "$work/convergent_fw.prom"
echo 'fw-facts: bounded probes, publication and source-age fixtures passed'
