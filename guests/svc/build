#!/bin/sh
# ARCHITECTURE 3.4, 6
# Requires native x86_64 Linux and root.
set -eu
umask 022
here=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
. "$here/../alpine.sh"
die() { echo "svc/build: $*" >&2; exit 1; }
[ "$#" = 0 ] || die "usage: guests/svc/build"
[ "$(id -u)" = 0 ] || die "run on the build host as root"
[ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || die "native x86_64 Linux required"
for tool in tar curl sha256sum chroot mount umount; do
    command -v "$tool" >/dev/null || die "missing build tool: $tool"
done
mkdir -p "$here/out"
work=$(mktemp -d /var/tmp/convergent-svc.XXXXXXXX)   # outside the tree: it holds live mounts
cleanup() {
    trap '' HUP INT TERM
    alpine_cleanup || return
    case $work in /var/tmp/convergent-svc.*) rm -rf -- "$work" ;; esac
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
cache=${CACHE_DIR:-/var/cache/convergent/alpine}
alpine_bootstrap "$work/mini" "$cache"
root=$mini/target
alpine_prepare
mkdir -p "$mini/apks"
# No kernel, SSH, cron, DHCP client, exporter, compiler or Incus agent.
alpine_apk --initdb add alpine-release alpine-baselayout busybox busybox-openrc openrc ifupdown-ng ca-certificates
case $(cat "$root/etc/alpine-release") in 3.24.*) ;; *) die "bootstrap is not Alpine 3.24" ;; esac
alpine_apk update
mkdir -p "$root/etc/convergent"
: >"$root/etc/convergent/apk-imports"
while read -r name repository version sha rest; do
    case $name in ''|'#'*) continue ;; esac
    if alpine_apk search --exact --quiet "$name" | grep -q .; then
        alpine_apk add "$name"
    else
        # Not in 3.24: the pinned signed edge build, cached or fetched; its dependencies come from 3.24.
        # A moved edge without a cached copy stops here until its pin is updated.
        [ -n "$version" ] && [ -n "$sha" ] || die "$name: no version and sha256 pin in packages"
        alpine_edge "$name" "$repository" "$version" "$sha" "$cache/edge"
        alpine_apk add "/apks/$name-$version.apk"
        printf '%s %s edge/%s\n' "$name" "$version" "$repository" >>"$root/etc/convergent/apk-imports"
    fi
done <"$here/packages"

# Pinned signed VictoriaLogs datasource plugin.
plugin_version=0.32.0
plugin_sha256=e100b767f19cd614ac8ac3860458a3fb33f5aa7a876e924d0340010e40d1c0d4
plugin_archive=victoriametrics-logs-datasource-v$plugin_version.tar.gz
alpine_pinned "https://github.com/VictoriaMetrics/victorialogs-datasource/releases/download/v$plugin_version/$plugin_archive" \
    "$plugin_sha256" "$cache/$plugin_archive"
tar -tzf "$cache/$plugin_archive" >"$work/plugin-files"
if grep -E '(^/|(^|/)\.\.(/|$))' "$work/plugin-files"; then die "unsafe plugin archive"; fi
mkdir "$work/plugin"
tar -xzf "$cache/$plugin_archive" --no-same-owner -C "$work/plugin"
plugin_json=$(find "$work/plugin" -type f -name plugin.json)
[ "$(printf '%s\n' "$plugin_json" | wc -l)" = 1 ] && [ -f "$plugin_json" ] || die "unexpected plugin layout"
plugin=$root/usr/share/grafana/plugins/victoriametrics-logs-datasource
mkdir -p "$plugin"
cp -R "${plugin_json%/plugin.json}/." "$plugin/"
[ -s "$plugin/MANIFEST.txt" ] || die "plugin signature manifest missing"

cp -R "$here/rootfs/." "$root/"
# Alpine's sysctl service needs a regular-file override; namespaced keys are in 90-svc.conf.
: >"$root/etc/sysctl.d/00-alpine.conf"
sh "$here/../../build/networks" svc "$root"
chmod 755 "$root/etc/init.d/"* "$root/usr/local/sbin/"*
chroot "$root" /bin/sh -eu <<'SETUP'
for account in vmmetrics vmlogs vmalert vmauth grafana; do
    if ! id "$account" >/dev/null 2>&1; then
        addgroup -S "$account"
        adduser -S -D -H -h /nonexistent -s /sbin/nologin -G "$account" "$account"
    fi
done
passwd -l root
mkdir -p /var/lib/victoria-metrics /var/lib/victoria-logs /var/lib/grafana
mkdir -p /var/lib/convergent/seed
chmod 700 /var/lib/convergent
chown vmmetrics:vmmetrics /var/lib/victoria-metrics
chown vmlogs:vmlogs /var/lib/victoria-logs
chown grafana:grafana /var/lib/grafana
chmod 750 /var/lib/victoria-metrics /var/lib/victoria-logs /var/lib/grafana
mkdir -p /etc/victoria-metrics/tls /etc/victoria-logs/tls
chown root:vmmetrics /etc/victoria-metrics/tls
chown root:vmlogs /etc/victoria-logs/tls
chown root:grafana /etc/grafana
chmod 750 /etc/victoria-metrics/tls /etc/victoria-logs/tls /etc/grafana
# Package post-install scripts must not decide this image's runlevels.
rm -rf /etc/runlevels
# Unused package services require the absent non-container dev service.
rm -f /etc/init.d/machine-id /etc/init.d/watchdog
mkdir -p /etc/runlevels/sysinit /etc/runlevels/boot /etc/runlevels/default /etc/runlevels/shutdown
rc-update add devfs sysinit
rc-update add dmesg sysinit
rc-update add sysfs sysinit
rc-update add hostname boot
rc-update add bootmisc boot
rc-update add convergent-seed boot
rc-update add sysctl boot
rc-update add networking boot
rc-update add syslog boot
rc-update add victoria-metrics default
rc-update add victoria-logs default
rc-update add vmauth default
rc-update add vmalert default
# Grafana is deliberately absent from every runlevel.
rc-update add killprocs shutdown
rc-update add savecache shutdown
# Remove SUID/SGID entry points.
find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} \;
# Require every configured service.
for service in devfs dmesg sysfs hostname bootmisc sysctl networking syslog killprocs savecache; do
    [ -x "/etc/init.d/$service" ]
done
SETUP

# Retain package provenance; remove the package manager.
if alpine_apk info --exists apk-tools >/dev/null 2>&1; then alpine_apk del apk-tools; fi
alpine_apk info -v >"$work/packages.txt"
# The tools package also carries clients this image never runs.
rm -f "$root/usr/bin/vmagent" "$root/usr/bin/vmctl"

chroot "$root" /usr/bin/vmalert -rule='/etc/vmalert/*.yaml' \
    -datasource.url=http://127.0.0.1:8427 -notifier.blackhole -dryRun
chroot "$root" /usr/bin/vmauth -auth.config=/etc/vmauth.yaml -dryRun
for script in "$root/etc/init.d/victoria-metrics" "$root/etc/init.d/victoria-logs" \
    "$root/etc/init.d/vmalert" "$root/etc/init.d/vmauth" "$root/etc/init.d/grafana" \
    "$root/usr/local/sbin/svc-secret-check"; do
    sh -n "$script"
done
rm -f "$root/etc/machine-id" "$root/var/lib/dbus/machine-id"

mkdir -p "$root/dev" "$root/proc" "$root/sys" "$root/run" "$root/tmp"
chmod 1777 "$root/tmp"
epoch=${SOURCE_DATE_EPOCH:-$(date +%s)}
case $epoch in ''|*[!0-9]*) die "invalid SOURCE_DATE_EPOCH" ;; esac
cat >"$work/metadata.yaml" <<EOF
architecture: x86_64
creation_date: $epoch
properties:
  os: Alpine
  release: '3.24'
  variant: convergent-svc
  description: svc (Alpine 3.24, OpenRC, x86_64)
EOF
tar --numeric-owner --owner=0 --group=0 -czf "$work/metadata.tar.gz" -C "$work" metadata.yaml

alpine_cleanup
tar --numeric-owner -czf "$work/rootfs.tar.gz" -C "$root" .
(cd "$work" && sha256sum metadata.tar.gz rootfs.tar.gz >SHA256SUMS)
for artifact in metadata.yaml metadata.tar.gz rootfs.tar.gz packages.txt SHA256SUMS; do
    mv "$work/$artifact" "$here/out/$artifact"
done
echo "svc/build: image in $here/out (credentials arrive on CVSEED)"
