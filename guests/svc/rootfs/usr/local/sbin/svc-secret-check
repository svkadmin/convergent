#!/bin/sh
# Require host-injected files: regular, root-owned, group-readable only by
# the named service, no other access. No automatic keys or default passwords.
set -eu
[ "$#" = 2 ] || exit 2
group=$1
file=$2
[ -f "$file" ] && [ ! -L "$file" ] && [ -s "$file" ] || exit 1
[ "$(stat -c %u "$file")" = 0 ] || exit 1
[ "$(stat -c %G "$file")" = "$group" ] || exit 1
[ "$(stat -c %a "$file")" = 640 ] || exit 1
