{
  "uid": "cv-network-path",
  "title": "Convergent · Network",
  "description": "Six CARP segments, pf, DNS, uplink and interface health.",
  "tags": [
    "convergent"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 2
      },
      "description": "Source: fw-facts pfctl, ifconfig pfsync0 and unbound-control status.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (convergent_pf_enabled)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "pf · {{node}}"
        },
        {
          "refId": "B",
          "expr": "max by (node) (convergent_pfsync_up)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "pfsync · {{node}}"
        },
        {
          "refId": "C",
          "expr": "max by (node) (convergent_unbound_up)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "resolver · {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#F2495C"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "#89C98E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 2
      },
      "description": "Source: wan-check. Lease present is not an Internet probe; overlap is latched until a safe lease; portal lasts at most 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(convergent_wan_upstream_up{node=\"wan\"})",
