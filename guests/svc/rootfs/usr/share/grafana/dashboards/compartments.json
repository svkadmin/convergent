{
  "uid": "cv-compartments",
  "title": "Convergent · Guests",
  "description": "Incus state and resource use; select a running instance.",
  "tags": [
    "convergent"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "description": "Source: VictoriaMetrics up, Incus /1.0/metrics CPU presence, tools/check autostart inventory. Expected does not include on-demand browsers.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"incus\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "Incus scrape"
        },
        {
          "refId": "B",
          "expr": "count(count by (project,name) (incus_cpu_seconds_total))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "running instances"
        },
        {
          "refId": "C",
          "expr": "sum(cv_guest_expected_running)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "expected autostart"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Incus scrape"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "#F2495C"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Instances · now",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 9
      },
      "description": "Source: Incus /1.0/metrics; tools/check cv_guest_expected_running supplies autostart guests missing now. A stopped guest is shown only while the Incus scrape answers. RAM is total minus available; agentless fw/wan VMs report capped QEMU RSS against configured RAM. Their CPU counts QEMU vCPU thread overhead, excluding guest execution. These are not guest utilization. Rates use two minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count by (project,name) (incus_cpu_seconds_total{job=\"incus\"}) > bool 0 or max by (project,name) (cv_guest_expected_running) * 0) and on() (max(up{job=\"incus\"}) == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (project,name) (rate(incus_cpu_seconds_total{mode=~\"user|system\"}[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (project,name) (incus_memory_MemTotal_bytes - incus_memory_MemAvailable_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (project,name) (incus_memory_MemTotal_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "100 * max by (project,name) (1 - incus_memory_MemAvailable_bytes / incus_memory_MemTotal_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "8 * sum by (project,name) (rate(incus_network_receive_bytes_total{device!=\"lo\"}[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "8 * sum by (project,name) (rate(incus_network_transmit_bytes_total{device!=\"lo\"}[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "1 * sum by (project,name) (rate(incus_disk_read_bytes_total[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "expr": "1 * sum by (project,name) (rate(incus_disk_written_bytes_total[2m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "STOPPED",
                        "color": "#F2495C"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "RUNNING",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "This instance",
                    "url": "/d/cv-compartments?var-project=${__data.fields.project}&var-name=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Incus cores"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: cores"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Incus RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#EDB873",
                      "value": 80
                    },
                    {
                      "color": "#F2495C",
                      "value": 95
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "out"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "read"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "written"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "state",
              "Value #B": "Incus cores",
              "Value #C": "Incus RAM",
              "Value #D": "RAM total",
              "Value #E": "RAM %",
              "Value #F": "in",
              "Value #G": "out",
              "Value #H": "read",
              "Value #I": "written"
            },
            "includeByName": {
              "project": true,
              "name": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true
            },
            "indexByName": {
              "project": 0,
              "name": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 10
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Selected instance · $project / $name",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU · Incus cores",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "Source: Incus user plus system CPU time. For agentless fw/wan VMs this is QEMU vCPU thread overhead, excluding guest execution; it is not guest CPU utilization.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(incus_cpu_seconds_total{project=~\"${project:regex}\",name=~\"${name:regex}\",mode=~\"user|system\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#79BCF5"
          },
          "min": 0,
          "max": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory · Incus used / total",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "description": "Source: Incus MemTotal minus MemAvailable. Agentless fw/wan VMs report QEMU RSS capped at configured RAM, with configured RAM as total; this is not guest memory pressure. Containers use their memory limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(incus_memory_MemTotal_bytes{project=~\"${project:regex}\",name=~\"${name:regex}\"} - incus_memory_MemAvailable_bytes{project=~\"${project:regex}\",name=~\"${name:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "Incus used"
        },
        {
          "refId": "B",
          "expr": "max(incus_memory_MemTotal_bytes{project=~\"${project:regex}\",name=~\"${name:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "Incus total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#79BCF5"
          },
          "min": 0,
          "max": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 1073741824
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Incus total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#BDACF0"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network · by interface",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "description": "Source: Incus network counters for the selected instance, excluding loopback.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(incus_network_receive_bytes_total{project=~\"${project:regex}\",name=~\"${name:regex}\",device!=\"lo\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "in · {{device}}"
        },
        {
          "refId": "B",
          "expr": "8 * rate(incus_network_transmit_bytes_total{project=~\"${project:regex}\",name=~\"${name:regex}\",device!=\"lo\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "out · {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0,
          "max": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 1000000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk · block throughput",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "description": "Source: Incus disk counters. Throughput is block I/O, not filesystem fill; cache hits need no block read.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(incus_disk_read_bytes_total{project=~\"${project:regex}\",name=~\"${name:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "expr": "sum(rate(incus_disk_written_bytes_total{project=~\"${project:regex}\",name=~\"${name:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "written"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#79BCF5"
          },
          "min": 0,
          "max": null,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 1048576
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "written"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#BDACF0"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Expected autostart · now",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 5
      },
      "description": "Source: tools/check snapshots Incus boot.autostart; one row per expected instance. Compare the live state table above.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (project,name) (cv_guest_expected_running)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "policy"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "EXPECTED RUNNING",
                        "color": "#A6B0BC"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
