{
  "uid": "cv-compartments",
  "title": "Convergent · Guests",
  "description": "Guest health, lifecycle, native pressure and secondary host cost.",
  "tags": [
    "convergent"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Guest health matrix",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "description": "Inventory includes stopped on-demand guests as of the last checker scan. Blank policy means inventory is stale. VM CPU is measured inside the VM; container CPU is percent of one core (may exceed 100). OpenBSD RAM is active+wired / pages, WAN uses MemAvailable; container RAM includes cache. svc free is its tightest qgroup headroom; other containers have no filesystem exporter. Exporter is scrape health, not a service probe; Network and Monitoring show services. Updates/restarts are in the lifecycle log below.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((max by (project,name) (cv_guest_expected_running) and on() ((cv_checker_last_run_seconds > time() - 129600) and (cv_checker_last_run_seconds <= time() + 60) and on(node) (up{job=\"node\",node=\"host\"} == 1))) - ((count by (project,name) (incus_cpu_seconds_total{job=\"incus\"}) > bool 0 or max by (project,name) (cv_guest_expected_running) * 0) and on() (max(up{job=\"incus\"}) == 1)), 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (project,name) (cv_guest_expected_running) and on() ((cv_checker_last_run_seconds > time() - 129600) and (cv_checker_last_run_seconds <= time() + 60) and on(node) (up{job=\"node\",node=\"host\"} == 1))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(count by (project,name) (incus_cpu_seconds_total{job=\"incus\"}) > bool 0 or max by (project,name) (cv_guest_expected_running) * 0) and on() (max(up{job=\"incus\"}) == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by(project,name) (label_replace(label_replace(max by(node) (up{job=\"node\",node=~\"fw1|fw2|wan\"}), \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "max by(project,name) (label_replace(label_replace(100 * (1 - avg by(node) (rate(node_cpu_seconds_total{node=~\"fw1|fw2|wan\",mode=\"idle\"}[4m]))), \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\")) or (100 * sum by(project,name) (rate(incus_cpu_seconds_total{type=\"container\",mode=~\"user|system\"}[4m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "max by(project,name) (label_replace(label_replace((100 * (1 - node_memory_MemAvailable_bytes{node=\"wan\"} / node_memory_MemTotal_bytes{node=\"wan\"})) or (100 * (node_memory_active_bytes{node=~\"fw1|fw2\"} + node_memory_wired_bytes{node=~\"fw1|fw2\"}) / node_memory_size_bytes{node=~\"fw1|fw2\"}), \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\")) or (100 * cv_guest_memory_current_bytes / cv_guest_memory_max_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "max by(project,name) (label_replace(label_replace(min by(node) (node_filesystem_avail_bytes{node=~\"fw1|fw2|wan\",fstype!~\"tmpfs|devtmpfs\"}), \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "max by(project,name) (label_replace(label_replace((convergent_pf_enabled * convergent_unbound_up) and on(node) ((convergent_fw_facts_success == 1) and on(node) (up{job=\"node\",node=~\"fw1|fw2\"} == 1) and on(node) (convergent_fw_facts_timestamp_seconds > time() - 180) and on(node) (convergent_fw_facts_timestamp_seconds <= time() + 60)), \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\")) or label_replace(label_replace(min(up{node=\"svc\"}), \"name\", \"svc\", \"\", \"\"), \"project\", \"default\", \"\", \"\")",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "I",
          "expr": "cv_guest_update_phase and on() (((cv_collector_timestamp_seconds{collector=\"guest_updates\"} <= time() + 60) and (cv_collector_timestamp_seconds{collector=\"guest_updates\"} > time() - 180) and (cv_collector_success{collector=\"guest_updates\"} == 1)) and on(node) (up{job=\"node\",node=\"host\"} == 1))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "interval": "1m",
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        },
        {
          "refId": "J",
          "expr": "max by(project,name) (label_replace(label_replace(time() - node_boot_time_seconds{node=~\"fw1|fw2|wan\"}, \"name\", \"$1\", \"node\", \"(.+)\"), \"project\", \"default\", \"node\", \".+\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "cvOptional": "No native exporter for containers; resource gaps are N/A, not zero.",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "missing expected"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#F2495C",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "autostart"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "ON DEMAND",
                        "color": "#A6B0BC"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "EXPECTED",
                        "color": "#79BCF5"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "STOPPED",
                        "color": "#A6B0BC"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "RUNNING",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exporter"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "#F2495C"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "services"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAILED",
                        "color": "#F2495C"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OK",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "VM uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "update phase"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "IDLE",
                        "color": "#A6B0BC"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "PREPARING",
                        "color": "#EDB873"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "PENDING",
                        "color": "#EDB873"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "3": {
                        "text": "COMMITTED",
                        "color": "#79BCF5"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "guest CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "guest RAM %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "filesystem free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "This instance",
                    "url": "/d/cv-compartments?var-project=${__data.fields.project}&var-name=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "missing expected",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "missing expected",
              "Value #B": "autostart",
              "Value #C": "running",
              "Value #D": "exporter",
              "Value #E": "guest CPU %",
              "Value #F": "guest RAM %",
              "Value #G": "filesystem free",
              "Value #H": "services",
              "Value #I": "update phase",
              "Value #J": "VM uptime"
            },
            "includeByName": {
              "project": true,
              "name": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true,
              "Value #J": true
            },
            "indexByName": {
              "project": 0,
              "name": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 10,
              "Value #J": 11
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inventory age",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 2
      },
      "description": "Autostart/on-demand inventory updates with the checker; unknown after 36h. Historical series retain stopped instance selectors.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cv_checker_last_run_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "checker / policy age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Selected instance - lifecycle / updates",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "description": "Incus lifecycle forwarding already exists. Guest update start, failure, deferred and success messages share this view. Match is a name search; inspect the resource field for the exact instance.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "remote_ip:=\"100.80.1.10\" app_name:in(\"incus-audit\",\"guests\",\"sys-firewall\") _msg:~\"${name:regex}\" | copy remote_ip as hostname | format if (remote_ip:=\"100.80.1.10\") \"host\" as hostname | format if (remote_ip:=\"100.80.2.2\") \"fw1\" as hostname | format if (remote_ip:=\"100.80.2.3\") \"fw2\" as hostname | format if (remote_ip:=\"100.80.0.10\") \"wan\" as hostname | format if (remote_ip:=\"127.0.0.1\") \"svc\" as hostname | set_stream_fields hostname, app_name",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "enableInfiniteScrolling": false
      },
      "links": [
        {
          "title": "These lines in Explore",
          "url": "/explore?left={%22datasource%22:%22logs%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22expr%22:%22remote_ip:%3D%5C%22100.80.1.10%5C%22%20app_name:in%28%5C%22incus-audit%5C%22%2C%5C%22guests%5C%22%2C%5C%22sys-firewall%5C%22%29%20_msg:~%5C%22${name:regex}%5C%22%20%7C%20copy%20remote_ip%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.1.10%5C%22%29%20%5C%22host%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.2.2%5C%22%29%20%5C%22fw1%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.2.3%5C%22%29%20%5C%22fw2%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.0.10%5C%22%29%20%5C%22wan%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22127.0.0.1%5C%22%29%20%5C%22svc%5C%22%20as%20hostname%20%7C%20set_stream_fields%20hostname%2C%20app_name%22%2C%22datasource%22:{%22type%22:%22victoriametrics-logs-datasource%22%2C%22uid%22:%22logs%22}%2C%22queryType%22:%22instant%22}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}"
        },
        {
          "title": "All logs in Explore",
          "url": "/explore?left={%22datasource%22:%22logs%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22expr%22:%22%2A%20%7C%20copy%20remote_ip%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.1.10%5C%22%29%20%5C%22host%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.2.2%5C%22%29%20%5C%22fw1%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.2.3%5C%22%29%20%5C%22fw2%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22100.80.0.10%5C%22%29%20%5C%22wan%5C%22%20as%20hostname%20%7C%20format%20if%20%28remote_ip:%3D%5C%22127.0.0.1%5C%22%29%20%5C%22svc%5C%22%20as%20hostname%20%7C%20set_stream_fields%20hostname%2C%20app_name%22%2C%22datasource%22:{%22type%22:%22victoriametrics-logs-datasource%22%2C%22uid%22:%22logs%22}%2C%22queryType%22:%22instant%22}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Native VM CPU",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "description": "Inside-VM CPU idle, including guest execution. Not QEMU thread accounting.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(node) (rate(node_cpu_seconds_total{node=~\"${name:regex}\",mode=\"idle\"}[4m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}}",
          "cvOptional": "Native exporter exists only for fw1/fw2/wan; stopped guests have no fresh data."
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "axisSoftMax": 100
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
