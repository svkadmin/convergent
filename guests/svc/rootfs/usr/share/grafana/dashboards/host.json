{
  "uid": "cv-host",
  "title": "Convergent · Host",
  "description": "Writable capacity, Btrfs, NVMe, power, temperature and pressure.",
  "tags": [
    "convergent"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "State storage",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "Exporter reads /var continuously. Btrfs/quotas are read hourly; storage collector success and age must be checked alongside the values.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_readonly{node=\"host\",mountpoint=\"/var\"}) and on(node) (up{job=\"node\",node=\"host\"} == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "writable"
        },
        {
          "refId": "B",
          "expr": "node_filesystem_avail_bytes{node=\"host\",mountpoint=\"/var\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "expr": "time() - cv_collector_timestamp_seconds{collector=\"storage\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "evidence age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "writable"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAILED",
                        "color": "#F2495C"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OK",
                        "color": "#89C98E"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "available"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "evidence age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Btrfs device errors",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "description": "Persistent per-filesystem totals from btrfs device stats; never reset by collection.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cv_btrfs_device_errors_total and on() (((cv_collector_timestamp_seconds{collector=\"storage\"} <= time() + 60) and (cv_collector_timestamp_seconds{collector=\"storage\"} > time() - 7200) and (cv_collector_success{collector=\"storage\"} == 1)) and on(node) (up{job=\"node\",node=\"host\"} == 1))",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#F2495C",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "errors",
              "Value": "errors"
            },
            "includeByName": {
              "kind": true,
              "Value #A": true,
              "Value": true
            },
            "indexByName": {
              "kind": 0,
              "Value #A": 1
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrub evidence",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "description": "Read-only parsing of btrfs-progs scrub status for /var UUID. Monthly scheduled scrub; no record is unknown, never a clean result. A running scrub has finished=0.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cv_btrfs_scrub_recorded",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "record exists"
        },
        {
          "refId": "B",
          "expr": "cv_btrfs_scrub_finished",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "finished without cancellation",
          "cvOptional": "No completed scrub record on a fresh install."
        },
        {
          "refId": "C",
          "expr": "time() - cv_btrfs_scrub_started_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "age since start",
          "cvOptional": "No scrub record yet."
        },
        {
          "refId": "D",
          "expr": "cv_btrfs_scrub_errors",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "errors",
          "cvOptional": "No scrub record yet."
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age since start"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#F2495C",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 20
        }
      }
    },
