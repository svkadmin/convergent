        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "result",
              "Value": "result"
            },
            "includeByName": {
              "collector": true,
              "Value #A": true,
              "Value": true
            },
            "indexByName": {
              "collector": 0,
              "Value #A": 1
            }
          }
        }
