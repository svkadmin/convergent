      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "description": "Source: host/wan syslog-ng and fw syslogd to VictoriaLogs. AppArmor DENIED, USBGuard block/reject, pam_faillock, login failures and sudo COMMAND records. Routine audit EXECVE/SYSCALL/PATH/CWD/PROCTITLE and stack continuations excluded. Labels retain hostname/app_name/level; all logs are in Explore.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "remote_ip:in(\"100.80.1.10\",\"100.80.2.2\",\"100.80.2.3\",\"100.80.0.10\") AND (_msg:~\"apparmor=\\\"DENIED\\\"|pam_faillock|authentication failure|Failed password\" OR (app_name:=\"usbguard\" AND _msg:~\"(?i)block|reject|denied\") OR (app_name:=\"sudo\" AND _msg:~\"COMMAND=|incorrect password|not in the sudoers\")) AND NOT _msg:~\"(?i)(type=(EXECVE|SYSCALL|CWD|PATH|PROCTITLE)|type=13(00|02|07|09|27))\" AND NOT (app_name:=\"kernel\" AND _msg:~\"^([[:space:]]|Call [Tt]race:|CPU: [0-9]|Hardware name:|Modules linked in:|RIP:|RSP:|R[A-Z0-9]{2}:|EFLAGS:|FS:|GS:|CS:|CR[0-9]:|PKRU:|Code:|---\\\\[ end trace|</?(TASK|IRQ|NMI)>|[? ]*[a-zA-Z0-9_]+\\\\+0x[0-9a-f]+/0x)\")",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
