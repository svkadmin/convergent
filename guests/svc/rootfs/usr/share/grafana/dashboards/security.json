  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 2
      },
      "description": "Source: tools/facts boot: EFI SecureBoot=1 and SetupMode=0, kernel confidentiality lockdown, LUKS header against the accepted hash. These are boot-time facts, not continuous verification of the UKI or verity.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cv_secure_boot_verified)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "Secure Boot"
        },
        {
          "refId": "B",
          "expr": "max(cv_lockdown_enabled)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "confidentiality lockdown"
        },
        {
          "refId": "C",
          "expr": "max(cv_luks_header_matches_release)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "LUKS header"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
