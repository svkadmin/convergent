    {
      "id": 3,
      "type": "table",
      "title": "Collectors · now",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 8,
        "h": 6
      },
      "description": "Source: tools/facts boot, daily, NTS and audit collector success. One instant row per collector; a failed daily collector can still publish readable certificate figures. Checker is separate in the band above.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (collector) (cv_collector_success)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
