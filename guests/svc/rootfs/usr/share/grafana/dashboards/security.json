      "title": "Textfile freshness · now",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "description": "Source: node_exporter textfile mtimes across host, fw1/fw2 and wan. Boot facts age with this boot; daily facts refresh after 20 hours; audit facts refresh hourly; firewall/wan facts every minute; checker after boot/update and daily. No single age threshold fits them all.",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node,file) (time() - node_textfile_mtime_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
