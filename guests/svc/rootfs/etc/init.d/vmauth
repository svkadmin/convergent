#!/sbin/openrc-run
# Query-only router for local rules and host log queries.
description="Query router for MetricsQL and LogsQL"
supervisor=supervise-daemon
pidfile="/run/$RC_SVCNAME.pid"
retry="TERM/60/KILL/5"
no_new_privs=true
command=/usr/bin/vmauth
command_user=vmauth:vmauth
command_args="-httpListenAddr=127.0.0.1:8427 -httpListenAddr=100.80.2.10:9428 -auth.config=/etc/vmauth.yaml"
export GOMEMLIMIT=16MiB GOMAXPROCS=1
respawn_delay=5
respawn_max=5
respawn_period=60
output_logger="logger -t vmauth"
error_logger="logger -t vmauth"
umask=0027
depend() { need victoria-metrics victoria-logs; }
