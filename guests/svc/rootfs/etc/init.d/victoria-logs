#!/sbin/openrc-run
description="TLS-only syslog and host log queries"
supervisor=supervise-daemon
pidfile="/run/$RC_SVCNAME.pid"
retry="TERM/60/KILL/5"
no_new_privs=true
command=/usr/bin/victoria-logs
command_user=vmlogs:vmlogs
directory=/var/lib/victoria-logs
# pf permits 6514 from host/fw1/fw2/wan, 9428 from host ONLY. Grafana and
# vmalert's query router use loopback. No UDP/plaintext syslog listener.
# Size retention drops day partitions and can overshoot during the newest
# two days: host MUST also give this data volume a hard 6 GiB quota.
command_args="-httpListenAddr=127.0.0.1:9428 -httpListenAddr=100.80.2.10:9428
    -storageDataPath=/var/lib/victoria-logs -retentionPeriod=7d
    -retention.maxDiskSpaceUsageBytes=4GiB
    -memory.allowedBytes=24MiB -search.maxConcurrentRequests=1
    -search.maxQueryDuration=10s -search.maxQueryTimeRange=7d
    -syslog.listenAddr.tcp=100.80.2.10:6514 -syslog.tls -syslog.tlsMinVersion=TLS13
    -syslog.tlsCertFile=/etc/victoria-logs/tls/server.crt
    -syslog.tlsKeyFile=/etc/victoria-logs/tls/server.key
    -syslog.useRemoteIP.tcp -syslog.streamFields.tcp='[\"hostname\",\"app_name\"]'"
export GOMEMLIMIT=80MiB GOMAXPROCS=1
respawn_delay=5
respawn_max=5
respawn_period=60
output_logger="logger -t victoria-logs"
error_logger="logger -t victoria-logs"
umask=0027

depend() { need net; use syslog; }
start_pre() {
    # Host injects its locally issued certificate (SAN IP:100.80.2.10,
    # DNS:svc) and a unique private key into the running container before
    # start. Both root:vmlogs 0640; directory root:vmlogs 0750.
    # Install issuer CA on each sender; require chain + SAN validation,
    # TLS 1.3, RFC5424/RFC6587 (RFC3164 also accepted). No insecure-skip-verify or TOFU.
    # OSS VictoriaLogs provides server TLS; source admission is pf plus
    # Incus NIC binding, NOT unverified syslog hostname/app_name fields.
    for file in server.crt server.key; do
        /usr/local/sbin/svc-secret-check vmlogs "/etc/victoria-logs/tls/$file" || {
            eerror "missing/insecure host-injected syslog TLS file: $file"; return 1;
        }
    done
    checkpath -d -m 0750 -o vmlogs:vmlogs "$directory"
}
