#!/sbin/openrc-run
description="Single-node metrics, exactly five external scrape endpoints"
supervisor=supervise-daemon
pidfile="/run/$RC_SVCNAME.pid"
retry="TERM/60/KILL/5"
no_new_privs=true
command=/usr/bin/victoria-metrics
command_user=vmmetrics:vmmetrics
directory=/var/lib/victoria-metrics
# statfs only sees host free space, not the 2GiB quota: 14 days fit it; the qgroup alert warns before it fills.
# Data is flushed every 30 s, not 5 s: fewer disk writes; a crash loses at most 30 s.
command_args="-httpListenAddr=127.0.0.1:8428
    -storageDataPath=/var/lib/victoria-metrics -retentionPeriod=14d
    -inmemoryDataFlushInterval=30s
    -memory.allowedBytes=32MiB -search.maxMemoryPerQuery=8MiB
    -search.maxConcurrentRequests=2 -search.maxQueryDuration=10s
    -storage.maxHourlySeries=25000 -storage.maxDailySeries=50000
    -storage.minFreeDiskSpaceBytes=512MiB
    -promscrape.config=/etc/victoria-metrics/scrape.yaml
    -promscrape.maxScrapeSize=4MiB"
export GOMEMLIMIT=80MiB GOMAXPROCS=1
respawn_delay=5
respawn_max=5
respawn_period=60
output_logger="logger -t victoria-metrics"
error_logger="logger -t victoria-metrics"
umask=0027

depend() { need net convergent-seed; use syslog; }
start_pre() {
    # Inject metrics-only client cert/key and CA; server SAN DNS:host.
    for file in incus-ca.crt incus-client.crt incus-client.key; do
        /usr/local/sbin/svc-secret-check vmmetrics "/etc/victoria-metrics/tls/$file" || {
            eerror "missing/insecure host-injected Incus TLS file: $file"; return 1;
        }
    done
    checkpath -d -m 0750 -o vmmetrics:vmmetrics "$directory"
}
