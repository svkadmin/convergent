#!/bin/sh
# ARCHITECTURE 3.4; host-menu start/stop.
set -eu
[ "$(id -u)" = 0 ] || { echo "grafana: run as root on host" >&2; exit 1; }
[ "$#" = 1 ] || { echo "usage: grafana start|stop" >&2; exit 2; }
case $1 in
    start)
        incus --project default config set svc limits.memory 768MiB
        if ! incus --project default exec svc -- rc-service grafana start; then
            if ! incus --project default exec svc -- rc-service grafana status; then
                incus --project default config set svc limits.memory 350MiB
            fi
            exit 1
        fi
        ;;
    stop)
        incus --project default exec svc -- rc-service grafana stop
        incus --project default config set svc limits.memory 350MiB
        ;;
    *) echo "usage: grafana start|stop" >&2; exit 2 ;;
esac
