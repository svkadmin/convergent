#!/sbin/openrc-run
# Networking and listeners require a loaded filter.
description="wan packet filter"

depend() {
	need localmount
	after modules sysctl
	before networking iwd sshd
}

start() {
	ebegin "Loading /etc/nftables.nft"
	nft -f /etc/nftables.nft
	eend $?
}

stop() {
	# The rules stay in force through shutdown.
	return 0
}
