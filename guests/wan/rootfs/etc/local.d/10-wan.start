#!/bin/sh
# Other users' processes are hidden (a passphrase is briefly on iwctl's command line), the
# state directories exist, and the first check runs without waiting for cron.
mount -o remount,hidepid=2 /proc
mkdir -p /run/wan /run/node_exporter
chmod 755 /run/wan /run/node_exporter
/usr/local/sbin/wan-check --delay 5 </dev/null >/dev/null 2>&1 &
exit 0
