# ARCHITECTURE 4.1; upstream DHCP supplies the default route.
auto lo
iface lo inet loopback

# Reach internal segments through CARP.
auto eth0
iface eth0 inet static
	address 100.80.0.10/28
	up ip route add 100.80.0.0/16 via 100.80.0.1 dev eth0

# Approved USB uplink; DHCP without a hostname.
allow-hotplug eth1
iface eth1 inet dhcp
