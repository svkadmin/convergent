#!/usr/sbin/nft -f
# ARCHITECTURE 3.2, 4.2, 10
flush ruleset

define transit     = "eth0"
define upstream    = { "wlan0", "eth1" }
define internal    = 100.80.0.0/16
define wan_addr    = 100.80.0.10
define host_addr   = 100.80.1.10
define svc_addr    = 100.80.2.10
define portal_addr = 100.80.3.11
define fw_addrs    = { 100.80.0.1, 100.80.0.2, 100.80.0.3 }

table inet wan {
	# Portal DNS destination map; empty means off.
	map portal_dns {
		type ipv4_addr : ipv4_addr
	}

	# Check the resolver on every DNAT packet, including existing flows.
	set portal_ns {
		type ipv4_addr
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif lo accept
		ct state invalid drop
		iifname $upstream udp sport 67 udp dport 68 accept
		iifname $upstream drop
		ct state established,related accept
		iifname $transit ip saddr $host_addr ip daddr $wan_addr tcp dport 22 ct state new accept
		iifname $transit ip saddr $svc_addr ip daddr $wan_addr tcp dport 9100 ct state new accept
		iifname $transit ip saddr $fw_addrs ip daddr $wan_addr icmp type echo-request limit rate 20/second accept
	}

	# Transit/upstream only; never forward into the internal range.
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state invalid drop
		iifname $transit ct status dnat ip daddr != @portal_ns drop
		iifname $upstream oifname $transit ct state established,related accept
		iifname $transit oifname $upstream ip saddr $internal ip daddr != $internal accept
	}

	chain output {
		type filter hook output priority filter; policy drop;
		oif lo accept
		ct state invalid drop
		oifname $upstream udp sport 68 udp dport 67 accept
		oifname $upstream drop
		ct state established,related accept
		oifname $transit ip daddr $svc_addr tcp dport 6514 ct state new accept
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname $transit ip saddr $portal_addr ip daddr $wan_addr meta l4proto { tcp, udp } th dport 53 dnat ip to ip daddr map @portal_dns
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		iifname $transit oifname $upstream ip saddr $internal masquerade
	}
}
