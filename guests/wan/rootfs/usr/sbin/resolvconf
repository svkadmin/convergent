#!/bin/sh
# iwd DNS hook: record portal resolvers and check lease overlap.
set -eu
umask 022
d=/run/wan
mkdir -p "$d"
case ${1:-} in
-a | -d) ;;
*) exit 1 ;;
esac
name=${2:-}
case $name in
'' | *[!A-Za-z0-9._-]*) exit 1 ;;
esac
if [ "$1" = -a ]; then
	cat > "$d/resolv.$name.tmp"
	mv "$d/resolv.$name.tmp" "$d/resolv.$name"
else
	rm -f "$d/resolv.$name"
fi
# Detached: iwd waits for this process, and wan-check talks to iwd.
setsid /usr/local/sbin/wan-check --delay 2 </dev/null >/dev/null 2>&1 &
exit 0
