#!/bin/sh
# udhcpc post-* hook; interface/dns are exported by default.script.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
case ${interface:-} in
'' | *[!A-Za-z0-9_-]*) exit 1 ;;
esac
case ${1:-} in
set)
	for s in ${dns:-}; do
		echo "nameserver $s"
	done | /usr/sbin/resolvconf -a "$interface.dns"
	;;
clear)
	/usr/sbin/resolvconf -d "$interface.dns"
	;;
*)
	echo "usage: wan-dhcp-dns set|clear" >&2
	exit 2
	;;
esac
