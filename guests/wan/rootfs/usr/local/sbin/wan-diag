#!/bin/sh
# ARCHITECTURE 3.2; read-only uplink facts for the host (ssh wan diag): no command takes input.
# wan itself never talks upstream (output chain), so reachability is tested from the firewalls.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
echo "== addresses"; ip -4 -o addr | awk '{print $2, $4}'
echo "== routes"; ip -4 route
echo "== forwarding"; cat /proc/sys/net/ipv4/ip_forward
echo "== nat"; nft list chain inet wan postrouting 2>&1 | grep -E 'masquerade|counter'
echo "== upstream dns"; cat /run/wan/resolv.* 2>/dev/null || echo none
