#!/bin/sh
# ARCHITECTURE 3.2; read-only uplink facts for the host (ssh wan diag): no command takes input.
# wan never talks upstream (output chain), so the firewalls test reachability.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
echo "== addresses"; ip -4 -o addr | awk '{print $2, $4}'
echo "== routes"; ip -4 route
# Fixed management-endpoint probe; never accept a destination from SSH input.
ui_result=0
timeout 5 openssl s_client -connect 100.80.1.10:8443 -brief </dev/null >/dev/null 2>&1 || ui_result=$?
case $ui_result in
    0) echo 'incus-ui-8443: allow' ;;
    1|124|143) echo 'incus-ui-8443: deny' ;;
    *) echo 'incus-ui-8443: error' ;;
esac
# End Incus UI checks.
echo "== forwarding"; cat /proc/sys/net/ipv4/ip_forward
echo "== nat"; nft list chain inet wan postrouting 2>&1 | grep -E 'masquerade|counter'
echo "== upstream dns"; cat /run/wan/resolv.* 2>/dev/null || echo none
echo "== links"; ip -o link | cut -c 1-110
echo "== dhcp"; ps -o pid,args | grep -E '[u]dhcpc|[d]hcpcd' || echo 'no DHCP client'
echo "== ifstate"; cat /run/ifstate* 2>/dev/null || echo none
echo "== overlap refusal"
if [ -s /run/wan/refused ]; then
	awk '{print "refused interface=" $1 " subnet=" $2}' /run/wan/refused
fi
for record in /run/wan/dhcp-overlap.*; do
	[ -s "$record" ] || continue
	awk -v ifc="${record##*.}" '{print "refused interface=" ifc " subnet=" $0}' "$record"
done
echo "Choose a non-overlapping Wi-Fi network, or move the wired adapter and retry from the host:"
echo "sudo ssh -F /etc/convergent/ssh_config wan 'check retry'"
