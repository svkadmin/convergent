#!/bin/sh
# ARCHITECTURE 3.2; allow only the exact SSH commands below.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
case ${SSH_ORIGINAL_COMMAND:-} in
topology) exec cat /etc/convergent/topology.sha256 ;;
"seed-status")
	exec cat /var/lib/convergent/seeded
	;;
"syslog-ca")
	set -eu
	umask 077
	ca=/etc/syslog-ng/svc-ca.pem
	cat >"$ca.new"
	openssl x509 -in "$ca.new" -noout >/dev/null
	chmod 644 "$ca.new"
	mv "$ca.new" "$ca"
	sync
	exec rc-service syslog-ng reload
	;;
"wifi list" | "wifi scan" | "wifi status" | "wifi auto" | "wifi disconnect" | \
"wifi connect" | "wifi connect-hidden" | "wifi add" | "wifi add-hidden" | "wifi forget")
	exec /usr/local/sbin/wan-wifi "${SSH_ORIGINAL_COMMAND#wifi }"
	;;
"portal on" | "portal off" | "portal status")
	exec /usr/local/sbin/wan-portal "${SSH_ORIGINAL_COMMAND#portal }"
	;;
"diag")
	exec /usr/local/sbin/wan-diag
	;;
"check")
	exec /usr/local/sbin/wan-check
	;;
"check retry")
	exec /usr/local/sbin/wan-check retry
	;;
esac
echo "wan-ssh: command refused" >&2
exit 126
