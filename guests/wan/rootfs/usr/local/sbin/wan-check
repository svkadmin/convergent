#!/bin/sh
# ARCHITECTURE 3.2
# Refuse overlaps, latch UpstreamOverlap until a safe lease, expire portal mode.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
. /etc/wan/wan.conf
. /usr/local/lib/wan-lib.sh

case ${1:-}:$# in
:0 | retry:1) ;;
--delay:1 | --delay:2) sleep "${2:-2}" ;;
*) echo "usage: wan-check [retry | --delay [seconds]]" >&2; exit 2 ;;
esac

d=/run/wan
m=/run/node_exporter
mkdir -p "$d" "$m"
chmod 755 "$d" "$m"
exec 9> "$d/check.lock"
# A new lease's check waits out a running one, which may have read the addresses before it.
case ${1:-} in
--delay) flock -w 30 9 || exit 1 ;;
*) flock -n 9 || { [ "${1:-}" != retry ]; exit $?; } ;;
esac

# Drop one uplink's refusal; the others stay latched.
unrefuse() {
	[ -e "$d/refused" ] || return 0
	grep -v "^$1 " "$d/refused" > "$d/refused.new"
	case $? in
	0) mv "$d/refused.new" "$d/refused" ;;
	1) rm -f "$d/refused" "$d/refused.new" ;;
	*) rm -f "$d/refused.new"; return 1 ;;
	esac
}

# A refused wired uplink: no DHCP client, no address, link down until a safe lease or a retry.
wired_down() {
	ifdown --force "$1" 9>&- >/dev/null 2>&1 || :
	ip addr flush dev "$1" 2>/dev/null
	ip link set dev "$1" down 2>/dev/null
}

rc=0
# Retry only configured wired uplinks; keep the alarm until a safe lease arrives.
if [ "${1:-}" = retry ]; then
	for ifc in $UP_IFS; do
		[ "$ifc" != "$WIFI_IF" ] && [ "$ifc" != "$TRANSIT_IF" ] || continue
		[ -e "/sys/class/net/$ifc" ] || continue
		ifdown --force "$ifc" 9>&- >/dev/null 2>&1 || exit 1
		ifup "$ifc" 9>&- >/dev/null 2>&1 || rc=1
		# The retry's own carrier changes are no replug: the next check keeps the new lease.
		cat "/sys/class/net/$ifc/ifindex" "/sys/class/net/$ifc/carrier_changes" >"$d/link.$ifc" 2>/dev/null || :
	done
fi

# Remember carrier changes too, including unplug/replug between checks.
for ifc in $UP_IFS; do
	[ "$ifc" != "$WIFI_IF" ] && [ "$ifc" != "$TRANSIT_IF" ] || continue
	if [ ! -e "/sys/class/net/$ifc" ]; then
		# Drop ifup's remembered state and its route refusal: a replug starts a new DHCP client.
		ifdown --force "$ifc" 9>&- >/dev/null 2>&1 || :
		rm -f "$d/link.$ifc" "$d/dhcp-overlap.$ifc"
		continue
	fi
	grep -q "^$ifc " "$d/refused" 2>/dev/null && continue
	link=$(cat "/sys/class/net/$ifc/ifindex" "/sys/class/net/$ifc/carrier_changes") || continue
	previous=$(cat "$d/link.$ifc" 2>/dev/null || :)
	if [ "$link" != "$previous" ] || ! ip -4 -o addr show dev "$ifc" scope global | grep -q ' inet '; then
		ifdown --force "$ifc" 9>&- >/dev/null 2>&1 || :
	fi
	ifup "$ifc" 9>&- >/dev/null 2>&1 || :
	cat "/sys/class/net/$ifc/ifindex" "/sys/class/net/$ifc/carrier_changes" >"$d/link.$ifc"
done

good=0
bad=0
for ifc in $UP_IFS; do
	ifc_good=0 ifc_bad=0
	route_overlap=$(cat "$d/dhcp-overlap.$ifc" 2>/dev/null || :)
	for cidr in $(ip -4 -o addr show dev "$ifc" scope global 2>/dev/null | awk '{print $4}') $route_overlap; do
		if overlaps_internal "${cidr%/*}" "${cidr#*/}"; then
			bad=1 ifc_bad=1
			if [ -n "$route_overlap" ] && grep -q "^$ifc " "$d/refused" 2>/dev/null; then
				# Latched already: no new alert, but a retried wired uplink goes down again.
				[ "$ifc" = "$WIFI_IF" ] || [ "$(cat "/sys/class/net/$ifc/operstate" 2>/dev/null)" = down ] || wired_down "$ifc"
				continue
			fi
			# One line per interface: another uplink's refusal stays latched.
			{ grep -v "^$ifc " "$d/refused" 2>/dev/null; echo "$ifc $cidr $(date +%s)"; } > "$d/refused.new"
			mv "$d/refused.new" "$d/refused"
			logger -t convergent-alert -p local0.crit \
				"UpstreamOverlap interface=$ifc lease=$cidr internal=$INTERNAL_NET action=refused"
			if [ "$ifc" = "$WIFI_IF" ]; then
				if ! timeout 10 iwctl station "$ifc" disconnect >/dev/null; then
					rc=1
					logger -t wan-check "disconnect failed interface=$ifc; removing IPv4 routes and addresses"
					ip -4 route flush dev "$ifc" || logger -t wan-check "route cleanup failed interface=$ifc"
					ip -4 addr flush dev "$ifc" || logger -t wan-check "address cleanup failed interface=$ifc"
				fi
			else
				wired_down "$ifc"
			fi
		else
			good=1 ifc_good=1
		fi
	done
	# A safe lease on this uplink, or its removal, clears its refusal.
	if [ "$ifc_bad" = 0 ] && { [ "$ifc_good" = 1 ] || [ ! -e "/sys/class/net/$ifc" ]; }; then
		unrefuse "$ifc" || rc=1
	fi
done

# A disconnected Wi-Fi's refusal also ends with a safe uplink; a wired one keeps its link down until then.
if [ "$bad" -eq 0 ] && [ "$good" -eq 1 ]; then
	unrefuse "$WIFI_IF" || rc=1
fi

/usr/local/sbin/wan-portal expire || rc=1

overlap=0
[ -e "$d/refused" ] && overlap=1
portal=0
[ -e "$d/portal" ] && portal=1
{
	echo "# TYPE convergent_wan_upstream_overlap gauge"
	echo "convergent_wan_upstream_overlap $overlap"
	echo "# TYPE convergent_wan_upstream_up gauge"
	echo "convergent_wan_upstream_up $good"
	echo "# TYPE convergent_wan_portal_mode gauge"
	echo "convergent_wan_portal_mode $portal"
	# Association changes observed at this cadence, without SSID/BSSID labels.
	radio=$(timeout 5 iw dev "$WIFI_IF" link 2>/dev/null || :)
	bssid=$(printf '%s\n' "$radio" | awk '$1 == "Connected" && $2 == "to" && $3 ~ /^[0-9a-f:]+$/ {print $3; exit}')
	roams=$(cat "$d/wifi.roams" 2>/dev/null || echo 0)
	case $roams in ''|*[!0-9]*) roams=0 ;; esac
	last=$(cat "$d/wifi.bssid" 2>/dev/null || :)
	connected=0
	if [ -n "$bssid" ]; then
		connected=1
		[ -z "$last" ] || [ "$last" = "$bssid" ] || roams=$((roams + 1))
		printf '%s\n' "$radio" | awk -f /usr/local/lib/wan-radio.awk
	fi
	printf '%s\n' "$bssid" >"$d/wifi.bssid"
	printf '%s\n' "$roams" >"$d/wifi.roams"
	echo "convergent_wifi_connected $connected"
	echo "convergent_wifi_roams_total $roams"
	echo "convergent_wifi_timestamp_seconds $(date +%s)"
} > "$m/wan.prom.tmp"
chmod 644 "$m/wan.prom.tmp"
mv "$m/wan.prom.tmp" "$m/wan.prom"
exit "$rc"
