#!/bin/sh
# ARCHITECTURE 3.2, 9
# Close both DNS map and resolver set, including existing flows.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
. /etc/wan/wan.conf
. /usr/local/lib/wan-lib.sh

d=/run/wan
die() { echo "wan-portal: $*" >&2; exit 1; }
mkdir -p "$d" || die "could not create $d"
exec 8> "$d/portal.lock"
flock -x 8 || die "could not lock portal mode"

# A disconnected uplink can retain its lease records.
resolver() {
	routes=$(ip -4 route show default) || return 1
	ifc=$(printf '%s\n' "$routes" | awk -v transit="$TRANSIT_IF" '
		$1 == "default" && $0 !~ /linkdown/ {
			for (i=1;i<NF;i++) if ($i == "dev" && $(i+1) != transit) {print $(i+1); exit}
		}')
	case $ifc in '' | *[!A-Za-z0-9_-]*) return 1 ;; esac
	ns=$(awk '$1 == "nameserver" {print $2; exit}' "$d/resolv.$ifc.dns") || return 1
	is_ipv4 "$ns" || return 1
	! overlaps_internal "$ns" 32 || return 1
	echo "$ns"
}

close_map() {
	nft -f - <<EOF
flush map inet wan portal_dns
flush set inet wan portal_ns
flush set inet wan portal_src
EOF
}

set_map() {
	ns=$(resolver) || return 1
	nft -f - <<EOF || return 1
flush map inet wan portal_dns
flush set inet wan portal_ns
add element inet wan portal_dns { $TRANSIT_ADDR : $ns }
add element inet wan portal_ns { $ns }
flush set inet wan portal_src
add element inet wan portal_src { $PORTAL_BROWSER }
EOF
	echo "$ns"
}

case ${1:-} in
on)
	mkdir -p "$d"
	ns=$(set_map) || {
		close_map || die "could not close portal DNS"
		rm -f "$d/portal"
		die "no usable upstream resolver (no lease with DNS)"
	}
	date +%s > "$d/portal"
	logger -t wan-portal "portal mode on, resolver $ns for $PORTAL_BROWSER, at most $PORTAL_MAX_MIN minutes"
	;;
off)
	close_map || die "could not close portal DNS"
	rm -f "$d/portal"
	logger -t wan-portal "portal mode off"
	;;
refresh)

	[ -e "$d/portal" ] || exit 0
	set_map >/dev/null || {
		close_map || die "could not close portal DNS"
		rm -f "$d/portal"
		logger -t wan-portal "portal mode off, the resolver is gone"
	}
	;;
status)
	if [ -e "$d/portal" ]; then
		ns=$(resolver) || die "no usable upstream resolver"
		echo "on $ns"
	else
		echo off
	fi
	;;
*)
	echo "usage: wan-portal on|off|refresh|status" >&2
	exit 2
	;;
esac
