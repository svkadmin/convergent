#!/bin/sh
# ARCHITECTURE 3.2
# Read SSID then optional passphrase from stdin; credentials stay in wan.
# iwctl briefly receives the passphrase in argv; /proc uses hidepid=2.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
. /etc/wan/wan.conf
LC_ALL=C
export LC_ALL

die() { echo "wan-wifi: $*" >&2; exit 1; }

esc=$(printf '\033')

# Run with a deadline; strip iwctl colors and preserve its status.
run() {
	_out=$(timeout "$@" 2>&1)
	_rc=$?
	printf '%s\n' "$_out" | sed "s/${esc}\[[0-9;]*[A-Za-z]//g" | tr -d '\000-\010\013-\037\177'
	return $_rc
}

read_ssid() {
	IFS= read -r ssid || true
	[ -n "$ssid" ] || die "SSID missing"
	[ "$(printf %s "$ssid" | wc -c)" -le 32 ] || die "SSID longer than 32 bytes"
	if printf %s "$ssid" | grep -q '[[:cntrl:]]'; then
		die "SSID has control characters"
	fi
}

read_pass() {
	pass=
	IFS= read -r pass || true
	[ -n "$pass" ] || return 0
	if [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
		die "passphrase must be 8 to 63 characters"
	fi
	if printf %s "$pass" | grep -q '[[:cntrl:]]'; then
		die "passphrase has control characters"
	fi
}

join() {
	if [ -n "$pass" ]; then
		run 45 iwctl --passphrase "$pass" station "$WIFI_IF" "$1" "$ssid"
	else
		run 45 iwctl station "$WIFI_IF" "$1" "$ssid"
	fi
}

case ${1:-} in
list)
	run 10 iwctl known-networks list
	;;
scan)
	run 10 iwctl station "$WIFI_IF" scan >/dev/null
	sleep 4
	run 10 iwctl station "$WIFI_IF" get-networks
	;;
status)
	run 10 iwctl station "$WIFI_IF" show
	ip -4 -o addr show dev "$WIFI_IF" 2>/dev/null | awk '{print "address", $4}'
	;;
add)
	read_ssid
	read_pass
	join connect
	;;
add-hidden)
	read_ssid
	read_pass
	join connect-hidden
	;;
connect)
	read_ssid
	run 45 iwctl station "$WIFI_IF" connect "$ssid"
	;;
connect-hidden)
	read_ssid
	run 45 iwctl station "$WIFI_IF" connect-hidden "$ssid"
	;;
forget)
	read_ssid
	run 10 iwctl known-networks "$ssid" forget
	;;
disconnect)
	run 10 iwctl station "$WIFI_IF" disconnect
	;;
auto)
	run 10 iwctl station "$WIFI_IF" autoconnect on
	;;
*)
	echo "usage: wan-wifi list|scan|status|add|add-hidden|connect|connect-hidden|forget|disconnect|auto" >&2
	exit 2
	;;
esac
