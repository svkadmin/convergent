#!/bin/sh
# ARCHITECTURE 3.2
# Read SSID, passphrase for add, then optional security from stdin.
# iwctl briefly receives the passphrase in argv; /proc uses hidepid=2.
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
. /etc/wan/wan.conf
LC_ALL=C
export LC_ALL

die() { echo "wan-wifi: $*" >&2; exit 1; }

esc=$(printf '\033')

# Run with a deadline; strip iwctl colors and preserve its status.
run() {
	_out=$(timeout "$@" 2>&1)
	_rc=$?
	printf '%s\n' "$_out" | sed "s/${esc}\[[0-9;]*[A-Za-z]//g" | tr -d '\000-\010\013-\037\177'
	return $_rc
}

read_ssid() {
	IFS= read -r ssid || true
	[ -n "$ssid" ] || die "SSID missing"
	case $ssid in -*) die "SSID must not start with -" ;; esac
	[ "$(printf %s "$ssid" | wc -c)" -le 32 ] || die "SSID longer than 32 bytes"
	if printf %s "$ssid" | grep -q '[[:cntrl:]]'; then
		die "SSID has control characters"
	fi
}

read_pass() {
	pass=
	IFS= read -r pass || true
	[ -n "$pass" ] || return 0
	if [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
		die "passphrase must be 8 to 63 characters"
	fi
	if printf %s "$pass" | grep -q '[[:cntrl:]]'; then
		die "passphrase has control characters"
	fi
}

read_security() {
	security=
	IFS= read -r security || true
	case $security in ''|open|psk|8021x) ;; *) die "invalid security type" ;; esac
}

join() {
	set -- "$1" "$ssid"
	[ "$1" != connect ] || [ -z "$security" ] || set -- "$@" "$security"
	if [ -n "$pass" ]; then
		reply=$(run 45 iwctl --passphrase "$pass" station "$WIFI_IF" "$@")
	else
		reply=$(run 45 iwctl station "$WIFI_IF" "$@")
	fi
	rc=$?
	if [ "$rc" != 0 ] && [ "$1" = connect-hidden ]; then
		case $reply in
		*AlreadyProvisioned*|*"Already provisioned"*) join connect; return $? ;;
		esac
	fi
	printf '%s\n' "$reply"
	return "$rc"
}

pass= security=
case ${1:-} in
list)
	run 10 iwctl known-networks list
	;;
scan)
	run 10 iwctl station "$WIFI_IF" scan >/dev/null || exit $?
	deadline=$(($(date +%s) + 15))
	while :; do
		remaining=$((deadline - $(date +%s)))
		[ "$remaining" -gt 0 ] || die "scan timed out"
		reply=$(run "$remaining" iwctl station "$WIFI_IF" show) || exit $?
		case $(printf '%s\n' "$reply" | awk '$1 == "Scanning" {print $2}') in
		no) break ;;
		yes) sleep 1 ;;
		*) die "scan status unavailable" ;;
		esac
	done
	run 10 iwctl station "$WIFI_IF" get-networks
	;;
status)
	run 10 iwctl station "$WIFI_IF" show
	rc=$?
	if addresses=$(ip -4 -o addr show dev "$WIFI_IF" 2>/dev/null); then
		printf '%s\n' "$addresses" | awk 'NF {print "address", $4}'
	else
		[ "$rc" -ne 0 ] || rc=1
	fi
	exit "$rc"
	;;
add)
	read_ssid
	read_pass
	read_security
	join connect
	;;
add-hidden)
	read_ssid
	read_pass
	read_security
	join connect-hidden
	;;
connect)
	read_ssid
	read_security
	join connect
	;;
connect-hidden)
	read_ssid
	read_security
	join connect-hidden
	;;
forget)
	read_ssid
	run 10 iwctl known-networks "$ssid" forget
	;;
disconnect)
	run 10 iwctl station "$WIFI_IF" disconnect
	;;
auto)
	run 10 iwctl station "$WIFI_IF" autoconnect on
	;;
*)
	echo "usage: wan-wifi list|scan|status|add|add-hidden|connect|connect-hidden|forget|disconnect|auto" >&2
	exit 2
	;;
esac
