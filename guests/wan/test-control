#!/bin/sh
# Offline Wi-Fi recovery and locked portal expiry.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
export work
for name in wan-wifi wan-portal; do
    sed '/^PATH=/d; /^\. /d; s|^d=/run/wan$|d=$work/run|' \
        "$here/rootfs/usr/local/sbin/$name" >"$work/$name"
    sh -n "$work/$name"
done
cat >"$work/wifi-driver" <<'EOF'
WIFI_IF=wlan0
date() { cat "$work/clock"; }
sleep() { echo "$(($(date) + $1))" >"$work/clock"; }
timeout() {
    printf '%s\n' "$*" >>"$work/calls"
    bound=$1; shift
    case $* in
    'rc-service iwd restart') [ "$bound" = 10 ] || exit 97; return "$restart_rc" ;;
    iwctl*) "$@" ;;
    *) exit 97 ;;
    esac
}
iwctl() {
    case $* in
    'station wlan0 connect-hidden saved') echo "$provisioned"; return 1 ;;
    'station wlan0 scan')
        [ "$bound" = 10 ] || exit 97
        [ "$fault" != scan ] || { echo 'Operation failed: Busy'; return "$failure_rc"; }
        sleep "$init_delay"
        ;;
    'station wlan0 show')
        [ "$bound" = "$((100 + init_delay + 15 - $(date)))" ] || exit 97
        case $fault in
        show) echo 'Operation failed: NotAvailable'; return "$failure_rc" ;;
        unknown) echo 'Scanning unknown' ;;
        stalled) echo 'Scanning yes' ;;
        *)
            if [ "$(date)" -lt "$scan_done" ]; then echo 'Scanning yes'
            else echo 'Scanning no'; touch "$work/ready"; fi
            ;;
        esac
        ;;
    'station wlan0 connect saved') [ -e "$work/ready" ] || return 96; echo connected ;;
    'station wlan0 get-networks')
        [ "$bound" = 10 ] && [ -e "$work/ready" ] || return 96
        echo networks
        ;;
    *) exit 97 ;;
    esac
}
. "$work/wan-wifi"
EOF
sh -n "$work/wifi-driver"
export fault provisioned restart_rc
export init_delay scan_done failure_rc
init_delay=2 scan_done=104 failure_rc=124
restart_rc=0
for provisioned in AlreadyProvisioned 'Already provisioned'; do
    for fault in none scan show unknown stalled; do
        echo 100 >"$work/clock"
        : >"$work/calls"
        rm -f "$work/ready"
        rc=0
        printf 'saved\n' | sh "$work/wifi-driver" connect-hidden >"$work/out" 2>"$work/err" || rc=$?
        if [ "$fault" = none ]; then
            [ "$rc" = 0 ]
            grep -qx connected "$work/out"
            printf '%s\n' '45 iwctl station wlan0 connect-hidden saved' \
                '45 iwctl station wlan0 connect saved' \
                '10 iwctl station wlan0 scan' '15 iwctl station wlan0 show' \
                '14 iwctl station wlan0 show' '13 iwctl station wlan0 show' \
                '45 iwctl station wlan0 connect saved' >"$work/want"
            cmp "$work/want" "$work/calls"
        else
            [ "$rc" != 0 ]
            case $fault in
            scan|show) [ "$rc" = 124 ] ;;
            *) [ "$rc" = 1 ]; grep -q '^wan-wifi: scan' "$work/err" ;;
            esac
            [ "$(grep -c 'station wlan0 connect saved' "$work/calls")" = 1 ]
            [ "$(cat "$work/clock")" -le 117 ]
            [ "$fault" != stalled ] || grep -qx 'wan-wifi: scan timed out' "$work/err"
        fi
    done
done
# A cached hidden network connects without a scan (a busy scan must not block it).
fault=scan
echo 100 >"$work/clock"
: >"$work/calls"
touch "$work/ready"
printf 'saved\n' | sh "$work/wifi-driver" connect-hidden >"$work/out"
grep -qx connected "$work/out"
printf '%s\n' '45 iwctl station wlan0 connect-hidden saved' '45 iwctl station wlan0 connect saved' >"$work/want"
cmp "$work/want" "$work/calls"
# Initiation and completion have separate budgets in the scan command.
init_delay=8 scan_done=116
for fixture in none:0 scan:7 scan:124 show:9 show:124 unknown:1 stalled:1; do
    fault=${fixture%:*} failure_rc=${fixture#*:}
    echo 100 >"$work/clock"
    : >"$work/calls"
    rm -f "$work/ready"
    rc=0
    sh "$work/wifi-driver" scan >"$work/out" 2>"$work/err" || rc=$?
    [ "$rc" = "$failure_rc" ]
    if [ "$fault" = none ]; then
        grep -qx networks "$work/out"
        [ "$(cat "$work/clock")" = 116 ]
        {
            echo '10 iwctl station wlan0 scan'
            for bound in 15 14 13 12 11 10 9 8 7; do
                echo "$bound iwctl station wlan0 show"
            done
            echo '10 iwctl station wlan0 get-networks'
        } >"$work/want"
        cmp "$work/want" "$work/calls"
    else
        if grep -q get-networks "$work/calls"; then exit 1; fi
        [ "$fault" != scan ] || grep -qx 'wan-wifi: scan request failed: Operation failed: Busy' "$work/err"
        [ "$fault" != show ] || grep -qx 'wan-wifi: scan status failed: Operation failed: NotAvailable' "$work/err"
        [ "$fault" != stalled ] || {
            [ "$(cat "$work/clock")" = 123 ]
            grep -qx 'wan-wifi: scan timed out' "$work/err"
        }
    fi
done
for restart_rc in 0 1 124; do
    : >"$work/calls"
    rc=0
    sh "$work/wifi-driver" auto >"$work/out" 2>"$work/err" || rc=$?
    printf '10 rc-service iwd restart\n' >"$work/want"
    cmp "$work/want" "$work/calls"
    if [ "$restart_rc" = 0 ]; then [ "$rc" = 0 ]
    else
        [ "$rc" != 0 ]
        grep -qx 'wan-wifi: iwd restart failed or timed out' "$work/err"
    fi
done
echo 'wan-wifi: delayed scan, hidden discovery and checked restart fixtures passed'

mkdir "$work/run"
cat >"$work/portal-driver" <<'EOF'
TRANSIT_IF=eth0 TRANSIT_ADDR=100.80.0.10 PORTAL_BROWSER=100.80.3.11 PORTAL_MAX_MIN=30
locked=0
flock() {
    [ "$*" = '-x 8' ] && [ "$locked" = 0 ] || exit 97
    # A replacement session wins the lock before the delayed expiry request.
    [ "$fault" != renewed ] || echo 2999 >"$work/run/portal"
    locked=1
}
cat() {
    [ "$locked" = 1 ] || exit 97
    command cat "$@"
}
date() { [ "$locked" = 1 ] || exit 97; echo 3000; }
ip() {
    [ "$*" = '-4 route show default' ] || exit 97
    [ "$fault" != resolver ] || return 1
    echo 'default via 192.168.1.1 dev wlan0'
}
is_ipv4() { [ "$1" = 192.168.1.1 ]; }
overlaps_internal() { return 1; }
nft() {
    [ "$locked" = 1 ] && [ "$*" = '-f -' ] || exit 97
    cat >"$work/nft"
    [ "$fault" != close ]
}
logger() { [ "$locked" = 1 ] || exit 97; }
. "$work/wan-portal"
EOF
sh -n "$work/portal-driver"
printf 'nameserver 192.168.1.1\n' >"$work/run/resolv.wlan0.dns"
cat >"$work/closed" <<'EOF'
flush map inet wan portal_dns
flush set inet wan portal_ns
flush set inet wan portal_src
EOF
cat >"$work/refreshed" <<'EOF'
flush map inet wan portal_dns
flush set inet wan portal_ns
add element inet wan portal_dns { 100.80.0.10 : 192.168.1.1 }
add element inet wan portal_ns { 192.168.1.1 }
flush set inet wan portal_src
add element inet wan portal_src { 100.80.3.11 }
EOF
for fault in expired fresh boundary renewed absent resolver close; do
    echo 1000 >"$work/run/portal"
    case $fault in
    fresh|resolver) echo 2999 >"$work/run/portal" ;;
    boundary) echo 1200 >"$work/run/portal" ;;
    absent) rm "$work/run/portal" ;;
    esac
    rm -f "$work/nft"
    rc=0
    sh "$work/portal-driver" expire >"$work/out" 2>"$work/err" || rc=$?
    if [ "$fault" = close ]; then
        [ "$rc" != 0 ]
        [ -e "$work/run/portal" ]
        grep -qx 'wan-portal: could not close portal DNS' "$work/err"
        continue
    fi
    [ "$rc" = 0 ]
    case $fault in
    expired|resolver) [ ! -e "$work/run/portal" ]; cmp "$work/closed" "$work/nft" ;;
    fresh|boundary|renewed)
        [ -e "$work/run/portal" ]; cmp "$work/refreshed" "$work/nft"
        [ "$fault" != renewed ] || [ "$(cat "$work/run/portal")" = 2999 ]
        ;;
    absent) [ ! -e "$work/nft" ] ;;
    esac
done
# The periodic checker must delegate the decision, and report a failed close.
sed -n '/^\/usr\/local\/sbin\/wan-portal expire/p' "$here/rootfs/usr/local/sbin/wan-check" |
    sed 's|/usr/local/sbin/wan-portal|portal|' >"$work/expire"
[ -s "$work/expire" ]
sh -n "$work/expire"
portal() { [ "$*" = expire ] || exit 97; return "$portal_rc"; }
for portal_rc in 0 1; do
    rc=0
    . "$work/expire"
    [ "$rc" = "$portal_rc" ]
done
echo 'wan-portal: locked expiry, renewal and resolver refresh fixtures passed'
# wan-check: a retry keeps its new lease, also one that comes after the retry with a carrier change; a retry
# still waiting for its lease is left running despite the old refusal's overlap file; a retried wired uplink
# whose route overlap recurs goes down again without a second alert; one already set down is left alone. A working
# second wired uplink keeps its lease throughout.
sed -e '/^PATH=/d' -e '/^\. /d' -e 's|^d=/run/wan$|d=$work/run|' -e 's|^m=/run/node_exporter$|m=$work/m|' \
    -e 's|/sys/class/net/|$work/sys/|g' -e 's|^/usr/local/sbin/wan-portal expire|wan_portal expire|' -e 's|/var/run/udhcpc\.|$work/run/udhcpc.|' \
    "$here/rootfs/usr/local/sbin/wan-check" >"$work/wan-check"
sh -n "$work/wan-check"
grep -q 'wan_portal expire' "$work/wan-check"
if grep -q '/sys/class/net/\|/run/wan' "$work/wan-check"; then exit 1; fi
cat >"$work/check-driver" <<'DRIVER'
UP_IFS='eth1 eth2 wlan0' WIFI_IF=wlan0 TRANSIT_IF=eth0 INTERNAL_NET=100.80.0.0/16
flock() { :; }
bump() { echo $(($(cat "$work/sys/$1/carrier_changes") + 1)) >"$work/sys/$1/carrier_changes"; }
set_down() { [ "$(cat "$work/sys/$1/flags")" = 0x1002 ] || bump "$1"; echo 0x1002 >"$work/sys/$1/flags"; }
ifdown() { echo "ifdown $*" >>"$work/calls"; set_down "$2"; rm -f "$work/addr.$2"; return "${ifdown_rc:-0}"; }
ifup() {
    echo "ifup $*" >>"$work/calls"
    # An uplink already up keeps its carrier.
    [ "$(cat "$work/sys/$1/flags")" = 0x1003 ] || bump "$1"
    echo 0x1003 >"$work/sys/$1/flags"
    case $1:$lease in
    eth1:safe) echo 192.168.5.10/24 >"$work/addr.$1"; rm -f "$work/run/dhcp-overlap.$1" ;;
    eth1:overlap) echo 100.80.1.0/24 >"$work/run/dhcp-overlap.$1" ;;
    esac
}
ip() {
    case $* in
    "-4 -o addr show dev "*" scope global") [ ! -f "$work/addr.$6" ] || echo "2: $6    inet $(cat "$work/addr.$6") brd x scope global $6" ;;
    "link set dev "*" down") echo "ip $*" >>"$work/calls"; set_down "$4" ;;
    *) echo "ip $*" >>"$work/calls" ;;
    esac
}
overlaps_internal() { case $1 in 100.80.*) return 0 ;; *) return 1 ;; esac; }
logger() { echo "logger $*" >>"$work/calls"; }
iwctl() { echo "iwctl $*" >>"$work/calls"; }
wan_portal() { :; }
. "$work/wan-check"
DRIVER
sh -n "$work/check-driver"
for case in keep stale stale-pid stuck pending late recur latched; do
    rm -rf "$work/run" "$work/m" "$work/sys" "$work/addr.eth1" "$work/addr.eth2" "$work/calls"
    mkdir -p "$work/run" "$work/sys/eth1" "$work/sys/eth2"
    echo 4 >"$work/sys/eth2/ifindex"
    echo 2 >"$work/sys/eth2/carrier_changes"
    echo 0x1003 >"$work/sys/eth2/flags"
    printf '4\n2\n' >"$work/run/link.eth2"
    echo 192.168.6.10/24 >"$work/addr.eth2"
    echo 3 >"$work/sys/eth1/ifindex"
    echo 6 >"$work/sys/eth1/carrier_changes"
    echo 0x1002 >"$work/sys/eth1/flags"
    echo 'eth1 100.80.1.0/24 1000' >"$work/run/refused"
    # Written before the refusal set the link down; the refusal was a route overlap.
    printf '3\n5\n' >"$work/run/link.eth1"
    echo 100.80.1.0/24 >"$work/run/dhcp-overlap.eth1"
    case $case in
    keep)
        lease=safe sh "$work/check-driver" retry
        if grep -q '^ifdown --force eth2$' "$work/calls"; then exit 1; fi
        [ ! -e "$work/run/refused" ]
        grep -q '^convergent_wan_upstream_up 1$' "$work/m/wan.prom"
        : >"$work/calls"
        lease=safe sh "$work/check-driver"
        if grep -q '^ifdown' "$work/calls"; then exit 1; fi
        [ -f "$work/addr.eth1" ] ;;
    stale)
        # The refusal killed the client, so ifdown finds no pidfile and fails: the retry still brings it up.
        ifdown_rc=1 lease=safe sh "$work/check-driver" retry
        grep -qx 'ifup eth1' "$work/calls"
        [ ! -e "$work/run/refused" ] ;;
    stuck)
        # A client ifdown cannot stop is not doubled: no ifup, and the retry fails.
        sh -c 'sleep 30; :' udhcpc -p "$work/run/udhcpc.eth1.pid" & echo $! >"$work/run/udhcpc.eth1.pid"
        rc=0; ifdown_rc=1 lease=safe sh "$work/check-driver" retry || rc=$?
        kill "$(cat "$work/run/udhcpc.eth1.pid")"
        [ "$rc" = 1 ]
        if grep -qx 'ifup eth1' "$work/calls"; then exit 1; fi ;;
    pending)
        # Not refused, no address, link unchanged: a live client is still discovering and is left alone.
        rm -f "$work/run/refused" "$work/run/dhcp-overlap.eth1"
        printf '3\n6\n' >"$work/run/link.eth1"
        sh -c 'sleep 30; :' udhcpc -p "$work/run/udhcpc.eth1.pid" & echo $! >"$work/run/udhcpc.eth1.pid"
        lease=none sh "$work/check-driver"
        kill "$(cat "$work/run/udhcpc.eth1.pid")"
        if grep -qx 'ifdown --force eth1' "$work/calls"; then exit 1; fi
        # Once that client is gone (its pidfile left behind, or naming another process), the next check restarts it.
        sleep 30 & echo $! >"$work/run/udhcpc.eth1.pid"
        lease=none sh "$work/check-driver"
        kill "$(cat "$work/run/udhcpc.eth1.pid")"
        grep -qx 'ifdown --force eth1' "$work/calls" ;;
    stale-pid)
        # A killed client left its pidfile: the retry goes on.
        echo 999999 >"$work/run/udhcpc.eth1.pid"
        ifdown_rc=1 lease=safe sh "$work/check-driver" retry
        grep -qx 'ifup eth1' "$work/calls" ;;
    late)
        lease=none sh "$work/check-driver" retry || :
        sed -n '/^ifup eth1$/,$p' "$work/calls" >"$work/after"
        if grep -q '^ifdown' "$work/after"; then exit 1; fi
        [ -e "$work/run/refused" ]
        # The lease comes a minute later, after a carrier change.
        echo 9 >"$work/sys/eth1/carrier_changes"
        echo 192.168.5.10/24 >"$work/addr.eth1"
        lease=none sh "$work/check-driver"
        [ ! -e "$work/run/refused" ]
        : >"$work/calls"
        lease=none sh "$work/check-driver"
        if grep -q '^ifdown' "$work/calls"; then exit 1; fi ;;
    recur|latched)
        arg=retry
        if [ "$case" = latched ]; then
            # A refused Wi-Fi stays up for iwd to join a safe network.
            arg=
            mkdir "$work/sys/wlan0"
            echo 0x1003 >"$work/sys/wlan0/flags"
            echo 'wlan0 100.80.2.0/24 1000' >>"$work/run/refused"
            echo 100.80.2.0/24 >"$work/run/dhcp-overlap.wlan0"
        fi
        lease=overlap sh "$work/check-driver" $arg || :
        [ -e "$work/run/refused" ]
        if grep -q 'convergent-alert' "$work/calls"; then exit 1; fi
        if [ "$case" = recur ]; then
            sed -n '/^ifup eth1$/,$p' "$work/calls" >"$work/after"
            grep -qx 'ifdown --force eth1' "$work/after"
            grep -qx 'ip link set dev eth1 down' "$work/after"
            [ "$(cat "$work/sys/eth1/flags")" = 0x1002 ]
        else
            if grep -q 'eth1\|wlan0' "$work/calls"; then exit 1; fi
        fi ;;
    esac
done
echo 'wan-check: retry and late leases, pending retry, recurring route overlap and latched refusal fixtures passed'
# A client's deconfig (every start and stop) drops its record and queues no check.
sed -e 's|/run/wan/|$work/run/|g' -e 's|/usr/sbin/resolvconf|resolvconf|g' \
    "$here/rootfs/usr/local/sbin/wan-dhcp-dns" >"$work/wan-dhcp-dns"
sh -n "$work/wan-dhcp-dns"
mkdir -p "$work/run"
echo 'nameserver 192.0.2.1' >"$work/run/resolv.eth1.dns"
: >"$work/calls"
(
    resolvconf() { echo "resolvconf $*" >>"$work/calls"; }
    interface=eth1
    set -- clear
    . "$work/wan-dhcp-dns"
)
[ ! -e "$work/run/resolv.eth1.dns" ]
[ ! -s "$work/calls" ]
echo 'wan-dhcp-dns: deconfig drops the record without queuing a check'
