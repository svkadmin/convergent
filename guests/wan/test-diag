#!/bin/sh
# Offline refusal and bounded local-log diagnostics.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
sh "$here/test-control"
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
mkdir "$work/run" "$work/log"
# Check only DHCP routes selected by default.script.
(
. "$here/rootfs/usr/local/lib/wan-lib.sh"
sed -n '/^	overlap=$/,/^	mkdir -p \/run\/wan$/p' "$here/rootfs/usr/local/sbin/wan-dhcp-dns" |
    sed '$d' >"$work/dhcp-overlap"
[ -s "$work/dhcp-overlap" ]
sh -n "$work/dhcp-overlap"
INTERNAL_NET=100.80.0.0/16
check_overlap() (
    expected=$1 router=$2 staticroutes=$3
    # The hook does not use errexit; inspect its overlap result.
    if . "$work/dhcp-overlap"; then :; fi
    [ "$overlap" = "$expected" ]
)
check_overlap '' 100.80.1.1 '0.0.0.0/0 192.168.1.1'
check_overlap '' 192.168.1.1 ''
check_overlap 100.80.1.1/32 100.80.1.1 ''
check_overlap 100.80.1.1/32 192.168.1.1 '0.0.0.0/0 100.80.1.1'
check_overlap 100.80.1.0/24 192.168.1.1 '100.80.1.0/24 192.168.1.1'
echo 'wan-dhcp-dns: selected route overlap fixtures passed'
)
# Exercise the refusal loop with IWD stalled and independent cleanup failures.
(
. "$here/rootfs/usr/local/lib/wan-lib.sh"
sed -n '/^good=0$/,/^if \[ "\$bad" -eq 0 \]/p' "$here/rootfs/usr/local/sbin/wan-check" |
    sed '$d' >"$work/refuse"
[ -s "$work/refuse" ]
sh -n "$work/refuse"
d=$work/run UP_IFS=wlan0 WIFI_IF=wlan0 INTERNAL_NET=100.80.0.0/16
logger() { printf '%s\n' "$*" >>"$work/messages"; }
timeout() { [ "$1" = 10 ] || exit 97; shift; "$@"; }
iwctl() {
    [ "$*" = 'station wlan0 disconnect' ] || exit 97
    echo disconnect >>"$work/calls"
    if [ "$fault" != none ]; then echo 'IWD timed out' >&2; return 124; fi
    rm "$work/address" "$work/route"
}
ip() {
    case $* in
    '-4 -o addr show dev wlan0 scope global') echo "2: wlan0 inet $lease scope global wlan0" ;;
    '-4 route flush dev wlan0'|'-4 addr flush dev wlan0')
        case $2 in route) item=route ;; addr) item=address ;; esac
        echo "$item" >>"$work/calls"
        if [ "$fault" = "$item" ] || [ "$fault" = both ]; then return 1; fi
        rm "$work/$item"
        ;;
    *) exit 97 ;;
    esac
}
for fault in none timeout route address both safe; do
    rc=0 lease=100.80.1.2/24
    [ "$fault" != safe ] || lease=192.168.1.2/24
    touch "$work/address" "$work/route"
    rm -f "$d/refused"
    : >"$work/calls"
    : >"$work/messages"
    # wan-check does not use errexit; inspect its accumulated status below.
    if . "$work/refuse" 2>"$work/error"; then :; fi
    case $fault in
    safe)
        [ "$rc" = 0 ] && [ "$good" = 1 ] && [ "$bad" = 0 ]
        [ ! -s "$work/calls" ] && [ ! -e "$d/refused" ]
        [ -e "$work/address" ] && [ -e "$work/route" ]
        continue ;;
    none) [ "$rc" = 0 ]; printf 'disconnect\n' >"$work/want" ;;
    *)
        [ "$rc" = 1 ]
        grep -q 'disconnect failed interface=wlan0' "$work/messages"
        grep -qx 'IWD timed out' "$work/error"
        printf 'disconnect\nroute\naddress\n' >"$work/want" ;;
    esac
    cmp "$work/want" "$work/calls"
    grep -q '^wlan0 100.80.1.2/24 ' "$d/refused"
    for item in route address; do
        if [ "$fault" = "$item" ] || [ "$fault" = both ]; then
            [ -e "$work/$item" ]
            grep -q "$item cleanup failed interface=wlan0" "$work/messages"
        else
            [ ! -e "$work/$item" ]
        fi
    done
done
echo 'wan-check: disconnect and IPv4 cleanup failure fixtures passed'
)
# Two overlapping uplinks keep a line each: an overwrite re-upped eth1 and alerted again.
(
. "$here/rootfs/usr/local/lib/wan-lib.sh"
d=$work/run UP_IFS='wlan0 eth1' WIFI_IF=wlan0 INTERNAL_NET=100.80.0.0/16 rc=0
logger() { printf '%s\n' "$*" >>"$work/messages"; }
timeout() { [ "$1" = 10 ] || exit 97; shift; "$@"; }
iwctl() { [ "$*" = 'station wlan0 disconnect' ] || exit 97; }
ifdown() { [ "$*" = '--force eth1' ] || exit 97; }
ip() {
    case $* in
    '-4 -o addr show dev wlan0 scope global') [ -z "$wifi" ] || echo "2: wlan0 inet $wifi scope global wlan0" ;;
    '-4 -o addr show dev eth1 scope global'|'addr flush dev eth1'|'link set dev eth1 down') ;;
    *) exit 97 ;;
    esac
}
rm -f "$d/refused"
: >"$work/messages"
printf '100.80.9.1/32\n' >"$d/dhcp-overlap.eth1"
for wifi in '' 100.80.1.2/24 100.80.1.2/24; do
    if . "$work/refuse"; then :; fi
done
rm "$d/dhcp-overlap.eth1"
[ "$(wc -l <"$d/refused")" = 2 ]
grep -q '^eth1 100.80.9.1/32 ' "$d/refused"
[ "$(grep -c '^wlan0 100.80.1.2/24 ' "$d/refused")" = 1 ]
[ "$(grep -c 'UpstreamOverlap interface=eth1 ' "$work/messages")" = 1 ]
[ "$(grep -c 'UpstreamOverlap interface=wlan0 ' "$work/messages")" = 2 ]
rm "$d/refused"
echo 'wan-check: one refusal line per uplink passed'
)
sed -n '/^echo "== overlap refusal"/,$p' "$here/rootfs/usr/local/sbin/wan-diag" |
	sed "s|/run/wan|$work/run|g; s|/var/log/wan|$work/log|g" >"$work/diag"
sh "$work/diag" >"$work/out"
[ "$(grep -c '^none$' "$work/out")" = 2 ]
! grep -q 'Choose a non-overlapping' "$work/out" || exit 1
: >"$work/run/refused"
: >"$work/run/dhcp-overlap.eth1"
sh "$work/diag" >"$work/out"
! grep -q 'Choose a non-overlapping' "$work/out" || exit 1
printf 'wlan0 100.80.0.0/24\n' >"$work/run/refused"
sh "$work/diag" >"$work/out"
grep -q '^refused interface=wlan0 subnet=100.80.0.0/24$' "$work/out"
[ "$(grep -c '^Choose a non-overlapping' "$work/out")" = 1 ]
rm "$work/run/refused"
printf '100.80.1.0/24\n' >"$work/run/dhcp-overlap.eth1"
sh "$work/diag" >"$work/out"
grep -q '^refused interface=eth1 subnet=100.80.1.0/24$' "$work/out"
[ "$(grep -c '^Choose a non-overlapping' "$work/out")" = 1 ]
sed -n '/^echo "== local log/,$p' "$work/diag" >"$work/log-diag"
printf 'older\n' >"$work/log/diag.log.1"
printf 'newer\n' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
printf 'older\nnewer\n' >"$work/want"
cmp "$work/want" "$work/out"
rm "$work/log/diag.log"
sh "$work/log-diag" | grep -q '^older$'
awk 'BEGIN {for (i=1; i<=300; i++) print i}' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
[ "$(wc -l <"$work/out")" -eq 200 ]
[ "$(head -n 1 "$work/out")" = 101 ]
awk 'BEGIN {for (i=1; i<=40000; i++) printf "x"}' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
[ "$(wc -c <"$work/out")" -eq 32768 ]
echo 'wan-diag: refusal and local-log fixtures passed'
