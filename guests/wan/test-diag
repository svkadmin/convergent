#!/bin/sh
# Offline refusal and bounded local-log diagnostics.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
mkdir "$work/run" "$work/log"
sed -n '/^echo "== overlap refusal"/,$p' "$here/rootfs/usr/local/sbin/wan-diag" |
	sed "s|/run/wan|$work/run|g; s|/var/log/wan|$work/log|g" >"$work/diag"
sh "$work/diag" >"$work/out"
[ "$(grep -c '^none$' "$work/out")" = 2 ]
! grep -q 'Choose a non-overlapping' "$work/out" || exit 1
: >"$work/run/refused"
: >"$work/run/dhcp-overlap.eth1"
sh "$work/diag" >"$work/out"
! grep -q 'Choose a non-overlapping' "$work/out" || exit 1
printf 'wlan0 100.80.0.0/24\n' >"$work/run/refused"
sh "$work/diag" >"$work/out"
grep -q '^refused interface=wlan0 subnet=100.80.0.0/24$' "$work/out"
[ "$(grep -c '^Choose a non-overlapping' "$work/out")" = 1 ]
rm "$work/run/refused"
printf '100.80.1.0/24\n' >"$work/run/dhcp-overlap.eth1"
sh "$work/diag" >"$work/out"
grep -q '^refused interface=eth1 subnet=100.80.1.0/24$' "$work/out"
[ "$(grep -c '^Choose a non-overlapping' "$work/out")" = 1 ]
sed -n '/^echo "== local log/,$p' "$work/diag" >"$work/log-diag"
printf 'older\n' >"$work/log/diag.log.1"
printf 'newer\n' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
printf 'older\nnewer\n' >"$work/want"
cmp "$work/want" "$work/out"
rm "$work/log/diag.log"
sh "$work/log-diag" | grep -q '^older$'
awk 'BEGIN {for (i=1; i<=300; i++) print i}' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
[ "$(wc -l <"$work/out")" -eq 200 ]
[ "$(head -n 1 "$work/out")" = 101 ]
awk 'BEGIN {for (i=1; i<=40000; i++) printf "x"}' >"$work/log/diag.log"
sh "$work/log-diag" | sed '1d' >"$work/out"
[ "$(wc -c <"$work/out")" -eq 32768 ]
echo 'wan-diag: refusal and local-log fixtures passed'
