#!/bin/sh
# ARCHITECTURE 3.2, 6
# WAN_COUNTRY=XX HOST_SSH_PUBKEY_FILE=... SVC_CA_FILE=... guests/wan/build [outdir]
# Run as root on the build host; requires loop devices.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"

die() { echo "build: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"
for t in curl sha256sum tar xz truncate chroot mount umount losetup sfdisk mkfs.vfat mkfs.ext4 qemu-img \
	ssh-keygen awk sed grep tac blkid; do
	command -v "$t" >/dev/null 2>&1 || die "$t is missing on the build host"
done

out=${1:-$OUT_DIR}

# 1. Inputs.
case $WAN_COUNTRY in
[A-Z][A-Z]) ;;
*) die "set WAN_COUNTRY to the two-letter regulatory country (for example from the environment)" ;;
esac
[ "$MINIROOTFS_SHA256" != unset ] || die "pin MINIROOTFS and MINIROOTFS_SHA256 in build.conf"
[ -r "$HOST_SSH_PUBKEY_FILE" ] || die "HOST_SSH_PUBKEY_FILE is not a readable file"
[ -r "$SVC_CA_FILE" ] || die "SVC_CA_FILE is not a readable file"
grep -q 'BEGIN CERTIFICATE' "$SVC_CA_FILE" || die "SVC_CA_FILE is not a PEM certificate"
hostkey=$(awk 'NR == 1 { print $1 " " $2 }' "$HOST_SSH_PUBKEY_FILE")
printf '%s\n' "$hostkey" | grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]+=*$' ||
	die "HOST_SSH_PUBKEY_FILE must hold an ssh-ed25519 public key"

# Require matching internal ranges in script and filter config.
net=$(sed -n 's/^INTERNAL_NET=//p' "$here/rootfs/etc/wan/wan.conf")
grep -q "^define internal    = $net\$" "$here/rootfs/etc/nftables.nft" ||
	die "INTERNAL_NET in wan.conf and 'internal' in nftables.nft disagree"

PACKAGES="alpine-baselayout busybox busybox-openrc busybox-mdev-openrc mdev-conf openrc mkinitfs
	linux-lts linux-firmware-intel wireless-regdb grub grub-efi
	iwd dbus nftables flock openssh-server chrony syslog-ng acpid prometheus-node-exporter"

work=$(mktemp -d /var/tmp/wan-build.XXXXXX)
mounts=$work/mounts
: > "$mounts"
loop=
cleanup() {
	set +e
	if [ -s "$mounts" ]; then
		tac "$mounts" | while read -r m; do umount "$m"; done
	fi
	[ -n "$loop" ] && losetup -d "$loop"
	# Never remove a tree that still has something mounted in it.
	if grep -q " $work" /proc/mounts; then
		echo "build: mounts remain under $work; left in place" >&2
	else
		rm -rf "$work"
	fi
}
trap cleanup EXIT INT TERM

mountrec() { mount "$@"; for _last; do :; done; echo "$_last" >> "$mounts"; }
bind() { mkdir -p "$2"; mountrec --bind "$1" "$2"; }

# 2. The bootstrap: download, verify the pin, unpack.
mkdir -p "$CACHE_DIR"
mini_tar=$CACHE_DIR/$MINIROOTFS
if [ ! -f "$mini_tar" ]; then
	curl -fsSL -o "$mini_tar.part" "$ALPINE_MIRROR/$ALPINE_BRANCH/releases/x86_64/$MINIROOTFS"
	mv "$mini_tar.part" "$mini_tar"
fi
echo "$MINIROOTFS_SHA256  $mini_tar" | sha256sum -c - >/dev/null || die "$MINIROOTFS does not match its pin"
mini=$work/mini
mkdir -p "$mini"
tar -xzf "$mini_tar" -C "$mini"
cp /etc/resolv.conf "$mini/etc/resolv.conf"

# 3. The disk: GPT, ESP, ext4 root.
mkdir -p "$out"
raw=$work/wan.raw
truncate -s "$IMAGE_SIZE" "$raw"
printf 'label: gpt\n,32M,U\n,,L\n' | sfdisk -q "$raw"
loop=$(losetup --find --show --partscan "$raw")
n=0
while [ ! -b "${loop}p2" ]; do
	n=$((n + 1))
	[ "$n" -le 50 ] || die "partitions of $loop did not appear"
	sleep 0.2
done
uuid=$(cat /proc/sys/kernel/random/uuid)
mkfs.vfat -F 32 -n WANESP "${loop}p1" >/dev/null
mkfs.ext4 -q -L wanroot -U "$uuid" "${loop}p2"
target=$work/target
mkdir -p "$target"
mountrec -t ext4 "${loop}p2" "$target"
mkdir -p "$target/boot/efi"
mountrec -t vfat "${loop}p1" "$target/boot/efi"

mkdir -p "$target/etc/apk/keys" "$target/etc/mkinitfs" "$target/dev" "$target/proc" "$target/sys"
cp "$mini"/etc/apk/keys/* "$target/etc/apk/keys/"
printf '%s\n' "$ALPINE_MIRROR/$ALPINE_BRANCH/main" "$ALPINE_MIRROR/$ALPINE_BRANCH/community" \
	> "$target/etc/apk/repositories"
cp "$here/rootfs/etc/mkinitfs/mkinitfs.conf" "$target/etc/mkinitfs/mkinitfs.conf"
bind /dev "$mini/dev"
bind /proc "$mini/proc"
bind "$target" "$mini/target"
bind /dev "$mini/target/dev"
bind /proc "$mini/target/proc"
bind /sys "$mini/target/sys"
bind /dev "$target/dev"
bind /proc "$target/proc"
bind /sys "$target/sys"
# shellcheck disable=SC2086
chroot "$mini" /sbin/apk --root /target --initdb --no-cache add $PACKAGES

inchroot() { chroot "$target" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root "$@"; }
inchroot sh -c 'command -v flock' >/dev/null || die "flock is missing after install"

# Only what was asked for: the kernel and its firmware must be there.
[ -e "$target/boot/vmlinuz-lts" ] || die "no /boot/vmlinuz-lts after install"
ls "$target"/lib/firmware/iwlwifi-* >/dev/null 2>&1 || die "no iwlwifi firmware after install"
kver=$(ls "$target/lib/modules")
[ "$(echo "$kver" | wc -l)" -eq 1 ] || die "expected one kernel in /lib/modules"

grep -q 'ARGS' "$target/etc/init.d/node-exporter" || die "node-exporter's init script does not read ARGS; adapt rootfs/etc/conf.d/node-exporter"
grep -q RESOLV_CONF "$target/usr/share/udhcpc/default.script" || die "udhcpc's default.script does not read RESOLV_CONF; adapt rootfs/etc/udhcpc"

# Overlay and fill placeholders; set checkout-independent modes below.
tar -C "$here/rootfs" --owner=0 --group=0 --numeric-owner -cf - . | tar -C "$target" -xf -
sed -i "s|@ROOT_UUID@|$uuid|g; s|@WAN_COUNTRY@|$WAN_COUNTRY|g" "$target/boot/grub/grub.cfg" "$target/etc/fstab"
sed -i "s|@HOST_SSH_KEY@|$hostkey|" "$target/root/.ssh/authorized_keys"
install -m 0644 "$SVC_CA_FILE" "$target/etc/syslog-ng/svc-ca.pem"
if grep -rIl '@[A-Z_][A-Z_]*@' "$target/boot/grub" "$target/etc/fstab" "$target/root/.ssh" "$target/etc/wan" \
	"$target/etc/ssh" "$target/etc/network" "$target/etc/syslog-ng/syslog-ng.conf"; then
	die "placeholders left in the files above"
fi

chmod 755 "$target"/usr/local/sbin/wan-* "$target/usr/sbin/resolvconf" \
	"$target/etc/init.d/wan-firewall" "$target/etc/local.d/10-wan.start" \
	"$target/etc/udhcpc/post-bound/wan-dns" "$target/etc/udhcpc/post-renew/wan-dns" "$target/etc/udhcpc/post-deconfig/wan-dns"
chmod 644 "$target/usr/local/lib/wan-lib.sh" "$target/etc/udhcpc/udhcpc.conf" "$target/etc/wan/wan.conf" "$target/etc/nftables.nft"
chmod 700 "$target/root" "$target/root/.ssh"
chmod 600 "$target/root/.ssh/authorized_keys" "$target/etc/crontabs/root"
chmod 644 "$target/etc/ssh/sshd_config" "$target/etc/syslog-ng/syslog-ng.conf"
# Lock root; host-key SSH only.
sed -i 's/^root:[^:]*:/root:*:/' "$target/etc/shadow"

rm -f "$target"/etc/ssh/ssh_host_*
ssh-keygen -q -t ed25519 -N '' -C wan -f "$target/etc/ssh/ssh_host_ed25519_key"
cp "$target/etc/ssh/ssh_host_ed25519_key.pub" "$out/ssh_host_ed25519_key.pub"

rm -f "$target"/etc/runlevels/*/*
while read -r lvl svc; do
	case $lvl in '' | '#'*) continue ;; esac
	[ -e "$target/etc/init.d/$svc" ] || die "service $svc is not installed"
	inchroot rc-update add "$svc" "$lvl" >/dev/null
done < "$here/runlevels"

inchroot mkinitfs -o /boot/initramfs-lts "$kver"
mkdir -p "$target/boot/efi/EFI/BOOT"
cat > "$target/tmp/embed.cfg" <<EOF
search --no-floppy --fs-uuid --set=root $uuid
set prefix=(\$root)/boot/grub
configfile \$prefix/grub.cfg
EOF
inchroot grub-mkimage -O x86_64-efi -o /boot/efi/EFI/BOOT/BOOTX64.EFI -c /tmp/embed.cfg -p /boot/grub \
	part_gpt ext2 fat normal configfile linux search search_fs_uuid echo
[ -s "$target/boot/efi/EFI/BOOT/BOOTX64.EFI" ] || die "no boot loader was written"

inchroot apk info -v | sort > "$work/packages"
: > "$target/etc/apk/repositories"
rm -rf "$target"/var/cache/apk/* "$target"/tmp/* "$target"/root/.ash_history
du -sm "$target" | awk '{ print "build: root filesystem " $1 " MiB" }'
sync
fstrim "$target" 2>/dev/null || true

# 11. Close everything and write the outputs.
tac "$mounts" | while read -r m; do umount "$m"; done
: > "$mounts"
losetup -d "$loop"
loop=
qemu-img convert -c -O qcow2 "$raw" "$out/wan.qcow2"
epoch=${SOURCE_DATE_EPOCH:-$(date +%s)}
mkdir -p "$work/meta"
cat > "$work/meta/metadata.yaml" <<EOF
architecture: x86_64
creation_date: $epoch
properties:
  description: Convergent wan, Alpine ${ALPINE_BRANCH#v}
  os: Alpine
  release: "${ALPINE_BRANCH#v}"
  variant: wan
requirements:
  secureboot: "false"
EOF
tar -C "$work/meta" -cJf "$out/wan-metadata.tar.xz" metadata.yaml
{
	echo "alpine=${ALPINE_BRANCH#v}"
	echo "minirootfs=$MINIROOTFS sha256=$MINIROOTFS_SHA256"
	echo "country=$WAN_COUNTRY"
	echo "image_sha256=$(sha256sum "$out/wan.qcow2" | awk '{ print $1 }')"
	echo "metadata_sha256=$(sha256sum "$out/wan-metadata.tar.xz" | awk '{ print $1 }')"
	echo "ssh_host_key=$(cat "$out/ssh_host_ed25519_key.pub")"
	sed 's/^/package=/' "$work/packages"
} > "$out/wan.manifest"
echo "build: wrote $out"
