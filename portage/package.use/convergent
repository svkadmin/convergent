# Signed hardened kernel; build creates initramfs and UKI.
sys-kernel/gentoo-kernel hardened modules-sign -initramfs
# build/image selects client microcode from the individual blobs.
sys-firmware/intel-microcode split-ucode -hostonly

# systemd-boot and udev; ukify is builder-only.
sys-apps/systemd-utils boot kernel-install udev tmpfiles

# Containers and VMs, confined by AppArmor.
app-containers/incus qemu apparmor
app-containers/lxc apparmor caps -tools

# Dependency USE requirements.
media-libs/freetype harfbuzz
# Incus imports images with xz-compressed squashfs.
sys-fs/squashfs-tools lzma
# Incus: SPICE console, virtfs config drive, USB uplink passthrough.
app-emulation/qemu spice usbredir virtfs usb -vnc -curl -oss -jpeg -png
# swtpm, the VMs' virtual TPM, needs gnutls with PKCS#11 and its tools.
net-libs/gnutls pkcs11 tools
# Incus' database (cowsql) needs raft with lz4.
dev-libs/raft lz4
# Incus applies image deltas with xdelta, which must read xz.
dev-util/xdelta lzma
# Incus drives nftables through its JSON interface.
net-firewall/nftables json

# No mail or smartd.
app-admin/sudo -sendmail
sys-apps/smartmontools -daemon -update-drivedb
# Intel GPU; no runtime LLVM.
media-libs/mesa -llvm
# No AppArmor language bindings or ebtables Perl helper.
sys-libs/libapparmor -perl -python
net-firewall/ebtables -perl

# Passwords hashed with yescrypt (PAM, through pambase).
sys-auth/pambase yescrypt -nullok

# Read guest disks without mounting them; setpriv drops debugfs privileges.
sys-apps/util-linux caps

# Static addresses only: no DHCP client on the host.
net-misc/netifrc -dhcp

# sound-server: the browsers' playback-only pulse socket; bluetooth (needs dbus): headsets.
media-video/pipewire sound-server bluetooth dbus

# The seatd daemon and its init script, for sway without logind.
sys-auth/seatd server

# Launcher: Wayland only.
dev-libs/bemenu wayland -X -ncurses

# Bluetooth audio and input only: OBEX and mesh pull in ICU and libical.
net-wireless/bluez -obex -mesh
