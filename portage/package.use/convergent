# Kernel: Gentoo's hardened configuration; modules signed with a key made for each build.
# No initramfs from the package: the build makes its own, and the UKI (build/, section 6).
sys-kernel/gentoo-kernel hardened modules-sign -initramfs

# systemd-boot and udev from systemd-utils; no systemd init. (ukify runs only in the builder.)
sys-apps/systemd-utils boot kernel-install udev tmpfiles

# Containers and VMs, confined by AppArmor.
app-containers/incus qemu apparmor
app-containers/lxc apparmor caps tools

# Required by the sets' dependencies.
# pango (for Sway's text) needs freetype with harfbuzz.
media-libs/freetype harfbuzz
# LXC's tools link libcap statically.
sys-libs/libcap static-libs
# Incus imports images with xz-compressed squashfs.
sys-fs/squashfs-tools lzma
# QEMU for Incus VMs: the console (spice), the configuration drive (virtfs), USB passthrough
# of an approved network adapter to wan (usb), and usbredir, which Incus requires. Nothing else.
app-emulation/qemu spice usbredir virtfs usb -vnc -curl -oss -jpeg -png
# swtpm, the VMs' virtual TPM, needs gnutls with PKCS#11 and its tools.
net-libs/gnutls pkcs11 tools
# Incus' database (cowsql) needs raft with lz4.
dev-libs/raft lz4
# Incus applies image deltas with xdelta, which must read xz.
dev-util/xdelta lzma
# Incus drives nftables through its JSON interface.
net-firewall/nftables json

# No mail on the laptop: sudo logs to syslog, and only smartctl is needed, not smartd.
app-admin/sudo -sendmail
sys-apps/smartmontools -daemon
# Intel's GPU drivers need no LLVM at run time (the builder still uses it to compile shaders).
media-libs/mesa -llvm
# No Perl or Python on the laptop: AppArmor's library without its language bindings
# (aa-status is C), ebtables (an Incus dependency) without its Perl helper.
sys-libs/libapparmor -perl -python
net-firewall/ebtables -perl
