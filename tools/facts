#!/bin/sh
# ARCHITECTURE 8, 12
# Reset luks-header.sha256 after an approved keyslot change; refresh the backup.
# Keep archived pstore records until acknowledged.
set -u
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

out=/var/lib/node_exporter
sdir=/var/lib/convergent
run=/run/convergent
efi=/sys/firmware/efi/efivars
efi_guid=8be4df61-93ca-11d2-aa0d-00e098032b8c
cert=/var/lib/incus/server.crt

die() { logger -p user.err -t facts "$*" 2>/dev/null || :; echo "facts: $*" >&2; exit 1; }
log() { logger -t facts "$*"; }
usage() { echo "usage: facts boot | daily | nts | auto" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

umask 022
mkdir -p "$out" "$run" "$sdir" || die "could not create the state directories"
# A 0600 lock: a world-readable one lets the owner flock it and stall the job.
umask 077
exec 9>"$run/facts.lock"
umask 022

buf=
ok=1
m() { printf '%s\n' "$*" >>"$buf"; }
bad() { ok=0; logger -p user.err -t facts "$*" 2>/dev/null || :; }

# Publish NAME.prom with cv_collector_success{collector}.
publish() {
	m "cv_collector_success{collector=\"$2\"} $ok"
	m "cv_collector_timestamp_seconds{collector=\"$2\"} $(date +%s)"
	chmod 644 "$buf" && mv "$buf" "$out/$1.prom" || die "could not write $out/$1.prom"
	buf=
}

trap 'rm -f "$buf"' 0

new_buf() { buf=$(mktemp "$out/.facts.XXXXXX") || die "could not write in $out"; ok=1; }

# --- boot ---

fact_release() {
	# Wait for this boot's bless (3 minutes at most), then read the slots once.
	i=0
	up=$(cut -d. -f1 /proc/uptime)
	while [ "$up" -lt 600 ] && [ ! -e /run/openrc/started/convergent-bless ] && [ "$i" -lt 36 ]; do
		i=$((i + 1)); sleep 5
	done
	st=$(slot status 2>/dev/null) || st=
	rel= slt= good= high=
	while read -r kind value label slot rest; do
		case $kind in
		booted) rel=$value; slt=$slot ;;
		good) good=$value ;;
		highest) high=$value ;;
		esac
	done <<EOF
$st
EOF
	if [ -z "$rel" ]; then bad "slot status gave nothing"; return; fi
	m "cv_booted_info{release=\"$rel\",slot=\"$slt\"} 1"
	m "cv_release_number{which=\"booted\"} $rel"
	case $good in '' | *[!0-9]*) ;; *) m "cv_release_number{which=\"good\"} $good" ;; esac
	case $high in '' | *[!0-9]*) ;; *) m "cv_release_number{which=\"highest\"} $high" ;; esac
}

efivar() { od -An -t u1 -j4 -N1 "$efi/$1-$efi_guid" 2>/dev/null | tr -d ' \n'; }

fact_secure_boot() {
	sb=$(efivar SecureBoot); setup=$(efivar SetupMode)
	case $sb$setup in [01][01]) ;; *) bad "Secure Boot state unreadable in $efi" ;; esac
	if [ "$sb" = 1 ] && [ "$setup" = 0 ]; then m "cv_secure_boot_verified 1"; else m "cv_secure_boot_verified 0"; fi
}

# Confidentiality lockdown.
fact_lockdown() {
	lk=$(cat /sys/kernel/security/lockdown 2>/dev/null) || lk=
	case $lk in
	*'[confidentiality]'*) m "cv_lockdown_enabled 1" ;;
	'') bad "lockdown state unreadable"; m "cv_lockdown_enabled 0" ;;
	*) m "cv_lockdown_enabled 0" ;;
	esac
}

fact_luks() {
	dev=$(cryptsetup status cv-state 2>/dev/null | awk '$1 == "device:" { print $2 }')
	[ -b "$dev" ] || { bad "no LUKS device behind cv-state"; return; }
	d=$(mktemp -d "$run/luks.XXXXXX") || { bad "no scratch space for the LUKS header"; return; }
	umask 077
	if cryptsetup luksHeaderBackup --disable-locks "$dev" --header-backup-file "$d/h" >/dev/null 2>&1; then
		h=$(sha256sum <"$d/h" | cut -d' ' -f1)
		acc=$(cat "$sdir/luks-header.sha256" 2>/dev/null || :)
		if [ -z "$acc" ]; then
			echo "$h" >"$sdir/luks-header.sha256" && acc=$h && log "LUKS header seen for the first time, recorded"
		fi
		if [ "$h" = "$acc" ]; then m "cv_luks_header_matches_release 1"; else m "cv_luks_header_matches_release 0"; fi
	else
		bad "could not read the LUKS header of $dev"
	fi
	umask 022
	rm -rf "$d"
}

fact_pstore() {
	ps=/sys/fs/pstore
	arch=$sdir/crash
	if ! grep -q " $ps " /proc/mounts; then
		mount -t pstore pstore "$ps" 2>/dev/null || bad "could not mount pstore"
	fi
	umask 077
	if [ -d "$sdir/pstore" ] && [ ! -e "$arch" ]; then
		mv "$sdir/pstore" "$arch" || bad "could not move the old crash archive"
	fi
	install -d -m 0700 -o 0 -g 0 "$arch" || { bad "could not create $arch"; umask 022; return; }
	dst=
	for f in "$ps"/*; do
		[ -f "$f" ] || continue
		if [ -z "$dst" ]; then
			dst=$arch/$(date -u +%Y%m%dT%H%M%SZ)
			mkdir -m 0700 "$dst" && chown 0:0 "$dst" || { bad "could not create $dst"; break; }
		fi
		if cp "$f" "$dst/" && cmp -s "$f" "$dst/${f##*/}" && sync; then
			rm -f "$f" || bad "could not clear ${f##*/} from pstore"
		else
			bad "could not archive ${f##*/}"
		fi
	done
	[ -z "$dst" ] || rmdir "$dst" 2>/dev/null || log "crash records archived in $dst"
	bert=/sys/firmware/acpi/tables/data/BERT
	if [ -r "$bert" ]; then
		copy=$(mktemp "$arch/.bert.XXXXXX") || { bad 'cannot create BERT archive'; umask 022; return; }
		if cat "$bert" >"$copy" && hash=$(sha256sum <"$copy"); then
			target=$arch/bert-${hash%% *}
			if [ -f "$sdir/crash-ack/bert-${hash%% *}" ]; then :
			elif [ -e "$target" ]; then
				cmp -s "$copy" "$target" || bad 'BERT archive differs'
			else
				mv "$copy" "$target" && sync || bad 'cannot archive BERT'
			fi
		else bad 'cannot read BERT'; fi
		rm -f "$copy"
	fi
	umask 022
	m "cv_crash_records $(find "$arch" -type f | wc -l)"
}

boot() {
	new_buf
	fact_pstore
	fact_release
	fact_secure_boot
	fact_lockdown
	fact_luks
	publish boot boot
}

# --- daily ---

fact_nvme() {
	found=0
	for c in /sys/class/nvme/nvme[0-9]*; do
		[ -e "$c" ] || continue
		n=${c##*/}
		found=$((found + 1))
		m "cv_nvme_expected{device=\"$n\"} 1"
		rows=$(smartctl -j -A "/dev/$n" 2>/dev/null | jq -r --arg d "$n" '
			.nvme_smart_health_information_log // empty | . as $l |
			"cv_nvme_spare_percent{device=\"\($d)\"} \($l.available_spare)",
			"cv_nvme_spare_threshold_percent{device=\"\($d)\"} \($l.available_spare_threshold)",
			"cv_nvme_media_errors_total{device=\"\($d)\"} \($l.media_errors)",
			"cv_nvme_critical_warning{device=\"\($d)\"} \($l.critical_warning)"' 2>/dev/null)
		if [ -n "$rows" ] && ! printf '%s\n' "$rows" | grep -q ' null$'; then echo "$rows" >>"$buf"; else bad "no health log from $n"; fi
	done
	m "cv_nvme_devices $found"
}

# Count selected/combined sources with NTS cookies.
fact_nts() {
	sources=$(chronyc -n -c sources 2>/dev/null) && authdata=$(chronyc -n authdata 2>/dev/null) || {
		bad "chronyc gave no answer"; return
	}
	n=$({ printf '%s\n' "$sources" | sed 's/^/S,/'; printf '%s\n' "$authdata" | sed 's/^/A /'; } | awk '
		/^S,/ { split($0, f, ","); if (f[3] ~ /^[*+]$/) agree[f[4]] = 1; next }
		/^A / { if ($3 == "NTS" && $(NF - 1) > 0) auth[$2] = 1 }
		END { for (k in agree) if (k in auth) c++; print c + 0 }')
	case $n in '' | *[!0-9]*) bad "chronyc gave no answer"; return ;; esac
	m "cv_nts_authenticated_sources $n"
}

fact_certs() {
	e=$(openssl x509 -noout -enddate -in "$cert" 2>/dev/null) || {
		bad "cannot read the certificate $cert"; return
	}
	case $e in notAfter=?*) e=${e#notAfter=} ;; *) bad "no expiry in $cert"; return ;; esac
	s=$(date -d "$e" +%s 2>/dev/null) || s=
	if [ -n "$s" ]; then m "cv_certificate_not_after_seconds{certificate=\"incus-server\"} $s"; else bad "cannot read the certificate $cert"; fi
	for certificate in ca server incus-client; do
		file=/var/lib/convergent/guests/tls/$certificate.crt
		if e=$(openssl x509 -noout -enddate -in "$file" 2>/dev/null); then
			e=${e#notAfter=}
			value=$(date -d "$e" +%s 2>/dev/null) || value=
			if [ -n "$value" ]; then m "cv_certificate_not_after_seconds{certificate=\"$certificate\"} $value"; else bad "cannot read expiry: $certificate"; fi
		else bad "cannot read certificate: $certificate"; fi
	done

	# The encrypted UI credential is optional and rotates through owner authentication.
	ui=/var/lib/convergent/guests/tls/incus-ui/client.crt
	if [ -f "$ui" ]; then
		e=$(openssl x509 -noout -enddate -in "$ui" 2>/dev/null) || { bad 'cannot read Incus UI certificate'; return; }
		case $e in notAfter=?*) e=${e#notAfter=} ;; *) bad 'no expiry in Incus UI certificate'; return ;; esac
		s=$(date -d "$e" +%s 2>/dev/null) || { bad 'cannot read Incus UI expiry'; return; }
		m "cv_certificate_not_after_seconds{certificate=\"incus-ui\"} $s"
	fi
}

# Audit records the kernel dropped this boot (queue full): any is an alert.
fact_audit() {
	lost=$(auditctl -s 2>/dev/null | awk '$1 == "lost" { print $2 }')
	case $lost in '' | *[!0-9]*) bad "auditctl gave no lost counter"; return ;; esac
	m "cv_audit_lost_total $lost"
}

hourly() {
	new_buf
	fact_audit
	publish audit audit
}

daily() {
	new_buf
	fact_nvme
	fact_certs
	publish daily daily
}

# Firewall ntpd only slews a host clock step (0.5% at most) and never steps at securelevel 1; rdate does,
# from this host, and ntpd keeps the residual. Once a boot, after this host first synchronizes; each node
# until its step succeeds, bounded, while check reports it running. A DNS push waits on that clock: never during one.
# The restart ends ntpd's back-off from an unsynced host (about 55 minutes). Ten failed tries a boot per node: each
# holds the push lock. The heal's restart and a rebuild of a node clear its step and tries (firewall-heal, guests).
fw_ntpd() {
	[ -e "$sdir/guests/initialized" ] || return 0
	[ ! -e "$run/fw-ntpd.fw1" ] || [ ! -e "$run/fw-ntpd.fw2" ] || return 0
	chronyc -n tracking 2>/dev/null | awk -F ' *: *' '$1 == "Leap status" {leap = $2} END {exit leap != "Normal"}' || return 0
	umask 077
	exec 7>"$run/dns-push.lock"
	umask 022
	flock -s -n 7 || { exec 7>&-; return 0; }
	for node in fw1 fw2; do
		[ ! -e "$run/fw-ntpd.$node" ] || continue
		if grep -Fq " $node=down " "$run/status/topology" 2>/dev/null; then continue; fi
		# Nor one the heal observes: its restart takes this lock without waiting.
		[ ! -e "$run/firewall-heal/$node" ] && [ ! -e "$run/firewall-heal/pair" ] || continue
		tries=$(cat "$run/fw-ntpd.$node.tries" 2>/dev/null) || tries=0
		# A garbled counter counts as none, not as spent.
		case $tries in ''|*[!0-9]*|0?*) tries=0 ;; esac
		[ "$tries" -lt 10 ] 2>/dev/null || continue
		if ! timeout -k 1 20 ssh -F /etc/convergent/ssh_config -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 \
			"$node" 'rdate -n 100.80.1.10 && rcctl restart ntpd' </dev/null >/dev/null 2>&1 9>&- 7>&-; then
			echo $((tries + 1)) >"$run/fw-ntpd.$node.tries" || bad "cannot record the $node clock step"
			[ "$tries" != 9 ] || log "$node clock step failed 10 times; not retried this boot"
			continue
		fi
		: >"$run/fw-ntpd.$node" || bad "cannot record the $node clock step"
		log "$node clock stepped to this host's"
	done
	exec 7>&-
}

nts() {
	new_buf
	fact_nts
	publish nts nts
	hourly
	logger -t cv-heartbeat alive
	fw_ntpd
}

# Read Btrfs evidence hourly; no scrub, rescan or quota mutation is requested.
storage() {
	new_buf
	if stats=$(btrfs device stats /var 2>/dev/null); then
		printf '%s\n' "$stats" | awk '$2 ~ /^[0-9]+$/ {n=$1; sub(/^.*\]\./,"",n); sum[n]+=$2; found=1}
			END {for(n in sum) printf "cv_btrfs_device_errors_total{kind=\"%s\"} %d\n",n,sum[n]; exit !found}' >>"$buf" || bad 'invalid Btrfs device stats'
	else bad 'Btrfs device stats unavailable'; fi
	uuid=$(findmnt -n -o UUID /var) || { uuid=; bad "cannot identify /var UUID"; }
	scrub=/var/lib/btrfs/scrub.status.$uuid
	missing=$sdir/scrub-missing.$uuid
	if [ -n "$uuid" ] && [ -r "$scrub" ]; then
		awk -F'|' 'NR>1 {
			delete v; for(i=2;i<=NF;i++) {split($i,a,":"); v[a[1]]=a[2]}
			if(v["t_start"] !~ /^[0-9]+$/ || v["finished"] !~ /^[01]$/ || v["canceled"] !~ /^[01]$/ || v["uncorrectable_errors"] !~ /^[0-9]+$/ || v["read_errors"] !~ /^[0-9]+$/ || v["csum_errors"] !~ /^[0-9]+$/ || v["verify_errors"] !~ /^[0-9]+$/ || v["super_errors"] !~ /^[0-9]+$/) {bad=1; next}
			n++; t=v["t_start"]+0; if(!start || t<start) start=t
			if(v["finished"] != 1 || v["canceled"] != 0) failed=1
			errors+=v["uncorrectable_errors"]+v["read_errors"]+v["csum_errors"]+v["verify_errors"]+v["super_errors"]
		} END {if(n && !bad) printf "cv_btrfs_scrub_started_seconds %d\ncv_btrfs_scrub_finished %d\ncv_btrfs_scrub_errors %d\n",start,!failed,errors; exit !n || bad}' "$scrub" >>"$buf" || bad 'invalid Btrfs scrub status'
		m 'cv_btrfs_scrub_recorded 1'
		rm -f "$missing" || bad 'cannot clear missing scrub observation'
	else
		m 'cv_btrfs_scrub_recorded 0'
		now=$(date +%s)
		if [ -n "$uuid" ] && [ ! -e "$missing" ]; then
			printf '%s\n' "$now" >"$missing.new" && mv "$missing.new" "$missing" || bad 'cannot record missing scrub observation'
		fi
		since=$(cat "$missing" 2>/dev/null) || since=0
		case $since in ''|*[!0-9]*) since=0 ;; esac
		if [ "$since" -gt 0 ] 2>/dev/null && [ "$since" -le "$now" ] 2>/dev/null; then :
		else since=0; bad 'invalid missing scrub observation'; fi
		m "cv_btrfs_scrub_missing_since_seconds $since"
	fi
	for volume in svc-metrics svc-logs svc-grafana; do
		path=/var/lib/incus/storage-pools/default/custom/default_$volume
		if id=$(btrfs inspect-internal rootid "$path" 2>/dev/null) && limits=$(btrfs qgroup show --raw -r "$path" 2>/dev/null); then
			printf '%s\n' "$limits" | awk -v id="0/$id" -v volume="$volume" '
				$1 == id && $2 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {
					printf "cv_volume_used_bytes{volume=\"%s\"} %s\ncv_volume_limit_bytes{volume=\"%s\"} %s\n",volume,$2,volume,$4; found=1
				} END {exit !found}' >>"$buf" || bad "quota unavailable: $volume"
		else bad "cannot inspect quota: $volume"; fi
	done
	publish storage storage
}

# --- auto ---

age() { _m=$(stat -c %Y "$1" 2>/dev/null) || { echo 999999999; return; }; echo $(( $(date +%s) - _m )); }

auto() {
	storage
	btime=$(awk '$1 == "btime" { print $2 }' /proc/stat)
	if [ ! -e "$out/boot.prom" ] || [ "$(stat -c %Y "$out/boot.prom")" -lt "$btime" ] ||
		! grep -qx 'cv_collector_success{collector="boot"} 1' "$out/boot.prom"; then
		boot
	fi
	daily_age=$(age "$out/daily.prom")
	if [ "$daily_age" -lt 0 ] || [ "$daily_age" -ge 72000 ] ||
		{ [ "$daily_age" -ge 3600 ] && ! grep -qx 'cv_collector_success{collector="daily"} 1' "$out/daily.prom" 2>/dev/null; }; then
		daily
	fi
	hourly
}

case ${1:-} in
boot) [ $# = 1 ] || usage; flock -w 300 9 || die "another facts is running"; daily; storage; hourly; nts; boot ;;
daily) [ $# = 1 ] || usage; flock -w 120 9 || die "another facts is running"; daily ;;
nts) [ $# = 1 ] || usage; flock -n 9 || exit 0; nts ;;
# nts holds the lock for seconds each minute: wait for it rather than skip an hour.
auto) [ $# = 1 ] || usage; flock -w 60 9 || exit 0; auto ;;
*) usage ;;
esac
