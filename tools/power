#!/bin/sh
# ARCHITECTURE 3.1
set -u
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

ac_epp=balance_performance
cap=0
[ ! -f /usr/lib/convergent/cpu-cap-khz ] || read -r cap </usr/lib/convergent/cpu-cap-khz
bat_epp=power

cpu=/sys/devices/system/cpu/cpufreq
ps=/sys/class/power_supply

die() { logger -p user.err -t power "$*" 2>/dev/null || :; echo "power: $*" >&2; exit 1; }
trap 'status=$?; [ "$status" = 0 ] || logger -p user.err -t power "handler failed (status $status)" 2>/dev/null || :' 0
[ "$(id -u)" = 0 ] || die "run as root"

# Mains/USB-C online, or no battery, means AC.
source_now() {
	bat=
	for s in "$ps"/*; do
		[ -e "$s/type" ] || continue
		read -r type <"$s/type" || continue
		case $type in
		Battery) bat=1 ;;
		Mains | USB*)
			online=0
			[ ! -r "$s/online" ] || read -r online <"$s/online"
			[ "$online" = 1 ] && { echo ac; return; } ;;
		esac
	done
	if [ -n "$bat" ]; then echo battery; else echo ac; fi
}

rc=0 changed=0
policy_online() {
	read -r affected 2>/dev/null <"$1/affected_cpus" && [ -n "$affected" ]
}
write_failed() {
	message="$1: $3 (requested=$2 observed=${current:-unreadable})"
	offline=0
	case $1 in "$cpu"/policy*/*) policy_online "${1%/*}" || offline=1 ;; esac
	[ "$offline" = 0 ] || message="$message; policy now offline"
	severity=user.err
	[ "$offline" = 0 ] || severity=user.notice
	logger -p "$severity" -t power "$message" 2>/dev/null || :
	echo "power: $message" >&2
	[ "$offline" = 1 ] || rc=1
	return 1
}
set_file() {
	[ -e "$1" ] || return 0
	current=
	read -r current 2>/dev/null <"$1" || :
	[ "$current" = "$2" ] && return 0
	if echo "$2" 2>/dev/null >"$1"; then
		changed=1
		current=
		read -r current 2>/dev/null <"$1" && [ "$current" = "$2" ] || write_failed "$1" "$2" 'readback mismatch'
	else
		current=
		read -r current 2>/dev/null <"$1" || :
		write_failed "$1" "$2" 'write rejected'
	fi
}
set_limit() {
	[ -e "$1" ] || return 0
	current=
	read -r current 2>/dev/null <"$1" || :
	[ "$current" = "$2" ] && return 0
	if ! echo "$2" 2>/dev/null >"$1"; then
		current=
		read -r current 2>/dev/null <"$1" || :
		write_failed "$1" "$2" 'write rejected'
		return 1
	fi
	changed=1
	# QoS recalculation is asynchronous; other requests may set a lower cap.
	n=0
	while :; do
		current=
		read -r current 2>/dev/null <"$1" || :
		case $current in ''|*[!0-9]*) ;;
		*) [ "$current" -gt 0 ] && [ "$current" -le "$2" ] && return 0 ;;
		esac
		[ "$n" -lt 10 ] || break
		n=$((n + 1))
		sleep 0.1
	done
	write_failed "$1" "$2" 'write accepted; effective limit still pending or constrained'
}

save_choice() {
	mkdir -p /var/lib/convergent/power || die 'cannot create power state'
	file=$(mktemp /var/lib/convergent/power/.choice.XXXXXX) || exit 1
	printf '%s\n' "$2" >"$file" && chmod 0644 "$file" &&
		mv -f "$file" "/var/lib/convergent/power/$1" || die 'cannot save power choice'
}
charge() {
	case $1 in off) end=100; start=95; charge_type=Standard ;;
	[5-9][0-9]|100) [ "$1" -ge 55 ] || die 'charge limit must be 55-100 or off'; end=$1; start=$((end - 5)); charge_type=Custom ;;
	*) die 'charge limit must be 55-100 or off' ;;
	esac
	found=0
	for s in "$ps"/*; do
		[ -e "$s/charge_control_end_threshold" ] || continue
		found=1
		# Raise the end first, so neither intermediate pair has start >= end.
		old=100
		read -r old <"$s/charge_control_end_threshold" || { rc=1; continue; }
		case $old in ''|*[!0-9]*) rc=1; continue ;; esac
		if [ "$end" -ge "$old" ]; then
			set_file "$s/charge_control_end_threshold" "$end" || continue
			set_file "$s/charge_control_start_threshold" "$start" || continue
		else
			set_file "$s/charge_control_start_threshold" "$start" || continue
			set_file "$s/charge_control_end_threshold" "$end" || continue
		fi
		# Dell thresholds only take effect in Custom mode; off restores Standard.
		if [ -e "$s/charge_types" ]; then
			types=$(cat "$s/charge_types") || { rc=1; continue; }
			case $types in *"[$charge_type]"*) ;;
			*)
				if echo "$charge_type" 2>/dev/null >"$s/charge_types"; then changed=1
				else
					current=$(cat "$s/charge_types" 2>/dev/null) || current=
					write_failed "$s/charge_types" "$charge_type" 'write rejected'
				fi ;;
			esac
		fi
	done
}
thermal() {
	case $1 in quiet|balanced|performance) ;; *) die 'thermal profile must be quiet, balanced or performance' ;; esac
	found=0
	[ -e /sys/firmware/acpi/platform_profile ] || return 0
	found=1
	choices=$(cat /sys/firmware/acpi/platform_profile_choices) || { rc=1; return; }
	case " $choices " in *" $1 "*) set_file /sys/firmware/acpi/platform_profile "$1" ;;
	*) echo "power: unsupported thermal profile: $1 ($choices)" >&2; rc=1 ;;
	esac
}

exec 9>/run/convergent-power.lock
flock -x 9 || exit 1
case ${1:-} in
'') [ "$#" = 0 ] || exit 2; src=$(source_now) ;;
ac|battery) [ "$#" = 1 ] || exit 2; src=$1 ;;
charge|thermal)
	[ "$#" = 2 ] || die 'use power charge off|55-100 or power thermal quiet|balanced|performance'
	"$1" "$2"
	[ "$found" = 1 ] || { echo "power: $1 unsupported (no sysfs control)"; exit 0; }
	[ "$rc" = 0 ] || exit "$rc"
	save_choice "$1" "$2"
	exit 0 ;;
*) echo 'usage: power [ac|battery|charge off|55-100|thermal quiet|balanced|performance]' >&2; exit 2 ;;
esac
if [ "$src" = ac ]; then epp=$ac_epp; else epp=$bat_epp; fi

policies=0
for p in "$cpu"/policy[0-9]*; do
	[ -d "$p" ] || continue
	policy_online "$p" || continue
	if [ -e "$p/energy_performance_preference" ]; then
		set_file "$p/scaling_governor" powersave && set_file "$p/energy_performance_preference" "$epp"
	fi
	policy_online "$p" || continue
	max=$cap
	[ ! -r "$p/cpuinfo_max_freq" ] || read -r max <"$p/cpuinfo_max_freq" || max=$cap
	if [ "$cap" = 0 ] || [ "$max" -lt "$cap" ]; then want=$max; else want=$cap; fi
	set_limit "$p/scaling_max_freq" "$want" || continue
	policy_online "$p" || continue
	[ ! -e "$p/energy_performance_preference" ] || policies=$((policies + 1))
done
[ -d "$cpu" ] || { echo 'power: no cpufreq in sysfs' >&2; rc=1; }
# Publish only a successfully applied CPU profile, manual overrides included.
profile=unknown
[ "$rc" != 0 ] || [ "$policies" = 0 ] || profile=$src
file=$(mktemp /run/.convergent-power.XXXXXX) || exit 1
printf '%s\n' "$profile" >"$file" && chmod 0644 "$file" &&
	mv -f "$file" /run/convergent-power.profile || die 'cannot publish profile'

limit=off
[ ! -r /var/lib/convergent/power/charge ] || read -r limit </var/lib/convergent/power/charge
charge "$limit"
if [ -r /var/lib/convergent/power/thermal ]; then
	read -r mode </var/lib/convergent/power/thermal && thermal "$mode" || rc=1
fi
# Retry camera probing once state is mounted, even if early udev denied a load.
if [ ! -e /run/convergent-camera-restored ]; then
	/usr/local/sbin/devices camera restore && : >/run/convergent-camera-restored || rc=1
fi

# Duplicate AC events need no log write; changes and failures still do.
severity=user.notice
[ "$rc" = 0 ] || severity=user.err
[ "$changed:$rc" = 0:0 ] || logger -p "$severity" -t power "$src: energy preference $epp, clock cap $cap kHz, status $rc" 2>/dev/null || :
exit "$rc"
