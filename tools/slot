#!/bin/sh
# ARCHITECTURE 5.2, 7.2, 7.3
set -eu

linux=EFI/Linux
health=/usr/lib/convergent/health.d
stm=/run/cv-state
key=/etc/convergent/release.pub
esp=
tmp=
mounted=
oneshot=

# Warning level: /var/log/messages keeps warnings and up; slot events are few.
die() { logger -p user.err -t slot "$*" 2>/dev/null || :; echo "slot: $*" >&2; exit 1; }
log() { logger -p user.warning -t slot "$*" 2>/dev/null || :; echo "slot: $*"; }
usage() { echo "usage: slot bless | status | write <release-dir> | rescue-write <release-dir> [a|b|inactive] | rescue-next <a|b>" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

# One run at a time.
exec 9>/run/convergent-slot.lock
flock -w 120 9 || die "another slot is running"

# Unmount whatever this run mounted, on the way out.
cleanup() {
	result=$?
	if [ -n "$oneshot" ]; then chattr +i "$oneshot" || result=1; fi
	for d in $mounted; do umount "$d" 2>/dev/null || :; done
	[ -z "$esp" ] || rmdir "$esp" 2>/dev/null || :
	[ -z "$tmp" ] || rm -rf "$tmp"
	exit "$result"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# The booted release and slot, from the kernel command line.
booted() {
	release=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^convergent\.release=//p')
	slot=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^dm-mod\.waitfor=PARTLABEL=cv-slot-//p')
	[ -n "$release" ] || die "no convergent.release= on the kernel command line"
	case $slot in a | b) ;; *) die "the kernel command line names no slot" ;; esac
}

rescue_only() {
	[ -f /etc/convergent/rescue ] && grep -qw 'convergent.rescue=1' /proc/cmdline ||
		die "this command requires the standalone rescue image"
	stm=/run/slot-state
}

esp_mount() {
	[ "$(blkid -o device -t PARTLABEL=cv-esp | wc -l)" = 1 ] || die "expected one cv-esp partition"
	esp=$(mktemp -d /run/slot.XXXXXX)
	mount -t vfat -o nodev,nosuid,noexec /dev/disk/by-partlabel/cv-esp "$esp" || die "the ESP did not mount"
	mounted="$esp $mounted"
}

state_mount() {   # state_mount ro|rw
	mkdir -p "$stm"
	mount -t btrfs -o "$1,subvolid=5,noatime,nodev,nosuid,noexec" /dev/mapper/cv-state "$stm" ||
		die "the state volume did not mount"
	mounted="$stm $mounted"
}

vars_mount() {
	vars=/sys/firmware/efi/efivars
	mkdir -p "$vars"
	if ! findmnt -rn -t efivarfs "$vars" >/dev/null; then
		mount -t efivarfs efivarfs "$vars" || die "cannot mount EFI variables"
		mounted="$vars $mounted"
	fi
}

# The ESP's UKIs of one slot, good or counting.
ukis() {
	for f in "$esp/$linux"/convergent-*-"$1".efi "$esp/$linux"/convergent-*-"$1"+*.efi; do
		if [ -e "$f" ]; then echo "$f"; fi
	done
}

uki_release() { r=${1##*/}; r=${r#convergent-}; echo "${r%%-*}"; }

uki_counter() {
	case $1 in
	*+*) c=${1##*+}; echo "+${c%.efi}" ;;
	*) echo good ;;
	esac
}

disarm() { rc-service -q convergent-watchdog stop || :; }

healthy() {
	[ -z "$(rc-status --crashed)" ] || { log "crashed services: $(rc-status --crashed | tr '\n' ' ')"; return 1; }

	s=$(rc-status -f ini default) || { log "rc-status default failed"; return 1; }
	if printf '%s\n' "$s" | grep -Eq '^[^=]*= *(crashed|failed|stopped)( |$)'; then
		log "services of the default runlevel are not running"
		return 1
	fi
	# From the boot runlevel only the protections; stock one-shots may differ per machine.
	for svc in convergent-firewall usbguard auditd apparmor; do
		rc-service -q "$svc" status || { log "$svc is not running"; return 1; }
	done
	for h in "$health"/*; do
		[ -f "$h" ] && [ -x "$h" ] || continue
		"$h" || { log "health check $h failed"; return 1; }
	done
}

# The number in a state file, 0 when there is none.
num() { n=$(cat "$stm/$1" 2>/dev/null || :); case $n in '' | *[!0-9]*) n=0 ;; esac; echo "$n"; }

# Replace a state file whole.
put() { printf '%s\n' "$2" >"$stm/$1.new" && mv "$stm/$1.new" "$stm/$1" && sync || die "could not write $1"; }

# Keep /var for bootable releases only.
prune() {
	[ "$slot" = a ] && o=b || o=a
	keep=" $release "
	for u in $(ukis "$o"); do keep="$keep$(uki_release "$u") "; done
	for v in "$stm"/var-*; do
		[ -d "$v" ] || continue
		case $keep in *" ${v##*/var-} "*) continue ;; esac
		log "removing the stale ${v##*/}"
		btrfs -q subvolume delete "$v" || log "could not remove $v"
	done
}

accept() {
	[ "$(cat "$stm/good" 2>/dev/null || :)" = "$release" ] || put good "$release"
	prune
	log "release $release in slot $slot is good"
}

copy_rescue() {
	src=/usr/lib/convergent/rescue.efi
	[ -f "$src" ] || return 0
	# Exclude rescue even when both releases have exhausted their tries.
	conf=$esp/loader/loader.conf
	if grep -qxF 'default convergent-*' "$conf"; then
		sed 's/^default convergent-\*$/default convergent-[0-9]*/' "$conf" >"$conf.new" &&
			sync && mv "$conf.new" "$conf" && sync || die "could not update loader default"
	fi
	dst=$esp/$linux/convergent-rescue.efi
	cmp -s "$src" "$dst" && return 0
	cp "$src" "$dst.new" && cmp -s "$src" "$dst.new" &&
		sync && mv -f "$dst.new" "$dst" && sync || die "could not install rescue UKI"
	log "rescue UKI refreshed from release $release"
}

bless() {
	booted
	esp_mount
	# An exhausted newer UKI explains an automatic fallback to this release.
	for other in "$esp/$linux"/convergent-*-*+0-*.efi "$esp/$linux"/convergent-*-*+0.efi; do
		[ -f "$other" ] || continue
		newer=$(uki_release "$other")
		if expr "$newer" '>' "$release" >/dev/null; then
			log "fallback: booted release $release in slot $slot; release $newer exhausted its tries"
		fi
	done
	# shellcheck disable=SC2046
	set -- $(ukis "$slot")
	[ $# = 1 ] || die "expected one UKI for slot $slot on the ESP, found $#"
	uki=$1
	case ${uki##*/} in
	convergent-"$release"-"$slot".efi)
		disarm
		log "release $release is already uncounted; watchdog disarmed before health checks"
		;;
	convergent-"$release"-"$slot"+*) ;;
	*) die "the UKI of slot $slot is not release $release" ;;
	esac
	if ! healthy; then
		log "release $release in slot $slot failed its health checks"
		echo "release $release failed its checks" 2>/dev/null >/dev/console || :
		exit 1
	fi
	# Persist highest, remove boot counter, then persist good.
	state_mount rw
	if expr "$release" '>' "$(num highest)" >/dev/null; then put highest "$release"; fi
	case ${uki##*/} in
	*+*) mv "$uki" "$esp/$linux/convergent-$release-$slot.efi" && sync || die "could not rename the UKI" ;;
	esac
	disarm
	accept
	copy_rescue
	echo "release $release is good" 2>/dev/null >/dev/console || :
}

status() {
	booted
	esp_mount
	state_mount ro
	version=$(cat /usr/lib/convergent/version 2>/dev/null) || version=
	echo "version ${version:-$release}"
	echo "booted  $release  slot $slot"
	for s in a b; do
		u=$(ukis "$s")
		if [ -n "$u" ]; then echo "slot $s  $(uki_release "$u")  $(uki_counter "$u")"; else echo "slot $s  none"; fi
	done
	echo "good    $(cat "$stm/good" 2>/dev/null || echo none)"
	echo "highest $(num highest)"
}

write() {
	dir=$1
	[ -f "$dir/manifest" ] || die "no manifest in $dir"
	# Everything after the check reads this private copy, never $dir again.
	tmp=$(mktemp -d /run/slot-write.XXXXXX)
	m=$tmp/manifest
	cp "$dir/manifest" "$m" || die "cannot read the manifest"
	if [ "${CONVERGENT_UNSIGNED:-}" = 1 ] && [ -z "${rescue_target:-}" ]; then
		log "writing without a signature check (CONVERGENT_UNSIGNED=1)"
	else
		[ -f "$key" ] || die "this image trusts no release key"
		cp "$dir/manifest.sig" "$tmp/sig" 2>/dev/null || die "the release is not signed"
		openssl pkeyutl -verify -pubin -inkey "$key" -rawin -in "$m" -sigfile "$tmp/sig" \
			>/dev/null 2>&1 || die "the manifest signature does not verify"
	fi
	new=$(awk '$1 == "release" { print $2 }' "$m")
	case $new in '' | *[!0-9]*) die "the manifest names no release" ;; esac
	for f in slot.img "convergent-$new-a.efi" "convergent-$new-b.efi"; do
		grep -q "  $f\$" "$m" || die "the manifest does not list $f"
	done
	grep -E '^[0-9a-f]{64}  ' "$m" | (cd "$dir" && sha256sum -c --quiet -) ||
		die "the release does not match its manifest"

	if [ -n "${rescue_target:-}" ]; then
		state_mount rw
		esp_mount
		inactive=$rescue_target
		if [ "$inactive" = inactive ]; then
			good=$(num good)
			active=
			for s in a b; do
				for u in $(ukis "$s"); do
					[ "$(uki_release "$u")" != "$good" ] || active="$active$s"
				done
			done
			case $active in a) inactive=b ;; b) inactive=a ;; *) die "cannot identify the last good slot; choose a or b" ;; esac
		fi
		printf 'Write signed release %s over slot %s (highest blessed: %s)? Type yes: ' "$new" "$inactive" "$(num highest)"
		IFS= read -r answer || die "no confirmation"
		[ "$answer" = yes ] || die "cancelled"
	else
		booted
		expr "$new" '>' "$release" >/dev/null || die "release $new is not newer than the booted $release"
		# Only a good boot may overwrite the fallback.
		state_mount rw
		[ "$(cat "$stm/good" 2>/dev/null || :)" = "$release" ] ||
			die "the booted release $release is not the one marked good; boot the good slot or let it bless first"
		hi=$(num highest)
		expr "$new" '>' "$hi" >/dev/null || die "release $new is not newer than $hi, the highest ever blessed"
		[ "$slot" = a ] && inactive=b || inactive=a
	fi
	part=/dev/disk/by-partlabel/cv-slot-$inactive
	[ -b "$part" ] || die "no partition $part"
	[ "$(blkid -o device -t PARTLABEL=cv-slot-$inactive | wc -l)" = 1 ] || die "more than one disk has a cv-slot-$inactive partition"
	size=$(stat -c %s "$dir/slot.img")
	[ "$size" -le "$(blockdev --getsize64 "$part")" ] || die "slot.img does not fit in slot $inactive"
	sum=$(awk '$2 == "slot.img" && length($1) == 64 { print $1 }' "$m")
	uki=convergent-$new-$inactive.efi
	cp "$dir/$uki" "$tmp/uki" && [ "$(sha256sum <"$tmp/uki" | cut -d' ' -f1)" = "$(awk -v f="$uki" '$2 == f && length($1) == 64 { print $1 }' "$m")" ] ||
		die "$uki does not match the manifest"

	# Remove the old UKI before overwriting its image.
	[ -n "$esp" ] || esp_mount
	for f in $(ukis "$inactive") "$esp/$linux"/convergent-*-"$inactive"+*.efi.new; do
		if [ -e "$f" ]; then rm "$f"; fi
	done
	sync -f "$esp" || die "could not sync the ESP"
	# Remove /var from a previous failed attempt at this release.
	for v in "$stm/var-$new" "$stm/var-$new.new"; do
		if [ -z "${rescue_target:-}" ] && [ -d "$v" ]; then btrfs -q subvolume delete "$v" || die "could not remove $v"; fi
	done
	sync -f "$stm" || die "could not sync the state volume"
	log "writing release $new to slot $inactive"
	dd if="$dir/slot.img" of="$part" bs=1M conv=fsync status=none || die "writing slot $inactive failed"
	blockdev --flushbufs "$part"
	[ "$(head -c "$size" "$part" | sha256sum | cut -d' ' -f1)" = "$sum" ] ||
		die "slot $inactive does not read back as slot.img"

	# Clear persistent entry overrides before the new entry exists: a failure leaves no UKI to try.
	if [ -z "${rescue_target:-}" ]; then
		vars_mount
		for name in LoaderEntryDefault LoaderEntryPreferred; do
			var=$vars/$name-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
			[ -e "$var" ] || continue
			chattr -i "$var" && rm "$var" || die "cannot clear $name"
		done
	fi
	# Stage the UKI before exposing its three-try boot entry.
	dst="$esp/$linux/convergent-$new-$inactive+3.efi"
	cp "$tmp/uki" "$dst.new" && cmp -s "$tmp/uki" "$dst.new" &&
		sync -f "$esp" && mv "$dst.new" "$dst" && sync -f "$esp" || die "could not install the UKI"
	for d in $mounted; do umount "$d" || die "could not unmount $d"; done
	mounted=
	log "release $new is in slot $inactive with three tries; reboot to try it"
}

rescue_next() {
	case $1 in a | b) ;; *) usage ;; esac
	esp_mount
	# shellcheck disable=SC2046
	set -- $(ukis "$1")
	[ $# = 1 ] || die "expected one UKI for the selected slot"
	entry=${1##*/}
	entry=${entry%%+*}
	case $entry in *.efi) ;; *) entry=$entry.efi ;; esac
	vars_mount
	# EFI attributes, then a NUL-terminated UTF-16LE entry ID without its counter.
	tmp=$(mktemp -d /run/slot-next.XXXXXX)
	printf '\007\000\000\000' >"$tmp/entry"
	case $entry in *[!a-z0-9.-]*) die "invalid entry ID" ;; esac
	for char in $(printf '%s' "$entry" | sed 's/./& /g'); do printf '%s\000' "$char"; done >>"$tmp/entry"
	printf '\000\000' >>"$tmp/entry"
	oneshot=$vars/LoaderEntryOneShot-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
	if [ -e "$oneshot" ]; then chattr -i "$oneshot" || die "cannot unlock the next boot entry"; fi
	cat "$tmp/entry" >"$oneshot" ||
		die "cannot set the next boot entry"
	chattr +i "$oneshot" || die "cannot protect the next boot entry"
	oneshot=
	sync
	log "next boot: $entry (boot counter and good state unchanged)"
}

case ${1:-} in
bless) [ $# = 1 ] || usage; bless ;;
status) [ $# = 1 ] || usage; status ;;
write) [ $# = 2 ] || usage; write "$2" ;;
rescue-write)
	[ $# = 2 ] || [ $# = 3 ] || usage
	rescue_only
	rescue_target=${3:-inactive}
	case $rescue_target in a | b | inactive) ;; *) usage ;; esac
	write "$2"
	;;
rescue-next) [ $# = 2 ] || usage; rescue_only; rescue_next "$2" ;;
*) usage ;;
esac
