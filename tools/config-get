#!/bin/sh
# Scalars and one install mapping; never source input.
set -eu
set +ax
export LC_ALL=C

die() { echo "config-get: $*" >&2; exit 1; }
if [ "${1:-}" = --selftest ]; then
	work=$(mktemp -d)
	trap 'rm -rf "$work"' 0
	trap 'exit 1' HUP INT TERM
	get() { sh "$0" "$work/config" "$1"; }
	[ "$(get hostname)" = host ] || die defaults
	[ "$(get owner_login)" = owner ] || die defaults
	[ "$(get install.disk)" = auto ] || die defaults
	[ "$(get install.state_size)" = auto ] || die defaults
	[ "$(get install.swap)" = none ] || die defaults
	[ -z "$(get display_scale)" ] || die defaults
	cat >"$work/config" <<'EOF'
# Non-defaults and whole-value quotes.
hostname: "laptop-2" # comment
timezone: Europe/Budapest
console_keymap: hu
xkb_layouts: us(dvorak),hu
display_scale: 1.2
wifi_country: HU
nts_servers: a.example,b.example,a.example
blocklist_url: https://example.org/list?x=1&y=2
cpu_cap_khz: 3000000
idle_lock_minutes: 5
owner_login: user_2
install:
  disk: /dev/disk/by-id/nvme-example_123
  state_size: 64GiB
  swap: zram:4GiB
image_size: 32G
EOF
	[ "$(get hostname)" = laptop-2 ] && [ "$(get install.state_size)" = 64GiB ] || die values
	[ "$(get install.disk)" = /dev/disk/by-id/nvme-example_123 ] || die disk
	[ "$(get install.swap)" = zram:4GiB ] || die swap
	[ "$(get blocklist_url)" = 'https://example.org/list?x=1&y=2' ] || die URL
	[ "$(get display_scale)" = 1.2 ] || die scale
	for size in auto 1% 100% 32GiB 999999GiB; do
		printf 'install:\n  state_size: %s\n' "$size" >"$work/config"
		[ "$(get install.state_size)" = "$size" ] || die state
	done
	for swap in none zram:1GiB zram:1024GiB state:1GiB state:1024GiB; do
		printf 'install:\n  swap: "%s"\n' "$swap" >"$work/config"
		[ "$(get install.swap)" = "$swap" ] || die swap
	done
	for scale in '' 0.5 0.50 1 1.25 4 4.00; do
		printf 'display_scale: "%s"\n' "$scale" >"$work/config"
		[ "$(get display_scale)" = "$scale" ] || die scale
	done
	n=0
	for bad in 'typo: value' 'hostname: host\nhostname: host' ' hostname: host' \
		'hostname: [host]' '- hostname: host' 'hostname: ho\tst' 'hostname: Bad' \
		'blocklist_url: http://example.org/list' 'state_max_gib: 2G' \
		'hostname: "host' 'hostname: host"' 'nts_servers: a.example,a.example' \
		'esp_mib: 1024' 'slot_mib: 8192' 'owner_password_hash: ""' \
		'state_max_gib: 0' 'install: auto' 'install:\ninstall:' \
		'install:\n  disk: auto\n  disk: auto' 'install:\n  unknown: x' \
		'install:\n disk: auto' 'install:\n    disk: auto' '  disk: auto' \
		'install.disk: auto' 'install:\n  disk: /dev/sda' \
		'install:\n  disk: /dev/disk/by-id/../sda' 'install:\n  disk: /dev/disk/by-id/x-part1' \
		'install:\n  state_size: 0%' 'install:\n  state_size: 101%' \
		'install:\n  state_size: 31GiB' 'install:\n  state_size: 01GiB' \
		'install:\n  state_size: 32G' 'install:\n  state_size: 1.5GiB' \
		'install:\n  swap: zram:0GiB' 'install:\n  swap: state:1025GiB' \
		'install:\n  swap: 4GiB' 'install:\n  encryption: false' \
		'install:\n  disk: auto\nhostname: host\n  swap: none' \
		'xkb_layouts: us,,hu' 'hostname: host\000' 'hostname: host\r' \
		'display_scale: 0.49' 'display_scale: 4.01' 'display_scale: 1.234' \
		'display_scale: -1' 'display_scale: .5' 'display_scale: 1.' \
		'display_scale: 01' 'display_scale: 1e0' 'display_scale: NaN' \
		'display_scale: 1;id'; do
		printf '%b\n' "$bad" >"$work/config"
		n=$((n + 1))
		if get image_size >"$work/out" 2>"$work/error"; then die "accepted invalid input $n"; fi
		[ ! -s "$work/out" ] && grep -q 'line [0-9]' "$work/error" || die diagnostics
	done
	echo 'config-get: selftest passed'
	exit
fi
[ $# = 2 ] || die 'usage: config-get <file> <key>'
file=$1
if [ ! -e "$file" ] && [ ! -L "$file" ]; then file=/dev/null; fi
[ -f "$file" ] || [ "$file" = /dev/null ] || die 'not a regular config file'
awk -v BINMODE=3 -v key="$2" '
function fail(message) {
	print "config-get: line " NR ": " message > "/dev/stderr"
	bad=1; exit 1
}
function hn(s) { return length(s) <= 63 && s ~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/ }
function dns(s, a,n,i) {
	if (length(s) > 253) return 0
	n=split(s,a,".")
	for (i=1;i<=n;i++) if (!hn(a[i])) return 0
	return n > 0
}
function valid(k,v, a,n,i,distinct,seen) {
	if (k == "hostname") return hn(v)
	if (k == "timezone") return v ~ /^[A-Za-z_+-]+(\/[A-Za-z0-9_+-]+)*$/
	if (k == "console_keymap") return v ~ /^[A-Za-z0-9_+-]+$/
	if (k == "display_scale") return v == "" || (v ~ /^[0-4](\.[0-9]{1,2})?$/ && v+0 >= 0.5 && v+0 <= 4)
	if (k == "xkb_layouts") {
		n=split(v,a,",")
		for (i=1;i<=n;i++) if (a[i] !~ /^[a-z]{2,3}(\([a-z0-9_-]+\))?$/) return 0
		return n > 0
	}
	if (k == "wifi_country") return v ~ /^([A-Z]{2})?$/
	if (k == "nts_servers") {
		n=split(v,a,",")
		for (i=1;i<=n;i++) {
			if (!dns(a[i])) return 0
			if (!seen[a[i]]++) distinct++
		}
		return distinct >= 2
	}
	if (k == "blocklist_url") return v ~ /^https:\/\/[a-z0-9][a-z0-9.-]*(\/[A-Za-z0-9._~\/%?=&+,-]*)?$/
	if (k == "cpu_cap_khz") return v ~ /^[1-9][0-9]{5,7}$/
	if (k == "idle_lock_minutes") return v ~ /^[1-9][0-9]?$/ && v+0 <= 60
	if (k == "owner_login") return v ~ /^[a-z_][a-z0-9_-]{0,31}$/
	if (k == "install.disk") return v == "auto" || (v ~ /^\/dev\/disk\/by-id\/[A-Za-z0-9_][A-Za-z0-9_.:+-]*$/ && v !~ /-part[0-9]+$/)
	if (k == "install.state_size") return v == "auto" || v ~ /^([1-9][0-9]?|100)%$/ || (v ~ /^[1-9][0-9]{0,5}GiB$/ && v+0 >= 32)
	if (k == "install.swap") {
		if (v == "none") return 1
		n=split(v,a,":")
		return n == 2 && (a[1] == "zram" || a[1] == "state") && a[2] ~ /^[1-9][0-9]{0,3}GiB$/ && a[2]+0 <= 1024
	}
	if (k == "image_size") return v ~ /^[1-9][0-9]{0,4}G$/
	return 0
}
BEGIN {
	d["hostname"]="host"; d["timezone"]="UTC"; d["console_keymap"]="us"
	d["xkb_layouts"]="us"; d["wifi_country"]=""
	d["display_scale"]=""
	d["nts_servers"]="time.cloudflare.com,ptbtime1.ptb.de,ntppool1.time.nl"
	d["blocklist_url"]="https://raw.githubusercontent.com/hagezi/dns-blocklists/main/rpz/pro.mini.txt"
	d["cpu_cap_khz"]="4200000"; d["idle_lock_minutes"]="10"
	d["owner_login"]="owner"; d["image_size"]="30G"
	d["install.disk"]="auto"; d["install.state_size"]="auto"; d["install.swap"]="none"
	range["install.disk"]="auto or a whole-disk /dev/disk/by-id/<id> path"
	range["install.state_size"]="auto, 1%..100%, or 32GiB..999999GiB"
	range["install.swap"]="none, zram:1GiB..zram:1024GiB, or state:1GiB..state:1024GiB"
	if (!(key in d)) fail("unknown requested key")
}
{
	if ($0 ~ /[[:cntrl:]]/) fail("control character")
	if ($0 ~ /^ *$/ || $0 ~ /^ *#/) next
	# YAML: a comment needs a space before its #; "a#b" is a value.
	line=$0; sub(/ +#.*/, "", line)
	if (line ~ /^ /) {
		if (section != "install" || line !~ /^  [a-z_]+ *:/) fail("expected two-space install key")
		sub(/^  /, "", line)
		prefix="install."
	} else {
		section=""; prefix=""
	}
	colon=index(line, ":")
	if (!colon) fail("expected key: value")
	k=substr(line,1,colon-1); sub(/ *$/, "", k)
	if (k !~ /^[a-z_]+$/) fail("invalid key")
	k=prefix k
	v=substr(line,colon+1); sub(/^ */, "", v); sub(/ *$/, "", v)
	if (k == "install") {
		if (v != "" || seen[k]++) fail("expected one install mapping")
		section="install"; next
	}
	if (!(k in d)) fail("unknown key " k " (see config.example.yaml; no secrets allowed)")
	if (seen[k]++) fail("duplicate key " k)
	if (v ~ /^".*"$/) v=substr(v,2,length(v)-2)
	if (!valid(k,v)) fail("invalid " k ((k in range) ? ": expected " range[k] : ""))
	d[k]=v
}
END { if (!bad) print d[key] }
' <"$file"
