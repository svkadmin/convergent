            -set_serial "0x$(openssl rand -hex 16)" -days 825 -extfile "$work/extensions" -out "$tls/$cert.crt.new"
        openssl verify -CAfile "$tls/ca.crt" "$tls/$cert.crt.new"
        if [ "$cert" = incus-client ] && [ -f "$tls/$cert.crt" ] && [ ! -f "$tls/incus-client.previous" ]; then
            cp "$tls/$cert.crt" "$tls/incus-client.previous"
        fi
