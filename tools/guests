force_stop() {
    timeout -k 5 60 incus --force-local --project default stop "$1" --force 9>&- 8>&- 7>&- 6>&- && return
    case $1 in fw1|fw2|wan) if pid=$(heal_qemu "$1"); then kill -KILL "$pid" || :; fi ;; esac
    retry stopped "$1"
}
start_guest() {
    # The previous QEMU may hold the VFIO group for a moment after its guest stopped.
    attempt=0
    until ic start "$1"; do
        [ $((attempt += 1)) -lt 3 ] || return 1
        sleep 10 || return
    done
}
# Incus leaves a guest stopped after ten crashes in a minute; nothing else starts wan or svc again.
start_stopped() {
    for node in wan svc; do
        # Nothing heals a paused wan or svc either: a forced restart, as the checker's for a paused pair.
        if paused "$node"; then
            echo "guests: restarting paused $node"
            set -- restart "$node" --force
        else
            stopped "$node" || continue
            echo "guests: starting stopped $node"
            set -- start "$node"
        fi
        [ "$node" != svc ] || svc_storage_check || return
        # Bounded as the checker's start, so a stall cannot keep the locks; Incus may have restarted it meanwhile.
        # Three tries as start_guest: the last QEMU may still hold the VFIO group.
        attempt=0
        until timeout -k 5 60 incus --force-local --project default "$@" 9>&- 8>&- 7>&- 6>&- || running "$node"; do
            [ $((attempt += 1)) -lt 3 ] ||
                die "cannot $1 $node; rebuild it: guests update $node /var/lib/convergent/release-guests/guests/$node --trusted-local"
            sleep 10 || return
        done
    done
}
seed_start() {
    seed_launch "$1" || return
    seed_finish "$1" || return
    case $1 in fw1|fw2) [ -d "$state/fw.topology" ] || leases_resume ;; esac
}
seed_launch() {
    step="seed_start $1"
    autorestart_hold "$1" || return
    if [ -z "$initializing" ] || [ -f "$state/seeds/$1.img" ] || [ ! -f "$state/init/seed-$1" ]; then
        if running "$1"; then stop_guest "$1" || return; fi
        seed_attach "$1" || return
    fi
    running "$1" || start_guest "$1"
}
seed_finish() {
    case $1 in fw1|fw2|wan) retry pin "$1" || return ;; esac
    retry seed_applied "$1" || return
    retry healthy "$1" || return
    [ -z "$initializing" ] || init_done "seed-$1" || return
    seed_remove "$1"
}
init_done() { touch "$state/init/$1" && sync; }
parallel_autostart() {
    ic profile list --format json >"$work/profiles"
    jq -r '.[] | select(.name == "fw" or .name == "wan" or .name == "svc") |
        .name as $n | .config | keys[] | select(. == "boot.autostart.priority" or . == "boot.autostart.delay") | "\($n) \(.)"' "$work/profiles" >"$work/autostart"
    while read -r p key; do
        ic profile unset "$p" "$key" || return
    done <"$work/autostart"
    ic query '/1.0/instances?recursion=1&project=default' >"$work/instances"
    jq -r '.[] | select(.name == "fw1" or .name == "fw2" or .name == "wan" or .name == "svc") |
        .name as $n | .config | keys[] | select(. == "boot.autostart.priority" or . == "boot.autostart.delay") | "\($n) \(.)"' "$work/instances" >"$work/autostart"
    while read -r node key; do
        ic config unset "$node" "$key" || return
    done <"$work/autostart"
}
# Remmina volumes: the owner may resize share independently of image updates.
remmina_volumes() {
    volume_create remmina-state 512MiB
    if ic storage volume list default --format json | jq -e 'any(.[]; .name == "share" and .type == "custom")' >/dev/null; then
        ic query /1.0/storage-pools/default/volumes/custom/share |
            jq -e '.content_type == "filesystem" and .config["security.shifted"] == "true"' >/dev/null || die 'share must be a shifted filesystem volume'
    else
        ic storage volume create default share --type filesystem size=4GiB security.shifted=true
    fi
}
# End Remmina volumes.
volume_create() {
    if ic storage volume list default --format json | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null; then
        ic query "/1.0/storage-pools/default/volumes/custom/$1" |
            jq -e --arg s "$2" '.config.size == $s and .config["security.shifted"] == "true"' >/dev/null || die "volume $1 differs"
    else
        ic storage volume create default "$1" size="$2" security.shifted=true
    fi
    init_done "volume-$1"
}
profile() {
    ic profile list --format json | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null || ic profile create "$1"
    ic profile edit "$1" <"$2"
    init_done "profile-$1"
}
# Profiles as they were before this update; a failed update puts them back.
profiles_save() {
    mkdir -p "$state/profiles.before"
    ic profile list --format json >"$work/profiles" || return
    for p do
        [ ! -f "$state/profiles.before/$p.yaml" ] || continue
        jq -e --arg n "$p" 'any(.[]; .name == $n)' "$work/profiles" >/dev/null || continue
        ic profile show "$p" >"$state/profiles.before/$p.new" &&
            mv "$state/profiles.before/$p.new" "$state/profiles.before/$p.yaml" || return
    done
    sync
}
profiles_restore() {
    [ -n "${recovering:-}" ] || return 1
    # Renames roll forward; their old profiles refer to volumes under the old names.
    [ ! -d "$state/browser.rename" ] || return 0
    for f in "$state/profiles.before"/*.yaml; do
        [ -f "$f" ] || continue
        ic profile edit "$(basename "$f" .yaml)" <"$f" || return
    done
    rm -rf "$state/profiles.before"
}
browser_legacy() {
    ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers" || die 'cannot list browsers'
    ic storage volume list default --format json >"$work/volumes" || die 'cannot list browser volumes'
    ic profile list --format json >"$work/profiles" || die 'cannot list browser profiles'
    jq -e 'any(.[]; .name == "web" or .name == "admin" or .name == "portal")' "$work/browsers" >/dev/null ||
        jq -e 'any(.[]; .name == "browser-web-state" or .name == "browser-admin-state")' "$work/volumes" >/dev/null ||
        jq -e 'any(.[]; .name == "browser-web" or .name == "browser-admin" or .name == "browser-portal")' "$work/profiles" >/dev/null
}
browser_migrate() {
    step=browser-migrate
    if [ ! -d "$state/browser.rename" ]; then
        browser_legacy || return 0
        # Save the new profiles too: recovery must not depend on a staging directory.
        mkdir -p "$work/browser.rename"
        for role in base def tmp int; do cp "$image_dir/incus/$role.yaml" "$work/browser.rename/$role.yaml"; done
        profiles_save browser-base browser-web browser-admin browser-portal browser-def browser-int browser-tmp
        sync
        mv "$work/browser.rename" "$state/browser.rename"
        sync
    fi
    for old in web admin; do
        case $old in web) new=def ;; admin) new=int ;; esac
        ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
        jq -e --arg n "$new" --arg o "$old" 'all(.[] | select(.name == $n);
            .type == "container" and (.profiles == ["browser-base", "browser-" + $n] or
            .profiles == ["browser-base", "browser-" + $o]))' "$work/browsers" >/dev/null ||
            die "$new is not this browser"
        if jq -e --arg n "$old" 'any(.[]; .name == $n)' "$work/browsers" >/dev/null; then
            ! jq -e --arg n "$new" 'any(.[]; .name == $n)' "$work/browsers" >/dev/null ||
                die "both $old and $new exist; refusing to merge browsers"
            jq -e --arg n "$old" '.[] | select(.name == $n) | .type == "container" and .profiles == ["browser-base", "browser-" + $n]' "$work/browsers" >/dev/null ||
                die "$old is not the old browser"
            if running "$old"; then stop_guest "$old"; fi
            ic rename "$old" "$new"
        fi
        ic storage volume list default --format json >"$work/volumes"
        if jq -e --arg n "browser-$old-state" 'any(.[]; .name == $n)' "$work/volumes" >/dev/null; then
            ! jq -e --arg n "browser-$new-state" 'any(.[]; .name == $n)' "$work/volumes" >/dev/null ||
                die "both browser-$old-state and browser-$new-state exist"
            # Incus rewrites profile sources before renaming the volume. Detach
            # first so instance validation cannot look up the not-yet-existing name.
            # Check both profiles for resumes after an instance/profile rename.
            ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
            if jq -e --arg n "$new" 'any(.[]; .name == $n)' "$work/browsers" >/dev/null; then
                if running "$new"; then stop_guest "$new"; fi
            fi
            ic profile list --format json >"$work/profiles"
            for role in "$old" "$new"; do
                if jq -e --arg p "browser-$role" 'any(.[]; .name == $p and .devices.state != null)' "$work/profiles" >/dev/null; then
                    ic profile device remove "browser-$role" state
                fi
            done
            ic storage volume rename default "browser-$old-state" "browser-$new-state"
        fi
    done
    for role in base def tmp int; do profile "browser-$role" "$state/browser.rename/$role.yaml"; done
    ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
    for node in def int; do
        jq -e --arg n "$node" 'any(.[]; .name == $n)' "$work/browsers" >/dev/null || continue
        if running "$node"; then stop_guest "$node"; fi
        ic profile assign "$node" "browser-base,browser-$node"
    done
    # Reap the retired ephemeral role before removing its unused profile.
    if jq -e 'any(.[]; .name == "portal" and .ephemeral and .profiles == ["browser-base", "browser-portal"])' "$work/browsers" >/dev/null; then
        autorestart_hold portal
        if running portal; then ic stop portal --force; else ic delete portal; fi
    fi
}
browser_profiles_prune() {
    ic profile list --format json >"$work/profiles" || return
    for p in browser-web browser-admin browser-portal; do
        if jq -e --arg n "$p" 'any(.[]; .name == $n and (.used_by | length) == 0)' "$work/profiles" >/dev/null; then
            ic profile delete "$p" || return
        fi
    done
}
init_guest() {
    node=$1
    shift
    instance_type=container
    instance_profile=$node
    case $node in fw1|fw2) instance_type=virtual-machine; instance_profile=fw ;; wan) instance_type=virtual-machine ;; esac
    import_image "$node"
    fingerprint=$(ic query "/1.0/images/aliases/candidate-$node" | jq -er .target)
    if ic query '/1.0/instances?recursion=1&project=default' | jq -e --arg n "$node" '.[] | select(.name == $n)' >/dev/null; then
        ic query "/1.0/instances/$node" | jq -e --arg id "$init_id" --arg fp "$fingerprint" --arg t "$instance_type" --arg p "$instance_profile" \
            '.config["user.convergent.init"] == $id and .config["volatile.base_image"] == $fp and .type == $t and .profiles == [$p]' >/dev/null || die "$node differs from initialization"
    else
        ic init "candidate-$node" "$node" -c "user.convergent.init=$init_id" -c boot.autostart=false "$@"
    fi
    init_done "instance-$node"
}
radio() {
    radio_device=
    for device in /sys/bus/pci/devices/*; do
        [ "$(cat "$device/vendor")" = 0x8086 ] && [ "$(cat "$device/class")" = 0x028000 ] || continue
        [ -z "$radio_device" ] || die 'multiple Intel radios; select hardware outside guests'
        radio_device=$device
    done
    if [ -z "$radio_device" ]; then
        echo 'guests: no Intel Wi-Fi device; wan has no radio (SSH and internal checks remain available)' >&2
        return
    fi
    /bin/sh "$lib/host-net" vfio "${radio_device##*/}" || die 'cannot bind radio to vfio-pci'
    ic query /1.0/instances/wan | jq -e '.devices.radio' >/dev/null || ic config device add wan radio pci address="${radio_device##*/}"
    [ "$(ic config device get wan radio address)" = "${radio_device##*/}" ] || die 'wan radio differs'
}

# Read the old disk in userspace; only the rebuilt disk may reach the kernel.
wan_debugfs() (
    cd "$work/wan-read" || exit 1
    # Bound directory listings too; dump does not preserve guest ownership or modes.
    case $1 in dump\ *) ulimit -f 128 ;; *) ulimit -f 2048 ;; esac || exit 1
    setpriv --reuid=65534 --regid=65534 --clear-groups --no-new-privs \
        debugfs -R "$1" partition >"$2" 2>"$work/wan-debugfs" 9>&- 8>&- 7>&- 6>&- || exit 1
    awk '/^debugfs [0-9][0-9.]* \([0-9A-Za-z -]+\)$/ {next} {exit 1}' "$work/wan-debugfs"
)
wan_listing() {
    wan_debugfs "ls -p $1" "$work/wan-list" || die 'cannot list wan iwd store'
    awk -F/ '
        /^$/ {next}
        NF != 8 || $1 != "" || $8 != "" || $2 !~ /^[0-9]+$/ ||
            $3 !~ /^[0-7][0-7][0-7][0-7][0-7][0-7]$/ ||
            $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ {exit 1}
        $2 == 0 {next}
        $6 == "" || $6 ~ /[^ -~]/ || seen[$6]++ {exit 1}
        substr($3, 1, 2) == "04" {if ($7 != "") exit 1; dirs[$6]++; next}
        $7 !~ /^[0-9]+$/ {exit 1}
        END {if (dirs["."] != 1 || dirs[".."] != 1) exit 1}
    ' "$work/wan-list" || die 'invalid wan directory listing'
}
wan_extract() {
    # Absence is established by a successful parent listing, never an error string.
    wan_listing /var/lib
    inode=$(awk -F/ '$2 != 0 && $6 == "iwd" {if (substr($3, 1, 2) != "04") exit 1; print $2}' "$work/wan-list") ||
        die 'wan iwd is not a directory'
    [ -n "$inode" ] || return 0
    wan_listing "<$inode>"
    awk -F/ '
        $2 == 0 || substr($3, 1, 2) != "10" {next}
        $6 !~ /\.(psk|open|8021x)$/ {next}
        {
            ssid=$6; sub(/\.[^.]*$/, "", ssid)
            if (substr(ssid, 1, 1) == "=") {
                hex=substr(ssid, 2)
                if (hex == "" || hex ~ /[^0-9a-fA-F]/ || length(hex) > 64 || length(hex) % 2) next
            } else if (ssid == "" || length(ssid) > 32) next
            if ($7 > 65536 || ++count > 256 || (total += $7) > 4194304) exit 1
            print $2 "/" $7 "/" $6
        }
    ' "$work/wan-list" >"$work/wan-files" || die 'wan iwd extraction limits exceeded'
    while IFS=/ read -r inode size name; do
        wan_debugfs "dump <$inode> out/profile" "$work/wan-output" || die 'cannot extract wan iwd profile'
        file=$work/wan-read/out/profile
        [ -f "$file" ] && [ ! -L "$file" ] && [ "$(stat -c %s "$file")" = "$size" ] ||
            die 'incomplete wan iwd profile'
        [ ! -s "$work/wan-output" ] || die 'unexpected wan extraction output'
        install -m 600 -- "$file" "$work/iwd/$name" || die 'cannot save wan iwd profile'
        rm "$file" || die 'cannot remove wan extraction scratch file'
    done <"$work/wan-files"
}
wan_read() {
    running wan && die 'refusing to read a running wan disk'
    disk=$pool/virtual-machines/wan/root.img
    [ -f "$disk" ] || die 'unexpected Incus Btrfs VM disk layout'
    sfdisk --json "$disk" >"$work/wan-partitions"
    range=$(jq -er --arg disk "$disk" --argjson bytes "$(stat -c %s "$disk")" '
        .partitiontable | select(.label == "gpt" and .unit == "sectors") |
        .sectorsize as $s | select($s == 512 or $s == 4096) |
        [.partitions[] | select(.node == ($disk + "2"))] | select(length == 1) | .[0] |
        select(.start > 0 and .size > 0 and .start == (.start | floor) and .size == (.size | floor)) |
        select((.start + .size) <= ($bytes / $s | floor)) |
        "\(.start * $s) \(.size * $s)"' "$work/wan-partitions") || die 'invalid wan partition 2'
    read -r offset bytes <<EOF
$range
EOF
    mkdir -p "$work/wan-read/out" "$work/iwd"
    dd if="$disk" of="$work/wan-read/partition" bs=4M iflag=skip_bytes,count_bytes \
        skip="$offset" count="$bytes" status=none
    [ "$(stat -c %s "$work/wan-read/partition")" = "$bytes" ] || die 'short wan partition copy'
    chown 65534:65534 "$work/wan-read/partition" "$work/wan-read/out"
    chmod 0400 "$work/wan-read/partition"
    chmod 0700 "$work/wan-read/out"
    chmod 0711 "$work/wan-read"
    wan_extract
    rm -rf "$work/wan-read"
}
wan_mount() {
    running wan && die 'refusing to mount a running wan disk'
    [ -f "$pool/virtual-machines/wan/root.img" ] || die 'unexpected Incus Btrfs VM disk layout'
    mkdir -p "$work/root" || return
    loop=$(losetup --find --show --partscan "$pool/virtual-machines/wan/root.img") || return
    retry test -b "${loop}p2" || return
    mount -t ext4 -o nodev,nosuid,noexec "${loop}p2" "$work/root" 9>&- 8>&- 7>&- 6>&- || return
    mounted=1
}
prune() {
    # The last three state snapshots stay for a restore by hand.
    for volume in $(volumes "$1"); do
        ic storage volume snapshot list default "$volume" --format csv -c n >"$work/volume-snapshots" || return
        awk '/^guests-/' "$work/volume-snapshots" | sort -r | sed '1,3d' >"$work/prune" || return
        while read -r old; do ic storage volume snapshot delete default "$volume" "$old" || return; done <"$work/prune"
    done
}
prepare_cleanup() {
    [ -f "$state/preparing" ] || return 0
    read -r prep_guest prep_snap prep_start <"$state/preparing" || return
    prep_health=
    if ! awk -v g="$prep_guest" -v s="$prep_snap" '$1 == g && $2 == s {found=1} END {exit !found}' "$state/pending" 2>/dev/null; then
        prep_now=$(cut -d. -f1 /proc/uptime) || return
        prep_deadline=$((prep_now + boot_timeout))
        for volume in $(volumes "$prep_guest"); do
            # A disconnected client can leave an Incus operation running.
            while :; do
                ic operation list --format json >"$work/operations" || return
                jq -r --arg v "/1.0/storage-pools/default/volumes/custom/$volume" '
                    .[] | select(.status_code < 200) |
                    select(any(.resources[]?[]?; split("?")[0] | . == $v or startswith($v + "/snapshots/"))) |
                    .id' "$work/operations" >"$work/volume-operations" || return
                [ -s "$work/volume-operations" ] || break
                prep_now=$(cut -d. -f1 /proc/uptime) || return
                [ "$prep_now" -lt "$prep_deadline" ] || { fail "snapshot operations for $volume timed out after ${boot_timeout}s"; return 1; }
                sleep 1
            done
            ic storage volume snapshot list default "$volume" --format csv -c n >"$work/volume-snapshots" || return
            if grep -qxF "$prep_snap" "$work/volume-snapshots"; then
                locked ic storage volume snapshot delete default "$volume" "$prep_snap" || return
            fi
        done
        rm -rf "$state/iwd.$prep_guest" || return
        if [ "$prep_start" = yes ]; then
            running "$prep_guest" || start_guest "$prep_guest" || return
            prep_health=$prep_guest
        fi
    fi
    rm "$state/preparing" && sync || return
    # Nothing is left to undo: an unhealthy guest fails the run without a journal that inhibits the heal.
    [ -z "$prep_health" ] || retry healthy "$prep_health"
}
replace() {
    step="replace $1"
    guest=$1
    snap=guests-$(date -u +%Y%m%dT%H%M%S)-$$${rebuilding:+-rebuild}
    import_image "$guest"
    case $guest in fw1|fw2) leases_hold ;; esac
    autorestart_hold "$guest"
    if [ -n "$rebuilding" ] && [ -n "$pending" ]; then
        # Only a positively stopped guest skips the stop: a frozen or unreadable one goes through it.
        stopped "$guest" || stop_guest "$guest"
        seed_remove "$guest"
        replace_root
        return
    fi
    step="prepare $guest"
    # A rebuild refuses an instance with snapshots; only ours may go.
    ic query "/1.0/instances/$guest/snapshots?recursion=1" >"$work/snapshots"
    jq -r '.[].name | split("/")[-1] | select(startswith("guests-") | not)' "$work/snapshots" >"$work/foreign"
    [ ! -s "$work/foreign" ] || die "$guest has snapshots a rebuild cannot keep ($(tr '\n' ' ' <"$work/foreign")); remove each with: sudo incus --force-local --project default snapshot delete $guest <name>"
    # The way back: the image the guest runs on, kept in the store while it is in use (images_prune).
    image=$(ic config get "$guest" volatile.base_image)
    [ -n "$image" ] && ic query "/1.0/images/$image" >/dev/null || die "the image $guest runs on is gone; a failed update could not be undone"
    [ -n "$pending" ] || cp "$keys/known_hosts" "$state/known_hosts.before"
    prep_start=no
    stopped "$guest" || prep_start=yes
    printf '%s %s %s\n' "$guest" "$snap" "$prep_start" >"$work/preparing"
    sync
    mv "$work/preparing" "$state/preparing"
    sync
    if [ "$prep_start" = yes ]; then starting=$guest; stop_guest "$guest"; fi
    # Drop a local memory pin (by hand or update fw); the fw profile carries it now.
    case $guest in
    fw1|fw2)
        mem=$(ic config get "$guest" limits.memory)
        [ -z "$mem" ] || ic config unset "$guest" limits.memory ;;
    esac
    for volume in $(volumes "$guest"); do locked ic storage volume snapshot create default "$volume" "$snap" --no-expiry; done
    if [ "$guest" = wan ]; then
        # The networks outlive the old disk; both the new disk and a rollback get them.
        wan_read
        rm -rf "$state/iwd.wan"
        mv "$work/iwd" "$state/iwd.wan"
        sync
    fi
    if [ -n "$pending" ]; then cp "$state/pending" "$work/pending"; else : >"$work/pending"; fi
    printf '%s %s %s\n' "$guest" "$snap" "$image" >>"$work/pending"
    sync
    mv "$work/pending" "$state/pending"
    pending=1
    starting=
    sync
    rm "$state/preparing"
    sync
    replace_root
}
# In place, from an image: devices, MACs and seeds stay. An interrupted rebuild is redone whole.
rebuild_root() {
    case $1 in fw1|fw2) touch "$state/dns.stale" && sync || return ;; esac
    ic query "/1.0/instances/$1/snapshots?recursion=1" >"$work/snapshots" || return
    jq -r '.[].name | split("/")[-1] | select(startswith("guests-"))' "$work/snapshots" >"$work/old-snapshots" || return
    while read -r old_snapshot; do ic snapshot delete "$1" "$old_snapshot" || return; done <"$work/old-snapshots"
    # A stopped container's file server keeps the old root for up to 15 s after the last file call, and
    # Incus 7.0 does not stop it on rebuild: the launcher check below would read the replaced root.
    tries=0
    while server=$(cat "/run/incus/$1/forkfile.pid" 2>/dev/null) && kill -0 "$server" 2>/dev/null; do
        tries=$((tries + 1))
        [ "$tries" -le 60 ] || { fail "a file server still holds the old root of $1"; return 1; }
        sleep 1
    done
    locked ic rebuild "$2" "$1" || return
    case $1 in
    wan)
        wan_mount || return
        mkdir -p "$work/root/var/lib/iwd" || return
        [ ! -d "$state/iwd.wan" ] || cp -a "$state/iwd.wan/." "$work/root/var/lib/iwd/" || return
        unmount_root || return
        ;;
    remmina)
        ic file pull "$1/usr/local/bin/remmina-launch" "$work/remmina-launch" || return
        sh -n "$work/remmina-launch" 9>&- 8>&- 7>&- 6>&- || return
        ;;
    def|int)
        ic file pull "$1/usr/local/bin/browser-launch" "$work/browser-launch" || return
        sh -n "$work/browser-launch" 9>&- 8>&- 7>&- 6>&- || return
        ;;
    esac
}
replace_root() {
    if [ "$rebuilding" = fw1 ]; then touch "$state/fw.handoff"; sync; fi
    step="rebuild $guest"
    rebuild_root "$guest" "candidate-$guest"
    case $guest in
    def|int|remmina) ;;
    *)
        seed_start "$guest"
        # The seed restores leases; the host pushes DNS data afterwards.
        case $guest in fw1|fw2) fw_check "$guest" release ;; esac
        ;;
    esac
}
commit_update() {
    step=commit
    # Recovery must finish both root and profiles once this marker exists.
    if [ ! -f "$state/committed" ]; then
        cp "$state/pending" "$work/committed" && sync &&
            mv "$work/committed" "$state/committed" && sync || return
    fi
    cp "$state/committed" "$work/committed" || return
    : >"$work/updates" || return
    [ ! -f "$state/updates" ] || cp "$state/updates" "$work/updates" || return
    while read -r guest snap image; do
        awk -v g="$guest" -v s="$snap" 'NF == 3 && $2 == g && $3 == s {found=1} END {exit !found}' "$work/updates" && continue
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$guest" "$snap" >>"$work/updates" || return
    done <"$work/committed"
    sync && mv "$work/updates" "$state/updates" && sync || return
    # A replay after a power loss finds the proven guest stopped: it belongs running.
    while read -r guest snap image; do
        case $guest in def|int|web|admin|remmina) ;; *) running "$guest" || start_guest "$guest" || return; retry healthy "$guest" || return ;; esac
    done <"$work/committed"
    rm -f "$state/pending" "$state/fw.rebuilt" && rm -rf "$state/profiles.before" && sync || return
    pending=
    rm "$state/committed" && sync || return
    images_prune || return
    while read -r guest snap image; do rm -rf "$state/iwd.$guest" && prune "$guest" || return; done <"$work/committed"
}
browser_commit() {
    # The durable marker means both replacements passed; recovery finishes the commit.
    browser_image=$(cat "$state/browser.ready")
    image_alias browser "$browser_image"
    [ ! -f "$state/pending" ] || commit_update
    browser_profiles_prune
    rm -rf "$state/profiles.before"
    rm -rf "$state/browser.rename"
    sync
    rm "$state/browser.ready"
    sync
    images_prune
}
good_slot() {
    slot status >"$work/slot" 9>&- 8>&- 7>&- 6>&-
    awk '$1 == "booted" {r=$2; s=$4} $1 == "good" {g=$2} $1 == "highest" {h=$2}
        $1 == "slot" {release[$2]=$3; status[$2]=$4}
        END {exit !(r ~ /^[0-9]+$/ && r == g && r <= h && release[s] == r && status[s] == "good")}' "$work/slot" ||
        die 'booted host slot is not marked good'
}

rebuild() {
    step="rebuild $1"
    case $1 in fw1) peer=fw2 ;; fw2) peer=fw1 ;; *) die 'rebuild accepts fw1 or fw2' ;; esac
    [ -f "$state/initialized" ] || die 'init has not completed'
    [ ! -e /var/lib/convergent/firewall-maintenance ] ||
        [ "$(cat /var/lib/convergent/firewall-maintenance)" = "$1" ] || die 'the peer is in maintenance; run sys firewall undo first'
    for journal in profiles.before browser.ready browser.rename; do
        [ ! -e "$state/$journal" ] || die 'finish the guest update before rebuilding a firewall'
    done
    resuming=
    for journal in preparing pending committed; do
        [ -e "$state/$journal" ] || continue
        resuming=1
        # Until a commit ends, pending is its copy. A committed update of this node is redone as a rebuild is.
        [ "$journal" != pending ] || ! cmp -s "$state/pending" "$state/committed" || continue
        awk -v node="$1" -v journal="$journal" '
            $1 != node || $2 !~ /^guests-[0-9]+T[0-9]+-[0-9]+(-rebuild)?$/ ||
            (journal == "preparing" && NF != 3) || NF < 2 || NF > 3 ||
            ($2 !~ /-rebuild$/ && (journal != "committed" || NF != 3)) {bad=1}
            END {exit !(NR == 1 && !bad)}' "$state/$journal" ||
            die 'another guest update or rebuild is pending; finish it first'
    done
    # A handoff without a journal (fw1 demoted, its replacement not yet journaled) only a rebuild of fw1 can release;
    # one a committed fw2 update left is released before fw2 is redone.
    [ ! -e "$state/fw.handoff" ] || [ "$1" = fw1 ] || [ -n "$resuming" ] ||
        die 'a firewall handoff is pending; finish the guest update first'
    # The soak needs wan and svc; any journal left is this node's.
    start_stopped
    image_dir=/var/lib/convergent/release-guests/guests/fw
    [ -d "$image_dir" ] || die 'installed firewall images are missing'
    verify_image fw
    [ -s "$state/carp-pass" ] || die 'missing laptop CARP password'
    fw_check "$peer" || die "$peer must be healthy before rebuilding $1"
    actual=$(guest_reply 128 rsh "$peer" "awk '{for(i=1;i<NF;i++) if(\$i==\"pass\") print \$(i+1)}' /etc/hostname.carp0 | sha256 -q")
    [ "$actual" = "$(sha256sum "$state/carp-pass" | awk '{print $1}')" ] || die 'running CARP password differs from laptop state'
    # CARP preempts within seconds of the release: wait for it before judging the pair.
    [ "$1" != fw2 ] || { fw_release && retry carp fw1 MASTER; }
    rebuilding=$1
    # A completed handback can be committed after an interruption.
    if [ -n "$resuming" ] && [ ! -f "$state/preparing" ] &&
        { [ -f "$state/fw.rebuilt" ] || [ -f "$state/committed" ]; } && pair fw1 fw2 && fw_check "$1" release; then
        touch "$state/dns.stale"
        sync
    else
        # A committed node that stays unhealthy is redone whole from the same image; its marker outlives the redo.
        if ! carp "$peer" MASTER; then
            if stopped "$1"; then die "$peer must be MASTER on all registered segments before rebuilding $1"; fi
            # The peer takes over only with coherent CARP (MASTER or BACKUP) on every registered segment.
            guest_reply 65536 rsh "$peer" ifconfig >"$work/carp" && awk -v mode=status -f "$lib/carp.awk" /etc/convergent/segments "$work/carp" >/dev/null ||
                die "$peer must be MASTER or BACKUP on every registered segment before $1 stops"
            starting=$1
            stop_guest "$1"
            retry carp "$peer" MASTER || die "$peer did not take over all registered segments"
        fi
        rm -f "$state/fw.rebuilt"
        sync
        # Firewalls have no data volumes: an interrupted preparation left nothing behind.
        rm -f "$state/preparing"
        sync
        [ ! -f "$state/pending" ] && [ ! -f "$state/committed" ] || pending=1
        replace "$1"
        touch "$state/fw.rebuilt"
        sync
        fw_check "$1"
        dns_restore
        retry pair "$peer" "$1"
    fi
    fw_release
    retry pair fw1 fw2
    if [ "$1" = fw2 ]; then backup_soak; else soak fw1 fw2; fi
    commit_update
    echo "guests: rebuilt $1; fw1 MASTER / fw2 BACKUP on all registered segments"
}

init_server() {
    openssl verify -CAfile "$tls/ca.crt" "$tls/incus-server.crt" >/dev/null || die 'invalid saved Incus certificate'
    openssl pkey -in "$tls/incus-server.key" -pubout >"$work/server-key.pub" || die 'invalid saved Incus key'
    openssl x509 -in "$tls/incus-server.crt" -pubkey -noout >"$work/server-cert.pub" || die 'invalid saved Incus certificate'
    cmp -s "$work/server-key.pub" "$work/server-cert.pub" || die 'saved Incus key and certificate differ'
    if ! rc-service incus stop 9>&- 8>&- 7>&- 6>&-; then
        # The preseed stop (SIGPWR, 40 s) can run out before any instance exists.
        start-stop-daemon --stop --oknodo --retry TERM/60/KILL/5 --pidfile /run/incus.pid || die 'incus did not stop'
        rc-service incus zap 9>&- 8>&- 7>&- 6>&-
    fi
    install -m 600 "$tls/incus-server.key" /var/lib/incus/server.key
    install -m 644 "$tls/incus-server.crt" /var/lib/incus/server.crt
    rc-service incus start 9>&- 8>&- 7>&- 6>&-
    retry ic query /1.0 >/dev/null
    init_done server
}
init() {
    step=init
    [ ! -e "$state/initialized" ] || die 'already initialized'
    if [ -f "$state/init/release" ] && [ -f "$state/init/preseed" ] && [ ! -f "$state/init/server" ]; then
        [ "$(cat "$state/init/release")" = "$(cd "$1" && pwd)" ] || die 'resume init with the original release directory'
        credentials
        init_server
    fi
    rc-service incus status >/dev/null 9>&- 8>&- 7>&- 6>&- || rc-service incus start 9>&- 8>&- 7>&- 6>&-
    retry ic query /1.0 >/dev/null
    autorestart_clear
    release=$(cd "$1" && pwd)
    for kind in fw wan svc browser remmina; do
        image_dir=$release/guests/$kind
        verify_image "$kind"
    done
    if [ ! -f "$state/init/release" ]; then
        [ "$(ic query '/1.0/instances?recursion=1&project=default' | jq length)" = 0 ] || die 'init needs an empty default project or its recovery journal'
        mkdir -p "$state/init"
        printf '%s\n' "$release" >"$work/release"
        mv "$work/release" "$state/init/release"
        sync
    fi
    [ "$(cat "$state/init/release")" = "$release" ] || die 'resume init with the original release directory'
