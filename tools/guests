# Native events are projected to safe fields by the loopback syslog input.
incus_ui_config() {
    ic config set core.https_address=100.80.1.10:8443 \
        logging.convergent.target.type=syslog logging.convergent.target.address=udp://127.0.0.1:1514 \
        logging.convergent.target.facility=daemon logging.convergent.types=lifecycle,logging \
        logging.convergent.logging.level=debug
