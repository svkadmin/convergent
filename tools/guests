#!/bin/sh
# ARCHITECTURE 4.1, 5.2, 7.1, 7.2, 13.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077
lib=/usr/lib/convergent/incus
state=/var/lib/convergent/guests
keys=/var/lib/convergent/ssh
tls=$state/tls
conf=/etc/convergent/ssh_config
pool=/var/lib/incus/storage-pools/default
boot_timeout=${GUEST_BOOT_TIMEOUT:-900}
work= loop= mounted= pending= demoted= starting= probes= initializing= fw_touched=
applying=
step=setup

fail() { echo "guests: $step: $*" >&2; return 1; }
die() { fail "$*" || :; exit 1; }
# Keep lock descriptors out of clients and any helpers they leave running.
ic() {
    case $1 in
    query) incus --force-local "$@" 9>&- 8>&- 7>&- 6>&- ;; # query takes no --project
    *) incus --force-local --project default "$@" 9>&- 8>&- 7>&- 6>&- ;;
    esac || { code=$?; fail "incus $* failed (status $code)" || return "$code"; }
}
# Fresh connections only: a shared one could still reach a guest this tool just replaced.
rsh() { timeout 30 ssh -F "$conf" -o ControlMaster=no -o ControlPath=none "$@" 9>&- 8>&- 7>&- 6>&- || { code=$?; fail "ssh $* failed (status $code)" || return "$code"; }; }
retry() {
    # VMs boot slowly; the svc container is up in seconds.
    case "$*" in *' svc'*) wait=${GUEST_SVC_TIMEOUT:-300} ;; *) wait=$boot_timeout ;; esac
    deadline=$(($(date +%s) + wait))
    until "$@"; do
        [ "$(date +%s)" -lt "$deadline" ] || { fail "$* timed out after ${wait}s"; return 1; }
        sleep 2
    done
}
running() { [ "$(ic query "/1.0/instances/$1/state" | jq -r .status)" = Running ]; }
volumes() {
    case $1 in
    svc) echo 'svc-metrics svc-logs svc-grafana' ;;
    web|admin) echo "browser-$1-state" ;;
    esac
}
unmount_root() {
    if [ -n "$mounted" ]; then umount "$work/root" 9>&- 8>&- 7>&- 6>&- || return; mounted=; fi
    if [ -n "$loop" ]; then losetup -d "$loop" || return; loop=; fi
}
clear_probes() {
    for address in $probes; do ip route del "$address/32" via 100.80.1.3 dev host || return; done
    probes=
}
rollback() {
    step=rollback
    while read -r guest snap <"$state/pending"; do
        backup=$state/backups/$guest-$snap.tar.gz
        [ -s "$backup" ] || { fail "missing backup $backup"; return 1; }
        echo "guests: restoring $guest/$snap" >&2
        ic list --format json >"$work/instances" || return
        if jq -e --arg n "$guest" '.[] | select(.name == $n)' "$work/instances" >/dev/null; then
            if running "$guest"; then ic stop "$guest" --force || return; fi
            seed_remove "$guest" || return
            ic config set "$guest" security.protection.delete=false || return
            ic delete "$guest" || return
        fi
        ic import "$backup" "$guest" || return
        for volume in $(volumes "$guest"); do
            ic storage volume snapshot restore default "$volume" "$snap" || return
        done
        cp "$state/known_hosts.before" "$keys/known_hosts" || return
        case $guest in web|admin) ;; *) ic start "$guest" || return; retry healthy "$guest" || return ;; esac
        tail -n +2 "$state/pending" >"$work/pending" && sync && mv "$work/pending" "$state/pending" && sync || return
    done
    rm "$state/pending" || return
    pending=
}
cleanup() {
    result=$1
    failed_status=$result failed_step=$step
    trap - 0
    trap '' HUP INT TERM
    set +e
    [ "$result" = 0 ] || printf 'guests: %s: operation failed (status %s); cleaning up\n' "$failed_step" "$failed_status" >&2
    step=cleanup
    unmount_root || { fail "cannot detach root mount or loop device"; [ -z "$applying" ] || update_status failed; exit 1; }
    clear_probes || { fail 'cannot remove probe routes'; result=1; }
    # Profiles first: the restored instance starts with what it ran with.
    if [ ! -f "$state/browser.ready" ]; then
        if [ "$result" != 0 ] && [ -d "$state/profiles.before" ]; then profiles_restore || { fail 'cannot restore the previous Incus profiles'; result=1; pending=; }; fi
        if [ -n "$pending" ]; then rollback || { fail "cannot restore $guest/$snap; pending journal retained"; result=1; demoted=; }; fi
    fi
    if [ -n "$starting" ]; then ic start "$starting" || { fail "cannot restart $starting"; result=1; }; fi
    if [ -n "$demoted" ]; then rsh "$demoted" 'if [ -f /etc/convergent/seeded/demote ]; then rm /etc/convergent/seeded/demote && ifconfig -g upgrade -carpdemote 128; else ifconfig -g carp -carpdemote 128; fi' || { fail "cannot release $demoted demotion"; result=1; }; fi
    # A replaced firewall starts with the image's DNS data, whether or not the whole update succeeded.
    if [ -n "$fw_touched" ] && [ -f /var/lib/convergent/dns/list.rpz ]; then
        exec 8>&- 6>&-
        dns-push local || { fail 'the DNS push failed; run sudo dns-push local'; result=1; }
    fi
    [ -z "$work" ] || rm -rf "$work" || { fail "cannot remove $work"; result=1; }
    [ "$result" = 0 ] || printf 'guests: %s: exiting with status %s (original status %s)\n' "$failed_step" "$result" "$failed_status" >&2
    if [ -n "$applying" ]; then
        if [ "$result" = 0 ]; then
            echo "${browser_pending:-}" >/run/convergent/status/guests-pending
            chmod 0644 /run/convergent/status/guests-pending
        fi
        if [ "$result" = 0 ]; then update_status 'done'; else update_status failed; fi
    fi
    exit "$result"
}
update_status() {
    mkdir -p /run/convergent/status
    chmod 0755 /run/convergent/status
    echo "$1" >/run/convergent/status/guests-update
    chmod 0644 /run/convergent/status/guests-update
    echo "guests: update $1"
}

# Secrets are generated once on this laptop, never on the build host.
secret_valid() {
    [ "$(wc -c <"$1")" -eq $(($2 * 2 + 1)) ] &&
        LC_ALL=C grep -qxE "[0-9a-f]{$(($2 * 2))}" "$1"
}
secret_create() {
    if [ -e "$1" ]; then
        secret_valid "$1" "$2" || die "invalid secret: $1; remove it before retrying setup"
        return
    fi
    openssl rand -hex "$2" >"$1.new" && secret_valid "$1.new" "$2" &&
        sync && mv "$1.new" "$1" && sync || { rm -f "$1.new"; die "cannot generate $1"; }
}
credentials() {
    step=credentials
    mkdir -p "$tls" "$keys"
    secret_create "$state/carp-pass" 16
    [ -f "$keys/id_ed25519" ] || ssh-keygen -q -t ed25519 -N '' -C convergent -f "$keys/id_ed25519"
    if [ ! -f "$tls/ca.crt" ]; then
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
            -keyout "$tls/ca.key" -out "$tls/ca.crt" -days 3650 -subj '/CN=Local CA' \
            -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign
    fi
    for cert in server incus-server incus-client; do
        [ ! -f "$tls/$cert.crt" ] || continue
        case $cert in
        server) san='IP:100.80.2.10,DNS:svc'; purpose=serverAuth ;;
        incus-server) san='DNS:host,IP:100.80.1.10'; purpose=serverAuth ;;
        incus-client) san='DNS:svc'; purpose=clientAuth ;;
        esac
        openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
            -keyout "$tls/$cert.key" -out "$work/request" -subj "/CN=$cert"
        printf 'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=%s\nsubjectAltName=%s\n' \
            "$purpose" "$san" >"$work/extensions"
        openssl x509 -req -in "$work/request" -CA "$tls/ca.crt" -CAkey "$tls/ca.key" \
            -set_serial "0x$(openssl rand -hex 16)" -days 825 -extfile "$work/extensions" -out "$tls/$cert.crt"
    done
    for secret in admin-password secret-key; do
        secret_create "$tls/$secret" 32
    done
}
verify_image() {
    step="verify $1"
    case $1 in
    fw) set -- fw1.qcow2 fw2.qcow2 fw1.pf.sha256 fw2.pf.sha256 fw1.rules.sha256 fw2.rules.sha256 ;;
    fw1|fw2) set -- "$1.qcow2" "$1.pf.sha256" "$1.rules.sha256" ;;
    wan) set -- wan-metadata.tar.xz wan.qcow2 ;;
    *) set -- metadata.tar.gz rootfs.tar.gz ;;
    esac
    : >"$work/checksums"
    for artifact do
        awk -v name="$artifact" '($2 == name || $2 == "*" name) && NF == 2 && length($1) == 64 && $1 !~ /[^0-9a-fA-F]/ {print; n++}
            END {if (n != 1) exit 1}' "$image_dir/SHA256SUMS" >>"$work/checksums" ||
            die "missing or invalid SHA256SUMS entry: $artifact"
    done
    (cd "$image_dir" && sha256sum -c "$work/checksums") || die 'guest artifact checksum mismatch'
}
import_image() {
    verify_image "$1"
    step="import $1"
    case $1 in
    fw1|fw2)
        cp "$lib/fw-metadata.yaml" "$work/metadata.yaml"
        TZ=UTC touch -t 197001010000 "$work/metadata.yaml"
        tar -C "$work" -czf "$work/metadata.tar.gz" metadata.yaml
        set -- "$1" "$work/metadata.tar.gz" "$image_dir/$1.qcow2"
        ;;
    wan) set -- "$1" "$image_dir/wan-metadata.tar.xz" "$image_dir/wan.qcow2" ;;
    *) set -- "$1" "$image_dir/metadata.tar.gz" "$image_dir/rootfs.tar.gz" ;;
    esac
    fingerprint=$(cat "$2" "$3" | sha256sum | awk '{print $1}')
    ic image list --format json >"$work/images"
    jq -e --arg fp "$fingerprint" '.[] | select(.fingerprint == $fp)' "$work/images" >/dev/null || ic image import "$2" "$3"
    [ -z "${import_only:-}" ] || return 0
    image_alias "$1" "$fingerprint"
}
image_alias() {
    ic image alias list --format json >"$work/aliases"
    target=$(jq -r --arg n "candidate-$1" '.[] | select(.name == $n) | .target' "$work/aliases")
    [ "$target" != "$2" ] || return 0
    [ -z "$target" ] || ic image alias delete "candidate-$1"
    ic image alias create "candidate-$1" "$2"
}
pin() {
    step="pin $1"
    case $1 in
    fw1) address=100.80.1.2 ;;
    fw2) address=100.80.1.3 ;;
    wan) address=100.80.0.10 ;;
    esac
    ic console "$1" --show-log >"$work/console" || return 1
    expected=$(tr -d '\r' <"$work/console" | awk -v n="$1" -v id="$(cat "$state/seeds/$1.id")" \
        '{ i = index($0, "CONVERGENT-HOSTKEY "); if (!i) next; split(substr($0, i), f, " ") } f[2] == n && f[3] == id { key = f[4] } END { print key }')   # console lines interleave
    [ -n "$expected" ] || { fail 'no host key announcement for this seed'; return 1; }
    ssh-keyscan -T 5 -t ed25519 "$address" >"$work/scan" 2>/dev/null 9>&- 8>&- 7>&- 6>&- || { fail 'host key scan failed'; return 1; }
    [ "$(ssh-keygen -E sha256 -lf "$work/scan" | awk '{print $2}')" = "$expected" ] || { fail 'scanned host key differs from console'; return 1; }
    awk -v n="$1" '{print n, $2, $3}' "$work/scan" >"$work/pin" || return
    [ -f "$keys/known_hosts" ] || : >"$keys/known_hosts" || return
    awk -v n="$1" '$1 != n' "$keys/known_hosts" >"$work/known_hosts" || return
    cat "$work/pin" >>"$work/known_hosts" || return
    mv "$work/known_hosts" "$keys/known_hosts" || return
}
healthy() {
    step="healthy $1"
    case $1 in
    fw1|fw2) rsh "$1" true ;;
    wan) rsh wan check ;;
    svc)
        ic exec svc -- wget -q -T 5 -O /dev/null http://127.0.0.1:8428/health || { fail 'VictoriaMetrics health check failed'; return 1; }
        curl -qfsS --noproxy '*' --max-time 5 http://100.80.2.10:8880/health >/dev/null 9>&- 8>&- 7>&- 6>&- || { fail 'metrics proxy health check failed'; return 1; }
        curl -qfsS --noproxy '*' --max-time 5 http://100.80.2.10:9428/select/logsql/query --data-urlencode 'query=_time:1m' -d limit=1 >/dev/null 9>&- 8>&- 7>&- 6>&- || { fail 'VictoriaLogs query check failed'; return 1; }
        timeout 5 openssl s_client -connect 100.80.2.10:6514 -CAfile "$tls/ca.crt" \
            -verify_ip 100.80.2.10 -verify_return_error </dev/null >"$work/tls-check" 2>&1 9>&- 8>&- 7>&- 6>&- ||
            { fail "syslog TLS check failed: $(tr '\n' ' ' <"$work/tls-check")"; return 1; }
        ;;
    esac
}
carp() {
    step="carp $1"
    rsh "$1" 'ifconfig' | awk -v want="$2" '/carp: / {n++; if ($2 != want) bad=1} END {exit !(n == 6 && !bad)}' || fail "expected six $2 interfaces"
}
pair() { carp "$1" MASTER && carp "$2" BACKUP; }
fw_check() {
    step="fw_check $1"
    rsh "$1" 'ifconfig pfsync0' >"$work/pfsync" || return
    grep -q RUNNING "$work/pfsync" && grep -q 'defer: on' "$work/pfsync" || { fail 'pfsync is not running with defer enabled'; return 1; }
    rsh "$1" 'pfctl -si' | grep -q '^Status: Enabled' || { fail 'PF is not enabled'; return 1; }
    [ "$(rsh "$1" 'sha256 -q /etc/pf.conf')" = "$(cat "$image_dir/$1.pf.sha256")" ] || { fail 'pf.conf digest differs from release'; return 1; }
    if [ "${2:-}" = release ]; then
        [ "$(rsh "$1" "pfctl -sr | sed 's/__automatic_[0-9a-f_]*/__automatic/g' | sha256 -q")" = "$(cat "$image_dir/$1.rules.sha256")" ] || { fail 'loaded PF rules digest differs from release'; return 1; }
    fi
    rsh "$1" 'pfctl -nf /etc/pf.conf' || return 1
    rsh "$1" 'host -t A svc.convergent.internal 127.0.0.1' | grep -q '100.80.2.10' || fail 'svc DNS answer is missing'
}
soak() {
    # Six good samples; up to twelve misses (nested test VMs stall under disk load).
    count=0 misses=0
    while [ "$count" -lt 6 ]; do
        if pair "$1" "$2" && healthy wan && healthy svc; then
            count=$((count + 1))
        else
            misses=$((misses + 1))
            [ "$misses" -le 12 ] || return 1
        fi
        sleep 5
    done
}
backup_soak() {
    for address in 100.80.0.10 100.80.2.10; do
        ip route add "$address/32" via 100.80.1.3 dev host
        probes="$probes $address"
    done
    soak fw1 fw2
    clear_probes
}

# The persistent seed survives errors until verified or the replacement is rolled back.
seed_create() {
    step="seed_create $1"
    mkdir -p "$state/seeds" "$work/root"
    if [ -e "$state/seeds/$1.img" ]; then
        [ "$(sha256sum "$state/seeds/$1.img" | awk '{print $1}')" = "$(cat "$state/seeds/$1.sha256")" ] || die "seed for $1 differs"
        return
    fi
    truncate -s 16M "$work/seed.img"
    mkfs.vfat -F 16 -n CVSEED "$work/seed.img" >/dev/null
    loop=$(losetup --find --show "$work/seed.img")
    mount -t vfat -o nodev,nosuid,noexec,umask=077 "$loop" "$work/root" 9>&- 8>&- 7>&- 6>&-
    mounted=1
    openssl rand -hex 16 >"$state/seeds/$1.id"
    cp "$state/seeds/$1.id" "$work/root/seed-id"
    case $1 in
    fw1|fw2|wan)
        cp "$keys/id_ed25519.pub" "$work/root/management.pub"
        cp "$tls/ca.crt" "$work/root/syslog-ca.crt"
        case $1 in fw1|fw2) cp "$state/carp-pass" "$work/root/carp-pass" ;; esac
        if [ "$1" = fw1 ] && [ -n "$pending" ]; then touch "$work/root/demote"; fi
        ;;
    svc)
        for file in server.crt server.key ca.crt incus-client.crt incus-client.key admin-password secret-key; do
            cp "$tls/$file" "$work/root/$file"
        done
        ;;
    esac
    unmount_root
    sha256sum "$work/seed.img" | awk '{print $1}' >"$state/seeds/$1.sha256"
    sync
    mv "$work/seed.img" "$state/seeds/$1.img"
    sync
}
seed_attach() {
    seed_create "$1"
    step="seed_attach $1"
    ic query "/1.0/instances/$1" >"$work/instance"
    if jq -e '.devices.seed' "$work/instance" >/dev/null; then ic config device remove "$1" seed; fi
    seed_source=$state/seeds/$1.img
    case $1 in
    svc)
        [ -f "$state/seeds/svc.autostart" ] || ic config get svc boot.autostart >"$state/seeds/svc.autostart"
        ic config set svc boot.autostart=false
        for seed_loop in $(losetup -j "$seed_source" | cut -d: -f1); do losetup -d "$seed_loop"; done
        seed_source=$(losetup --find --show --read-only "$seed_source")
        uid=$(jq -er '(.config["volatile.idmap.next"] // .config["volatile.idmap.current"]) | fromjson[] | select(.Isuid and .Nsid == 0) | .Hostid' "$work/instance")
        gid=$(jq -er '(.config["volatile.idmap.next"] // .config["volatile.idmap.current"]) | fromjson[] | select(.Isgid and .Nsid == 0) | .Hostid' "$work/instance")
        ic config device add "$1" seed disk source="$seed_source" readonly=true \
            path=/var/lib/convergent/seed raw.mount.options="uid=$uid,gid=$gid,dmask=077,fmask=177,nodev,nosuid,noexec"
        ;;
    *) ic config device add "$1" seed disk source="$seed_source" readonly=true ;;
    esac
}
seed_applied() {
    step="seed_applied $1"
    case $1 in
    fw1|fw2) applied=$(rsh "$1" 'cat /var/db/convergent-seeded') || return 1 ;;
    wan) applied=$(rsh wan seed-status) || return 1 ;;
    svc) applied=$(ic exec svc -- cat /var/lib/convergent/seeded) || return 1 ;;
    esac
    [ "$applied" = "$(cat "$state/seeds/$1.id")" ] || fail 'applied seed ID differs'
}
seed_remove() {
    step="seed_remove $1"
    [ -f "$state/seeds/$1.img" ] || return 0
    ic config device show "$1" >"$work/devices" || return
    if grep -q '^seed:' "$work/devices"; then ic config device remove "$1" seed || return; fi
    if [ "$1" = svc ]; then
        for seed_loop in $(losetup -j "$state/seeds/$1.img" | cut -d: -f1); do losetup -d "$seed_loop" || return; done
        if [ -f "$state/seeds/svc.autostart" ]; then
            ic config set svc boot.autostart="$(cat "$state/seeds/svc.autostart")" || return
            rm "$state/seeds/svc.autostart" || return
        fi
    fi
    rm -f "$state/seeds/$1.img"
}
seed_start() {
    step="seed_start $1"
    if [ -z "$initializing" ] || [ -f "$state/seeds/$1.img" ] || [ ! -f "$state/init/seed-$1" ]; then
        if running "$1"; then ic stop "$1" --timeout 60; fi
        seed_attach "$1"
    fi
    running "$1" || ic start "$1"
    case $1 in fw1|fw2|wan) retry pin "$1" ;; esac
    retry seed_applied "$1"
    retry healthy "$1"
    [ -z "$initializing" ] || init_done "seed-$1"
    seed_remove "$1"
}
init_done() { touch "$state/init/$1"; sync; }
volume_create() {
    if ic storage volume list default --format json | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null; then
        ic query "/1.0/storage-pools/default/volumes/custom/$1" |
            jq -e --arg s "$2" '.config.size == $s and .config["security.shifted"] == "true"' >/dev/null || die "volume $1 differs"
    else
        ic storage volume create default "$1" size="$2" security.shifted=true
    fi
    init_done "volume-$1"
}
profile() {
    ic profile list --format json | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null || ic profile create "$1"
    ic profile edit "$1" <"$2"
    init_done "profile-$1"
}
# Profiles as they were before this update; a failed update puts them back.
profiles_save() {
    mkdir -p "$state/profiles.before"
    for p do
        [ ! -f "$state/profiles.before/$p.yaml" ] || continue
        ic profile show "$p" >"$state/profiles.before/$p.new" &&
            mv "$state/profiles.before/$p.new" "$state/profiles.before/$p.yaml" || return
    done
    sync
}
profiles_restore() {
    for f in "$state/profiles.before"/*.yaml; do
        [ -f "$f" ] || continue
        ic profile edit "$(basename "$f" .yaml)" <"$f" || return
    done
    rm -rf "$state/profiles.before"
}
init_guest() {
    node=$1
    shift
    instance_type=container
    instance_profile=$node
    case $node in fw1|fw2) instance_type=virtual-machine; instance_profile=fw ;; wan) instance_type=virtual-machine ;; esac
    import_image "$node"
    fingerprint=$(ic query "/1.0/images/aliases/candidate-$node" | jq -er .target)
    if ic list --format json | jq -e --arg n "$node" '.[] | select(.name == $n)' >/dev/null; then
        ic query "/1.0/instances/$node" | jq -e --arg id "$init_id" --arg fp "$fingerprint" --arg t "$instance_type" --arg p "$instance_profile" \
            '.config["user.convergent.init"] == $id and .config["volatile.base_image"] == $fp and .type == $t and .profiles == [$p]' >/dev/null || die "$node differs from initialization"
    else
        ic init "candidate-$node" "$node" -c "user.convergent.init=$init_id" -c boot.autostart=false "$@"
    fi
    init_done "instance-$node"
}
radio() {
    radio_device=
    for device in /sys/bus/pci/devices/*; do
        [ "$(cat "$device/vendor")" = 0x8086 ] && [ "$(cat "$device/class")" = 0x028000 ] || continue
        [ -z "$radio_device" ] || die 'multiple Intel radios; select hardware outside guests'
        radio_device=$device
    done
    if [ -z "$radio_device" ]; then
        echo 'guests: no Intel Wi-Fi device; wan has no radio (SSH and internal checks remain available)' >&2
        return
    fi
    /bin/sh "$lib/host-net" vfio "${radio_device##*/}" || die 'cannot bind radio to vfio-pci'
    ic query /1.0/instances/wan | jq -e '.devices.radio' >/dev/null || ic config device add wan radio pci address="${radio_device##*/}"
    [ "$(ic config device get wan radio address)" = "${radio_device##*/}" ] || die 'wan radio differs'
}

# Read the old disk in userspace; only the rebuilt disk may reach the kernel.
wan_read() {
    running wan && die 'refusing to read a running wan disk'
    disk=$pool/virtual-machines/wan/root.img
    [ -f "$disk" ] || die 'unexpected Incus Btrfs VM disk layout'
    sfdisk --json "$disk" >"$work/wan-partitions"
    range=$(jq -er --arg disk "$disk" --argjson bytes "$(stat -c %s "$disk")" '
        .partitiontable | select(.label == "gpt" and .unit == "sectors") |
        .sectorsize as $s | select($s == 512 or $s == 4096) |
        [.partitions[] | select(.node == ($disk + "2"))] | select(length == 1) | .[0] |
        select(.start > 0 and .size > 0 and .start == (.start | floor) and .size == (.size | floor)) |
        select((.start + .size) <= ($bytes / $s | floor)) |
        "\(.start * $s) \(.size * $s)"' "$work/wan-partitions") || die 'invalid wan partition 2'
    read -r offset bytes <<EOF
$range
EOF
    mkdir -p "$work/wan-read/out" "$work/iwd"
    dd if="$disk" of="$work/wan-read/partition" bs=4M iflag=skip_bytes,count_bytes \
        skip="$offset" count="$bytes" status=none
    [ "$(stat -c %s "$work/wan-read/partition")" = "$bytes" ] || die 'short wan partition copy'
    chown 65534:65534 "$work/wan-read/partition" "$work/wan-read/out"
    chmod 0400 "$work/wan-read/partition"
    chmod 0700 "$work/wan-read/out"
    chmod 0711 "$work/wan-read"
    (cd "$work/wan-read" && setpriv --reuid=65534 --regid=65534 --clear-groups --no-new-privs \
        debugfs -R 'rdump /var/lib/iwd out' partition) >"$work/wan-debugfs" 2>&1 9>&- 8>&- 7>&- 6>&-
    if [ -d "$work/wan-read/out/iwd" ] && [ ! -L "$work/wan-read/out/iwd" ]; then
        for file in "$work/wan-read/out/iwd/"* "$work/wan-read/out/iwd/".[!.]* "$work/wan-read/out/iwd/"..?*; do
            [ -f "$file" ] && [ ! -L "$file" ] || continue
            name=${file##*/}
            case $name in *.psk|*.open|*.8021x) ;; *) continue ;; esac
            ssid=${name%.*}
            case $ssid in
            =*) hex=${ssid#=}; case $hex in ''|*[!0-9a-fA-F]*) continue ;; esac
                [ "${#hex}" -le 64 ] && [ $((${#hex} % 2)) = 0 ] || continue ;;
            *) case $ssid in ''|*[!\ -~]*) continue ;; esac
                [ "${#ssid}" -le 32 ] || continue ;;
            esac
            [ "$(stat -c %s "$file")" -le 65536 ] || continue
            install -m 600 -- "$file" "$work/iwd/$name"
        done
    fi
    rm -rf "$work/wan-read"
}
wan_mount() {
    running wan && die 'refusing to mount a running wan disk'
    [ -f "$pool/virtual-machines/wan/root.img" ] || die 'unexpected Incus Btrfs VM disk layout'
    mkdir -p "$work/root"
    loop=$(losetup --find --show --partscan "$pool/virtual-machines/wan/root.img")
    retry test -b "${loop}p2"
    mount -t ext4 -o nodev,nosuid,noexec "${loop}p2" "$work/root" 9>&- 8>&- 7>&- 6>&-
    mounted=1
}
prune() {
    printf '%s\n' "$state/backups/$1-"*.tar.gz | sort -r | sed '1,3d' >"$work/prune"
    while read -r backup; do
        old=${backup##*/}; old=${old#"$1-"}; old=${old%.tar.gz}
        for volume in $(volumes "$1"); do ic storage volume snapshot delete default "$volume" "$old"; done
        rm "$backup"
    done <"$work/prune"
}
replace() {
    step="replace $1"
    guest=$1
    snap=guests-$(date -u +%Y%m%dT%H%M%S)-$$
    import_image "$guest"
    case $guest in fw1|fw2) fw_touched=1 ;; esac
    step="backup $guest"
    [ -n "$pending" ] || cp "$keys/known_hosts" "$state/known_hosts.before"
    if running "$guest"; then starting=$guest; ic stop "$guest" --timeout 60; fi
    # Drop a local memory pin (by hand or update fw); the fw profile carries it now.
    case $guest in
    fw1|fw2)
        mem=$(ic config get "$guest" limits.memory)
        [ -z "$mem" ] || ic config unset "$guest" limits.memory ;;
    esac
    mkdir -p "$state/backups"
    for volume in $(volumes "$guest"); do ic storage volume snapshot create default "$volume" "$snap" --no-expiry; done
    ic export "$guest" "$state/backups/$guest-$snap.tar.gz" --instance-only || { rm -f "$state/backups/$guest-$snap.tar.gz"; die 'cannot export guest backup'; }
    if [ -n "$pending" ]; then cp "$state/pending" "$work/pending"; else : >"$work/pending"; fi
    printf '%s %s\n' "$guest" "$snap" >>"$work/pending"
    sync
    mv "$work/pending" "$state/pending"
    pending=1
    starting=
    sync
    if [ "$guest" = wan ]; then
        wan_read
    fi
    step="rebuild $guest"
    ic query "/1.0/instances/$guest/snapshots?recursion=1" >"$work/snapshots"
    jq -r '.[].name | split("/")[-1] | select(startswith("guests-"))' "$work/snapshots" >"$work/old-snapshots"
    while read -r old; do ic snapshot delete "$guest" "$old"; done <"$work/old-snapshots"
    ic rebuild "candidate-$guest" "$guest"
    case $guest in
    wan)
        wan_mount
        mkdir -p "$work/root/var/lib/iwd"
        cp -a "$work/iwd/." "$work/root/var/lib/iwd/"
        unmount_root
        ;;
    web|admin)
        ic file pull "$guest/usr/local/bin/browser-launch" "$work/browser-launch"
        sh -n "$work/browser-launch" 9>&- 8>&- 7>&- 6>&-
        ;;
    esac
    case $guest in
    web|admin) ;;
    *)
        seed_start "$guest"
        # Nothing comes over from the old firewall; the host pushes its DNS data afterwards.
        case $guest in fw1|fw2) fw_check "$guest" release ;; esac
        ;;
    esac
}
commit_update() {
    step=commit
    cp "$state/pending" "$work/committed"
    while read -r guest snap; do
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$guest" "$snap" >>"$state/updates"
    done <"$work/committed"
    sync
    rm "$state/pending"
    pending=
    while read -r guest snap; do prune "$guest"; done <"$work/committed"
}
browser_commit() {
    # The durable marker means both replacements passed; recovery finishes the commit.
    browser_image=$(cat "$state/browser.ready")
    image_alias browser "$browser_image"
    [ ! -f "$state/pending" ] || commit_update
    rm -rf "$state/profiles.before"
    sync
    rm "$state/browser.ready"
    sync
}
good_slot() {
    slot status >"$work/slot" 9>&- 8>&- 7>&- 6>&-
    awk '$1 == "booted" {r=$2; s=$4} $1 == "good" {g=$2} $1 == "highest" {h=$2}
        $1 == "slot" {release[$2]=$3; status[$2]=$4}
        END {exit !(r ~ /^[0-9]+$/ && r == g && r <= h && release[s] == r && status[s] == "good")}' "$work/slot" ||
        die 'booted host slot is not marked good'
}

init() {
    step=init
    [ ! -e "$state/initialized" ] || die 'already initialized'
    rc-service incus status >/dev/null 9>&- 8>&- 7>&- 6>&- || rc-service incus start 9>&- 8>&- 7>&- 6>&-
    retry ic query /1.0 >/dev/null
    release=$(cd "$1" && pwd)
    for kind in fw wan svc browser; do
        image_dir=$release/guests/$kind
        verify_image "$kind"
    done
    if [ ! -f "$state/init/release" ]; then
        [ "$(ic list --format json | jq length)" = 0 ] || die 'init needs an empty default project or its recovery journal'
        mkdir -p "$state/init"
        printf '%s\n' "$release" >"$work/release"
        mv "$work/release" "$state/init/release"
        sync
    fi
    [ "$(cat "$state/init/release")" = "$release" ] || die 'resume init with the original release directory'
    if [ ! -f "$state/init/id" ]; then
        openssl rand -hex 16 >"$work/init-id"
        mv "$work/init-id" "$state/init/id"
        sync
    fi
    init_id=$(cat "$state/init/id")
    initializing=1
    credentials
    btrfs subvolume show /var/lib/incus-pool >/dev/null || die 'installer must create /var/lib/incus-pool on Btrfs'
    ic admin init --preseed <"$lib/preseed.yaml"
    init_done preseed
    if [ ! -f "$state/init/server" ]; then
        if ! rc-service incus stop 9>&- 8>&- 7>&- 6>&-; then
            # Right after the preseed the power-off stop (SIGPWR, 40 s) can run out. No instance
            # exists yet, so a plain stop loses nothing.
            start-stop-daemon --stop --retry TERM/60/KILL/5 --pidfile /run/incus.pid || die 'incus did not stop'
            rc-service incus zap 9>&- 8>&- 7>&- 6>&-
        fi
        install -m 600 "$tls/incus-server.key" /var/lib/incus/server.key
        install -m 644 "$tls/incus-server.crt" /var/lib/incus/server.crt
        rc-service incus start 9>&- 8>&- 7>&- 6>&-
        retry ic query /1.0 >/dev/null
        init_done server
    fi
    sh "$lib/host-net" 9>&- 8>&- 7>&- 6>&-
    trust=$(openssl x509 -in "$tls/incus-client.crt" -outform DER | sha256sum | awk '{print $1}')
    ic config trust list --format json | jq -e --arg fp "$trust" '.[] | select(.fingerprint == $fp)' >/dev/null ||
        ic config trust add-certificate "$tls/incus-client.crt" --type metrics --name svc-metrics
    ic config set core.metrics_address=100.80.1.10:8444
    ic config set core.metrics_authentication=true
    profile svc "$release/guests/svc/incus.yaml"
    for role in base web tmp portal admin; do profile "browser-$role" "$release/guests/browser/incus/$role.yaml"; done
    volume_create svc-metrics 2GiB
    volume_create svc-logs 6GiB
    volume_create svc-grafana 512MiB
    volume_create browser-web-state 4GiB
    volume_create browser-admin-state 512MiB
    image_dir=$release/guests/browser
    import_image browser
    fingerprint=$(ic query /1.0/images/aliases/candidate-browser | jq -er .target)
    ic image alias list --format json | jq -e '.[] | select(.name == "browser")' >/dev/null && ic image alias delete browser
    ic image alias create browser "$fingerprint"
    image_dir=$release/guests/fw
    for node in fw1 fw2; do
        init_guest "$node" --vm --profile fw
    done
    ic config set fw1 boot.autostart.priority=40
    ic config set fw2 boot.autostart.priority=30
    image_dir=$release/guests/wan
    init_guest wan --vm --profile wan
    radio
    image_dir=$release/guests/svc
    init_guest svc --profile svc
    ic config set svc security.idmap.isolated=true
    image_dir=$release/guests/fw
    for node in fw1 fw2; do seed_start "$node"; done
    retry pair fw1 fw2
    seed_start wan
    retry pair fw1 fw2
    seed_start svc
    mkdir -p /var/lib/convergent/syslog-ca /var/lib/syslog-ng
    ca_hash=$(openssl x509 -in "$tls/ca.crt" -hash -noout)
    install -m 600 "$tls/ca.crt" "/var/lib/convergent/syslog-ca/$ca_hash.0"
    rc-service syslog-ng reload 9>&- 8>&- 7>&- 6>&-
    for node in fw1 fw2 wan svc; do ic config set "$node" boot.autostart=true; done
    sync
    touch "$state/initialized"
    # Clears the bar's SETUP after a manual retry too.
    [ ! -e /run/convergent/status/setup ] || echo 'done' >/run/convergent/status/setup
}
update() {
    step="update $1"
    good_slot
    [ -f "$state/initialized" ] || die 'init has not completed'
    [ ! -f "$state/browser.ready" ] || browser_commit
    [ ! -d "$state/profiles.before" ] || profiles_restore
    [ ! -f "$state/pending" ] || { pending=1; rollback; die 'interrupted update restored; rerun update'; }
    image_dir=$2
    verify_image "$1"
    case $1 in
    fw)
        [ -s "$state/carp-pass" ] || die 'missing laptop CARP password'
        ic profile set fw boot.autostart.delay=0
        # Installs from before 1 GiB: KARL beside the blocklist ran 384 MiB out of memory. A running
        # VM cannot always grow, so each keeps its old size locally until replace() drops the pin.
        old=$(ic profile get fw limits.memory)
        if [ "$old" != 1GiB ]; then
            for node in fw1 fw2; do
                mem=$(ic config get "$node" limits.memory)
                [ -n "$mem" ] || ic config set "$node" limits.memory="$old"
            done
            ic profile set fw limits.memory=1GiB
        fi
        for node in fw1 fw2; do
            for suffix in qcow2 pf.sha256 rules.sha256; do
                [ -s "$image_dir/$node.$suffix" ] || die "missing $node.$suffix"
            done
            actual=$(rsh "$node" "awk '{for(i=1;i<NF;i++) if(\$i==\"pass\") print \$(i+1)}' /etc/hostname.carp0 | sha256 -q")
            [ "$actual" = "$(sha256sum "$state/carp-pass" | awk '{print $1}')" ] || die 'running CARP password differs from laptop state'
        done
        retry pair fw1 fw2
        replace fw2
        retry pair fw1 fw2
        fw_check fw2
        backup_soak
        demoted=fw1
        rsh fw1 'ifconfig -g carp carpdemote 128'
        retry pair fw2 fw1
        soak fw2 fw1
        commit_update
        replace fw1
        fw_check fw1
        retry pair fw2 fw1
        rsh fw1 'rm /etc/convergent/seeded/demote && ifconfig -g upgrade -carpdemote 128'
        demoted=
        retry pair fw1 fw2
        soak fw1 fw2
        commit_update
        ;;
    wan|svc)
        if [ "$1" = wan ]; then
            ic profile device set wan eth0 security.ipv4_filtering=false
            ic profile set wan boot.autostart.delay=0
        fi
        [ "$1" != svc ] || [ ! -f "$image_dir/incus.yaml" ] || { profiles_save svc && profile svc "$image_dir/incus.yaml"; }
        replace "$1"
        commit_update
        rm -rf "$state/profiles.before"
        ;;
    web|admin)
        running "$1" && die 'close this browser with tools/browser before updating it'
        # The role profiles travel with the browser image.
        profiles_save browser-base browser-web browser-tmp browser-portal browser-admin
        for role in base web tmp portal admin; do profile "browser-$role" "$image_dir/incus/$role.yaml"; done
        replace "$1"
        commit_update
        rm -rf "$state/profiles.before"
        ;;
    browser)
        browser_pending=
        # Browser sessions hold this lock through shutdown; new launches also need the guests lock.
        exec 6>/run/convergent/browser-update.lock
        if ! flock -n 6; then
            echo 'guests: browser is running; browser update waits for a later guests apply'
            browser_pending=1
            exec 6>&-
            return
        fi
        ic list --format json >"$work/browsers"
        if jq -e '.[] | select(.status == "Running" and (.profiles | index("browser-base")))' "$work/browsers" >/dev/null; then
            echo 'guests: browser is running; browser update waits for a later guests apply'
            browser_pending=1
            exec 6>&-
            return
        fi
        profiles_save browser-base browser-web browser-tmp browser-portal browser-admin
        for role in base web tmp portal admin; do profile "browser-$role" "$image_dir/incus/$role.yaml"; done
        import_only=1
        import_image browser
        import_only=
        browser_image=$fingerprint
        for node in web admin; do
            jq -e --arg n "$node" '.[] | select(.name == $n)' "$work/browsers" >/dev/null || continue
            if running "$node"; then
                die "$node started during the browser update"
            fi
            replace "$node"
        done
        printf '%s\n' "$browser_image" >"$work/browser.ready"
        sync
        mv "$work/browser.ready" "$state/browser.ready"
        sync
        browser_commit
        exec 6>&-
        ;;
    *) die 'update accepts fw (the pair), wan, svc, browser, web or admin' ;;
    esac
}
apply() {
    applying=1
    update_status running
    good_slot
    [ -f "$state/initialized" ] || die 'init has not completed'
    booted=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^convergent\.release=//p')
    case $booted in ''|*[!0-9]*) die 'the kernel command line names no release' ;; esac
    staged=/var/lib/convergent/guest-updates
    [ ! -L "$staged" ] || die "$staged is a symlink"
    [ -d "$staged" ] || return 0
    [ "$(stat -c '%u %a %F' "$staged")" = '0 700 directory' ] || die "$staged is not root's private directory"
    for entry in "$staged"/* "$staged"/.[!.]* "$staged"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        [ ! -L "$entry" ] || die "$entry is a symlink"
        # A newer release waits for its reboot; an older one is a fallback boot or superseded.
        name=${entry##*/}
        case $name in *[!0-9]*) ;; *) [ "$name" -le "$booted" ] || continue ;; esac
        [ "$entry" = "$staged/$booted" ] || rm -rf "$entry"
    done
    staged=$staged/$booted
    [ -d "$staged" ] || return 0
    [ "$(stat -c '%u %a %F' "$staged")" = '0 700 directory' ] || die "$staged is not root's private directory"
    [ -z "$(find "$staged" -type l -print)" ] || die "$staged contains symlinks"
    installed=/var/lib/convergent/release-guests
    [ ! -L "$installed" ] && [ ! -L "$installed/guests" ] || die 'installed guests directory is a symlink'
    mkdir -p "$installed/guests"
    # Nothing changes under an open browser (an admin one uses svc's Grafana); all of it waits.
    exec 6>/run/convergent/browser-update.lock
    if ! flock -n 6; then
        echo 'guests: a browser is open; close it, then sys guests update'
        browser_pending=1
        return 0
    fi
    for kind in svc wan fw browser; do
        [ -d "$staged/$kind" ] || continue
        echo "guests: applying $kind from release $booted"
        update "$kind" "$staged/$kind"
        [ "$kind" != browser ] || [ -z "$browser_pending" ] || continue
        [ ! -L "$installed/guests/$kind" ] && [ ! -L "$installed/guests/$kind.old" ] || die 'installed guest is a symlink'
        if [ -e "$installed/guests/$kind" ]; then
            rm -rf "$installed/guests/$kind.old"
            mv "$installed/guests/$kind" "$installed/guests/$kind.old"
        fi
        mv "$staged/$kind" "$installed/guests/$kind"
        rm -rf "$installed/guests/$kind.old"
        echo "guests: applied $kind from release $booted"
    done
    rmdir "$staged" 2>/dev/null || :
}

# Capture the command status before diagnostics or rollback can change it.
trap 'cleanup "$?"' 0
trap 'die "received HUP"' HUP
trap 'die "received INT"' INT
trap 'die "received TERM"' TERM
case ${1:-}:$# in init:2|update:3|apply:1|status:1) ;; *) die 'usage: guests init <release-dir> | update <guest> <image-dir> | apply | status' ;; esac
[ "$(id -u)" = 0 ] || die 'run as root'
if [ "$1" = status ]; then
    step=status
    instances=$(ic list --format json)
    printf '%s\n' "$instances" | jq -r 'sort_by(.name)[] | "\(.name) \(.status | ascii_downcase)"'
    exit
fi
mkdir -p "$state" /run/convergent
exec 9>/run/convergent/guests.lock
# Wait out the checker's shared hold (cron, every minute); another guests run holds it longer.
flock -w 600 9 || die 'another guests operation is running'
if [ "$1" != apply ] && [ "${2:-}" != browser ]; then
    exec 6>/run/convergent/browser-update.lock
    flock -w 600 6 || die 'close browsers before updating guests'
fi
exec 8>/run/convergent/dns-push.lock
flock -w 120 8 || die 'a DNS push is still running'
exec 7>/run/convergent/portal.lock
flock -w 60 7 || die 'a portal change is still running'
work=$(mktemp -d "$state/work.XXXXXX")
case $1 in init) init "$2" ;; update) update "$2" "$3" ;; apply) apply ;;
esac
