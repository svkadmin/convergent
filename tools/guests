        openssl rand -hex 16 >"$work/init-id"
        mv "$work/init-id" "$state/init/id"
        sync
    fi
    init_id=$(cat "$state/init/id")
    initializing=1
    recovering=1
    [ ! -f "$state/committed" ] || commit_update
    credentials
    [ ! -f "$state/browser.ready" ] || browser_commit
    [ ! -d "$state/profiles.before" ] || profiles_restore
    prepare_cleanup
    [ ! -f "$state/pending" ] || { pending=1; rollback; }
    btrfs subvolume show /var/lib/incus-pool >/dev/null || die 'installer must create /var/lib/incus-pool on Btrfs'
    ic admin init --preseed <"$lib/preseed.yaml"
    init_done preseed
    if [ ! -f "$state/init/server" ]; then
        init_server
    fi
    sh "$lib/host-net" 9>&- 8>&- 7>&- 6>&-
    work_network
    trust=$(openssl x509 -in "$tls/incus-client.crt" -outform DER | sha256sum | awk '{print $1}')
    ic config trust list --format json | jq -e --arg fp "$trust" '.[] | select(.fingerprint == $fp)' >/dev/null ||
        ic config trust add-certificate "$tls/incus-client.crt" --type metrics --name svc-metrics
    ic config set core.metrics_address=100.80.1.10:8444
    incus_ui_config
    ic config set core.metrics_authentication=true
    profile svc "$release/guests/svc/incus.yaml"
    image_dir=$release/guests/browser
    browser_migrate
    for role in base def tmp int; do profile "browser-$role" "$release/guests/browser/incus/$role.yaml"; done
    volume_create svc-metrics 2GiB
    volume_create svc-logs 6GiB
    volume_create svc-grafana 512MiB
    volume_create browser-def-state 4GiB
    volume_create browser-int-state 512MiB
    remmina_volumes
    profile remmina "$release/guests/remmina/incus.yaml"
    image_dir=$release/guests/remmina
    import_image remmina
    image_dir=$release/guests/browser
    import_image browser
    if [ -d "$state/browser.rename" ]; then
        browser_image=$fingerprint
        ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
        for node in def int; do
            jq -e --arg n "$node" 'any(.[]; .name == $n)' "$work/browsers" >/dev/null || continue
            replace "$node"
        done
        printf '%s\n' "$browser_image" >"$work/browser.ready"
        sync
        mv "$work/browser.ready" "$state/browser.ready"
        sync
        browser_commit
    fi
    image_dir=$release/guests/fw
    for node in fw1 fw2; do
        init_guest "$node" --vm --profile fw
    done
    work_trunks
    work_profiles
    image_dir=$release/guests/wan
    init_guest wan --vm --profile wan
    radio
    image_dir=$release/guests/svc
    init_guest svc --profile svc
    ic config set svc security.idmap.isolated=true
    parallel_autostart
    image_dir=$release/guests/fw
    for node in fw1 fw2 wan svc; do seed_launch "$node"; done
    for node in fw1 fw2; do seed_finish "$node"; done
    retry pair fw1 fw2
    seed_finish wan
    retry pair fw1 fw2
    retry seed_applied svc
    mkdir -p /var/lib/convergent/syslog-ca /var/lib/syslog-ng
    certificates_apply
    seed_finish svc
    ca_hash=$(openssl x509 -in "$tls/ca.crt" -hash -noout)
    install -m 600 "$tls/ca.crt" "/var/lib/convergent/syslog-ca/$ca_hash.0"
    rc-service syslog-ng reload 9>&- 8>&- 7>&- 6>&-
    for node in fw1 fw2 wan svc; do ic config set "$node" boot.autostart=true; done
    sync
    images_prune
    touch "$state/initialized"
    sync
    # Clears the bar's SETUP after a manual retry too.
    [ ! -e /run/convergent/status/setup ] || echo 'done' >/run/convergent/status/setup
}
update() {
    step="update $1"
    [ "$1" != fw ] || [ ! -e /var/lib/convergent/firewall-maintenance ] ||
        die 'firewall maintenance is active; end it with sys firewall undo first'
    logger -t guests "update $1 started: $2" 2>/dev/null || :
    good_slot
    [ -f "$state/initialized" ] || die 'init has not completed'
    case $1 in fw|wan|svc|browser|def|int|remmina) ;; *) die 'update accepts fw (the pair), wan, svc, browser, def, int or remmina' ;; esac
    # Recovery also changes browser objects; take the session lock before touching journals.
    recovering=
    # Under apply or a manual update, fd 6 already holds this lock: reopening it would drop it for an instant.
    [ -n "$applying" ] || [ -n "${browser_locked:-}" ] || exec 6>/run/convergent/browser-update.lock
    if ! flock -n 6; then
        echo 'guests: a browser is open; close it, then sys guests update'
        logger -t guests "update $1 deferred: browser is open" 2>/dev/null || :
        browser_pending=1
        return
    fi
    recovering=1
    # A commit has no way back: a wan or svc that stays unhealthy after it is redone in place by its own update.
    if [ -f "$state/committed" ] && ! commit_update; then
        case $1 in wan|svc) awk -v g="$1" '$1 != g || NF != 3 {bad=1} END {exit !(NR == 1 && !bad)}' "$state/committed" ;; *) false ;; esac ||
            die 'cannot finish committed update'
        rebuilding=$1 pending=1
    fi
    [ ! -f "$state/browser.ready" ] || browser_commit
    [ -n "$rebuilding" ] || [ ! -d "$state/profiles.before" ] || profiles_restore
    prepare_cleanup
    [ -n "$rebuilding" ] || [ ! -f "$state/pending" ] || { pending=1; rollback; }
    fw_release
    dns_restore
    [ ! -d "$state/browser.rename" ] || [ "$1" = browser ] || die 'resume the browser update first'
    image_dir=$2
    verify_image "$1"
    stale_installed "$1"
    case $1 in
    fw)
        [ -s "$state/carp-pass" ] || die 'missing laptop CARP password'
        ic profile set fw boot.autorestart=true
        # Installs from before 1 GiB: KARL beside the blocklist ran 384 MiB out of memory. A running
        # VM cannot always grow, so each keeps its old size locally until replace() drops the pin.
        old=$(ic profile get fw limits.memory)
        if [ "$old" != 1GiB ]; then
            for node in fw1 fw2; do
                mem=$(ic config get "$node" limits.memory)
                [ -n "$mem" ] || ic config set "$node" limits.memory="$old"
            done
            ic profile set fw limits.memory=1GiB
        fi
        # Incus starts the firewalls beside the boot-time apply: wait read-only for their sshd first.
        for node in fw1 fw2; do if running "$node"; then retry reachable "$node" || :; fi; done
        for node in fw1 fw2; do
            for suffix in qcow2 pf.sha256 rules.sha256; do
                [ -s "$image_dir/$node.$suffix" ] || die "missing $node.$suffix"
            done
            actual=$(guest_reply 128 rsh "$node" "awk '{for(i=1;i<NF;i++) if(\$i==\"pass\") print \$(i+1)}' /etc/hostname.carp0 | sha256 -q")
            [ "$actual" = "$(sha256sum "$state/carp-pass" | awk '{print $1}')" ] || die 'running CARP password differs from laptop state'
        done
        topology_changed=
        for node in fw1 fw2; do
            actual=$(guest_reply 128 rsh "$node" 'if test -f /etc/convergent/topology.sha256; then cat /etc/convergent/topology.sha256; fi')
            [ "$actual" = "$(cat "$image_dir/topology.sha256")" ] || topology_changed=1
        done
        if [ -n "$topology_changed" ]; then
            topology_update
        else
        cmp -s "$image_dir/topology.sha256" /etc/convergent/topology.sha256 || die 'firewall topology differs from host'
        retry pair fw1 fw2
        replace fw2
        retry pair fw1 fw2
        fw_check fw2
        # DNS policy (blocklist, owner records) before the replacement can be promoted.
        dns_restore
        backup_soak
        touch "$state/fw.handoff"
        sync
        fw_mutate fw1 'set -e
if [ -f /etc/convergent/segments ]; then
    interfaces=$(awk -v mode=interfaces -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments) || exit 1
else
    interfaces="carp0 carp1 carp2 carp3 carp4 carp5"
fi
for i in $interfaces; do ifconfig "$i" group handoff; done
ifconfig -g handoff carpdemote 128'
        retry pair fw2 fw1
        soak fw2 fw1
        commit_update
        replace fw1
        fw_check fw1
        dns_restore
        retry pair fw2 fw1
        fw_release
        retry pair fw1 fw2
        soak fw1 fw2
        commit_update
        fi
        # Recorded once committed: a later failure must not redo the update, nor leave rebuild on the old images.
        record_installed "$1" "$2"
        work_profiles
        ;;
    # Remmina: the shared volume deliberately never participates in app rollback.
    remmina)
        remmina_volumes
        ic query '/1.0/instances?recursion=1&project=default' >"$work/remmina-instances"
        if jq -e 'any(.[]; .name == "remmina")' "$work/remmina-instances" >/dev/null; then
            jq -e '.[] | select(.name == "remmina") | .type == "container" and .profiles == ["remmina"] and .status == "Stopped"' "$work/remmina-instances" >/dev/null ||
                die 'close Remmina before updating; its fixed profile is required'
            profiles_save remmina
            profile remmina "$image_dir/incus.yaml"
            replace remmina
            commit_update
        else
            profile remmina "$image_dir/incus.yaml"
            import_image remmina
        fi
        record_installed "$1" "$2"
        rm -rf "$state/profiles.before"
        ;;
    # End Remmina.
    wan|svc)
        if [ "$1" = wan ]; then
            cmp -s "$image_dir/topology.sha256" /etc/convergent/topology.sha256 || die 'WAN topology differs from host'
            sh "$lib/work-gate" close
            ic profile device set wan eth0 security.ipv4_filtering=false
            ic profile set wan boot.autorestart=true
        fi
        [ "$1" != svc ] || certificates_prepare
        [ "$1" != svc ] || [ ! -f "$image_dir/incus.yaml" ] || { profiles_save svc && profile svc "$image_dir/incus.yaml"; }
        replace "$1"
        commit_update
        record_installed "$1" "$2"
        rm -rf "$state/profiles.before"
        # Apply deploys after WAN has its current SSH commands.
        [ "$1" != svc ] || [ -n "$applying" ] || certificates_apply
        ;;
    def|int)
        browser_migrate
        if [ -d "$state/browser.rename" ]; then update browser "$image_dir"; return; fi
        running "$1" && die 'close this browser with tools/browser before updating it'
        # The role profiles travel with the browser image.
        profiles_save browser-base browser-def browser-tmp browser-int
        for role in base def tmp int; do profile "browser-$role" "$image_dir/incus/$role.yaml"; done
        replace "$1"
        commit_update
        record_installed "$1" "$2"
        rm -rf "$state/profiles.before"
        ;;
    browser)
        browser_pending=
        ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
        if jq -e '.[] | select(.status == "Running" and .name != "web" and .name != "admin" and .name != "portal" and (.profiles | index("browser-base")))' "$work/browsers" >/dev/null; then
            echo 'guests: browser is running; browser update waits for a later guests apply'
            logger -t guests 'update browser deferred: browser is running' 2>/dev/null || :
            browser_pending=1
            recovering=
            # Apply keeps its lock: certificates_apply still runs under it.
            [ -n "$applying" ] || exec 6>&-
            return
        fi
        browser_migrate
        ic query '/1.0/instances?recursion=1&project=default' >"$work/browsers"
        profiles_save browser-base browser-def browser-tmp browser-int
        for role in base def tmp int; do profile "browser-$role" "$image_dir/incus/$role.yaml"; done
        import_only=1
        import_image browser
        import_only=
        browser_image=$fingerprint
        for node in def int; do
            jq -e --arg n "$node" '.[] | select(.name == $n)' "$work/browsers" >/dev/null || continue
            if running "$node"; then
                die "$node started during the browser update"
            fi
            replace "$node"
        done
        printf '%s\n' "$browser_image" >"$work/browser.ready"
        sync
        mv "$work/browser.ready" "$state/browser.ready"
        sync
        browser_commit
        record_installed "$1" "$2"
        recovering=
        [ -n "$applying" ] || exec 6>&-
        ;;
    *) die 'update accepts fw (the pair), wan, svc, browser, def, int or remmina' ;;
    esac
    parallel_autostart
    sh "$lib/work-gate" || echo 'guests: work access closed until all topology hashes agree' >&2
    logger -t guests "update $1 done: $2" 2>/dev/null || :
}
stale_installed() {
    installed=/var/lib/convergent/release-guests
    [ ! -L "$installed" ] && [ ! -L "$installed/guests" ] || die 'installed guests directory is a symlink'
    mkdir -p "$installed/guests"
    case $1 in def|int) installed_kind=browser ;; *) installed_kind=$1 ;; esac
    # A committed replacement can outlive a failed archive copy.
    touch "$installed/guests/$installed_kind.stale"
    sync
}
record_installed() {
    installed=/var/lib/convergent/release-guests
    [ ! -L "$installed" ] && [ ! -L "$installed/guests" ] || die 'installed guests directory is a symlink'
    mkdir -p "$installed/guests"
    case $1 in def|int) installed_kind=browser ;; *) installed_kind=$1 ;; esac
    [ ! -L "$installed/guests/$installed_kind" ] && [ ! -L "$installed/guests/$installed_kind.old" ] || die 'installed guest is a symlink'
    # One role cannot certify the whole browser generation.
    case $1 in def|int) return ;; esac
    installed_source=$2
    if [ -z "$applying" ]; then
        mkdir "$work/installed"
        cp -a "$2/." "$work/installed/"
        installed_source=$work/installed
    fi
    sync
    if [ -e "$installed/guests/$1" ]; then
        rm -rf "$installed/guests/$1.old"
        mv "$installed/guests/$1" "$installed/guests/$1.old"
    fi
    mv "$installed_source" "$installed/guests/$1"
    sync
    rm -rf "$installed/guests/$1.old"
    rm -f "$installed/guests/$1.stale"
    sync
}
maintenance_due() {
    for journal in preparing pending committed browser.ready browser.rename profiles.before dns.stale fw.handoff; do
        [ ! -e "$state/$journal" ] || return 0
    done
    [ -f "$state/normalized" ] || return 0
    certificates_due && return 0
    [ -f /var/lib/convergent/release-guests/guests/browser/incus/def.yaml ] && browser_legacy
}
apply() {
    applying=1
    update_status running
    good_slot
    [ -f "$state/initialized" ] || die 'init has not completed'
    # Reconcile even when no guest images or certificates are due.
    /usr/local/sbin/incus-ui --reconcile 9>&- 8>&- 7>&- 6>&-
    incus_ui_config
    booted=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^convergent\.release=//p')
    case $booted in ''|*[!0-9]*) die 'the kernel command line names no release' ;; esac
    staged=/var/lib/convergent/guest-updates
    [ ! -L "$staged" ] || die "$staged is a symlink"
    # A retry can stop between renames, even for a release not booted yet.
    for entry in "$staged"/*.old; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        name=${entry##*/}
        name=${name%.old}
        case $name in ''|*[!0-9]*) continue ;; esac
        [ "$(stat -c '%u %a %F' "$staged")" = '0 700 directory' ] || die "$staged is not root's private directory"
        [ ! -L "$entry" ] && [ "$(stat -c '%u %a %F' "$entry")" = '0 700 directory' ] || die "$entry is not root's private directory"
        [ ! -L "$staged/$name" ] || die "$staged/$name is a symlink"
        [ -e "$staged/$name" ] || mv -T "$entry" "$staged/$name"
        sync -f "$staged" || die 'could not sync recovered guests'
    done
    [ -d "$staged/$booted" ] || maintenance_due || { start_stopped; return 0; }
    # Nothing changes under an open browser (an int one uses svc's Grafana).
    exec 6>/run/convergent/browser-update.lock
    if ! flock -n 6; then
        echo 'guests: a browser is open; close it, then sys guests update'
        browser_pending=1
        return 0
    fi
    parallel_autostart
    [ -f "$state/normalized" ] || touch "$tls/pending"
    touch "$state/normalized"
    sync
    recovering=1
    [ ! -f "$state/committed" ] || commit_update
    if [ ! -d "$staged/$booted/browser" ]; then
        [ ! -f "$state/browser.ready" ] || browser_commit
        [ ! -d "$state/profiles.before" ] || profiles_restore
        prepare_cleanup
        [ ! -f "$state/pending" ] || { pending=1; rollback; }
        fw_release
        # Old images do not understand def/int or tmp portal mode.
        if [ -f /var/lib/convergent/release-guests/guests/browser/incus/def.yaml ]; then
            image_dir=$lib/browser
            browser_migrate
            if [ -d "$state/browser.rename" ]; then
                browser_profiles_prune
                rm -rf "$state/profiles.before" "$state/browser.rename"
                sync
            fi
        fi
    fi
    # A fw update's soak needs wan and svc: started once no rollback is due.
    [ -f "$state/pending" ] || [ -f "$state/preparing" ] || start_stopped
    dns_restore
    [ -d "$staged" ] || { certificates_apply; return 0; }
    [ "$(stat -c '%u %a %F' "$staged")" = '0 700 directory' ] || die "$staged is not root's private directory"
    for entry in "$staged"/* "$staged"/.[!.]* "$staged"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        [ ! -L "$entry" ] || die "$entry is a symlink"
        # A newer release waits for its reboot; an older one is a fallback boot or superseded.
        name=${entry##*/}
        case $name in *[!0-9]*) ;; *) [ "$name" -le "$booted" ] || continue ;; esac
        [ "$entry" = "$staged/$booted" ] || rm -rf "$entry"
    done
    staged=$staged/$booted
    [ -d "$staged" ] || { certificates_apply; return 0; }
    [ "$(stat -c '%u %a %F' "$staged")" = '0 700 directory' ] || die "$staged is not root's private directory"
    [ -z "$(find "$staged" -type l -print)" ] || die "$staged contains symlinks"
    if [ -f "$staged/remmina.manifest" ]; then
        openssl pkeyutl -verify -pubin -inkey /etc/convergent/release.pub -rawin \
            -in "$staged/remmina.manifest" -sigfile "$staged/remmina.manifest.sig" >/dev/null || die 'invalid staged Remmina signature'
        awk -v release="$booted" '$1 == "release" {n++; if (NF != 2 || $2 != release) bad=1}
            END {exit bad || n != 1}' "$staged/remmina.manifest" || die 'Remmina sidecar is for another release'
        if [ -d "$staged/remmina" ]; then
            remmina_id=$( (cd "$staged/remmina" && { cat SHA256SUMS; sha256sum ./incus.yaml; }) | sha256sum | cut -d' ' -f1)
            awk -v id="$remmina_id" '$1 == "guest" {n++; if (NF != 3 || $2 != "remmina" || $3 != id) bad=1}
                END {exit bad || n != 1}' "$staged/remmina.manifest" || die 'staged Remmina identity differs'
        fi
    fi
    kinds='svc wan fw browser remmina'
    if [ -d "$state/browser.rename" ] || browser_legacy; then kinds='browser svc wan fw remmina'; fi
    for kind in $kinds; do
        [ -d "$staged/$kind" ] || continue
        echo "guests: applying $kind from release $booted"
        update "$kind" "$staged/$kind"
        [ "$kind" != browser ] || [ -z "$browser_pending" ] || continue
        echo "guests: applied $kind from release $booted"
    done
    [ -d "$staged/remmina" ] || rm -f "$staged/remmina.manifest" "$staged/remmina.manifest.sig"
    rmdir "$staged" 2>/dev/null || :
    certificates_apply
    sh "$lib/work-gate" || echo 'guests: work access closed: topology has not converged' >&2
}

# Capture the command status before diagnostics or rollback can change it.
trap 'cleanup "$?"' 0
trap 'die "received HUP"' HUP
trap 'die "received INT"' INT
trap 'die "received TERM"' TERM
case ${1:-}:$# in
init:2|update:3|rebuild:2|apply:1|status:1) ;;
update:4) [ "$4" = --trusted-local ] || die 'unknown update option' ;;
*) die 'usage: guests init <release-dir> | update <guest> <image-dir> [--trusted-local] | rebuild fw1|fw2 | apply | status' ;;
esac
[ "$(id -u)" = 0 ] || die 'run as root'
if [ "$1" = status ]; then
    step=status
    instances=$(ic query '/1.0/instances?recursion=1&project=default')
    printf '%s\n' "$instances" | jq -r 'sort_by(.name)[] | "\(.name) \(.status | ascii_downcase)"'
    exit
fi
# Authenticate manual input before archive recovery, journals or Incus can change.
if [ "$1" = update ] && [ "${4:-}" != --trusted-local ]; then
    # Under the state directory, where a killed run's stage is found and pruned below.
    mkdir -p "$state"
    manual_stage=$(mktemp -d "$state/stage.XXXXXX")
    case $3 in /*) source_image=$3 ;; *) source_image=./$3 ;; esac
    case $2 in remmina) manual_manifest=remmina.manifest ;; *) manual_manifest=guests.manifest ;; esac
    mkdir "$manual_stage/guests"
    cp -R "$source_image" "$manual_stage/guests/image"
    cp "$source_image/../../$manual_manifest" "$source_image/../../$manual_manifest.sig" "$manual_stage/"
    # Authenticate and consume the same private copy, including after the lock wait.
    set -- "$1" "$2" "$manual_stage/guests/image"
    manual_image "$2" "$3"
fi
mkdir -p "$state" /run/convergent
[ -w "$state" ] || die 'state disk lost or read-only: reboot'
exec 9>/run/convergent/guests.lock
# Wait out the checker's shared hold (cron, every minute); another guests run holds it longer.
flock -w 600 9 || die 'another guests operation is running'
[ ! -e /run/convergent/guests-stopping ] || die 'host is stopping guests'
# Recover the retry source before discarding an interrupted archive copy.
installed=/var/lib/convergent/release-guests
[ ! -L "$installed" ] && [ ! -L "$installed/guests" ] || die 'installed guests directory is a symlink'
for installed_kind in fw wan svc browser remmina; do
    [ ! -L "$installed/guests/$installed_kind" ] && [ ! -L "$installed/guests/$installed_kind.old" ] || die 'installed guest is a symlink'
    if [ ! -e "$installed/guests/$installed_kind" ] && [ -d "$installed/guests/$installed_kind.old" ]; then
        mv "$installed/guests/$installed_kind.old" "$installed/guests/$installed_kind"
        sync
    fi
done
# A killed manual update leaves its staged copy; a run still waiting for the lock has a fresh one.
for stale in "$state"/stage.??????; do
    [ "$stale" != "${manual_stage:-}" ] && [ -d "$stale" ] && [ ! -L "$stale" ] || continue
    [ -n "$(find "$stale" -maxdepth 0 -mmin +1440)" ] || continue
    rm -rf --one-file-system "$stale" || :
done
# A killed seed writer may leave a guest disk mounted below its scratch directory.
for stale in "$state"/work.??????; do
    [ -d "$stale" ] && [ ! -L "$stale" ] || continue
    if mountpoint -q "$stale/root"; then umount "$stale/root" 9>&- || continue; fi
    for disk in "$stale/seed.img" "$pool/virtual-machines/wan/root.img"; do
        [ -f "$disk" ] || continue
        for stale_loop in $(losetup -j "$disk" | cut -d: -f1); do losetup -d "$stale_loop" || :; done
    done
    rm -rf --one-file-system "$stale" || :
done
if [ "$1" != apply ] && [ "$1" != rebuild ] && [ "${2:-}" != browser ]; then
    exec 6>/run/convergent/browser-update.lock
    flock -n 6 || die 'close browsers before updating guests'
    browser_locked=1
fi
exec 8>/run/convergent/dns-push.lock
flock -w 120 8 || die 'a DNS push is still running'
exec 7>/run/convergent/portal.lock
flock -w 60 7 || die 'a portal change is still running'
work=$(mktemp -d "$state/work.XXXXXX")
# Exports from before 0.1.3 matter only to a pending journal of theirs.
[ -f "$state/pending" ] || rm -rf "$state/backups"
# Incus's own two-step work, cut by a power loss, has one way out each; every later step would fail.
storage_check() {
    ic query '/1.0/instances?recursion=1&project=default' >"$work/instances"
    ic storage volume list default --format json >"$work/volumes"
    jq -r --slurpfile v "$work/volumes" '.[] | select(.name | test("^(fw1|fw2|wan|svc|def|int|remmina)$")) |
        select(. as $i | any($v[0][]; .type == $i.type and .name == $i.name) | not) | "\(.name) \(.type)"' "$work/instances" >"$work/orphans"
    while read -r name type; do
        # Inside a rebuild, between dropping and recreating the root volume record (milliseconds).
        case $type in virtual-machine) codes="3, '$name', '', (SELECT id FROM projects WHERE name = 'default'), 1" ;;
        *) codes="0, '$name', '', (SELECT id FROM projects WHERE name = 'default'), 0" ;; esac
        image=$(awk -v g="$name" '$1 == g {print $3; exit}' "$state/pending" 2>/dev/null) || image=
        # A pair migration rebuilds from its own journal: the old root until committed, the new one after.
        if [ -z "$image" ]; then
            if [ -f "$state/fw.topology/committed" ]; then generation=new; else generation=old; fi
            image=$(cat "$state/fw.topology/$name.$generation" 2>/dev/null) || image=
        fi
        die "$name has no storage record (a rebuild cut by a power loss); put it back, rebuild, then recover: sudo incus admin sql global \"INSERT INTO storage_volumes (storage_pool_id, node_id, type, name, description, project_id, content_type, creation_date) VALUES ((SELECT id FROM storage_pools WHERE name = 'default'), (SELECT id FROM nodes), $codes, strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))\"; sudo incus --force-local --project default rebuild ${image:-<image>} $name; sys guests update"
    done <"$work/orphans"
    for volume in svc-metrics svc-logs svc-grafana browser-def-state browser-int-state remmina-state; do
        # Inside a snapshot restore, between moving the volume aside and replacing it (under a second).
        tmp=$pool/custom/default_$volume.incustmp
        [ -e "$tmp" ] || continue
        [ ! -e "$pool/custom/default_$volume" ] || die "$volume still has its pre-restore copy (a snapshot restore cut by a power loss); the restore itself is complete: sudo btrfs subvolume delete $tmp; sys guests update"
        die "$volume was moved aside by a snapshot restore cut by a power loss; move it back: sudo mv $tmp $pool/custom/default_$volume; sys guests update"
    done
}
[ "$1" = init ] || storage_check
[ "$1" = init ] || topology_recover
[ "$1" = init ] || autorestart_clear
# A rebuild journal from before 0.1.3 has only that command's way back; a newer one rolls back here.
if [ "$1" != rebuild ]; then
    for journal in preparing pending committed; do
        node=$(awk '$2 ~ /-rebuild$/ && NF == 2 {print $1; exit}' "$state/$journal" 2>/dev/null) || node=
        [ -z "$node" ] || die "interrupted firewall rebuild; run sys firewall rebuild $node"
    done
fi
case $1 in init) init "$2" ;; update) update "$2" "$3" ;; rebuild) rebuild "$2" ;; apply) apply ;;
esac
