            set -eu
            umask 077
            cat >"$1.new"
            chown "root:$2" "$1.new"
            chmod 640 "$1.new"
            mv "$1.new" "$1"
            sync
        ' sh "/etc/$2/tls/$4" "$3" <"$tls/$1"
    done
