            fw_mutate "$node" 'set -eu
                umask 077
                ca=/etc/convergent/seeded/syslog-ca.crt
                cat >"$ca.new"
                openssl x509 -in "$ca.new" -noout >/dev/null
                mv "$ca.new" "$ca"
