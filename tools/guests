#!/bin/sh
# ARCHITECTURE 4.1, 5.2, 7.1, 7.2, 13.
set -eu
. /usr/lib/convergent/guest-reply.sh
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077
lib=/usr/lib/convergent/incus
state=/var/lib/convergent/guests
keys=/var/lib/convergent/ssh
tls=$state/tls
conf=/etc/convergent/ssh_config
pool=/var/lib/incus/storage-pools/default
boot_timeout=${GUEST_BOOT_TIMEOUT:-900}
work= loop= mounted= pending= demoted= starting= probes= initializing=
applying= recovering= rebuilding= polling= manual_stage= browser_locked= frozen=
step=setup
. "$lib/fw-topology"
. "$lib/fw-leases"
. "$lib/firewall-heal"

fail() { [ -n "$polling" ] || logger -p user.err -t guests "$step: $*" 2>/dev/null || :; echo "guests: $step: $*" >&2; return 1; }
die() { fail "$*" || :; exit 1; }
# Keep lock descriptors out of clients and any helpers they leave running. A frozen VM monitor holds
# Incus reads and config changes (the instance listing waits on every VM): those are always bounded.
ic() {
    case $1:${2:-} in start:svc) svc_storage_check || return ;; esac
    if [ -n "$polling" ]; then
        case "$*" in
        'query /1.0'|'console fw1 --show-log'|'console fw2 --show-log'|'console wan --show-log'|\
        'exec svc -- true'|'exec svc -- cat /var/lib/convergent/seeded')
            case $1 in
            query) probe incus --force-local "$@" ;;
            *) probe incus --force-local --project default "$@" ;;
            esac
            return ;;
        esac
    fi
    case $1 in
    query) timeout -k 1 120 incus --force-local "$@" 9>&- 8>&- 7>&- 6>&- ;; # query takes no --project
    config) timeout -k 1 120 incus --force-local --project default "$@" 9>&- 8>&- 7>&- 6>&- ;;
    *) incus --force-local --project default "$@" 9>&- 8>&- 7>&- 6>&- ;;
    esac || {
        code=$?
        case $code:$1 in 124:query|124:config) frozen=1; fail "incus $1 timed out; $(frozen_hint)" || return 124 ;; esac
        fail "incus $* failed (status $code)" || return "$code"
    }
}
# The VM whose own state read times out too; a stopped or answering one is not frozen.
frozen_hint() {
    for node in fw1 fw2 wan; do
        probe incus --force-local query "/1.0/instances/$node/state?project=default" >/dev/null 2>&1 && continue
        [ "$?" = 124 ] || continue
        # A guest journal, maintenance or shutdown inhibits the checker's heal too.
        case $node in
        fw1|fw2) if heal_allowed; then echo "$node's QEMU no longer answers Incus; the checker kills a frozen firewall, then rerun"; return; fi ;;
        esac
        echo "$node's QEMU no longer answers Incus; kill the pid in /run/incus/$node/qemu.pid, then rerun"
        return
    done
    echo 'if a guest QEMU is frozen, kill the pid in /run/incus/<name>/qemu.pid (the checker does this for a firewall), then rerun'
}
# A wedged svc must not hang a mutator under the locks: a timeout counts as failed.
svc_exec() {
    timeout -k 5 120 incus --force-local --project default exec svc -- "$@" 9>&- 8>&- 7>&- 6>&- ||
        { code=$?; fail "incus exec svc -- $* failed (status $code)" || return "$code"; }
}
svc_storage_check() (
    for path in "$pool/containers/svc" "$pool/custom/default_svc-metrics" "$pool/custom/default_svc-logs" "$pool/custom/default_svc-grafana"; do
        nested=$(timeout -k 1 30 btrfs subvolume list -o "$path") || { fail "cannot check subvolumes in $path"; return 1; }
        [ -z "$nested" ] || { fail "nested subvolumes in $path; remove them before starting svc"; return 1; }
    done
)
# Fresh connections only: a shared one could still reach a guest this tool replaced. ConnectTimeout
# also bounds the SSH banner, which a loaded, relinking firewall missed: wait half the probe's bound,
# and let its stalls run into a 120 s keepalive rather than the config's 30 s.
rsh() {
    guest_stderr probe ssh -F "$conf" -o ControlMaster=no -o ControlPath=none -o ConnectTimeout="$((${probe_limit:-30} / 2))" -o ServerAliveCountMax=12 "$@" ||
        { code=$?; fail "ssh $* failed (status $code)" || return "$code"; }
}
# Only read-only probes use the retry budget; mutators must finish under their locks.
probe() (
    limit=${probe_limit:-30}
    if [ -n "$polling" ]; then
        now=$(cut -d. -f1 /proc/uptime) || exit 1
        remaining=$((deadline - now))
        [ "$remaining" -gt 0 ] || exit 124
        if [ "$remaining" -eq 1 ]; then
            timeout -s KILL 1 "$@" 9>&- 8>&- 7>&- 6>&-
            exit $?
        fi
        [ "$remaining" -gt "$((limit + 1))" ] || limit=$((remaining - 1))
    fi
    timeout -k 1 "$limit" "$@" 9>&- 8>&- 7>&- 6>&-
)
# Keep the locks until mutators finish, even if the updater is killed.
locked() (
    trap '' HUP INT TERM
    set +e
    ( "$@" 9>&- 8>&- 7>&- 6>&- )
    code=$?
    exit "$code"
)
# A relinking firewall (nested tests: minutes at full CPU) can take longer than 30 s to answer a write.
fw_mutate() {
    locked guest_stderr timeout -k 5 120 ssh -F "$conf" -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=60 -o ServerAliveCountMax=12 "$@" >/dev/null ||
        { code=$?; fail "ssh $* failed (status $code)" || return "$code"; }
}
retry() {
    # VMs boot slowly; the svc container is up in seconds; a halted VM stops within minutes.
    case "$*" in
    stopped\ *) wait=$((boot_timeout < 300 ? boot_timeout : 300)) ;;
    *' svc'*) wait=${GUEST_SVC_TIMEOUT:-300} ;;
    *) wait=$boot_timeout ;;
    esac
    now=$(cut -d. -f1 /proc/uptime) || return
    deadline=$((now + wait))
    polling=1
    waiting=
    until "$@" 2>"$work/retry.err"; do
        if [ -z "$waiting" ]; then
            case "$*" in seed_applied\ svc) echo 'guests: waiting for svc seed' >&2 ;;
            *) echo "guests: waiting for $*" >&2 ;; esac
            waiting=1
        fi
        now=$(cut -d. -f1 /proc/uptime) || return
        if [ "$now" -ge "$deadline" ]; then
            polling=
            # Guest text: bounded and without terminal controls.
            head -c 65536 "$work/retry.err" | guest_text >&2
            [ ! -s "$work/retry.err" ] || logger -p user.err -t guests "$(head -c 65536 "$work/retry.err")" 2>/dev/null || :
            fail "$* timed out after ${wait}s" || :
            case $1:${2:-} in pin:fw1|pin:fw2|pin:wan|seed_applied:fw1|seed_applied:fw2|seed_applied:wan|healthy:fw1|healthy:fw2|healthy:wan)
                now=$(cut -d. -f1 /proc/uptime) || return
                deadline=$((now + 15))
                polling=1
                ic console "$2" --show-log | tail -n 20 | head -c 65536 | guest_text >&2
                polling=
                case $2 in fw1|fw2) echo "guests: next: sys firewall rebuild $2" >&2 ;;
                wan) echo 'guests: next: guests update wan /var/lib/convergent/release-guests/guests/wan --trusted-local' >&2 ;; esac
                ;;
            healthy:svc) echo 'guests: next: guests update svc /var/lib/convergent/release-guests/guests/svc --trusted-local' >&2 ;;
            esac
            return 1
        fi
        remaining=$((deadline - now))
        sleep "$((remaining < 2 ? remaining : 2))" || return
    done
    polling=
}
running() {
    guest_state=$(probe incus --force-local query "/1.0/instances/$1/state?project=default") || return 1
    [ "$(printf '%s\n' "$guest_state" | jq -r .status)" = Running ]
}
stopped() {
    guest_state=$(probe incus --force-local query "/1.0/instances/$1/state?project=default") || return 1
    [ "$(printf '%s\n' "$guest_state" | jq -r .status)" = Stopped ]
}
# ENOSPC leaves QEMU in io-error, which Incus reports as Error; a pause is Frozen.
paused() {
    guest_state=$(probe incus --force-local query "/1.0/instances/$1/state?project=default") || return 1
    case $(printf '%s\n' "$guest_state" | jq -r .status) in Error|Frozen) ;; *) return 1 ;; esac
}
autorestart_hold() {
    # Mark in the same update; imports and renames keep ownership of the override.
    hold_set "$1" boot.autorestart=false user.convergent.autorestart=true
}
# Incus answers no read or change of a frozen monitor: an unbounded hold hung under the guests lock, with
# the checker's heal inhibited. End that QEMU first, verified as this instance's right before the signal
# as the healer does, then hold the instance that outlives it and continue the stop.
hold_set() {
    hold_mark "$@" && return
    case $1 in fw1|fw2|wan) ;; *) return 1 ;; esac
    if heal_state "$1" >/dev/null; then return 1; fi
    # A firewall that still answers is healthy: Incus is the one stuck, never kill it then (as the healer).
    case $1 in fw1|fw2) if heal_probe "$1" >/dev/null; then return 1; fi ;; esac
    pid=$(heal_qemu "$1") || return 1
    kill -KILL "$pid" || return 1
    echo "guests: $1 QEMU $pid no longer answers Incus; killed before the hold" >&2
    logger -p user.err -t guests "$step: $1 QEMU $pid no longer answers Incus; killed before the hold" 2>/dev/null || :
    hold_mark "$@"
}
hold_mark() {
    timeout -k 1 120 incus --force-local --project default config set "$@" 9>&- 8>&- 7>&- 6>&- ||
        { code=$?; fail "incus config set $* failed (status $code)" || return "$code"; }
}
autorestart_clear() (
    [ ! -d "$state/fw.topology" ] || return 0
    # Once a read timed out on a frozen monitor, the listing would too (cleanup ignores INT); the next run clears.
    [ -z "$frozen" ] || return 1
    ic query '/1.0/instances?recursion=1&project=default' >"$work/autorestart-instances" || return
    jq -r '.[] | select(.config["user.convergent.autorestart"] == "true") | .name' \
        "$work/autorestart-instances" >"$work/autorestart" || return
    while read -r node; do
        ic config unset "$node" boot.autorestart user.convergent.autorestart || return
    done <"$work/autorestart"
)
volumes() {
    case $1 in
    svc) echo 'svc-metrics svc-logs svc-grafana' ;;
    remmina) echo remmina-state ;;
    def|int|web|admin) echo "browser-$1-state" ;; # old pending journals
    esac
}
unmount_root() {
    if [ -n "$mounted" ]; then umount "$work/root" 9>&- 8>&- 7>&- 6>&- || return; mounted=; fi
    if [ -n "$loop" ]; then losetup -d "$loop" || return; loop=; fi
}
clear_probes() {
    for address in $probes; do ip route del "$address/32" via 100.80.1.3 dev host || return; done
    probes=
}
rollback() {
    step=rollback
    while read -r guest snap image <"$state/pending"; do
        echo "guests: restoring $guest/$snap" >&2
        if [ -z "$image" ]; then
            # A journal from before 0.1.3: the old guest was exported, the candidate rebuilt in place.
            backup=$state/backups/$guest-$snap.tar.gz
            gzip -t "$backup" 2>/dev/null || { fail "missing or damaged backup $backup"; return 1; }
            ic query '/1.0/instances?recursion=1&project=default' >"$work/instances" || return
            if jq -e --arg n "$guest" '.[] | select(.name == $n)' "$work/instances" >/dev/null; then
                autorestart_hold "$guest" || return
                if running "$guest"; then ic stop "$guest" --force || return; fi
                seed_remove "$guest" || return
                ic config set "$guest" security.protection.delete=false || return
                ic delete "$guest" || return
            fi
            locked ic import "$backup" "$guest" || return
            autorestart_hold "$guest" || return
        else
            # Back to the image the guest ran on; a second pass redoes the same rebuild.
            # A peer Incus restarted (autorestart) answers no SSH while it boots: wait read-only, then mutate once.
            case $guest in fw1) peer=fw2 ;; fw2) peer=fw1 ;; *) peer= ;; esac
            if [ -n "$peer" ] && running "$peer"; then retry reachable "$peer" || :; fi
            case $guest:$snap in
            fw1:*-rebuild|fw2:*-rebuild)
                # A healthy BACKUP peer takes over when the target stops.
                running "$peer" && leases_resume "$peer" &&
                    (image_dir=/var/lib/convergent/release-guests/guests/fw; fw_check "$peer") &&
                    { carp "$peer" MASTER || carp "$peer" BACKUP; } ||
                    { fail "$peer must be healthy on all registered segments; run sys firewall rebuild $guest"; return 1; }
                ;;
            esac
            # The target is replaced next: a silent one must not hold the rollback forever.
            case $guest in fw1|fw2) (rebuilding=$guest; leases_hold) || return ;; esac
            autorestart_hold "$guest" || return
            stopped "$guest" || force_stop "$guest" || return
            seed_remove "$guest" || return
            rebuild_root "$guest" "$image" || return
            image_alias "$guest" "$image" || return
        fi
        for volume in $(volumes "$guest"); do
            ic storage volume snapshot list default "$volume" --format csv -c n >"$work/volume-snapshots" || return
            grep -Fxq "$snap" "$work/volume-snapshots" || continue
            if [ "$volume" = svc-logs ]; then
                warning="rollback svc/$snap: logs accepted by the candidate after the snapshot may be lost"
                printf '%s WARNING %s\n' "$(date -u +%FT%TZ)" "$warning" >>"$state/updates" && sync || return
                echo "guests: WARNING: $warning" >&2
                logger -p user.err -t guests "$warning" 2>/dev/null || :
            fi
            locked ic storage volume snapshot restore default "$volume" "$snap" || return
            locked ic storage volume snapshot delete default "$volume" "$snap" || return
        done
        cp "$state/known_hosts.before" "$keys/known_hosts" || return
        case $guest in
        def|int|web|admin|remmina) ;;
        *)
            if [ -n "$image" ]; then
                seed_start "$guest" || return
            else
                start_guest "$guest" || return
                retry healthy "$guest" || return
            fi ;;
        esac
        [ "$guest" != fw1 ] || { touch "$state/fw.handoff" && sync && fw_release || return; }
        tail -n +2 "$state/pending" >"$work/pending" && sync && mv "$work/pending" "$state/pending" && sync || return
        rm -rf "$state/iwd.$guest" "$state/backups/$guest-$snap.tar.gz" || return
    done
    rm "$state/pending" || return
    pending=
}
cleanup() {
    result=$1
    polling=
    failed_status=$result failed_step=$step
    trap - 0
    trap '' HUP INT TERM
    set +e
    [ "$result" = 0 ] || printf 'guests: %s: operation failed (status %s); cleaning up\n' "$failed_step" "$failed_status" >&2
    step=cleanup
    [ -z "$manual_stage" ] || rm -rf "$manual_stage" || { fail "cannot remove $manual_stage"; result=1; }
    if [ -n "$work" ] && [ -d "$state/fw.topology" ]; then
        topology_recover || {
            # A committed migration goes forward on running firewalls.
            if [ -f "$state/fw.topology/committed" ]; then fail 'pair commit pending; rerun sys guests update'
            else fail 'pair rollback pending; both firewalls held; rerun sys guests update'; fi
            [ -z "$applying" ] || update_status failed; exit 1; }
    fi
    unmount_root || { fail "cannot detach root mount or loop device"; [ -z "$applying" ] || update_status failed; exit 1; }
    clear_probes || { fail 'cannot remove probe routes'; result=1; }
    if [ -n "${recovering:-}" ]; then
        if [ -f "$state/committed" ]; then commit_update || { fail 'cannot finish committed update'; result=1; }; fi
        # Profiles first: the restored instance starts with what it ran with.
        if [ ! -f "$state/browser.ready" ] && [ ! -f "$state/committed" ]; then
            if [ "$result" != 0 ] && [ -d "$state/profiles.before" ]; then
                profiles_restore || { fail 'cannot restore the previous Incus profiles'; result=1; recovering=; }
            fi
            if [ -n "$recovering" ]; then
                prepare_cleanup || { fail 'cannot clean up backup preparation'; result=1; }
                if [ -f "$state/pending" ]; then rollback || { fail "cannot restore $guest/$snap; pending journal retained"; result=1; }; fi
                if [ ! -f "$state/pending" ]; then fw_release || { fail 'cannot release firewall handoff'; result=1; }; fi
            fi
        fi
    fi
    if [ -n "$starting" ] && ! running "$starting"; then start_guest "$starting" || { fail "cannot restart $starting"; result=1; }; fi
    if [ -n "$work" ] && [ -f "$state/leases/held" ]; then
        for peer in fw1 fw2; do if running "$peer"; then retry reachable "$peer" || :; fi; done
    fi
    [ -z "$work" ] || leases_resume || result=1
    [ -z "$work" ] || dns_restore || result=1
    [ -z "$work" ] || autorestart_clear || { fail 'cannot clear autorestart overrides; rerun sys guests update'; result=1; }
    [ -z "$work" ] || rm -rf "$work" || { fail "cannot remove $work"; result=1; }
    [ "$result" = 0 ] || printf 'guests: %s: exiting with status %s (original status %s)\n' "$failed_step" "$result" "$failed_status" >&2
    [ "$result" = 0 ] || logger -p user.err -t guests "$failed_step: failed (status $result, original $failed_status); cleanup finished" 2>/dev/null || :
    if [ -n "$applying" ]; then
        if [ "$result" = 0 ]; then
            echo "${browser_pending:-}" >/run/convergent/status/guests-pending
            chmod 0644 /run/convergent/status/guests-pending
        fi
        if [ "$result" = 0 ]; then update_status 'done'; else update_status failed; fi
    fi
    exit "$result"
}
dns_restore() {
    [ -f "$state/dns.stale" ] && [ -f /var/lib/convergent/dns/list.rpz ] || return 0
    exec 8>&-
    dns-push local 9>&- 7>&- 6>&- || { code=$?; fail "the DNS push failed (status $code); run sudo dns-push local"; return 1; }
    exec 8>/run/convergent/dns-push.lock
    flock -w 120 8 || { fail 'a DNS push is still running'; return 1; }
}
update_status() {
    mkdir -p /run/convergent/status
    chmod 0755 /run/convergent/status
    echo "$1" >/run/convergent/status/guests-update
    chmod 0644 /run/convergent/status/guests-update
    echo "guests: update $1"
    logger -t guests "apply $1 (browser pending=${browser_pending:-0})" 2>/dev/null || :
}

# Secrets are generated once on this laptop, never on the build host.
secret_valid() {
    [ "$(wc -c <"$1")" -eq $(($2 * 2 + 1)) ] &&
        LC_ALL=C grep -qxE "[0-9a-f]{$(($2 * 2))}" "$1"
}
secret_create() {
    if [ -e "$1" ]; then
        secret_valid "$1" "$2" || die "invalid secret: $1; remove it before retrying setup"
        return
    fi
    openssl rand -hex "$2" >"$1.new" && secret_valid "$1.new" "$2" &&
        sync && mv "$1.new" "$1" && sync || { rm -f "$1.new"; die "cannot generate $1"; }
}
certificate_pair() {
    openssl pkey -in "$1" -check -noout >/dev/null 2>&1 &&
        openssl pkey -in "$1" -pubout -out "$work/key.pub" &&
        openssl x509 -in "$2" -pubkey -noout >"$work/cert.pub" &&
        cmp -s "$work/key.pub" "$work/cert.pub"
}
certificate_current() (
    openssl x509 -in "$1" -checkend 2592000 -noout >/dev/null 2>&1 || exit 1
    start=$(openssl x509 -in "$1" -startdate -noout) || exit 1
    start=$(date -d "${start#notBefore=}" +%s) || exit 1
    now=$(date +%s) || exit 1
    [ "$start" -le "$now" ]
)
# Certificates issued under a clock behind the booted build expire once it is corrected: no maintenance then.
certificates_clock() {
    built=$(cat /usr/lib/convergent/release 2>/dev/null) || built=
    case $built in
    ''|*[!0-9]*) reason='release build stamp unreadable' ;;
    *) clock=$(date -u +%Y%m%d%H%M) && [ "$clock" -ge "$built" ] && return 0
       reason='clock behind the release build' ;;
    esac
    if [ -z "${clock_noted:-}" ]; then
        echo "guests: certificates: $reason; skipping (fix the clock, then sys guests update)"
        logger -t guests "certificates skipped: $reason" 2>/dev/null || :
        clock_noted=1
    fi
    return 1
}
credentials() {
    step=credentials
    mkdir -p "$tls" "$keys"
    secret_create "$state/carp-pass" 16
    if [ ! -f "$keys/id_ed25519" ]; then
        [ ! -e "$keys/id_ed25519.pub" ] || die 'missing management private key'
        rm -f "$keys/id_ed25519.new" "$keys/id_ed25519.new.pub"
        ssh-keygen -q -t ed25519 -N '' -C convergent -f "$keys/id_ed25519.new"
        ssh-keygen -y -P '' -f "$keys/id_ed25519.new" >"$keys/id_ed25519.new.pub"
        sync
        mv "$keys/id_ed25519.new" "$keys/id_ed25519"
        sync
    fi
    # Recover the public half without changing the laptop's identity.
    ssh-keygen -y -P '' -f "$keys/id_ed25519" >"$keys/id_ed25519.pub.new" || die 'invalid management private key'
    sync
    mv "$keys/id_ed25519.pub.new" "$keys/id_ed25519.pub"
    sync
    for secret in admin-password secret-key; do
        secret_create "$tls/$secret" 32
    done
    if ! certificates_clock; then
        # Only a whole set with a valid CA pair is kept; a half-issued one failed later with a raw error.
        [ -f "$tls/ca.crt" ] && [ -f "$tls/server.crt" ] && [ -f "$tls/incus-server.crt" ] && [ -f "$tls/incus-client.crt" ] &&
            certificate_pair "$tls/ca.key" "$tls/ca.crt" ||
            die "certificates: cannot issue under this clock; set the host clock (date -u -s 'YYYY-MM-DD HH:MM:SS'), then reboot"
        return 0
    fi
    if openssl x509 -in "$tls/ca.crt" -noout >/dev/null 2>&1; then
        certificate_pair "$tls/ca.key" "$tls/ca.crt" || die 'invalid CA pair'
        openssl verify -no_check_time -CAfile "$tls/ca.crt" "$tls/ca.crt" >/dev/null || die 'invalid CA certificate'
    fi
    if ! certificate_current "$tls/ca.crt"; then
        if [ ! -f "$tls/ca.key" ]; then
            openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$tls/ca.key.new"
            openssl pkey -in "$tls/ca.key.new" -check -noout >/dev/null
            sync
            mv "$tls/ca.key.new" "$tls/ca.key"
            sync
        fi
        openssl pkey -in "$tls/ca.key" -check -noout >/dev/null || die 'invalid CA key'
        openssl req -x509 -key "$tls/ca.key" -out "$tls/ca.crt.new" -days 3650 -subj '/CN=Local CA' \
            -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign
        certificate_pair "$tls/ca.key" "$tls/ca.crt.new" || die 'invalid CA pair'
        openssl verify -CAfile "$tls/ca.crt.new" "$tls/ca.crt.new" >/dev/null || die 'invalid CA certificate'
        touch "$tls/ca.pending"
        sync
        mv "$tls/ca.crt.new" "$tls/ca.crt"
        sync
    fi
    certificate_pair "$tls/ca.key" "$tls/ca.crt" || die 'invalid CA pair'
    openssl verify -CAfile "$tls/ca.crt" "$tls/ca.crt" >/dev/null || die 'invalid CA certificate'
    for cert in server incus-server incus-client; do
        if [ -f "$tls/$cert.crt" ]; then
            if certificate_current "$tls/$cert.crt"; then
                certificate_pair "$tls/$cert.key" "$tls/$cert.crt" || die "invalid pair for $cert"
                openssl verify -CAfile "$tls/ca.crt" "$tls/$cert.crt" >/dev/null || die "invalid certificate for $cert"
                continue
            fi
            [ -s "$tls/$cert.key" ] || die "missing key for $cert"
        fi
        case $cert in
        server) san='IP:100.80.2.10,DNS:svc'; purpose=serverAuth ;;
        incus-server) san='DNS:host,IP:100.80.1.10'; purpose=serverAuth ;;
        incus-client) san='DNS:svc'; purpose=clientAuth ;;
        esac
        if [ ! -f "$tls/$cert.key" ]; then
            openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$tls/$cert.key.new"
            openssl pkey -in "$tls/$cert.key.new" -check -noout >/dev/null
            sync
            mv "$tls/$cert.key.new" "$tls/$cert.key"
            sync
        fi
        openssl req -new -key "$tls/$cert.key" -out "$work/request" -subj "/CN=$cert"
