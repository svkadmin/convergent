# The persistent seed survives errors until verified or the replacement is rolled back.
seed_create() {
    step="seed_create $1"
    mkdir -p "$state/seeds" "$work/root" || return
    if [ -e "$state/seeds/$1.img" ]; then
        sha256sum "$state/seeds/$1.img" >"$work/seed.sha256" || return
        seed_hash=$(awk '{print $1}' "$work/seed.sha256") || return
        seed_expected=$(cat "$state/seeds/$1.sha256") || return
        [ "$seed_hash" = "$seed_expected" ] || { fail "seed for $1 differs"; return 1; }
        return
    fi
    truncate -s 16M "$work/seed.img" || return
    mkfs.vfat -F 16 -n CVSEED "$work/seed.img" >/dev/null || return
    loop=$(losetup --find --show "$work/seed.img") || return
    mount -t vfat -o nodev,nosuid,noexec,umask=077 "$loop" "$work/root" 9>&- 8>&- 7>&- 6>&- || return
    mounted=1
    openssl rand -hex 16 >"$state/seeds/$1.id" || return
    cp "$state/seeds/$1.id" "$work/root/seed-id" || return
    case $1 in
    fw1|fw2|wan)
        cp "$keys/id_ed25519.pub" "$work/root/management.pub" || return
        cp "$tls/ca.crt" "$work/root/syslog-ca.crt" || return
        case $1 in fw1|fw2)
            cp "$state/carp-pass" "$work/root/carp-pass" || return
            if [ -f "$state/leases/saved" ]; then
                cp "$state/leases/saved" "$work/root/dhcpd.leases" || return
            fi
            [ ! -f "$state/leases/held" ] || touch "$work/root/dhcpd.hold" || return
            ;; esac
        if [ "$1" = fw1 ] && [ -n "$pending" ]; then touch "$work/root/demote" || return; fi
        ;;
    svc)
        for file in server.crt server.key ca.crt incus-client.crt incus-client.key admin-password secret-key; do
            cp "$tls/$file" "$work/root/$file" || return
        done
        ;;
    esac
    unmount_root || return
    sha256sum "$work/seed.img" >"$work/seed.sha256" || return
    awk '{print $1}' "$work/seed.sha256" >"$state/seeds/$1.sha256" || return
    sync || return
    mv "$work/seed.img" "$state/seeds/$1.img" || return
