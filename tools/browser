#!/bin/sh
# ARCHITECTURE 3.5, 4.1, 4.2, 9, 10, 12; install root:root 0755 as /usr/local/sbin/browser.
# Narrow sudo validates fixed browser sessions; Incus administration also requires a passphrase.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C
umask 077
die() { echo "browser: $*" >&2; exit 1; }
send_url() {
    printf '%s\n' "$#"
    if [ "$#" = 1 ]; then printf '%s' "$1"; fi
}

ic() { incus --force-local --project default "$@" 9>&- 8>&- 7>&- 6>&-; }
# Name, status and type only: a full list waits on each VM for state agentless guests lack.
instances_json() { incus --force-local query '/1.0/instances?recursion=1&project=default' 9>&- 8>&- 7>&- 6>&-; }
owner() {
    set -- setpriv --reuid "$uid" --regid "$gid" --init-groups --pdeathsig TERM --no-new-privs env -i \
        PATH="$PATH" HOME=/nonexistent LANG=C.UTF-8 XDG_RUNTIME_DIR="$runtime" \
        XDG_CONFIG_HOME=/nonexistent XDG_STATE_HOME="$run/state" \
        WAYLAND_DISPLAY="$display" SWAYSOCK="$ipc" "$@"
    if [ "${background:-}" = yes ]; then exec "$@" 9>&- 8>&- 7>&- 6>&-; fi
    "$@" 9>&- 8>&- 7>&- 6>&-
}
device() {
    dev=$1; shift
    settings=$(incus --force-local query "/1.0/instances/$name?project=default")
    if printf '%s\n' "$settings" | jq -e --arg d "$dev" '.devices[$d]' >/dev/null; then
        ic config device set "$name" "$dev" "$@"
    else
        ic config device override "$name" "$dev" "$@"
    fi
}
stop_container() {
    snapshot=$(instances_json) || return
    state=$(printf '%s\n' "$snapshot" | jq -r --arg n "$name" '.[] | select(.name == $n) | .status') || return
    case $state in '') return ;; Stopped) ;; *) ic stop "$name" --force || return ;; esac
    case $role in
        tmp)
            snapshot=$(instances_json) || return
            if printf '%s\n' "$snapshot" | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null; then
                ic delete "$name" || return
            fi ;;
    esac
}
reap_tmp() (
    snapshot=$(instances_json) || exit 1
    abandoned=$(printf '%s\n' "$snapshot" | jq -r '.[] | select(.type == "container" and
        .profiles == ["browser-base", "browser-tmp"] and
        (.name | test("^tmp-([2-9][0-9]|portal)$"))) | .name') || exit 1
    for stale in $abandoned; do
        exec 7>"/run/convergent/browser/$stale.lock"
        flock -n 7 || continue
        # A launcher may have acquired this slot since the first snapshot.
        snapshot=$(instances_json) || exit 1
        state=$(printf '%s\n' "$snapshot" | jq -r --arg n "$stale" '.[] | select(.name == $n and
            .type == "container" and .profiles == ["browser-base", "browser-tmp"]) | .status') || exit 1
        case $state in '') continue ;; Stopped) ;; *) ic stop "$stale" --force || exit 1 ;; esac
        # Ephemeral instances disappear on stop; recheck before deleting survivors.
        snapshot=$(instances_json) || exit 1
        state=$(printf '%s\n' "$snapshot" | jq -r --arg n "$stale" '.[] | select(.name == $n and
            .type == "container" and .profiles == ["browser-base", "browser-tmp"]) | .status') || exit 1
        case $state in '') ;; Stopped) ic delete "$stale" || exit 1 ;; *) exit 1 ;; esac
    done
)
portal_on() { /usr/local/sbin/portal status | grep -qx 'portal: on'; }
wait_socket() {
    attempts=0
    until [ -S "$1" ] && [ ! -L "$1" ]; do
        # The log goes with $run on exit; its last lines go in the message.
        kill -0 "$2" 2>/dev/null || die "socket provider exited: $1: $(tail -n 2 "$3" 2>/dev/null | tr '\n' ' ')"
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ] || die "socket timed out: $1"
        sleep .1
    done
}

browser_locks() {
    install -d -m 0755 /run/convergent
    mkdir -p /run/convergent/browser
    chmod 711 /run/convergent/browser
    # The guests lock covers launch; the browser lock covers the whole session.
    exec 9>/run/convergent/guests.lock
    flock -s -n 9 || die 'guest update in progress'
    [ ! -e /run/convergent/guests-stopping ] || die 'host is stopping guests'
    exec 6>/run/convergent/browser-update.lock
    flock -s -n 6 || die 'browser update in progress'
}

# Periodic cleanup has no owner session and keeps both shared locks until done.
if [ "${1:-}" = --reap-tmp ] && [ "$(id -u)" = 0 ]; then
    [ $# = 1 ] || die 'usage: browser --reap-tmp'
    browser_locks
    reap_tmp
    exit
fi
if [ "$(id -u)" != 0 ]; then
    case $# in 1|2|3) ;; *) die 'usage: browser def|tmp|int [url] | tmp --portal [url]' ;; esac
    [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${SWAYSOCK:-}" ] || die 'run in the owner Sway session'
    # Pressed again: focus the open window instead of refusing.
    if [ $# = 1 ] && { [ "$1" = def ] || [ "$1" = int ]; } &&
        swaymsg -q "[sandbox_engine=\"^convergent\$\" sandbox_app_id=\"^$1\$\" sandbox_instance_id=\"^$1\$\"] focus" 2>/dev/null; then exit 0; fi
    role=$1; shift
    portal_mode=
    if [ "$role" = tmp ] && [ "${1:-}" = --portal ]; then portal_mode=--portal; shift; fi
    [ $# -le 1 ] || die 'expected at most one URL'
    # Keep URLs out of sudo and root exec audit arguments.
    send_url "$@" | sudo -- /usr/local/sbin/browser --session "$WAYLAND_DISPLAY" "$SWAYSOCK" "$role" ${portal_mode:+"$portal_mode"}
    exit
fi
case ${SUDO_UID:-} in ''|0|*[!0-9]*) die 'run as the owner, not root' ;; esac
if [ "${1:-}" = --session ]; then
    shift
    exec env -i PATH="$PATH" LC_ALL=C SUDO_UID="$SUDO_UID" /usr/local/sbin/browser --privileged "$@"
fi
[ "${1:-}" = --privileged ] || die 'run as the owner in Sway'
shift
case $# in 3|4) ;; *) die 'invalid session arguments' ;; esac
display=$1 ipc=$2 role=$3
shift 3
case $role in def|tmp|int|remmina) ;; *) die 'role must be def, tmp, int or remmina' ;; esac
portal_mode=
if [ "$role" = tmp ] && [ "${1:-}" = --portal ]; then portal_mode=1; shift; fi
[ $# = 0 ] || die 'unexpected session argument'
# Bound direct sudo input too; preserve trailing newlines with a sentinel.
url=$(head -c 131075 && printf '.') || die 'cannot read URL input'
url=${url%.}
[ "${#url}" -le 131074 ] || die 'URL input too long'
case $url in
    '0
') ;;
    '1
'*) set -- "${url#??}" ;;
    *) die 'invalid URL input' ;;
esac
if [ -n "$portal_mode" ] && [ $# = 0 ]; then
    gateway=$(/usr/local/sbin/portal gateway) || die 'cannot find the uplink gateway; give a portal URL'
    set -- "http://$gateway/"
fi
for url do case $url in http://?*|https://?*) ;; *) die 'URL must be HTTP(S)' ;; esac; done
case $role in
    remmina) [ $# = 0 ] || die 'remmina accepts no arguments' ;;
    int)
        case ${1:-http://100.80.2.10:3000/} in
            http://100.80.2.10:3000/|https://100.80.1.10:8443/ui/) ;;
            *) die 'int only opens Grafana or Incus' ;;
        esac ;;
esac
incus_ui=
[ "$role:${1:-}" != int:https://100.80.1.10:8443/ui/ ] || incus_ui=1
uid=$SUDO_UID
gid=$(id -g "$uid")
runtime=/run/user/$uid
case $display in /*) ;; *) display=$runtime/$display ;; esac
[ -S "$display" ] && [ -S "$ipc" ] && [ -S "$runtime/pipewire-0" ] || die 'missing session sockets'
cd /
browser_locks
if [ "$role" != remmina ] && { [ "$role" != tmp ] || [ -n "$portal_mode" ]; } &&
    [ ! -f /var/lib/convergent/release-guests/guests/browser/incus/def.yaml ]; then
    die 'the browser image predates this release: run sys update install, or sys update usb with a stick that carries the guests'
fi
if [ "$role" = remmina ] && [ ! -f /var/lib/convergent/release-guests/guests/remmina/incus.yaml ]; then
    die 'Remmina image is not installed; run sys update install'
fi
journal=/var/lib/convergent/guests
if [ -f "$journal/browser.ready" ] || [ -d "$journal/browser.rename" ] ||
    [ -f "$journal/profiles.before/browser-base.yaml" ] || [ -f "$journal/profiles.before/remmina.yaml" ] ||
    grep -qE '^(def|int|web|admin|remmina) ' "$journal/pending" 2>/dev/null; then
    die 'interrupted browser update; rerun the guests update first'
fi
reap_tmp || echo "browser: stale temporary browser cleanup failed" >&2
name=$role
profile_base='browser-base'
profile_role=browser-$role
image=candidate-browser
launcher=/usr/local/bin/browser-launch
ready=/run/browser-ready
state_volume=browser-$role-state
if [ "$role" = remmina ]; then
    profile_base=remmina
    profile_role=
    image=candidate-remmina
    launcher=/usr/local/bin/remmina-launch
    ready=/run/remmina-ready
    state_volume=remmina-state
fi
if [ -n "$portal_mode" ]; then
    name=tmp-portal
    exec 8>"/run/convergent/browser/$name.lock"
    flock -n 8 || die 'portal is already open'
elif [ "$role" = tmp ]; then
    octet=20
    while :; do
        [ "$octet" -le 99 ] || die 'all temporary browser slots are busy'
        name=tmp-$octet
        exec 8>"/run/convergent/browser/$name.lock"
        flock -n 8 && break
        octet=$((octet + 1))
    done
else
    exec 8>"/run/convergent/browser/$name.lock"
    flock -n 8 || die "$role is already open; close it before reopening"
fi
run=/run/convergent/browser/$name
children= active= grafana= portal= browser= capture= cage= cage_capture=
cleanup() {
    result=$?
    trap - 0
    trap '' HUP INT TERM
    set +e
    if [ -n "$active" ]; then
        stop_container || result=1
    fi
    if [ "$role" = int ]; then
        /usr/local/sbin/incus-ui --close 9>&- 8>&- 7>&- 6>&- || result=1
    fi
    if [ -n "$grafana" ]; then
        if ic exec svc -- rc-service grafana stop; then ic config set svc limits.memory=350MiB || result=1; else result=1; fi
    fi
    if [ -n "$portal" ]; then
        if [ "$result" = 0 ]; then why=closed; else why=interrupted; fi
        /usr/local/sbin/portal off "$why" || result=1
    fi
    if [ -n "$browser" ]; then kill "$browser" 2>/dev/null; wait "$browser" 2>/dev/null; fi
    if [ -n "$capture" ]; then
        [ -n "$browser" ] || kill "$capture" 2>/dev/null
        wait "$capture" 2>/dev/null
    fi
    for child in $children; do
        # Cage precedes its collector; let EOF flush the retained diagnostics.
        [ "$child" = "$cage_capture" ] || kill "$child" 2>/dev/null
        case $child in "$cage"|"$cage_capture")
            attempts=0
            while kill -0 "$child" 2>/dev/null && [ "$attempts" -lt 50 ]; do
                sleep .1
                attempts=$((attempts + 1))
            done
            kill -KILL "$child" 2>/dev/null
            wait "$child" 2>/dev/null ;;
        esac
    done
    for child in $children; do wait "$child" 2>/dev/null; done
    if [ "$result" != 0 ]; then
        for log in "$run"/*.log; do [ ! -f "$log" ] || tail -n 8 "$log" >&2; done
    fi
    rm -rf -- "$run" || result=1
    exit "$result"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

if [ "$role" = int ]; then
    /usr/local/sbin/incus-ui --close 9>&- 8>&- 7>&- 6>&-
    if [ -n "$incus_ui" ]; then
        instances=$(instances_json)
        if printf '%s\n' "$instances" | jq -e 'any(.[]; .name == "int" and .status != "Stopped")' >/dev/null; then
            die 'stop int before unlocking an Incus session'
        fi
    fi
fi

# The privileged half touches only fixed, root-owned paths.
rm -rf -- "$run"
install -d -o root -g "$gid" -m 0750 "$run"
install -d -o root -g "$gid" -m 0730 "$run/sockets"
install -d -o "$uid" -g "$gid" -m 0700 "$run/state"
wayland_socket=$run/sockets/wayland-0
outer_socket=$wayland_socket
if [ "$role" = remmina ]; then
    install -d -o "$uid" -g "$gid" -m 0700 "$run/cage"
    outer_socket=$run/state/wayland-host
    wayland_socket=$run/cage/wayland-0
fi
# The container first: a first start creates it slowly, and the sockets below should not
# wait through that unused (a first browser once found its Wayland listener gone).
instances=$(instances_json)
if printf '%s\n' "$instances" | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null; then
    printf '%s\n' "$instances" | jq -e --arg n "$name" --arg b "$profile_base" --arg r "$profile_role" \
        '.[] | select(.name == $n) | .type == "container" and .profiles == ([$b, $r] | map(select(. != "")))' \
        >/dev/null || die 'existing instance is not this browser role'
    stop_container
fi
active=1
if ! instances_json | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null; then
    # Socket paths are this launcher's, not the profile's: profiles stay as installed until
    # a browser image update, and older ones name other paths.
    # Fixed words ($name is def, int, tmp-portal or tmp-NN), split on purpose; "$@" is the URLs.
    sockets="-d wayland,source=$wayland_socket -d wayland,required=false -d pipewire,source=$run/sockets/pulse-0 -d pipewire,required=false"
    case $role in
        remmina) ic init "$image" "$name" -p remmina $sockets ;;
        tmp) ic init candidate-browser "$name" --ephemeral -p browser-base -p browser-tmp $sockets ;;
        *) ic init candidate-browser "$name" -p browser-base -p "browser-$role" $sockets ;;
    esac
fi
background=yes owner way-secure -e convergent -a "$role" -i "$name" --socket-path "$outer_socket" >"$run/wayland.log" 2>&1 &
wayland=$!; children="$children $wayland"
wait_socket "$outer_socket" "$wayland" "$run/wayland.log"
if [ "$role" = remmina ]; then
    # Only Cage's inner socket crosses the container boundary.
    mkfifo -m 600 "$run/cage-output"
    # Keep a bounded tail, draining even after the retention cap.
    tail -c 1048576 9>&- 8>&- 7>&- 6>&- <"$run/cage-output" >"$run/cage.log" &
    cage_capture=$!
    # 2 GiB conservative address-space ceiling; session peaks have not been measured.
    background=yes owner env XDG_RUNTIME_DIR="$run/cage" WAYLAND_DISPLAY="$outer_socket" \
        WLR_BACKENDS=wayland WLR_RENDERER=pixman \
        prlimit --as=2147483648:2147483648 cage >"$run/cage-output" 2>&1 &
    cage=$!; children="$children $cage $cage_capture"
    wait_socket "$wayland_socket" "$cage" "$run/cage.log"
    chown root "$run/cage"
    chmod 0710 "$run/cage"
fi
# Only the Pulse socket crosses into the guest: no recording, module loading, device or default
# changes. Kill requests on other clients' streams still pass PipeWire's checks (0.1.2).
cat >"$run/pulse.conf" <<EOF
context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }
context.modules = [
  { name = libpipewire-module-protocol-native }
  { name = libpipewire-module-client-node }
  { name = libpipewire-module-adapter }
  { name = libpipewire-module-metadata }
  { name = libpipewire-module-protocol-pulse }
]
pulse.properties = {
  server.address = [ { address = "unix:$run/sockets/pulse-0" client.access = "restricted" } ]
  pulse.allow-module-loading = false
}
# An empty match object never matches in PipeWire; set and unset together match every client.
pulse.rules = [ { matches = [ { application.name = "!null" } { application.name = null } ] actions = {
  # Client properties must not override the socket's access level.
  update-props = { pipewire.client.access = "restricted" }
  quirks = [ block-record-stream block-source-volume block-sink-volume ]
} } ]
EOF
chmod 644 "$run/pulse.conf"
# A hostile client can provoke a log entry for every rejected request.
# 1 GiB conservative address-space ceiling; normal playback has not been measured.
background=yes owner env PIPEWIRE_REMOTE="$runtime/pipewire-0" PIPEWIRE_CONFIG_DIR="$run" \
    prlimit --as=1073741824:1073741824 --fsize=1048576:1048576 /usr/libexec/convergent/pipewire-pulse -c pulse.conf >"$run/pulse.log" 2>&1 &
audio=$!; children="$children $audio"
wait_socket "$run/sockets/pulse-0" "$audio" "$run/pulse.log"
chmod 0710 "$run/sockets"
for socket in "$wayland_socket" "$run/sockets/pulse-0"; do
    [ ! -L "$socket" ] && [ -S "$socket" ] || die 'invalid socket inode'
done
if [ -n "$portal_mode" ]; then
    ic config set "$name" environment.BROWSER_PORTAL=1 environment.BROWSER_IPV4=100.80.3.11 limits.memory=512MiB
    device eth0 ipv4.address=100.80.3.11 hwaddr=00:16:3e:80:03:11
    ic config device add "$name" render none
elif [ "$role" = tmp ]; then
    ic config set "$name" environment.BROWSER_IPV4="100.80.3.$octet"
    device eth0 "ipv4.address=100.80.3.$octet" "hwaddr=00:16:3e:80:03:$octet"
fi
device wayland "source=$wayland_socket" required=true
# Retain the image socket mount path; its wire protocol is now Pulse.
device pipewire "source=$run/sockets/pulse-0" required=true
if [ "$role" != tmp ]; then
    nested=$(timeout -k 1 30 btrfs subvolume list -o "/var/lib/incus/storage-pools/default/custom/default_$state_volume") || die 'cannot check browser state subvolumes'
    [ -z "$nested" ] || die "nested subvolumes in $state_volume; remove them before starting"
fi
if [ "$role" = remmina ]; then
    nested=$(timeout -k 1 30 btrfs subvolume list -o /var/lib/incus/storage-pools/default/custom/default_share) || die 'cannot check share subvolumes'
    [ -z "$nested" ] || die 'nested subvolumes in share; remove them before starting'
fi
ic start "$name"
mapping=$(ic config get "$name" volatile.idmap.current)
guest_uid=$(printf '%s\n' "$mapping" | jq -er '.[] | select(.Isuid and .Nsid <= 1000 and (.Nsid + .Maprange) > 1000) | .Hostid + 1000 - .Nsid')
setfacl -m "u:$guest_uid:rw" "$wayland_socket" "$run/sockets/pulse-0"
attempts=0
until ic exec "$name" -- test -f "$ready"; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 30 ] || die 'browser setup timed out'
    sleep 1
done
# Refuse argv-only guests before opening services.
if [ "$role" != remmina ]; then
    ic exec "$name" -- grep -Fqx '[ "$#" = 0 ] || die "URLs must arrive on stdin"' "$launcher" ||
        die 'browser guest needs updating: run sys update install, or sys update usb with a stick that carries the guests'
fi
if [ -n "$portal_mode" ]; then
    portal=1
    /usr/local/sbin/portal begin || die 'cannot open portal mode'
fi
if [ -n "$incus_ui" ]; then
    /usr/local/sbin/incus-ui --unlock 9>&- 8>&- 7>&- 6>&-
    /usr/local/sbin/incus-ui --import 9>&- 8>&- 7>&- 6>&-
fi
if [ "$role" = int ] && [ -z "$incus_ui" ]; then
    ic config set svc limits.memory=768MiB
    grafana=1; ic exec svc -- rc-service grafana start
fi
[ -z "$portal_mode" ] || portal_on || die 'portal mode ended during startup'
# A dead proxy shows only as a confusing Chromium error ("Connection refused").
for child in $children; do
    kill -0 "$child" 2>/dev/null || die "the Wayland or audio proxy exited before the browser started (logs: $run/*.log)"
done
# Drain guest output, keeping only a bounded tail for failure diagnostics.
mkfifo -m 600 "$run/output"
tail -c 65536 9>&- 8>&- 7>&- 6>&- <"$run/output" >"$run/browser.log" &
capture=$!
send_url "$@" 9>&- 8>&- 7>&- 6>&- | incus --force-local --project default exec "$name" --mode non-interactive \
    --user 1000 --group 1000 -- "$launcher" 9>&- 8>&- 7>&- 6>&- >"$run/output" 2>&1 &
browser=$!
flock -u 9
exec 9>&-
# One unprivileged timer; the root session loop only uses shell builtins.
epoch=$(date +%s)
read -r uptime idle </proc/uptime
epoch=$((epoch - ${uptime%.*}))
checked=${uptime%.*}
: >"$run/portal.checked"
mkfifo -m 600 "$run/tick"
(
    exec 9>&- 8>&- 7>&- 6>&-
    background=yes owner sh -c 'while :; do sleep 2; echo tick; done' >"$run/tick"
) &
children="$children $!"
exec 5<"$run/tick"
rm "$run/tick"
while kill -0 "$browser" 2>/dev/null; do
    read -r tick <&5 || die 'session timer exited'
    for child in $children; do kill -0 "$child" 2>/dev/null || die 'socket or audio provider exited'; done
    if [ -n "$portal_mode" ]; then
        started=
        [ ! -f /run/convergent/portal ] || read -r started </run/convergent/portal || :
        case $started in ''|0|*[!0-9]*) die 'portal mode ended' ;; esac
        read -r uptime idle </proc/uptime
        now=$((epoch + ${uptime%.*}))
        [ "$started" -le "$now" ] && [ $((now - started)) -lt 1800 ] || die 'portal mode ended'
        # check status probes all three guests each minute; ignore pre-launch results.
        if [ /run/convergent/status/portal -nt "$run/portal.checked" ]; then
            read -r mode </run/convergent/status/portal || die 'portal status unavailable'
            [ "$mode" = on ] || die 'portal mode ended'
            : >"$run/portal.checked"
            checked=${uptime%.*}
        fi
        [ $((${uptime%.*} - checked)) -lt 180 ] || die 'portal status is stale'
    fi
done
wait "$browser" || {
    rc=$?
    case $rc in
    21) die "the $role browser exited with status $rc: Chromium reports this profile is in use on another host" ;;
    7) die "the $role browser exited with status $rc: required Chromium files are missing" ;;
    31) die "the $role browser exited with status $rc: Chromium encountered an invalid sandbox state" ;;
    37) die "the $role browser exited with status $rc: Chromium exhausted system resources" ;;
    *) die "the $role browser exited with status $rc" ;;
    esac
}
