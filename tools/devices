#!/bin/sh
# ARCHITECTURE 3.1, 9, 10
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

tb=/sys/bus/thunderbolt/devices

die() { echo "devices: $*" >&2; exit 1; }
usage() { echo "usage: devices list | review | enrol | revoke RULE | allow ID | allow tb ID | wired status|remove|attach VENDOR:PRODUCT SERIAL | camera on|off|restore|load [MODULE]" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

# ask: show the question, accept only the word yes from a terminal.
ask() {
	[ -t 0 ] || die "this needs a terminal to confirm on"
	printf '%s [type yes] ' "$1"
	read -r a || a=
	[ "$a" = yes ] || die "not approved"
}

tb_list() {
	for d in "$tb"/[0-9]*-[0-9]*; do
		[ -e "$d/authorized" ] && [ -e "$d/unique_id" ] || continue
		printf '%s %s %s %s\n' "$(cat "$d/unique_id")" "$(cat "$d/authorized")" \
			"$(cat "$d/vendor_name" 2>/dev/null || echo ?)" "$(cat "$d/device_name" 2>/dev/null || echo ?)" | tr -d '\000-\010\013-\037\177'
	done
}

list() {
	echo "USB, blocked:"
	lines=$(usbguard list-devices -b) || die "usbguard does not answer"
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
	echo "Thunderbolt, not authorized:"
	tb_list | awk '$2 == 0 { id = $1; $1 = $2 = ""; print "  " id " " substr($0, 3) }'
	for d in "$tb"/domain[0-9]*; do
		[ -e "$d/security" ] || continue
		case $(cat "$d/security") in
		user | secure) ;;
		dponly) echo "  ${d##*/}: security level dponly, PCIe tunnels are off in the firmware" ;;
		*) echo "  ${d##*/}: security level $(cat "$d/security"): devices are authorized without asking" ;;
		esac
	done
}

allow_usb() {
	id=$1
	case $id in '' | *[!0-9]*) die "not a device number: $id" ;; esac
	line=$(usbguard list-devices -b | grep "^$id: ") || die "device $id is not among the blocked devices"
	printf '%s\n' "$line" | tr -d '\000-\010\013-\037\177'

	case $line in *03:01:01*) echo "WARNING: it presents itself as a keyboard." ;; esac
	case $line in *03:01:02*) echo "WARNING: it presents itself as a pointing device." ;; esac
	case $line in *" 08:"*) echo "NOTE: it presents itself as mass storage." ;; esac
	case $line in *" 02:"* | *" 0a:"* | *" e0:"* | *"{ ff:"*) echo "NOTE: it has a network, wireless or vendor-specific interface." ;; esac
	ask "Allow device $id for good?"
	usbguard allow-device -p "$id" || die "usbguard refused"
	logger -t devices "USB device $id allowed permanently: $line"
	echo "devices: allowed, and written to the allow-list"
}

allow_tb() {
	id=$1
	case $id in '' | *[!0-9a-fA-F-]*) die "not a unique id: $id" ;; esac
	for d in "$tb"/[0-9]*-[0-9]*; do
		# Pin the directory across approval.
		CDPATH= cd -P "$d" 2>/dev/null || continue
		[ -e unique_id ] && [ "$(cat unique_id)" = "$id" ] || continue
		[ -e authorized ] || continue
		[ "$(cat authorized)" = 0 ] || die "$id is authorized already"
		printf '%s\n' "$id: $(cat vendor_name 2>/dev/null || echo ?) $(cat device_name 2>/dev/null || echo ?)" | tr -d '\000-\010\013-\037\177'
		ask "Open a PCIe tunnel to it until it is unplugged?"
		echo 1 >authorized || die "the kernel refused (security level of the domain?)"
		logger -t devices "Thunderbolt device $id authorized"
		echo "devices: authorized"
		return
	done
	die "no Thunderbolt device with unique id $id"
}

ic() { incus --force-local --project default "$@" 9>&-; }
wired() {
	umask 077
	mkdir -p /run/convergent
	exec 9>/run/convergent/guests.lock
	flock -n 9 || die 'another guest operation is running'
	instance=$(timeout -k 1 30 incus --force-local query '/1.0/instances/wan?project=default' 9>&-) || die 'cannot read wan'
	printf '%s\n' "$instance" | jq -e '.type == "virtual-machine"' >/dev/null || die 'wan is not a VM'
	role=$(printf '%s\n' "$instance" | jq -c '.devices["wired-uplink"] // null')
	case ${1:-} in
	status)
		[ $# = 1 ] || usage
		printf 'wan wired-uplink: %s\n' "$role"
		allowed=$(usbguard list-devices -a) || die 'USBGuard does not answer'
		printf '%s\n' "$allowed" | tr -d '\000-\010\013-\037\177'
		;;
	remove)
		[ $# = 1 ] || usage
		[ "$role" != null ] || return 0
		ic config device remove wan wired-uplink
		;;
	attach)
		[ $# = 3 ] || usage
		# Only the owner's supported NIC; no arbitrary USB classes enter wan.
		[ "$2" = 0bda:8153 ] || die 'supported uplink is 0bda:8153'
		serial=$3
		case $serial in ''|*[!A-Za-z0-9_.:-]*) die 'invalid USB serial' ;; esac
		[ "${#serial}" -le 64 ] || die 'USB serial exceeds 64 characters'
		[ "$role" = null ] || die 'remove the existing wired role first'
		allowed=$(usbguard list-devices -a) || die 'USBGuard does not answer'
		printf '%s\n' "$allowed" | serial="$serial" awk '
		$2 == "allow" && $3 == "id" && $4 == "0bda:8153" &&
		index($0, " serial \"" ENVIRON["serial"] "\"") {n++}
		END {exit n != 1}' || die 'exactly one matching NIC must be allowed by USBGuard; use sys usb allow first'
		found=0
		for d in /sys/bus/usb/devices/*; do
			[ "$(cat "$d/idVendor" 2>/dev/null)" = 0bda ] &&
			[ "$(cat "$d/idProduct" 2>/dev/null)" = 8153 ] &&
			[ "$(cat "$d/serial" 2>/dev/null)" = "$serial" ] || continue
			[ "$(cat "$d/authorized")" = 1 ] || die 'NIC is not authorized'
			for n in "$d"/*/net/*; do
				[ -e "$n" ] || continue
				addresses=$(ip -o addr show dev "${n##*/}") || die 'cannot check host NIC addresses'
				[ -z "$addresses" ] || die 'NIC has host addresses; refusing passthrough'
			done
			found=$((found + 1))
		done
		[ "$found" = 1 ] || die 'NIC missing or serial is ambiguous'
		ask "Assign 0bda:8153 serial $serial to wan, including future replugs?"
		ic config device add wan wired-uplink usb vendorid=0bda productid=8153 "serial=$serial" required=false
		echo 'Wired role set. Incus attaches matching authorized replugs; sys wired remove clears it.'
		;;
	*) usage ;;
	esac
}

review() {
	echo 'USB policy (rule numbers; names included, even when unplugged):'
	lines=$(usbguard list-rules) || die 'cannot read policy'
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
	echo 'Attached USB (device numbers, allow/block/reject and names):'
	lines=$(usbguard list-devices) || die 'cannot read devices'
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
}

enrol() {
	[ -t 0 ] || die 'enrol needs a terminal'
	work=$(mktemp -d) || exit 1
	trap 'rm -rf "$work"' 0
	trap 'exit 1' HUP INT TERM
	usbguard generate-policy >"$work/generated" || die 'cannot generate policy'
	usbguard list-rules >"$work/old" || die 'cannot read policy'
	: >"$work/approved"
	echo 'Only attached devices individually approved here will be allowed. Review hubs too.'
	while IFS= read -r rule <&3; do
		case $rule in ''|'#'*) continue ;; esac
		case $rule in allow\ id\ *\ hash\ \"*\") ;; allow\ id\ *\ hash\ \"*\"\ *) ;; *) die 'generator returned a non-device rule' ;; esac
		printf '\n%s\n' "$rule" | tr -d '\000-\010\013-\037\177'
		printf 'Trust this device? [yes/No] '
		IFS= read -r a || die 'review cancelled'
		[ "$a" != yes ] || printf '%s\n' "$rule" >>"$work/approved"
	done 3<"$work/generated"
	tr -d '\000-\010\013-\037\177' <"$work/approved"
	ask 'Replace the entire USB policy with these devices? Unlisted devices will be blocked.'
	usbguard list-rules >"$work/current" && cmp -s "$work/old" "$work/current" || die 'policy changed during review; retry'
	cancelled=0
	trap 'cancelled=129' HUP
	trap 'cancelled=130' INT
	trap 'cancelled=143' TERM
	(
		# Children must also finish the commit before cancellation takes effect.
		trap '' HUP INT TERM
		trap 'echo "$?" >"$work/result"' 0
		# Insert reviewed rules before any old catch-all, then remove the old policy.
		while IFS= read -r rule; do
			usbguard append-rule -a 0 "$rule" >/dev/null || die 'append failed; review the policy before retrying'
		done <"$work/approved"
		while IFS= read -r rule; do
			id=${rule%%:*}
			case $id in ''|*[!0-9]*) die 'invalid policy rule number' ;; esac
			usbguard remove-rule "$id" || die 'removal failed; review the policy before retrying'
		done <"$work/old"
		# The daemon applies the saved policy to present devices on startup.
		rc-service usbguard restart || die 'policy saved; USBGuard restart failed'
		logger -t devices 'USB policy replaced after individual review'
	) &
	commit=$!
	# A trapped signal interrupts wait; the child records its own final status.
	while kill -0 "$commit" 2>/dev/null; do wait "$commit" || :; done
	[ -s "$work/result" ] && [ "$(cat "$work/result")" = 0 ] || die 'USB policy commit failed; review before retrying'
	exit "$cancelled"
}

revoke() {
	case $1 in ''|*[!0-9]*) die 'invalid rule number' ;; esac
	rules=$(usbguard list-rules) || die 'cannot read policy'
	line=$(printf '%s\n' "$rules" | grep "^$1: allow ") || die 'not an allowed rule (use review)'
	case $line in *\ hash\ \"*\"*) ;; *) die 'not a device-specific rule; enrol individual devices first' ;; esac
	printf '%s\n' "$line" | tr -d '\000-\010\013-\037\177'
	ask 'Remove this allowance and reapply the remaining policy? This can disconnect input or storage.'
	# A specific deny also defeats any overlapping allowance in an older policy.
	usbguard append-rule -a 0 "block ${line#*: allow }" >/dev/null || die 'cannot block device'
	usbguard remove-rule "$1" || die 'cannot remove rule'
	rc-service usbguard restart || die 'rule removed; USBGuard restart failed'
	logger -t devices "USB rule $1 revoked"
}

camera_unload() {
	# Sensor modules can hold the video core after the controller is gone.
	for holder in "/sys/module/$1/holders/"*; do
		[ -e "$holder" ] || continue
		camera_unload "${holder##*/}" || return 1
	done
	[ ! -d "/sys/module/$1" ] || modprobe -r "$1"
}

camera() {
	choice=/var/lib/convergent/devices/camera
	case ${1:-} in
	load)
		[ "$#" = 2 ] || usage
		case $2 in videodev|uvcvideo|intel_ipu6|intel_ipu6_isys|ipu3_cio2|ipu3_imgu|atomisp) ;; *) die 'invalid camera module' ;; esac
		exec 7>/run/convergent-camera-load.lock
		flock -s 7
		[ "$(cat "$choice" 2>/dev/null || :)" = on ] || die 'camera is off (sys camera on)'
		exec modprobe --ignore-install "$2" ;;
	on|off|restore) [ "$#" = 1 ] || usage ;;
	*) usage ;;
	esac
	install -d -m 0755 /var/lib/convergent/devices
	exec 8>/run/convergent-camera.lock
	flock -x 8
	if [ "$1" = off ]; then
		exec 7>/run/convergent-camera-load.lock
		flock -x 7
	fi
	if [ "$1" != restore ]; then
		file=$(mktemp /var/lib/convergent/devices/.camera.XXXXXX) || exit 1
		printf '%s\n' "$1" >"$file" && chmod 0644 "$file" && mv -f "$file" "$choice" || die 'cannot save camera choice'
	fi
	if [ "$(cat "$choice" 2>/dev/null || :)" = on ]; then
		modprobe uvcvideo || die 'camera enabled, but UVC driver failed to load'
		# Load only camera PCI drivers whose aliases match attached hardware.
		for f in /sys/bus/pci/devices/*/modalias; do
			[ -r "$f" ] || continue
			for m in $(modprobe -R "$(cat "$f")" 2>/dev/null || :); do
				case $m in intel_ipu6|intel_ipu6_isys|ipu3_cio2|ipu3_imgu|atomisp) modprobe "$m" || die "cannot load $m" ;; esac
			done
		done
	else
		# Block new loads before unloading; never force a module an application uses.
		failed=0
		camera_unload videodev || failed=1
		for m in uvcvideo intel_ipu6_isys intel_ipu6 ipu3_imgu ipu3_cio2 atomisp videodev; do
			[ ! -d "/sys/module/$m" ] || modprobe -r "$m" || failed=1
		done
		[ "$failed" = 0 ] || die 'camera disabled for future loads; close camera applications and retry off'
	fi
}

case ${1:-} in
wired) shift; wired "$@"; exit ;;
camera) shift; camera "$@"; exit ;;
esac
# Serialize owner policy changes, including the review interval.
exec 9>/run/convergent-usb.lock
flock -x 9
case ${1:-} in
list) [ $# = 1 ] || usage; list ;;
review) [ $# = 1 ] || usage; review ;;
enrol) [ $# = 1 ] || usage; enrol ;;
revoke) [ $# = 2 ] || usage; revoke "$2" ;;
allow)
	case $# in
	2) allow_usb "$2" ;;
	3) [ "$2" = tb ] || usage; allow_tb "$3" ;;
	*) usage ;;
	esac ;;
*) usage ;;
esac
