#!/bin/sh
# ARCHITECTURE 3.1, 9, 10
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

tb=/sys/bus/thunderbolt/devices

die() { echo "devices: $*" >&2; exit 1; }
usage() { echo "usage: devices list | review | enrol | revoke RULE | allow ID | allow tb ID | wired status|remove|attach VENDOR:PRODUCT SERIAL | camera on|off|restore|load [MODULE] | bluetooth on|off" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

# ask: show the question, accept only the word yes from a terminal.
ask() {
	[ -t 0 ] || die "this needs a terminal to confirm on"
	printf '%s [type yes] ' "$1"
	read -r a || a=
	[ "$a" = yes ] || die "not approved"
}

tb_list() {
	for d in "$tb"/[0-9]*-[0-9]*; do
		[ -e "$d/authorized" ] && [ -e "$d/unique_id" ] || continue
		printf '%s %s %s %s\n' "$(cat "$d/unique_id")" "$(cat "$d/authorized")" \
			"$(cat "$d/vendor_name" 2>/dev/null || echo ?)" "$(cat "$d/device_name" 2>/dev/null || echo ?)" | tr -d '\000-\010\013-\037\177'
	done
}

list() {
	echo "USB, blocked:"
	lines=$(usbguard list-devices -b) || die "usbguard does not answer"
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
	echo "Thunderbolt, not authorized:"
	tb_list | awk '$2 == 0 { id = $1; $1 = $2 = ""; print "  " id " " substr($0, 3) }'
	for d in "$tb"/domain[0-9]*; do
		[ -e "$d/security" ] || continue
		case $(cat "$d/security") in
		user | secure) ;;
		dponly | usbonly | nopcie) echo "  ${d##*/}: security level $(cat "$d/security"), PCIe tunnels are off in the firmware" ;;
		*) echo "  ${d##*/}: security level $(cat "$d/security"): devices are authorized without asking" ;;
		esac
	done
}

# Rules that follow a device: no parent-hash (a hub changes with the port) and no root hub hash (it carries the
# kernel version), a port only without a serial (USBGuard's own default), and a connection type only for
# internal (hardwired) devices. install/install writes the same.
rule_portable() {
	sed -e 's/ parent-hash "[^"]*"//' -e '/ serial ""/!s/ via-port "[^"]*"//' -e '/^allow id 1d6b:/s/ hash "[^"]*"//' \
		-e 's/ with-connect-type "hotplug"//' -e 's/ with-connect-type "unknown"//' -e 's/ with-connect-type ""//'
}

allow_usb() {
	id=$1
	case $id in '' | *[!0-9]*) die "not a device number: $id" ;; esac
	line=$(usbguard list-devices -b | grep "^$id: ") || die "device $id is not among the blocked devices"
	printf '%s\n' "$line" | tr -d '\000-\010\013-\037\177'

	# Any HID interface, not only boot keyboards and mice: a generic one can type too.
	case $line in *" 03:"*) echo "WARNING: it has a HID interface: it can type, click or move the pointer." ;; esac
	case $line in *" 08:"*) echo "NOTE: it presents itself as mass storage." ;; esac
	case $line in *" 02:"* | *" 0a:"* | *" e0:"* | *" ff:"*) echo "NOTE: it has a network, wireless or vendor-specific interface." ;; esac
	ask "Allow device $id for good?"
	case $line in [0-9]*:\ block\ id\ *\ hash\ \"*) ;; *) die "cannot build a rule for device $id" ;; esac
	# The rule the installer and enrol write (rule_portable), first, so it wins over an earlier block of the
	# same device; on disk before the device is let in.
	rule=$(printf '%s\n' "$line" | sed 's/^[0-9]*: block /allow /' | rule_portable)
	# A retry after a failed authorization finds its rule there already.
	usbguard list-rules | sed 's/^[0-9]*: //' | grep -qxF -- "$rule" ||
		usbguard append-rule -a 0 "$rule" >/dev/null || die "usbguard refused the rule"
	sync -f /etc/usbguard/rules.conf || die 'rule added, but it may not survive a power cut; run sync'
	usbguard allow-device "$id" || die "rule saved; the device is allowed at the next USBGuard start"
	logger -t devices "USB device $id allowed permanently: $line"
	echo "devices: allowed, and written to the allow-list"
}

allow_tb() {
	id=$1
	case $id in '' | *[!0-9a-fA-F-]*) die "not a unique id: $id" ;; esac
	for d in "$tb"/[0-9]*-[0-9]*; do
		# Pin the directory across approval.
		CDPATH= cd -P "$d" 2>/dev/null || continue
		[ -e unique_id ] && [ "$(cat unique_id)" = "$id" ] || continue
		[ -e authorized ] || continue
		[ "$(cat authorized)" = 0 ] || die "$id is authorized already"
		printf '%s\n' "$id: $(cat vendor_name 2>/dev/null || echo ?) $(cat device_name 2>/dev/null || echo ?)" | tr -d '\000-\010\013-\037\177'
		ask "Open a PCIe tunnel to it until it is unplugged?"
		echo 1 >authorized || die "the kernel refused (security level of the domain?)"
		logger -t devices "Thunderbolt device $id authorized"
		echo "devices: authorized"
		return
	done
	die "no Thunderbolt device with unique id $id"
}

ic() { timeout -k 1 120 incus --force-local --project default "$@" 9>&-; }
wired() {
	umask 077
	mkdir -p /run/convergent
	exec 9>/run/convergent/guests.lock
	# A full scan holds it shared for a minute or more: revoke and enrol wait it out to prune.
	# attach locks after the owner's answer: an open prompt must not hold off the heal and the scans.
	[ "${1:-}" = attach ] || flock -w 60 9 || die 'another guest operation is running'
	wired_read() {
		instance=$(timeout -k 1 30 incus --force-local query '/1.0/instances/wan?project=default' 9>&-) || die 'cannot read wan'
		printf '%s\n' "$instance" | jq -e '.type == "virtual-machine"' >/dev/null || die 'wan is not a VM'
		role=$(printf '%s\n' "$instance" | jq -c '.devices["wired-uplink"] // null')
	}
	wired_read
	case ${1:-} in
	status)
		[ $# = 1 ] || usage
		printf 'wan wired-uplink: %s\n' "$role"
		allowed=$(usbguard list-devices -a) || die 'USBGuard does not answer'
		printf '%s\n' "$allowed" | tr -d '\000-\010\013-\037\177'
		;;
	remove)
		[ $# = 1 ] || usage
		# check's re-attach state (tools/check wired_heal) ends with the role.
		rm -f /run/convergent/wired-strike /run/convergent/wired-heal
		[ "$role" != null ] || return 0
		ic config device remove wan wired-uplink
		;;
	prune)
		# After revoke or enrol: a role no allow rule names any more leaves wan (Incus ignores USBGuard). With no
		# role, a failed re-add's record (tools/check wired_heal) names the serial: it goes the same way.
		[ $# = 1 ] || usage
		if [ "$role" = null ]; then
			serial=$(sed -n 's/^failed //p' /run/convergent/wired-heal 2>/dev/null) || serial=
			[ -n "$serial" ] || return 0
			id=0bda:8153
		else
			id=$(printf '%s\n' "$role" | jq -r '"\(.vendorid // ""):\(.productid // "")"')
			serial=$(printf '%s\n' "$role" | jq -r '.serial // ""')
		fi
		rules=$(usbguard list-rules) || die 'cannot read policy'
		if printf '%s\n' "$rules" | id="$id" serial="$serial" awk '
		$2 == "allow" && $3 == "id" && $4 == ENVIRON["id"] &&
		index($0, " serial \"" ENVIRON["serial"] "\"") {n++}
		END {exit !n}'; then return 0; fi
		if [ "$role" = null ]; then
			rm -f /run/convergent/wired-strike /run/convergent/wired-heal
			echo 'devices: no USB rule allows the wired uplink NIC any more; dropped its failed re-attach'
			return 0
		fi
		ic config device remove wan wired-uplink
		rm -f /run/convergent/wired-strike /run/convergent/wired-heal
		echo 'devices: no USB rule allows the wired uplink NIC any more; removed its role from wan'
		;;
	attach)
		[ $# = 3 ] || usage
		# Only the owner's supported NIC; no arbitrary USB classes enter wan.
		[ "$2" = 0bda:8153 ] || die 'supported uplink is 0bda:8153'
		serial=$3
		case $serial in ''|*[!A-Za-z0-9_.:-]*) die 'invalid USB serial' ;; esac
		[ "${#serial}" -le 64 ] || die 'USB serial exceeds 64 characters'
		[ "$role" = null ] || die 'remove the existing wired role first'
		# Checked again after the answer, under the lock: the NIC can be swapped while the prompt waits.
		wired_nic() {
			allowed=$(usbguard list-devices -a) || die 'USBGuard does not answer'
			printf '%s\n' "$allowed" | serial="$serial" awk '
			$2 == "allow" && $3 == "id" && $4 == "0bda:8153" &&
			index($0, " serial \"" ENVIRON["serial"] "\"") {n++}
			END {exit n != 1}' || die 'exactly one matching NIC must be allowed by USBGuard; use sys usb allow first'
			found=0
			for d in /sys/bus/usb/devices/*; do
				[ "$(cat "$d/idVendor" 2>/dev/null)" = 0bda ] &&
				[ "$(cat "$d/idProduct" 2>/dev/null)" = 8153 ] &&
				[ "$(cat "$d/serial" 2>/dev/null)" = "$serial" ] || continue
				[ "$(cat "$d/authorized")" = 1 ] || die 'NIC is not authorized'
				for n in "$d"/*/net/*; do
					[ -e "$n" ] || continue
					addresses=$(ip -o addr show dev "${n##*/}") || die 'cannot check host NIC addresses'
					[ -z "$addresses" ] || die 'NIC has host addresses; refusing passthrough'
				done
				found=$((found + 1))
			done
			[ "$found" = 1 ] || die 'NIC missing or serial is ambiguous'
		}
		wired_nic
		ask "Assign 0bda:8153 serial $serial to wan, including future replugs?"
		flock -w 60 9 || die 'another guest operation is running'
		wired_read
		[ "$role" = null ] || die 'wan changed during the confirmation; retry'
		wired_nic
		ic config device add wan wired-uplink usb vendorid=0bda productid=8153 "serial=$serial" required=false
		echo 'Wired role set. After a replug, check re-attaches it within two minutes if USBGuard allows it; sys wired remove clears it.'
		;;
	*) usage ;;
	esac
}

review() {
	echo 'USB policy (rule numbers; names included, even when unplugged):'
	lines=$(usbguard list-rules) || die 'cannot read policy'
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
	echo 'Attached USB (device numbers, allow/block/reject and names):'
	lines=$(usbguard list-devices) || die 'cannot read devices'
	printf '%s\n' "$lines" | tr -d '\000-\010\013-\037\177'
}

# The USB ports from the disk under the open state volume (not a label another disk may carry) up to its root
# hub: a system installed to a USB disk.
system_usb() {
	dev=$(mountpoint -x /dev/mapper/cv-state 2>/dev/null) || return 0
	set -- /sys/dev/block/"$dev"/slaves/*
	[ $# = 1 ] && [ -e "$1" ] || return 0
	usb=$(readlink -f "/sys/class/block/${1##*/}/../device") || return 0
	while [ -n "$usb" ]; do
		[ ! -f "$usb/idVendor" ] || echo "${usb##*/}"
		usb=${usb%/*}
	done
}

enrol() (
	[ -t 0 ] || die 'enrol needs a terminal'
	work=$(mktemp -d) || exit 1
	trap 'rm -rf "$work"' 0
	trap 'exit 1' HUP INT TERM
	# Reviewed as generated; written as rule_portable makes them.
	usbguard generate-policy >"$work/generated" || die 'cannot generate policy'
	usbguard list-rules >"$work/old" || die 'cannot read policy'
	: >"$work/approved"
	echo 'Only attached devices individually approved here will be allowed. Review hubs too.'
	while IFS= read -r rule <&3; do
		case $rule in ''|'#'*) continue ;; esac
		case $rule in allow\ id\ *\ hash\ \"*\") ;; allow\ id\ *\ hash\ \"*\"\ *) ;; *) die 'generator returned a non-device rule' ;; esac
		printf '\n%s\n' "$rule" | tr -d '\000-\010\013-\037\177'
		printf 'Trust this device? [yes/No] '
		IFS= read -r a || die 'review cancelled'
		[ "$a" != yes ] || printf '%s\n' "$rule" >>"$work/approved"
	done 3<"$work/generated"
	tr -d '\000-\010\013-\037\177' <"$work/approved"
	# Blocking the disk the system runs from, or a hub above it, stops it, now and at every boot.
	for port in $(system_usb); do
		hash=$(usbguard list-devices | grep -F " via-port \"$port\"" | sed -n 's/.* hash "\([^"]*\)".*/\1/p')
		[ -n "$hash" ] && grep -qF " hash \"$hash\"" "$work/approved" ||
			die 'the system runs from a USB disk: enrol again and trust it and every hub above it; nothing changed'
	done
	ask 'Replace the entire USB policy with these devices? Unlisted devices will be blocked.'
	usbguard list-rules >"$work/current" && cmp -s "$work/old" "$work/current" || die 'policy changed during review; retry'
	# Insert reviewed rules before any old catch-all, then remove the old policy.
	rule_portable <"$work/approved" >"$work/portable" || die 'cannot write the rules'
	while IFS= read -r rule; do
		usbguard append-rule -a 0 "$rule" >/dev/null || die 'append failed; review the policy before retrying'
	done <"$work/portable"
	while IFS= read -r rule; do
		id=${rule%%:*}
		case $id in ''|*[!0-9]*) die 'invalid policy rule number' ;; esac
		usbguard remove-rule "$id" || die 'removal failed; review the policy before retrying'
	done <"$work/old"
	sync -f /etc/usbguard/rules.conf || die 'policy saved, maybe not on disk; run sync before a reboot'
	# The daemon applies the saved policy to present devices on startup.
	rc-service usbguard restart || die 'policy saved; USBGuard restart failed'
	logger -t devices 'USB policy replaced after individual review'
	# A subshell: wired takes fd 9, which holds the USB lock here.
	# Before guests setup there is no wan and no role to check.
	[ ! -f /var/lib/convergent/guests/initialized ] || (wired prune) ||
		die "policy saved; wan's wired role not checked: sys wired status, then sys wired remove if needed"
)

revoke() {
	case $1 in ''|*[!0-9]*) die 'invalid rule number' ;; esac
	rules=$(usbguard list-rules) || die 'cannot read policy'
	line=$(printf '%s\n' "$rules" | grep "^$1: allow ") || die 'not an allowed rule (use review)'
	case $line in *\ hash\ \"*\"*) ;; *) die 'not a device-specific rule; enrol individual devices first' ;; esac
	ports=$(system_usb)
	if [ -n "$ports" ]; then
		devices=$(usbguard list-devices) || die 'cannot read devices'
		for port in $ports; do
			device=$(printf '%s\n' "$devices" | grep -F " via-port \"$port\"")
			hash=$(printf '%s\n' "$device" | sed -n 's/.* hash "\([^"]*\)".*/\1/p')
			case $line in *" hash \"$hash\""*) [ -z "$hash" ] || die 'that rule allows the USB disk the system runs from, or a hub above it' ;; esac
		done
	fi
	printf '%s\n' "$line" | tr -d '\000-\010\013-\037\177'
	ask 'Remove this allowance and reapply the remaining policy? This can disconnect input or storage.'
	# A specific deny also defeats any overlapping allowance in an older policy.
	usbguard append-rule -a 0 "block ${line#*: allow }" >/dev/null || die 'cannot block device'
	usbguard remove-rule "$1" || die 'cannot remove rule'
	sync -f /etc/usbguard/rules.conf || die 'rule removed, maybe not on disk; run sync before a reboot'
	rc-service usbguard restart || die 'rule removed; USBGuard restart failed'
	logger -t devices "USB rule $1 revoked"
	[ ! -f /var/lib/convergent/guests/initialized ] || (wired prune) ||
		die "rule revoked; wan's wired role not checked: sys wired status, then sys wired remove if needed"
}

camera_unload() {
	# Sensor modules can hold the video core after the controller is gone.
	for holder in "/sys/module/$1/holders/"*; do
		[ -e "$holder" ] || continue
		camera_unload "${holder##*/}" || return 1
	done
	[ ! -d "/sys/module/$1" ] || modprobe -r "$1"
}

camera() {
	choice=/var/lib/convergent/devices/camera
	case ${1:-} in
	load)
		[ "$#" = 2 ] || usage
		case $2 in videodev|uvcvideo|intel_ipu6|intel_ipu6_isys|ipu3_cio2|ipu3_imgu|atomisp) ;; *) die 'invalid camera module' ;; esac
		exec 7>/run/convergent-camera-load.lock
		flock -s 7
		[ "$(cat "$choice" 2>/dev/null || :)" = on ] || die 'camera is off (sys camera on)'
		exec modprobe --ignore-install "$2" ;;
	on|off|restore) [ "$#" = 1 ] || usage ;;
	*) usage ;;
	esac
	install -d -m 0755 /var/lib/convergent/devices
	exec 8>/run/convergent-camera.lock
	flock -x 8
	if [ "$1" = off ]; then
		exec 7>/run/convergent-camera-load.lock
		flock -x 7
	fi
	if [ "$1" != restore ]; then
		file=$(mktemp /var/lib/convergent/devices/.camera.XXXXXX) || exit 1
		printf '%s\n' "$1" >"$file" && chmod 0644 "$file" && mv -f "$file" "$choice" || die 'cannot save camera choice'
	fi
	if [ "$(cat "$choice" 2>/dev/null || :)" = on ]; then
		modprobe uvcvideo || die 'camera enabled, but UVC driver failed to load'
		# Load only camera PCI drivers whose aliases match attached hardware.
		for f in /sys/bus/pci/devices/*/modalias; do
			[ -r "$f" ] || continue
			for m in $(modprobe -R "$(cat "$f")" 2>/dev/null || :); do
				case $m in intel_ipu6|intel_ipu6_isys|ipu3_cio2|ipu3_imgu|atomisp) modprobe "$m" || die "cannot load $m" ;; esac
			done
		done
	else
		# Block new loads before unloading; never force a module an application uses.
		failed=0
		camera_unload videodev || failed=1
		for m in uvcvideo intel_ipu6_isys intel_ipu6 ipu3_imgu ipu3_cio2 atomisp videodev; do
			[ ! -d "/sys/module/$m" ] || modprobe -r "$m" || failed=1
		done
		[ "$failed" = 0 ] || die 'camera disabled for future loads; close camera applications and retry off'
	fi
}

# The kill switch is the gate (rfkill.default_state=0 blocks every radio at boot); no saved choice.
bluetooth() {
	case ${1:-} in on|off) [ "$#" = 1 ] || usage ;; *) usage ;; esac
	exec 8>/run/convergent-bluetooth.lock
	flock -x 8
	if [ "$1" = on ]; then
		bluetooth_radio || die 'no Bluetooth radio'
		# Interrupted before power-on: block again.
		trap "bluetooth_block 'interrupted'" INT TERM HUP
		rfkill unblock bluetooth || bluetooth_block 'rfkill refused'
		rc-service bluetooth start || bluetooth_block 'bluetoothd did not start'
		# The adapter registers with bluetoothd after the unblock.
		waited=0
		until timeout -k 1 10 bluetoothctl show >/dev/null 2>&1; do
			waited=$((waited + 1))
			[ "$waited" -lt 10 ] || bluetooth_block 'no Bluetooth adapter'
			sleep 1
		done
		timeout -k 1 10 bluetoothctl power on || bluetooth_block 'the adapter did not power on'
		trap - INT TERM HUP
		return
	fi
	# Only a running bluetoothd answers: a stopped one costs the whole bound.
	if rc-service bluetooth status >/dev/null 2>&1; then timeout -k 1 10 bluetoothctl power off >/dev/null 2>&1 || :; fi
	failed=
	rfkill block bluetooth || failed='rfkill refused'
	rc-service bluetooth stop || failed=${failed:-'bluetoothd did not stop'}
	bluetooth_blocked || die 'a Bluetooth radio still reads unblocked'
	[ -z "$failed" ] || die "$failed"
}
bluetooth_radio() {
	for radio in /sys/class/rfkill/rfkill*; do
		[ "$(cat "$radio/type" 2>/dev/null)" != bluetooth ] || return 0
	done
	return 1
}
# A radio that vanished is blocked.
bluetooth_blocked() {
	for radio in /sys/class/rfkill/rfkill*; do
		[ -e "$radio" ] || continue
		kind=$(cat "$radio/type" 2>/dev/null) || continue
		[ "$kind" = bluetooth ] || continue
		soft=$(cat "$radio/soft" 2>/dev/null) || continue; [ "$soft" = 1 ] || return 1
	done
}
# A failed on leaves the radio blocked and bluetoothd stopped.
bluetooth_block() {
	rfkill block bluetooth || :
	rc-service bluetooth stop || :
	die "$1; the radio is blocked again"
}

case ${1:-} in
wired) shift; wired "$@"; exit ;;
camera) shift; camera "$@"; exit ;;
bluetooth) shift; bluetooth "$@"; exit ;;
esac
# Serialize owner policy changes, including the review interval.
exec 9>/run/convergent-usb.lock
# Bounded: another policy command may sit at its prompt.
flock -w 5 9 || die 'another USB policy command is open; finish or cancel it'
case ${1:-} in
list) [ $# = 1 ] || usage; list ;;
review) [ $# = 1 ] || usage; review ;;
enrol) [ $# = 1 ] || usage; enrol ;;
revoke) [ $# = 2 ] || usage; revoke "$2" ;;
allow)
	case $# in
	2) allow_usb "$2" ;;
	3) [ "$2" = tb ] || usage; allow_tb "$3" ;;
	*) usage ;;
	esac ;;
*) usage ;;
esac
