#!/bin/sh
# ARCHITECTURE 3.1, 9, 10
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

tb=/sys/bus/thunderbolt/devices

die() { echo "devices: $*" >&2; exit 1; }
usage() { echo "usage: devices list | allow ID | allow tb ID" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

# ask: show the question, accept only the word yes from a terminal.
ask() {
	[ -t 0 ] || die "this needs a terminal to confirm on"
	printf '%s [type yes] ' "$1"
	read -r a || a=
	[ "$a" = yes ] || die "not approved"
}

tb_list() {
	for d in "$tb"/[0-9]*-[0-9]*; do
		[ -e "$d/authorized" ] && [ -e "$d/unique_id" ] || continue
		printf '%s %s %s %s\n' "$(cat "$d/unique_id")" "$(cat "$d/authorized")" \
			"$(cat "$d/vendor_name" 2>/dev/null || echo ?)" "$(cat "$d/device_name" 2>/dev/null || echo ?)"
	done
}

list() {
	echo "USB, blocked:"
	usbguard list-devices -b || die "usbguard does not answer"
	echo "Thunderbolt, not authorized:"
	tb_list | awk '$2 == 0 { id = $1; $1 = $2 = ""; print "  " id " " substr($0, 3) }'
	for d in "$tb"/domain[0-9]*; do
		[ -e "$d/security" ] || continue
		case $(cat "$d/security") in
		user | secure) ;;
		dponly) echo "  ${d##*/}: security level dponly, PCIe tunnels are off in the firmware" ;;
		*) echo "  ${d##*/}: security level $(cat "$d/security"): devices are authorized without asking" ;;
		esac
	done
}

allow_usb() {
	id=$1
	case $id in '' | *[!0-9]*) die "not a device number: $id" ;; esac
	line=$(usbguard list-devices -b | grep "^$id: ") || die "device $id is not among the blocked devices"
	echo "$line"

	case $line in *03:01:01*) echo "WARNING: it presents itself as a keyboard." ;; esac
	case $line in *03:01:02*) echo "WARNING: it presents itself as a pointing device." ;; esac
	case $line in *" 08:"*) echo "NOTE: it presents itself as mass storage." ;; esac
	case $line in *" 02:"* | *" 0a:"* | *" e0:"* | *"{ ff:"*) echo "NOTE: it has a network, wireless or vendor-specific interface." ;; esac
	ask "Allow device $id for good?"
	usbguard allow-device -p "$id" || die "usbguard refused"
	logger -t devices "USB device $id allowed permanently: $line"
	echo "devices: allowed, and written to the allow-list"
}

allow_tb() {
	id=$1
	case $id in '' | *[!0-9a-fA-F-]*) die "not a unique id: $id" ;; esac
	for d in "$tb"/[0-9]*-[0-9]*; do
		# Pin the directory across approval.
		CDPATH= cd -P "$d" 2>/dev/null || continue
		[ -e unique_id ] && [ "$(cat unique_id)" = "$id" ] || continue
		[ -e authorized ] || continue
		[ "$(cat authorized)" = 0 ] || die "$id is authorized already"
		echo "$id: $(cat vendor_name 2>/dev/null || echo ?) $(cat device_name 2>/dev/null || echo ?)"
		ask "Open a PCIe tunnel to it until it is unplugged?"
		echo 1 >authorized || die "the kernel refused (security level of the domain?)"
		logger -t devices "Thunderbolt device $id authorized"
		echo "devices: authorized"
		return
	done
	die "no Thunderbolt device with unique id $id"
}

case ${1:-} in
list) [ $# = 1 ] || usage; list ;;
allow)
	case $# in
	2) allow_usb "$2" ;;
	3) [ "$2" = tb ] || usage; allow_tb "$3" ;;
	*) usage ;;
	esac ;;
*) usage ;;
esac
