#!/bin/sh
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8
umask 077

dir=/usr/lib/convergent/sys
tab=$(printf '\t')
die() { echo "sys: $*" >&2; exit 1; }
usage() { echo 'usage: sys [help | --pick ["area action"] | AREA [ACTION] [ARGS]]' >&2; exit 2; }

trace() {
	printf '+' >&2
	for arg do
		printf " '%s'" "$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")" >&2
	done
	printf '\n' >&2
}
run() { trace "$@"; "$@"; }
ask() { printf '%s: ' "$1" >&2; IFS= read -r answer || die 'input cancelled'; }
confirm() {
	printf '%s? [yes/No] ' "$1" >&2
	IFS= read -r answer || return 1
	[ "$answer" = yes ]
}
secret() (
	[ -t 0 ] || die 'passphrase needs a terminal'
	saved=$(stty -g) || exit 1
	trap 'stty "$saved"' 0
	trap 'exit 1' HUP INT TERM
	printf 'Passphrase (empty for a known or open network): ' >&2
	stty -echo || exit 1
	IFS= read -r answer || exit 1
	printf '\n' >&2
	printf '%s' "$answer"
)
noargs() { [ "$#" = 0 ] || usage; }
onearg() {
	[ "$#" -le 2 ] || usage
	if [ "$#" = 2 ]; then answer=$2; else ask "$1"; fi
}
number() {
	case $1 in ''|*[!0-9]*|??????????*) die 'invalid number' ;; esac
}
token() {
	case $1 in ''|-*|*[!a-zA-Z0-9_.-]*) die 'invalid identifier' ;; esac
}
text_valid() {
	[ "$(printf '%s' "$1" | tr -d '\001-\037\177')" = "$1" ] || die 'input contains control bytes'
}
path() {
	case $1 in /*) ;; *) die 'use an absolute path' ;; esac
	text_valid "$1"
}
mac() {
	text_valid "$1"
	printf '%s\n' "$1" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$' || die 'invalid Bluetooth MAC'
}
ssid_valid() {
	case $1 in -*) die 'SSID must not start with -' ;; esac
	[ -n "$1" ] && [ "$(printf %s "$1" | LC_ALL=C wc -c)" -le 32 ] || die 'SSID must be 1-32 bytes'
	text_valid "$1"
}
sway() { [ -n "${SWAYSOCK:-}" ] || die 'needs the sway session'; }
swayrun() { run swaymsg -r -- "$@"; }
pager() {
	if [ -t 1 ] && command -v less >/dev/null 2>&1; then less -F -X; else cat; fi
}
page() (
	file=$(mktemp) || exit 1
	trap 'rm -f "$file"' 0
	trap 'exit 1' HUP INT TERM
	"$@" >"$file"
	result=$?
	pager <"$file"
	exit "$result"
)
root_page() {
	page run sudo cat -- "$1"
}
pause() {
	if [ "$1" = 0 ]; then printf '\nDone.\n'; else printf '\nFailed (exit %s).\n' "$1"; fi
	printf 'Enter to continue '
	IFS= read -r answer || :
}
cached() {
	value=$(timeout -k 0.2 1 head -n 1 "$1" 2>/dev/null) || value=unknown
	printf '%s\n' "${value:-unknown}" | tr -d '\000-\010\013-\037\177' | cut -c 1-100
}
usb_count() {
	value=$(timeout -k 0.2 1 sudo -n usbguard list-devices -b 2>/dev/null) || { echo unknown; return; }
	printf '%s\n' "$value" | awk 'NF {n++} END {print n+0}'
}
save_config() (
	path "$HOME"
	case $1 in outputs|input|touchpad) ;; *) die 'invalid config name' ;; esac
	config=$HOME/.config/sway/config.d
	run mkdir -p "$config" || exit 1
	file=$(mktemp "$config/.$1.XXXXXX") || exit 1
	trap 'rm -f "$file"' 0
	trap 'exit 1' HUP INT TERM
	cat >"$file" || exit 1
	run mv -f "$file" "$config/$1" || exit 1
	[ -z "${SWAYSOCK:-}" ] || swayrun reload || exit 1
	echo 'Saved: applies now and at every login.'
)

areas=
for module in "$dir"/[0-9][0-9]-*; do
	[ -f "$module" ] || continue
	area=${module##*/}; area=${area#*-}
	case $area in ''|*[!a-z]*) die 'invalid module name' ;; esac
	title= actions= alias=
	. "$module"
	[ -n "$title" ] && [ -n "$actions" ] || die "incomplete module: $area"
	case $alias in *[!a-z]*) die "invalid alias: $area" ;; esac
	# Names and aliases are one namespace.
	for n in $area $alias; do
		printf '%s' "$areas" | awk -F '	' -v n="$n" '$1 == n || $3 == n { f = 1 } END { exit !f }' && die "name used twice: $n"
	done
	areas="${areas}${area}${tab}${title}${tab}${alias}
"
done

load() {
	case $1 in ''|*[!a-z]*) usage ;; esac
	area=$(printf '%s' "$areas" | awk -F '\t' -v a="$1" '$1 == a || $3 == a {print $1}')
	[ -n "$area" ] || usage
	alias=
	. "$dir"/[0-9][0-9]-"$area"
}
lookup() {
	label=$(printf '%s\n' "$actions" | a="$1" awk -F '\t' '$1 == ENVIRON["a"] {print $2}')
	flags=$(printf '%s\n' "$actions" | a="$1" awk -F '\t' '$1 == ENVIRON["a"] {print $3}')
	[ -n "$label" ]
}
help() {
	printf 'usage: sys AREA [ACTION] [ARGS]\n       sys | sys help | sys --pick ["area action"]\n\nFirst action is the default; other words are its arguments.\n\n'
	printf '%s' "$areas" | while IFS="$tab" read -r area title alias; do
		load "$area"
		printf '%s\n' "$actions" | while IFS="$tab" read -r action label flags; do
			case " $flags " in *' confirm '*) label="$label *" ;; esac
			printf '  %-30s %s: %s\n' "$area${alias:+ ($alias)} $action" "$title" "$label"
		done
	done
}
pick_list() {
	printf '%s' "$areas" | while IFS="$tab" read -r area title alias; do
		load "$area"
		printf '%s\n' "$actions" | while IFS="$tab" read -r action label flags; do
			printf '%s %s\t%s: %s\n' "$area" "$action" "$title" "$label"
		done
	done
}
dispatch() (
	[ "$#" -ge 1 ] || usage
	case $1 in
	debug) shift; set -- logs debug "$@" ;;
	alerts) shift; set -- security alerts "$@" ;;
	esac
	load "$1"; shift
	if [ "$#" -gt 0 ] && lookup "$1"; then
		action=$1; shift
	else
		action=${actions%%"$tab"*}
		lookup "$action" || usage
	fi
	case " $flags " in
	*' confirm '*)
		case $area:$action in
		wifi:forget|bluetooth:forget|update:usb) [ "$#" -le 1 ] || usage ;;
		display:reset|update:install|power:logout|power:reboot|power:off) noargs "$@" ;;
		esac
		confirm "$title: $label" || exit 1 ;;
	esac
	function=${area}_$action
	"$function" "$@"
)
state() {
	value=$(timeout -k 0.2 2.5 "$0" --state "$1" 2>/dev/null) || value=unknown
	printf '%s\n' "${value:-unknown}" | tr -d '\000-\010\013-\037\177' | head -n 3 | cut -c 1-100
}
command_line() {
	printf 'sys %s %s\n' "$area" "$action"
}
status_preview() (
	load "$1"
	if lookup status; then
		case " $flags " in
		*' root '*) ;;
		*)
			value=$(timeout -k 0.2 2.5 "$0" "$area" status </dev/null 2>/dev/null) || value=
			if [ -n "$value" ]; then
				printf '%s\n' "$value" | tr -d '\000-\010\013-\037\177'
				return
			fi ;;
		esac
	fi
	cat "$states/$1"
)
# Status under its bold title, without the repeated title ("Wi-Fi: x" under Wi-Fi).
status_text() { awk -v t="$title" 'index($0, t ": ") == 1 {$0 = substr($0, length(t) + 3)} $0 != t' "$states/status-$area"; }
dashboard() (
	st=/run/convergent/status
	now=$(date +%s)
	mtime=$(stat -c %Y "$st/topology" 2>/dev/null) || mtime=0
	memtime=$(stat -c %Y "$st/guestmem" 2>/dev/null) || memtime=0
	if [ -e /run/openrc/started/convergent-bless ]; then blessed=good; else blessed=trying; fi
	# The cache has running guests, but no inventory total. Never prompt here.
	guests=$(timeout -k 0.2 1 sudo -n /usr/local/sbin/guests status 2>/dev/null) || guests=unknown
	disk=$(timeout -k 0.2 1 df -Pk /var 2>/dev/null) || disk=
	SYS_DISK=$disk SYS_GUESTS=$guests awk -v st="$st" -v out="$states" -v now="$now" -v mtime="$mtime" -v memtime="$memtime" \
		-v owner="$(id -un)" -v kernel="$(uname -r)" -v blessed="$blessed" '
	function get(path, value) {
		if ((getline value < path) <= 0) value=""
		close(path)
		gsub(/\t/, " ", value)
		gsub(/[[:cntrl:]]/, "", value)
		return value
	}
	function known(value) {return value == "" ? "?" : value}
	function line(value) {
		info[++ni]=value
		if (length(value)>width) width=length(value)
	}
	function plain(s) {gsub(/[{][12][}]/, "", s); return s}
	function paint(s) {gsub(/[{]1[}]/, "\033[35m", s); gsub(/[{]2[}]/, "\033[37m", s); return s "\033[0m"}
	# Logo beside the info, padded by its visible width.
	function emit(file, logo, rows,   r, w, s, lw) {
		for (r=1;r<=rows;r++) if (length(plain(logo[r]))>lw) lw=length(plain(logo[r]))
		for (r=1;r<=(rows>ni ? rows : ni);r++) {
			s=(r<=rows ? logo[r] : "")
			printf "%s%" (lw-length(plain(s))+2) "s%s\n", paint(s), "", info[r] > file
		}
		return lw+2+width
	}
	BEGIN {
		# Gentoo logos from neofetch 7.1.0 (MIT, (c) 2015-2020 Dylan Araps); {1} purple, {2} white.
		big[1]="{1}         -/oyddmdhs+:."
		big[2]="{1}     -o{2}dNMMMMMMMMNNmhy+{1}-`"
		big[3]="{1}   -y{2}NMMMMMMMMMMMNNNmmdhy{1}+-"
		big[4]="{1} `o{2}mMMMMMMMMMMMMNmdmmmmddhhy{1}/`"
		big[5]="{1} om{2}MMMMMMMMMMMN{1}hhyyyo{2}hmdddhhhd{1}o`"
		big[6]="{1}.y{2}dMMMMMMMMMMd{1}hs++so/s{2}mdddhhhhdm{1}+`"
		big[7]="{1} oy{2}hdmNMMMMMMMN{1}dyooy{2}dmddddhhhhyhN{1}d."
		big[8]="{1}  :o{2}yhhdNNMMMMMMMNNNmmdddhhhhhyym{1}Mh"
		big[9]="{1}    .:{2}+sydNMMMMMNNNmmmdddhhhhhhmM{1}my"
		big[10]="{1}       /m{2}MMMMMMNNNmmmdddhhhhhmMNh{1}s:"
		big[11]="{1}    `o{2}NMMMMMMMNNNmmmddddhhdmMNhs{1}+`"
		big[12]="{1}  `s{2}NMMMMMMMMNNNmmmdddddmNMmhs{1}/."
		big[13]="{1} /N{2}MMMMMMMMNNNNmmmdddmNMNdso{1}:`"
		big[14]="{1}+M{2}MMMMMMNNNNNmmmmdmNMNdso{1}/-"
		big[15]="{1}yM{2}MNNNNNNNmmmmmNNMmhs+/{1}-`"
		big[16]="{1}/h{2}MMNNNNNNNNMNdhs++/{1}-`"
		big[17]="{1}`/{2}ohdmmddhys+++/:{1}.`"
		big[18]="{1}  `-//////:--."
		small[1]="{1} _-----_"
		small[2]="{1}(       \\"
		small[3]="{1}\\    0   \\"
		small[4]="{2} \\        )"
		small[5]="{2} /      _/"
		small[6]="{2}(     _-"
		small[7]="{2}\\____-"
		line(owner "@" known(get("/proc/sys/kernel/hostname")))
		n=split(get("/proc/cmdline"), words, " ")
		for (i=1;i<=n;i++) {
			if (words[i] ~ /^convergent.release=/) {release=words[i]; sub(/^[^=]*=/, "", release)}
			if (words[i] ~ /^dm-mod.waitfor=PARTLABEL=cv-slot-/) {slot=words[i]; sub(/^.*cv-slot-/, "", slot)}
		}
		version=get("/usr/lib/convergent/version")
		line("Release: " known(version == "" ? release : version) " / " known(slot) " / " blessed)
		line("Kernel: " kernel)
		uptime=get("/proc/uptime")+0
		line(sprintf("Uptime: %dd %02d:%02d",int(uptime/86400),int(uptime/3600)%24,int(uptime/60)%60))
		while ((getline value < "/proc/cpuinfo") > 0) if (value ~ /^model name[ \t]*:/) {
			sub(/^[^:]*:[ \t]*/, "", value); model=value; break
		}
		close("/proc/cpuinfo")
		line("CPU: " known(model))
		for (i=1;i<ARGC;i++) {
			path=ARGV[i]; value=get(path)
			if (path ~ /scaling_cur_freq$/ && value+0>freq) freq=value+0
			if (path ~ /scaling_max_freq$/ && value+0>cap) cap=value+0
			if (path ~ /\/type$/) {
				sub(/type$/, "", path)
				if (value == "Battery" && bat == "") bat=path
				if (value ~ /^(Mains|USB)/ && get(path "online") == "1") ac=1
			}
		}
		line("Max/cap: " (freq ? sprintf("%.2f",freq/1000000) : "?") "/" (cap ? sprintf("%.2f",cap/1000000) : "?") " GHz")
		while ((getline value < "/proc/meminfo") > 0) {split(value,m," "); mem[m[1]]=m[2]}
		close("/proc/meminfo")
		held=get(st "/guestmem"); ram="?"
		if (memtime>0 && now>=memtime && now-memtime<=180 && held ~ /^[0-9]+$/) {
			used=mem["MemTotal:"]-mem["MemFree:"]-held
			ram=sprintf("%.1f",(used>0 ? used : 0)/1048576)
		}
		line(sprintf("RAM: %s/%.1f GiB (host)",ram,mem["MemTotal:"]/1048576))
		n=split(ENVIRON["SYS_DISK"], rows, "\n"); disk="?"
		if (n>=2) {split(rows[n],m," "); if (m[2]+0>0) disk=sprintf("%.1f/%.1f GiB",m[3]/1048576,m[2]/1048576)}
		line("State: " disk " (/var)")
		n=split(get(st "/topology"), fields," ")
		for (i=1;i<=n;i++) {split(fields[i],pair,"="); topo[pair[1]]=pair[2]}
		master="?"; count="?/?"
		if (mtime>0 && now>=mtime && now-mtime<=180) {
			if (topo["fw1"] == "master" && topo["fw2"] == "backup") master="fw1"
			if (topo["fw2"] == "master" && topo["fw1"] == "backup") master="fw2"
			if (split(get(st "/.running"),m," ") == 5 && m[5] ~ /^[0-9]+$/)
				count=((m[1] == "true")+(m[2] == "true")+(m[3] == "true")+(m[4] == "true")+m[5]) "/?"
		}
		if (ENVIRON["SYS_GUESTS"] != "unknown") {
			n=split(ENVIRON["SYS_GUESTS"],rows,"\n"); total=0; running=0
			for (i=1;i<=n;i++) if (split(rows[i],m," ") == 2) {total++; if (m[2] == "running") running++}
			count=running "/" total
		}
		line("Guests: " count " running; master: " master)
		line("Wi-Fi: " known(get(st "/wifi")))
		line("Power: " (bat == "" ? "AC" : (ac ? "AC; " : "") "BAT " known(get(bat "capacity")) "% " known(get(bat "status"))))
		for (r=1;r<=ni;r++) print info[r] > (out "/header")
		need_small=emit(out "/header-small", small, 7)
		need_wide=emit(out "/header-wide", big, 18)
		rule="------------------------------------------------"
		print rule > (out "/header"); print rule > (out "/header-small"); print rule > (out "/header-wide")
		print need_small, need_wide > (out "/header-cols")
		exit
	}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_*_freq /sys/class/power_supply/*/type
)
# menu TITLE KEYS: terminal colours with a blue highlight; the list left, its status right.
menu() {
	SYS_HEADER=$states/header; export SYS_HEADER
	dashboard
	FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= SHELL=/bin/sh fzf \
		--layout reverse-list --no-sort --info hidden --no-separator --no-scrollbar \
		--delimiter "$tab" --with-nth 2.. --print-query --prompt '/ ' \
		--pointer '›' --marker ' ' --gutter ' ' --highlight-line \
		--border top --border-label " Convergent / $1 " --border-label-pos 3 \
		--list-border sharp --list-label ' Menu ' --list-label-pos 2 --header "$2" \
		--color 'bw,fg:-1,bg:-1,fg+:7:bold,bg+:4,hl:-1:underline,hl+:7:bold:underline,pointer:7:bold,label:-1:bold,header:-1:dim' \
		--preview 'read -r small wide <"$SYS_HEADER-cols"; header=$SYS_HEADER
			[ "${FZF_PREVIEW_COLUMNS:-0}" -lt "$small" ] || header=$SYS_HEADER-small
			[ "${FZF_PREVIEW_COLUMNS:-0}" -lt "$wide" ] || header=$SYS_HEADER-wide
			cat -- "$header" "$SYS_PREVIEW"/{1}' --preview-window right:55%:wrap:border-sharp \
		--preview-label ' Status ' --preview-label-pos 2 \
		--bind 'enter:accept-non-empty,esc:abort,ctrl-u:clear-query,alt-up:preview-up,alt-down:preview-down' \
		--bind 'alt-enter:print-query' \
		>"$states/selection"
	result=$?
	case $result in 0|1) ;; 130) return 1 ;; *) die "fzf failed ($result)" ;; esac
	query=$(head -n 1 "$states/selection")
	selected=$(sed -n '2s/\t.*//p' "$states/selection")
}
typed_command() (
	text_valid "$query"
	[ "${#query}" -le 4096 ] || die 'command too long'
	printf '%s\n' "$query" >"$states/query"
	printf 'sys %s%s\n' "${current:+$current }" "$query"
	set -- "$0"
	[ -z "$current" ] || set -- "$@" "$current"
	# xargs reads quotes, not shell syntax; -a preserves the terminal for prompts.
	rm -f "$states/result" || exit 1
	xargs -a "$states/query" -r -x -s 8192 -- sh -c '
		file=$1; shift
		"$@"; result=$?
		printf "%s\n" "$result" >"$file"
	' sh "$states/result" "$@" || exit $?
	[ -f "$states/result" ] || exit 0
	IFS= read -r result <"$states/result" || exit 1
	exit "$result"
)
tui() (
	states=$(mktemp -d) || exit 1
	trap 'rm -rf -- "$states"' 0
	trap 'exit 1' HUP INT TERM
	mkdir "$states/areas" "$states/actions" || exit 1
	bold=$(printf '\033[1m') plain=$(printf '\033[0m')
	export SYS_PREVIEW
	current=
	while :; do
		printf 'Reading status...\n'
		if [ -z "$current" ]; then
			SYS_PREVIEW=$states/areas
			for area in $(printf '%s' "$areas" | cut -f 1); do
				(state "$area" >"$states/$area"; status_preview "$area" >"$states/status-$area") &
			done
			wait
			printf '%s' "$areas" | while IFS="$tab" read -r area title alias; do
				load "$area"
				# The state without the area name it often repeats ("Wi-Fi: -" under Wi-Fi).
				s=$(head -n 1 "$states/$area"); s=${s#"$title: "}; [ "$s" != "$title" ] || s=
				printf '%s\t%s%s\n' "$area" "$title" "${s:+: $s}"
				{
					printf '%s%s%s\n\n' "$bold" "$title" "$plain"
					status_text
					printf '\n%sActions%s\n' "$bold" "$plain"
					printf '%s\n' "$actions" | while IFS="$tab" read -r action label flags; do
						printf '\n%s\n  ' "$label"; command_line
					done
				} >"$SYS_PREVIEW/$area"
			done >"$states/list"
			menu Areas 'Enter open · Esc quit · Alt+Enter run typed' <"$states/list" || return 0
			if [ -n "$selected" ]; then current=$selected; continue; fi
		else
			load "$current"
			SYS_PREVIEW=$states/actions/$area
			mkdir -p "$SYS_PREVIEW" || exit 1
			(state "$area" >"$states/$area"; status_preview "$area" >"$states/status-$area") &
			wait
			printf '%s\n' "$actions" | while IFS="$tab" read -r action label flags; do
				printf '%s\t%s\n' "$action" "$label"
				{
					printf '%s%s%s\n\n' "$bold" "$label" "$plain"; command_line
					case " $flags " in *' root '*) echo 'Needs root (sudo)' ;; esac
					case " $flags " in *' confirm '*) echo 'Asks to confirm (default No)' ;; esac
					printf '\n%s%s%s\n\n' "$bold" "$title" "$plain"; status_text
				} >"$SYS_PREVIEW/$action"
			done >"$states/list"
			menu "$title" 'Enter run · Esc back · Alt+Enter run typed' <"$states/list" || { current=; continue; }
		fi
		[ -n "$selected$query" ] || continue
		clear
		# Ctrl+C stops the action, not the menu.
		trap : INT
		if [ -n "$selected" ]; then dispatch "$current" "$selected"; else typed_command; fi
		result=$?
		trap 'exit 1' INT
		pause "$result"
	done
)

case ${1:-} in
'') [ "$#" = 0 ] || usage
	if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then tui; else help; fi ;;
help) [ "$#" = 1 ] || usage; help ;;
--state) [ "$#" = 2 ] || usage; load "$2"; "${area}_state" ;;
--pick)
	case $# in
	1) pick_list ;;
	2)
		selection=$2
		area=${selection%% *}; action=${selection#* }
		[ "$selection" = "$area $action" ] || usage
		load "$area"; lookup "$action" || usage
		(export CONVERGENT_SYS_WAIT=1; run foot -T "$title: $label" -e sys "$area" "$action") ;;
	*) usage ;;
	esac ;;
*)
	[ "${CONVERGENT_SYS_WAIT:-}" != 1 ] || trap ':' INT
	dispatch "$@"; result=$?
	[ "${CONVERGENT_SYS_WAIT:-}" != 1 ] || pause "$result"
	exit "$result" ;;
esac
