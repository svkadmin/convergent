#!/bin/sh
# ARCHITECTURE 5.3, 8, 10, 12; accept only from a trusted release after reviewing changes.
set -u
. /usr/lib/convergent/guest-reply.sh
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077
state=/var/lib/convergent/check
out=/var/lib/node_exporter
list=/usr/lib/convergent/etc-state
work=
die() { logger -p user.err -t check "$*" 2>/dev/null || :; echo "check: $*" >&2; exit 1; }
bad() { ok=0; logger -p user.err -t check "$*" 2>/dev/null || :; printf 'FAIL %s\n' "$*" >>"$work/report"; }
# Lock fds closed: a shared SSH connection outlives this run and would keep them held.
# Firewall stderr lands in the audited report: bounded and filtered.
rsh() { guest_stderr timeout 30 ssh -F /etc/convergent/ssh_config "$@" 9>&- 8>&- 7>&-; }
# wan's wired role as devices wired attach sets it. Incus 7.0.1 matches hotplug uevents, which carry no
# serial, to no serial-pinned role: a replugged NIC stays off wan until the role is added again.
# Prints the serial when its one present NIC is authorized, allowed by USBGuard and has an interface off
# usbfs (wan's QEMU does not hold it); status 1 otherwise, 2 without such a role on a running wan.
wired_lost() (
    # 10 s: a late answer only defers the re-attach; 30 s with a firewall fault overran the minute run.
    serial=$(timeout -k 1 10 incus --force-local query '/1.0/instances/wan?project=default' 9>&- 8>&- 7>&- 2>/dev/null |
        jq -er 'select(.status == "Running") | .devices["wired-uplink"] |
            select(del(.serial) == {type: "usb", vendorid: "0bda", productid: "8153", required: "false"}) | .serial') || exit 2
    case $serial in ''|*[!A-Za-z0-9_.:-]*) exit 2 ;; esac
    found=0 lost=0
    for d in /sys/bus/usb/devices/*; do
        [ "$(cat "$d/idVendor" "$d/idProduct" "$d/serial" "$d/authorized" 2>/dev/null)" = "$(printf '0bda\n8153\n%s\n1' "$serial")" ] || continue
        found=$((found + 1))
        for i in "$d/${d##*/}":*; do [ ! -e "$i" ] || [ "$(basename "$(readlink "$i/driver")")" = usbfs ] || lost=1; done
    done
    [ "$found:$lost" = 1:1 ] && timeout -k 1 30 usbguard list-devices -a 9>&- 8>&- 7>&- 2>/dev/null | serial=$serial awk '
        $2 == "allow" && $3 == "id" && $4 == "0bda:8153" && index($0, " serial \"" ENVIRON["serial"] "\"") {n++}
        END {exit n != 1}' || exit 1
    echo "$serial"
)
# Minute self-heal: wired_lost in two runs in a row removes and re-adds that role under the guests
# lock, once per loss, three times an hour at most. wired-heal keeps the outcome for the scan.
wired_heal() (
    strike=/run/convergent/wired-strike outcome=/run/convergent/wired-heal
    ic() { timeout -k 1 120 incus --force-local --project default "$@" 9>&- 8>&- 7>&-; }
    heal_allowed || exit 0
    serial=$(wired_lost)
    case $? in 0) ;; 1) rm -f "$strike" "$outcome"; exit 0 ;; *) exit 0 ;; esac
    case $(cat "$outcome" 2>/dev/null) in
    '') ;;
    healed\ *) echo "lost $serial" >"$outcome"; echo 'SELF-HEAL wired uplink: wan lost the NIC again after a re-attach'; exit 0 ;;
    *) echo 'SELF-HEAL wired uplink: wan does not hold the NIC; no second re-attach'; exit 0 ;;
    esac
    read -r uptime rest </proc/uptime
    now=${uptime%.*} was= at=
    [ ! -f "$strike" ] || read -r was at <"$strike"
    case $at in ''|*[!0-9]*) at=0 ;; esac
    # A guest reconfiguring the NIC releases it for a moment: act on the second run in a row only.
    if [ "$was" != "$serial" ] || [ "$((now - at))" -gt 90 ]; then
        echo "$serial $now" >"$strike"
        echo 'SELF-HEAL wired uplink: wan does not hold the NIC; re-attaching next minute if that persists'
        exit 0
    fi
    # Reads above run unlocked (a frozen wan stalls them); the change is re-checked under the lock.
    exec 8>/run/convergent/guests.lock
    flock -n 8 && [ "$(wired_lost)" = "$serial" ] || exit 0
    rm -f "$strike"
    # As firewall-heal, three an hour: each add leaves a usb-host qdev behind. Past that the scan alerts.
    attempts=/run/convergent/wired-attempts
    [ -f "$attempts" ] || : >"$attempts"
    awk -v now="$now" '$1 > now-3600 {print}' "$attempts" >"$attempts.new" &&
        mv "$attempts.new" "$attempts" || exit 1
    if [ "$(wc -l <"$attempts")" -ge 3 ]; then
        echo "failed $serial" >"$outcome"
        logger -p user.err -t check 'wired uplink: three re-attaches in the last hour; no more' 2>/dev/null || :
        echo 'SELF-HEAL wired uplink: three re-attaches in the last hour; no more'
        exit 0
    fi
    echo "$now" >>"$attempts" || exit 1
    if ic config device remove wan wired-uplink &&
        ic config device add wan wired-uplink usb vendorid=0bda productid=8153 "serial=$serial" required=false; then
        echo "healed $serial" >"$outcome"
        logger -t check 'wired uplink: wan did not hold its NIC for two runs; role removed and added again' 2>/dev/null || :
        echo 'SELF-HEAL wired uplink: role removed and added again'
    else
        echo "failed $serial" >"$outcome"
        logger -p user.err -t check 'wired uplink: re-adding its role failed' 2>/dev/null || :
        echo 'SELF-HEAL wired uplink: re-adding its role failed'
    fi
)
[ "$(id -u)" = 0 ] || die 'run as root'
if awk '$2 == "/var" && $3 == "btrfs" && $4 ~ /(^|,)ro(,|$)/ {found=1}
    END {exit !found}' /proc/mounts; then
    die 'state disk lost or read-only: reboot'
fi
if [ "${1:-}:$#" = status:1 ]; then
    status=/run/convergent/status
    install -d -m 0755 /run/convergent "$status" || die 'cannot create status directory'
    # Locks stay 0600 (umask 077 above): a world-readable lock lets the owner flock it and stall the job.
    exec 9>"$status/lock"; flock -n 9 || exit 0
    # Wait out expiry's WAN probe; leave 25 seconds plus kill grace for collection.
    exec 8>/run/convergent/portal.lock
    exec 7>/run/convergent/guests.lock
    umask 022
    portal_locked=0
    # guests holds the portal lock through whole applies and rebuilds: never wait that out.
    if flock -s -n 7; then exec 7>&-; flock -w 30 8 && portal_locked=1
    else exec 7>&-; flock -n 8 && portal_locked=1; fi
    # Parallel guests, sequential sessions per guest: no cold ControlMaster race.
    (
        if instances=$(timeout -k 1 10 incus --force-local query '/1.0/instances?recursion=1&project=default' 9>&- 8>&- 2>/dev/null); then
            printf '%s\n' "$instances" | jq -er 'map(select(.status == "Running")) |
                [any(.[]; .name == "wan"), any(.[]; .name == "fw1"),
                 any(.[]; .name == "fw2"), any(.[]; .name == "svc"),
                 ([.[] | select(.type == "container") | select(.name |
                    test("^(def|int|tmp-(portal|[0-9]+))$"))] | length), any(.[]; .name == "remmina")] | @tsv' \
                >"$status/.running" || rm -f "$status/.running"
        else rm -f "$status/.running"; fi
    ) &
    for node in fw1 fw2; do
        (
            echo unknown >"$status/.portal-$node"
            cmd='ifconfig carp'
            if [ "$portal_locked" = 1 ]; then
                cmd="$cmd"'; if dns=$(pfctl -t portal_dns -T show) && lan=$(pfctl -t portal_lan -T show); then
                    if [ -n "$dns$lan" ]; then echo "portal on"; else echo "portal off"; fi
                    else echo "portal unknown"; fi'
            fi
            if carp=$(guest_reply 65536 timeout -k 1 10 ssh -F /etc/convergent/ssh_config "$node" "$cmd" 9>&- 8>&- 2>/dev/null); then
                # All registered CARP interfaces must agree.
                printf '%s\n' "$carp" | awk -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments - >"$status/.$node" || echo degraded >"$status/.$node"
                printf '%s\n' "$carp" | awk '$1 == "portal" {print $2}' >"$status/.portal-$node"
            else echo down >"$status/.$node"; fi
        ) &
    done
    (
        # Keep the old portal worker's 25-second budget across sequential WAN probes.
        read -r uptime rest </proc/uptime
        deadline=$((${uptime%.*} + 25))
        wan_probe() {
            read -r uptime rest </proc/uptime
            remaining=$((deadline - ${uptime%.*}))
            [ "$remaining" -gt 0 ] || return 1
            [ "$remaining" -le 10 ] || remaining=10
            timeout -k 1 "$remaining" ssh -F /etc/convergent/ssh_config wan "$@" 9>&- 8>&-
        }
        if diag=$(guest_reply 65536 wan_probe diag 2>/dev/null); then
            printf '%s\n' "$diag" | awk '
                /^== / {section=$2; next}
                section == "addresses" && $2 !~ /^(127\.|169\.254\.|0\.)/ {address[$1]=1}
                section == "routes" && $1 == "default" && $0 !~ /linkdown/ {
                    for (i=1;i<NF;i++) if ($i == "dev") route[++routes]=$(i+1)
                }
                section == "links" {
                    name=$2; sub(/:$/, "", name); sub(/@.*/, "", name)
                    if (name ~ /^wl/) wlan=1
                    else if (name != "eth0" && name ~ /^(eth|en)/) eth=1
                    if (/[<,]UP[,>]/ && /[<,]LOWER_UP[,>]/) link[name]=1
                }
                END {for (i=1;i<=routes;i++) {
                        name=route[i]
                        if (name != "eth0" && address[name] && link[name]) {up=1; dev=name; break}
                    }
                    # The uplink kind for the bar: a Wi-Fi radio or a passed-through wired NIC.
                    print up ? "up " (dev ~ /^wl/ ? "wlan" : "eth") : "nolink " (eth ? "eth" : wlan ? "wlan" : "-")}' >"$status/.wan"
        else echo nolink - >"$status/.wan"; fi
        if wifi=$(guest_reply 65536 wan_probe wifi status 2>/dev/null); then
            # Valid UTF-8 only: the bar's markup breaks on anything else.
            printf '%s\n' "$wifi" | iconv -c -f UTF-8 -t UTF-8 | awk '$1 == "Connected" && $2 == "network" {sub(/^ *Connected network */, ""); sub(/ *$/, ""); gsub(/[[:cntrl:]]/, ""); name=$0} END {print name == "" ? "-" : name}' >"$status/.wifi"
        else echo '?' >"$status/.wifi"; fi
        echo unknown >"$status/.portal-wan"
        if [ "$portal_locked" = 1 ] &&
            portal=$(guest_reply 128 wan_probe portal status 2>/dev/null); then
            printf '%s\n' "$portal" | awk '$1 == "on" || $1 == "off" {print $1}' >"$status/.portal-wan"
        fi
    ) &
    # What the guests hold, which the bar leaves out of the host's use: container cgroups without
    # their reclaimable file cache (the bar counts MemAvailable), and VM processes outside them.
    kib=0
    for f in /sys/fs/cgroup/lxc.payload.*/memory.current; do
        [ -r "$f" ] && read -r bytes <"$f" || continue
        cache=$(awk '$1 == "file" {file=$2} $1 == "shmem" {shmem=$2}
            END {printf "%.0f\n", file-shmem}' "${f%/*}/memory.stat" 2>/dev/null) || cache=0
        kib=$((kib + (bytes - ${cache:-0}) / 1024))
    done
    for pid in $(pgrep -x qemu-system-x86 2>/dev/null); do
        grep -q lxc.payload "/proc/$pid/cgroup" 2>/dev/null && continue
        rss=$(awk '$1 == "VmRSS:" {print $2}' "/proc/$pid/status" 2>/dev/null) && kib=$((kib + ${rss:-0}))
    done
    echo "$kib" >"$status/.guestmem"
    wait
    exec 8>&-
    awk '{n++; if ($0 == "on") on++; if ($0 == "off") off++}
        END {print n == 3 && on == 3 ? "on" : n == 3 && off == 3 ? "off" : "unknown"}' \
        "$status/.portal-fw1" "$status/.portal-fw2" "$status/.portal-wan" >"$status/.portal"
    # A failed inventory must age out, rather than publish false down states.
    if [ -s "$status/.running" ]; then
        read -r wan fw1 fw2 svc browsers remote <"$status/.running"
        if [ "$wan" = true ]; then
            read -r wan uplink <"$status/.wan"
        else wan=down uplink=-; fi
        if [ "$fw1" = true ]; then read -r fw1 <"$status/.fw1"; else fw1=down; fi
        if [ "$fw2" = true ]; then read -r fw2 <"$status/.fw2"; else fw2=down; fi
        # Remember only coherent pairs; a missed probe is not a takeover.
        master=
        case $fw1:$fw2 in master:backup) master=fw1 ;; backup:master) master=fw2 ;; esac
        if [ -n "$master" ]; then
            previous=$(cat "$status/firewall-master" 2>/dev/null) || previous=
            case $previous in fw1|fw2)
                [ "$previous" = "$master" ] ||
                    logger -t sys-firewall "observed takeover: $previous -> $master (all registered segments)" 2>/dev/null || : ;;
            esac
            printf '%s\n' "$master" >"$status/firewall-master"
        fi
        if [ "$svc" = true ]; then svc=up; else svc=down; fi
        if [ "$remote" = true ]; then remote=on; else remote=off; fi
        printf 'uplink=%s wan=%s fw1=%s fw2=%s svc=%s browsers=%s remote=%s\n' "$uplink" "$wan" "$fw1" "$fw2" "$svc" "$browsers" "$remote" >"$status/.topology"
        chmod 644 "$status/.topology" && mv "$status/.topology" "$status/topology" || exit 1
    fi
    if [ "$portal_locked" = 1 ]; then
        chmod 644 "$status/.portal" && mv "$status/.portal" "$status/portal" || exit 1
    fi
    chmod 644 "$status/.wifi" "$status/.guestmem" &&
        mv "$status/.wifi" "$status/wifi" &&
        mv "$status/.guestmem" "$status/guestmem"
    exit $?
fi
case ${1:-}:$# in :0|auto:1|accept:2|accept-fw:2) ;; *) die 'usage: check [auto|status] | accept <trusted-release-dir> | accept-fw <trusted-fw-image-dir>' ;; esac
# Remmina: a killed supervisor must not leave an unlocked orphan running.
if [ "${1:-}" = auto ]; then
    timeout -k 1 30 /usr/local/sbin/remote reap || logger -p user.warning -t remote 'orphan cleanup deferred or failed'
fi
# End Remmina.
net_ok=1
[ "${1:-}" != auto ] || sh /usr/lib/convergent/incus/host-net repair || net_ok=0
mkdir -p "$state" "$out" /run/convergent || die 'cannot create directories'
if [ "${1:-}" = auto ]; then (
    exec 7>/run/convergent/firewall-heal.lock
    flock -n 7 || exit 0
    . /usr/lib/convergent/incus/firewall-heal
    # Built on tmpfs: the audited reports are rewritten only when their content changes.
    firewall_heal >/run/convergent/.firewall-heal 2>&1 || echo 'SELF-HEAL failed: inspect syslog' >>/run/convergent/.firewall-heal
    wired_heal >>/run/convergent/.firewall-heal 2>&1 || echo 'SELF-HEAL wired uplink failed: inspect syslog' >>/run/convergent/.firewall-heal
    # A guest operation may have closed the gate on purpose: reconcile only while none holds the lock.
    exec 8>/run/convergent/guests.lock
    if flock -s -n 8; then
        sh /usr/lib/convergent/incus/work-gate 9>&- 8>&- 7>&- || echo 'SELF-HEAL work access closed: topology mismatch' >>/run/convergent/.firewall-heal
    else echo 'SELF-HEAL work access left as is: a guest operation is running' >>/run/convergent/.firewall-heal; fi
    exec 8>&-
    cmp -s /run/convergent/.firewall-heal "$state/firewall-heal" ||
        { cp /run/convergent/.firewall-heal "$state/.firewall-heal" && mv "$state/.firewall-heal" "$state/firewall-heal"; } ||
        die 'cannot publish self-heal report'
    exec 9>/run/convergent/check.lock
    flock -n 9 || exit 0
    if [ -f "$state/last" ]; then
        # Keep the full scan's timestamp: minute recovery must not postpone or stale its checks.
        sed '/^SELF-HEAL /d' "$state/last" >/run/convergent/.check-last &&
            cat "$state/firewall-heal" >>/run/convergent/.check-last && {
                cmp -s /run/convergent/.check-last "$state/last" || {
                    cp /run/convergent/.check-last "$state/.last" &&
                        touch -r "$state/last" "$state/.last" && mv "$state/.last" "$state/last"
                }
            } || {
                rm -f "$state/.last"
                die 'cannot update report'
            }
    fi
); fi
# Run before the daily scan throttle; cleanup takes the int session lock.
if [ "${1:-}" = auto ]; then
    /usr/local/sbin/incus-ui cleanup || logger -p user.err -t check 'Incus UI orphan cleanup failed'
fi
# After self-heal: a frozen QEMU holds each sweep, and its shared guests lock, for the full 30 s. Two sweeps
# first pushed the heal into the next minute's sweep, so every restart was refused by the guests lock.
if [ "${1:-}" = auto ]; then
    timeout -k 1 30 /usr/local/sbin/browser --reap-tmp || logger -p user.warning -t browser 'orphan cleanup deferred or failed'
fi
exec 9>/run/convergent/check.lock
flock -n 9 || die 'another checker is running'
if [ ! -e "$state/accepted" ] && [ -d "$state/previous" ]; then
    mv "$state/previous" "$state/accepted" || die 'cannot restore previous acceptance'
fi
exec 8>/run/convergent/guests.lock
case ${1:-} in accept|accept-fw) lock=-x ;; *) lock=-s ;; esac
flock "$lock" -n 8 || { [ "${1:-}" = auto ] && exit 0; die 'a guest operation is running'; }
if [ "${1:-}" = auto ] && [ -f "$state/last" ]; then
    last=$(stat -c %Y "$state/last")
    interval=300
    scan=$(sed -n 's/^Scan: //p' "$state/last")
    [ -n "$scan" ] && grep -qxF "# scan $scan" "$out/checker.prom" 2>/dev/null &&
        grep -qx 'cv_checker_success 1' "$out/checker.prom" 2>/dev/null && interval=86400
    boot=$(awk '$1 == "btime" {print $2}' /proc/stat)
    elapsed=$(($(date +%s) - last))
    if [ "$net_ok" = 1 ] && [ "$last" -ge "$boot" ] && [ "$elapsed" -ge 0 ] && [ "$elapsed" -lt "$interval" ] &&
        [ ! /var/lib/convergent/guests/updates -nt "$state/last" ] &&
        [ ! /var/lib/convergent/guests/initialized -nt "$state/last" ] &&
        [ ! /run/convergent/wired-heal -nt "$state/last" ]; then exit 0; fi
fi
work=$(mktemp -d "$state/.run.XXXXXX") || die 'cannot create scratch directory'
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
ok=1
scan=$(cat /proc/sys/kernel/random/uuid) || die 'cannot create scan identity'
date -u '+%FT%TZ' >"$work/report"
printf 'Scan: %s\n' "$scan" >>"$work/report"
# The management endpoint must never widen or replace the metrics listener.
address=$(timeout -k 1 30 incus --force-local config get core.https_address) &&
    [ "$address" = 100.80.1.10:8443 ] || bad 'Incus UI listener differs'
address=$(timeout -k 1 30 incus --force-local config get core.metrics_address) &&
    [ "$address" = 100.80.1.10:8444 ] || bad 'Incus metrics listener differs'
# A UI lock timeout is not a trust mismatch: retry the whole scan later.
/usr/local/sbin/incus-ui --audit 9>&- 8>&- 7>&-
case $? in
    0) ;;
    75) [ "${1:-}" = auto ] && exit 0; die 'an Incus UI operation is running' ;;
    *) bad 'Incus trust differs from metrics and unlocked int session' ;;
esac
[ ! -f "$state/firewall-heal" ] || cat "$state/firewall-heal" >>"$work/report"
[ "$net_ok" = 1 ] || bad 'host network repair failed (default route or sysctls)'

# The manifest is kept explicitly; never learn an accepted baseline during a check.
baseline=$state/accepted
manifest=$baseline/manifest
[ "${1:-}" != accept ] || manifest=$2/manifest
slot status >"$work/slot" 2>>"$work/report" || bad 'slot status failed'
release=$(cat /usr/lib/convergent/release)
version=$(cat /usr/lib/convergent/version 2>/dev/null) || version=
printf 'Release: %s (%s)\n' "${version:-$release}" "$release" >>"$work/report"
awk -v r="$release" '$1 == "booted" {b=($2 == r && $4 ~ /^[ab]$/); s=$4}
    $1 == "slot" {v[$2]=$3} END {exit !(b && v[s] == r)}' "$work/slot" || bad 'booted slot/release mismatch'
[ "$(awk '$1 == "release" {print $2}' "$manifest" 2>/dev/null)" = "$release" ] || bad 'manifest release mismatch or missing manifest'
root_hash=$(dmsetup table vroot 2>>"$work/report" | awk '$3 == "verity" {print $12}')
[ "$(uname -r)" = "$(awk '$1 == "kernel" {print $2}' "$manifest" 2>/dev/null)" ] || bad 'kernel differs from manifest'
[ -n "$root_hash" ] && [ "$root_hash" = "$(awk '$1 == "roothash" {print $2}' "$manifest" 2>/dev/null)" ] || bad 'verity root hash differs from manifest'
findmnt -nro FSTYPE,OPTIONS / | grep -Eq '^erofs ro(,|$)' || bad 'root is not read-only EROFS'
dmsetup status vroot 2>>"$work/report" | grep -Eq ' verity V$' || bad 'verity is not healthy'
[ "$(readlink -f "$(findmnt -nro SOURCE /)")" = "$(readlink -f /dev/mapper/vroot)" ] || bad 'root does not use vroot'
boot_slot=$(awk '$1 == "booted" {print $4}' "$work/slot")
partition=$(lsblk -dnro MAJ:MIN "/dev/disk/by-partlabel/cv-slot-$boot_slot" 2>>"$work/report")
dmsetup table vroot | awk -v p="$partition" 'END {exit !(p != "" && $5 == p && $6 == p)}' || bad 'verity does not use the booted slot partition'

# Track content, including non-executable desktop files and shell startup scripts.
autostart() {
    find /home -mindepth 1 -maxdepth 1 -type l -print >"$work/home.links" || return 1
    [ ! -s "$work/home.links" ] || return 1
    find /home \( -type f -o -type l \) \( -path '*/.config/autostart/*' -o -path '*/.config/systemd/user/*' \
        -o -path '*/.local/share/systemd/user/*' -o -path '*/.config/sway/*' -o -path '*/.local/bin/*' \
        -o -path '*/.sway/*' -o -path '*/.i3/*' -o -path '*/.config/i3/*' -o -path '*/.config/mako/*' \
        -o -path '*/.config/pipewire/*' -o -path '*/.config/wireplumber/*' \
        -o -path '*/.config/environment.d/*' -o -name .profile -o -name .shrc -o -name .bashrc \
        -o -name .bash_profile -o -name .bash_login -o -name .zshrc -o -name .zshenv -o -name .zprofile \
        -o -name .zlogin -o -path '*/.config/fish/*' -o -path '*/.config/autostart-scripts/*' \
        -o -path '*/.config/plasma-workspace/env/*' -o -path '*/.local/share/autostart/*' \
        -o -name .xprofile -o -name .xinitrc -o -path '*/.ssh/rc' \
        -o -name .config -o -name .local -o -name .ssh \
        -o -path '*/.config/autostart' -o -path '*/.config/systemd' -o -path '*/.config/systemd/user' \
        -o -path '*/.local/share' -o -path '*/.local/share/systemd' -o -path '*/.local/share/systemd/user' \
        -o -path '*/.config/sway' -o -path '*/.local/bin' -o -path '*/.config/environment.d' \
        -o -name .sway -o -name .i3 -o -path '*/.config/i3' -o -path '*/.config/mako' \
        -o -path '*/.config/pipewire' -o -path '*/.config/wireplumber' \
        -o -path '*/.config/fish' -o -path '*/.config/autostart-scripts' \
        -o -path '*/.config/plasma-workspace' -o -path '*/.config/plasma-workspace/env' \
        -o -path '*/.local/share/autostart' \) -exec sh -c '
            for file do
                [ ! -L "$file" ] || { echo "autostart symlink: $file" >&2; exit 1; }
                relative=${file#/home/}; relative=${relative#*/}
                case $relative in
                .sway/*|.i3/*|.config/sway/*|.config/i3/*)
                    # Includes must stay in scanned trees or the verified system config.
                    awk '\''
                        # Sway splits on every whitespace byte, not just blanks.
                        BEGIN { FS = "[[:space:]]+" }
                        { line = line $0 }
                        line !~ /^#/ && sub(/\\$/, "", line) { next }
                        {
                            $0 = line; line = ""
                            sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, "")
                            if ($0 ~ /^#/ || $0 == "") next
                            if (included && $0 == "{") exit 1
                            included = 0
                            if ($0 ~ /^\$/) exit 1
                            if (tolower($1) != "include") next
                            if (NF != 2) exit 1
                            path = $2
                            if (path ~ /^".*"$/ || path ~ /^\047.*\047$/)
                                path = substr(path, 2, length(path) - 2)
                            sub(/^(~\/(\.sway|\.i3|\.config\/(sway|i3))|\/etc\/sway)\//, "", path)
                            if (path !~ /^([A-Za-z0-9_*?][A-Za-z0-9_.*?-]*\/)*[A-Za-z0-9_*?][A-Za-z0-9_.*?-]*$/)
                                exit 1
                            included = 1
                        }
                        END { if (line != "") exit 1 }
                    '\'' "$file" || { echo "autostart unsafe include: $file" >&2; exit 1; } ;;
                esac
                pattern=
                case $relative in
                .config/sway/config.d/input)
                    pattern="input type:keyboard (xkb_layout \"[a-z]{2,5}(,[a-z]{2,5})*\"|xkb_variant \"[A-Za-z0-9_,-]*\")" ;;
                .config/sway/config.d/touchpad)
                    pattern="input type:touchpad (pointer_accel -?[01](\.[0-9]{1,3})?|scroll_factor [0-9]{1,2}(\.[0-9]{1,3})?|accel_profile (adaptive|flat)|(tap|natural_scroll|dwt|middle_emulation) (enabled|disabled)|scroll_method (none|two_finger|edge|on_button_down))" ;;
                .config/sway/config.d/outputs)
                    pattern="output [A-Za-z0-9_.][A-Za-z0-9_.-]* (disable|enable mode [1-9][0-9]{0,4}x[1-9][0-9]{0,4}(@[0-9]{1,3}(\.[0-9]{1,3})?(Hz)?)? scale [0-9](\.[0-9]{1,3})? position -?[0-9]{1,6} -?[0-9]{1,6} transform (normal|90|180|270|flipped|flipped-90|flipped-180|flipped-270))" ;;
                esac
                # Exempt sys settings only when every line is inert.
                if [ -n "$pattern" ]; then
                    awk "/^([[:blank:]]*(#.*)?|$pattern)$/ {next} {exit 1}" "$file" && continue
                fi
                sha256sum "$file" || exit 1
            done
        ' sh '{}' + >"$work/autostart.raw" && sort "$work/autostart.raw" >"$work/autostart"
}
suid() {
    find /home /var /tmp -xdev -type f -perm -4000 -printf '%m %U %G %p\n' >"$work/suid.raw" &&
        sort "$work/suid.raw" >"$work/suid"
}
autostart 2>>"$work/report" || bad 'autostart scan failed'
suid 2>>"$work/report" || bad 'SUID scan failed'
timeout -k 1 30 incus --force-local list --all-projects --fast --format json >"$work/instances" 2>>"$work/report" || bad 'Incus settings query failed'
timeout -k 1 30 incus --force-local query '/1.0/profiles/browser-tmp?project=default' >"$work/browser-tmp.raw" 2>>"$work/report" || bad 'browser-tmp profile query failed'
jq -eS 'select((.config | type) == "object" and (.devices | type) == "object") |
    {config, devices}' "$work/browser-tmp.raw" >"$work/browser-tmp" || bad 'browser-tmp profile unreadable'
timeout -k 1 30 incus --force-local query '/1.0/profiles/remmina?project=default' >"$work/remmina-profile.raw" 2>>"$work/report" || bad 'Remmina profile query failed'
jq -eS 'select((.config | type) == "object" and (.devices | type) == "object") |
    {config, devices}' "$work/remmina-profile.raw" >"$work/remmina-profile" || bad 'Remmina profile unreadable'
incus_limits() {
    jq -S 'map(if .name == "svc" and (.config["limits.memory"] == "350MiB" or .config["limits.memory"] == "768MiB")
        then .config["limits.memory"] = "350MiB" else . end) | sort_by(.name)' "$1"
}
jq -S 'map(select((.project // "default") == "default") | select(.name | test("^(fw1|fw2|wan|svc|def|int|remmina)$")) |
    {name, profiles, config: (.expanded_config | with_entries(select(.key | startswith("volatile.") | not))),
    devices: .expanded_devices})' "$work/instances" >"$work/incus.raw" || bad 'Incus settings unreadable'
incus_limits "$work/incus.raw" >"$work/incus" || bad 'Incus settings unreadable'
jq -e 'all(.[] | select((.project // "default") == "default" and .name == "svc");
    .expanded_config["limits.memory"] == "350MiB" or .expanded_config["limits.memory"] == "768MiB")' \
    "$work/instances" >/dev/null || bad 'svc memory limit differs'

if [ "${1:-}" = accept ]; then
    jq -e 'any(.[]; .name == "def") and any(.[]; .name == "int") and any(.[]; .name == "remmina" and .profiles == ["remmina"])' "$work/incus" >/dev/null ||
        die 'open and close def, int and Remmina, then retry acceptance'
    [ "$ok" = 1 ] || { cat "$work/report" >&2; die 'refusing acceptance: host verification failed'; }
    mkdir -p "$work/accepted/etc" "$work/accepted/fw" || die 'cannot prepare acceptance'
    cp "$manifest" "$work/accepted/manifest" || die 'cannot retain manifest'
    for node in fw1 fw2; do
        for kind in pf rules; do
            cp "$2/guests/fw/$node.$kind.sha256" "$work/accepted/fw/" || die "missing release hash: $node.$kind"
        done
    done
    while IFS= read -r entry; do
        case $entry in ''|'#'*) continue ;; esac
        cp -a --parents "/etc/$entry" "$work/accepted/" || die "cannot accept /etc/$entry"
    done <"$list"
    cp "$work/autostart" "$work/suid" "$work/incus" "$work/browser-tmp" "$work/remmina-profile" "$work/accepted/" || die 'cannot retain inventories'
    baseline=$work/accepted
fi
if [ "${1:-}" = accept-fw ]; then
    [ "$ok" = 1 ] || { cat "$work/report" >&2; die 'host verification failed'; }
    cp -a "$state/accepted" "$work/accepted" || die 'cannot stage acceptance'
    baseline=$work/accepted
    for node in fw1 fw2; do
        for kind in pf rules; do
            cp "$2/$node.$kind.sha256" "$baseline/fw/" || die "missing release hash: $node.$kind"
        done
    done
fi

# Keep diffs private: account databases can contain password hashes.
while IFS= read -r entry; do
    case $entry in ''|'#'*) continue ;; esac
    diff -ruN -- "$baseline/etc/$entry" "/etc/$entry" >>"$work/report" 2>&1 || bad "/etc/$entry differs from last acceptance"
    [ ! -L "/etc/$entry" ] || bad "/etc/$entry is a symlink"
    [ -e "$baseline/etc/$entry" ] && [ -e "/etc/$entry" ] || bad "missing /etc/$entry or accepted copy"
    [ "$(stat -c '%a:%u:%g:%F' "/etc/$entry")" = "$(stat -c '%a:%u:%g:%F' "$baseline/etc/$entry" 2>/dev/null)" ] || bad "/etc/$entry metadata changed"
done <"$list"
for inventory in autostart suid incus browser-tmp remmina-profile; do
    accepted=$baseline/$inventory
    if [ "$inventory" = incus ]; then
        accepted=$work/incus.accepted
        incus_limits "$baseline/incus" >"$accepted" 2>>"$work/report" || bad 'accepted Incus settings unreadable'
    fi
    diff -u "$accepted" "$work/$inventory" >>"$work/report" 2>&1 || bad "$inventory inventory changed or missing"
done
radio=$(jq -r '.[] | select((.project // "default") == "default" and .name == "wan") |
    .expanded_devices.radio.address // empty' "$work/instances")
if [ -n "$radio" ]; then
    [ "$(basename "$(readlink "/sys/bus/pci/devices/$radio/driver")")" = vfio-pci ] || bad 'wan radio is not owned by vfio-pci'
    [ "$(find "/sys/bus/pci/devices/$radio/iommu_group/devices" -mindepth 1 -maxdepth 1 | wc -l)" = 1 ] || bad 'wan radio does not have a private IOMMU group'
fi
# What wired_heal has not fixed: a loss it is not about to retry, or a role it could not add again.
pending=$(find /run/convergent/wired-strike -mmin -3 -exec cut -d ' ' -f 1 {} + 2>/dev/null)
if serial=$(wired_lost) && [ "$serial" != "$pending" ] || grep -qs '^failed ' /run/convergent/wired-heal; then
    bad 'wan wired uplink: the allowed NIC is not passed through; recovery: sys wired remove, then sys wired attach (reboot if Incus refuses it)'
fi

# facts boot also exports these; do not duplicate its metric series.
efi=/sys/firmware/efi/efivars
guid=8be4df61-93ca-11d2-aa0d-00e098032b8c
sb=$(od -An -tu1 -j4 -N1 "$efi/SecureBoot-$guid" 2>>"$work/report" | tr -d ' \n')
setup=$(od -An -tu1 -j4 -N1 "$efi/SetupMode-$guid" 2>>"$work/report" | tr -d ' \n')
[ "$sb:$setup" = 1:0 ] || bad 'Secure Boot disabled or unverifiable'
grep -q '\[confidentiality\]' /sys/kernel/security/lockdown 2>>"$work/report" || bad 'confidentiality lockdown absent'

timeout -k 1 30 guests status >"$work/guests" 2>>"$work/report" || bad 'guest inventory failed'
for node in fw1 fw2 wan svc; do
    grep -qx "$node running" "$work/guests" || bad "$node is not running"
done
jq -r '.[] | (.project // "default") as $p |
    "cv_guest_expected_running{project=\"\($p)\",name=\"\(.name)\"} \(if .expanded_config["boot.autostart"] == "true" then 1 else 0 end)"' "$work/instances" >>"$work/metrics" || bad 'guest metrics failed'
jq -e 'all(.[]; .expanded_config["boot.autostart"] != "true" or .status == "Running")' \
    "$work/instances" >/dev/null || bad 'an autostart guest is stopped'

# Match the exporter hash prefix exactly; compare the raw digest locally.
for node in fw1 fw2; do
    for kind in pf rules; do
        expected=$(cat "$baseline/fw/$node.$kind.sha256" 2>/dev/null) || expected=
        printf '%s\n' "$expected" | grep -Eq '^[0-9a-f]{64}$' || { bad "$node $kind release hash missing or malformed"; continue; }
        case $kind in pf) cmd='sha256 -q /etc/pf.conf' ;; rules) cmd="pfctl -sr | sed 's/__automatic_[0-9a-f_]*/__automatic/g' | sha256 -q" ;; esac
        actual=$(guest_reply 128 rsh "$node" "$cmd" 2>>"$work/report") || bad "$node $kind query failed"
        [ -n "$expected" ] && [ "$actual" = "$expected" ] || bad "$node $kind hash differs from release"
        if [ "$kind" = rules ]; then
            printf 'cv_firewall_ruleset_expected_info{firewall="%s",loaded="SHA256 (stdin) = %s"} 1\n' "$node" "$expected" >>"$work/metrics"
        fi
    done
    guest_reply 65536 rsh "$node" ifconfig >"$work/$node" 2>>"$work/report" || bad "$node CARP query failed; recovery: sys firewall rebuild $node"
    rsh "$node" 'pfctl -si' 2>>"$work/report" | grep -q '^Status: Enabled' || bad "$node pf is disabled"
done
role1=$(awk -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments "$work/fw1") || bad 'fw1 CARP membership or state invalid'
role2=$(awk -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments "$work/fw2") || bad 'fw2 CARP membership or state invalid'
case $role1:$role2 in master:backup|backup:master) ;; *) bad 'CARP pair lacks coherent complementary roles' ;; esac

if [ "$ok" = 1 ] && [ "$baseline" = "$work/accepted" ]; then
    rm -rf "$state/previous" && { [ ! -e "$state/accepted" ] || mv "$state/accepted" "$state/previous"; } &&
        mv "$baseline" "$state/accepted" || die 'cannot promote acceptance'
    logger -t check "accepted ${1} baselines for $release"
fi
printf '# scan %s\ncv_checker_success %s\ncv_checker_last_run_seconds %s\n' "$scan" "$ok" "$(date +%s)" >>"$work/metrics"
[ "$ok" != 1 ] || echo 'OK release, writable state, firewalls, guests and boot security' >>"$work/report"
mv "$work/report" "$state/last" || die 'cannot publish report'
tmp=$(mktemp "$out/.checker.XXXXXX") || die 'cannot create metric file'
cat "$work/metrics" >"$tmp" && chmod 644 "$tmp" && mv "$tmp" "$out/checker.prom" || { rm -f "$tmp"; die 'cannot publish metrics'; }
logger -t check "success=$ok; report: $state/last"
cat "$state/last"
[ "$ok" = 1 ]
