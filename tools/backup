#!/bin/sh
# ARCHITECTURE 7.4, 12; mounted LUKS external media, no new encryption package.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077
work= snapshot= state_root=
die() { echo "backup: $*" >&2; exit 1; }
ic() { incus --force-local --project "$project" "$@"; }
remove_snapshot() {
    [ ! -L "$1" ] && [ ! -L "$1/home" ] || return 1
    if [ -d "$1/home" ]; then
        if btrfs subvolume show "$1/home" >/dev/null 2>&1; then
            btrfs subvolume delete "$1/home" || return
        else
            rmdir "$1/home" || return
        fi
    fi
    rmdir "$1"
}
[ "$(id -u)" = 0 ] || die 'run as root'
if [ $# = 0 ]; then
    [ -t 0 ] || die 'run in a terminal or supply mountpoint and owner project'
    printf 'Mounted encrypted external disk: '; IFS= read -r dest
    printf 'Owner Incus project: '; IFS= read -r owner
    set -- "$dest" "$owner"
fi
[ $# = 2 ] || die 'usage: backup <LUKS-external-mountpoint> <owner-project>'
dest=$(cd "$1" && pwd -P) || die 'no destination directory'
[ "$(stat -c %u "$dest")" = 0 ] && [ -z "$(find "$dest" -maxdepth 0 -perm /022)" ] || die 'mountpoint must be root-owned and not writable by others'
owner=$2
case $owner in ''|default|*[!a-zA-Z0-9_-]*) die 'supply the separate owner project, not default' ;; esac
dev=$(findmnt -nro SOURCE --mountpoint "$dest") || die 'destination must be a mountpoint'
dev=${dev%%\[*}
case $dev in /dev/mapper/*|/dev/dm-*) ;; *) die 'destination is not a LUKS mapping' ;; esac
cryptsetup status "$dev" | grep -Eq 'type: *LUKS[12]$' || die 'destination must use LUKS'
lsblk -snro TRAN "$dev" | grep -qx usb || die 'destination must be on an external USB disk'
state=$(cryptsetup status cv-state | awk '$1 == "device:" {print $2}')
[ -b "$state" ] || die 'cannot identify the state disk'
for disk in $(lsblk -snrpo NAME,TYPE "$state" | awk '$2 == "disk" {print $1}'); do
    lsblk -snrpo NAME "$dev" | grep -qx "$disk" && die 'destination shares the state disk'
done
mkdir -p /run/convergent
exec 9>/run/convergent/backup.lock
flock -n 9 || die 'another backup is running'
exec 8>/run/convergent/guests.lock
flock -n 8 || die 'a guest operation is running'
# Browser sessions hold this shared; state volumes are not exported live.
exec 6>/run/convergent/browser-update.lock
flock -n 6 || die 'close the browsers first'
base=$dest/convergent-backups
[ ! -L "$base" ] || die 'backup directory is a symlink'
mkdir -p "$base"
[ "$(stat -c '%u:%a' "$base")" = 0:700 ] || die 'backup directory must be root-owned mode 700'
# Pruning goes by name: one laptop per disk. Unmarked generations predate the marker.
machine=$(cat /etc/machine-id) || die 'cannot read the machine id'
case $machine in ''|*[!0-9a-f]*) die 'invalid machine id' ;; esac
for marker in "$base"/backup-*/machine-id; do
    [ -e "$marker" ] || [ -L "$marker" ] || continue
    [ "$(cat "$marker")" = "$machine" ] || die "$base holds another laptop's backups; use another disk"
done
cleanup() {
    result=$?
    trap - 0
    trap '' HUP INT TERM
    if [ -n "$snapshot" ]; then remove_snapshot "$snapshot" || result=1; fi
    if [ -n "$state_root" ]; then
        if mountpoint -q "$state_root"; then umount "$state_root" || result=1; fi
        rmdir "$state_root" || result=1
    fi
    [ -z "$work" ] || rm -rf "$work" || result=1
    exit "$result"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
rm -rf "$base"/.partial.??????
work=$(mktemp -d "$base/.partial.XXXXXX")

# Snapshot home on the same Btrfs; archive writable /etc separately.
[ "$(findmnt -nro FSTYPE -T /home)" = btrfs ] &&
    [ "$(findmnt -nro UUID -T /home)" = "$(findmnt -nro UUID -T /var)" ] || die '/home and /var must share Btrfs'
btrfs subvolume list -o /home >"$work/subvolumes" || die 'cannot inspect /home subvolumes'
[ ! -s "$work/subvolumes" ] || die 'nested Btrfs subvolumes under /home are not backed up; refusing'
# Keep snapshots outside release generations, even after a power loss.
state_root=/run/convergent/backup-state
mkdir -p "$state_root"
mountpoint -q "$state_root" && umount "$state_root"
mount -t btrfs -o subvolid=5,noatime,nodev,nosuid,noexec /dev/mapper/cv-state "$state_root"
exec 7>/run/convergent-slot.lock
flock -n 7 || die 'a slot operation is running'
for old in "$state_root"/.backup.?????? "$state_root"/var-*/.backup.??????; do
    [ -e "$old" ] || [ -L "$old" ] || continue
    remove_snapshot "$old" || die "cannot remove abandoned snapshot $old"
done
exec 7>&-
snapshot=$(mktemp -d "$state_root/.backup.XXXXXX")
btrfs subvolume snapshot -r /home "$snapshot/home"
payload=$work/data
mkdir -p "$payload/projects"
printf '%s\n' "$machine" >"$payload/machine-id"
echo 'VM instances and custom block volumes are excluded; back them up separately while offline.' >"$payload/EXCLUDED"
tar --one-file-system --acls --xattrs --numeric-owner -C "$snapshot" -cpf "$payload/home.tar" home
grep -v '^#' /usr/lib/convergent/etc-state | sed '/^$/d;s|^|etc/|' >"$work/etc.list"
tar --one-file-system --acls --xattrs --numeric-owner -C / -cpf "$payload/etc.tar" -T "$work/etc.list"
rm "$work/etc.list"
# Keep Grafana's database paired with its host-held secrets.
mkdir "$payload/grafana-secrets"
for secret in admin-password secret-key; do
    source=/var/lib/convergent/guests/tls/$secret
    [ -s "$source" ] || die "missing Grafana secret: $secret"
    install -m 600 "$source" "$payload/grafana-secrets/$secret"
done
for project in default "$owner"; do
    mkdir "$payload/projects/$project"
    if [ "$project" = "$owner" ]; then
        ic profile list --format json >"$payload/projects/$project/profiles.json"
        ic list --format json >"$work/instances.json"
        jq -r '.[] | select(.type == "virtual-machine") | "instance " + .name' "$work/instances.json" >>"$payload/EXCLUDED"
        jq -r '.[] | select(.type == "container") | .name' "$work/instances.json" >"$work/instances"
        while IFS= read -r name; do
            ic export "$name" "$payload/projects/$project/instance-$name.tar.gz" --root-only --compression gzip
        done <"$work/instances"
        rm "$work/instances" "$work/instances.json"
    fi
    ic storage list --format csv -c n >"$work/pools"
    [ "$project" != default ] || grep -qx default "$work/pools" || die 'missing default storage pool'
    while IFS= read -r pool; do
        mkdir "$payload/projects/$project/$pool"
        ic storage volume list "$pool" --format json >"$work/volumes.json"
        jq -r '.[] | select(.type == "custom") | .name' "$work/volumes.json" >"$work/volumes"
        if [ "$project:$pool" = default:default ]; then
            for volume in svc-metrics svc-logs svc-grafana; do
                grep -qx "$volume" "$work/volumes" || die "missing required custom volume $volume"
            done
            for names in 'def web' 'int admin'; do
                set -- $names
                grep -qxE "browser-($1|$2)-state" "$work/volumes" || die "missing browser-$1-state or browser-$2-state"
            done
        fi
        while IFS= read -r volume; do
            case $volume in */*) continue ;; esac
            content=$(jq -er --arg n "$volume" '.[] | select(.type == "custom" and .name == $n) | .content_type' "$work/volumes.json")
            case $content in
            filesystem) suffix=tar.gz ;;
            iso) suffix=iso ;;
            block)
                # A live raw export has no stable point-in-time image.
                echo "volume $project/$pool/$volume" >>"$payload/EXCLUDED"
                continue ;;
            *) die "unknown content type for $project/$pool/$volume: $content" ;;
            esac
            # Shared storage is never exported while any attached instance can write.
            if [ "$pool:$volume" = default:share ]; then
                incus --force-local list --all-projects --fast --format json >"$work/share-users"
                jq -e 'all(.[];
                    if any(.expanded_devices[]?; .type == "disk" and .pool == "default" and .source == "share")
                    then .status == "Stopped" else true end)' "$work/share-users" >/dev/null ||
                    die 'stop every instance attached to share before backup'
            fi
            ic storage volume export "$pool" "$volume" "$payload/projects/$project/$pool/$volume.$suffix" --compression gzip
        done <"$work/volumes"
    done <"$work/pools"
    rm "$work/pools" "$work/volumes" "$work/volumes.json"
done

# Read every written byte back before publishing or pruning a generation.
(cd "$payload" && find . -type f ! -name SHA256SUMS -exec sha256sum '{}' + >SHA256SUMS)
sync
(cd "$payload" && sha256sum -c SHA256SUMS) || die 'backup readback differs'
find "$payload" -type f \( -name '*.tar' -o -name '*.tar.gz' \) >"$work/archives"
while IFS= read -r archive; do tar -xOf "$archive" >/dev/null || die "unreadable archive: $archive"; done <"$work/archives"
rm "$work/archives"
generation=$base/backup-$(date -u +%Y%m%dT%H%M%SZ)
[ ! -e "$generation" ] || die 'generation already exists'
mv "$payload" "$generation"
sync
# Three generations, following the existing guest-backup retention count in 7.2.
find "$base" -mindepth 1 -maxdepth 1 -type d -name 'backup-*' ! -name "${generation##*/}" | sort -r | sed '1,2d' >"$work/prune"
while IFS= read -r old; do rm -rf "$old"; done <"$work/prune"
rm "$work/prune"
sync
logger -t backup "readback verified: $generation; VM instances and custom block volumes excluded"
cat "$generation/EXCLUDED"
echo "backup: readback verified $generation (keep 3); unmount and close the external LUKS disk before unplugging"
