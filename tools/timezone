#!/bin/sh
# ARCHITECTURE 5.3; the owner's time zone: /etc/timezone names it, /etc/localtime is a copy of its zoneinfo.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022
stm= mounted=

die() { echo "timezone: $*" >&2; exit 1; }
usage() { echo 'usage: timezone set ZONE' >&2; exit 2; }
# The same rule as the initramfs (convergent-state.sh): a zone name under zoneinfo, never posix/ or right/, and a TZif file.
zone_valid() {
	printf '%s\n' "$1" | LC_ALL=C awk '{n++} n == 1 && /^[A-Za-z0-9_+-]+(\/[A-Za-z0-9_+-]+)*$/ && !/^(posix|right)\// && !/^(localtime|posixrules|Factory)$/ {ok = 1}
		END {exit !(ok && n == 1)}' &&
		[ ! -L "$2/$1" ] && [ -f "$2/$1" ] && LC_ALL=C awk '{ok = substr($0, 1, 4) == "TZif"; exit} END {exit !ok}' "$2/$1"
}
# A file left unbound by a failure gets the state copy back, new or old: boot binds the same.
cleanup() {
	result=$?
	trap - 0
	trap '' HUP INT TERM
	set +e
	if [ -n "$mounted" ]; then
		rm -f "$stm/etc/.localtime.new" "$stm/etc/.timezone.new"
		for f in localtime timezone; do
			mountpoint -q "/etc/$f" || mount --bind "$stm/etc/$f" "/etc/$f" || result=1
		done
		umount "$stm" || result=1
	fi
	[ -z "$stm" ] || rmdir "$stm" || result=1
	exit "$result"
}
case ${1:-}:$# in set:2) ;; *) usage ;; esac
[ "$(id -u)" = 0 ] || die 'run as root'
zone=$2
zone_valid "$zone" /usr/share/zoneinfo || die "not an installed time zone: $zone"
exec 9>/run/convergent-timezone.lock
flock -w 30 9 || die 'another time zone change is running'
trap cleanup 0
trap 'exit 1' HUP INT TERM

stm=$(mktemp -d /run/timezone.XXXXXX)
mount -t btrfs -o rw,subvolid=5,noatime,nodev,nosuid,noexec /dev/mapper/cv-state "$stm" ||
	die 'the state volume did not mount'
mounted=1
cp "/usr/share/zoneinfo/$zone" "$stm/etc/.localtime.new"
printf '%s\n' "$zone" >"$stm/etc/.timezone.new"
chmod 0644 "$stm/etc/.localtime.new" "$stm/etc/.timezone.new"
sync
# Either order is safe at boot, which copies localtime again from the zone in timezone.
mv -f "$stm/etc/.localtime.new" "$stm/etc/localtime"
mv -f "$stm/etc/.timezone.new" "$stm/etc/timezone"
sync
for f in localtime timezone; do
	umount -l "/etc/$f" || die "cannot unmount /etc/$f; the new zone applies at the next boot"
	mount --bind "$stm/etc/$f" "/etc/$f" || die "cannot rebind /etc/$f"
done
echo "timezone: $zone; programs started from now on use it"
