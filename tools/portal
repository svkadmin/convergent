#!/bin/sh
# ARCHITECTURE 3.2, 4.2, 9
# /run/convergent/portal: start epoch; 0 retries closure each minute.
set -u
. /usr/lib/convergent/guest-reply.sh
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

net=100.80
wan_addr=$net.0.10
portal_addr=$net.3.11
max=30
conf=/etc/convergent/ssh_config
run=/run/convergent
stamp=$run/portal
reason=$run/portal.reason

die() { logger -t portal "$*"; echo "portal: $*" >&2; exit 1; }
log() { logger -t portal "$*"; echo "portal: $*"; }
usage() { echo "usage: portal on [A.B.C.D/LEN] | begin | gateway | off [closed|interrupted] | status | expire" >&2; exit 2; }
[ "$(id -u)" = 0 ] || die "run as root"

# Expiry yields to an active sys action.
umask 077
mkdir -p "$run" || die "could not create $run"
exec 9>"$run/portal.lock"
if [ "${1:-}" = expire ]; then
	flock -n 9 || exit 0
else
	flock -w 60 9 || die "another portal is running"
fi

rsh() { _h=$1; shift; guest_stderr timeout 30 ssh -F "$conf" -n "$_h" "$@" 9>&- 8>&- 7>&- 6>&-; }
note() { printf '%s\n' "$*" >"$reason.new" && mv "$reason.new" "$reason"; }
browser_active() {
	mkdir -p "$run/browser"
	(exec 8>"$run/browser/tmp-portal.lock"; ! flock -n 8)
}

# Normalize an external IPv4 /8..30 network.
net_of() {
	case $1 in */*) ;; *) return 1 ;; esac
	_l=${1#*/}
	case $_l in '' | *[!0-9]*) return 1 ;; esac
	[ "$_l" -ge 8 ] && [ "$_l" -le 30 ] || return 1
	_n=$(
		IFS=.
		# shellcheck disable=SC2086
		set -- ${1%/*}
		[ $# -eq 4 ] || exit 1
		for o in "$@"; do
			case $o in '' | 0?* | *[!0-9]*) exit 1 ;; esac
			[ "$o" -le 255 ] || exit 1
		done
		_a=$(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 ))
		_a=$(( _a & ((0xFFFFFFFF << (32 - _l)) & 0xFFFFFFFF) ))
		# Refuse any overlap with the internal /16.
		_m=$_l; [ "$_m" -le 16 ] || _m=16
		[ $(( _a >> (32 - _m) )) != $(( ((${net%.*} << 24) + (${net#*.} << 16)) >> (32 - _m) )) ] || exit 1
		echo "$(( _a >> 24 )).$(( (_a >> 16) & 255 )).$(( (_a >> 8) & 255 )).$(( _a & 255 ))"
	) || return 1
	echo "$_n/$_l"
}

upstream_net() {
	_diag=$(guest_reply 65536 rsh wan diag 2>/dev/null) || return 1
	_route=$(printf '%s\n' "$_diag" | awk '
		/^== / {section=$2; next}
		section == "addresses" && $1 != "eth0" && $2 !~ /^(127\.|169\.254\.|0\.)/ {address[$1]=$2}
		section == "routes" && $1 == "default" && $0 !~ /linkdown/ {
			gateway=""; for (i=1;i<NF;i++) if ($i == "via") gateway=$(i+1)
			for (i=1;i<NF;i++) if ($i == "dev" && address[$(i+1)] != "") {print address[$(i+1)], gateway; exit}
		}')
	_a=${_route% *}
	case ${_a#*/} in 31 | 32) echo "portal: the uplink lease is a /${_a#*/} without a subnet; portal mode needs /8 to /30" >&2; return 1 ;; esac
	_upstream=$(net_of "$_a") || return 1
	if [ "${1:-}" = gateway ]; then
		_gateway=${_route#* }
		[ "$(net_of "$_gateway/${_a#*/}")" = "$_upstream" ] || return 1
		printf '%s\n' "$_gateway"
	else
		printf '%s\n' "$_upstream"
	fi
}

open_side() {
	case $1 in
	wan) rsh wan portal on >/dev/null ;;
	*) rsh "$1" "pfctl -t portal_dns -T replace $wan_addr && pfctl -t portal_lan -T replace $lan" >/dev/null ;;
	esac
}

# Flush tables and kill portal states in both directions.
close_side() {
	case $1 in
	wan) rsh wan portal off ;;
	*) rsh "$1" "rc=0; pfctl -t portal_dns -T flush || rc=1; pfctl -t portal_lan -T flush || rc=1; pfctl -k $portal_addr || rc=1; pfctl -k 0.0.0.0/0 -k $portal_addr || rc=1; exit \$rc" ;;
	esac
}

# Try every side; collect failures in bad.
close_all() {
	bad=
	for _s in fw1 fw2 wan; do
		close_side "$_s" >/dev/null || bad="$bad $_s"
	done
	[ -z "$bad" ]
}

off() {
	note "${1:-owner requested closure}" || die 'cannot record closure reason'
	echo 0 >"$stamp" || die 'cannot journal closure'
	if close_all; then
		rm -f "$stamp"
		log "portal mode off: fw1, fw2 and wan closed"
	else
		# Retry closure next minute.
		echo 0 >"$stamp"
		note "${1:-owner requested closure}; closure pending:$bad"
		die "portal mode NOT closed on:$bad; trying again every minute"
	fi
}

on() {
	# Always clean stale remote rules, even if the last host process lost its journal.
	off 'recovering previous session' || return
	if [ $# -ge 1 ]; then
		lan=$(net_of "$1") || die "not an IPv4 network of 8 to 30 bits outside $net.0.0/16: $1"
	else
		lan=$(upstream_net) || die "wan has no upstream address to take the network from; give it: portal on A.B.C.D/LEN"
	fi
	{ date +%s >"$stamp.new" && mv "$stamp.new" "$stamp"; } || die "could not write $stamp"
	note 'opening portal session'
	trap 'off "interrupted while opening"; exit 1' HUP INT TERM
	for _s in wan fw1 fw2; do
		if ! open_side "$_s"; then
			note "opening failed on $_s"
			logger -t portal "could not open portal mode on $_s; closing"
			close_all || :
			if [ -z "$bad" ]; then rm -f "$stamp"; else echo 0 >"$stamp"; fi
			die "could not open portal mode on $_s; everything closed again${bad:+ except:$bad (retrying every minute)}"
		fi
	done
	trap - HUP INT TERM
	note "active; expires after $max minutes or when the browser closes"
	log "portal mode on for $portal_addr toward $lan, for at most $max minutes"
}

# status_side SIDE: on or off, or fail.
status_side() {
	case $1 in
	wan) _r=$(guest_reply 128 rsh wan portal status) || return 1 ;;
	*) _r=$(guest_reply 128 rsh "$1" 'dns=$(pfctl -t portal_dns -T show) && lan=$(pfctl -t portal_lan -T show) &&
printf "dns %s lan %s\n" "$(printf "%s" "$dns" | wc -w)" "$(printf "%s" "$lan" | wc -w)"') || return 1 ;;
	esac
	case $1 in
	wan) printf '%s\n' "$_r" | awk '$1 == "on" || $1 == "off" { print; f = 1 } END { exit !f }' ;;
	*) printf '%s\n' "$_r" | awk '$1 == "dns" { print ($2 > 0 || $4 > 0) ? "on" : "off"; f = 1 } END { exit !f }' ;;
	esac
}

status() {
	expire
	n_on=0 n_off=0 n_bad=0
	for _s in wan fw1 fw2; do
		if _r=$(status_side "$_s" 2>/dev/null); then
			printf '%-4s %s\n' "$_s" "$_r"
			case $_r in on*) n_on=$((n_on + 1)) ;; *) n_off=$((n_off + 1)) ;; esac
		else
			printf '%-4s unreachable: status probe failed\n' "$_s"
			n_bad=$((n_bad + 1))
		fi
	done
	if [ "$n_bad" -gt 0 ]; then v=unknown
	elif [ "$n_on" = 3 ]; then v=on
	elif [ "$n_off" = 3 ]; then v=off
	else v=mixed; fi
	if [ "$n_on" -gt 0 ] && [ ! -e "$stamp" ]; then
		v=mixed
		note 'untracked rules remain; run sys portal off'
	fi
	echo "portal: $v"
	printf 'reason: %s\n' "$(cat "$reason" 2>/dev/null || echo 'no session this boot')"
	[ "$v" = on ] || [ "$v" = off ]
}

expire() {
	[ -e "$stamp" ] || return 0
	t=$(cat "$stamp" 2>/dev/null || :)
	case $t in '' | *[!0-9]*) t=0 ;; esac
	if [ "$t" = 0 ]; then
		why=$(cat "$reason" 2>/dev/null); why=${why%%; closure pending:*}
		off "${why:-interrupted session}"
	elif [ $(( $(date +%s) - t )) -ge $(( max * 60 )) ] || [ "$t" -gt "$(date +%s)" ]; then
		off 'timeout'
	elif [ $(( $(date +%s) - t )) -ge 60 ] && ! browser_active; then
		off 'interrupted session: browser no longer running'
	else
		case $(status_side wan 2>/dev/null) in
		on\ *) ;;
		*) off 'wan portal resolver lost or unreachable' ;;
		esac
	fi
	return 0
}

case ${1:-} in
on) shift; [ $# -le 1 ] || usage; browser_active && die 'portal browser already running'; on "$@" ;;
begin) [ $# = 1 ] || usage; browser_active || die 'begin requires the browser session lock'; on ;;
gateway) [ $# = 1 ] || usage; upstream_net gateway || die 'wan has no gateway in the uplink subnet' ;;
off)
	case $#:${2:-} in
	1:) off ;;
	2:closed) [ ! -e "$stamp" ] || off 'browser closed' ;;
	2:interrupted) [ ! -e "$stamp" ] || off 'browser interrupted or launch failed' ;;
	*) usage ;;
	esac ;;
status) [ $# = 1 ] || usage; status ;;
expire) [ $# = 1 ] || usage; expire ;;
*) usage ;;
esac
