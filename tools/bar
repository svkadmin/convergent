#!/bin/sh
# ARCHITECTURE 8, 9, 12
# swaybar status_command; slow probes never delay the clock.
set -u
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
. /usr/lib/convergent/theme

vmalert=http://100.80.2.10:8880
ps=/sys/class/power_supply
st=/run/convergent/status
uid=$(id -u)
# swayidle's timeout skips the lock while this file exists (sway config).
hold=$XDG_RUNTIME_DIR/nolock
work=$(mktemp -d "$XDG_RUNTIME_DIR/convergent-bar.XXXXXX") || exit 1
reader= alerts_pid= inputs_pid=
cleanup() {
	trap - 0
	for child in $reader $alerts_pid $inputs_pid; do kill "$child" 2>/dev/null || :; done
	for child in $reader $alerts_pid $inputs_pid; do wait "$child" 2>/dev/null || :; done
	rm -rf "$work"
}
trap cleanup 0
trap 'exit 0' HUP INT TERM

# An explicit descriptor keeps stdin available to the background reader.
exec 3<&0
(
	while IFS= read -r event; do
		case $event in *'{'*) ;; *) continue ;; esac
		name=$(printf '%s\n' "${event#,}" | jq -er 'select(.button == 1) | .name') || continue
		case $name in
		nolock) if [ -e "$hold" ]; then rm -f "$hold"; else : >"$hold"; fi ;;
		alerts) sys --pick 'security alerts' </dev/null >/dev/null 2>&1 & ;;
		esac
	done
) <&3 &
reader=$!
exec 3<&-

# The first battery, if any, and the external supplies: a charge limit reports "Not charging" on mains.
bat= mains=
for b in "$ps"/*; do
	[ -r "$b/type" ] && read -r ty <"$b/type" || continue
	case $ty in
	Battery) [ -n "$bat" ] || bat=$b ;;
	Mains | USB*) [ ! -r "$b/online" ] || mains="$mains $b/online" ;;
	esac
done
# The booted release cannot change during the session.
release='?'
read -r cmdline </proc/cmdline
for word in $cmdline; do
	case $word in convergent.release=*) release=${word#*=} ;; esac
done

version=$(cat /usr/lib/convergent/version 2>/dev/null) || version=
release=${version:-$release}

# Failed requests or unhealthy rules leave the count unknown.
poll_alerts() {
    alerts=$(curl -sf --connect-timeout 2 -m 4 "$vmalert/api/v1/alerts" "$vmalert/api/v1/rules?type=alert" |
        jq -ser 'select(length == 2 and all(.[]; .status == "success")) |
        select(.[0].data.alerts | type == "array") |
        select(.[1].data.groups | type == "array") |
        select(all(.[1].data.groups[].rules[]; .health == "ok")) |
        [.[0].data.alerts[] | select(.state == "firing") | .labels.severity] |
        "\(map(select(. == "critical")) | length) \(map(select(. == "warning")) | length) \(map(select(. != "critical" and . != "warning")) | length)"') ||
        alerts='?'
    printf '%s\n' "$alerts" >"$work/.alerts" && mv "$work/.alerts" "$work/alerts"
}

poll_inputs() {
	mic=$(timeout -k 1 2 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null) || mic=unknown
	case $mic in *'[MUTED]'*) mic=off ;; 'Volume: '*) mic=on ;; *) mic=unknown ;; esac
	printf '%s\n' "$mic" >"$work/.mic" && mv "$work/.mic" "$work/mic"
	timeout -k 1 2 ip -4 route show default 2>/dev/null |
		awk '{for (i=1;i<NF;i++) if ($i == "dev") {print $(i+1); exit}}' >"$work/.route"
	mv "$work/.route" "$work/route"
	# The layout's code (SK, GB), looked up by the name sway reports in xkeyboard-config's list.
	layout='?'
	if name=$(timeout -k 1 2 swaymsg -t get_inputs 2>/dev/null |
		jq -er '[.[] | select(.type == "keyboard")][0].xkb_active_layout_name | select(type == "string")'); then
		previous=
		[ ! -r "$work/layout-name" ] || IFS= read -r previous <"$work/layout-name"
		# Keep polling Sway; only the name-to-code lookup is cached.
		[ "$name" != "$previous" ] || return 0
		layout=$(awk -v n="$name" '$1 == "!" {s=$2; next}
			s == "layout" {c=$1; sub(/^ *[^ ]+ +/, ""); if ($0 == n) {print toupper(c); exit}}
			s == "variant" {sub(/^ *[^ ]+ +/, ""); i=index($0, ": "); if (i && substr($0, i+2) == n) {print toupper(substr($0, 1, i-1)); exit}}' \
			/usr/share/X11/xkb/rules/evdev.lst 2>/dev/null | grep .) || layout=$(printf '%.2s' "$name" | tr a-z A-Z)
	else
		name=
		rm -f "$work/layout-name"
	fi
	printf '%s\n' "$layout" >"$work/.layout" && mv "$work/.layout" "$work/layout" || {
		rm -f "$work/layout-name"; return 1;
	}
	[ -z "$name" ] || printf '%s\n' "$name" >"$work/layout-name"
}

printf '{"version":1,"click_events":true}\n[\n'
next_alerts=0 next_inputs=0 comma=
while :; do
	stamp=$(date '+%s %a %m/%d %H:%M:%S')
	now=${stamp%% *}
	if [ "$now" -ge "$next_alerts" ]; then
		if [ -z "$alerts_pid" ] || ! kill -0 "$alerts_pid" 2>/dev/null; then
			poll_alerts & alerts_pid=$!
			next_alerts=$((now + 30))
		fi
	fi
	if [ "$now" -ge "$next_inputs" ]; then
		if [ -z "$inputs_pid" ] || ! kill -0 "$inputs_pid" 2>/dev/null; then
			poll_inputs & inputs_pid=$!
			next_inputs=$((now + 5))
		fi
	fi
	nl=off
	[ ! -e "$hold" ] || nl=on
	pkill -0 -u "$uid" -x swayidle 2>/dev/null || nl=missing
	mtime=$(stat -c %Y "$st/topology" 2>/dev/null) || mtime=0
	memtime=$(stat -c %Y "$st/guestmem" 2>/dev/null) || memtime=0
	if [ -e /run/openrc/started/convergent-bless ]; then bl=good; else bl=UNBLESSED; fi
	# One formatter per frame; procfs/sysfs reads need no helper processes. UTF-8: the network
	# name is cut by characters.
	LC_ALL=C.UTF-8 awk -v work="$work" -v st="$st" -v bat="$bat" -v mains="$mains" -v now="$now" -v mtime="$mtime" \
		-v memtime="$memtime" \
		-v grey="$theme_dim" -v green="$theme_ok" -v red="$theme_crit" -v orange="$theme_warn" \
		-v master="$theme_master" -v backup="$theme_backup" -v fg="$theme_text" \
		-v clock="${stamp#* }" -v nl="$nl" -v bl="$bl" -v comma="$comma" -v rel="$release" '
	function get(path, value) {
		if ((getline value < path) <= 0) value=""
		close(path)
		return value
	}
	function json(s, out, i, c) {
		out="\""
		for (i=1;i<=length(s);i++) {
			c=substr(s,i,1)
			if (c == "\"" || c == "\\") out=out "\\" c
			else if (c in control) out=out control[c]
			else out=out c
		}
		return out "\""
	}
	function block(text, color, name, markup) {
		printf "%s{\"full_text\":%s", sep, json(text)
		printf ",\"color\":%s", json(color == "" ? fg : color)
		if (name != "") printf ",\"name\":%s", json(name)
		if (markup) printf ",\"markup\":\"pango\""
		printf "}"
		sep=","
	}
	function span(text, state, color) {
		gsub(/&/, "\\&amp;", text); gsub(/</, "\\&lt;", text); gsub(/>/, "\\&gt;", text)
		color=grey
		if (fresh) {
			if (state == "up") color=green
			else if (state == "master") {color=master; text="<b>" text "</b>"}
			else if (state == "backup") color=backup
			else if (state == "down") color=red
			else if (state == "nolink" || state == "degraded") color=orange
		}
		return "<span foreground=\"" color "\">" text "</span>"
	}
	BEGIN {
		for (i=1;i<32;i++) control[sprintf("%c",i)]=sprintf("\\u%04x",i)
		split(get(work "/previous"), prev, " ")
		split(get("/proc/stat"), cpu, " ")
		total=0; for (i=2;i<=8;i++) total+=cpu[i]
		idle=cpu[5]+cpu[6]; busy="-"
		if (prev[1] != "" && total>prev[1]) busy=sprintf("%.0f",100*(1-(idle-prev[2])/(total-prev[1])))
		lo=""; hi=""; package=prev[8]; hottest=prev[9]
		# Temperature reads can wake idle cores.
		refresh=prev[7] == "" || now<prev[7] || now-prev[7]>=5
		if (refresh) {package="-"; hottest="-"}
		for (i=1;i<ARGC;i++) {
			path=ARGV[i]
			if (!refresh && path !~ /scaling_cur_freq$/) continue
			value=get(path)
			if (value !~ /^[0-9]+$/) continue
			if (path ~ /scaling_cur_freq$/) {
				if (lo == "" || value+0<lo) lo=value+0
				if (hi == "" || value+0>hi) hi=value+0
			} else {
				if (hottest == "-" || value+0>hottest) hottest=value+0
				label=path; sub(/_input$/, "_label", label)
				dir=path; sub(/\/[^/]+$/, "", dir)
				# Read a chip name once per frame, even when it exposes many cores.
				if (!(dir in chip)) chip[dir]=get(dir "/name")
				if (chip[dir] == "coretemp" && get(label) == "Package id 0") package=value+0
			}
		}
		freq=lo == "" ? "-" : sprintf("%.1f-%.1f",lo/1000000,hi/1000000)
		if (refresh) {
			if (package != "-") package=sprintf("%.0f",package/1000)
			if (hottest != "-") hottest=sprintf("%.0f",hottest/1000)
		}
		printf "%s[", comma
		block("CPU " busy "% " freq "GHz " package "/" hottest "C", "")
		while ((getline line < "/proc/meminfo") > 0) {split(line,m," "); mem[m[1]]=m[2]}
		close("/proc/meminfo")
		# Include cache before subtracting guest cgroups and VM processes.
		used=mem["MemTotal:"]-mem["MemFree:"]; held=get(st "/guestmem")
		ram="?"
		if (memtime>0 && now>=memtime && now-memtime<=180 && held ~ /^[0-9]+$/)
			ram=sprintf("%.1f",(used>held+0 ? used-held : 0)/1048576)
		block(sprintf("RAM %s/%.0fG SWP %.1f/%.0fG",ram,
			mem["MemTotal:"]/1048576,(mem["SwapTotal:"]-mem["SwapFree:"])/1048576,mem["SwapTotal:"]/1048576), "")
		iface=get(work "/route"); tx=""; rx=""; rate="NET tx - rx - Mb/s"
		if (iface ~ /^[[:alnum:]_.:-]+$/) {
			tx=get("/sys/class/net/" iface "/statistics/tx_bytes")
			rx=get("/sys/class/net/" iface "/statistics/rx_bytes")
		}
		split(get("/proc/uptime"), uptime," "); elapsed=uptime[1]-prev[3]
		if (iface != "" && iface == prev[4] && elapsed>0 && tx ~ /^[0-9]+$/ && rx ~ /^[0-9]+$/ &&
			prev[5] ~ /^[0-9]+$/ && prev[6] ~ /^[0-9]+$/ && tx+0>=prev[5]+0 && rx+0>=prev[6]+0)
			rate=sprintf("NET tx %.1f rx %.1f Mb/s",(tx-prev[5])*8/elapsed/1000000,(rx-prev[6])*8/elapsed/1000000)
		block(rate, "")
		printf "%.0f %.0f %.2f %s %s %s %.0f %s %s\n",total,idle,uptime[1],iface == "" ? "-" : iface,
			tx == "" ? "-" : tx,rx == "" ? "-" : rx,refresh ? now : prev[7],package,hottest > (work "/previous")
		close(work "/previous")
		while ((getline line < "/proc/mounts") > 0) {
			split(line,m," ")
			if (m[2] == "/var" && m[3] == "btrfs" && m[4] ~ /(^|,)ro(,|$)/) state_ro=1
		}
		close("/proc/mounts")
		fresh=mtime>0 && now-mtime<=180 && !state_ro
		n=split(get(st "/topology"), fields," ")
		for (i=1;i<=n;i++) {split(fields[i],pair,"="); topo[pair[1]]=pair[2]}
		browsers=topo["browsers"] ~ /^[0-9]+$/ ? topo["browsers"] : "?"
		# The uplink first: a passed-through wired NIC, or the Wi-Fi network ("-" none, "?" no answer).
		if (topo["uplink"] == "eth") uplink=span("ETH",topo["wan"])
		else {
			ssid=get(st "/wifi"); if (ssid == "") ssid="?"
			if (length(ssid)>16) ssid=substr(ssid,1,14) ".."
			uplink=span("WLAN:" ssid,ssid == "?" ? "" : ssid == "-" ? "down" : "up")
		}
		block(uplink "--" span("WAN",topo["wan"]) "--[" span("FW1",topo["fw1"]) " " span("FW2",topo["fw2"]) "]--" \
			span(get("/proc/sys/kernel/hostname"),"up") "--" span("SVC",topo["svc"]) "--" \
			span("BR:" browsers,browsers != "?" && browsers+0>0 ? "up" : ""), grey, "", 1)
		block("rel " rel " " bl,bl == "good" ? grey : red)
		block(nl == "missing" ? "NL!" : "NL",nl == "missing" ? red : nl == "on" ? orange : grey,"nolock")
		mic=get(work "/mic")
		if (mic == "on") block("MIC", orange); else if (mic != "off") block("MIC?", grey)
		# Firing alerts: critical, warning, info.
		if (state_ro) block("state disk lost or read-only: reboot", red)
		else if (split(get(work "/alerts"),count," ") == 3)
			block("<span foreground=\"" red "\">" count[1] "</span> <span foreground=\"" orange "\">" count[2] "</span> " count[3], "", "alerts", 1)
		else block("? ? ?", grey, "alerts")
		portal=get(st "/portal")
		# Shown only while on; "unknown" before guests exist is not news.
		if (portal == "on") block("PORTAL", orange)
		camera=get("/var/lib/convergent/devices/camera")
		video=get("/sys/module/videodev/refcnt")
		if (camera == "on" || video != "") block(camera == "on" ? "CAM" : "CAM!", orange)
		# First boot of a disk image: guests being created (convergent-setup).
		setup=get(st "/setup")
		if (setup == "running") block("SETUP", orange); else if (setup == "failed") block("SETUP failed", red)
		guests=get(st "/guests-update")
		if (guests == "running") block("GUESTS", orange); else if (guests == "failed") block("GUESTS failed", red)
		layout=get(work "/layout"); block(layout == "" ? "?" : layout, "")
		days=int(uptime[1]/86400)
		block(sprintf("UP %s%02d:%02d",days ? days "d " : "",int(uptime[1]/3600)%24,int(uptime[1]/60)%60), "")
		block(clock, "")
		ac=0; n=split(mains, m, " "); for (i=1; i<=n; i++) if (get(m[i]) == "1") ac=1
		if (bat == "") block("AC", "")
		else {
			cap=get(bat "/capacity"); bs=get(bat "/status"); color=""; level=(cap == "" ? "-" : cap) "%"
			if (bs == "Charging") text="BAT " level " +"
			else if (bs == "Discharging") {
				text="BAT " level " -"
				if (cap ~ /^[0-9]+$/) color=cap+0<15 ? red : cap+0<30 ? orange : ""
			} else text=(ac || bs == "Full" ? "AC " : "") "BAT " level
			block(text, color)
		}
		printf "]\n"
		exit
	}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq /sys/class/hwmon/hwmon*/temp*_input || exit 1
	comma=,
	sleep 1
done
