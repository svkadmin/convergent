#!/bin/sh
# Runs in build/test's disposable host; fixtures are from 1631544^.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
release=/var/lib/convergent/test-release
state=/var/lib/convergent/guests
ic() { incus --force-local --project default "$@"; }
step=setup
trap 'r=$?; [ "$r" = 0 ] || echo "CV-BROWSER migration FAIL: $step"; exit "$r"' 0
trap 'exit 1' HUP INT TERM

for mode in normal interrupted detached renamed committed; do
	step="$mode old layout"
	for role in base tmp web admin portal; do
		case $role in base|tmp) ;; *) ic profile create "browser-$role" ;; esac
		ic profile edit "browser-$role" <"$release/browser-legacy/$role.yaml"
	done
	for role in def int; do ic profile delete "browser-$role"; done
	# New volumes came from guests init (or the preceding migration).
	# Keep backups: the fourth mode also tests pruning snapshots lost with these volumes.
	for role in def int; do ic storage volume delete default "browser-$role-state"; done
	for role in web admin; do
		case $role in web) size=4GiB ;; admin) size=512MiB ;; esac
		ic storage volume create default "browser-$role-state" size="$size" security.shifted=true
		ic init candidate-browser "$role" -p browser-base -p "browser-$role"
		# Seed through a temporary mount; current browser-setup rejects the old roles.
		ic storage volume attach default "browser-$role-state" svc migration /mnt/migration
		# shellcheck disable=SC2016 # $1 is the inner shell's
		ic exec svc -- sh -c 'printf "%s\n" "$1" >/mnt/migration/rename-marker' sh "$mode-$role"
		ic storage volume detach default "browser-$role-state" svc migration
	done
	step="$mode update"
	if [ "$mode" != normal ]; then
		faults=$mode
		# Reuse the committed transaction to stay within the VM test deadline.
		[ "$mode" != committed ] || faults='committed pruning'
		for fault in $faults; do
			step="$fault fault injection"
			# Each copy injects one fault; final recovery uses the installed command.
			awk -v mode="$fault" '
				{print}
				mode == "pruning" && $0 == "prune() {" {print "    return 1"}
				(mode == "interrupted" && $0 == "        mv \"$work/browser.rename\" \"$state/browser.rename\"") ||
				(mode == "detached" && $0 ~ /ic profile device remove "browser-\$role" state$/) ||
				(mode == "renamed" && $0 ~ /ic storage volume rename default "browser-\$old-state" "browser-\$new-state"$/) ||
				(mode == "committed" && $0 == "    cp \"$state/committed\" \"$work/committed\" || return") {
					print "    kill -KILL \"$$\""
				}
			' /usr/local/sbin/guests >"$release/guests-interrupt"
			grep -Eq '^    (kill -KILL "\$\$"|return 1)$' "$release/guests-interrupt"
			r=0
			sh "$release/guests-interrupt" update browser "$release/guests/browser" || r=$?
			step="$fault fault assertions"
			# Trace the assertions: a failure names its check on the console.
			set -x
			case $fault in pruning) [ "$r" = 1 ] ;; *) [ "$r" = 137 ] ;; esac
			for role in base def tmp int; do
				cmp "$release/guests/browser/incus/$role.yaml" "$state/browser.rename/$role.yaml"
			done
			if [ "$fault" = pruning ]; then
				[ ! -e "$state/profiles.before" ] && [ ! -e "$state/pending" ] && [ ! -e "$state/committed" ]
			else
				[ -f "$state/profiles.before/browser-web.yaml" ]
			fi
			case $fault in interrupted) first=web ;; *) first=def ;; esac
			case $fault in committed|pruning) second='int' ;; *) second='admin' ;; esac
			ic list --format json | jq -e --arg first "$first" --arg second "$second" 'any(.[]; .name == $first) and any(.[]; .name == $second)'
			case $fault in committed|pruning)
				[ -f "$state/browser.ready" ]
				for role in def int; do
					[ "$(ic profile device get "browser-$role" state source)" = "browser-$role-state" ]
				done
			;; esac
			set +x
			echo "CV-BROWSER migration fault: $fault"
		done
	fi
	step="$mode resume"
	sh -x /usr/local/sbin/guests update browser "$release/guests/browser" 2>"/var/log/guests-update-browser-$mode.log" || {
		tail -n 80 "/var/log/guests-update-browser-$mode.log" >&2
		exit 1
	}
	step="$mode assertions"
	for entry in web:def admin:int; do
		old=${entry%:*}; new=${entry#*:}
		incus --force-local query "/1.0/instances/$new?project=default" |
			jq -e --arg r "$new" '.type == "container" and .status == "Stopped" and .profiles == ["browser-base", "browser-" + $r]'
		[ "$(ic profile device get "browser-$new" state source)" = "browser-$new-state" ]
		[ "$(ic profile get "browser-$new" environment.BROWSER_ROLE)" = "$new" ]
		ic storage volume attach default "browser-$new-state" svc migration /mnt/migration
		[ "$(ic exec svc -- cat /mnt/migration/rename-marker)" = "$mode-$old" ]
		ic storage volume detach default "browser-$new-state" svc migration
	done
	ic list --format json | jq -e 'all(.[]; .name != "web" and .name != "admin" and .name != "portal")'
	ic storage volume list default --format json |
		jq -e 'all(.[]; .name != "browser-web-state" and .name != "browser-admin-state")'
	ic profile list --format json |
		jq -e 'all(.[]; .name != "browser-web" and .name != "browser-admin" and .name != "browser-portal")'
	for journal in browser.rename browser.ready profiles.before pending committed preparing; do [ ! -e "$state/$journal" ]; done
	echo "CV-BROWSER migration $mode ok"
	for role in def int; do
		ic config set "$role" security.protection.delete=false
		ic delete "$role"
	done
done
