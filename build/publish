#!/bin/sh
# publish: upload a signed release to <channel>/<release>/ in the R2 bucket, then point
# <channel>/latest-v2 and latest at it. Keeps two releases, under 9 GiB (R2's
# free tier is 10 GB). Only the five host files, guests.manifest and its signature go up,
# and the guest files it lists; the bucket is public.
#   CHANNEL=beta build/publish <release-dir>      override the build.conf default
set -eu
export LC_ALL=C
umask 077

here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"
cap=$((9 * 1024 * 1024 * 1024))
keep=2
die() { echo "publish: $*" >&2; exit 1; }
case $CHANNEL in '' | *[!a-z0-9-]*) die "invalid channel: $CHANNEL" ;; dev) die "dev is unpublished" ;; esac
pub=/etc/convergent/keys/$CHANNEL.pub
env=/etc/convergent/r2-$CHANNEL.env
[ "$(id -u)" = 0 ] || die "run as root"
[ $# = 1 ] || die "usage: build/publish <release-dir>"
dir=$1
release=$(awk '$1 == "release" { print $2 }' "$dir/manifest" 2>/dev/null) || :
case $release in '' | *[!0-9]* | 0?*) die "invalid release in $dir/manifest" ;; esac
[ "${#release}" -le 12 ] || die "invalid release in $dir/manifest"
files="slot.img convergent-$release-a.efi convergent-$release-b.efi manifest.sig manifest"
[ -f "$pub" ] || die "no public key $pub"
. "$here/release-check"
manifests=manifest
for manifest in guests.manifest remmina.manifest; do
	[ -f "$dir/$manifest" ] || continue
	manifests="$manifests $manifest"
	grep -qx "release $release" "$dir/$manifest" || die "$manifest is not for release $release"
	case $manifest in guests.manifest) kinds='fw|wan|svc|browser' ;; *) kinds=remmina ;; esac
	guest_files=$(awk -v kinds="$kinds" '$2 ~ /^guests\// {
		if (kinds == "remmina" && $2 !~ /^guests\/remmina\//) exit 1
		if ($2 !~ ("^guests/((" kinds ")/[A-Za-z0-9._-]+|browser/incus/[A-Za-z0-9._-]+\\.yaml)$") || $2 ~ /\/\.\.?$/) exit 1
		if (length($1) == 64 && $1 !~ /[^0-9a-fA-F]/) {if (seen[$2]++) exit 1; print $2}
	}' "$dir/$manifest") || die "invalid guest path in $manifest"
	files="$files $manifest.sig $manifest $guest_files"
done
for f in $files latest latest.sig; do
	[ -f "$dir/$f" ] && [ ! -L "$dir/$f" ] || die "missing $dir/$f"
done
for m in $manifests; do
	openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$dir/$m" -sigfile "$dir/$m.sig" >/dev/null ||
		die "$m is not signed with the $CHANNEL key"
	(cd "$dir" && grep -E '^[0-9a-f]{64}  ' "$m" | sha256sum -c --quiet -) || die "the release does not match its $m"
done
openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$dir/latest" -sigfile "$dir/latest.sig" >/dev/null &&
	grep -qx "release $release" "$dir/latest" || die "latest is not signed for release $release"
guests=none
[ ! -f "$dir/guests.manifest" ] || guests=$(sha256sum <"$dir/guests.manifest" | cut -d' ' -f1)
awk -v guests="$guests" '$1 == "guests" {n++; if (NF != 2 || $2 != guests) bad=1}
	END {exit bad || n != 1}' "$dir/latest" || die "latest does not match the guest bundle"

remmina=none
[ ! -f "$dir/remmina.manifest" ] || remmina=$(sha256sum <"$dir/remmina.manifest" | cut -d' ' -f1)
awk -v remmina="$remmina" '$1 == "remmina" {n++; if (NF != 2 || $2 != remmina) bad=1}
	END {exit bad || (n != 1 && !(n == 0 && remmina == "none"))}' "$dir/latest" || die 'latest does not match Remmina'

# Fresh advisory data, before any bucket mutation (including pruning).
"$here/advisories" --gate "$dir" || die "advisory gate failed"

[ -f "$env" ] || die "no $env"
. "$env"
ep=${R2_ENDPOINT:-https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com}/$R2_BUCKET
s3() {
	curl -q -sS --fail --proto =https --retry 3 --connect-timeout 15 --max-time 3600 --aws-sigv4 "aws:amz:auto:s3" -K - "$@" <<-EOF
	user = "$R2_ACCESS_KEY_ID:$R2_SECRET_ACCESS_KEY"
	EOF
}

# One publisher at a time: the totals and latest below must not go stale.
exec 9>/run/convergent-publish.lock
flock -n 9 || die "another publish is running"

# The bucket as "size key" lines (keys may hold spaces); one page covers what this keeps.
list=$(s3 "$ep?list-type=2&max-keys=1000") || die "cannot list the bucket"
case $list in *'<IsTruncated>true<'*) die "more than 1000 objects in the bucket" ;; esac
objects=$(printf '%s' "$list" | tr '<' '\n' | awk -F'>' '$1 == "Key" { k = substr($0, 5) } $1 == "Size" { print $2, k }')
total=$(printf '%s\n' "$objects" | awk '{ s += $1 } END { print s + 0 }')
new=0
for f in $files latest latest.sig latest latest.sig; do
	n=$(stat -c %s "$dir/$f")
	[ "$n" -lt $((5 * 1024 * 1024 * 1024)) ] || die "$f is over R2's 5 GiB single upload"
	new=$((new + n))
done
# Preserve both advertised releases if a legacy refresh was interrupted.
latest= legacy_latest= latest_path=latest-v2 latest_sig=
for pointer_name in latest latest-v2; do
	if cur=$(s3 "$ep/$CHANNEL/$pointer_name" 2>&1); then
		current=$(printf '%s\n' "$cur" | awk '$1 == "release" {if (NF != 2) exit 1; print $2}') || die 'malformed published latest'
		case $current in '' | *[!0-9]* | 0?*) die 'malformed published latest' ;; esac
		[ "${#current}" -le 12 ] || die 'malformed published latest'
		latest=$current latest_path=$pointer_name
		latest_sig=$pointer_name.sig
		if [ "$pointer_name" = latest ]; then legacy_latest=$current
		else latest_sig=latest-v2.$(printf '%s\n' "$cur" | sha256sum | cut -d' ' -f1).sig
		fi
		expr "$release" '>=' "$latest" >/dev/null || die "release $release is older than the published $latest"
	else
		case $cur in *'returned error: 404'*) ;; *) die "cannot read the published $pointer_name: $cur" ;; esac
	fi
done

publish_legacy() (
	check=$(mktemp) || die 'cannot create legacy check'
	trap 'rm -f "$check"' 0
	trap 'exit 1' HUP INT TERM
	# Each PUT is atomic; old readers reject a mismatched pair until retry.
	for f in latest.sig latest; do
		if s3 -o "$check" "$ep/$CHANNEL/$f" && cmp -s "$check" "$dir/$f"; then continue; fi
		s3 -o /dev/null -H 'Cache-Control: no-store' -T "$dir/$f" "$ep/$CHANNEL/$f" || die "could not update $f"
	done
)
keys_of() { printf '%s\n' "$objects" | awk -v p="$CHANNEL/$1/" '{ k = substr($0, index($0, " ") + 1) } index(k, p) == 1 { print k }'; }
if [ "$release" = "$latest" ]; then
	# An advertised prefix must survive a failed retry unchanged.
	want=$(for f in $files; do printf '%s/%s/%s\n' "$CHANNEL" "$release" "$f"; done | sort)
	[ "$(keys_of "$release" | grep -Ev '/advisories(\.json(\.sig)?|-v2\.json(\.[0-9a-f]{64}\.sig)?)$' | sort)" = "$want" ] || die "published file set differs; use a new release ID"
	check=$(mktemp) || die "cannot create retry check"
	trap 'rm -f "$check"' EXIT
	trap 'exit 1' HUP INT TERM
	for f in $files latest latest.sig; do
		case $f in latest) path=$CHANNEL/$latest_path ;; latest.sig) path=$CHANNEL/$latest_sig ;; *) path=$CHANNEL/$release/$f ;; esac
		s3 -o "$check" "$ep/$path" || die "cannot read published $f"
		cmp -s "$check" "$dir/$f" || die "published $f differs; use a new release ID"
	done
	publish_legacy
	echo "publish: $CHANNEL/$release is already latest and identical"
	exit 0
fi
size_of() { printf '%s\n' "$objects" | awk -v p="$CHANNEL/$1/" '{ k = substr($0, index($0, " ") + 1) } index(k, p) == 1 { s += $1 } END { print s + 0 }'; }
overwritten=$(printf '%s\n' "$objects" | awk -v p="$CHANNEL/$release/" -v files="$files" '
	BEGIN {n=split(files, f, /[[:space:]]+/); for (i=1;i<=n;i++) replace[p f[i]]=1}
	{ k = substr($0, index($0, " ") + 1); if (k in replace) s += $1 } END {print s + 0}')
total=$((total - overwritten))
olds=$(printf '%s\n' "$objects" | awk -v c="$CHANNEL/" -v r="$release" '
	{ k = substr($0, index($0, " ") + 1) }
	# Diagnostics are not releases, even under bucket pressure.
	index(k, c "debug/") == 1 || index(k, "debug-out/") == 1 {next}
	index(k, c) == 1 { split(substr(k, length(c) + 1), p, "/"); if (p[1] ~ /^[0-9]+$/ && p[1] != r) print p[1] }' | sort -u -n)
n=$(printf '%s\n' $olds | grep -c . || :)
# Oldest first, never the one latest points at.
for old in $olds; do
	[ "$n" -ge "$keep" ] || [ $((total + new)) -gt "$cap" ] || break
	[ "$old" != "$latest" ] && [ "$old" != "$legacy_latest" ] || continue
	keys_of "$old" | while IFS= read -r k; do
		s3 -X DELETE "$ep/$k" >/dev/null || die "cannot delete $k"
	done
	total=$((total - $(size_of "$old"))); n=$((n - 1))
	echo "publish: removed $CHANNEL/$old"
done
[ $((total + new)) -le "$cap" ] ||
	die "the bucket would hold $(((total + new) / 1048576)) MiB, over the $((cap / 1048576)) MiB cap"

for f in $files; do
	s3 -o /dev/null -T "$dir/$f" "$ep/$CHANNEL/$release/$f" || die "upload of $f failed"
	got=$(s3 -I "$ep/$CHANNEL/$release/$f" | tr -d '\r' | awk -F': ' 'tolower($1) == "content-length" { print $2 }')
	[ "$got" = "$(stat -c %s "$dir/$f")" ] || die "$f is $got bytes in the bucket"
done
# The document is the sole commit for digest readers.
digest=$(sha256sum <"$dir/latest" | cut -d' ' -f1)
s3 -o /dev/null -T "$dir/latest.sig" "$ep/$CHANNEL/latest-v2.$digest.sig" || die 'could not upload latest signature'
s3 -o /dev/null -H 'Cache-Control: no-store' -T "$dir/latest" "$ep/$CHANNEL/latest-v2" || die 'could not update latest'
publish_legacy
echo "publish: $CHANNEL/$release is latest; bucket $(((total + new) / 1048576)) MiB of $((cap / 1048576))"
