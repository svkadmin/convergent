#!/bin/sh
# Boot and privacy fixtures; no root, hardware or virtual machines.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap '[ -z "${holder:-}" ] || { kill "$holder" 2>/dev/null || :; wait "$holder" 2>/dev/null || :; }; rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-boot-privacy: $*" >&2; exit 1; }
check_script() { [ -s "$1" ] || die "empty extraction: $1"; sh -n "$1"; }

# Forwarding stays off until the final policy loads and PF answers enabled.
fw=$repo/guests/fw/site
awk -F= '$1 == "net.inet.ip.forwarding" {n++; if ($2 != 0) bad=1}
    END {exit (n != 1 || bad)}' "$fw/etc/sysctl.conf" || die 'early firewall forwarding'
# Apply the installation edit to the stock bootstrap rules; reject upstream drift.
sed -n '/^# Bootstrap SSH states/,/^# No CARP/p' "$fw/install.site" |
    sed '$d;s|/etc/rc|"$work/fw-rc"|g' >"$work/fw-edit"
check_script "$work/fw-edit"
cat >"$work/fw-stock" <<'FWRC'
RULES="
    block all
    pass on lo0
    pass in proto tcp from any to any port ssh keep state
    pass out proto { tcp, udp } from any to any port domain keep state"
printf '%s\n' "$RULES"
FWRC
check_script "$work/fw-stock"
for shape in stock missing duplicate changed; do
    cp "$work/fw-stock" "$work/fw-rc"
    case $shape in
    missing) sed '/port ssh/d' "$work/fw-stock" >"$work/fw-rc" ;;
    duplicate) cat "$work/fw-stock" >>"$work/fw-rc" ;;
    changed) sed 's/port ssh/port 22/' "$work/fw-stock" >"$work/fw-rc" ;;
    esac
    if sh -eu -c 'work=$1; die() { echo "$*" >&2; exit 1; }; . "$work/fw-edit"' sh "$work"; then
        [ "$shape" = stock ] || die "bootstrap edit accepted $shape"
        check_script "$work/fw-rc"
        sh "$work/fw-rc" >"$work/fw-patched-rules"
        sed '/port ssh/d' "$work/fw-stock" >"$work/fw-expected-rc"
        cmp "$work/fw-expected-rc" "$work/fw-rc"
    else
        [ "$shape" != stock ] || die 'bootstrap edit failed'
    fi
done
sh "$work/fw-stock" >"$work/fw-stock-rules"
# The build's logs do not ship in the firewall image: archives go, every other log stays, empty.
sed -n "/^# The build's logs/,/-exec sh -c 'for f do/p" "$fw/install.site" |
    sed "s|/var/log|$work/varlog|g" >"$work/fw-logs"
check_script "$work/fw-logs"
grep -q "$work/varlog" "$work/fw-logs" || die 'log cleanup not mapped'
mkdir -p "$work/varlog/nested"
echo 'dhcpleased[72886]: adding 10.0.2.15 to em0 (lease from 10.0.2.2)' >"$work/varlog/daemon"
echo old >"$work/varlog/messages.0.gz"
echo old >"$work/varlog/nested/xferlog.1"
echo header >"$work/varlog/pflog"
(rcctl() { [ "$*" = 'stop syslogd' ] || exit 97; touch "$work/syslogd-stopped"; }; . "$work/fw-logs")
[ -e "$work/syslogd-stopped" ] || die 'syslogd still writes during the log cleanup'
[ -f "$work/varlog/daemon" ] && [ ! -s "$work/varlog/daemon" ] && [ -f "$work/varlog/pflog" ] && [ ! -s "$work/varlog/pflog" ] ||
    die 'build logs ship in the firewall image'
[ ! -e "$work/varlog/messages.0.gz" ] && [ ! -e "$work/varlog/nested/xferlog.1" ] || die 'build log archives ship'
{ printf '. "%s/fw-mocks"\n' "$work"
    sed "s|/var/run/fw-pf-reload.lock|$work/reload.lock|" "$fw/usr/local/libexec/convergent/fw-pf-reload"
} >"$work/fw-reload"
check_script "$work/fw-reload"
grep -q "$work/reload.lock" "$work/fw-reload" || die 'reload lock not mapped'
sed -n "/^cat >\/etc\/rc.local <<'FIRSTBOOT'$/,/^FIRSTBOOT$/p" "$fw/install.site" |
    sed '1d;$d;s|/usr/local/libexec/convergent/fw-seed|fw_seed|;s|/usr/local/libexec/convergent/fw-pf-reload|sh "$work/fw-reload"|' >"$work/fw-boot"
check_script "$work/fw-boot"
cat >"$work/fw-mocks" <<'FWMOCKS'
pfctl() {
    case "$*" in
    '-f /etc/pf.conf')
        echo load >>"$work/fw-events"
        case $fault in
        killed) kill -KILL "$$" ;;
        hold)
            touch "$work/holding"
            attempts=0
            while [ ! -e "$work/release" ]; do
                attempts=$((attempts + 1))
                [ "$attempts" -le 10 ] || exit 96
                sleep 1
            done ;;
        esac
        [ "$fault" != load ] ;;
    -si)
        echo status >>"$work/fw-events"
        case $fault in
        disabled) echo 'Status: Disabled' ;;
        malformed) echo unknown ;;
        status) echo 'Status: Enabled'; return 1 ;;
        *) echo 'Status: Enabled for 0 days 00:00:01' ;;
        esac ;;
    -sr) echo 'block drop all' ;;
    *) exit 98 ;;
    esac
}
sysctl() {
    case "$*" in
    net.inet.ip.forwarding=0)
        echo 0 >"$work/fw-forwarding"
        echo off >>"$work/fw-events" ;;
    net.inet.ip.forwarding=1)
        [ "$(cat "$work/fw-events")" = "$(printf 'off\nload\nstatus')" ] || exit 97
        [ "$fault" != sysctl ] || return 1
        echo 1 >"$work/fw-forwarding"
        # Retransmitted forbidden SSH passes only if bootstrap state survived.
        [ "$state" = 0 ] || echo leak >>"$work/fw-events"
        echo forward >>"$work/fw-events" ;;
    '-n kern.version') echo fixture ;;
    *) exit 98 ;;
    esac
}
sha256() { echo fixture; }
syspatch() { [ "$*" = -l ]; }
fw_seed() { echo seed >>"$work/fw-events"; }
FWMOCKS
check_script "$work/fw-mocks"
cat >"$work/fw-run" <<'FWBOOT'
work=$1 fault=$2 mode=$3 rules=$4
# PF sees the incoming SYN before the forwarding check. Reloads retain its state.
state=0
if grep -q 'pass in proto tcp from any to any port ssh keep state' "$rules"; then state=1; fi
export work fault state
. "$work/fw-mocks"
case $mode in
boot) . "$work/fw-boot" ;;
reload) exec sh "$work/fw-reload" ;;
esac
FWBOOT
check_script "$work/fw-run"
# A live holder refuses overlap without touching forwarding; SIGKILL leaves a reusable lock file.
: >"$work/fw-events"
sh -eu "$work/fw-run" "$work" hold reload "$work/fw-patched-rules" >"$work/holder-log" 2>&1 &
holder=$!
attempts=0
while [ ! -e "$work/holding" ]; do
    attempts=$((attempts + 1))
    [ "$attempts" -le 10 ] || { cat "$work/holder-log"; die 'reload never held lock'; }
    sleep 1
done
cp "$work/fw-events" "$work/before-overlap"
if sh -eu "$work/fw-run" "$work" none reload "$work/fw-patched-rules" >"$work/overlap-log" 2>&1; then
    die 'overlapping reload accepted'
fi
grep -qx 'fw-pf-reload: another reload is running' "$work/overlap-log"
cmp "$work/before-overlap" "$work/fw-events"
touch "$work/release"
wait "$holder"
holder=
: >"$work/fw-events"
if sh -eu "$work/fw-run" "$work" killed reload "$work/fw-patched-rules" >"$work/killed-log" 2>&1; then
    die 'reload survived SIGKILL'
fi
[ "$(cat "$work/fw-forwarding")" = 0 ] || die 'killed reload left forwarding on'
[ -f "$work/reload.lock" ] || die 'missing persistent reload lock'
# The next successful reload must acquire the stale file without removing it.
for mode in boot reload; do
for fault in none load disabled malformed status sysctl; do
    : >"$work/fw-events"
    case $mode in boot) echo 0 ;; reload) echo 1 ;; esac >"$work/fw-forwarding"
    if sh -eu "$work/fw-run" "$work" "$fault" "$mode" "$work/fw-patched-rules" >"$work/fw-log" 2>&1; then
        [ "$fault" = none ] || die "forwarding accepted $fault"
        [ "$(cat "$work/fw-forwarding")" = 1 ]
        printf 'off\nload\nstatus\nforward\n' >"$work/fw-expected"
        [ "$mode" != boot ] || echo seed >>"$work/fw-expected"
        cmp "$work/fw-expected" "$work/fw-events"
    else
        [ "$fault" != none ] || { cat "$work/fw-log"; die 'firewall boot'; }
        [ "$(cat "$work/fw-forwarding")" = 0 ] || die "forwarding left on after $fault"
        if grep -qE '^(forward|seed)$' "$work/fw-events"; then die "forwarded after $fault"; fi
    fi
done
done
# Allow control: the unedited bootstrap rule leaks despite the forwarding gate.
: >"$work/fw-events"
echo 0 >"$work/fw-forwarding"
sh -eu "$work/fw-run" "$work" none boot "$work/fw-stock-rules" >"$work/fw-log" 2>&1
grep -qx leak "$work/fw-events" || die 'SYN state survival control failed'
echo 'test-boot-privacy: firewall forwarding passed'

# Exercise the shipped local-health counters without daemon timing or network probes.
sed -n '/^while :; do$/,/^[[:space:]]*# Reuse this round/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed '1d;$d' >"$work/wan-round"
check_script "$work/wan-round"
sed -n '/^[[:space:]]*# After a first loss/,/^done$/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed "1d;\$d; s|/var/run/convergent-power|$work/fw-power|" >"$work/wan-pace"
check_script "$work/wan-pace"
grep -q "$work/fw-power" "$work/wan-pace" || die 'wan-watch power path not replaced'
sed -n '/^[[:space:]]*# Reuse this round/,/^[[:space:]]*if \[ "\$want" != "\$owned" \]; then$/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed "1d;\$d; s|/var/node_exporter/textfile|$work/textfile|; s|/usr/local/libexec/convergent/wan-probe.awk|$fw/usr/local/libexec/convergent/wan-probe.awk|" >"$work/wan-publish"
check_script "$work/wan-publish"
grep -q "$work/textfile" "$work/wan-publish" || die 'wan-watch textfile path not replaced'
mkdir "$work/textfile"
(
    sysctl() {
        [ "$*" = '-n net.inet.ip.forwarding' ] || exit 98
        case $forward in error) echo 1; return 1 ;; *) printf '%s\n' "$forward" ;; esac
    }
    # Exact probes and bounds; ping runs in a command substitution, so a mismatch also leaves a mark.
    bad_probe() { printf '%s\n' "$*" >>"$work/wan-bad"; exit 97; }
    host() { [ "$*" = '-W 2 -t A svc.convergent.internal 127.0.0.1' ] || bad_probe host "$@"; [ "$dns" = up ]; }
    ping() { [ "$*" = "-q -n -I $src -c 3 -i 0.3 -w 1 $wan" ] || bad_probe ping "$@"; [ "$wan_up" = 1 ]; }
    timeout() {
        case "$*" in
        '-k 1 3 host '*) shift 3 ;;
        '-p -s INT 1 ping '*) shift 4 ;;
        *) bad_probe timeout "$@" ;;
        esac
        "$@"
    }
    sleep() { printf '%s\n' "$*" >>"$work/wan-sleeps"; }
    round() { . "$work/wan-round"; [ ! -e "$work/wan-bad" ] || exit 97; owned=$want; . "$work/wan-pace"; }
    src=100.80.0.11 wan=100.80.0.10 wan_up=1
    for failure in off empty malformed error dns; do
        owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1
        case $failure in
        off) forward=0 ;;
        empty) forward= ;;
        malformed) forward=unknown ;;
        error) forward=error ;;
        dns) dns=down ;;
        esac
        for n in 1 2 3 4 5 6 7 8 9; do
            round
            [ "$owned:$dns_lost:$good" = "0:$n:0" ] || die "early local demotion: $failure/$n"
        done
        round
        [ "$owned:$dns_lost" = 128:10 ] || die "missing local demotion: $failure"
        forward=1 dns=up
        for n in 1 2; do
            round
            [ "$owned:$dns_lost:$good" = "128:0:$n" ] || die "early local recovery: $failure/$n"
        done
        round
        [ "$owned:$good" = 0:3 ] || die "missing local recovery: $failure"
    done
    # Short reloads reset the local failure streak without demotion.
    for n in 1 2 3 4 5 6 7 8 9; do forward=0; round; [ "$owned" = 0 ]; done
    forward=1; round
    [ "$owned:$dns_lost" = 0:0 ]
    forward=0; round
    [ "$owned:$dns_lost" = 0:1 ]
    # A local failure right after one lost WAN round must not skip the pacing sleep.
    forward=1; wan_up=0; round; [ "$lost" = 1 ]
    forward=0; round; [ "$lost" = 0 ]
    # Pacing: a good round sleeps out the rest of its second (0.6 s of probes), a first loss
    # re-probes at once, a second loss and a local failure wait a second.
    : >"$work/wan-sleeps"
    owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1 wan_up=1
    round; round
    wan_up=0; round; round
    forward=0; round
    printf '0.4\n0.4\n1\n1\n' | cmp - "$work/wan-sleeps" || die 'wan-watch rounds are not paced'
    # On battery good rounds start every 5 s, demoting after the same two losses; demoted, every second until
    # recovered; local failures keep 1 s.
    now=1000000
    : >"$work/wan-sleeps"
    echo battery 999400 >"$work/fw-power"
    owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1 wan_up=1
    round; round
    wan_up=0; round; [ "$owned" = 0 ]; round; [ "$owned" = 128 ] || die 'battery pace changed the two-loss rule'
    forward=0; round
    forward=1 wan_up=1; round; round; round; [ "$owned" = 0 ] || die 'battery pace changed the recovery rule'
    printf '4.4\n4.4\n1\n1\n0.4\n0.4\n4.4\n' | cmp - "$work/wan-sleeps" || die 'wan-watch battery rounds are not paced'
    # Any other word, no time, a word over 10 minutes old or from the future is AC.
    for word in 'batteryx 1000000' battery 'battery 999399' 'battery 1000001' 'battery 0999999'; do
        : >"$work/wan-sleeps"
        printf '%s\n' "$word" >"$work/fw-power"
        owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1 wan_up=1
        round
        printf '0.4\n' | cmp - "$work/wan-sleeps" || die "wan-watch paced as battery: $word"
    done
    rm "$work/fw-power"
    # A round without a probe publishes a local fault, never a failed transit probe.
    prom=$work/textfile/wan-watch.prom
    for c in local:0:- lost:1:0 up:1:1; do
        owned=0 good=0 lost=0 dns_lost=0 dns=up forward=1 wan_up=1 metrics_at=0
        case ${c%%:*} in local) forward=0 ;; lost) wan_up=0 ;; esac
        . "$work/wan-round"; [ ! -e "$work/wan-bad" ] || exit 97; . "$work/wan-publish"
        grep -qx "convergent_wan_watch_local_ok $(echo "$c" | cut -d: -f2)" "$prom" || die "local_ok: $c"
        up=${c##*:}
        if [ "$up" = - ]; then
            if grep -q '^convergent_wan_watch_probe_up' "$prom"; then die "probe_up without a probe: $c"; fi
        else grep -qx "convergent_wan_watch_probe_up $up" "$prom" || die "probe_up: $c"; fi
        grep -q '^convergent_wan_watch_probe_timestamp_seconds [0-9]' "$prom" || die "probe timestamp: $c"
    done
    # A backward clock step leaves the last publication in the future: publish at once, not an hour later.
    for ahead in 30 3600; do
        rm -f "$prom"
        owned=0 good=0 lost=0 dns_lost=0 dns=up forward=1 wan_up=1 metrics_at=$(($(date +%s) + ahead))
        . "$work/wan-round"; [ ! -e "$work/wan-bad" ] || exit 97; . "$work/wan-publish"
        [ -f "$prom" ] || die "no publication after a backward step: $ahead"
        [ "$metrics_at" -le "$(date +%s)" ] || die "future metrics time kept: $ahead"
    done
)
echo 'test-boot-privacy: firewall local health passed'

# Capture the feeder's actual fd 3 writes, including TERM's magic close.
(
    . "$repo/rootfs/etc/init.d/convergent-watchdog"
    printf '%s\n' "$loop" >"$work/loop"
    check_script "$work/loop"
    # A separate shell gives the TERM fixture its own PID.
    cat >"$work/feeder" <<'EOF'
set -u
work=$1 mode=$2
logger() { printf '%s\n' "$*" >"$work/logger"; }
sleep() {
    printf '%s\n' "$*" >>"$work/sleeps"
    [ "$mode" != term ] || kill -TERM "$$"
}
. "$work/loop"
EOF
    check_script "$work/feeder"
    : >"$work/sleeps"
    sh "$work/feeder" "$work" expire 3>"$work/feeds"
    [ "$(cat "$work/feeds")" = '....................' ]
    [ "$(grep -cx 30 "$work/sleeps")" = 20 ]
    [ "$(wc -l <"$work/sleeps")" -eq 20 ]
    grep -q 'no bless within ten minutes' "$work/logger"
    rm "$work/logger"
    : >"$work/sleeps"
    sh "$work/feeder" "$work" term 3>"$work/feeds"
    [ "$(cat "$work/feeds")" = '.V' ]
    [ "$(cat "$work/sleeps")" = 30 ]
    [ ! -e "$work/logger" ]

    # Only the device probe and daemon command are mocked for stop.
    sed -n '/^stop() {/,/^}/p' "$repo/rootfs/etc/init.d/convergent-watchdog" |
        sed -e "s|/dev/watchdog|$work/watchdog|g" -e 's/\[ ! -c /[ ! -f /' \
            -e "s|/sys/class/watchdog/|$work/sys-watchdog/|g" -e 's/start-stop-daemon/mock_daemon/' >"$work/stop"
    check_script "$work/stop"
    grep -q "$work/sys-watchdog/watchdog0/nowayout" "$work/stop" || die 'watchdog nowayout read moved'
    . "$work/stop"
    mkdir -p "$work/sys-watchdog/watchdog0"
    echo active >"$work/sys-watchdog/watchdog0/state"; echo 0 >"$work/sys-watchdog/watchdog0/nowayout"
    mock_daemon() {
        printf '%s\n' "$*" >"$work/daemon"
        [ "$daemon_status" = 0 ] || echo 'start-stop-daemon: no matching processes found' >&2
        return "$daemon_status"
    }
    pidfile=$work/exited.pid
    for daemon_status in 0 1; do
        : >"$work/watchdog"
        stop 2>"$work/stop.err"
        [ "$(cat "$work/watchdog")" = V ]
        [ "$(cat "$work/daemon")" = "--stop --quiet --retry TERM/5 --pidfile $pidfile" ]
        # bless disarms an exited feeder without a message on the owner's terminal.
        [ ! -s "$work/stop.err" ]
    done
    # No V for an idle one (opening it starts it) nor under nowayout (ignored, and it stays running).
    for device in inactive:0 active:1 active:; do
        echo "${device%:*}" >"$work/sys-watchdog/watchdog0/state"
        echo "${device#*:}" >"$work/sys-watchdog/watchdog0/nowayout"
        [ -n "${device#*:}" ] || rm "$work/sys-watchdog/watchdog0/nowayout"
        : >"$work/watchdog"
        daemon_status=1
        stop 2>/dev/null || die "watchdog stop failed: $device"
        [ ! -s "$work/watchdog" ] || die "watchdog closed on stop: $device"
    done
    echo 0 >"$work/sys-watchdog/watchdog0/nowayout"

    # A start after bless (an owner's restart) must not arm a reset on a good release.
    sed -n '/^start() {/,/^}/p' "$repo/rootfs/etc/init.d/convergent-watchdog" |
        sed -e "s|/run/openrc|$work/openrc|g" -e "s|/dev/watchdog|$work/watchdog|g" -e 's/\[ ! -c /[ ! -f /' \
            -e "s|/sys/class/watchdog/|$work/sys-watchdog/|g" -e "s|/proc/cmdline|$work/cmdline|g" >"$work/start"
    check_script "$work/start"
    grep -q "$work/sys-watchdog/watchdog0/identity" "$work/start" || die 'watchdog identity read moved'
    grep -q "$work/cmdline" "$work/start" || die 'watchdog command line read moved'
    echo 'root=/dev/dm-0 convergent.release=42 init=/sbin/init' >"$work/cmdline"
    . "$work/start"
    ebegin() { :; }; eend() { :; }; einfo() { :; }; ewarn() { exit 97; }; logger() { exit 97; }
    nohup() { echo feeder >>"$work/fed"; }
    pidfile=$work/feeder.pid
    mkdir -p "$work/openrc/started" "$work/sys-watchdog/watchdog0"
    echo iTCO_wdt >"$work/sys-watchdog/watchdog0/identity"; echo 180 >"$work/sys-watchdog/watchdog0/timeout"
    for blessed in no yes; do
        rm -f "$work/fed" "$work/openrc/started/convergent-bless"
        [ "$blessed" = no ] || : >"$work/openrc/started/convergent-bless"
        : >"$work/watchdog"
        start
        wait
        if [ "$blessed" = yes ]; then [ ! -e "$work/fed" ] || die 'watchdog armed after bless'
        else grep -qx feeder "$work/fed" || die 'watchdog not fed before bless'; fi
    done
    # The install image never blesses: no feeder and no V, whatever the device; a look-alike flag still arms.
    rm -f "$work/openrc/started/convergent-bless"
    for flag in convergent.install=1 convergent.install=0 xconvergent.install=1 convergent.install.console=ttyS0; do
        echo "root=/dev/dm-0 $flag init=/sbin/init" >"$work/cmdline"
        rm -f "$work/fed"
        : >"$work/watchdog"
        start
        wait
        case $flag in
        convergent.install=1) [ ! -e "$work/fed" ] && [ ! -s "$work/watchdog" ] || die 'watchdog armed on the install image' ;;
        *) grep -qx feeder "$work/fed" || die "watchdog not fed with $flag" ;;
        esac
    done
    echo 'root=/dev/dm-0 convergent.release=42 init=/sbin/init' >"$work/cmdline"
    # 30 s feeds only for iTCO at 180 s: a WDAT watchdog (30 s) or an iTCO left at its 30 s default is
    # closed with the magic V instead, never fed into a reset.
    rm -f "$work/openrc/started/convergent-bless"
    for device in wdat_wdt:30 iTCO_wdt:30 iTCO_wdt:x :; do
        printf '%s\n' "${device%:*}" >"$work/sys-watchdog/watchdog0/identity"
        printf '%s\n' "${device#*:}" >"$work/sys-watchdog/watchdog0/timeout"
        [ -n "${device%:*}" ] || rm "$work/sys-watchdog/watchdog0/identity" "$work/sys-watchdog/watchdog0/timeout"
        echo active >"$work/sys-watchdog/watchdog0/state"
        rm -f "$work/fed" "$work/logger"
        : >"$work/watchdog"
        (
            ewarn() { :; }; logger() { printf '%s\n' "$*" >"$work/logger"; }
            start
        )
        [ ! -e "$work/fed" ] && [ "$(cat "$work/watchdog")" = V ] || die "watchdog fed: $device"
        grep -q 'continuing without a watchdog' "$work/logger" || die "watchdog refusal not logged: $device"
    done
    # An idle one stays closed: opening it would start it.
    printf 'wdat_wdt\n' >"$work/sys-watchdog/watchdog0/identity"; echo 30 >"$work/sys-watchdog/watchdog0/timeout"
    echo inactive >"$work/sys-watchdog/watchdog0/state"
    rm -f "$work/fed" "$work/logger"
    : >"$work/watchdog"
    ( ewarn() { :; }; logger() { :; }; start )
    [ ! -e "$work/fed" ] && [ ! -s "$work/watchdog" ] || die 'idle watchdog opened'
    # Nor one under nowayout: the V is ignored.
    echo active >"$work/sys-watchdog/watchdog0/state"; echo 1 >"$work/sys-watchdog/watchdog0/nowayout"
    : >"$work/watchdog"
    ( ewarn() { :; }; logger() { :; }; start )
    [ ! -e "$work/fed" ] && [ ! -s "$work/watchdog" ] || die 'watchdog closed under nowayout'
)
echo 'test-boot-privacy: watchdog passed'

# Setup: Incus slow to answer is not a boot failure; a finished manual setup clears SETUP.
sed -n '/^start() {/,/^}/p' "$repo/rootfs/etc/init.d/convergent-setup" |
    sed -e "s|/var/lib/convergent|$work/setup/lib|g" -e "s|/run/convergent|$work/setup/run|g" \
