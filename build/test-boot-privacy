#!/bin/sh
# Boot and privacy fixtures; no root, hardware or virtual machines.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap '[ -z "${holder:-}" ] || { kill "$holder" 2>/dev/null || :; wait "$holder" 2>/dev/null || :; }; rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-boot-privacy: $*" >&2; exit 1; }
check_script() { [ -s "$1" ] || die "empty extraction: $1"; sh -n "$1"; }

# Forwarding stays off until the final policy loads and PF answers enabled.
fw=$repo/guests/fw/site
awk -F= '$1 == "net.inet.ip.forwarding" {n++; if ($2 != 0) bad=1}
    END {exit (n != 1 || bad)}' "$fw/etc/sysctl.conf" || die 'early firewall forwarding'
# Apply the installation edit to the stock bootstrap rules; reject upstream drift.
sed -n '/^# Bootstrap SSH states/,/^# No CARP/p' "$fw/install.site" |
    sed '$d;s|/etc/rc|"$work/fw-rc"|g' >"$work/fw-edit"
check_script "$work/fw-edit"
cat >"$work/fw-stock" <<'FWRC'
RULES="
    block all
    pass on lo0
    pass in proto tcp from any to any port ssh keep state
    pass out proto { tcp, udp } from any to any port domain keep state"
printf '%s\n' "$RULES"
FWRC
check_script "$work/fw-stock"
for shape in stock missing duplicate changed; do
    cp "$work/fw-stock" "$work/fw-rc"
    case $shape in
    missing) sed '/port ssh/d' "$work/fw-stock" >"$work/fw-rc" ;;
    duplicate) cat "$work/fw-stock" >>"$work/fw-rc" ;;
    changed) sed 's/port ssh/port 22/' "$work/fw-stock" >"$work/fw-rc" ;;
    esac
    if sh -eu -c 'work=$1; die() { echo "$*" >&2; exit 1; }; . "$work/fw-edit"' sh "$work"; then
        [ "$shape" = stock ] || die "bootstrap edit accepted $shape"
        check_script "$work/fw-rc"
        sh "$work/fw-rc" >"$work/fw-patched-rules"
        sed '/port ssh/d' "$work/fw-stock" >"$work/fw-expected-rc"
        cmp "$work/fw-expected-rc" "$work/fw-rc"
    else
        [ "$shape" != stock ] || die 'bootstrap edit failed'
    fi
done
sh "$work/fw-stock" >"$work/fw-stock-rules"
{ printf '. "%s/fw-mocks"\n' "$work"
    sed "s|/var/run/fw-pf-reload.lock|$work/reload.lock|" "$fw/usr/local/libexec/convergent/fw-pf-reload"
} >"$work/fw-reload"
check_script "$work/fw-reload"
grep -q "$work/reload.lock" "$work/fw-reload" || die 'reload lock not mapped'
sed -n "/^cat >\/etc\/rc.local <<'FIRSTBOOT'$/,/^FIRSTBOOT$/p" "$fw/install.site" |
    sed '1d;$d;s|/usr/local/libexec/convergent/fw-seed|fw_seed|;s|/usr/local/libexec/convergent/fw-pf-reload|sh "$work/fw-reload"|' >"$work/fw-boot"
check_script "$work/fw-boot"
cat >"$work/fw-mocks" <<'FWMOCKS'
pfctl() {
    case "$*" in
    '-f /etc/pf.conf')
        echo load >>"$work/fw-events"
        case $fault in
        killed) kill -KILL "$$" ;;
        hold)
            touch "$work/holding"
            attempts=0
            while [ ! -e "$work/release" ]; do
                attempts=$((attempts + 1))
                [ "$attempts" -le 10 ] || exit 96
                sleep 1
            done ;;
        esac
        [ "$fault" != load ] ;;
    -si)
        echo status >>"$work/fw-events"
        case $fault in
        disabled) echo 'Status: Disabled' ;;
        malformed) echo unknown ;;
        status) echo 'Status: Enabled'; return 1 ;;
        *) echo 'Status: Enabled for 0 days 00:00:01' ;;
        esac ;;
    -sr) echo 'block drop all' ;;
    *) exit 98 ;;
    esac
}
sysctl() {
    case "$*" in
    net.inet.ip.forwarding=0)
        echo 0 >"$work/fw-forwarding"
        echo off >>"$work/fw-events" ;;
    net.inet.ip.forwarding=1)
        [ "$(cat "$work/fw-events")" = "$(printf 'off\nload\nstatus')" ] || exit 97
        [ "$fault" != sysctl ] || return 1
        echo 1 >"$work/fw-forwarding"
        # Retransmitted forbidden SSH passes only if bootstrap state survived.
        [ "$state" = 0 ] || echo leak >>"$work/fw-events"
        echo forward >>"$work/fw-events" ;;
    '-n kern.version') echo fixture ;;
    *) exit 98 ;;
    esac
}
sha256() { echo fixture; }
syspatch() { [ "$*" = -l ]; }
fw_seed() { echo seed >>"$work/fw-events"; }
FWMOCKS
check_script "$work/fw-mocks"
cat >"$work/fw-run" <<'FWBOOT'
work=$1 fault=$2 mode=$3 rules=$4
# PF sees the incoming SYN before the forwarding check. Reloads retain its state.
state=0
if grep -q 'pass in proto tcp from any to any port ssh keep state' "$rules"; then state=1; fi
export work fault state
. "$work/fw-mocks"
case $mode in
boot) . "$work/fw-boot" ;;
reload) exec sh "$work/fw-reload" ;;
esac
FWBOOT
check_script "$work/fw-run"
# A live holder refuses overlap without touching forwarding; SIGKILL leaves a reusable lock file.
: >"$work/fw-events"
sh -eu "$work/fw-run" "$work" hold reload "$work/fw-patched-rules" >"$work/holder-log" 2>&1 &
holder=$!
attempts=0
while [ ! -e "$work/holding" ]; do
    attempts=$((attempts + 1))
    [ "$attempts" -le 10 ] || { cat "$work/holder-log"; die 'reload never held lock'; }
    sleep 1
done
cp "$work/fw-events" "$work/before-overlap"
if sh -eu "$work/fw-run" "$work" none reload "$work/fw-patched-rules" >"$work/overlap-log" 2>&1; then
    die 'overlapping reload accepted'
fi
grep -qx 'fw-pf-reload: another reload is running' "$work/overlap-log"
cmp "$work/before-overlap" "$work/fw-events"
touch "$work/release"
wait "$holder"
holder=
: >"$work/fw-events"
if sh -eu "$work/fw-run" "$work" killed reload "$work/fw-patched-rules" >"$work/killed-log" 2>&1; then
    die 'reload survived SIGKILL'
fi
[ "$(cat "$work/fw-forwarding")" = 0 ] || die 'killed reload left forwarding on'
[ -f "$work/reload.lock" ] || die 'missing persistent reload lock'
# The next successful reload must acquire the stale file without removing it.
for mode in boot reload; do
for fault in none load disabled malformed status sysctl; do
    : >"$work/fw-events"
    case $mode in boot) echo 0 ;; reload) echo 1 ;; esac >"$work/fw-forwarding"
    if sh -eu "$work/fw-run" "$work" "$fault" "$mode" "$work/fw-patched-rules" >"$work/fw-log" 2>&1; then
        [ "$fault" = none ] || die "forwarding accepted $fault"
        [ "$(cat "$work/fw-forwarding")" = 1 ]
        printf 'off\nload\nstatus\nforward\n' >"$work/fw-expected"
        [ "$mode" != boot ] || echo seed >>"$work/fw-expected"
        cmp "$work/fw-expected" "$work/fw-events"
    else
        [ "$fault" != none ] || { cat "$work/fw-log"; die 'firewall boot'; }
        [ "$(cat "$work/fw-forwarding")" = 0 ] || die "forwarding left on after $fault"
        if grep -qE '^(forward|seed)$' "$work/fw-events"; then die "forwarded after $fault"; fi
    fi
done
done
# Allow control: the unedited bootstrap rule leaks despite the forwarding gate.
: >"$work/fw-events"
echo 0 >"$work/fw-forwarding"
sh -eu "$work/fw-run" "$work" none boot "$work/fw-stock-rules" >"$work/fw-log" 2>&1
grep -qx leak "$work/fw-events" || die 'SYN state survival control failed'
echo 'test-boot-privacy: firewall forwarding passed'

# Exercise the shipped local-health counters without daemon timing or network probes.
sed -n '/^while :; do$/,/^[[:space:]]*# Reuse this round/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed '1d;$d' >"$work/wan-round"
check_script "$work/wan-round"
sed -n '/^[[:space:]]*# After a first loss/,/^done$/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed '1d;$d' >"$work/wan-pace"
check_script "$work/wan-pace"
sed -n '/^[[:space:]]*# Reuse this round/,/^[[:space:]]*if \[ "\$want" != "\$owned" \]; then$/p' "$fw/usr/local/libexec/convergent/wan-watch" |
    sed "1d;\$d; s|/var/node_exporter/textfile|$work/textfile|; s|/usr/local/libexec/convergent/wan-probe.awk|$fw/usr/local/libexec/convergent/wan-probe.awk|" >"$work/wan-publish"
check_script "$work/wan-publish"
grep -q "$work/textfile" "$work/wan-publish" || die 'wan-watch textfile path not replaced'
mkdir "$work/textfile"
(
    sysctl() {
        [ "$*" = '-n net.inet.ip.forwarding' ] || exit 98
        case $forward in error) echo 1; return 1 ;; *) printf '%s\n' "$forward" ;; esac
    }
    host() { [ "$dns" = up ]; }
    ping() { [ "$wan_up" = 1 ]; }
    timeout() {
        case $1 in -k) shift 3 ;; -p) shift 4 ;; *) exit 98 ;; esac
        "$@"
    }
    sleep() { printf '%s\n' "$*" >>"$work/wan-sleeps"; }
    round() { . "$work/wan-round"; owned=$want; . "$work/wan-pace"; }
    src=100.80.0.11 wan=100.80.0.10 wan_up=1
    for failure in off empty malformed error dns; do
        owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1
        case $failure in
        off) forward=0 ;;
        empty) forward= ;;
        malformed) forward=unknown ;;
        error) forward=error ;;
        dns) dns=down ;;
        esac
        for n in 1 2 3 4 5 6 7 8 9; do
            round
            [ "$owned:$dns_lost:$good" = "0:$n:0" ] || die "early local demotion: $failure/$n"
        done
        round
        [ "$owned:$dns_lost" = 128:10 ] || die "missing local demotion: $failure"
        forward=1 dns=up
        for n in 1 2; do
            round
            [ "$owned:$dns_lost:$good" = "128:0:$n" ] || die "early local recovery: $failure/$n"
        done
        round
        [ "$owned:$good" = 0:3 ] || die "missing local recovery: $failure"
    done
    # Short reloads reset the local failure streak without demotion.
    for n in 1 2 3 4 5 6 7 8 9; do forward=0; round; [ "$owned" = 0 ]; done
    forward=1; round
    [ "$owned:$dns_lost" = 0:0 ]
    forward=0; round
    [ "$owned:$dns_lost" = 0:1 ]
    # A local failure right after one lost WAN round must not skip the pacing sleep.
    forward=1; wan_up=0; round; [ "$lost" = 1 ]
    forward=0; round; [ "$lost" = 0 ]
    # Pacing: a good round sleeps out the rest of its second (0.6 s of probes), a first loss
    # re-probes at once, a second loss and a local failure wait a second.
    : >"$work/wan-sleeps"
    owned=0 good=3 lost=0 dns_lost=0 dns=up forward=1 wan_up=1
    round; round
    wan_up=0; round; round
    forward=0; round
    printf '0.4\n0.4\n1\n1\n' | cmp - "$work/wan-sleeps" || die 'wan-watch rounds are not paced'
    # A round without a probe publishes a local fault, never a failed transit probe.
    prom=$work/textfile/wan-watch.prom
    for c in local:0:- lost:1:0 up:1:1; do
        owned=0 good=0 lost=0 dns_lost=0 dns=up forward=1 wan_up=1 metrics_at=0
        case ${c%%:*} in local) forward=0 ;; lost) wan_up=0 ;; esac
        . "$work/wan-round"; . "$work/wan-publish"
        grep -qx "convergent_wan_watch_local_ok $(echo "$c" | cut -d: -f2)" "$prom" || die "local_ok: $c"
        up=${c##*:}
        if [ "$up" = - ]; then
            if grep -q '^convergent_wan_watch_probe_up' "$prom"; then die "probe_up without a probe: $c"; fi
        else grep -qx "convergent_wan_watch_probe_up $up" "$prom" || die "probe_up: $c"; fi
        grep -q '^convergent_wan_watch_probe_timestamp_seconds [0-9]' "$prom" || die "probe timestamp: $c"
    done
)
echo 'test-boot-privacy: firewall local health passed'

# Capture the feeder's actual fd 3 writes, including TERM's magic close.
(
    . "$repo/rootfs/etc/init.d/convergent-watchdog"
    printf '%s\n' "$loop" >"$work/loop"
    check_script "$work/loop"
    # A separate shell gives the TERM fixture its own PID.
    cat >"$work/feeder" <<'EOF'
set -u
work=$1 mode=$2
logger() { printf '%s\n' "$*" >"$work/logger"; }
sleep() {
    printf '%s\n' "$*" >>"$work/sleeps"
    [ "$mode" != term ] || kill -TERM "$$"
}
. "$work/loop"
EOF
    check_script "$work/feeder"
    : >"$work/sleeps"
    sh "$work/feeder" "$work" expire 3>"$work/feeds"
    [ "$(cat "$work/feeds")" = '....................' ]
    [ "$(grep -cx 30 "$work/sleeps")" = 20 ]
    [ "$(wc -l <"$work/sleeps")" -eq 20 ]
    grep -q 'no bless within ten minutes' "$work/logger"
    rm "$work/logger"
    : >"$work/sleeps"
    sh "$work/feeder" "$work" term 3>"$work/feeds"
    [ "$(cat "$work/feeds")" = '.V' ]
    [ "$(cat "$work/sleeps")" = 30 ]
    [ ! -e "$work/logger" ]

    # Only the device probe and daemon command are mocked for stop.
    sed -n '/^stop() {/,/^}/p' "$repo/rootfs/etc/init.d/convergent-watchdog" |
        sed -e "s|/dev/watchdog|$work/watchdog|g" -e 's/\[ -c /[ -f /' \
            -e 's/start-stop-daemon/mock_daemon/' >"$work/stop"
    check_script "$work/stop"
    . "$work/stop"
    mock_daemon() { printf '%s\n' "$*" >"$work/daemon"; return "$daemon_status"; }
    pidfile=$work/exited.pid
    for daemon_status in 0 1; do
        : >"$work/watchdog"
        stop
        [ "$(cat "$work/watchdog")" = V ]
        [ "$(cat "$work/daemon")" = "--stop --quiet --retry TERM/5 --pidfile $pidfile" ]
    done
)
echo 'test-boot-privacy: watchdog passed'

# Fixture sysfs and commands; never touch a partition or mapping.
sed -n '/^grow_state() {/,/^}/p' "$repo/initramfs/90convergent/convergent-state.sh" |
    sed "s|/sys/class/block/|$work/sys/|g" >"$work/grow"
check_script "$work/grow"
(
    . "$work/grow"
    state=$work/state NEWROOT=$work/root dev=/dev/vda5 pass=fixture-secret
    mkdir -p "$state" "$NEWROOT/usr/lib/convergent" "$work/sys/vda5" "$work/vda/vda5"
    readlink() {
        case "$*" in
        '-f /dev/vda5') echo /dev/vda5 ;;
        "-f $work/sys/vda5/..") echo "$work/vda" ;;
        *) die "unexpected readlink: $*" ;;
        esac
    }
    blockdev() {
        case "$*" in
        '--getss /dev/vda') echo "$sector" ;;
        '--getsz /dev/mapper/cv-state') echo "$mapped" ;;
        *) die "unexpected blockdev: $*" ;;
        esac
    }
    sgdisk() {
        printf 'sgdisk %s\n' "$*" >>"$work/calls"
        case "$*" in
        '-i 5 /dev/vda') printf 'First sector: %s\nPartition unique GUID: fixture-guid\n' "$((2048 * 512 / sector))" ;;
        '-e /dev/vda') ;;
        '-p /dev/vda') echo "First usable sector is 34, last usable sector is $((33554432 * 512 / sector - 34))" ;;
        "-d 5 -n 5:$((2048 * 512 / sector)):$expected_target -t 5:8309 -c 5:cv-state -u 5:fixture-guid /dev/vda") ;;
        *) die "unexpected sgdisk: $*" ;;
        esac
    }
    partx() {
        [ "$*" = '-u --nr 5 /dev/vda' ] || die "unexpected partx: $*"
        printf 'partx %s\n' "$*" >>"$work/calls"
        echo "$(((expected_target + 1) * sector / 512 - 2048))" >"$work/sys/vda5/size"
    }
    cryptsetup() {
        [ "$*" = 'resize --key-file - cv-state' ] || die "unexpected cryptsetup: $*"
        [ "$(cat)" = fixture-secret ] || die 'lost resize key'
        printf 'cryptsetup %s\n' "$*" >>"$work/calls"
    }
    for scenario in legacy fixed percent auto capped capped4k partition-grown mapping-grown at-cap not-last small invalid-cap; do
        sector=512 mapped=4161536 expected_target=33554398
        echo 5 >"$work/sys/vda5/partition"
        echo 2048 >"$work/sys/vda5/start"
        echo 2048 >"$work/vda/vda5/start"
        echo 4194304 >"$work/sys/vda5/size"
        echo 33554432 >"$work/vda/size"
        echo auto >"$state/install-state-size"
        echo 0 >"$NEWROOT/usr/lib/convergent/state-max-gib"
        rm -f "$work/vda/later/start"
        case $scenario in
        legacy) rm "$state/install-state-size" ;;
        fixed) echo 8 >"$state/install-state-size" ;;
        percent) echo '50%' >"$state/install-state-size" ;;
        capped|capped4k) echo 4 >"$NEWROOT/usr/lib/convergent/state-max-gib"; expected_target=8390655
            if [ "$scenario" = capped4k ]; then sector=4096; expected_target=1048831; fi ;;
        partition-grown|mapping-grown) echo 33552351 >"$work/sys/vda5/size"
            [ "$scenario" != mapping-grown ] || mapped=33519583 ;;
        at-cap) echo 2 >"$NEWROOT/usr/lib/convergent/state-max-gib" ;;
        not-last) mkdir -p "$work/vda/later"; echo 8388608 >"$work/vda/later/start" ;;
        small) echo 6293504 >"$work/vda/size" ;;
        invalid-cap) echo invalid >"$NEWROOT/usr/lib/convergent/state-max-gib" ;;
        esac
        : >"$work/calls"
        if (grow_state); then
            [ "$scenario" != invalid-cap ] || die 'accepted invalid cap'
        else
            [ "$scenario" = invalid-cap ] || die "grow failed: $scenario"
        fi
        : >"$work/expected"
        case $scenario in
        auto|capped|capped4k)
            cat >"$work/expected" <<EOF
sgdisk -i 5 /dev/vda
sgdisk -e /dev/vda
sgdisk -p /dev/vda
sgdisk -d 5 -n 5:$((2048 * 512 / sector)):$expected_target -t 5:8309 -c 5:cv-state -u 5:fixture-guid /dev/vda
partx -u --nr 5 /dev/vda
cryptsetup resize --key-file - cv-state
EOF
            ;;
        partition-grown) echo 'cryptsetup resize --key-file - cv-state' >"$work/expected" ;;
        esac
        cmp "$work/expected" "$work/calls" || die "wrong resize: $scenario"
    done
    # Btrfs must resume even when the mapping was already grown.
    sed -n '/^btrfs -q filesystem resize max /,/^[[:space:]]*warn /p' \
        "$repo/initramfs/90convergent/convergent-state.sh" >"$work/btrfs"
    check_script "$work/btrfs"
    btrfs() { printf '%s\n' "$*" >"$work/btrfs-call"; }
    . "$work/btrfs"
    [ "$(cat "$work/btrfs-call")" = "-q filesystem resize max $state" ]
)
echo 'test-boot-privacy: state growth passed'

# Configuration coverage only; signed/bogus replies still need the firewall fixture.
dns=$repo/guests/fw/site/var/unbound/etc
awk '
    /^[[:space:]]*#/ {next}
    $1 == "module-config:" {modules++; if ($0 !~ /"respip validator iterator"[[:space:]]*$/) bad=1}
    $1 == "auto-trust-anchor-file:" {anchors++; if ($2 != "\"/var/unbound/db/root.key\"") bad=1}
    $1 == "harden-dnssec-stripped:" {harden++; if ($2 != "yes") bad=1}
    $1 == "val-permissive-mode:" && $2 != "no" {bad=1}
    $1 == "domain-insecure:" || $1 == "val-override-date:" {bad=1}
    END {exit bad || modules != 1 || anchors != 1 || harden != 1}
' "$dns/unbound.conf" "$dns/local-names.conf" "$dns/local-owner.conf" || die 'DNSSEC validation config weakened'
echo 'test-boot-privacy: DNSSEC config passed'

# RPZ filtering must not produce an unbounded per-query daemon log.
awk '$1 == "rpz-log:" {n++; if ($2 != "no") bad=1}
    END {exit (n != 1 || bad)}' "$dns/unbound.conf" || die 'RPZ query logging enabled'
echo 'test-boot-privacy: RPZ logging passed'

# Firewall cron jobs mail only failures, never overlap and log no job start (-q).
grep -qF 'cat /etc/convergent/crontab >>/etc/crontab' "$fw/install.site" || die 'firewall crontab not installed'
awk '/^[[:space:]]*(#|$)/ {next} {n++; if ($6 != "root" || $7 != "-nsq") bad=1}
    END {exit (!n || bad)}' "$fw/etc/convergent/crontab" || die 'firewall cron jobs lost -n, -s or -q'
# wan's busybox crond logs no job start (level 8) either; the build checks Alpine's script reads CRON_OPTS.
(. "$repo/guests/wan/rootfs/etc/conf.d/crond"; [ "$CRON_OPTS" = '-c /etc/crontabs -l 9' ]) || die 'wan crond logs job starts'
grep -qF "grep -q 'CRON_OPTS' \"\$target/etc/init.d/crond\" || die" "$repo/guests/wan/build" || die 'wan build ignores CRON_OPTS'
echo 'test-boot-privacy: firewall and wan cron logging passed'

# Real SHA-512 hashing and file replacement; tty and ownership operations are mocked.
(
    state=$work/recovery
    mkdir -p "$state/etc"
    stty() { :; }
    sync() { :; }
    chown() { printf 'chown %s\n' "$*" >>"$work/permissions"; }
    chmod() { printf 'chmod %s\n' "$*" >>"$work/permissions"; command chmod "$@"; }
    . "$repo/initramfs/90convergent/recovery-lib.sh"
    for scenario in valid minimum maximum short long mismatch no-owner two-owners no-shadow two-shadows bad-group; do
        printf 'root:x:0:0::/:/bin/sh\nowner:x:1000:1000::/home/owner:/bin/sh\nother:x:1001:1001::/:/bin/sh\n' >"$state/etc/passwd"
        printf 'root:x:0:\nshadow:x:42:\n' >"$state/etc/group"
        printf 'root:root-hash:1:2:3:4:5:6:7\nowner:old-hash:8:9:10:11:12:13:14\nother:other-hash:15:16:17:18:19:20:21\n' >"$state/etc/shadow"
        password='a fixture password' repeat=
        case $scenario in
        minimum) password=123456789012 ;;
        maximum) password=$(printf '%0256d' 0) ;;
        short) password=12345678901 ;;
        long) password=$(printf '%0257d' 0) ;;
        mismatch) repeat='different password' ;;
        no-owner) sed '/^owner:/d' "$state/etc/passwd" >"$work/passwd"; mv "$work/passwd" "$state/etc/passwd" ;;
        two-owners) echo 'second:x:1000:1000::/:/bin/sh' >>"$state/etc/passwd" ;;
        no-shadow) sed '/^owner:/d' "$state/etc/shadow" >"$work/shadow"; mv "$work/shadow" "$state/etc/shadow" ;;
        two-shadows) echo 'owner:duplicate:1:2:3:4:5:6:7' >>"$state/etc/shadow" ;;
        bad-group) echo 'shadow:x:bad:' >"$state/etc/group" ;;
        esac
        cp "$state/etc/shadow" "$work/before"
        : >"$work/permissions"
        printf '%s\n%s\n' "$password" "${repeat:-$password}" >"$work/input"
        if reset_password <"$work/input" >"$work/reset-log"; then
            case $scenario in valid|minimum|maximum) ;; *) die "accepted reset: $scenario" ;; esac
            grep -qx 'Password changed for owner.' "$work/reset-log"
            hash=$(awk -F: '$1 == "owner" {print $2}' "$state/etc/shadow")
            case $hash in '$6$'*) ;; *) die 'not SHA-512' ;; esac
            salt=${hash#\$6\$}; salt=${salt%%\$*}
            [ "$hash" = "$(printf '%s\n' "$password" | openssl passwd -6 -salt "$salt" -stdin)" ]
            sed 's/^owner:[^:]*:/owner:old-hash:/' "$state/etc/shadow" >"$work/restored"
            cmp "$work/before" "$work/restored"
            sed "s|$state/etc/.shadow\.[^ ]*|TEMP|" "$work/permissions" >"$work/actual"
            printf 'chown 0:42 TEMP\nchmod 0640 TEMP\n' >"$work/expected"
            cmp "$work/expected" "$work/actual"
        else
            case $scenario in valid|minimum|maximum) die "reset failed: $scenario" ;; esac
            cmp "$work/before" "$state/etc/shadow"
            [ ! -s "$work/permissions" ]
        fi
        for leftover in "$state/etc/".shadow.*; do [ ! -e "$leftover" ] || die 'reset left temporary shadow'; done
    done
)
echo 'test-boot-privacy: password reset passed'

# Redirect all camera paths; exec uses an explicit interpreter on noexec /tmp.
mkdir -p "$work/camera/run" "$work/camera/sys/module/videodev"
sed -n '/^camera_unload() {/,/^}/p; /^camera() {/,/^}/p' "$repo/tools/devices" |
    sed -e "s|/var/lib/convergent/devices|$work/camera/state|g" \
        -e "s|/run/convergent-camera|$work/camera/run/convergent-camera|g" \
        -e "s|/sys/|$work/camera/sys/|g" \
        -e "s|exec modprobe |exec sh \"$work/modprobe\" |" >"$work/camera-functions"
check_script "$work/camera-functions"
cat >"$work/modprobe" <<'EOF'
set -eu
printf '%s\n' "$*" >>"$work/modules"
case "$*" in
'-r videodev') printf 'choice=%s\n' "$(cat "$work/camera/state/camera")" >>"$work/modules"; exit 1 ;;
'--ignore-install uvcvideo'|'uvcvideo') ;;
*) exit 98 ;;
esac
EOF
check_script "$work/modprobe"
export work
(
    . "$work/camera-functions"
    flock() { :; }
    modprobe() { sh "$work/modprobe" "$@"; }
    usage() { exit 2; }
    : >"$work/modules"
    (camera on)
    [ "$(cat "$work/modules")" = uvcvideo ]
    [ "$(cat "$work/camera/state/camera")" = on ]
    : >"$work/modules"
    (camera load uvcvideo)
    [ "$(cat "$work/modules")" = '--ignore-install uvcvideo' ]
    : >"$work/modules"
    if (camera off) >"$work/off-log" 2>&1; then die 'busy camera reported disabled'; fi
    grep -q 'camera disabled for future loads' "$work/off-log"
    [ "$(cat "$work/camera/state/camera")" = off ]
    printf '%s\n' '-r videodev' 'choice=off' '-r videodev' 'choice=off' >"$work/expected"
    cmp "$work/expected" "$work/modules"
    : >"$work/modules"
    if (camera load uvcvideo) >"$work/load-log" 2>&1; then die 'loaded disabled camera'; fi
    grep -q 'camera is off' "$work/load-log"
    [ ! -s "$work/modules" ]
)
echo 'test-boot-privacy: camera passed'

# Execute the shipped commands, substituting only the socket readiness probe.
sway=$repo/rootfs/etc/sway/config.d/convergent
sed -n "/^exec sh -c '.*DEFAULT_AUDIO_SOURCE@/s/^exec sh -c '\(.*\)'$/\1/p" "$sway" |
    sed 's/\[ -S /[ -e /' >"$work/mic-init"
sed -n 's/^bindsym --locked XF86AudioMicMute exec //p' "$sway" >"$work/mic-locked"
check_script "$work/mic-init"
check_script "$work/mic-locked"
(
    SWAYSOCK=$work/sway.sock
    touch "$SWAYSOCK"
    calls=0 sleeps=0 muted=0
    timeout() { [ "$1 $2 $3" = '-k 1 2' ] || die 'wrong mute timeout'; shift 3; "$@"; }
    sleep() { [ "$*" = 1 ] || die 'wrong mute delay'; sleeps=$((sleeps + 1)); [ "$sleeps" -le 2 ] || die 'mute never completed'; }
    wpctl() {
        [ "$*" = 'set-mute @DEFAULT_AUDIO_SOURCE@ 1' ] || die "unexpected wpctl: $*"
        calls=$((calls + 1))
        [ "$calls" -ge 3 ] || return 1
        muted=1
    }
    . "$work/mic-init"
    [ "$calls:$sleeps:$muted" = 3:2:1 ]
    rm "$SWAYSOCK"
    calls=0
    . "$work/mic-init"
    [ "$calls" = 0 ]
    # A source that appears late: 120 fast attempts, one log line, then every 30 s until it mutes.
    touch "$SWAYSOCK"
    calls=0 fast=0 slow=0 logs=0 muted=0
    sleep() {
        case $* in 1) fast=$((fast + 1)) ;; 30) slow=$((slow + 1)) ;; *) die "wrong mute delay: $*" ;; esac
        [ "$((fast + slow))" -le 200 ] || die 'mute loop never ended'
    }
    wpctl() {
        [ "$*" = 'set-mute @DEFAULT_AUDIO_SOURCE@ 1' ] || die "unexpected wpctl: $*"
        calls=$((calls + 1))
        [ "$calls" -gt 125 ] || return 1
        muted=1
    }
    logger() { [ "$1 $2" = '-t sway' ] || die "unexpected logger: $*"; logs=$((logs + 1)); }
    . "$work/mic-init"
    [ "$calls:$fast:$slow:$logs:$muted" = 126:119:6:1:1 ] || die "late source not muted: $calls:$fast:$slow:$logs:$muted"
    rm "$SWAYSOCK"

    . "$repo/rootfs/usr/lib/convergent/sys/30-audio"
    audio_session() { :; }
    onearg() { [ "$#" = 2 ]; answer=$2; }
    noargs() { [ "$#" = 0 ]; }
    run() { "$@"; }
    sys() { [ "$1" = audio ]; action=$2; shift 2; "audio_$action" "$@"; }
    wpctl() {
        calls=$((calls + 1))
        case "$*" in
        'set-mute @DEFAULT_AUDIO_SOURCE@ 1') muted=1 ;;
        'set-mute @DEFAULT_AUDIO_SOURCE@ 0') muted=0 ;;
        'set-mute @DEFAULT_AUDIO_SOURCE@ toggle') muted=$((1 - muted)) ;;
        *) die "unexpected wpctl: $*" ;;
        esac
    }
    # Prove the mock can unmute, then exercise both initial states.
    muted=1
    audio_micmute
    [ "$muted" = 0 ]
    for initial in 0 1; do
        muted=$initial calls=0
        . "$work/mic-locked"
        [ "$calls:$muted" = 1:1 ]
    done
)
echo 'test-boot-privacy: microphone passed'

# The boot waiter polls the host bridge every five seconds and gives up after an hour.
sed -n '/^if \[ "\${1:-}" != repair \]; then$/,/^fi$/p' "$repo/rootfs/usr/lib/convergent/incus/host-net" |
    sed '1d;$d' >"$work/host-wait"
check_script "$work/host-wait"
(
    die() { echo "$polls $*" >>"$work/host-died"; exit 1; }
    ip() { [ "$*" = '-4 address show dev host' ] || exit 98; [ "$polls" -ge "$up_after" ] && echo '    inet 100.80.1.10/28 scope global host'; }
    sleep() { [ "$*" = 5 ] || die "wrong bridge poll delay: $*"; polls=$((polls + 1)); [ "$polls" -le 800 ] || die 'bridge waiter never gave up'; }
    rm -f "$work/host-died"
    polls=0 up_after=3
    . "$work/host-wait"
    [ "$polls" = 3 ] || die "bridge waiter polled $polls times"
    polls=0 up_after=999999
    if (. "$work/host-wait"); then die 'bridge waiter never gave up'; fi
    [ "$(cat "$work/host-died")" = '720 no host bridge within an hour; check auto repairs it' ] ||
        die "bridge waiter gave up wrongly: $(cat "$work/host-died")"
)
echo 'test-boot-privacy: host bridge waiter passed'

# KVM halt polling follows the power source through set_file; a missing knob is skipped, a refused write fails.
power=$repo/tools/power
sed -n '/^ac_epp=/p; /^bat_epp=/p; /^ac_halt_poll=/p; /^bat_halt_poll=/p
    /^policy_online() {/,/^}/p; /^write_failed() {/,/^}/p; /^set_file() {/,/^}/p' "$power" >"$work/power-lib"
sed -n '/^if \[ "\$src" = ac \]; then epp=/p; /^set_file \/sys\/module\/kvm\/parameters\/halt_poll_ns /p' "$power" |
    sed "s|/sys/module/kvm/parameters/|$work/kvm/|" >"$work/power-halt"
check_script "$work/power-lib"
check_script "$work/power-halt"
[ "$(grep -c "$work/kvm/halt_poll_ns" "$work/power-halt")" = 1 ] && [ "$(wc -l <"$work/power-halt")" = 2 ] ||
    die 'halt polling extraction'
# After the CPU profile is published: a refused knob must not turn the profile unknown.
awk '/^set_file \/sys\/module\/kvm\/parameters\/halt_poll_ns / {knob = NR}
    /^\tmv -f "\$file" \/run\/convergent-power.profile / {profile = NR}
    END {exit !(profile && knob > profile)}' "$power" || die 'halt polling set before the profile is published'
(
    cpu=$work/cpu
    logger() { :; }
    . "$work/power-lib"
    [ "$ac_halt_poll:$bat_halt_poll" = 200000:0 ] || die "halt polling values $ac_halt_poll/$bat_halt_poll"
    mkdir "$work/kvm"
    echo 200000 >"$work/kvm/halt_poll_ns"
    for src in battery battery ac ac; do
        rc=0 changed=0
        read -r before <"$work/kvm/halt_poll_ns"
        . "$work/power-halt" || :
        read -r value <"$work/kvm/halt_poll_ns"
        case $src in ac) want=200000 ;; *) want=0 ;; esac
        [ "$rc:$value" = "0:$want" ] || die "halt polling on $src: status $rc, value $value"
        if [ "$before" = "$want" ]; then expect=0; else expect=1; fi
        [ "$changed" = "$expect" ] || die "halt polling on $src: changed $changed after $before"
    done
    rm "$work/kvm/halt_poll_ns"
    rc=0 changed=0 src=battery
    . "$work/power-halt" || :
    [ "$rc:$changed" = 0:0 ] && [ ! -e "$work/kvm/halt_poll_ns" ] || die 'missing halt polling knob not skipped'
    # A directory refuses the write, as a read-only parameter would.
    mkdir "$work/kvm/halt_poll_ns"
    . "$work/power-halt" 2>/dev/null || :
    [ "$rc" = 1 ] || die 'refused halt polling write passed'
)
echo 'test-boot-privacy: KVM halt polling passed'
