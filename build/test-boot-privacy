    sed "s|/sys/class/rfkill/|$work/net-rfkill/|" >"$work/host-rfkill"
check_script "$work/host-rfkill"
grep -q "$work/net-rfkill/rfkill\*" "$work/host-rfkill" || die 'host rfkill extraction'
(
    die() { echo "$*" >"$work/host-rfkill-died"; exit 1; }
    rfkill() { echo "rfkill $*" >>"$work/host-rfkill-calls"; [ "$refuse" = no ]; }
    mkdir -p "$work/net-rfkill/rfkill0" "$work/net-rfkill/rfkill1" "$work/net-rfkill/rfkill2"
    echo bluetooth >"$work/net-rfkill/rfkill0/type"; echo 1 >"$work/net-rfkill/rfkill0/soft"
    refuse=no
    . "$work/host-rfkill"
    [ ! -e "$work/host-rfkill-calls" ] || die 'unblocked with no Wi-Fi switch'
    echo wlan >"$work/net-rfkill/rfkill1/type"; echo wwan >"$work/net-rfkill/rfkill2/type"
    echo 0 >"$work/net-rfkill/rfkill1/soft"; echo 0 >"$work/net-rfkill/rfkill2/soft"
    . "$work/host-rfkill"
    [ ! -e "$work/host-rfkill-calls" ] || die 'unblocked switches that were not blocked'
    echo 1 >"$work/net-rfkill/rfkill2/soft"
    . "$work/host-rfkill"
    [ ! -e "$work/host-rfkill-calls" ] || die 'unblocked a WWAN switch nothing uses'
    echo 1 >"$work/net-rfkill/rfkill1/soft"
    . "$work/host-rfkill"
    [ "$(cat "$work/host-rfkill-calls")" = 'rfkill unblock 1' ] || die 'platform Wi-Fi switch not unblocked by its index'
    refuse=yes
    if (. "$work/host-rfkill"); then die 'a refused unblock passed'; fi
    grep -qx 'cannot unblock the platform Wi-Fi switch' "$work/host-rfkill-died" || die 'refused unblock not named'
)
echo 'test-boot-privacy: platform Wi-Fi switch passed'

# KVM halt polling follows the power source through set_file; a missing knob is skipped, a refused write fails.
power=$repo/tools/power
sed -n '/^ac_epp=/p; /^bat_epp=/p; /^ac_halt_poll=/p; /^bat_halt_poll=/p
    /^ac_aspm=/p; /^bat_aspm=/p; /^ac_runtime=/p; /^bat_runtime=/p
    /^policy_online() {/,/^}/p; /^write_failed() {/,/^}/p; /^set_file() {/,/^}/p' "$power" >"$work/power-lib"
sed -n '/^if \[ "\$src" = ac \]; then epp=/p; /^else epp=\$bat_epp /p; /^set_file \/sys\/module\/kvm\/parameters\/halt_poll_ns /p' "$power" |
    sed "s|/sys/module/kvm/parameters/|$work/kvm/|" >"$work/power-halt"
check_script "$work/power-lib"
check_script "$work/power-halt"
[ "$(grep -c "$work/kvm/halt_poll_ns" "$work/power-halt")" = 1 ] && [ "$(wc -l <"$work/power-halt")" = 3 ] ||
    die 'halt polling extraction'
# After the CPU profile is published: a refused knob must not turn the profile unknown.
awk '/^set_file \/sys\/module\/kvm\/parameters\/halt_poll_ns / {knob = NR}
    /^\tmv -f "\$file" \/run\/convergent-power.profile / {profile = NR}
    END {exit !(profile && knob > profile)}' "$power" || die 'halt polling set before the profile is published'
(
    cpu=$work/cpu
    logger() { :; }
    . "$work/power-lib"
    [ "$ac_halt_poll:$bat_halt_poll" = 200000:0 ] || die "halt polling values $ac_halt_poll/$bat_halt_poll"
    mkdir "$work/kvm"
    echo 200000 >"$work/kvm/halt_poll_ns"
    for src in battery battery ac ac; do
        rc=0 changed=0
        read -r before <"$work/kvm/halt_poll_ns"
        . "$work/power-halt" || :
        read -r value <"$work/kvm/halt_poll_ns"
        case $src in ac) want=200000 ;; *) want=0 ;; esac
        [ "$rc:$value" = "0:$want" ] || die "halt polling on $src: status $rc, value $value"
        if [ "$before" = "$want" ]; then expect=0; else expect=1; fi
        [ "$changed" = "$expect" ] || die "halt polling on $src: changed $changed after $before"
    done
    rm "$work/kvm/halt_poll_ns"
    rc=0 changed=0 src=battery
    . "$work/power-halt" || :
    [ "$rc:$changed" = 0:0 ] && [ ! -e "$work/kvm/halt_poll_ns" ] || die 'missing halt polling knob not skipped'
    # A directory refuses the write, as a read-only parameter would.
    mkdir "$work/kvm/halt_poll_ns"
    . "$work/power-halt" 2>/dev/null || :
    [ "$rc" = 1 ] || die 'refused halt polling write passed'
)
echo 'test-boot-privacy: KVM halt polling passed'

# Battery: ASPM powersave and runtime PM auto for the listed functions, the kernel defaults on AC. The system's
# NVMe, unlisted, other-vendor and vfio-pci functions stay on; without a partition list every NVMe stays on.
sed -n '/^set_aspm() {/,/^}/p; /^backing() {/,/^}/p; /^runtime_pm() {/,/^}/p' "$power" >"$work/power-pm-lib"
sed -n '/^if \[ "\$src" = ac \]; then epp=/p; /^else epp=\$bat_epp /p; /^set_aspm "\$aspm"$/p; /^runtime_pm "\$runtime"$/p' "$power" >"$work/power-pm"
check_script "$work/power-pm-lib"
check_script "$work/power-pm"
[ "$(wc -l <"$work/power-pm")" = 4 ] || die 'battery savings extraction'
awk '/^set_file \/sys\/module\/kvm\/parameters\/halt_poll_ns / {knob = NR} /^runtime_pm "\$runtime"$/ {pm = NR}
    END {exit !(knob && pm > knob)}' "$power" || die 'battery savings set before the profile is published'
(
    logger() { printf '%s\n' "$*" >>"$work/power-log"; }
    . "$work/power-lib"
    . "$work/power-pm-lib"
    cpu=$work/cpu aspm_policy=$work/aspm pci=$work/pci labels=$work/labels blocks=$work/block
    aspm_refused=$work/aspm-refused devfs=$work/dev mounts=$work/mounts swaps=$work/swaps
    : >"$work/mounts"; : >"$work/swaps"
    # The kernel brackets the active policy; refuse=1 rejects it, as with ASPM disabled by the firmware.
    # The redirection truncates a plain file, so a refusal writes back the default line sysfs would keep.
    refuse=0
    echo() {
        case $1 in
        default|performance|powersave|powersupersave)
            [ "$refuse" = 0 ] || { printf '[default] performance powersave powersupersave\n'; return 1; }
            line=
            for a in default performance powersave powersupersave; do
                [ "$a" != "$1" ] || a="[$a]"
                line="$line${line:+ }$a"
            done
            printf '%s\n' "$line" ;;
        *) printf '%s\n' "$*" ;;
        esac
    }
    dev=$work/devices/pci0000:00
    mkdir -p "$work/pci" "$work/labels" "$work/block" "$work/node" "$work/drivers/vfio-pci" "$work/drivers/nvme"
    fn() {
        mkdir -p "$dev/$1/power"
        printf '%s\n' "$2" >"$dev/$1/vendor"; printf '%s\n' "$3" >"$dev/$1/class"; printf 'on\n' >"$dev/$1/power/control"
        ln -s "$dev/$1" "$work/pci/$1"
        [ -z "${4:-}" ] || ln -s "$work/drivers/$4" "$dev/$1/driver"
    }
    # NPU, GNA, ISH, DTT, KT and the unused NVMe; then a host bridge, the dGPU and a listed class on vfio-pci,
    # a listed class from another vendor and the NVMe that holds cv-slot-a.
    listed='0000:00:0b.0 0000:00:08.0 0000:00:12.0 0000:00:04.0 0000:00:16.3 0000:02:00.0'
    kept='0000:00:00.0 0000:01:00.0 0000:00:15.0 0000:03:00.0 0000:04:00.0'
    fn 0000:00:0b.0 0x8086 0x120000; fn 0000:00:08.0 0x8086 0x088000; fn 0000:00:12.0 0x8086 0x070000
    fn 0000:00:04.0 0x8086 0x118000; fn 0000:00:16.3 0x8086 0x070002; fn 0000:02:00.0 0x1e0f 0x010802 nvme
    fn 0000:00:00.0 0x8086 0x060000; fn 0000:01:00.0 0x10de 0x030000 vfio-pci; fn 0000:00:15.0 0x8086 0x118000 vfio-pci
    fn 0000:03:00.0 0x10ec 0x070000; fn 0000:04:00.0 0x144d 0x010802 nvme
    mkdir -p "$dev/0000:04:00.0/nvme/nvme1/nvme1n1/nvme1n1p2" "$dev/0000:00:14.0/usb3/3-1/host0/block/sda/sda3"
    ln -s "$dev/0000:04:00.0/nvme/nvme1/nvme1n1/nvme1n1p2" "$work/block/nvme1n1p2"
    ln -s "$dev/0000:00:14.0/usb3/3-1/host0/block/sda/sda3" "$work/block/sda3"
    : >"$work/node/nvme1n1p2"; : >"$work/node/sda3"
    ln -s "$work/node/nvme1n1p2" "$work/labels/cv-slot-a"; ln -s "$work/node/sda3" "$work/labels/cv-state"
    pm() { for b in "$@"; do cat "$work/pci/$b/power/control"; done | tr '\n' ' '; }
    apply() { src=$1 rc=0 changed=0; . "$work/power-pm" || :; }
    printf '[default] performance powersave powersupersave\n' >"$work/aspm"
    apply battery
    [ "$rc:$changed:$(cat "$work/aspm")" = '0:1:default performance [powersave] powersupersave' ] || die "battery ASPM: $rc $changed"
    [ "$(pm $listed)" = 'auto auto auto auto auto auto ' ] || die "battery runtime PM: $(pm $listed)"
    [ "$(pm $kept)" = 'on on on on on ' ] || die "runtime PM changed a kept function: $(pm $kept)"
    apply battery
    [ "$rc:$changed" = 0:0 ] || die 'a repeated battery event wrote again'
    apply ac
    [ "$rc:$changed:$(cat "$work/aspm")" = '0:1:[default] performance powersave powersupersave' ] || die "AC ASPM: $rc $changed"
    [ "$(pm $listed $kept)" = 'on on on on on on on on on on on ' ] || die "AC runtime PM: $(pm $listed $kept)"
    # No cv-* label, or one whose block device cannot be resolved: no NVMe is proven not to be the system's.
    mv "$work/labels" "$work/labels.all"; mkdir "$work/labels"
    apply battery
    [ "$rc:$(pm 0000:02:00.0 0000:04:00.0 0000:00:0b.0)" = '0:on on auto ' ] || die 'an NVMe left on without a partition list'
    apply ac
    rm -r "$work/labels"; mv "$work/labels.all" "$work/labels"
    : >"$work/node/gone"; ln -s "$work/node/gone" "$work/labels/cv-slot-b"
    apply battery
    [ "$rc:$(pm 0000:02:00.0 0000:04:00.0)" = '0:on on ' ] || die 'an NVMe left on with an unresolved partition'
    rm "$work/labels/cv-slot-b"
    apply ac
    # An NVMe under a mounted filesystem (through dm-crypt) or active swap stays on; a source that exists but does
    # not resolve to a block device, or an unreadable list, keeps every NVMe on.
    # runtime_pm's own dev replaced this one.
    dev=$work/devices/pci0000:00
    fn 0000:06:00.0 0x15b7 0x010802 nvme
    mkdir -p "$dev/0000:02:00.0/nvme/nvme2/nvme2n1/nvme2n1p1" "$dev/0000:06:00.0/nvme/nvme3/nvme3n1" \
        "$work/devices/virtual/block/dm-0/slaves" "$work/dev/mapper"
    ln -s "$dev/0000:02:00.0/nvme/nvme2/nvme2n1/nvme2n1p1" "$work/block/nvme2n1p1"
    ln -s "$dev/0000:02:00.0/nvme/nvme2/nvme2n1/nvme2n1p1" "$work/devices/virtual/block/dm-0/slaves/nvme2n1p1"
    ln -s "$work/devices/virtual/block/dm-0" "$work/block/dm-0"
    ln -s "$dev/0000:06:00.0/nvme/nvme3/nvme3n1" "$work/block/nvme3n1"
    : >"$work/node/dm-0"; : >"$work/node/nvme3n1"; : >"$work/node/sdz"
    ln -s "$work/node/dm-0" "$work/dev/mapper/pool"; ln -s "$work/node/nvme3n1" "$work/dev/nvme3n1"; ln -s "$work/node/sdz" "$work/dev/sdz"
    apply battery
    [ "$rc:$(pm 0000:02:00.0 0000:06:00.0)" = '0:auto auto ' ] || die 'unused NVMe control'
    apply ac
    printf '%s\n' "$work/dev/mapper/pool /var/lib/incus/storage-pools/default btrfs rw 0 0" 'proc /proc proc rw 0 0' \
        "$work/dev/gone /mnt ext4 ro 0 0" >"$work/mounts"
    printf 'Filename Type Size Used Priority\n%s partition 8388604 0 -2\n' "$work/dev/nvme3n1" >"$work/swaps"
    apply battery
    [ "$rc:$(pm 0000:02:00.0 0000:06:00.0 0000:00:0b.0)" = '0:on on auto ' ] || die "an NVMe under a mount or swap: $(pm 0000:02:00.0 0000:06:00.0)"
    apply ac
    printf '%s /mnt ext4 ro 0 0\n' "$work/dev/sdz" >"$work/mounts"; : >"$work/swaps"
    apply battery
    [ "$rc:$(pm 0000:02:00.0 0000:06:00.0 0000:00:0b.0)" = '0:on on auto ' ] || die 'an NVMe left on with an unresolved mount'
    apply ac
    rm "$work/mounts"
    apply battery 2>/dev/null
    [ "$rc:$(pm 0000:02:00.0 0000:06:00.0 0000:00:0b.0)" = '0:on on auto ' ] || die 'an NVMe left on without the mount list'
    apply ac
    : >"$work/mounts"
    # A function removed mid-loop is skipped; a refused policy is unsupported, noted once a boot; a missing policy
    # file is skipped.
    mkdir -p "$work/pci/0000:05:00.0/power"; printf 'on\n' >"$work/pci/0000:05:00.0/power/control"
    refuse=1
    : >"$work/power-log"
    apply battery 2>/dev/null
    [ "$rc:$(cat "$work/aspm"):$(pm 0000:00:0b.0)" = '0:[default] performance powersave powersupersave:auto ' ] || die 'a refused ASPM policy failed the run'
    apply ac; apply battery 2>/dev/null
    [ "$rc:$(grep -c 'write refused' "$work/power-log")" = 0:1 ] && [ -e "$work/aspm-refused" ] || die 'a refused ASPM policy not noted once'
    refuse=0
    rm "$work/aspm"
    apply ac
    [ "$rc:$(pm 0000:00:0b.0)" = '0:on ' ] && [ ! -e "$work/aspm" ] || die 'missing ASPM policy not skipped'
)
echo 'test-boot-privacy: battery ASPM and runtime PM passed'

# Power choices: none leaves the firmware alone, an invalid one skips only itself, a new one is synced.
sed -n '/^save_choice() {/,/^}/p; /^bad_choice() {/,/^}/p' "$power" |
    sed -e "s|/var/lib/convergent/power|$work/power-state|g" -e "s|/run/|$work/power-run/|g" >"$work/power-choice-lib"
sed -n '/^# No charge choice/,/^# Retry camera/p' "$power" | sed '$d' |
    sed "s|/var/lib/convergent/power/|$work/power-state/|g" >"$work/power-choices"
check_script "$work/power-choice-lib"
check_script "$work/power-choices"
grep -q "$work/power-state/thermal" "$work/power-choices" || die 'power choices extraction'
grep -q "$work/power-run/convergent-power.bad-" "$work/power-choice-lib" || die 'power choice marker extraction'
mkdir "$work/power-state" "$work/power-run"
(
    logger() { echo "$*" >>"$work/power-logged"; }
    sync() { printf '%s\n' "$1" >>"$work/power-synced"; }
    charge() { echo "charge $1" >>"$work/power-calls"; }
    thermal() { echo "thermal $1" >>"$work/power-calls"; }
    . "$work/power-choice-lib"
    choices() { rc=0; : >"$work/power-calls"; . "$work/power-choices" 2>/dev/null; }
    choices
    [ "$rc:$(cat "$work/power-calls")" = 0: ] || die 'no charge choice touched the firmware'
    : >"$work/power-state/charge"; echo balanced >"$work/power-state/thermal"
    choices
    [ "$rc:$(cat "$work/power-calls")" = '0:thermal balanced' ] || die 'empty charge choice stopped the run'
    echo 80 >"$work/power-state/charge"; echo hot >"$work/power-state/thermal"
    choices
    [ "$rc:$(cat "$work/power-calls")" = '0:charge 80' ] || die 'invalid thermal choice not skipped'
    # One warning a boot per invalid choice, not one per supply event; saving a new choice ends it.
    choices; choices
    printf -- '-p user.warning -t power invalid saved %s choice; set it again with sys power %s\n' charge charge thermal thermal |
        cmp -s - "$work/power-logged" || die 'invalid choice warnings'
    save_choice thermal balanced
    echo hot >"$work/power-state/thermal"
    choices
    [ "$(grep -c 'saved thermal choice' "$work/power-logged")" = 2 ] || die 'a saved choice kept the warning marker'
    save_choice charge 75
    [ "$(cat "$work/power-state/charge")" = 75 ] || die 'charge choice not saved'
    grep -q "^$work/power-state/\.choice\.[A-Za-z0-9]\{6\}$" "$work/power-synced" || die 'choice not synced before the rename'
)
echo 'test-boot-privacy: power choices passed'

# A manual profile survives supply events until the source changes, and is kept only once applied.
awk '/^case \$\{1:-\} in$/ {copy = 1} copy {print} /^# A manual profile is kept only once applied/ {last = 1}
    last && /^fi$/ {exit}' "$power" | sed "s|/run/|$work/power-run/|g" >"$work/power-source"
sed -n '/^set_limit() {/,/^}/p' "$power" >"$work/power-limit"
check_script "$work/power-source"
check_script "$work/power-limit"
grep -q "$work/power-run/convergent-power.manual" "$work/power-source" && [ "$(tail -n 1 "$work/power-source")" = 'fi' ] ||
    die 'power source extraction'
(
    . "$work/power-lib"
    . "$work/power-limit"
    logger() { :; }
    source_now() { echo "$fake"; }
    cpu=$work/power-cpu cap=0 run=$work/power-run p=$work/power-cpu/policy0
    mkdir -p "$p"
    echo 0 >"$p/affected_cpus"; echo powersave >"$p/scaling_governor"
    echo 4000000 >"$p/cpuinfo_max_freq"; echo 4000000 >"$p/scaling_max_freq"
    echo balance_performance >"$p/energy_performance_preference"
    # The run goes on past the profile (to the saved choices and the camera): its status is recorded after it.
    profile() {
        rm -f "$work/power-status"
        (rc=0 changed=0; set +e; . "$work/power-source"; echo "$rc" >"$work/power-status") 2>/dev/null
    }
    state() { echo "$(cat "$work/power-status") $(cat "$p/energy_performance_preference") $(cat "$run/convergent-power.profile")"; }
    fake=ac; profile battery
    [ "$(state):$(cat "$run/convergent-power.source"):$(cat "$run/convergent-power.manual")" = '0 balance_power battery:ac:battery' ] ||
        die 'manual profile not recorded'
    # A supply event on the same source applies it again.
    echo balance_performance >"$p/energy_performance_preference"
    profile
    [ "$(state)" = '0 balance_power battery' ] && [ -e "$run/convergent-power.manual" ] || die 'a supply event undid a manual profile'
    fake=battery; profile
    [ "$(state)" = '0 balance_power battery' ] && [ ! -e "$run/convergent-power.manual" ] || die 'a source change kept the manual profile'
    fake=ac; profile
    [ "$(state)" = '0 balance_performance ac' ] || die 'automatic profile'
    # A manual profile the hardware refuses is not kept, nor the manual one before it.
    profile battery
    rm "$p/energy_performance_preference"; mkdir "$p/energy_performance_preference"
    profile ac
    [ "$(cat "$work/power-status"):$(cat "$run/convergent-power.profile")" = 1:unknown ] &&
        [ ! -e "$run/convergent-power.manual" ] || die 'a failed manual profile was kept'
    rmdir "$p/energy_performance_preference"; echo power >"$p/energy_performance_preference"
    profile
    [ "$(state)" = '0 balance_performance ac' ] || die 'the source profile after a failed manual one'
)
echo 'test-boot-privacy: manual power profile passed'

# The bar's exit ends the sensor worker's awk and waits a bounded time for a worker stuck in a read.
sed -n '/^cleanup() {/,/^}/p' "$repo/tools/bar" >"$work/bar-cleanup"
check_script "$work/bar-cleanup"
(
    . "$work/bar-cleanup"
    work=$work/bar-work reader= alerts_pid= inputs_pid=
    mkdir "$work"
    # A read the kernel does not interrupt: TERM changes nothing.
    (trap '' TERM; exec sleep 30) >/dev/null 2>&1 & power_pid=$!
    { sleep 30 && :; } >/dev/null 2>&1 & sensors_pid=$!
    i=0
    until awk_pid=$(pgrep -P "$sensors_pid"); do [ "$i" -lt 50 ] || die 'sensor worker child'; sleep 0.1; i=$((i + 1)); done
    start=$(date +%s)
    cleanup
    [ "$(($(date +%s) - start))" -le 4 ] || die 'bar exit waited for a stuck worker'
    [ ! -e "$work" ] || die 'bar work directory kept'
    i=0
    while kill -0 "$awk_pid" 2>/dev/null && [ "$i" -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
    if kill -0 "$awk_pid" 2>/dev/null; then die 'sensor worker child outlived the bar'; fi
    kill -KILL "$power_pid" 2>/dev/null || :
)
echo 'test-boot-privacy: bar exit passed'

# devices allow warns for any HID interface, and names vendor-specific ones in any position.
sed -n '/^allow_usb() {/,/^}/p' "$repo/tools/devices" >"$work/allow-usb"
check_script "$work/allow-usb"
(
    . "$work/allow-usb"
    ask() { :; }
    logger() { :; }
    usbguard() {
        case $1 in
        list-devices) printf '7: block id 1234:5678 serial "" name "x" via-port "1-1" with-interface %s with-connect-type "hotplug"\n' "$iface" ;;
        allow-device) [ "$*" = 'allow-device -p 7' ] || exit 97 ;;
        *) exit 97 ;;
        esac
    }
    for iface in '{ 08:06:50 03:00:00 }' '03:01:01' '{ 08:06:50 ff:00:00 }' '08:06:50'; do
        allow_usb 7 >"$work/allow-out"
        case $iface in
        *03:*) grep -q '^WARNING: it has a HID interface' "$work/allow-out" || die "no HID warning for $iface" ;;
        *) if grep -q WARNING "$work/allow-out"; then die "HID warning for $iface"; fi ;;
