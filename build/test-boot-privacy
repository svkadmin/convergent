    END {exit (n != 1 || bad)}' "$dns/unbound.conf" || die 'RPZ query logging enabled'
echo 'test-boot-privacy: RPZ logging passed'

# Firewall cron jobs mail only failures, never overlap and log no job start (-q).
grep -qF 'cat /etc/convergent/crontab >>/etc/crontab' "$fw/install.site" || die 'firewall crontab not installed'
awk '/^[[:space:]]*(#|$)/ {next} {n++; if ($6 != "root" || $7 != "-nsq") bad=1}
    END {exit (!n || bad)}' "$fw/etc/convergent/crontab" || die 'firewall cron jobs lost -n, -s or -q'
# wan's busybox crond logs no job start (level 8) either; the build checks Alpine's script reads CRON_OPTS.
(. "$repo/guests/wan/rootfs/etc/conf.d/crond"; [ "$CRON_OPTS" = '-c /etc/crontabs -l 9' ]) || die 'wan crond logs job starts'
grep -qF "grep -q 'CRON_OPTS' \"\$target/etc/init.d/crond\" || die" "$repo/guests/wan/build" || die 'wan build ignores CRON_OPTS'
echo 'test-boot-privacy: firewall and wan cron logging passed'

# Real SHA-512 hashing and file replacement; tty and ownership operations are mocked.
(
    state=$work/recovery
    mkdir -p "$state/etc"
    stty() { :; }
    sync() { :; }
    chown() { printf 'chown %s\n' "$*" >>"$work/permissions"; }
    chmod() { printf 'chmod %s\n' "$*" >>"$work/permissions"; command chmod "$@"; }
    . "$repo/initramfs/90convergent/recovery-lib.sh"
    for scenario in valid minimum maximum short long mismatch no-owner two-owners no-shadow two-shadows bad-group; do
        printf 'root:x:0:0::/:/bin/sh\nowner:x:1000:1000::/home/owner:/bin/sh\nother:x:1001:1001::/:/bin/sh\n' >"$state/etc/passwd"
        printf 'root:x:0:\nshadow:x:42:\n' >"$state/etc/group"
        printf 'root:root-hash:1:2:3:4:5:6:7\nowner:old-hash:8:9:10:11:12:13:14\nother:other-hash:15:16:17:18:19:20:21\n' >"$state/etc/shadow"
        password='a fixture password' repeat=
        case $scenario in
        minimum) password=123456789012 ;;
        maximum) password=$(printf '%0256d' 0) ;;
        short) password=12345678901 ;;
        long) password=$(printf '%0257d' 0) ;;
        mismatch) repeat='different password' ;;
        no-owner) sed '/^owner:/d' "$state/etc/passwd" >"$work/passwd"; mv "$work/passwd" "$state/etc/passwd" ;;
        two-owners) echo 'second:x:1000:1000::/:/bin/sh' >>"$state/etc/passwd" ;;
        no-shadow) sed '/^owner:/d' "$state/etc/shadow" >"$work/shadow"; mv "$work/shadow" "$state/etc/shadow" ;;
        two-shadows) echo 'owner:duplicate:1:2:3:4:5:6:7' >>"$state/etc/shadow" ;;
        bad-group) echo 'shadow:x:bad:' >"$state/etc/group" ;;
        esac
        cp "$state/etc/shadow" "$work/before"
        : >"$work/permissions"
        printf '%s\n%s\n' "$password" "${repeat:-$password}" >"$work/input"
        if reset_password <"$work/input" >"$work/reset-log"; then
            case $scenario in valid|minimum|maximum) ;; *) die "accepted reset: $scenario" ;; esac
            grep -qx 'Password changed for owner.' "$work/reset-log"
            hash=$(awk -F: '$1 == "owner" {print $2}' "$state/etc/shadow")
            case $hash in '$6$'*) ;; *) die 'not SHA-512' ;; esac
            salt=${hash#\$6\$}; salt=${salt%%\$*}
            [ "$hash" = "$(printf '%s\n' "$password" | openssl passwd -6 -salt "$salt" -stdin)" ]
            sed 's/^owner:[^:]*:/owner:old-hash:/' "$state/etc/shadow" >"$work/restored"
            cmp "$work/before" "$work/restored"
            sed "s|$state/etc/.shadow\.[^ ]*|TEMP|" "$work/permissions" >"$work/actual"
            printf 'chown 0:42 TEMP\nchmod 0640 TEMP\n' >"$work/expected"
            cmp "$work/expected" "$work/actual"
        else
            case $scenario in valid|minimum|maximum) die "reset failed: $scenario" ;; esac
            cmp "$work/before" "$state/etc/shadow"
            [ ! -s "$work/permissions" ]
        fi
        for leftover in "$state/etc/".shadow.*; do [ ! -e "$leftover" ] || die 'reset left temporary shadow'; done
    done
)
echo 'test-boot-privacy: password reset passed'

# Redirect all camera paths; exec uses an explicit interpreter on noexec /tmp.
mkdir -p "$work/camera/run" "$work/camera/sys/module/videodev"
sed -n '/^camera_unload() {/,/^}/p; /^camera() {/,/^}/p' "$repo/tools/devices" |
    sed -e "s|/var/lib/convergent/devices|$work/camera/state|g" \
        -e "s|/run/convergent-camera|$work/camera/run/convergent-camera|g" \
        -e "s|/sys/|$work/camera/sys/|g" \
        -e "s|exec modprobe |exec sh \"$work/modprobe\" |" >"$work/camera-functions"
check_script "$work/camera-functions"
cat >"$work/modprobe" <<'EOF'
set -eu
printf '%s\n' "$*" >>"$work/modules"
case "$*" in
'-r videodev') printf 'choice=%s\n' "$(cat "$work/camera/state/camera")" >>"$work/modules"; exit 1 ;;
'--ignore-install uvcvideo'|'uvcvideo') ;;
*) exit 98 ;;
esac
EOF
check_script "$work/modprobe"
export work
(
    . "$work/camera-functions"
    flock() { :; }
    modprobe() { sh "$work/modprobe" "$@"; }
    usage() { exit 2; }
    : >"$work/modules"
    (camera on)
    [ "$(cat "$work/modules")" = uvcvideo ]
    [ "$(cat "$work/camera/state/camera")" = on ]
    : >"$work/modules"
    (camera load uvcvideo)
    [ "$(cat "$work/modules")" = '--ignore-install uvcvideo' ]
    : >"$work/modules"
    if (camera off) >"$work/off-log" 2>&1; then die 'busy camera reported disabled'; fi
    grep -q 'camera disabled for future loads' "$work/off-log"
    [ "$(cat "$work/camera/state/camera")" = off ]
    printf '%s\n' '-r videodev' 'choice=off' '-r videodev' 'choice=off' >"$work/expected"
    cmp "$work/expected" "$work/modules"
    : >"$work/modules"
    if (camera load uvcvideo) >"$work/load-log" 2>&1; then die 'loaded disabled camera'; fi
    grep -q 'camera is off' "$work/load-log"
    [ ! -s "$work/modules" ]
