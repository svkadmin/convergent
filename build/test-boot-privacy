echo 'test-boot-privacy: camera passed'

# Bluetooth: rfkill is the gate; off fails while a radio still reads unblocked, a failed on blocks again.
sed -n '/^bluetooth() {/,/^}/p; /^bluetooth_radio() {/,/^}/p; /^bluetooth_blocked() {/,/^}/p; /^bluetooth_block() {/,/^}/p' "$repo/tools/devices" |
    sed -e "s|/sys/class/rfkill/|$work/bt/rfkill/|g" -e "s|/run/convergent-bluetooth|$work/bt/convergent-bluetooth|g" \
        -e 's/rc-service /rc_service /' >"$work/bt-functions"
check_script "$work/bt-functions"
[ "$(grep -c 'rc_service bluetooth' "$work/bt-functions")" = 4 ] || die 'bluetooth extraction'
mkdir -p "$work/bt/rfkill/rfkill0" "$work/bt/rfkill/rfkill1"
echo wlan >"$work/bt/rfkill/rfkill0/type"; echo 0 >"$work/bt/rfkill/rfkill0/soft"
echo bluetooth >"$work/bt/rfkill/rfkill1/type"; echo 1 >"$work/bt/rfkill/rfkill1/soft"
(
    b=$work/bt
    . "$work/bt-functions"
    die() { echo "devices: $*" >&2; exit 1; }
    usage() { exit 2; }
    flock() { [ "$*" = '-x 8' ] || exit 97; }
    sleep() { :; }
    rfkill() {
        echo "rfkill $*" >>"$b/calls"
        case $* in
        'unblock bluetooth') echo 0 >"$b/rfkill/rfkill1/soft" ;;
        'block bluetooth') [ "$stuck" = yes ] || echo 1 >"$b/rfkill/rfkill1/soft" ;;
        *) exit 97 ;;
        esac
    }
    rc_service() {
        case $* in 'bluetooth start') : >"$b/running" ;; 'bluetooth stop') rm -f "$b/running" ;; 'bluetooth status') ;; *) exit 97 ;; esac
        echo "rc-service $*" >>"$b/calls"
        [ "$*" != 'bluetooth status' ] || [ -e "$b/running" ]
    }
    timeout() {
        [ "$1 $2 $3 $4" = '-k 1 10 bluetoothctl' ] || exit 97
        shift 3
        "$@"
    }
    # The adapter answers on the second try; power off fails (no adapter) and is tolerated.
    bluetoothctl() {
        echo "bluetoothctl $*" >>"$b/calls"
        case $* in
        show)
            shows=$((shows + 1))
            [ "$adapter" != interrupt ] || sh -c 'kill -TERM "$PPID"'
            [ "$adapter" = yes ] && [ "$shows" -ge 2 ] ;;
        'power on') ;;
        'power off') return 1 ;;
        *) exit 97 ;;
        esac
    }
    expect() { printf '%s\n' "$@" >"$b/expected"; cmp "$b/expected" "$b/calls"; : >"$b/calls"; }
    : >"$b/calls"
    stuck=no adapter=yes shows=0
    (bluetooth on)
    expect 'rfkill unblock bluetooth' 'rc-service bluetooth start' 'bluetoothctl show' 'bluetoothctl show' 'bluetoothctl power on'
    [ "$(cat "$b/rfkill/rfkill1/soft")" = 0 ]
    (bluetooth off)
    expect 'rc-service bluetooth status' 'bluetoothctl power off' 'rfkill block bluetooth' 'rc-service bluetooth stop'
    [ "$(cat "$b/rfkill/rfkill1/soft")" = 1 ]
    # bluetoothd stopped: off does not wait for it.
    echo 0 >"$b/rfkill/rfkill1/soft"; stuck=yes
    if (bluetooth off) 2>"$b/log"; then die 'Bluetooth off passed with the radio unblocked'; fi
    grep -q 'still reads unblocked' "$b/log"
    expect 'rc-service bluetooth status' 'rfkill block bluetooth' 'rc-service bluetooth stop'
    # No adapter: a bounded wait, then the radio is blocked again.
    stuck=no adapter=no
    if (bluetooth on) 2>"$b/log"; then die 'Bluetooth on passed without an adapter'; fi
    grep -q 'no Bluetooth adapter; the radio is blocked again' "$b/log"
    [ "$(grep -c '^bluetoothctl show$' "$b/calls")" = 10 ]
    [ "$(tail -n 2 "$b/calls" | tr '\n' ,)" = 'rfkill block bluetooth,rc-service bluetooth stop,' ] ||
        die 'a failed Bluetooth on left bluetoothd running'
    [ "$(cat "$b/rfkill/rfkill1/soft")" = 1 ]
    if (bluetooth on extra) 2>/dev/null; then die 'Bluetooth took an extra argument'; fi
    # Interrupted during the adapter wait: blocked again, bluetoothd stopped.
    : >"$b/calls"; adapter=interrupt shows=0
    if (bluetooth on) 2>/dev/null; then die 'Bluetooth on passed when interrupted'; fi
    [ "$(cat "$b/rfkill/rfkill1/soft")" = 1 ] || die 'an interrupted Bluetooth on left the radio unblocked'
    expect 'rfkill unblock bluetooth' 'rc-service bluetooth start' 'bluetoothctl show' 'rfkill block bluetooth' 'rc-service bluetooth stop'
    # No Bluetooth radio: on changes nothing.
    echo wlan >"$b/rfkill/rfkill1/type"
    if (bluetooth on) 2>"$b/log"; then die 'Bluetooth on passed without a radio'; fi
    grep -q 'no Bluetooth radio' "$b/log" || die 'Bluetooth on without a radio'
    [ ! -s "$b/calls" ] || die 'Bluetooth on acted without a radio'
    echo bluetooth >"$b/rfkill/rfkill1/type"
    # A radio that vanishes mid-loop counts as blocked.
    mkdir "$b/rfkill/rfkill2"
    (bluetooth off) || die 'a vanished radio failed Bluetooth off'
    expect 'rc-service bluetooth status' 'rfkill block bluetooth' 'rc-service bluetooth stop'
    rmdir "$b/rfkill/rfkill2"
)
echo 'test-boot-privacy: bluetooth passed'

# Wired role: Incus changes are bounded, and revoke or enrol drops a role no allow rule names any more.
sed -n '/^ic() {/p; /^wired() {/,/^}/p; /^enrol() (/,/^)/p; /^revoke() {/,/^}/p' "$repo/tools/devices" |
    sed -e "s|/run/convergent|$work/wired|g" -e "s|/sys/bus/usb/devices/|$work/wired/sys/|g" \
        -e '/\[ -t 0 \] || die/d' -e 's/rc-service /rc_service /' >"$work/wired-functions"
check_script "$work/wired-functions"
grep -q 'wired prune' "$work/wired-functions"
mkdir "$work/wired"
(
    w=$work/wired
    . "$work/wired-functions"
    die() { echo "devices: $*" >&2; exit 1; }
    usage() { exit 2; }
    ask() { :; }
    # A bounded wait: the scan's shared hold must not leave a role for a blocked NIC.
    flock() { [ "$*" = '-w 60 9' ] || exit 97; }
    logger() { :; }
    rc_service() { [ "$*" = 'usbguard restart' ] || exit 97; }
    role='{"type":"usb","vendorid":"0bda","productid":"8153","serial":"S1","required":"false"}'
    timeout() {
        case "$1 $2 $3 $4" in
        '-k 1 30 incus') [ "$6" = query ] || exit 97 ;;
        '-k 1 120 incus') [ "$8" = config ] || exit 97; echo "$*" >>"$w/calls" ;;
        *) exit 97 ;;
        esac
        shift 3
        "$@"
    }
    incus() {
        case $* in
        '--force-local query /1.0/instances/wan?project=default')
            printf '{"type":"virtual-machine","devices":{"wired-uplink":%s}}\n' "$(cat "$w/role")" ;;
        '--force-local --project default config device remove wan wired-uplink') echo null >"$w/role" ;;
        '--force-local --project default config device add wan wired-uplink usb vendorid=0bda productid=8153 serial=S1 required=false') ;;
        *) echo "unexpected incus: $*" >&2; exit 97 ;;
        esac
    }
    # Numbered as list-rules shows them; append-rule -a 0 puts a rule first.
    usbguard() {
        case $1 in
        list-rules) cat "$w/rules" ;;
        append-rule)
            [ "$2 $3" = '-a 0' ] || exit 97
            { echo "$(($(wc -l <"$w/rules") + 100)): $4"; cat "$w/rules"; } >"$w/rules.new"
            mv "$w/rules.new" "$w/rules" ;;
        remove-rule) grep -v "^$2: " "$w/rules" >"$w/rules.new"; mv "$w/rules.new" "$w/rules" ;;
        generate-policy) cat "$w/generated" ;;
        list-devices) [ "$2" = -a ] || exit 97; [ ! -e "$w/swapped" ] || return 0; printf '5: %s\n' "$nic" ;;
        *) exit 97 ;;
        esac
    }
    nic='allow id 0bda:8153 serial "S1" name "LAN" hash "h1" with-interface { ff:ff:00 }'
    kbd='allow id 046d:c31c serial "" name "Kbd" hash "h2" with-interface 03:01:01'
    reset() { echo "$role" >"$w/role"; printf '5: %s\n7: %s\n' "$kbd" "$nic" >"$w/rules"; : >"$w/calls"; }
    removed='-k 1 120 incus --force-local --project default config device remove wan wired-uplink'
    # sys wired remove goes through the bound.
    reset
    (wired remove)
    [ "$(cat "$w/calls")" = "$removed" ] || exit 1
    # Revoking another device keeps the role; revoking the NIC's only rule drops it, and says so.
    reset
    (revoke 5) >"$w/out"
    [ ! -s "$w/calls" ] && [ "$(cat "$w/role")" != null ] || exit 1
    reset
    (revoke 7) >"$w/out"
    [ "$(cat "$w/calls")" = "$removed" ] && [ "$(cat "$w/role")" = null ] || exit 1
    grep -q 'removed its role from wan' "$w/out" || exit 1
    # With no role, a failed re-add's record goes with the NIC's last rule; revoking another device keeps it.
    reset; echo null >"$w/role"; echo 'failed S1' >"$w/wired-heal"
    (revoke 5) >"$w/out"
    [ ! -s "$w/calls" ] && grep -qx 'failed S1' "$w/wired-heal" || exit 1
    reset; echo null >"$w/role"; echo 'failed S1' >"$w/wired-heal"
    (revoke 7) >"$w/out"
    [ ! -s "$w/calls" ] && [ ! -e "$w/wired-heal" ] && grep -q 'dropped its failed re-attach' "$w/out" || exit 1
    # No role and no record (the usual state): nothing to do, under errexit too.
    reset; echo null >"$w/role"; rm -f "$w/wired-heal"
    # Not in an || list, which would ignore errexit inside: a failed read must stop it before the marker.
    rm -f "$w/pruned"
    (set -e; wired prune; : >"$w/pruned") >"$w/out" 2>&1
    [ -e "$w/pruned" ] && [ ! -s "$w/calls" ] && [ ! -s "$w/out" ] || exit 1
    # Enrol without the NIC drops the role; with it, the role stays.
    printf '%s\n%s\n' "$kbd" "$nic" >"$w/generated"
    for answers in 'yes no' 'yes yes'; do
        reset
        printf '%s\n' $answers | (enrol) >"$w/out"
        case $answers in
        'yes no') [ "$(cat "$w/calls")" = "$removed" ] || exit 1 ;;
        *) [ ! -s "$w/calls" ] || exit 1 ;;
        esac
    done
    # attach takes the guests lock only after the owner's answer, and re-reads wan and the NIC under it (a NIC
    # deauthorized or no longer allowed while the prompt waited).
    mkdir -p "$w/sys/1-2"
    printf '0bda\n' >"$w/sys/1-2/idVendor"; printf '8153\n' >"$w/sys/1-2/idProduct"
    printf 'S1\n' >"$w/sys/1-2/serial"
    added='-k 1 120 incus --force-local --project default config device add wan wired-uplink usb vendorid=0bda productid=8153 serial=S1 required=false'
    for change in none role unauthorized swapped; do
        echo null >"$w/role"; : >"$w/calls"; : >"$w/order"; echo 1 >"$w/sys/1-2/authorized"; rm -f "$w/swapped"
        code=0
        (
            # wired sets its own role: keep the fixture's.
            set_role=$role
            ask() {
                echo ask >>"$w/order"
                case $change in
                role) echo "$set_role" >"$w/role" ;;
                unauthorized) echo 0 >"$w/sys/1-2/authorized" ;;
                swapped) : >"$w/swapped" ;;
                esac
            }
            flock() { [ "$*" = '-w 60 9' ] || exit 97; echo lock >>"$w/order"; }
            wired attach 0bda:8153 S1
        ) >/dev/null 2>&1 || code=$?
        [ "$(cat "$w/order")" = "$(printf 'ask\nlock')" ] || exit 1
        case $change in
        none) [ "$code" = 0 ] && [ "$(cat "$w/calls")" = "$added" ] || exit 1 ;;
        *) [ "$code" = 1 ] && [ ! -s "$w/calls" ] || exit 1 ;;
        esac
    done
)
echo 'test-boot-privacy: wired role bound and prune passed'

# Execute the shipped commands, substituting only the socket readiness probe.
