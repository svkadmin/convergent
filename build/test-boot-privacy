echo 'test-boot-privacy: camera passed'

# Wired role: Incus changes are bounded, and revoke or enrol drops a role no allow rule names any more.
sed -n '/^ic() {/p; /^wired() {/,/^}/p; /^enrol() (/,/^)/p; /^revoke() {/,/^}/p' "$repo/tools/devices" |
    sed -e "s|/run/convergent|$work/wired|g" -e "s|/sys/bus/usb/devices/|$work/wired/sys/|g" \
        -e '/\[ -t 0 \] || die/d' -e 's/rc-service /rc_service /' >"$work/wired-functions"
check_script "$work/wired-functions"
grep -q 'wired prune' "$work/wired-functions"
mkdir "$work/wired"
(
    w=$work/wired
    . "$work/wired-functions"
    die() { echo "devices: $*" >&2; exit 1; }
    usage() { exit 2; }
    ask() { :; }
    # A bounded wait: the scan's shared hold must not leave a role for a blocked NIC.
    flock() { [ "$*" = '-w 60 9' ] || exit 97; }
    logger() { :; }
    rc_service() { [ "$*" = 'usbguard restart' ] || exit 97; }
    role='{"type":"usb","vendorid":"0bda","productid":"8153","serial":"S1","required":"false"}'
    timeout() {
        case "$1 $2 $3 $4" in
        '-k 1 30 incus') [ "$6" = query ] || exit 97 ;;
        '-k 1 120 incus') [ "$8" = config ] || exit 97; echo "$*" >>"$w/calls" ;;
        *) exit 97 ;;
        esac
        shift 3
        "$@"
    }
    incus() {
        case $* in
        '--force-local query /1.0/instances/wan?project=default')
            printf '{"type":"virtual-machine","devices":{"wired-uplink":%s}}\n' "$(cat "$w/role")" ;;
        '--force-local --project default config device remove wan wired-uplink') echo null >"$w/role" ;;
        '--force-local --project default config device add wan wired-uplink usb vendorid=0bda productid=8153 serial=S1 required=false') ;;
        *) echo "unexpected incus: $*" >&2; exit 97 ;;
        esac
    }
    # Numbered as list-rules shows them; append-rule -a 0 puts a rule first.
    usbguard() {
        case $1 in
        list-rules) cat "$w/rules" ;;
        append-rule)
            [ "$2 $3" = '-a 0' ] || exit 97
            { echo "$(($(wc -l <"$w/rules") + 100)): $4"; cat "$w/rules"; } >"$w/rules.new"
            mv "$w/rules.new" "$w/rules" ;;
        remove-rule) grep -v "^$2: " "$w/rules" >"$w/rules.new"; mv "$w/rules.new" "$w/rules" ;;
        generate-policy) cat "$w/generated" ;;
        list-devices) [ "$2" = -a ] || exit 97; printf '5: %s\n' "$nic" ;;
        *) exit 97 ;;
        esac
    }
    nic='allow id 0bda:8153 serial "S1" name "LAN" hash "h1" with-interface { ff:ff:00 }'
    kbd='allow id 046d:c31c serial "" name "Kbd" hash "h2" with-interface 03:01:01'
    reset() { echo "$role" >"$w/role"; printf '5: %s\n7: %s\n' "$kbd" "$nic" >"$w/rules"; : >"$w/calls"; }
    removed='-k 1 120 incus --force-local --project default config device remove wan wired-uplink'
    # sys wired remove goes through the bound.
    reset
    (wired remove)
    [ "$(cat "$w/calls")" = "$removed" ] || exit 1
    # Revoking another device keeps the role; revoking the NIC's only rule drops it, and says so.
    reset
    (revoke 5) >"$w/out"
    [ ! -s "$w/calls" ] && [ "$(cat "$w/role")" != null ] || exit 1
    reset
    (revoke 7) >"$w/out"
    [ "$(cat "$w/calls")" = "$removed" ] && [ "$(cat "$w/role")" = null ] || exit 1
    grep -q 'removed its role from wan' "$w/out" || exit 1
    # Enrol without the NIC drops the role; with it, the role stays.
    printf '%s\n%s\n' "$kbd" "$nic" >"$w/generated"
    for answers in 'yes no' 'yes yes'; do
        reset
        printf '%s\n' $answers | (enrol) >"$w/out"
        case $answers in
        'yes no') [ "$(cat "$w/calls")" = "$removed" ] || exit 1 ;;
        *) [ ! -s "$w/calls" ] || exit 1 ;;
        esac
    done
    # attach takes the guests lock only after the owner's answer, and re-reads wan under it.
    mkdir -p "$w/sys/1-2"
    printf '0bda\n' >"$w/sys/1-2/idVendor"; printf '8153\n' >"$w/sys/1-2/idProduct"
    printf 'S1\n' >"$w/sys/1-2/serial"; echo 1 >"$w/sys/1-2/authorized"
    added='-k 1 120 incus --force-local --project default config device add wan wired-uplink usb vendorid=0bda productid=8153 serial=S1 required=false'
    for change in none role; do
        echo null >"$w/role"; : >"$w/calls"; : >"$w/order"
        code=0
        (
            # wired sets its own role: keep the fixture's.
            set_role=$role
            ask() { echo ask >>"$w/order"; [ "$change" = none ] || echo "$set_role" >"$w/role"; }
            flock() { [ "$*" = '-w 60 9' ] || exit 97; echo lock >>"$w/order"; }
            wired attach 0bda:8153 S1
        ) >/dev/null 2>&1 || code=$?
        [ "$(cat "$w/order")" = "$(printf 'ask\nlock')" ] || exit 1
        case $change in
        none) [ "$code" = 0 ] && [ "$(cat "$w/calls")" = "$added" ] || exit 1 ;;
        *) [ "$code" = 1 ] && [ ! -s "$w/calls" ] || exit 1 ;;
        esac
    done
)
echo 'test-boot-privacy: wired role bound and prune passed'

# Execute the shipped commands, substituting only the socket readiness probe.
sway=$repo/rootfs/etc/sway/config.d/convergent
sed -n "/^exec sh -c '.*DEFAULT_AUDIO_SOURCE@/s/^exec sh -c '\(.*\)'$/\1/p" "$sway" |
    sed 's/\[ -S /[ -e /' >"$work/mic-init"
sed -n 's/^bindsym --locked XF86AudioMicMute exec //p' "$sway" >"$work/mic-locked"
check_script "$work/mic-init"
check_script "$work/mic-locked"
(
    SWAYSOCK=$work/sway.sock
    touch "$SWAYSOCK"
    calls=0 sleeps=0 muted=0
    timeout() { [ "$1 $2 $3" = '-k 1 2' ] || die 'wrong mute timeout'; shift 3; "$@"; }
    sleep() { [ "$*" = 1 ] || die 'wrong mute delay'; sleeps=$((sleeps + 1)); [ "$sleeps" -le 2 ] || die 'mute never completed'; }
    wpctl() {
        [ "$*" = 'set-mute @DEFAULT_AUDIO_SOURCE@ 1' ] || die "unexpected wpctl: $*"
        calls=$((calls + 1))
        [ "$calls" -ge 3 ] || return 1
        muted=1
    }
    . "$work/mic-init"
    [ "$calls:$sleeps:$muted" = 3:2:1 ]
    rm "$SWAYSOCK"
    calls=0
    . "$work/mic-init"
    [ "$calls" = 0 ]
    # A source that appears late: 120 fast attempts, one log line, then every 30 s until it mutes.
    touch "$SWAYSOCK"
    calls=0 fast=0 slow=0 logs=0 muted=0
    sleep() {
        case $* in 1) fast=$((fast + 1)) ;; 30) slow=$((slow + 1)) ;; *) die "wrong mute delay: $*" ;; esac
        [ "$((fast + slow))" -le 200 ] || die 'mute loop never ended'
    }
    wpctl() {
        [ "$*" = 'set-mute @DEFAULT_AUDIO_SOURCE@ 1' ] || die "unexpected wpctl: $*"
        calls=$((calls + 1))
        [ "$calls" -gt 125 ] || return 1
        muted=1
    }
    logger() { [ "$1 $2" = '-t sway' ] || die "unexpected logger: $*"; logs=$((logs + 1)); }
    . "$work/mic-init"
    [ "$calls:$fast:$slow:$logs:$muted" = 126:119:6:1:1 ] || die "late source not muted: $calls:$fast:$slow:$logs:$muted"
    rm "$SWAYSOCK"

    . "$repo/rootfs/usr/lib/convergent/sys/30-audio"
    audio_session() { :; }
    onearg() { [ "$#" = 2 ]; answer=$2; }
    noargs() { [ "$#" = 0 ]; }
    run() { "$@"; }
    sys() { [ "$1" = audio ]; action=$2; shift 2; "audio_$action" "$@"; }
    wpctl() {
        calls=$((calls + 1))
        case "$*" in
        'set-mute @DEFAULT_AUDIO_SOURCE@ 1') muted=1 ;;
        'set-mute @DEFAULT_AUDIO_SOURCE@ 0') muted=0 ;;
        'set-mute @DEFAULT_AUDIO_SOURCE@ toggle') muted=$((1 - muted)) ;;
        *) die "unexpected wpctl: $*" ;;
        esac
    }
    # Prove the mock can unmute, then exercise both initial states.
    muted=1
    audio_micmute
    [ "$muted" = 0 ]
    for initial in 0 1; do
        muted=$initial calls=0
        . "$work/mic-locked"
        [ "$calls:$muted" = 1:1 ]
    done
)
echo 'test-boot-privacy: microphone passed'

# The browser keys name a failed launch's reason and leave no launch log behind.
sed -n -e "s/^bindsym Mod4+b exec sh -c '\(.*\)'$/\1/p" -e "s/^bindsym Mod4+Shift+t exec sh -c '\(.*\)'$/\1/p" "$sway" >"$work/browser-keys"
[ "$(wc -l <"$work/browser-keys")" = 2 ] || die 'browser key bindings not found'
check_script "$work/browser-keys"
(
    XDG_RUNTIME_DIR=$work/xdg-keys
    mkdir "$XDG_RUNTIME_DIR"
    swaynag() { printf '%s\n' "$*" >>"$work/nags"; }
    for result in 1 0; do
        browser() { echo "browser: $1 refused" >&2; return "$result"; }
        while IFS= read -r key; do (eval "$key"); done <"$work/browser-keys"
    done
    printf '%s\n' '-t warning -m browser: def refused' '-t warning -m browser: tmp refused' | cmp - "$work/nags" ||
        die 'browser key failure not named'
