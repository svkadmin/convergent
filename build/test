updates=$(wc -l <"$state/updates")
sh -x /usr/local/sbin/guests apply 2>/var/log/guests-update-apply.log || bad $LINENO
[ "$(wc -l <"$state/updates")" -gt "$updates" ] || bad $LINENO
grep -q '^+ ic rebuild candidate-svc svc$' /var/log/guests-update-apply.log || bad $LINENO
