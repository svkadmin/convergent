	bld mkfs.vfat -F 32 -n CV-ESP "${loop}p1" >/dev/null
	mount "${loop}p1" "$esp"
	mkdir -p "$esp/EFI/BOOT" "$esp/EFI/Linux" "$esp/loader"
	cp "$BUILDER/usr/lib/systemd/boot/efi/systemd-bootx64.efi" "$esp/EFI/BOOT/BOOTX64.EFI"
	printf 'timeout 0\neditor no\ndefault convergent-[0-9]*\n' >"$esp/loader/loader.conf"
}

install_rescue() {
	mkdir -p "$root"
	mount -t erofs -o ro,loop "$BUILDER/releases/$release/slot.img" "$root"
	cp "$root/usr/lib/convergent/rescue.efi" "$esp/EFI/Linux/convergent-rescue.efi" || die 'release has no rescue UKI'
	umount "$root"
	# Boot the shipped UKI; SMBIOS adds only the serial console, as in --update.
	printf 'timeout 0\neditor no\ndefault convergent-rescue.efi\n' >"$esp/loader/loader.conf"
	(cd "$esp/EFI/Linux" && sha256sum *.efi) >"$BUILDER$work/esp-before"
}

install_uki() {   # release slot counter
	rel=/releases/$1
	# Serial replaces quiet, ahead of init=, as in the single-release test.
	sed 's/ quiet / console=ttyS0,115200 /' "$BUILDER$rel/cmdline-$2" >"$BUILDER$work/cmdline"
	kver=$(awk '/^kernel / { print $2 }' "$BUILDER$rel/manifest")
	# The release's own metadata; older releases did not keep it.
	osr=$rel/os-release-$2
	[ -f "$BUILDER$osr" ] || osr=/image-root/usr/lib/os-release
	sed 's/ init=/ convergent.recovery=1 init=/' "$BUILDER$work/cmdline" >"$BUILDER$work/recovery-cmdline"
	bld ukify build --profile 'ID=recovery
TITLE=Recovery' --cmdline "@$work/recovery-cmdline" --os-release '' --output "$work/p1.efi" >/dev/null
	bld ukify build --linux "$rel/vmlinuz" --initrd "$rel/microcode.cpio" --initrd "$rel/initramfs.img" \
		--cmdline "@$work/cmdline" --os-release "@$osr" --uname "$kver" \
		--profile 'ID=main' --join-profile "$work/p1.efi" \
		--output "$work/esp/EFI/Linux/convergent-$1-$2$3.efi" >/dev/null
	rm "$BUILDER$work/p1.efi" "$BUILDER$work/recovery-cmdline"
}

run_vm() {
	goal=${1:-bless}
	memory=4096
	limit=300
	case $goal in guests) memory=8192; limit=3600 ;; guests-update | online) memory=8192; limit=7200 ;; desktop | update) limit=600 ;; esac
	runs=$((runs + 1))
	remaining=$((deadline - $(date +%s)))
	[ "$remaining" -gt 0 ] || die "total boot time expired"
	[ "$remaining" -le "$limit" ] || remaining=$limit
	log="$BUILDER$work/console-$runs.log"
	ln -sfn "console-$runs.log" "$BUILDER$work/console.log"
	echo "test: boot $runs ($mode), console: $log"
	# chroot execs Python, so the cleanup trap can reap its QEMU child.
	CVTEST_PASS="$pass" CVTEST_WORK="$work" CVTEST_RUN="$runs" CVTEST_TIMEOUT="$remaining" \
		CVTEST_GOAL="$goal" CVTEST_MEMORY="$memory" \
		chroot "$BUILDER" python3 - <<'EOF' &
import json, os, re, select, signal, socket, subprocess, time

work = os.environ["CVTEST_WORK"]
run = os.environ["CVTEST_RUN"]
goal = os.environ["CVTEST_GOAL"]
guest_test = goal in ("guests", "guests-update", "online", "desktop", "update")
marker = {"guests-update": b"CV-UPDATE-RESULT", "online": b"CV-ONLINE-RESULT", "desktop": b"CV-DESKTOP-RESULT", "update": b"CV-UPDATE-SIG-RESULT"}.get(goal, b"CV-GUESTS-RESULT")
pw = os.environ["CVTEST_PASS"].encode() + b"\n"
deadline = time.monotonic() + int(os.environ["CVTEST_TIMEOUT"])
path = f"{work}/qmp.sock"
if os.path.exists(path):
    os.unlink(path)

def interrupted(signum, frame):
    raise SystemExit(1)

for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(sig, interrupted)
qemu = subprocess.Popen([
    "qemu-system-x86_64", "-enable-kvm", "-machine", "q35", "-cpu", "host", "-smp", "4", "-m", os.environ["CVTEST_MEMORY"],
    "-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/edk2/OvmfX64/OVMF_CODE.fd",
    "-drive", f"if=pflash,format=raw,file={work}/vars.fd",
    "-drive", f"file={work}/disk.img,if=none,id=disk,format=raw", "-device", "virtio-blk-pci,drive=disk,bootindex=0",
    "-qmp", f"unix:{path},server=on,wait=off",
    "-nographic", "-monitor", "none"] +
    # Keep the signed UKI intact; the stub appends the serial console through SMBIOS.
    (["-no-reboot", "-smbios", "type=11,value=io.systemd.stub.kernel-cmdline-extra=console=ttyS0,,115200"] if goal in ("update", "rescue") else []) +
    # Guest tests get an Internet uplink (QEMU user networking) that the test bridges into wan as eth1.
    (["-netdev", "user,id=uplink", "-device", "virtio-net-pci,netdev=uplink,mac=52:54:00:c0:ff:ee,romfile="] if goal in ("guests", "guests-update", "online") else ["-nic", "none"]),
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
qmp = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
seen, messages = b"", b""
sent = ready = quitting = powered_off = rebooted = False
continued = False
prompted = None
ended = "stopped"
result = None

def command(name):
    qmp.sendall(json.dumps({"execute": name}).encode() + b"\n")

try:
    # Connect before reading the guest console, so no shutdown event can be missed.
    while True:
        try:
            qmp.connect(path)
            break
        except (FileNotFoundError, ConnectionRefusedError):
            if qemu.poll() is not None or time.monotonic() >= deadline:
                raise RuntimeError("QEMU did not open QMP")
            time.sleep(0.05)
    streams = [qemu.stdout, qmp]
    with open(f"{work}/console-{run}.log", "wb") as log:
        # Drain both streams after exit; the last read may contain the verdict.
        while streams:
            left = deadline - time.monotonic()
            if left <= 0:
                ended = "timeout"
                break
            for stream in select.select(streams, [], [], min(1, left))[0]:
                try:
                    chunk = os.read(stream.fileno(), 4096)
                except ConnectionResetError:   # QMP after quit
                    chunk = b""
                if not chunk:
                    streams.remove(stream)
                    continue
                if stream is qmp:
                    messages += chunk
                    while b"\n" in messages:
                        line, messages = messages.split(b"\n", 1)
                        event = json.loads(line)
                        if "QMP" in event:
                            command("qmp_capabilities")
                        if "return" in event:
                            ready = True
                        if event.get("event") == "SHUTDOWN":
                            powered_off |= event.get("data", {}).get("reason") == "guest-shutdown"
                            rebooted |= event.get("data", {}).get("reason") == "guest-reset"
                else:
                    log.write(chunk); log.flush()
                    seen = (seen + chunk)[-8192:]
                    if guest_test and result is None:
                        match = re.search(rb"(?:^|\n)" + marker + rb" ([0-9]+)\r?\n", seen)
                        if match:
                            result = int(match[1])
                    # Releases before 2026-10-18 print "Convergent passphrase".
                    if prompted is None and b"assphrase [" in seen:
                        prompted = time.monotonic()
                    if goal == "recovery" and sent and not continued and b"Recovery choice: " in seen:
                        qemu.stdin.write(b"3\n"); qemu.stdin.flush(); continued = True
                    if goal == "rescue" and sent and not continued and b"Rescue choice: " in seen:
                        qemu.stdin.write(b"7\n"); qemu.stdin.flush(); continued = True
            # A second after the prompt: under load a passphrase typed at once was lost.
            if not sent and prompted is not None and time.monotonic() - prompted >= 1:
                qemu.stdin.write(pw); qemu.stdin.flush(); sent = True
            done = result is not None if guest_test else re.search(rb"(?:^|\n)(?:convergent: )?release [0-9]+ is good\r?\n", seen)
            if goal == "recovery":
                done = done and continued
            if goal == "rescue":
                done = False  # Wait for guest poweroff, not a host-initiated quit.
            if ready and not quitting and done:
                # Both completion paths sync in the guest; quit flushes QEMU's disk writes.
                command("quit")
                quitting = True
        if ended != "timeout":
            qemu.wait(timeout=max(0.1, deadline - time.monotonic()))
            if qemu.returncode == 0:
                ended = "blessed" if quitting else "poweroff" if powered_off else "reboot" if rebooted else "stopped"
                if quitting and guest_test:
                    ended = f"{goal}-{result}"
finally:
    if qemu.poll() is None:
        qemu.kill()
    qemu.wait()
    with open(f"{work}/console-{run}.log", "ab") as log:
        log.write(qemu.stdout.read())
    qmp.close()
    with open(f"{work}/ended-{run}", "w") as result:
        result.write(ended + "\n")
print(f"test: VM ended: {ended}")
EOF
	driver=$!
	if wait "$driver"; then
		driver=''
	else
		driver=''
		case $goal in guests*) return 1 ;; esac
		die "QEMU driver failed; see $log"
	fi
	ended=$(cat "$BUILDER$work/ended-$runs")
}

blessed() {
	[ "$ended" = blessed ] && grep -qF "release $release is good" "$log"
}

refused() {
	[ "$ended" = poweroff ] && ! grep -q ' is good' "$log" &&
		grep -Eq 'verity:.*(data|metadata) block [0-9]+ is corrupted' "$log"
}

if [ "$mode" = guests-update ]; then
	test_guest_delivery
	make_broken_svc
fi
make_disk
[ "$mode" = rescue ] || write_slot "$release" 2
make_state
make_esp
case $mode in
boot | corrupt | recovery | rescue) install_uki "$release" a +3 ;;
*) install_uki "$release" a '' ;;
esac
# The recovery profile's entry id is the UKI's plus @ and its number or ID; only it has an @.
[ "$mode" != recovery ] || printf 'timeout 0\neditor no\ndefault convergent-*@*\n' >"$esp/loader/loader.conf"
[ "$mode" != rescue ] || install_rescue
umount "$esp"
[ "$mode" != corrupt ] || corrupt 2
detach
[ "$mode" != update ] || inject_update
cp "$BUILDER/usr/share/edk2/OvmfX64/OVMF_VARS.fd" "$BUILDER$work/vars.fd"
runs=0
case $mode in boot | corrupt | recovery | rescue | desktop | guests | guests-update | online) budget=300 ;; interrupt) budget=600 ;; update) budget=1200 ;; fallback) budget=1800 ;; esac
deadline=$(($(date +%s) + budget))
case $mode in update | recovery | rescue) run_vm "$mode" ;; *) run_vm ;; esac
case $mode in
boot) blessed || die "release $release did not bless; see $log" ;;
rescue)
	[ "$ended" = poweroff ] && grep -qF 'Convergent rescue: state at /run/cv-state' "$log" &&
		grep -qF 'Rescue choice: ' "$log" && ! grep -q ' is good' "$log" || die "rescue did not unlock and power off; see $log"
	open_state ro
	[ ! -e "$state/good" ] && [ ! -e "$state/highest" ] || die 'rescue blessed a release'
	for f in "$state"/var-*; do [ ! -e "$f" ] || die 'rescue prepared a slot /var'; done
	mount "${loop}p1" "$esp"
	(cd "$esp/EFI/Linux" && sha256sum *.efi) >"$BUILDER$work/esp-after"
	cmp "$BUILDER$work/esp-before" "$BUILDER$work/esp-after" || die 'rescue changed or counted the UKIs'
	umount "$esp"
	close_state
	;;
recovery)
	blessed || die "recovery did not continue and bless; see $log"
	grep -qF "Convergent recovery: release $release, slot a" "$log" || die "no recovery menu; see $log"
	attach
	mount "${loop}p1" "$esp"
	[ -f "$esp/EFI/Linux/convergent-$release-a.efi" ] || die 'recovery UKI was not blessed'
	for f in "$esp/EFI/Linux/"*+*.efi; do [ ! -e "$f" ] || die 'recovery boot counter remains'; done
	umount "$esp"
	detach
	;;
corrupt) refused || die "expected verity corruption and guest poweroff without blessing; see $log" ;;
update)
	[ "$ended" = reboot ] || die "signed update did not reboot ($ended); see $log"
	for line in 'unsigned refused' 'tampered refused' 'wrongkey refused' 'good written'; do
		tr -d '\r' <"$log" | grep -qx "CV-SIG $line" || die "expected CV-SIG $line; see $log"
	done
	grep -qF "release $release is good" "$log" || die "release $release did not bless; see $log"
	run_vm update
	[ "$runs" = 2 ] && [ "$ended" = update-0 ] &&
		grep -qF "release $other is good" "$log" &&
		tr -d '\r' <"$log" | grep -qx "booted  $other  slot b" || die "signed update did not bless slot B ($ended); see $log"
	;;
desktop)
	blessed || die "release $release did not bless; see $log"
	inject_desktop
	deadline=$(($(date +%s) + 600))
	vm_ok=1
	run_vm desktop || vm_ok=0
	[ "$vm_ok" = 1 ] || die "QEMU driver failed; see $log"
	[ "$ended" = desktop-0 ] || die "desktop smoke test failed ($ended); CV-DESKTOP lines in $log"
	;;
guests | guests-update | online)
	blessed || die "initial release $release did not bless; see $log"
	inject_guests
	if [ "$mode" = guests ]; then budget=3600; else budget=7200; fi
	deadline=$(($(date +%s) + budget))
	vm_ok=1
	run_vm "$mode" || vm_ok=0
	guest_logs
	[ "$vm_ok" = 1 ] || die "QEMU driver failed; see $log"
	[ "$ended" = "$mode-0" ] || die "$mode failed ($ended); see $log"
	;;
fallback | interrupt)
	blessed || die "initial release $release did not bless; see $log"
	# A has now made good, highest and var-<release> through the real boot path.
	attach
	if [ "$mode" = interrupt ]; then
		half=$(( $(stat -c %s "$BUILDER/releases/$other/slot.img") / 2 ))
		write_slot "$other" 3 "$half"
		detach
		run_vm
		blessed || die "A did not bless after the partial write; see $log"
	else
		write_slot "$other" 3
		corrupt 3
		mount "${loop}p1" "$esp"
		install_uki "$other" b +3
		# As install/install: newest entry first, exhausted entries last.
		printf 'timeout 0\neditor no\ndefault convergent-[0-9]*\n' >"$esp/loader/loader.conf"
		umount "$esp"
		detach
		failed=0
		for attempt in 1 2 3 4 5 6; do
			run_vm
			if blessed; then break; fi
			refused || die "B did not fail with verity and poweroff; see $log"
			failed=$((failed + 1))
		done
		blessed || die "A did not return within six attempts; see $log"
		[ "$failed" = 3 ] || die "expected three failed B boots, got $failed"
		attach
		mount "${loop}p1" "$esp"
		[ -f "$esp/EFI/Linux/convergent-$other-b+0-3.efi" ] || die "B's UKI is not exhausted (+0-3)"
		[ -f "$esp/EFI/Linux/convergent-$release-a.efi" ] || die "A's uncounted UKI is missing"
		umount "$esp"
		detach
	fi
	;;
esac
echo "test: $mode passed ($runs boots); disk, passphrase and consoles in $BUILDER$work"
