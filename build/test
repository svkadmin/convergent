    set -e
    printf 'yes\n' | sys firewall maintenance
    [ "$(cat /var/lib/convergent/firewall-maintenance)" = fw1 ]
    if guests update fw "$release/guests/fw" >"$release/maintenance-refusal" 2>&1; then exit 1; fi
    grep -q 'firewall maintenance is active' "$release/maintenance-refusal"
    fw1_state() { echo "CV-MAINT $1"; ic list fw1 -c ns -f csv; ic console fw1 --show-log 2>&1 | tail -n 25 | sed 's/^/CV-MAINT console /'; }
    ic restart fw1 --timeout 120 || { fw1_state "restart failed ($?)"; exit 1; }
    # Wait for OpenBSD's boot relinking: libraries before sshd, kernel after.
    deadline=$(($(date +%s) + 1800))
    until timeout 30 ssh -F /etc/convergent/ssh_config fw1 'rcctl check unbound && ! pgrep -f "/etc/[r]c|[r]eorder_kernel" >/dev/null'; do
        [ "$(date +%s)" -lt "$deadline" ] || { fw1_state 'boot or unbound not ready 30 minutes after the restart'; exit 1; }
        sleep 5
    done
    timeout 30 ssh -F /etc/convergent/ssh_config fw1 '/usr/local/libexec/convergent/fw-seed && test -f /etc/convergent/seeded/maintenance'
    for f in fw1 fw2; do
        case $f in fw1) want=BACKUP ;; fw2) want=MASTER ;; esac
        carp=$(timeout 30 ssh -F /etc/convergent/ssh_config "$f" ifconfig)
        printf '%s\n' "$carp" | awk -v want="$want" '/carp: / {n++; if ($2 != want) bad=1} END {exit !(n == 6 && !bad)}'
    done
    printf 'yes\n' | sys firewall undo
    timeout 30 ssh -F /etc/convergent/ssh_config fw1 'test ! -e /etc/convergent/seeded/maintenance'
)
