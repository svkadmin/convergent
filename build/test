	# eight times in the topology migration) about 18.8k. Each keeps that margin (~11%), up to the half hour.
	budget=$((budget + 3660))
	deadline=$(($(date +%s) + budget))
	vm_ok=1
	run_vm "$mode" || vm_ok=0
	cv_time guest-logs
