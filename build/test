cv_time() { echo "CV-TIME $1 $(($(date +%s) - test_start))"; }
# After a firewall boots: sshd answers, neither /etc/rc nor the kernel relink runs, and the CARP roles
# hold for two checks in a row. fw_settled [-t seconds] node[:master|:backup]... (default 2400 s);
# a node without a role must be uniform, fw1 and fw2 together one MASTER and one BACKUP.
fw_settled() {
    settle_start=$(date +%s) settle_limit=2400
    if [ "${1:-}" = -t ]; then settle_limit=$2; shift 2; fi
    settle_last=
    while :; do
        settle_seen= settle_ok=1 settle_masters=0
        for settle_spec do
            # A fresh connection proves sshd; the shared master can outlive a reboot.
            if settle_reply=$(timeout 60 ssh -n -F /etc/convergent/ssh_config -o ConnectTimeout=30 \
                -o ControlMaster=no -o ControlPath=none "${settle_spec%%:*}" \
                'if pgrep -f "/etc/[r]c|[r]eorder_kernel" >/dev/null; then echo busy; else ifconfig carp; fi' 2>/dev/null); then
                settle_role=$(printf '%s\n' "$settle_reply" | awk '$1 == "busy" {b=1} $1 == "carp:" {n++; s[$2]++}
                    END {print (b ? "busy" : !n ? "none" : s["MASTER"] == n ? "master" : s["BACKUP"] == n ? "backup" : "split")}')
            else settle_role=down; fi
            settle_seen="$settle_seen ${settle_spec%%:*}=$settle_role"
            case $settle_role in master) settle_masters=$((settle_masters + 1)) ;; backup) ;; *) settle_ok=0 ;; esac
            case $settle_spec in *:*) [ "$settle_role" = "${settle_spec#*:}" ] || settle_ok=0 ;; esac
        done
        [ "$#" = 1 ] || [ "$settle_masters" = 1 ] || settle_ok=0
        if [ "$settle_ok" = 1 ]; then
            [ "$settle_seen" != "$settle_last" ] || { echo "CV-SETTLE$settle_seen after $(($(date +%s) - settle_start)) s"; return 0; }
            settle_last=$settle_seen
        else settle_last=; fi
        [ "$(($(date +%s) - settle_start))" -lt "$settle_limit" ] ||
            { echo "CV-SETTLE not settled after $settle_limit s:$settle_seen"; return 1; }
        sleep 10
    done
}
EOF
	cp -a "$guests/." "$var/lib/convergent/test-release/guests/"
	# Remmina lifecycle fixture.
