#!/bin/sh
# EFI and abandoned-backup fixtures; no root or virtual machines.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-slot-backup: $*" >&2; exit 1; }
guid=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
export work guid
# Rescue refresh is best-effort only after the blessing commits.
for fn in ukis uki_release num num_strict put accept copy_rescue bless; do
    case $fn in
    uki_release|num|put) sed -n "/^$fn() {/p" "$repo/tools/slot" >"$work/$fn" ;;
    *) sed -n "/^$fn() {/,/^}/p" "$repo/tools/slot" >"$work/$fn" ;;
    esac
    [ -s "$work/$fn" ] || die "missing $fn"
    cat "$work/$fn"
done >"$work/bless-source"
sed -e "s|/usr/lib/convergent/rescue.efi|$work/rescue.efi|" \
    -e "s|/dev/console|$work/console|g" "$work/bless-source" >"$work/bless-functions"
sh -n "$work/bless-functions"
cat >"$work/bless-driver" <<'BLESS'
set -eu
fault=$1
esp=$work/bless/esp stm=$work/bless/state linux=EFI/Linux
die() { echo "$*" >&2; exit 1; }
log() { echo "$*"; }
booted() { release=123 slot=a; }
esp_mount() { :; }
state_mount() { :; }
healthy() { case $fault in health|cuthealth) return 1 ;; esac; }
disarm() { touch "$work/bless/disarmed"; }
prune() { :; }
sync() { :; }
mv() {
    case "$fault:$*" in
    highest:*'/highest.new '*|good:*'/good.new '*|rename:*'-a.efi.new '*|loader:*'/loader.conf.new '*) return 1 ;;
    # The counted UKI is copied, never renamed.
    *'+3.efi '*) exit 98 ;;
    esac
    command mv "$@"
}
cp() {
    if [ "$fault" = copy ] && [ "$1" = "$work/rescue.efi" ]; then
        [ "$(cat "$stm/highest")" = 123 ] && [ "$(cat "$stm/good")" = 123 ] || exit 97
        [ -f "$esp/$linux/convergent-123-a.efi" ] && [ -f "$work/bless/disarmed" ] || exit 97
        echo partial >"$2"
        return 1
    fi
    command cp "$@"
}
. "$work/bless-functions"
bless
BLESS
sh -n "$work/bless-driver"
# cut/differ: a power loss left both names of the booted release (a verified copy, or not).
# absent/malformed/unreadable: only a missing rollback floor reads as 0.
for fault in none health highest rename good loader copy cut differ cuthealth absent malformed unreadable; do
    rm -rf "$work/bless"
    esp=$work/bless/esp stm=$work/bless/state
    mkdir -p "$esp/EFI/Linux" "$esp/loader" "$stm"
    case $fault in
    absent) ;;
    malformed) echo 12x >"$stm/highest" ;;
    unreadable) mkdir "$stm/highest" ;;
    *) echo 122 >"$stm/highest" ;;
    esac
    echo 122 >"$stm/good"
    echo host >"$esp/EFI/Linux/convergent-123-a+3.efi"
    case $fault in
    cut|differ|cuthealth)
        mv "$esp/EFI/Linux/convergent-123-a+3.efi" "$esp/EFI/Linux/convergent-123-a+2-1.efi"
        echo host >"$esp/EFI/Linux/convergent-123-a.efi"
        [ "$fault" != differ ] || echo partial >"$esp/EFI/Linux/convergent-123-a.efi"
        ;;
    esac
    echo old >"$esp/EFI/Linux/convergent-rescue.efi"
    echo new >"$work/rescue.efi"
    echo 'default convergent-*' >"$esp/loader/loader.conf"
    if sh "$work/bless-driver" "$fault" >"$work/bless-out" 2>&1; then
        case $fault in none|loader|copy|cut|absent) ;; *) die "blessed despite $fault failure" ;; esac
    else
        case $fault in none|loader|copy|cut|absent) cat "$work/bless-out"; die "bless failed: $fault" ;; esac
        grep -qx 122 "$stm/good"
        case $fault in
        malformed|unreadable)
            grep -q 'cannot read the highest blessed release' "$work/bless-out" || die "bless $fault: no floor refusal"
            [ -f "$esp/EFI/Linux/convergent-123-a+3.efi" ] || die "bless $fault removed the counted UKI"
            [ "$fault" != malformed ] || grep -qx 12x "$stm/highest" ;;
        esac
        grep -qx old "$esp/EFI/Linux/convergent-rescue.efi"
        [ "$fault" != rename ] || [ -f "$esp/EFI/Linux/convergent-123-a+3.efi" ]
        [ "$fault" != differ ] || [ -f "$esp/EFI/Linux/convergent-123-a+2-1.efi" ]
        # A cut bless whose health checks then fail keeps its counted entry and the watchdog.
        [ "$fault" != cuthealth ] || { [ -f "$esp/EFI/Linux/convergent-123-a+2-1.efi" ] && [ ! -e "$work/bless/disarmed" ]; }
        [ ! -e "$esp/EFI/Linux/convergent-123-a.efi.new" ]
        continue
    fi
    grep -qx 123 "$stm/highest"
    grep -qx 123 "$stm/good"
    grep -qx host "$esp/EFI/Linux/convergent-123-a.efi"
    for f in "$esp"/EFI/Linux/convergent-123-a+* "$esp/EFI/Linux/convergent-123-a.efi.new"; do [ ! -e "$f" ]; done
    [ -f "$work/bless/disarmed" ]
    [ ! -e "$esp/EFI/Linux/convergent-rescue.efi.new" ]
    [ ! -e "$esp/loader/loader.conf.new" ]
    if [ "$fault" != none ] && [ "$fault" != cut ] && [ "$fault" != absent ]; then
        grep -qx old "$esp/EFI/Linux/convergent-rescue.efi"
        grep -q 'could not refresh rescue' "$work/bless-out"
        sh "$work/bless-driver" none >"$work/bless-out" 2>&1
    fi
    cmp "$work/rescue.efi" "$esp/EFI/Linux/convergent-rescue.efi"
    grep -qxF 'default convergent-[0-9]*' "$esp/loader/loader.conf"
done
echo 'test-slot-backup: committed blessing survives rescue failure and retries passed'
# Grafana's restored database must keep both secrets, including future seeds.
sed -n '/^# Keep Grafana/,/^done$/p' "$repo/tools/backup" |
    sed "s|/var/lib/convergent/guests/tls/|$work/tls/|" >"$work/backup-secrets"
[ -s "$work/backup-secrets" ] || die 'missing Grafana backup'
sed -n '/^# Restore Grafana secrets\.$/,/^# Grafana secrets restored\.$/p' "$repo/RECOVERY.md" |
    sed -e "s|state=/var/lib/convergent/guests|state=$work/host|" \
        -e "s|/etc/grafana/|$work/svc/|g" >"$work/restore-secrets"
[ -s "$work/restore-secrets" ] || die 'missing Grafana restore recipe'
sh -n "$work/backup-secrets"
sh -n "$work/restore-secrets"
(
    umask 077
    mkdir -p "$work/tls" "$work/svc" "$work/host/tls" "$work/host/seeds"
    for secret in admin-password secret-key; do
        printf 'original-%s\n' "$secret" >"$work/tls/$secret"
    done
    install() { [ "$1:$2" = -m:600 ] || exit 1; command install "$@"; }
    for fault in none missing empty; do
        payload=$work/payload-$fault
        mkdir "$payload"
        case $fault in
        missing) mv "$work/tls/secret-key" "$work/saved-key" ;;
        empty) : >"$work/tls/secret-key" ;;
        esac
        if [ "$fault" = none ]; then
            (set -e; . "$work/backup-secrets")
            for secret in admin-password secret-key; do
                cmp "$work/tls/$secret" "$payload/grafana-secrets/$secret"
            done
        else
            if payload=$payload sh -eu "$work/backup-secrets" 2>/dev/null; then die "accepted $fault secret"; fi
        fi
    done
    mv "$work/saved-key" "$work/tls/secret-key"
    backup=$work/payload-none
    export backup
    cat >"$work/restore-driver" <<'RESTORE'
    install() { [ "$1:$2" = -m:600 ] || exit 1; command install "$@"; }
    ic() {
        case $* in
        'config device show svc') if [ "$fault" = attached ]; then echo 'seed:'; fi ;;
        'start svc'|'exec svc -- rc-service grafana stop') echo "$*" >>"$work/restore-events" ;;
        'exec svc -- sh -eu -c '*)
            shift 6
            printf '%s\n' "$1" >"$work/install-secret"
            sh -n "$work/install-secret"
            (
                chown() { [ "$1" = root:grafana ] || exit 1; }
                chmod() { [ "$1" = 640 ] || exit 1; command chmod "$@"; }
                set -- "$3"
                . "$work/install-secret"
            ) ;;
        *) exit 1 ;;
        esac
    }
    losetup() {
        [ "$*" = "-j $work/host/seeds/svc.img" ] || exit 1
        if [ "$fault" = loop ]; then echo /dev/loop0; fi
    }
    sync() { :; }
    . "$work/restore-secrets"
RESTORE
    sh -n "$work/restore-driver"
    for fault in none uncached attached loop missing; do
        for secret in admin-password secret-key; do
            echo fresh >"$work/host/tls/$secret"
            echo fresh >"$work/svc/$secret"
        done
        touch "$work/host/seeds/svc.img" "$work/host/seeds/svc.sha256" "$work/host/seeds/svc.id"
        [ "$fault" != uncached ] || rm "$work/host/seeds/svc.img" "$work/host/seeds/svc.sha256"
        : >"$work/restore-events"
        [ "$fault" != missing ] || mv "$backup/grafana-secrets/secret-key" "$work/saved-key"
        if fault=$fault sh -eu "$work/restore-driver" >"$work/restore-output" 2>&1; then result=0
        else result=$?; fi
        if [ "$fault" = none ] || [ "$fault" = uncached ]; then
            [ "$result" = 0 ] || { cat "$work/restore-output"; exit 1; }
            for secret in admin-password secret-key; do
                cmp "$backup/grafana-secrets/$secret" "$work/host/tls/$secret"
                cmp "$backup/grafana-secrets/$secret" "$work/svc/$secret"
            done
            [ ! -e "$work/host/seeds/svc.img" ]
            [ ! -e "$work/host/seeds/svc.sha256" ]
            [ -f "$work/host/seeds/svc.id" ]
            printf 'start svc\nexec svc -- rc-service grafana stop\n' >"$work/expected"
            cmp "$work/expected" "$work/restore-events"
        else
            [ "$result" != 0 ] || die "accepted restore fault: $fault"
            [ ! -s "$work/restore-events" ]
            [ -f "$work/host/seeds/svc.img" ]
            for secret in admin-password secret-key; do
                grep -qx fresh "$work/host/tls/$secret"
                grep -qx fresh "$work/svc/$secret"
            done
        fi
        [ "$fault" != missing ] || mv "$work/saved-key" "$backup/grafana-secrets/secret-key"
    done
)
echo 'test-slot-backup: Grafana backup and restore secrets passed'
sed -n '/^cleanup() {/,/^}/p; /^rescue_next() {/,/^}/p' "$repo/tools/slot" |
    sed "s|/run/slot-next.XXXXXX|$work/next.XXXXXX|" >"$work/functions"
sed -n '/^[[:space:]]*# Clear persistent entry overrides/,/^[[:space:]]*log "release \$new is/p' "$repo/tools/slot" >"$work/finish"
grep -q 'Stage the UKI' "$work/finish" || die 'missing UKI staging'
cat >"$work/driver" <<'EOF'
set -eu
mode=$1 fault=$2
case_root=$work/case
vars=$case_root/vars
esp=$case_root/esp tmp=$case_root/tmp stm=$case_root/state
linux=EFI/Linux new=123 inactive=b mounted= oneshot=
mkdir -p "$vars" "$esp/$linux" "$tmp" "$stm"
# A non-empty directory: an unquoted glob in the entry would expand here.
cd "$case_root"
die() { echo "$*" >&2; exit 1; }
log() { echo "$*"; }
sync() { :; }
umount() { :; }
vars_mount() { [ "$fault" != mount ] || die 'mount failed'; }
esp_mount() { :; }
ukis() {
    case $fault in
    exhausted) echo "$esp/$linux/convergent-123-$1+0-3.efi" ;;
    good) echo "$esp/$linux/convergent-123-$1.efi" ;;
    *) echo "$esp/$linux/convergent-123-$1+3.efi" ;;
    esac
}
chattr() {
    echo "$*" >>"$case_root/flags"
    case "$fault:$1:${2##*/}" in
    unlock:-i:LoaderEntryOneShot-*|default:-i:LoaderEntryDefault-*|preferred:-i:LoaderEntryPreferred-*) return 1 ;;
    protect:+i:*)
        if [ ! -e "$case_root/retried" ]; then touch "$case_root/retried"; return 1; fi ;;
    esac
    case $1 in -i) command rm -f "$2.lock" ;; +i) touch "$2.lock" ;; *) exit 2 ;; esac
}
rm() {
    if [ "$#" = 1 ] && [ "${1%/*}" = "$vars" ]; then
        [ ! -e "$1.lock" ] && [ "$fault" != delete ] || return 1
    fi
    command rm "$@"
}
cat() {
    [ "$fault" != write ] || return 1
    [ ! -e "$vars/LoaderEntryOneShot-$guid.lock" ] || return 1
    command cat "$@"
}
. "$work/functions"
trap cleanup 0
trap 'exit 1' HUP INT TERM
if [ "$mode" = next ]; then
    if [ "$fault" != absent ]; then
        echo old >"$vars/LoaderEntryOneShot-$guid"
        touch "$vars/LoaderEntryOneShot-$guid.lock"
    fi
    rescue_next a
    rescue_next b
else
    echo UKI >"$tmp/uki"
    for name in LoaderEntryDefault LoaderEntryPreferred Unrelated; do
        echo old >"$vars/$name-$guid"
        touch "$vars/$name-$guid.lock"
    done
    [ "$mode" != rescue ] || rescue_target=b
    . "$work/finish"
fi
EOF
sh -n "$work/functions"
sh -n "$work/finish"
sh -n "$work/driver"
for mode in write rescue next; do
    case $mode in
    write) faults='none mount default preferred delete' ;;
    rescue) faults=none ;;
    next) faults='none absent exhausted good unlock write protect' ;;
    esac
    for fault in $faults; do
        rm -rf "$work/case"
        if sh "$work/driver" "$mode" "$fault" >"$work/out" 2>"$work/error"; then
            case $fault in none|absent|exhausted|good) ;; *) die "accepted $mode/$fault" ;; esac
        else
            case $fault in none|absent|exhausted|good) cat "$work/error"; die "failed $mode/$fault" ;; esac
            if grep -q 'release 123 is\|next boot:' "$work/out"; then die 'reported failed operation as successful'; fi
        fi
        vars=$work/case/vars
        if [ "$mode" = next ]; then
            [ -e "$vars/LoaderEntryOneShot-$guid.lock" ] || die 'one-shot left mutable'
            case $fault in none|absent|exhausted|good)
                # Systemd-boot fnmatches OneShot: the ID with or without its counter, not recovery or slot a.
                glob=$(tail -c +5 "$vars/LoaderEntryOneShot-$guid" | tr -d '\000')
                for id in convergent-123-b.efi convergent-123-b+0-3.efi; do
                    # shellcheck disable=SC2254
                    case $id in $glob) ;; *) die "one-shot $glob misses $id" ;; esac
                done
                for id in convergent-123-b.efi@recovery convergent-123-a.efi convergent-1234-b.efi; do
                    # shellcheck disable=SC2254
                    case $id in $glob) die "one-shot $glob matches $id" ;; esac
                done
                printf '\007\000\000\000' >"$work/expected"
                for char in c o n v e r g e n t - 1 2 3 - b '*' . e f i; do printf '%s\000' "$char"; done >>"$work/expected"
                printf '\000\000' >>"$work/expected"
                cmp "$work/expected" "$vars/LoaderEntryOneShot-$guid"
                ;; esac
        else
            [ -f "$vars/Unrelated-$guid.lock" ]
            # A failed clearing must not leave a three-try entry behind a pinned override.
            uki=$work/case/esp/EFI/Linux/convergent-123-b+3.efi
            case $fault in none) [ -f "$uki" ] ;; *) [ ! -e "$uki" ] && [ ! -e "$uki.new" ] || die "UKI installed after $fault failed" ;; esac
            for name in LoaderEntryDefault LoaderEntryPreferred; do
                if [ "$mode:$fault" = write:none ]; then [ ! -e "$vars/$name-$guid" ]; fi
                if [ "$mode" = rescue ]; then [ -e "$vars/$name-$guid.lock" ]; fi
            done
        fi
    done
done
grep -q 'inst_multiple .* chattr' "$repo/initramfs/91convergent-rescue/module-setup.sh"

# Retain the audit directory before dropping the state mount; every setup failure stops boot.
sed -n '/^# Audit watches need/,$p' "$repo/initramfs/90convergent/convergent-state.sh" >"$work/audit"
[ -s "$work/audit" ] || die 'missing audit backing directory'
sh -n "$work/audit"
(
    NEWROOT=$work/root state=$work/state
    audit=$NEWROOT/var/lib/convergent/audit
    mkdir() { echo "mkdir $*" >>"$work/calls"; [ "$fault" != mkdir ]; }
    chown() { echo "chown $*" >>"$work/calls"; [ "$fault" != chown ]; }
    chmod() { echo "chmod $*" >>"$work/calls"; [ "$fault" != chmod ]; }
    mount() { echo "mount $*" >>"$work/calls"; [ "$fault" != mount ]; }
    umount() { echo "umount $*" >>"$work/calls"; }
    for fault in none mkdir chown chmod mount; do
        : >"$work/calls"
        if (set +e; . "$work/audit") 2>"$work/error"; then
            [ "$fault" = none ] || die "accepted audit $fault failure"
        else
            [ "$fault" != none ] || die 'audit setup failed'
            grep -q 'could not retain the audit backing directory' "$work/error"
            if grep -q '^umount ' "$work/calls"; then die 'continued after audit failure'; fi
            continue
        fi
        printf '%s\n' "mkdir -p $audit" "chown 0:0 $audit" "chmod 0700 $audit" \
            "mkdir -p $audit/etc" "mount --bind $state/etc $audit/etc" "umount $state" >"$work/expected"
        cmp "$work/expected" "$work/calls"
    done
)
rules=$repo/rootfs/etc/audit/rules.d/10-convergent.rules
for entry in passwd shadow group gshadow subuid subgid usbguard/rules.conf; do
    key=identity; [ "$entry" != usbguard/rules.conf ] || key=usb
    grep -qx -- "-w /var/lib/convergent/audit/etc/$entry -p wa -k $key" "$rules"
done
if grep -q '^-w /etc/' "$rules"; then die 'audit watches covered inodes'; fi
echo 'test-slot-backup: audit backing directory, failure gates and watches passed'

# Run the boot cleanup, including both locations and the legacy empty placeholder.
sed -n '/^# As in backup:/,/^# Prepare this release/p' "$repo/initramfs/90convergent/convergent-state.sh" >"$work/boot-cleanup"
[ -s "$work/boot-cleanup" ] || die 'missing boot cleanup'
sh -n "$work/boot-cleanup"
state=$work/state
mkdir -p "$state/var-1"
btrfs() {
    [ "$1" = subvolume ] || return 1
    case $2 in
    show) [ -f "$3/snapshot" ] ;;
    delete) { [ "${fault:-}" != delete ] || [ "$3" != "${bad:-}/home" ]; } && rm "$3/snapshot" && rmdir "$3" ;;
    *) return 1 ;;
    esac
}
for base in "$state" "$state/var-1"; do
    mkdir -p "$base/.backup.123456/home" "$base/.backup.empty1/home"
    touch "$base/.backup.123456/home/snapshot"
done
. "$work/boot-cleanup"
for base in "$state" "$state/var-1"; do
    [ ! -e "$base/.backup.123456" ] && [ ! -e "$base/.backup.empty1" ]
done
# A leftover that stays is warned about and skipped; the next one is still removed and boot goes on.
warn() { echo "$*" >&2; }
for fault in delete nonempty symlink home-link; do
    bad=$state/.backup.123456
    mkdir -p "$bad/home" "$work/keep" "$state/.backup.zzzzzz/home"
    echo keep >"$work/keep/data"
    touch "$state/.backup.zzzzzz/home/snapshot"
    case $fault in
    delete) touch "$bad/home/snapshot" ;;
    nonempty) touch "$bad/home/data" ;;
    symlink) rmdir "$bad/home" "$bad"; ln -s "$work/keep" "$bad"; [ -L "$bad" ] ;;
    home-link) rmdir "$bad/home"; ln -s "$work/keep" "$bad/home"; [ -L "$bad/home" ] ;;
    esac
    (. "$work/boot-cleanup") 2>"$work/error" || { cat "$work/error"; die "cleanup $fault stopped boot"; }
    grep -q "cannot remove abandoned snapshot $bad" "$work/error" || die "cleanup $fault left no warning"
    [ -f "$work/keep/data" ]
    [ -e "$bad" ] || [ -L "$bad" ] || die "cleanup $fault removed the leftover anyway"
    [ ! -e "$state/.backup.zzzzzz" ] || die "cleanup $fault stopped before the next leftover"
    rm -rf "$bad"
done
grep -q 'inst_multiple .* rmdir ' "$repo/initramfs/90convergent/module-setup.sh"

# Instance archives must exclude dependent disks; volumes are exported separately.
sed -n '/^[[:space:]]*ic export /p' "$repo/tools/backup" >"$work/export"
[ -s "$work/export" ]
sh -n "$work/export"
ic() { [ "$*" = 'export container /payload/projects/owner/instance-container.tar.gz --root-only --compression gzip' ]; }
name=container payload=/payload project=owner
. "$work/export"
echo 'test-slot-backup: EFI selection, failure cleanup, boot snapshots and root-only export passed'

# One laptop per backup disk: any generation marked by another machine refuses the run.
sed -n '/^# Pruning goes by name: one laptop per disk/,/^done$/p' "$repo/tools/backup" |
    sed "s|/etc/machine-id|$work/machine-id|" >"$work/backup-owner"
[ -s "$work/backup-owner" ] || die 'missing backup owner check'
sh -n "$work/backup-owner"
grep -qxF 'printf '\''%s\n'\'' "$machine" >"$payload/machine-id"' "$repo/tools/backup" || die 'backup writes no machine-id'
this=0123456789abcdef0123456789abcdef other=fedcba9876543210fedcba9876543210
for sample in empty legacy same other dangling invalid; do
    dir=$work/owner-$sample
    mkdir -p "$dir/backup-20260101T000000Z" "$dir/backup-20260102T000000Z"
    echo "$this" >"$work/machine-id"
    case $sample in
    empty) rm -r "$dir"/backup-* ;;
    same) echo "$this" >"$dir/backup-20260102T000000Z/machine-id" ;;
    # The newest is ours; an older one is not.
    other) echo "$this" >"$dir/backup-20260102T000000Z/machine-id"
        echo "$other" >"$dir/backup-20260101T000000Z/machine-id" ;;
    dangling) ln -s "$work/missing" "$dir/backup-20260102T000000Z/machine-id" ;;
    invalid) echo not-hex >"$work/machine-id" ;;
    esac
    rc=0
    (
        base=$dir
        die() { echo "$*" >&2; exit 1; }
        . "$work/backup-owner"
    ) 2>"$work/owner-error" || rc=$?
    case $sample in
    empty|legacy|same) [ "$rc" = 0 ] ;;
    other|dangling) [ "$rc" = 1 ] && grep -q "holds another laptop's backups" "$work/owner-error" ;;
    invalid) [ "$rc" = 1 ] && grep -qx 'invalid machine id' "$work/owner-error" ;;
    esac || { cat "$work/owner-error"; die "backup owner check: $sample"; }
done
echo 'test-slot-backup: one laptop per backup disk passed'

# The minute check holds the guests lock shared for seconds: backup waits for it (it lost the 0.1.6 smoke test).
sed -n '/^exec 8>\/run\/convergent\/guests.lock$/,/^flock .* 8 || die /p' "$repo/tools/backup" |
    sed "s|/run/convergent/guests.lock|$work/guests.lock|" >"$work/backup-lock"
[ "$(grep -c . "$work/backup-lock")" -ge 2 ] || die 'missing backup guests lock'
sh -n "$work/backup-lock"
for sample in shared held; do
    rm -f "$work/held"
    # held: an exclusive holder past a 1 s bound must still refuse.
    case $sample in shared) mode=-s hold=3 source=$work/backup-lock ;;
    held) mode=-x hold=4 source=$work/backup-lock-short
        sed 's/flock -w 120 8/flock -w 1 8/' "$work/backup-lock" >"$source"
        grep -q 'flock -w 1 8' "$source" || die 'backup guests lock bound not found' ;;
    esac
    ( exec 7>"$work/guests.lock"; flock "$mode" 7; : >"$work/held"; sleep "$hold" ) &
    holder=$!
    n=0
    until [ -e "$work/held" ]; do [ "$n" -lt 50 ] || die 'lock holder did not start'; n=$((n + 1)); sleep 0.1; done
    begin=$(date +%s) rc=0
    (
        die() { echo "$*" >&2; exit 1; }
        . "$source"
    ) 2>"$work/lock-error" || rc=$?
    waited=$(($(date +%s) - begin))
    wait "$holder"
    case $sample in
    shared) [ "$rc" = 0 ] && [ "$waited" -ge 2 ] ;;
    held) [ "$rc" = 1 ] && grep -qx 'a guest operation is running' "$work/lock-error" ;;
    esac || { cat "$work/lock-error"; die "backup guests lock: $sample (rc $rc after ${waited}s)"; }
done
# Only the exports hold it: self-heal and the wired re-attach run during the home tar and the readback.
awk '/^exec 8>\/run\/convergent\/guests.lock$/ {lock = NR} /-cpf "\$payload\/home.tar" home$/ {tar = NR}
    /^exec 8>&- 6>&-$/ {free = NR} /^# Read every written byte back/ {readback = NR}
    END {exit !(tar && lock > tar && free > lock && readback > free)}' "$repo/tools/backup" ||
    die 'backup holds the guests lock outside the exports'
echo 'test-slot-backup: backup waits out the minute check'\''s guests lock passed'

# Backup writes absolute paths: no ancestor of the destination may be renamable by another user.
sed -n '/^# Later writes use absolute paths/,/^done$/p' "$repo/tools/backup" >"$work/backup-ancestors"
grep -q '^while ' "$work/backup-ancestors" || die 'missing backup ancestor check'
sh -n "$work/backup-ancestors"
mkdir -p "$work/open/media" "$work/owned/media" "$work/sticky/media"
chmod 0777 "$work/open"
chmod 1777 "$work/sticky"
samples='system open'
if [ "$(id -u)" = 0 ]; then chown 1000 "$work/owned"; samples="$samples owned sticky"; fi
for sample in $samples; do
    case $sample in system) dest=/usr/share ;; *) dest=$work/$sample/media ;; esac
    rc=0
    (
        die() { echo "$*" >&2; exit 1; }
        . "$work/backup-ancestors"
    ) 2>"$work/ancestor-error" || rc=$?
    case $sample in
    system|sticky) [ "$rc" = 0 ] ;;
    *) [ "$rc" = 1 ] && grep -qxF "destination ancestor $work/$sample must be root-owned and not writable by others" "$work/ancestor-error" ;;
    esac || { cat "$work/ancestor-error"; die "backup ancestor check: $sample (rc $rc)"; }
done
echo 'test-slot-backup: backup destination ancestors passed'

# Exports: bounded listings without guest state; default-project volumes without update snapshots.
sed -n '/^for project in default "\$owner"; do$/,/^done$/p' "$repo/tools/backup" >"$work/backup-exports"
grep -q 'storage volume export' "$work/backup-exports" || die 'missing backup exports'
sh -n "$work/backup-exports"
cat >"$work/exports-driver" <<'EXPORTS'
set -eu
fault=$1 calls=$2 work=$3 source=$4
owner=owner payload=$work/data
mkdir -p "$payload/projects"
: >"$payload/EXCLUDED"
die() { echo "$*" >&2; exit 1; }
ic() {
    echo "$project: $*" >>"$calls"
    case $* in
    'profile list --format json') echo '[]' ;;
    'storage list --format csv -c n') echo default ;;
    'storage volume list default --format json')
        if [ "$project" = default ]; then
            for v in svc-metrics svc-logs svc-grafana browser-def-state browser-int-state share; do
                printf '{"type":"custom","name":"%s","content_type":"filesystem"}\n' "$v"
            done | jq -s .
        else echo '[{"type":"custom","name":"state","content_type":"filesystem"}]'; fi ;;
    'storage volume export '*|'export '*) ;;
    *) exit 97 ;;
    esac
}
# timeout execs a binary: only this stand-in reaches the incus mock.
timeout() {
    echo "timeout $*" >>"$calls"
    [ "$1 $2 $3 $4 $5" = '-k 1 30 incus --force-local' ] || exit 97
    case "$fault:$6" in share:list|owner:query) return 124 ;; esac
    shift 3
    "$@"
}
incus() {
    case $* in
    '--force-local query /1.0/instances?recursion=1&project=owner')
        echo '[{"name":"c1","type":"container"},{"name":"v1","type":"virtual-machine"}]' ;;
    '--force-local list --all-projects --fast --format json')
        echo '[{"status":"Stopped","expanded_devices":{"share":{"type":"disk","pool":"default","source":"share"}}}]' ;;
    *) exit 97 ;;
    esac
}
. "$source"
EXPORTS
sh -n "$work/exports-driver"
for fault in none share owner; do
    rm -rf "$work/exports"
    mkdir "$work/exports"
    p=$work/exports/data/projects
    : >"$work/export-calls"
    rc=0
    sh "$work/exports-driver" "$fault" "$work/export-calls" "$work/exports" "$work/backup-exports" 2>"$work/export-error" || rc=$?
    case $fault in
    none)
        {
            echo 'default: storage list --format csv -c n'
            echo 'default: storage volume list default --format json'
            for v in svc-metrics svc-logs svc-grafana browser-def-state browser-int-state; do
                echo "default: storage volume export default $v $p/default/default/$v.tar.gz --compression gzip --volume-only"
            done
            echo 'timeout -k 1 30 incus --force-local list --all-projects --fast --format json'
            echo "default: storage volume export default share $p/default/default/share.tar.gz --compression gzip --volume-only"
            echo 'owner: profile list --format json'
            echo 'timeout -k 1 30 incus --force-local query /1.0/instances?recursion=1&project=owner'
            echo "owner: export c1 $p/owner/instance-c1.tar.gz --root-only --compression gzip"
            echo 'owner: storage list --format csv -c n'
            echo 'owner: storage volume list default --format json'
            echo "owner: storage volume export default state $p/owner/default/state.tar.gz --compression gzip"
        } >"$work/expected"
        [ "$rc" = 0 ] && cmp "$work/expected" "$work/export-calls" && grep -qx 'instance v1' "$work/exports/data/EXCLUDED" ;;
    share) [ "$rc" = 1 ] && grep -qx 'Incus did not list the share users' "$work/export-error" &&
        if grep -q 'export default share ' "$work/export-calls"; then false; fi ;;
    owner) [ "$rc" = 1 ] && grep -qx 'Incus did not list the owner instances' "$work/export-error" &&
        if grep -q '^owner: export ' "$work/export-calls"; then false; fi ;;
    esac || { cat "$work/export-error" "$work/export-calls"; die "backup exports: $fault (rc $rc)"; }
done
echo 'test-slot-backup: bounded backup listings and volume-only guest exports passed'

# The readback follows a checked syncfs and a page-cache drop, so it reads the disk.
sed -n '/^# Read every written byte back/,/^rm "\$work\/archives"$/p' "$repo/tools/backup" |
    sed "s|/proc/sys/vm/drop_caches|$work/drop_caches|" >"$work/backup-readback"
grep -q "$work/drop_caches" "$work/backup-readback" || die 'missing backup readback'
sh -n "$work/backup-readback"
grep -qxF 'sync -f "$base" || die '\''backup write failed'\''' "$repo/tools/backup" || die 'backup publishes without a checked sync'
for fault in none sync; do
    rm -rf "$work/readback" "$work/drop_caches"
    mkdir -p "$work/readback/data"
    echo data >"$work/readback/data/file"
    : >"$work/sync-calls"
    rc=0
    (
        payload=$work/readback/data calls=$work/sync-calls source=$work/backup-readback
        work=$work/readback
        die() { echo "$*" >&2; exit 1; }
        sync() { echo "sync $*" >>"$calls"; [ "$fault" != sync ]; }
        . "$source"
    ) 2>"$work/readback-error" || rc=$?
    echo "sync -f $work/readback/data" >"$work/expected"
    case $fault in
    none) [ "$rc" = 0 ] && grep -qx 1 "$work/drop_caches" && [ -s "$work/readback/data/SHA256SUMS" ] ;;
    sync) [ "$rc" = 1 ] && grep -qx 'backup write failed' "$work/readback-error" && [ ! -e "$work/drop_caches" ] ;;
    esac && cmp "$work/expected" "$work/sync-calls" || { cat "$work/readback-error"; die "backup readback: $fault (rc $rc)"; }
done
echo 'test-slot-backup: backup readback after syncfs and cache drop passed'

# Rescue must authenticate even when the ordinary writer's bypass is set.
sed -n '/^write() {/,/^}/p' "$repo/tools/slot" |
    sed "s|/run/slot-write.XXXXXX|$work/write.XXXXXX|" >"$work/write"
[ -s "$work/write" ]
sh -n "$work/write"
mkdir "$work/release"
for f in slot.img convergent-42-a.efi convergent-42-b.efi; do echo "$f" >"$work/release/$f"; done
(
    cd "$work/release"
    echo 'release 42'
    sha256sum -t slot.img convergent-42-a.efi convergent-42-b.efi
) >"$work/manifest"
openssl genpkey -algorithm ed25519 -out "$work/key"
openssl genpkey -algorithm ed25519 -out "$work/wrong-key"
openssl pkey -in "$work/key" -pubout -out "$work/pub"
for fault in signed missing wrong-key tampered; do
    cp "$work/manifest" "$work/release/manifest"
    signing_key=$work/key
    [ "$fault" != wrong-key ] || signing_key=$work/wrong-key
    openssl pkeyutl -sign -inkey "$signing_key" -rawin -in "$work/release/manifest" -out "$work/release/manifest.sig"
    case $fault in
    missing) rm "$work/release/manifest.sig" ;;
    tampered) echo '# changed' >>"$work/release/manifest" ;;
    esac
    : >"$work/mutations"
    if (
        . "$work/write"
        key=$work/pub rescue_target=b CONVERGENT_UNSIGNED=1
        state_mount() { echo "state $*" >>"$work/mutations"; }
        esp_mount() { echo esp >>"$work/mutations"; }
        num() { echo 0; }
        log() { echo "$*"; }
        # EOF at confirmation keeps even a valid release away from real devices.
        write "$work/release" </dev/null
    ) >"$work/write-out" 2>"$work/write-error"; then die "write accepted EOF: $fault"; fi
    if [ "$fault" = signed ]; then
        grep -q 'Write signed release 42 over slot b' "$work/write-out"
        grep -q 'no confirmation' "$work/write-error"
        printf 'state rw\nesp\n' >"$work/expected"
        cmp "$work/expected" "$work/mutations"
    else
        [ ! -s "$work/mutations" ] || die "rescue mounted before authentication: $fault"
        if grep -q 'Type yes:' "$work/write-out"; then die "rescue offered unsigned write: $fault"; fi
        case $fault in
        missing) grep -q 'release is not signed' "$work/write-error" ;;
        *) grep -q 'manifest signature does not verify' "$work/write-error" ;;
        esac
    fi
done
echo 'test-slot-backup: rescue signature enforcement passed'

# The ordinary write keeps its rollback floor: an absent highest is 0, an unreadable one refuses.
sed -n '/^num_strict() {/,/^}/p' "$repo/tools/slot" >"$work/num-strict"
[ -s "$work/num-strict" ] || die 'missing num_strict'
sed -n '/^write() {/,/^}/p' "$repo/tools/slot" |
    sed -e "s|/run/slot-write.XXXXXX|$work/write.XXXXXX|" -e "s|/dev/disk/by-partlabel/cv-slot-|$work/part-|" >"$work/write-floor"
grep -q "$work/part-" "$work/write-floor" || die 'missing slot partition path'
cp "$work/manifest" "$work/release/manifest"
for sample in absent higher malformed unreadable; do
    rm -rf "$work/floor"
    mkdir "$work/floor"
    echo 41 >"$work/floor/good"
    case $sample in
    higher) echo 50 >"$work/floor/highest" ;;
    malformed) echo 4x >"$work/floor/highest" ;;
    unreadable) mkdir "$work/floor/highest" ;;
    esac
    rc=0
    (
        . "$work/num-strict"
        . "$work/write-floor"
        stm=$work/floor CONVERGENT_UNSIGNED=1
        booted() { release=41 slot=a; }
        state_mount() { :; }
        esp_mount() { exit 97; }
        log() { :; }
        write "$work/release"
    ) >/dev/null 2>"$work/floor-error" || rc=$?
    case $sample in
    absent) grep -q "no partition $work/part-b" "$work/floor-error" ;;
    higher) grep -q 'release 42 is not newer than 50' "$work/floor-error" ;;
    *) grep -q 'cannot read the highest blessed release' "$work/floor-error" ;;
    esac && [ "$rc" = 1 ] || { cat "$work/floor-error"; die "slot write floor: $sample (rc $rc)"; }
done
# A lookup error is not absence: a state directory that cannot be listed refuses.
(. "$work/num-strict"; stm=$work/floor/good; num_strict highest) >/dev/null 2>&1 && die 'slot write floor: unlistable state read as 0'
(. "$work/num-strict"; stm=$work/floor; [ "$(num_strict missing)" = 0 ]) || die 'slot write floor: absent file not 0'
echo 'test-slot-backup: slot write rollback floor passed'
