#!/bin/sh
# Pair journal replay model: production recovery, simulated Incus/SSH boundaries.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM
state=$scratch/state work=$scratch/work
mkdir -p "$state" "$work"
lib=$repo/rootfs/usr/lib/convergent/incus
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
. "$lib/fw-topology"
command sh "$here/networks" registry "$scratch/new"
old_registry=$lib/segments
new_registry=$scratch/new/etc/convergent/segments
log=$scratch/events
leases_hold() { :; }
leases_resume() { :; }
work_profiles() { echo "profiles reconciled" >>"$log"; }
running() { [ "$(cat "$scratch/$1.status")" = running ]; }
stopped() { ! running "$1"; }
locked() { "$@"; }
retry() { "$@"; }
healthy() { running "$1"; }
reachable() { running "$1"; }
start_guest() { seed_start "$1"; }
seed_remove() { echo "unseed $1" >>"$log"; }
image_alias() { echo "alias $1 $2" >>"$log"; }
images_prune() { echo prune >>"$log"; }
fail() { echo "$*" >&2; return 1; }
sh() {
    if [ "$1" = "$lib/work-gate" ]; then echo 'gate closed' >>"$log"
    else command sh "$@"; fi
}
ic() {
    case $1:$2 in
    config:set) echo "hold $3" >>"$log"; touch "$scratch/$3.held" ;;
    stop:*) echo "stop $2" >>"$log"; echo stopped >"$scratch/$2.status" ;;
    *) echo "unexpected ic $*" >&2; return 1 ;;
    esac
}
force_stop() { ic stop "$1" --force; }
hold_set() { ic config set "$@"; }
rebuild_root() {
    stopped fw1 && stopped fw2 || return 1
    [ -f "$scratch/fw1.held" ] && [ -f "$scratch/fw2.held" ] || return 1
    echo "rebuild $1 $2" >>"$log"
    [ "${fault:-}" != "$1" ] || return 1
    printf '%s\n' "$2" >"$scratch/$1.image"
}
seed_start() {
    # No boot, including after a replay, may expose different generations.
    cmp "$scratch/fw1.image" "$scratch/fw2.image" || return 1
    echo "boot $1" >>"$log"
    echo running >"$scratch/$1.status"
}
rsh() {
    running "$1"
    case $(cat "$scratch/$1.image") in old) registry=$old_registry ;; new) registry=$new_registry ;; *) return 1 ;; esac
    case $1 in fw1) role=MASTER ;; fw2) role=BACKUP ;; esac
    awk -v role="$role" '$1 !~ /^#/ {print $1 ": flags=41<UP,RUNNING>"; print " carp: " role " carpdev " $3 " vhid " $2}' "$registry"
}
pair() {
    rsh fw1 ifconfig >"$work/live1"
    rsh fw2 ifconfig >"$work/live2"
    awk -v want=MASTER -f "$lib/carp.awk" "$new_registry" "$work/live1" >/dev/null &&
        awk -v want=BACKUP -f "$lib/carp.awk" "$new_registry" "$work/live2" >/dev/null
}
topology_restore_config() { echo "restore-config $1" >>"$log"; }
topology_autostart() {
    running fw1 && running fw2 || return 1
    cmp "$scratch/fw1.image" "$scratch/fw2.image" || return 1
    echo 'release holds' >>"$log"
    rm "$scratch/fw1.held" "$scratch/fw2.held"
}
journal() {
    mkdir -p "$state/fw.topology"
    cp "$old_registry" "$state/fw.topology/segments.old"
    for f in fw1 fw2; do
        echo old >"$state/fw.topology/$f.old"
        echo new >"$state/fw.topology/$f.new"
        touch "$scratch/$f.held"
        echo stopped >"$scratch/$f.status"
    done
    : >"$log"
}
for phase in before-rebuild one-new both-new first-boot both-booted rollback-interrupted committed; do
    journal
    echo old >"$scratch/fw1.image"; echo old >"$scratch/fw2.image"
    case $phase in
    one-new) echo new >"$scratch/fw1.image" ;;
    both-new|first-boot|both-booted|rollback-interrupted|committed)
        echo new >"$scratch/fw1.image"; echo new >"$scratch/fw2.image" ;;
    esac
    case $phase in first-boot|both-booted|committed) echo running >"$scratch/fw1.status" ;; esac
    case $phase in both-booted|committed) echo running >"$scratch/fw2.status" ;; esac
    fault=
    if [ "$phase" = rollback-interrupted ]; then
        fault=fw2
        if topology_recover; then echo 'accepted failed rollback' >&2; exit 1; fi
        [ -d "$state/fw.topology" ]
        stopped fw1
        stopped fw2
        [ -f "$scratch/fw1.held" ]
        [ -f "$scratch/fw2.held" ]
        fault=
        : >"$log"
    fi
    if [ "$phase" = committed ]; then touch "$state/fw.topology/committed"; fi
    topology_recover
    [ ! -e "$state/fw.topology" ]
    if [ "$phase" = committed ]; then
        [ "$(cat "$scratch/fw1.image")" = new ]
        grep -q "profiles reconciled" "$log"
        if grep -q '^rebuild ' "$log"; then exit 1; fi
    else
        [ "$(cat "$scratch/fw1.image")" = old ]
        awk '/^rebuild / {n++} /^boot / {if(n!=2) bad=1} END {exit bad || n!=2}' "$log"
    fi
    running fw1
    running fw2
    [ ! -e "$scratch/fw1.held" ]
    [ ! -e "$scratch/fw2.held" ]
done
echo 'test-topology: rollback/replay and commit fixtures passed'

# Exercise the real snapshot loop: EOF used to erase the caller's rollback fingerprint.
(
    awk '/^rebuild_root\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" |
        sed "s|/run/convergent/|$scratch/run/|g" >"$scratch/rebuild"
    [ -s "$scratch/rebuild" ]
    sh -n "$scratch/rebuild"
    grep -q "$scratch/run/fw-ntpd" "$scratch/rebuild"
    mkdir "$scratch/run"
    . "$scratch/rebuild"
    ic() {
        echo "$*" >>"$log"
        case $1 in
        query) echo '[]' ;;
        snapshot) : ;;
        rebuild)
            [ "$2" = fingerprint ] || return 1
            case $3 in
            fw1|fw2) [ -f "$state/dns.stale" ] && [ "$synced" = yes ] ;;
            svc) [ ! -e "$state/dns.stale" ] && [ "$synced" = no ] ;;
            *) return 1 ;;
            esac ;;
        *) return 1 ;;
        esac
    }
    jq() { printf '%s\n' guests-one guests-two; }
    locked() { "$@"; }
    sync() { [ "${fault:-}" != sync ] || return 1; synced=yes; }
    touch() { [ "${fault:-}" != touch ] || return 1; command touch "$@"; }
    old=fingerprint
    for node in fw1 fw2 svc; do
        # A completed DNS push removed the marker before rollback.
        rm -f "$state/dns.stale"
        synced=no
        touch "$scratch/run/fw-ntpd.$node" "$scratch/run/fw-ntpd.$node.tries"
        rebuild_root "$node" "$old"
        [ "$old" = fingerprint ]
        grep -qx "rebuild fingerprint $node" "$log"
        # A rebuilt firewall's clock is stepped again (facts).
        case $node in
        fw1|fw2) [ ! -e "$scratch/run/fw-ntpd.$node" ] && [ ! -e "$scratch/run/fw-ntpd.$node.tries" ] || exit 1 ;;
        *) [ -e "$scratch/run/fw-ntpd.$node" ] || exit 1 ;;
        esac
    done
    # Cleanup disables errexit: neither marker failure may reach Incus.
    for node in fw1 fw2; do
        for fault in touch sync; do
            rm -f "$state/dns.stale"
            : >"$log"
            set +e
            rebuild_root "$node" "$old"
            code=$?
            set -e
            [ "$code" != 0 ]
            [ ! -s "$log" ]
        done
    done
    rm -f "$state/dns.stale"
)
echo 'test-topology: production rebuild preserves fingerprint and durably marks DNS stale'

if command -v jq >/dev/null 2>&1; then
    (
        . "$lib/fw-topology"
        mkdir -p "$state/fw.topology"
        for node in fw1 fw2; do
            printf '{"config":{}}\n' >"$state/fw.topology/$node.json"
            printf '{"config":{"user.convergent.autorestart":"true","user.convergent.autorestart.old":"false","boot.autostart":"false","boot.autorestart":"false"}}\n' >"$scratch/$node.json"
        done
        ic() {
            case $1:$2 in
            query:*) file=${2##*/}; cat "$scratch/$file.json" ;;
            config:unset)
                jq -e --arg k "$4" '.config | has($k)' "$scratch/$3.json" >/dev/null || return
                jq --arg k "$4" 'del(.config[$k])' "$scratch/$3.json" >"$scratch/config.new" && mv "$scratch/config.new" "$scratch/$3.json" ;;
            *) return 1 ;;
            esac
        }
        topology_autostart
        topology_autostart
        # A cut drain's saved value goes too, or the next clear would restore the hold's false.
        for node in fw1 fw2; do
            jq -e '.config == {}' "$scratch/$node.json" >/dev/null
        done
        topology_retire
    )
    echo 'test-topology: repeated production unsets are idempotent'
else
    echo 'test-topology: SKIP jq recovery fixture (jq unavailable)'
fi
# A killed backup soak's probe routes go with the next recovery; other routes stay.
(
    eval "$(sed -n '/^fw_release() {/,/^}/p' "$repo/tools/guests")"
    routes=$scratch/routes
    ip() {
        case $1:$2 in
        route:show) grep -Fx "$3 via $5 dev $7" "$routes" || : ;;
        route:del)
            echo "del $3" >>"$scratch/route-events"
            [ ! -e "$scratch/del-fails" ] || return 1
            grep -vFx "$3 via $5 dev $7" "$routes" >"$routes.new" || :
            mv "$routes.new" "$routes" ;;
        *) return 1 ;;
        esac
    }
    printf '%s\n' '100.80.0.10/32 via 100.80.1.3 dev host' '100.80.2.10/32 via 100.80.1.2 dev host' >"$routes"
    : >"$scratch/route-events"
    fw_release
    [ "$(cat "$scratch/route-events")" = 'del 100.80.0.10/32' ]
    [ "$(cat "$routes")" = '100.80.2.10/32 via 100.80.1.2 dev host' ]
    : >"$scratch/route-events"
    fw_release
    [ ! -s "$scratch/route-events" ]
    echo '100.80.2.10/32 via 100.80.1.3 dev host' >>"$routes"
    touch "$scratch/del-fails"
    if fw_release; then exit 1; fi
)
echo 'test-topology: recovery removes only stale probe routes'
# A handoff left without a journal is released by rebuilding fw1 alone; a committed node that stays
# unhealthy is redone instead of refused. The handoff must be gone before the commit.
(
    awk '/^rebuild\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" |
        awk -v dir="$scratch/images" '$0 == "    image_dir=/var/lib/convergent/release-guests/guests/fw" {$0 = "    image_dir=" dir; n++} {print} END {exit n != 1}' |
        sed -e "s|/proc/cmdline|$scratch/cmdline|" -e "s|/var/lib/convergent/guest-updates|$scratch/updates|" \
            -e "s|/var/lib/convergent/firewall-maintenance|$scratch/maintenance|g" \
            -e "s|'0 700 directory'|'$(id -u) 700 directory'|" >"$scratch/rebuild"
    [ -s "$scratch/rebuild" ]
    sh -n "$scratch/rebuild"
    grep -q "$scratch/cmdline" "$scratch/rebuild" && grep -q "$scratch/updates" "$scratch/rebuild" || exit 1
    [ "$(grep -c "$scratch/maintenance" "$scratch/rebuild")" -ge 3 ]
    . "$scratch/rebuild"
    mkdir -p "$scratch/images"
    echo 'BOOT_IMAGE=/vmlinuz convergent.release=42 ro' >"$scratch/cmdline"
    touch "$state/initialized"
    echo secret >"$state/carp-pass"
    die() { echo "$*" >&2; exit 1; }
    logger() { :; }
    verify_image() { :; }
    # silent: the peer does not answer SSH at all.
    guest_reply() { [ ! -e "$scratch/$3.silent" ] || return 1; sha256sum "$state/carp-pass" | awk '{print $1}'; }
    carp() { [ ! -e "$scratch/$1.unhealthy" ]; }
    # A handed-off (demoted) fw1 leaves fw2 MASTER.
    pair() { carp "$1" && carp "$2" && if [ -e "$state/fw.handoff" ]; then [ "$1" = fw2 ]; else [ "$1" = fw1 ]; fi; }
    # unchecked: CARP holds, the health check fails (dhcpd off, another release's pf.conf).
    fw_check() { echo "check $1 $image_dir ${fw_either:-}" >>"$log"; [ ! -e "$scratch/$1.unchecked" ] && carp "$1"; }
    stopped() { [ -e "$scratch/$1.stopped" ]; }
    # frozen: its state read gets no answer.
    running() { [ ! -e "$scratch/$1.stopped" ] && [ ! -e "$scratch/$1.frozen" ]; }
    frozen_hint() { echo frozen-hint; }
    confirm() { [ -e "$scratch/yes" ]; }
    stop_guest() { return 1; }
    replace() { echo "replace $1 pending=${pending:-} $image_dir" >>"$log"; rm -f "$scratch/$1.unhealthy"; [ "$rebuilding" != fw1 ] || touch "$state/fw.handoff"; }
    fw_release() { echo fw_release >>"$log"; rm -f "$state/fw.handoff"; }
    commit_update() { echo commit >>"$log"; [ ! -e "$state/fw.handoff" ] || return 1; rm -f "$state/pending" "$state/committed" "$state/fw.rebuilt"; }
    dns_restore() { :; }
    start_stopped() { :; }
    soak() { :; }
    backup_soak() { :; }
    clean() { rm -rf "$state/pending" "$state/committed" "$state/fw.rebuilt" "$state/fw.handoff" "$state/dns.stale" "$scratch"/fw?.unhealthy \
        "$scratch"/fw?.unchecked "$scratch"/fw?.stopped "$scratch"/fw?.silent "$scratch"/fw?.frozen "$scratch/updates" \
        "$scratch/yes" "$state/committed.stage"; : >"$log"; }
    finished() { [ ! -e "$state/pending" ] && [ ! -e "$state/committed" ] && [ ! -e "$state/fw.handoff" ] && grep -qx commit "$log"; }
    # Killed between the fw2 commit and fw1's journal: fw1 demoted, nothing pending.
    clean
    touch "$state/fw.handoff"
    if (rebuild fw2) 2>"$scratch/err"; then exit 1; fi
    grep -q 'handoff is pending' "$scratch/err"
    [ -e "$state/fw.handoff" ]
    (rebuild fw1) >/dev/null
    finished
    awk '$1 == "replace" {r=NR} $1 == "fw_release" {f=NR} $1 == "commit" {c=NR} END {exit !(r && r < f && f < c)}' "$log"
    # The node in maintenance may be rebuilt, and its fresh root ends the demotion its journal records; the peer may not.
    clean
    echo fw1 >"$scratch/maintenance"
    if (rebuild fw2) 2>"$scratch/err"; then exit 1; fi
    grep -q 'the peer is in maintenance' "$scratch/err"
    [ -f "$scratch/maintenance" ]
    (rebuild fw1) >"$scratch/out"
    finished
    [ ! -e "$scratch/maintenance" ]
    grep -qx 'guests: the fw1 maintenance demotion ended with the rebuild' "$scratch/out"
    # A rebuild cut after its replace and resumed takes the handback; the journal naming its fresh root goes too.
    clean
    printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/committed"
    cp "$state/committed" "$state/pending"
    touch "$state/fw.rebuilt"
    echo fw1 >"$scratch/maintenance"
    (rebuild fw1) >/dev/null
    finished
    [ ! -e "$scratch/maintenance" ]
    if grep -q '^replace' "$log"; then exit 1; fi
    # A committed rebuild whose node stays unhealthy is redone from its journal.
    clean
    printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/committed"
    cp "$state/committed" "$state/pending"
    touch "$state/fw.rebuilt" "$scratch/fw1.unhealthy"
    (rebuild fw1) >/dev/null
    finished
    grep -qx "replace fw1 pending=1 $scratch/images" "$log"
    # A healthy committed node is committed without a redo.
    clean
    printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/committed"
    (rebuild fw1) >/dev/null
    finished
    if grep -q '^replace ' "$log"; then exit 1; fi
    # An unhealthy committed update is redone too; fw2's leaves fw1 handed off, released before the redo.
    # With nothing staged the installed release is a stand-in only once the owner, told so, agrees; else it
    # stops and names the update. A manual update's kept copy comes before the staged release.
    for node in fw1 fw2; do
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        touch "$scratch/$node.unhealthy"
        [ "$node" = fw1 ] || touch "$state/fw.handoff"
        if (rebuild "$node") 2>"$scratch/err"; then exit 1; fi
        grep -qx "guests: release 42 is not staged for the committed $node update; the installed release is older" "$scratch/err"
        grep -qx "release 42 is not staged for the committed $node update; rerun the update" "$scratch/err"
        [ ! -s "$log" ] || exit 1
        touch "$scratch/yes"
        (rebuild "$node") >/dev/null 2>&1
        finished
        grep -qx "replace $node pending=1 $scratch/images" "$log"
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        touch "$scratch/$node.unhealthy"
        [ "$node" = fw1 ] || touch "$state/fw.handoff"
        mkdir -p "$scratch/updates/42/fw" "$state/committed.stage/guests/image"
        chmod 700 "$scratch/updates" "$scratch/updates/42" "$scratch/updates/42/fw"
        (rebuild "$node") >/dev/null
        finished
        grep -qx "replace $node pending=1 $state/committed.stage/guests/image" "$log"
        # A damaged kept copy is dropped and the staged release used.
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        touch "$scratch/$node.unhealthy"
        [ "$node" = fw1 ] || touch "$state/fw.handoff"
        mkdir -p "$scratch/updates/42/fw" "$state/committed.stage/guests/image"
        chmod 700 "$scratch/updates" "$scratch/updates/42" "$scratch/updates/42/fw"
        ln -s /nonexistent "$state/committed.stage/guests/image/bad"
        (rebuild "$node") >/dev/null 2>&1
        finished
        [ ! -e "$state/committed.stage" ]
        grep -qx "replace $node pending=1 $scratch/updates/42/fw" "$log"
    done
    awk '$1 == "fw_release" && !f {f=NR} $1 == "replace" {r=NR} END {exit !(f && f < r)}' "$log"
    # Its images are recorded only after both commits: the committed node is redone from the staged release,
    # the peer judged against either release, the target against the staged one only.
    for node in fw1 fw2; do
        case $node in fw1) peer=fw2 ;; fw2) peer=fw1 ;; esac
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        touch "$scratch/$node.unhealthy"
        [ "$node" = fw1 ] || touch "$state/fw.handoff"
        mkdir -p "$scratch/updates/42/fw"
        chmod 700 "$scratch/updates" "$scratch/updates/42" "$scratch/updates/42/fw"
        (rebuild "$node") >/dev/null
        finished
        grep -qx "replace $node pending=1 $scratch/updates/42/fw" "$log"
        grep -qx "check $peer $scratch/updates/42/fw $scratch/images" "$log"
        grep -qx "check $node $scratch/updates/42/fw " "$log"
        # A staged directory others can reach is refused.
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        mkdir -p "$scratch/updates/42/fw"
        chmod 755 "$scratch/updates/42"
        if (rebuild "$node") 2>"$scratch/err"; then exit 1; fi
        grep -q "is not root's private directory" "$scratch/err"
    done
    # An interrupted rebuild of a stopped node goes on past a peer that fails its health check: the redo
    # restores the pair. A running target, or no rebuild journal, still needs a healthy peer; a peer that
    # does not answer SSH is named, not a bare exit after the warning.
    for case in redo running frozen fresh silent; do
        clean
        [ "$case" = fresh ] || printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/pending"
        case $case in running) ;; frozen) touch "$scratch/fw1.frozen" ;; *) touch "$scratch/fw1.stopped" ;; esac
        touch "$scratch/fw2.unchecked"
        [ "$case" != silent ] || touch "$scratch/fw2.silent"
        if [ "$case" = redo ]; then
            (rebuild fw1) >/dev/null 2>"$scratch/err"
            finished
            grep -qx "replace fw1 pending=1 $scratch/images" "$log"
            grep -qx 'guests: WARNING: fw2 is unhealthy; redoing the interrupted rebuild of fw1 (fw2 must still answer SSH)' "$scratch/err"
        elif [ "$case" = silent ]; then
            if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
            grep -qx 'fw2 does not answer SSH; it must before rebuilding fw1' "$scratch/err"
            if grep -q '^replace ' "$log"; then exit 1; fi
        elif [ "$case" = running ]; then
            # An autostarted target: the refusal names the owner's stop.
            if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
            grep -qx 'fw2 must be healthy before rebuilding a running fw1; stop it (sudo incus --force-local --project default stop --force fw1) and rerun' "$scratch/err"
            if grep -q '^replace ' "$log"; then exit 1; fi
        elif [ "$case" = frozen ]; then
            # An unanswered state read gets the frozen way out, never a stop that would hang too.
            if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
            grep -qx 'fw2 must be healthy before rebuilding fw1, whose state Incus did not report; frozen-hint' "$scratch/err"
            if grep -q '^replace ' "$log"; then exit 1; fi
        else
            if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
            grep -qx 'fw2 must be healthy before rebuilding fw1' "$scratch/err"
            if grep -q '^replace ' "$log"; then exit 1; fi
        fi
    done
    # An uncommitted update rolls back instead, and another node's commit is not this rebuild's.
    for journal in pending:fw1 committed:fw2; do
        clean
        printf '%s\n' "${journal#*:} guests-20250101T000000-1 image" >"$state/${journal%:*}"
        if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
        grep -q 'another guest update or rebuild is pending' "$scratch/err"
    done
    clean
)
echo 'test-topology: rebuild releases a journal-less handoff and redoes an unhealthy committed node'
# A resumed rebuild never restarts its half-rebuilt root on failure; a damaged old wan disk costs its
# networks, not the rebuild; an unconfirmed stop reads nothing.
(
    awk '/^replace\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" >"$scratch/replace"
    [ -s "$scratch/replace" ]
    sh -n "$scratch/replace"
    . "$scratch/replace"
    keys=$scratch/keys
    mkdir -p "$keys"
    : >"$keys/known_hosts"
    die() { echo "$*" >&2; exit 1; }
    logger() { :; }
    import_image() { :; }
    autorestart_hold() { :; }
    seed_remove() { :; }
    volumes() { :; }
    stop_guest() { echo "stop $1" >>"$log"; }
    stopped() { [ ! -e "$scratch/$1.unknown" ]; }
    ic() {
        case $1:$2 in
        query:*/snapshots*) echo '[]' ;;
        config:get) echo old-image ;;
        query:/1.0/images/*) echo '{}' ;;
        *) echo "unexpected ic $*" >&2; return 1 ;;
        esac
    }
    wan_read() {
        echo wan_read >>"$log"
        mkdir -p "$work/iwd"
        echo saved >"$work/iwd/home.psk"
        [ ! -e "$scratch/wan.damaged" ] || exit 2
