#!/bin/sh
# Pair journal replay model: production recovery, simulated Incus/SSH boundaries.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM
state=$scratch/state work=$scratch/work
mkdir -p "$state" "$work"
lib=$repo/rootfs/usr/lib/convergent/incus
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
. "$lib/fw-topology"
command sh "$here/networks" registry "$scratch/new"
old_registry=$lib/segments
new_registry=$scratch/new/etc/convergent/segments
log=$scratch/events
leases_hold() { :; }
leases_resume() { :; }
work_profiles() { echo "profiles reconciled" >>"$log"; }
running() { [ "$(cat "$scratch/$1.status")" = running ]; }
stopped() { ! running "$1"; }
locked() { "$@"; }
retry() { "$@"; }
healthy() { running "$1"; }
reachable() { running "$1"; }
start_guest() { seed_start "$1"; }
seed_remove() { echo "unseed $1" >>"$log"; }
image_alias() { echo "alias $1 $2" >>"$log"; }
fail() { echo "$*" >&2; return 1; }
sh() {
    if [ "$1" = "$lib/work-gate" ]; then echo 'gate closed' >>"$log"
    else command sh "$@"; fi
}
ic() {
    case $1:$2 in
    config:set) echo "hold $3" >>"$log"; touch "$scratch/$3.held" ;;
    stop:*) echo "stop $2" >>"$log"; echo stopped >"$scratch/$2.status" ;;
    *) echo "unexpected ic $*" >&2; return 1 ;;
    esac
}
force_stop() { ic stop "$1" --force; }
hold_set() { ic config set "$@"; }
rebuild_root() {
    stopped fw1 && stopped fw2 || return 1
    [ -f "$scratch/fw1.held" ] && [ -f "$scratch/fw2.held" ] || return 1
    echo "rebuild $1 $2" >>"$log"
    [ "${fault:-}" != "$1" ] || return 1
    printf '%s\n' "$2" >"$scratch/$1.image"
}
seed_start() {
    # No boot, including after a replay, may expose different generations.
    cmp "$scratch/fw1.image" "$scratch/fw2.image" || return 1
    echo "boot $1" >>"$log"
    echo running >"$scratch/$1.status"
}
rsh() {
    running "$1"
    case $(cat "$scratch/$1.image") in old) registry=$old_registry ;; new) registry=$new_registry ;; *) return 1 ;; esac
    case $1 in fw1) role=MASTER ;; fw2) role=BACKUP ;; esac
    awk -v role="$role" '$1 !~ /^#/ {print $1 ": flags=41<UP,RUNNING>"; print " carp: " role " carpdev " $3 " vhid " $2}' "$registry"
}
pair() {
    rsh fw1 ifconfig >"$work/live1"
    rsh fw2 ifconfig >"$work/live2"
    awk -v want=MASTER -f "$lib/carp.awk" "$new_registry" "$work/live1" >/dev/null &&
        awk -v want=BACKUP -f "$lib/carp.awk" "$new_registry" "$work/live2" >/dev/null
}
topology_restore_config() { echo "restore-config $1" >>"$log"; }
topology_autostart() {
    running fw1 && running fw2 || return 1
    cmp "$scratch/fw1.image" "$scratch/fw2.image" || return 1
    echo 'release holds' >>"$log"
    rm "$scratch/fw1.held" "$scratch/fw2.held"
}
journal() {
    mkdir -p "$state/fw.topology"
    cp "$old_registry" "$state/fw.topology/segments.old"
    for f in fw1 fw2; do
        echo old >"$state/fw.topology/$f.old"
        echo new >"$state/fw.topology/$f.new"
        touch "$scratch/$f.held"
        echo stopped >"$scratch/$f.status"
    done
    : >"$log"
}
for phase in before-rebuild one-new both-new first-boot both-booted rollback-interrupted committed; do
    journal
    echo old >"$scratch/fw1.image"; echo old >"$scratch/fw2.image"
    case $phase in
    one-new) echo new >"$scratch/fw1.image" ;;
    both-new|first-boot|both-booted|rollback-interrupted|committed)
        echo new >"$scratch/fw1.image"; echo new >"$scratch/fw2.image" ;;
    esac
    case $phase in first-boot|both-booted|committed) echo running >"$scratch/fw1.status" ;; esac
    case $phase in both-booted|committed) echo running >"$scratch/fw2.status" ;; esac
    fault=
    if [ "$phase" = rollback-interrupted ]; then
        fault=fw2
        if topology_recover; then echo 'accepted failed rollback' >&2; exit 1; fi
        [ -d "$state/fw.topology" ]
        stopped fw1 && stopped fw2
        [ -f "$scratch/fw1.held" ] && [ -f "$scratch/fw2.held" ]
        fault=
        : >"$log"
    fi
    if [ "$phase" = committed ]; then touch "$state/fw.topology/committed"; fi
    topology_recover
    [ ! -e "$state/fw.topology" ]
    if [ "$phase" = committed ]; then
        [ "$(cat "$scratch/fw1.image")" = new ]
        grep -q "profiles reconciled" "$log"
        if grep -q '^rebuild ' "$log"; then exit 1; fi
    else
        [ "$(cat "$scratch/fw1.image")" = old ]
        awk '/^rebuild / {n++} /^boot / {if(n!=2) bad=1} END {exit bad || n!=2}' "$log"
    fi
    running fw1 && running fw2
    [ ! -e "$scratch/fw1.held" ] && [ ! -e "$scratch/fw2.held" ]
done
echo 'test-topology: rollback/replay and commit fixtures passed'

# Exercise the real snapshot loop: EOF used to erase the caller's rollback fingerprint.
(
    awk '/^rebuild_root\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" |
        sed "s|/run/convergent/|$scratch/run/|g" >"$scratch/rebuild"
    [ -s "$scratch/rebuild" ]
    sh -n "$scratch/rebuild"
    grep -q "$scratch/run/fw-ntpd" "$scratch/rebuild"
    mkdir "$scratch/run"
    . "$scratch/rebuild"
    ic() {
        echo "$*" >>"$log"
        case $1 in
        query) echo '[]' ;;
        snapshot) : ;;
        rebuild)
            [ "$2" = fingerprint ] || return 1
            case $3 in
            fw1|fw2) [ -f "$state/dns.stale" ] && [ "$synced" = yes ] ;;
            svc) [ ! -e "$state/dns.stale" ] && [ "$synced" = no ] ;;
            *) return 1 ;;
            esac ;;
        *) return 1 ;;
        esac
    }
    jq() { printf '%s\n' guests-one guests-two; }
    locked() { "$@"; }
    sync() { [ "${fault:-}" != sync ] || return 1; synced=yes; }
    touch() { [ "${fault:-}" != touch ] || return 1; command touch "$@"; }
    old=fingerprint
    for node in fw1 fw2 svc; do
        # A completed DNS push removed the marker before rollback.
        rm -f "$state/dns.stale"
        synced=no
        touch "$scratch/run/fw-ntpd.$node" "$scratch/run/fw-ntpd.$node.tries"
        rebuild_root "$node" "$old"
        [ "$old" = fingerprint ]
        grep -qx "rebuild fingerprint $node" "$log"
        # A rebuilt firewall's clock is stepped again (facts).
        case $node in
        fw1|fw2) [ ! -e "$scratch/run/fw-ntpd.$node" ] && [ ! -e "$scratch/run/fw-ntpd.$node.tries" ] || exit 1 ;;
        *) [ -e "$scratch/run/fw-ntpd.$node" ] || exit 1 ;;
        esac
    done
    # Cleanup disables errexit: neither marker failure may reach Incus.
    for node in fw1 fw2; do
        for fault in touch sync; do
            rm -f "$state/dns.stale"
            : >"$log"
            set +e
            rebuild_root "$node" "$old"
            code=$?
            set -e
            [ "$code" != 0 ]
            [ ! -s "$log" ]
        done
    done
    rm -f "$state/dns.stale"
)
echo 'test-topology: production rebuild preserves fingerprint and durably marks DNS stale'

if command -v jq >/dev/null 2>&1; then
    (
        . "$lib/fw-topology"
        mkdir -p "$state/fw.topology"
        for node in fw1 fw2; do
            printf '{"config":{}}\n' >"$state/fw.topology/$node.json"
            printf '{"config":{"user.convergent.autorestart":"true","boot.autostart":"false","boot.autorestart":"false"}}\n' >"$scratch/$node.json"
        done
        ic() {
            case $1:$2 in
            query:*) file=${2##*/}; cat "$scratch/$file.json" ;;
            config:unset)
                jq -e --arg k "$4" '.config | has($k)' "$scratch/$3.json" >/dev/null || return
                jq --arg k "$4" 'del(.config[$k])' "$scratch/$3.json" >"$scratch/config.new" && mv "$scratch/config.new" "$scratch/$3.json" ;;
            *) return 1 ;;
            esac
        }
        topology_autostart
        topology_autostart
        topology_retire
    )
    echo 'test-topology: repeated production unsets are idempotent'
else
    echo 'test-topology: SKIP jq recovery fixture (jq unavailable)'
fi
# A killed backup soak's probe routes go with the next recovery; other routes stay.
(
    eval "$(sed -n '/^fw_release() {/,/^}/p' "$repo/tools/guests")"
    routes=$scratch/routes
    ip() {
        case $1:$2 in
        route:show) grep -Fx "$3 via $5 dev $7" "$routes" || : ;;
        route:del)
            echo "del $3" >>"$scratch/route-events"
            [ ! -e "$scratch/del-fails" ] || return 1
            grep -vFx "$3 via $5 dev $7" "$routes" >"$routes.new" || :
            mv "$routes.new" "$routes" ;;
        *) return 1 ;;
        esac
    }
    printf '%s\n' '100.80.0.10/32 via 100.80.1.3 dev host' '100.80.2.10/32 via 100.80.1.2 dev host' >"$routes"
    : >"$scratch/route-events"
    fw_release
    [ "$(cat "$scratch/route-events")" = 'del 100.80.0.10/32' ]
    [ "$(cat "$routes")" = '100.80.2.10/32 via 100.80.1.2 dev host' ]
    : >"$scratch/route-events"
    fw_release
    [ ! -s "$scratch/route-events" ]
    echo '100.80.2.10/32 via 100.80.1.3 dev host' >>"$routes"
    touch "$scratch/del-fails"
    if fw_release; then exit 1; fi
)
echo 'test-topology: recovery removes only stale probe routes'
# A handoff left without a journal is released by rebuilding fw1 alone; a committed node that stays
# unhealthy is redone instead of refused. The handoff must be gone before the commit.
(
    awk '/^rebuild\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" |
        awk -v dir="$scratch/images" '$0 == "    image_dir=/var/lib/convergent/release-guests/guests/fw" {$0 = "    image_dir=" dir; n++} {print} END {exit n != 1}' >"$scratch/rebuild"
    [ -s "$scratch/rebuild" ]
    sh -n "$scratch/rebuild"
    . "$scratch/rebuild"
    mkdir -p "$scratch/images"
    touch "$state/initialized"
    echo secret >"$state/carp-pass"
    die() { echo "$*" >&2; exit 1; }
    verify_image() { :; }
    guest_reply() { sha256sum "$state/carp-pass" | awk '{print $1}'; }
    carp() { [ ! -e "$scratch/$1.unhealthy" ]; }
    # A handed-off (demoted) fw1 leaves fw2 MASTER.
    pair() { carp "$1" && carp "$2" && if [ -e "$state/fw.handoff" ]; then [ "$1" = fw2 ]; else [ "$1" = fw1 ]; fi; }
    fw_check() { carp "$1"; }
    stopped() { return 1; }
    stop_guest() { return 1; }
    replace() { echo "replace $1 pending=${pending:-}" >>"$log"; rm -f "$scratch/$1.unhealthy"; [ "$rebuilding" != fw1 ] || touch "$state/fw.handoff"; }
    fw_release() { echo fw_release >>"$log"; rm -f "$state/fw.handoff"; }
    commit_update() { echo commit >>"$log"; [ ! -e "$state/fw.handoff" ] || return 1; rm -f "$state/pending" "$state/committed" "$state/fw.rebuilt"; }
    dns_restore() { :; }
    start_stopped() { :; }
    soak() { :; }
    backup_soak() { :; }
    clean() { rm -f "$state/pending" "$state/committed" "$state/fw.rebuilt" "$state/fw.handoff" "$state/dns.stale" "$scratch"/fw?.unhealthy; : >"$log"; }
    finished() { [ ! -e "$state/pending" ] && [ ! -e "$state/committed" ] && [ ! -e "$state/fw.handoff" ] && grep -qx commit "$log"; }
    # Killed between the fw2 commit and fw1's journal: fw1 demoted, nothing pending.
    clean
    touch "$state/fw.handoff"
    if (rebuild fw2) 2>"$scratch/err"; then exit 1; fi
    grep -q 'handoff is pending' "$scratch/err"
    [ -e "$state/fw.handoff" ]
    (rebuild fw1) >/dev/null
    finished
    awk '$1 == "replace" {r=NR} $1 == "fw_release" {f=NR} $1 == "commit" {c=NR} END {exit !(r && r < f && f < c)}' "$log"
    # A committed rebuild whose node stays unhealthy is redone from its journal.
    clean
    printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/committed"
    cp "$state/committed" "$state/pending"
    touch "$state/fw.rebuilt" "$scratch/fw1.unhealthy"
    (rebuild fw1) >/dev/null
    finished
    grep -qx 'replace fw1 pending=1' "$log"
    # A healthy committed node is committed without a redo.
    clean
    printf '%s\n' 'fw1 guests-20250101T000000-1-rebuild image' >"$state/committed"
    (rebuild fw1) >/dev/null
    finished
    if grep -q '^replace ' "$log"; then exit 1; fi
    # An unhealthy committed update is redone too; fw2's leaves fw1 handed off, released before the redo.
    for node in fw1 fw2; do
        clean
        printf '%s\n' "$node guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        touch "$scratch/$node.unhealthy"
        [ "$node" = fw1 ] || touch "$state/fw.handoff"
        (rebuild "$node") >/dev/null
        finished
        grep -qx "replace $node pending=1" "$log"
    done
    awk '$1 == "fw_release" && !f {f=NR} $1 == "replace" {r=NR} END {exit !(f && f < r)}' "$log"
    # An uncommitted update rolls back instead, and another node's commit is not this rebuild's.
    for journal in pending:fw1 committed:fw2; do
        clean
        printf '%s\n' "${journal#*:} guests-20250101T000000-1 image" >"$state/${journal%:*}"
        if (rebuild fw1) 2>"$scratch/err"; then exit 1; fi
        grep -q 'another guest update or rebuild is pending' "$scratch/err"
    done
    clean
)
echo 'test-topology: rebuild releases a journal-less handoff and redoes an unhealthy committed node'
# A committed wan or svc that stays unhealthy is redone in place by its own update, never rolled back.
(
    awk '/^update\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" >"$scratch/update"
    [ -s "$scratch/update" ]
    sh -n "$scratch/update"
    . "$scratch/update"
    applying= browser_locked=1 rebuilding= pending=
    mkdir -p "$scratch/image"
    touch "$state/initialized"
    die() { echo "$*" >&2; exit 1; }
    logger() { :; }
    flock() { :; }
    cmp() { :; }
    ic() { :; }
    good_slot() { :; }
    verify_image() { :; }
    stale_installed() { :; }
    certificates_prepare() { :; }
    certificates_apply() { :; }
    prepare_cleanup() { :; }
    fw_release() { :; }
    dns_restore() { :; }
    parallel_autostart() { :; }
    record_installed() { :; }
    browser_commit() { echo browser_commit >>"$log"; }
    profiles_restore() { echo profiles_restore >>"$log"; }
    rollback() { echo rollback >>"$log"; }
    replace() { echo "replace $1 pending=${pending:-} rebuilding=${rebuilding:-}" >>"$log"; rm -f "$scratch/$1.unhealthy"; }
    commit_update() {
        echo commit >>"$log"
        for marker in "$scratch"/*.unhealthy; do [ ! -e "$marker" ] || return 1; done
        rm -f "$state/pending" "$state/committed" && rm -rf "$state/profiles.before"
    }
    journal() {
        rm -f "$scratch"/*.unhealthy "$state/pending" "$state/committed"
        : >"$log"
        printf '%s\n' "$1 guests-20250101T000000-1 image" >"$state/committed"
        cp "$state/committed" "$state/pending"
        mkdir -p "$state/profiles.before"
    }
    for guest in wan svc; do
        journal "$guest"
        touch "$scratch/$guest.unhealthy"
        (update "$guest" "$scratch/image") >/dev/null
        [ ! -e "$state/committed" ] && [ ! -e "$state/pending" ] && [ ! -e "$state/profiles.before" ]
        grep -qx "replace $guest pending=1 rebuilding=$guest" "$log"
        [ "$(grep -cx commit "$log")" = 2 ]
        if grep -q -e rollback -e profiles_restore "$log"; then exit 1; fi
    done
    # A healthy commit is finished first; the update then has its own way back.
    journal svc
    (update svc "$scratch/image") >/dev/null
    grep -qx 'replace svc pending= rebuilding=' "$log"
    # Another guest's commit is never redone by this update.
    for guest in wan fw; do
        journal svc
        touch "$scratch/svc.unhealthy"
        if (update "$guest" "$scratch/image") 2>"$scratch/err"; then exit 1; fi
        grep -q 'cannot finish committed update' "$scratch/err"
        [ -e "$state/committed" ]
        if grep -q '^replace ' "$log"; then exit 1; fi
    done
    rm -rf "$scratch"/*.unhealthy "$state/pending" "$state/committed" "$state/profiles.before"
    # Recorded right after the commit: a later failure must not redo the whole update.
    : >"$log"
    record_installed() { echo "record $1" >>"$log"; }
    parallel_autostart() { exit 1; }
    if (update svc "$scratch/image") >/dev/null 2>&1; then exit 1; fi
    grep -qx 'record svc' "$log"
)
echo 'test-topology: update redoes its own unhealthy committed wan or svc in place'
# A boot-time apply reaches update fw while Incus still boots the firewalls: the first reads wait
# read-only for sshd. The images are recorded once the pair is committed, before any later step.
(
    awk '/^update\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" >"$scratch/update"
    sed -n '/^reachable() {/p; /^work_profiles_due() {/,/^}/p; /^maintenance_due() {/,/^}/p' "$repo/tools/guests" >>"$scratch/update"
    grep -q '^reachable() {' "$scratch/update"
    grep -q '^work_profiles_due() {' "$scratch/update"
    grep -q '^maintenance_due() {' "$scratch/update"
    sh -n "$scratch/update"
    . "$scratch/update"
    applying= browser_locked=1 rebuilding= pending=
    mkdir -p "$scratch/fw-image"
    for node in fw1 fw2; do
        for suffix in qcow2 pf.sha256 rules.sha256; do echo x >"$scratch/fw-image/$node.$suffix"; done
    done
    echo topology >"$scratch/fw-image/topology.sha256"
    echo secret >"$state/carp-pass"
    touch "$state/initialized"
    rm -f "$state/pending" "$state/committed"
    die() { echo "$*" >&2; exit 1; }
    for fn in logger flock cmp ic good_slot verify_image stale_installed prepare_cleanup fw_release dns_restore \
        pair replace fw_check backup_soak fw_mutate soak parallel_autostart; do eval "$fn() { :; }"; done
    running() { :; }
    retry() { echo "retry $*" >>"$log"; tries=0; until "$@"; do [ "$((tries += 1))" -lt 5 ] || return 1; done; }
    guest_reply() { shift; "$@"; }
    # fw1's sshd refuses the first connections while it boots.
    rsh() {
        case $1 in fw1) [ "$((boots += 1))" -gt 2 ] || return 255 ;; esac
        case $2 in
        true) ;;
        *hostname.carp0*) echo "read $1" >>"$log"; sha256sum "$state/carp-pass" | awk '{print $1}' ;;
        *topology.sha256*) cat "$scratch/fw-image/topology.sha256" ;;
        *) return 1 ;;
        esac
    }
    commit_update() { echo commit >>"$log"; }
    # The work profiles are due from before the images are recorded until they land.
    record_installed() { [ -e "$state/work-profiles.due" ] || exit 97; echo "record $1" >>"$log"; }
    work_profiles() { echo profiles >>"$log"; [ "$fault" != profiles ] || exit 1; }
    work_stale() { echo stale >>"$log"; [ "$fault" != stale ]; }
    for fault in '' stale profiles; do
        : >"$log"; boots=0
        rm -f "$state/work-profiles.due"
        if [ -z "$fault" ]; then (update fw "$scratch/fw-image") >/dev/null
        elif (update fw "$scratch/fw-image") >/dev/null 2>&1; then exit 1; fi
        # A profile still in use refuses before anything changes.
        [ "$(head -n 1 "$log")" = stale ]
        if [ "$fault" = stale ]; then [ "$(cat "$log")" = stale ]; continue; fi
        awk '$0 == "retry reachable fw1" {r=NR} $0 == "read fw1" && !p {p=NR} END {exit !(r && p && r < p)}' "$log"
        awk '$0 == "commit" {c=NR} $0 == "record fw" {r=NR} $0 == "profiles" {w=NR} END {exit !(c && c < r && r < w)}' "$log"
        if [ -z "$fault" ]; then [ ! -e "$state/work-profiles.due" ]; else [ -e "$state/work-profiles.due" ]; fi
    done
    rm -f "$state/fw.handoff" "$state/carp-pass"
    # A failure after the commit keeps maintenance due: apply reruns the profiles until they land.
    touch "$state/normalized"
    certificates_due() { return 1; }
    browser_legacy() { return 1; }
    maintenance_due
    if (work_profiles_due) 2>/dev/null; then exit 1; fi
    [ -e "$state/work-profiles.due" ]
    fault=
    work_profiles_due
    [ ! -e "$state/work-profiles.due" ]
    if maintenance_due; then exit 1; fi
    rm "$state/normalized"
    awk '/^apply\(\) \{/ {a=1} a && $0 == "    work_profiles_due" {w=NR}
        a && /^    \[ -d "\$staged" \] \|\| \{ certificates_apply/ && !s {s=NR} a && /^}/ {exit}
        END {exit !(w && s && w < s)}' "$repo/tools/guests"
)
echo 'test-topology: update fw waits for booting firewalls and records its images once committed'
# A replay at boot meets firewalls Incus has just started: holds first, then a read-only wait for sshd,
# then the real lease checkpoint; a node silent throughout is replaced from the saved leases.
(
    . "$lib/fw-leases"
    retry() { echo "retry $*" >>"$log"; tries=0; until "$@"; do [ "$((tries += 1))" -lt 5 ] || return 1; done; }
    reachable() { rsh "$1" true >/dev/null; }
    # dying: fw2 stops during the wait, which ends at once instead of running out.
    rsh() {
        case $1:$silent in
        fw2:dying) echo "probe $1" >>"$log"; echo stopped >"$scratch/fw2.status"; return 255 ;;
        fw2:*) [ "$((boots += 1))" -gt "$silent" ] || return 255 ;;
        esac
        case $2 in
        true) ;;
        *'rcctl disable dhcpd'*) echo "read $1" >>"$log" ;;
        *'cat >/var/db/dhcpd.leases.new'*) cat >/dev/null ;;
        *) return 1 ;;
        esac
    }
    for silent in 2 1000 dying; do
        journal
        rm -rf "$state/leases" "$scratch/fw1.held" "$scratch/fw2.held"
        for f in fw1 fw2; do echo running >"$scratch/$f.status"; done
        boots=0
        topology_hold
        stopped fw1 && stopped fw2
        [ -f "$state/leases/quiesced" ]
        awk '$0 == "hold fw2" {h=NR} $0 == "retry topology_settled fw2" {w=NR} $0 == "read fw1" {r=NR} END {exit !(h && w && r && h < w && w < r)}' "$log"
        if [ "$silent" = 2 ]; then grep -qx 'read fw2' "$log"; elif grep -qx 'read fw2' "$log"; then exit 1; fi
        [ "$silent" != dying ] || [ "$(grep -cx 'probe fw2' "$log")" = 1 ]
    done
    rm -rf "$state/fw.topology" "$state/leases"
)
echo 'test-topology: rollback holds both, waits for a booting firewall and checkpoints around a silent one'
# A committed node that never answers is redone from the journal, never left without an exit.
(
    journal
    for f in fw1 fw2; do echo new >"$scratch/$f.image"; echo running >"$scratch/$f.status"; done
    touch "$state/fw.topology/committed" "$scratch/fw2.broken"
    healthy() { running "$1" && [ ! -e "$scratch/$1.broken" ]; }
    rebuild_root() { stopped "$1" || return 1; echo "rebuild $1 $2" >>"$log"; rm -f "$scratch/$1.broken"; printf '%s\n' "$2" >"$scratch/$1.image"; }
    leases_hold() { echo "checkpoint ${rebuilding:-}" >>"$log"; }
    leases_resume() { echo resume >>"$log"; }
    topology_recover
    [ ! -e "$state/fw.topology" ]
    if grep -q '^rebuild fw1' "$log"; then exit 1; fi
    awk '$0 == "checkpoint fw2" {h=NR} $0 == "stop fw2" {s=NR} $0 == "rebuild fw2 new" {r=NR} $0 == "boot fw2" {b=NR} $0 == "resume" {u=NR}
        END {exit !(h && h < s && s < r && r < b && b < u)}' "$log"
    running fw1 && running fw2
)
echo 'test-topology: a committed migration redoes a node that never becomes healthy'
# Both committed nodes silent (an fsck prompt): both are redone under one real checkpoint, neither refused.
(
    . "$lib/fw-leases"
    journal
    rm -rf "$state/leases"
    for f in fw1 fw2; do echo new >"$scratch/$f.image"; echo running >"$scratch/$f.status"; touch "$scratch/$f.broken"; done
    touch "$state/fw.topology/committed"
    healthy() { running "$1" && [ ! -e "$scratch/$1.broken" ]; }
    rebuild_root() { stopped "$1" || return 1; echo "rebuild $1 $2" >>"$log"; rm -f "$scratch/$1.broken"; printf '%s\n' "$2" >"$scratch/$1.image"; }
    rsh() { [ ! -e "$scratch/$1.broken" ] || return 255; case $2 in *'cat >/var/db/dhcpd.leases.new'*) cat >/dev/null ;; esac; }
    pair() { [ ! -e "$scratch/fw1.broken" ] && [ ! -e "$scratch/fw2.broken" ]; }
    topology_recover
    [ ! -e "$state/fw.topology" ] && [ ! -e "$state/leases/held" ]
    grep -qx 'rebuild fw1 new' "$log" && grep -qx 'rebuild fw2 new' "$log"
    running fw1 && running fw2
    rm -rf "$state/leases"
)
echo 'test-topology: a committed migration redoes both silent nodes'
# A start Incus refuses for a moment is tried again: a committed-good root is never rebuilt for it.
(
    journal
    for f in fw1 fw2; do echo new >"$scratch/$f.image"; done
    echo running >"$scratch/fw2.status"
    touch "$state/fw.topology/committed"
    retry() { tries=0; until "$@"; do [ "$((tries += 1))" -lt 5 ] || return 1; done; }
    start_guest() { [ -e "$scratch/fw1.refused" ] || { touch "$scratch/fw1.refused"; return 1; }; seed_start "$1"; }
    topology_recover
    [ ! -e "$state/fw.topology" ] && [ -e "$scratch/fw1.refused" ]
    if grep -q '^rebuild ' "$log"; then exit 1; fi
    running fw1 && running fw2
)
echo 'test-topology: a committed node whose start is refused once is started again, not rebuilt'
if command -v jq >/dev/null 2>&1; then
    # A renamed work domain's profile stays on a VLAN another domain may own: unused goes, used takes the
    # name of the not yet created profile on its VLAN, other used ones refuse. Owner shapes are never touched.
    (
        . "$lib/fw-topology"
        lib=$scratch/lib
        mkdir -p "$lib/work"
        for vlan in 320:a 360:b; do
            printf 'config: {}\ndevices:\n  eth0:\n    type: nic\n    network: work\n    name: eth0\n    vlan: "%s"\n    security.mac_filtering: "true"\n' \
                "${vlan%:*}" >"$lib/work/work-eng-${vlan#*:}.yaml"
        done
        ic() { [ "$*" = 'project list --format json' ] || return 1; echo '[{"name":"default"},{"name":"owner"}]'; }
        incus() { echo "incus $*" >>"$log"; case "$*" in *'profile list --format json') cat "$scratch/profiles.json" ;; esac; }
        cmp() { :; }
        image_dir=$scratch
        die() { echo "$*" >&2; exit 1; }
        import_image() { echo import >>"$log"; exit 1; }
        used='"/1.0/instances/vm?project=owner"'
        nic() { printf '{"eth0":{"type":"nic","network":"work","name":"eth0","vlan":"%s","security.mac_filtering":"true"}}' "$1"; }
        # work-mine (no MAC filtering), work-ten (VLAN outside the four) and work-mtu (an extra key) are owner-made.
        mine='{"eth0":{"type":"nic","network":"work","vlan":"320"}}'
        ten='{"eth0":{"type":"nic","network":"work","name":"eth0","vlan":"100","security.mac_filtering":"true"}}'
        mtu='{"eth0":{"type":"nic","network":"work","name":"eth0","vlan":"330","security.mac_filtering":"true","mtu":"1400"}}'
        for users in "$used" ''; do
            printf '[{"name":"default","used_by":[%s]},{"name":"work-eng-a","used_by":[%s],"devices":%s},{"name":"work-dev-a","used_by":[],"devices":%s},{"name":"work-dev-b","used_by":[%s],"devices":%s},{"name":"work-lab","used_by":[%s],"devices":{"root":{"type":"disk"}}},{"name":"work-old","used_by":[]},{"name":"work-mine","used_by":[%s],"devices":%s},{"name":"work-ten","used_by":[],"devices":%s},{"name":"work-mtu","used_by":[],"devices":%s},{"name":"work-jhn-old","used_by":[%s],"devices":%s}]\n' \
                "$used" "$used" "$(nic 320)" "$(nic 330)" "$users" "$(nic 320)" "$used" "$used" "$mine" "$ten" "$mtu" "$used" "$(nic 360)" >"$scratch/profiles.json"
            : >"$log"
            if (topology_update) 2>"$scratch/err"; then exit 1; fi
            if [ -n "$users" ]; then
                # work-eng-a, its VLAN's profile, exists already: only a detach is left.
                grep -q 'owner profile work-dev-b has a reserved work- name and shape but is no current work domain, and is in use by vm; detach it from each: sudo incus --force-local --project owner profile remove <instance> work-dev-b' "$scratch/err"
                if grep -q -e '^import' -e 'profile delete' -e 'profile rename' "$log"; then exit 1; fi
                if work_profiles 2>/dev/null; then exit 1; fi
                if grep -q -e 'profile delete work-dev-b' -e 'profile create' "$log"; then exit 1; fi
            else
                grep -qx import "$log"
                if grep -q -e 'profile delete' -e 'profile rename' "$log"; then exit 1; fi
                logger() { echo "logger $*" >>"$log"; }
                work_profiles
                [ "$(grep 'profile delete' "$log")" = "$(printf 'incus --force-local --project owner profile delete %s\n' work-dev-a work-dev-b)" ]
                # Each deletion is logged.
                [ "$(grep '^logger .*deleted' "$log")" = "$(printf 'logger -t guests deleted unused work profile %s: no current work domain\n' work-dev-a work-dev-b)" ]
                # Renamed before its successor is created: same devices, so its instances carry over.
                [ "$(grep 'profile rename' "$log")" = 'incus --force-local --project owner profile rename work-jhn-old work-eng-b' ]
                awk '/profile rename work-jhn-old work-eng-b$/ {r=NR} /profile (create|edit) work-eng-b$/ && !c {c=NR} END {exit !(r && c && r < c)}' "$log"
            fi
        done
        # Two left on one VLAN: only one can take its name, so the check refuses before the migration.
        printf '[{"name":"work-x","used_by":[%s],"devices":%s},{"name":"work-y","used_by":[%s],"devices":%s}]\n' \
            "$used" "$(nic 360)" "$used" "$(nic 360)" >"$scratch/profiles.json"
        if work_stale 2>"$scratch/err"; then exit 1; fi
        grep -q 'work-y has a reserved work- name and shape but is no current work domain' "$scratch/err"
        [ ! -e "$state/fw.topology" ]
        rm -rf "$work/topology"
    )
    echo 'test-topology: profiles of renamed work domains are pruned, renamed onto their VLAN, or refused'
    # Saved profiles whose only failure is a running VM's agent missing the guest API change reconcile;
    # any other instance failure still fails.
    (
        . "$lib/fw-topology"
        lib=$scratch/lib-edit
        mkdir -p "$lib/work"
        : >"$lib/work/work-dev-a.yaml"
        ic() { [ "$*" = 'project list --format json' ] || return 1; echo '[{"name":"owner"}]'; }
        logger() { echo "logger $*" >>"$scratch/edit-log"; }
        incus() {
            case "$*" in
            *'project set owner features.networks=false') ;;
            *'profile list --format json') echo '[{"name":"work-dev-a","used_by":["/1.0/instances/vm1?project=owner"],"devices":{"eth0":{"type":"nic","network":"work"}}}]' ;;
            *'profile edit work-dev-a') [ -z "$edit_error" ] || { printf 'Error: %s\n\n' "$edit_error" >&2; return 1; } ;;
            *) return 1 ;;
            esac
        }
        saved='The following instances failed to update (profile change still saved):'
        for sample in none agent handle vsock device mixed header other; do
            case $sample in
            none) edit_error= ;;
            agent) edit_error="$saved
 - Project: owner, Instance: vm1: Failed connecting to the agent: context deadline exceeded" ;;
            handle) edit_error="$saved
 - Project: owner, Instance: vm1: Failed getting agent client handle: VM agent isn't currently running" ;;
            vsock) edit_error="$saved
 - Project: owner, Instance: vm1: Failed sending host vsock information to the agent: EOF" ;;
            device) edit_error="$saved
 - Project: owner, Instance: vm1: Failed to update device \"eth0\": busy" ;;
            mixed) edit_error="$saved
 - Project: owner, Instance: vm1: Failed connecting to the agent: EOF
 - Project: owner, Instance: ct1: Failed to update device \"eth0\": busy" ;;
            header) edit_error=$saved ;;
            other) edit_error='Profile not found' ;;
            esac
            rm -f "$scratch/edit-log"
            if (work_profiles) 2>"$scratch/edit-err"; then
                case $sample in none|agent|handle|vsock) ;; *) echo "accepted $sample" >&2; exit 1 ;; esac
                [ "$sample" = none ] || grep -q 'work profile work-dev-a saved' "$scratch/edit-log"
            else
                case $sample in none|agent|handle|vsock) cat "$scratch/edit-err" >&2; exit 1 ;; esac
                grep -qF "$edit_error" "$scratch/edit-err"
            fi
        done
    )
    echo 'test-topology: a running VM agent that misses the guest API change does not fail the reconcile'
    # Work profiles carry the guests' guest API and Btrfs ioctl settings; devices stay NIC-only.
    (
        root=$scratch/host
        mkdir -p "$root/etc"
        cp "$repo/rootfs/etc/nftables.rules" "$root/etc/"
        command sh "$here/networks" host "$root"
        sed -n '/^  security.syscalls.deny: |$/,/^  security.guestapi: "false"$/p' "$repo/guests/browser/incus/base.yaml" >"$scratch/guest-config"
        [ "$(wc -l <"$scratch/guest-config")" = 6 ]
        printf 'devices:\n  eth0:\n    type: nic\n    network: work\n    name: eth0\n    vlan: N\n    security.mac_filtering: "true"\n' >"$scratch/work-devices"
        count=0
        for profile in "$root/usr/lib/convergent/incus/work/"work-*.yaml; do
            sed -n '/^config:$/,/^devices:$/p' "$profile" | sed '1d;$d' | cmp - "$scratch/guest-config"
            sed -n '/^devices:$/,$p' "$profile" | sed 's/^    vlan: "[0-9]*"$/    vlan: N/' | cmp - "$scratch/work-devices"
            count=$((count + 1))
        done
        [ "$count" = 4 ]
    )
    echo 'test-topology: work profiles turn the guest API off and deny Btrfs subvolume ioctls'
    # The storage repair hint names the migration's own image when no update journal exists.
    (
        awk '/^storage_check\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$repo/tools/guests" >"$scratch/storage"
        [ -s "$scratch/storage" ]
        sh -n "$scratch/storage"
        . "$scratch/storage"
        pool=$scratch/pool
        ic() { case $1 in query) echo '[{"name":"fw2","type":"virtual-machine"}]' ;; storage) echo '[]' ;; *) return 1 ;; esac; }
        die() { echo "$*" >"$scratch/hint"; exit 1; }
        rm -f "$state/pending"
        mkdir -p "$state/fw.topology"
        echo old-image >"$state/fw.topology/fw2.old"
        echo new-image >"$state/fw.topology/fw2.new"
        for generation in old new; do
            [ "$generation" = old ] || touch "$state/fw.topology/committed"
            if (storage_check); then exit 1; fi
            grep -q "rebuild $generation-image fw2; sys guests update" "$scratch/hint"
        done
        rm -rf "$state/fw.topology"
    )
    echo 'test-topology: the storage repair hint names the migration image'
else
    echo 'test-topology: SKIP jq work profile and storage hint fixtures (jq unavailable)'
fi
