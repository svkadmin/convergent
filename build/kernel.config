# ARCHITECTURE 3.1; merge over Gentoo's hardened kernel config.

# Verified root support must be built in.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_CRYPTO_SHA256=y

# dm-mod.waitfor needs the complete storage path before the initramfs.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_VMD=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Confidentiality lockdown and AppArmor.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
CONFIG_AUDIT=y

# Enforce module signatures; ephemeral build key.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y

# No kexec or hibernation.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_HIBERNATION is not set

# Built-in VFIO; no NVIDIA host driver.
CONFIG_IOMMUFD=y
CONFIG_VFIO=y
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_VFIO_PCI=y

# KVM built in (a modular kvm_intel was refused at load); Intel only, no Xen emulation.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
# CONFIG_KVM_AMD is not set
# CONFIG_KVM_XEN is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_NOVA_CORE is not set
# CONFIG_DRM_NOVA is not set

# No host Wi-Fi driver.
# CONFIG_IWLWIFI is not set

# Hardware and protocols the laptop does not have or use.
# CONFIG_FIREWIRE is not set
# CONFIG_ATALK is not set
# CONFIG_X25 is not set
# CONFIG_AFS_FS is not set
# CONFIG_AF_RXRPC is not set
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_CAN is not set
