# Convergent: kernel configuration merged over Gentoo's hardened configuration
# (ARCHITECTURE section 3.1). Installed by build/buildenv as /etc/kernel/config.d/.

# The root: a read-only EROFS image under dm-verity, set up by the kernel itself from the
# signed UKI command line (dm-mod.create=), so all of it must be built in.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_CRYPTO_SHA256=y

# Lockdown in confidentiality mode from the first instruction; AppArmor as the access control.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
CONFIG_AUDIT=y

# Every module signed, unsigned ones refused; the key exists only during the build.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y

# No replacing the running kernel, no hibernation (lockdown forbids both anyway).
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_HIBERNATION is not set

# The NVIDIA card is held by vfio-pci from the command line, before anything else could
# claim it; there is no host driver for it at all.
# IOMMUFD as a module would hold VFIO to a module too.
CONFIG_IOMMUFD=y
CONFIG_VFIO=y
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_VFIO_PCI=y
# CONFIG_DRM_NOUVEAU is not set

# The host can never take the radio back: no driver for the Wi-Fi card.
# CONFIG_IWLWIFI is not set

# Hardware and protocols the laptop does not have or use.
# CONFIG_FIREWIRE is not set
# CONFIG_ATALK is not set
# CONFIG_X25 is not set
# CONFIG_AFS_FS is not set
# CONFIG_AF_RXRPC is not set
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_CAN is not set
