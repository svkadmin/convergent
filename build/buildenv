#!/bin/sh
# ARCHITECTURE 6; run as root on the build host.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
. "$here/chroot.sh"

die() { echo "buildenv: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"

mirror=https://distfiles.gentoo.org/releases/amd64/autobuilds
key=/usr/share/openpgp-keys/gentoo-release.asc
[ -r "$key" ] || die "$key missing (sec-keys/openpgp-keys-gentoo-release)"

work=$(mktemp -d)
trap 'chroot_umount; rm -rf "$work"' EXIT

# Bootstrap the signed stage3 once.
if [ ! -x "$BUILDER/bin/sh" ]; then
	tarball="stage3-amd64-$STAGE3_VARIANT-$STAGE3_BUILD.tar.xz"
	curl -fsSL -o "$work/$tarball" "$mirror/$STAGE3_BUILD/$tarball"
	curl -fsSL -o "$work/$tarball.asc" "$mirror/$STAGE3_BUILD/$tarball.asc"
	GNUPGHOME="$work/gnupg"; export GNUPGHOME
	mkdir -m 700 "$GNUPGHOME"
	gpg -q --import "$key"
	gpg -q --verify "$work/$tarball.asc" "$work/$tarball" || die "stage3 signature does not verify"
	mkdir -p "$BUILDER"
	tar -xpf "$work/$tarball" --xattrs-include='*.*' --numeric-owner -C "$BUILDER"
	echo "buildenv: builder created from $tarball"
fi

# Replace Portage configuration from the repository.
etc="$BUILDER/etc/portage"
[ -d "$etc/make.conf" ] || { rm -f "$etc/make.conf"; mkdir "$etc/make.conf"; }
cp "$repo/portage/make.conf" "$etc/make.conf/10-convergent"
jobs=$(nproc)
printf 'MAKEOPTS="-j%s -l%s"\nEMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --jobs=4 --load-average=%s"\n' \
	"$jobs" "$jobs" "$jobs" >"$etc/make.conf/90-local"
for d in package.use package.accept_keywords package.license sets; do
	rm -rf "${etc:?}/$d"
	mkdir -p "$etc/$d"
	cp -r "$repo/portage/$d/." "$etc/$d/"
done
cp "$here/builder.use" "$etc/package.use/zz-builder"
# Our one-package overlay (DECISIONS 41).
rm -rf "$BUILDER/var/db/repos/convergent"
cp -r "$repo/portage/overlay" "$BUILDER/var/db/repos/convergent"
mkdir -p "$etc/repos.conf"
printf '[convergent]\nlocation = /var/db/repos/convergent\n' >"$etc/repos.conf/convergent.conf"
# Use the builder's keyring when installing into /staging.
printf '%s\n' '#!/bin/sh' 'ROOT=/ EROOT=/ exec /usr/bin/getuto "$@"' >"$BUILDER/usr/local/bin/getuto-builder"
chmod 755 "$BUILDER/usr/local/bin/getuto-builder"
echo 'PORTAGE_TRUST_HELPER=/usr/local/bin/getuto-builder' >"$etc/make.conf/85-trust"
cp "$here/builder.set" "$etc/sets/convergent-builder"
# Gentoo kernel configuration fragment.
install -D -m 0644 "$here/kernel.config" "$BUILDER/etc/kernel/config.d/50-convergent.config"
cp -L /etc/resolv.conf "$BUILDER/etc/resolv.conf"

# Verify pinned snapshot; select profile and binary-package keys.
chroot_mount
stamp=/var/db/repos/gentoo/.convergent-snapshot
chroot "$BUILDER" /bin/sh -eu -c "
	if [ \"\$(cat $stamp 2>/dev/null)\" = '$SNAPSHOT_DATE' ]; then
		echo 'buildenv: snapshot $SNAPSHOT_DATE already in place'
	else
		emerge-webrsync -q --revert=$SNAPSHOT_DATE
		echo '$SNAPSHOT_DATE' >$stamp
	fi
	eselect profile set $PROFILE
	getuto >/dev/null
"

# Persistent key for signed local binary packages.
chroot "$BUILDER" /bin/sh -eu <<'EOF'
home=/etc/convergent/binpkg-gnupg
if [ ! -s "$home/fingerprint" ]; then
	install -d -m 700 "$home"
	gpg --homedir "$home" --batch --passphrase '' \
		--quick-gen-key 'Convergent builder <builder@convergent.invalid>' ed25519 sign never
	gpg --homedir "$home" --list-secret-keys --with-colons |
		awk -F: '/^fpr/ { print $10; exit }' >"$home/fingerprint"
fi
fpr=$(cat "$home/fingerprint")
gpg --homedir "$home" --export --armor "$fpr" | gpg --homedir /etc/portage/gnupg --batch --quiet --import
gpg --homedir /etc/portage/gnupg --batch --yes --pinentry-mode loopback \
	--passphrase-file /etc/portage/gnupg/pass --quick-lsign-key "$fpr"
# Refresh trustdb before unprivileged verification.
gpg --homedir /etc/portage/gnupg --batch --check-trustdb
printf '%s\n' 'FEATURES="${FEATURES} binpkg-signing"' \
	"BINPKG_GPG_SIGNING_GPG_HOME=\"$home\"" "BINPKG_GPG_SIGNING_KEY=\"$fpr\"" \
	>/etc/portage/make.conf/86-signing
gpgconf --homedir "$home" --kill all
EOF
# Install builder tools.
chroot "$BUILDER" emerge --noreplace --quiet-build=y @convergent-builder
echo "buildenv: builder ready at $BUILDER (snapshot $SNAPSHOT_DATE, profile $PROFILE)"
