#!/bin/sh
# Offline USB enrollment fixtures; no daemon or root needed.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' 0
trap 'exit 1' HUP INT TERM
export fixture
mkdir "$fixture/bin"
# Exercise the complete enrollment body, replacing only terminal approval.
sed -n '/^enrol() [({]$/,/^[)}]$/p' "$here/../tools/devices" |
	sed '1d; $d; /needs a terminal/d' >"$fixture/body"
[ -s "$fixture/body" ]
# Keep the real timeout and KILL escalation, with a cheap fixture deadline.
sed 's/timeout -k 1 30 /timeout -k 1 1 /g' "$fixture/body" >"$fixture/timed"
mv "$fixture/timed" "$fixture/body"
sed -n "/<<'COMMIT' &$/,/^COMMIT$/p" "$fixture/body" | sed '1d; $d' >"$fixture/commit"
[ -s "$fixture/commit" ]
cat >"$fixture/enrol" <<'ENROL'
die() { echo "$*" >&2; exit 1; }
ask() { :; }
exec 9>"$fixture/usb.lock"
flock -x 9
enrol_pid=$$
export enrol_pid
. "$fixture/body"
ENROL
cat >"$fixture/bin/usbguard" <<'MOCK'
#!/bin/sh
set -eu
case $1 in
--fixture-probe) echo mock-usbguard; exit ;;
generate-policy)
	printf 'allow id 1234:5678 hash "approved"\nallow id 1234:5679 hash "declined"\n'
	exit ;;
list-rules) echo '1: allow'; exit ;;
list-devices) [ "$#" = 1 ]; [ "$(cat "$fixture/daemon")" = running ]; exit ;;
append-rule)
	[ "$#" = 4 ] && [ "$2:$3:$4" = '-a:0:allow id 1234:5678 hash "approved"' ] ;;
remove-rule) [ "$#" = 2 ] && [ "$2" = 1 ] ;;
restart)
	[ "$#" = 1 ]
	echo stopped >"$fixture/daemon"
	echo interrupted >"$fixture/service"
	[ "$recovery" != running ] || echo running >"$fixture/daemon" ;;
zap) [ "$#" = 1 ]; echo stopped >"$fixture/service" ;;
start)
	[ "$#" = 1 ] && [ "$(cat "$fixture/service")" = stopped ]
	case $recovery in
	no) exit 1 ;;
	hang) exec python3 "$fixture/interrupt.py" ;;
	esac
	echo running >"$fixture/daemon" ;;
logged) [ "$#" = 1 ] ;;
*) exit 90 ;;
esac
echo "$1" >>"$fixture/events"
if [ "$phase" = "$1" ]; then
	[ "$fault" != hang ] || exec python3 "$fixture/interrupt.py"
	python3 "$fixture/interrupt.py"
	[ "$fault" = no ] || exit 1
fi
[ "$1" != restart ] || echo running >"$fixture/daemon"
echo "$1 done" >>"$fixture/events"
MOCK
cat >"$fixture/bin/rc-service" <<'MOCK'
#!/bin/sh
set -eu
[ "${1:-}" != --fixture-probe ] || { echo mock-rc-service; exit; }
[ "$#" = 2 ] && [ "$1" = usbguard ]
case $2 in restart|zap|start) exec usbguard "$2" ;; *) exit 90 ;; esac
MOCK
cat >"$fixture/bin/logger" <<'MOCK'
#!/bin/sh
set -eu
[ "${1:-}" != --fixture-probe ] || { echo mock-logger; exit; }
[ "$#" = 3 ] && [ "$1:$2:$3" = '-t:devices:USB policy replaced after individual review' ]
exec usbguard logged
MOCK
cat >"$fixture/interrupt.py" <<'PY'
import os
import signal
import time

parent = int(os.environ["enrol_pid"])
assert os.getsid(0) != os.getsid(parent), "commit shares the terminal session"
# OpenRC installs handlers even for signals ignored by its caller.
def interrupted(signum, frame):
    raise SystemExit(91)

for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(sig, interrupted)
if os.environ["signal"] != "none":
    sig = getattr(signal, "SIG" + os.environ["signal"])
    os.killpg(parent, sig)
    time.sleep(0.05)
    os.killpg(parent, sig)
if os.environ["fault"] == "hang":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    # Longer than both deadlines; a missing bound must fail, not hang the test.
    time.sleep(5)
    raise SystemExit("hung command escaped its deadline")
PY
chmod +x "$fixture/bin/"*
# /tmp may be noexec: never let PATH skip a mock for the real policy command.
check_mocks() {
	for mock in usbguard rc-service logger; do
		[ "$("$fixture/bin/$mock" --fixture-probe)" = "mock-$mock" ] || return 1
	done
}
chmod -x "$fixture/bin/usbguard"
if check_mocks 2>/dev/null; then echo 'non-executable mock accepted'; exit 1; fi
chmod +x "$fixture/bin/usbguard"
check_mocks || { echo 'fixture mocks cannot execute (noexec temporary directory?)'; exit 1; }
for script in "$fixture/body" "$fixture/commit" "$fixture/enrol" "$fixture/bin/"*; do sh -n "$script"; done
PATH=$fixture/bin:$PATH
recovery=no
export PATH phase signal fault recovery
printf 'yes\nno\n' >"$fixture/answers"
printf 'append-rule\nappend-rule done\nremove-rule\nremove-rule done\nrestart\nrestart done\nlogged\nlogged done\n' >"$fixture/expected"
for phase in append-rule remove-rule restart logged; do
	for signal in none HUP INT TERM; do
		fault=no rc=0
		: >"$fixture/events"
		setsid -w sh -eu "$fixture/enrol" <"$fixture/answers" >"$fixture/out" 2>&1 || rc=$?
		case $signal in none) want=0 ;; HUP) want=129 ;; INT) want=130 ;; TERM) want=143 ;; esac
		[ "$rc" = "$want" ] || { cat "$fixture/out"; echo "$phase/$signal: status $rc, expected $want"; exit 1; }
		cmp "$fixture/expected" "$fixture/events"
	done
	# Unrecovered command failures must still be reported.
	signal=none fault=yes
	: >"$fixture/events"
	if setsid -w sh -eu "$fixture/enrol" <"$fixture/answers" >"$fixture/out" 2>&1; then exit 1; fi
	case $phase in
	append-rule) message='append failed' ;;
	remove-rule) message='removal failed' ;;
	restart) message='USBGuard recovery failed' ;;
	logged) message='logging failed' ;;
	esac
	grep -q "$message" "$fixture/out"
	if grep -qx "$phase done" "$fixture/events"; then exit 1; fi
	# Cancellation must not leave a TERM-ignoring command holding the USB lock.
	signal=TERM fault=hang rc=0
	: >"$fixture/events"
	setsid -w sh -eu "$fixture/enrol" <"$fixture/answers" >"$fixture/out" 2>&1 || rc=$?
	[ "$rc" = 1 ] || { cat "$fixture/out"; echo "$phase hang: status $rc"; exit 1; }
	grep -q "$message" "$fixture/out"
	if grep -q 'hung command escaped' "$fixture/out"; then exit 1; fi
	if grep -qx "$phase done" "$fixture/events"; then exit 1; fi
	flock -n "$fixture/usb.lock" true
done
phase=restart signal=none
for fault in yes hang; do
	for recovery in running yes hang; do
		# A failed restart may already be healthy, or need a fresh start.
		[ "$recovery:$fault" != hang:yes ] || continue
		rc=0
		: >"$fixture/events"
		setsid -w sh -eu "$fixture/enrol" <"$fixture/answers" >"$fixture/out" 2>&1 || rc=$?
		if [ "$recovery" = hang ]; then
			[ "$rc" = 1 ]
			grep -q 'USBGuard recovery failed' "$fixture/out"
			if grep -qx logged "$fixture/events"; then exit 1; fi
		else
			[ "$rc" = 0 ] || { cat "$fixture/out"; exit 1; }
			[ "$(cat "$fixture/daemon")" = running ]
			grep -qx 'logged done' "$fixture/events"
			if [ "$recovery" = yes ]; then
				grep -qx 'zap done' "$fixture/events"
				grep -qx 'start done' "$fixture/events"
			elif grep -qx zap "$fixture/events"; then exit 1; fi
		fi
		if grep -q 'hung command escaped' "$fixture/out"; then exit 1; fi
		flock -n "$fixture/usb.lock" true
	done
done
echo 'devices: enrollment cancellation, failure and timeout fixtures passed'
