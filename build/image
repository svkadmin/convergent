#!/bin/sh
# image: assemble a release from the staging root (ARCHITECTURE section 6, steps 3 to 6):
# the image root, the EROFS image with its dm-verity tree, the initramfs, and one UKI per slot.
# Runs as root on the build host after build/packages. The UKIs are left unsigned; signing with
# the owner's offline key is the last step of a release (section 6, step 7).
#   build/image [release]      release defaults to the UTC date and time
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
. "$here/chroot.sh"

die() { echo "image: $*" >&2; exit 1; }
input=${CONVERGENT_CONFIG:-/etc/convergent/config.yaml}
cfg() { sh "$repo/tools/config-get" "$input" "$1"; }
hostname=$(cfg hostname)
[ -e "$input" ] || echo 'image: config absent; using defaults' >&2
timezone=$(cfg timezone)
keymap=$(cfg console_keymap)
layouts=$(cfg xkb_layouts)
scale=$(cfg display_scale)
nts=$(cfg nts_servers)
blocklist=$(cfg blocklist_url)
cap=$(cfg cpu_cap_khz)
idle=$(cfg idle_lock_minutes)
state_max=$(cfg state_max_gib)
[ "$(id -u)" = 0 ] || die "run as root"

release=${1:-$(date -u +%Y%m%d%H%M)}
case $release in '' | *[!0-9]*) die "release must be digits: $release" ;; esac
staging="$BUILDER/staging"
root="$BUILDER/image-root"                 # the image root, a copy of the staging root
out="$BUILDER/releases/$release"           # inside the builder, so its tools can reach it
[ -d "$staging/usr" ] || die "no staging root; run build/packages first"
[ ! -e "$out" ] || die "release $release exists already"
mkdir -p "$out"

# 1. The image root: the staging root, this repository's rootfs over it, then everything the
#    laptop does not run taken out again.
rm -rf "$root"
cp -a "$staging" "$root"
# Owned by root whatever the checkout's owner; modes kept.
cp -R --preserve=mode,timestamps,links "$repo/rootfs/." "$root/"
# A git archive tree is group-writable throughout; cronie then skips cron.d files, and /etc became 0775.
(cd "$repo/rootfs" && find . ! -type l ! -perm -1000 -perm /022 -print0) | (cd "$root" && xargs -0r chmod go-w)
! find "$root/etc" "$root/usr/local" ! -type l ! -perm -1000 -perm /022 | grep . || die 'group- or world-writable files in the image (above)'
rm -f "$root/etc/convergent/config.yaml"
[ -f "$root/usr/share/zoneinfo/$timezone" ] || die "timezone is not installed: $timezone"
ln -sfn "../usr/share/zoneinfo/$timezone" "$root/etc/localtime"
printf '%s\n' "$timezone" >"$root/etc/timezone"
printf 'hostname="%s"\n' "$hostname" >"$root/etc/conf.d/hostname"
aliases=host
[ "$hostname" = host ] || aliases="host $hostname"
printf '127.0.0.1\tlocalhost %s\n::1\tlocalhost\n' "$aliases" >"$root/etc/hosts"
find "$root/usr/share/keymaps" -name "$keymap.map*" | grep -q . || die "console_keymap $keymap is not an installed keymap"
printf 'keymap="%s"\n' "$keymap" >"$root/etc/conf.d/keymaps"
printf '%s\n' "$cap" >"$root/usr/lib/convergent/cpu-cap-khz"
printf '%s\n' "$state_max" >"$root/usr/lib/convergent/state-max-gib"
{
	printf '%s\n' "$nts" | awk -F, '{for (i=1;i<=NF;i++) if (!seen[$i]++) print "server " $i " iburst nts"}'
	sed '/^server /d' "$repo/rootfs/etc/chrony/chrony.conf"
} >"$root/etc/chrony/chrony.conf"
{
	printf "BLOCKLIST_URL='%s'\n" "$blocklist"
	sed '/^BLOCKLIST_URL=/d' "$repo/rootfs/etc/convergent/dns.conf"
} >"$root/etc/convergent/dns.conf"
xkb_layout=$(printf '%s\n' "$layouts" | sed 's/([^)]*)//g')
xkb_variant=$(printf '%s\n' "$layouts" | sed 's/[a-z][a-z]*\((\([^)]*\))\)\{0,1\}/\2/g')
# The power-off first: the lock, always the first timeout, could otherwise become 660 and be taken.
sed -i "s/timeout 660 /timeout $((idle * 60 + 60)) /; s/timeout 600 /timeout $((idle * 60)) /; s/xkb_layout \"us\"/xkb_layout \"$xkb_layout\"/; s/xkb_variant \"\"/xkb_variant \"$xkb_variant\"/" \
	"$root/etc/sway/config.d/convergent"
if [ -n "$scale" ]; then
	sed -i "/^include ~\/\.config\/sway\/config.d\/\*/i output * scale $scale" "$root/etc/sway/config.d/convergent"
fi
# The stock config's wallpaper is not installed (no wallpapers USE): its bg line would be a config error.
sed -i '/^output \* bg /d' "$root/etc/sway/config"
! grep -q '^output \* bg ' "$root/etc/sway/config" || die 'the stock sway config still sets a wallpaper'
# tty1 logs in through greetd (etc/greetd/config.toml); the other consoles keep agetty.
# greetd's own messages go to syslog: on the console they draw over the greeter.
sed -i 's#^c1:12345:respawn:/sbin/agetty .* tty1 linux$#c1:12345:respawn:/usr/bin/greetd 2>\&1 | logger -t greetd#' "$root/etc/inittab"
grep -qx 'c1:12345:respawn:/usr/bin/greetd 2>&1 | logger -t greetd' "$root/etc/inittab" || die 'tty1 does not run greetd'
# Modes git does not keep.
chmod 0440 "$root"/etc/sudoers.d/*
chmod 0600 "$root"/etc/audit/rules.d/*
# The tools of ARCHITECTURE section 12.
install -D -m 0755 -t "$root/usr/local/sbin" "$repo"/tools/*
# The signed debug channel is for bleeding-edge testing only; stable never carries it.
[ "$CHANNEL" = bleeding-edge ] || rm -f "$root/usr/local/sbin/debug"
install -m 0755 "$repo/install/install" "$root/usr/local/sbin/convergent-install"   # not "install": coreutils
chmod 0755 "$root"/etc/init.d/convergent-* "$root"/usr/lib/convergent/health.d/*
# The installed kernel is the one with sources; module trees left by an older one go.
kver=$(ls -d "$root"/usr/src/linux-* | sed 's|.*/linux-||')
for m in "$root"/lib/modules/*; do [ "${m##*/}" = "$kver" ] || rm -rf "$m"; done
[ "$(echo "$kver" | wc -l)" = 1 ] || die "expected one kernel in the image, found: $kver"
cp "$root/usr/src/linux-$kver/arch/x86/boot/bzImage" "$out/vmlinuz"
# The kernel as it was really built: a cached package could predate build/kernel.config.
config="$root/usr/src/linux-$kver/.config"
for want in CONFIG_DM_INIT=y CONFIG_DM_VERITY=y CONFIG_EROFS_FS=y CONFIG_MODULE_SIG_FORCE=y \
	CONFIG_BLK_DEV_NVME=y CONFIG_NVME_CORE=y CONFIG_VMD=y CONFIG_USB=y CONFIG_USB_PCI=y \
	CONFIG_USB_XHCI_HCD=y CONFIG_USB_XHCI_PCI=y CONFIG_USB_STORAGE=y CONFIG_USB_UAS=y \
	CONFIG_SCSI=y CONFIG_BLK_DEV_SD=y \
	CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y CONFIG_VFIO_PCI=y CONFIG_KVM_INTEL=y \
	'# CONFIG_KEXEC is not set' '# CONFIG_KEXEC_FILE is not set' '# CONFIG_HIBERNATION is not set' \
	'# CONFIG_IWLWIFI is not set' '# CONFIG_DRM_NOUVEAU is not set'; do
	grep -qxF "$want" "$config" || die "the kernel was not built with: $want (rebuild sys-kernel/gentoo-kernel)"
done
# Kconfig omits disabled symbols whose dependencies (such as Rust) are unavailable.
for symbol in NOVA_CORE DRM_NOVA; do
	! grep -Eq "^CONFIG_${symbol}=[ym]$" "$config" || die "the kernel enables $symbol (rebuild sys-kernel/gentoo-kernel)"
done
# Keep the actual config for driver selection and release review.
cp "$config" "$out/kernel.config"
config="$out/kernel.config"
chroot_mount
profiles=
trap '[ -z "$profiles" ] || rm -rf "$BUILDER$profiles"; chroot_umount' EXIT
bld() { chroot "$BUILDER" "$@"; }   # run a command inside the builder
rel=/releases/$release
# Early microcode: one uncompressed newc archive, as intel-uc.img uses.
mkdir -p "$out/microcode/kernel/x86/microcode"
ucode="$out/microcode/kernel/x86/microcode/GenuineIntel.bin"
: >"$ucode"
for cpu in $MICROCODE_KEEP; do
	fw="/staging/usr/lib/firmware/intel-ucode/$cpu"
	if [ -s "$BUILDER$fw" ]; then
		cat "$BUILDER$fw" >>"$ucode"
	elif [ -s "$BUILDER$fw.zst" ]; then
		bld zstd -dc "$fw.zst" >>"$ucode"
	elif [ -s "$BUILDER$fw.xz" ]; then
		bld xz -dc "$fw.xz" >>"$ucode"
	else
		die "no microcode for $cpu (sys-firmware/intel-microcode)"
	fi
done
bld sh -c 'cd "$1" && find kernel -print | cpio -o -H newc --owner=0:0 --reproducible' sh \
	"$rel/microcode" >"$out/microcode.cpio"
[ "$(stat -c %s "$out/microcode.cpio")" -lt 1048576 ] || die 'early microcode exceeds 1 MiB'
rm -rf "$out/microcode"

# Remove hardware classes, retaining dependencies of every surviving module.
bld depmod -b /image-root "$kver"
modules="$root/lib/modules/$kver"
(cd "$modules" && find kernel -type f -name '*.ko*' | sort) >"$out/modules.before"
(
	set -f
	drop=$(printf '%s\n' "$MODULE_DROP" | sed 's/#.*//')
	# shellcheck disable=SC2254 # the patterns are globs
	while read -r f; do
		for pattern in $MODULE_KEEP; do case ${f#kernel/} in $pattern) continue 2 ;; esac; done
		for pattern in $drop; do
			case ${f#kernel/} in $pattern) echo "$f"; break ;; esac
		done
	done <"$out/modules.before"
) >"$out/modules.candidates"
awk 'FILENAME == ARGV[1] {drop[$1]=1; next}
	{gsub(/:/, ""); line[++n]=$0}
	END {
		do {
			changed=0
			for (i=1;i<=n;i++) {
				count=split(line[i], field)
				if (field[1] in drop) continue
				for (j=2;j<=count;j++) if (field[j] in drop) {delete drop[field[j]]; changed=1}
			}
		} while (changed)
		for (f in drop) print f
	}' "$out/modules.candidates" "$modules/modules.dep" | sort >"$out/modules.removed"
while read -r f; do rm -f "$modules/$f"; done <"$out/modules.removed"
rm "$out/modules.candidates"
(cd "$modules" && find kernel -type f -name '*.ko*' | sort) >"$out/modules.after"
gccdir=$(ls -d "$root"/usr/lib/gcc/x86_64-pc-linux-gnu/* | head -n 1)
# Super+d lists apps by their desktop entries: helpers that are not apps to pick go.
rm -f "$root"/usr/share/applications/footclient.desktop "$root"/usr/share/applications/foot-server.desktop \
	"$root"/usr/share/applications/qemu.desktop
rm -rf "$root"/usr/src "$root"/usr/include "$root"/usr/share/doc "$root"/usr/share/man \
	"$root"/usr/share/info "$root"/usr/share/gtk-doc "$root"/usr/lib*/pkgconfig "$root"/usr/share/pkgconfig \
	"$root"/var/db/pkg "$root"/var/db/repos "$root"/var/cache/* "$root"/var/lib/portage "$root"/etc/portage \
	"$root"/etc/kernel "${root:?}"/boot/* "$root"/usr/libexec/gcc "$gccdir/include" "$gccdir/plugin"
find "$root/usr/lib" "$root/usr/lib64" -name '*.a' -delete
find "$gccdir" -maxdepth 1 \( -name '*.o' -o -name '*.la' \) -delete
# Unused multilib and SPIR-V tools; the library check below backs this.
(cd "$root" && rm -rf $IMAGE_DROP)
# The compiler itself; gcc's package stays only for the C++ runtime libraries in $gccdir.
find "$root/usr/bin" \( -name '*gcc*' -o -name '*g++*' -o -name 'c++' -o -name 'cc' -o -name 'cpp' \
	-o -name 'x86_64-pc-linux-gnu-*' \) -delete
# Unused parts of needed packages (measured on release 202610181918): the compiler's own files,
# gcc runtimes nothing links, Incus' extra tools and foreign-OS agents, protoc, the SSH server (the
# host runs none) and QEMU firmware for other architectures. The library check below backs this.
rm -rf "$root"/usr/x86_64-pc-linux-gnu/gcc-bin "$root"/usr/share/gcc-data "$gccdir/32" \
	"$root"/usr/bin/incus-user "$root"/usr/bin/incus-benchmark "$root"/usr/bin/incus-migrate \
	"$root"/usr/bin/incus-simplestreams "$root"/usr/bin/lxc-to-incus "$root"/usr/bin/lxd-to-incus \
	"$root"/etc/init.d/incus-user "$root"/usr/libexec/incus/agents/*windows* "$root"/usr/libexec/incus/agents/*i686* \
	"$root"/usr/lib64/libprotoc* "$root"/usr/bin/protoc* \
	"$root"/usr/sbin/sshd "$root"/usr/lib64/misc/sshd-session "$root"/usr/lib64/misc/sshd-auth "$root"/etc/init.d/sshd \
	"$root"/usr/share/edk2/ArmVirtQemu-AARCH64 "$root"/usr/share/edk2/OvmfX64/*.qcow2 "$root"/usr/share/edk2/OvmfX64/Shell.efi
find "$gccdir" -maxdepth 1 \( -name 'libgfortran*' -o -name 'libquadmath*' -o -name 'lib*san*' -o -name 'libitm*' \
	-o -name 'libcc1*' -o -name 'libgomp-plugin*' \) -exec rm -rf {} +
(cd "$root/usr/share/qemu" && rm -rf edk2-arm* edk2-aarch64* edk2-riscv* edk2-loongarch64* edk2-i386-code.fd \
	edk2-i386-secure-code.fd skiboot.lid openbios-* slof.bin hppa-* u-boot* opensbi-* palcode-* s390-* pnv-* \
	vof* npcm* ast27x0* QEMU,* qemu_vga.ndrv dtb)
printf '%s\n' "$release" >"$root/usr/lib/convergent/release"
# Mount points the initramfs needs: the image is read-only once made.
mkdir -p "$root/dev" "$root/proc" "$root/sys" "$root/run" "$root/home" "$root/tmp" "$root/var" "$root/srv"
# The audit watches need their directories before the first guests init, check or dns-push.
install -d -m 0700 "$root/var/lib/convergent/ssh" "$root/var/lib/convergent/check" "$root/var/lib/convergent/dns"
# Every writable /etc entry must exist in the image: the initramfs binds over it.
grep -v '^#' "$root/usr/lib/convergent/etc-state" | while read -r entry; do
	[ -n "$entry" ] && [ ! -e "$root/etc/$entry" ] || continue
	mkdir -p "$(dirname "$root/etc/$entry")"
	install -m 0644 /dev/null "$root/etc/$entry"
done
ln -sfn ../proc/self/mounts "$root/etc/mtab"   # as systemd-tmpfiles makes it
# auditd loads audit.rules as it is; the fragments are put together here, as augenrules would.
cat "$root"/etc/audit/rules.d/*.rules >"$root/etc/audit/audit.rules"
chmod 0600 "$root/etc/audit/audit.rules"
# What starts at boot. Left out: mtab (the link above), network file systems (netmount) and a
# DHCP client (every address is static).
rl="$root/etc/runlevels"
rm -f "$rl/boot/mtab" "$rl/default/netmount" "$rl/default/dhcpcd"
for s in boot/keymaps boot/convergent-firewall boot/usbguard boot/auditd boot/apparmor default/syslog-ng default/chronyd \
	default/cronie default/acpid default/dbus default/bluetooth default/seatd default/node_exporter default/lxcfs default/incus \
	sysinit/convergent-watchdog default/convergent-bless default/convergent-setup boot/convergent-net; do
	[ -e "$root/etc/init.d/${s#*/}" ] || die "no init script for ${s#*/}"
	ln -sfn "/etc/init.d/${s#*/}" "$rl/$s"
done

# 2. Firmware: copy selected paths with links resolved before dropping other generations.
mkdir -p "$out/firmware"
(
	cd "$root/usr/lib/firmware"
	find . ! -type d | while read -r f; do
		for k in $FIRMWARE_KEEP; do
			case ${f#./} in "$k"*) cp -aL --parents "$f" "$out/firmware/"; break ;; esac
		done
	done
)
rm -rf "$root/usr/lib/firmware"
mv "$out/firmware" "$root/usr/lib/firmware"
for fw in mtl_dmc.bin mtl_guc_70.bin mtl_huc_gsc.bin mtl_gsc_1.bin; do
	f="$root/usr/lib/firmware/i915/$fw"
	[ -s "$f" ] || [ -s "$f.zst" ] || [ -s "$f.xz" ] || die "missing Arrow Lake firmware: $fw"
done

# C.UTF-8 (foot and other programs need a UTF-8 locale; the image has no locale-gen) and LANG
# from rootfs/etc/env.d into profile.env.
mkdir -p "$root/usr/lib/locale"
bld localedef --prefix=/image-root -i C -f UTF-8 C.UTF-8 || die "cannot compile C.UTF-8"
bld env ROOT=/image-root env-update || die "env-update failed"
grep -q "LANG='C.UTF-8'" "$root/etc/profile.env" || die "LANG is not in profile.env"
# Setuid, setgid and file capabilities only where the laptop needs them: nothing else gains
# privilege by being run. cdrtools' CD-writing programs (Incus needs only mkisofs) go entirely.
rm -f "$root"/usr/bin/rscsi "$root"/usr/bin/cdrecord "$root"/usr/bin/cdda2wav "$root"/usr/bin/readcd
find "$root" -xdev -type f -perm /6000 | while read -r f; do
	case ${f##*/} in sudo | su | passwd | unix_chkpwd | dbus-daemon-launch-helper) continue ;; esac
	chmod ug-s "$f" && echo "image: setuid/setgid removed: ${f#"$root"}"
done
bld getcap -r /image-root 2>/dev/null | awk '{ print $1 }' | while read -r f; do
	bld setcap -r "$f" && echo "image: capabilities removed: ${f#/image-root}"
done
[ -z "$(bld getcap -r /image-root 2>/dev/null)" ] || die "file capabilities remain in the image"
# Translations: the session runs C.UTF-8, compiled above.
rm -rf "$root"/usr/share/locale/*/ "$root"/usr/share/i18n
# A config the daemon rejects would only show at boot, as a release that never marks itself good.
chroot "$root" syslog-ng --syntax-only -f /etc/syslog-ng/syslog-ng.conf || die "syslog-ng.conf does not parse"
chroot "$root" visudo -cq || die "sudoers does not parse"
chroot "$root" openssl version >/dev/null || die "no openssl CLI in the image"
# Online updates: the channel's key and download URL. Without the key the image takes only
# releases written with CONVERGENT_UNSIGNED=1.
keys=/etc/convergent/keys
case $CHANNEL in '' | *[!a-z0-9-]*) die "CHANNEL must be lowercase letters, digits and dashes" ;; esac
if [ -f "$keys/$CHANNEL.pub" ]; then
	install -m 0644 "$keys/$CHANNEL.pub" "$root/etc/convergent/release.pub"
	# A subshell: the bucket secrets stay out of this build.
	url=$(. "/etc/convergent/r2-$CHANNEL.env" 2>/dev/null; echo "${R2_PUBLIC_URL:-}") || url=
	case $url in https://*[!A-Za-z0-9./-]* | */) url= ;; esac
	case $url in https://?*) printf 'UPDATE_URL=%s/%s\n' "$url" "$CHANNEL" >"$root/etc/convergent/update.conf" ;;
	*) echo "image: no R2_PUBLIC_URL in /etc/convergent/r2-$CHANNEL.env; online updates off" >&2 ;; esac
else
	echo "image: no $keys/$CHANNEL.pub; this release accepts only unsigned writes" >&2
fi
# 3. The initramfs. With --sysroot dracut takes its modules and every binary from the image root,
#    so Convergent's module is put there for the run; afterwards dracut leaves the image, which
#    never builds an initramfs itself.
cp -r "$repo/initramfs/90convergent" "$repo/initramfs/91convergent-rescue" "$root/usr/lib/dracut/modules.d/"
chmod 0755 "$root/usr/lib/dracut/modules.d/90convergent"/*.sh "$root/usr/lib/dracut/modules.d/91convergent-rescue"/*.sh
# The links to the kernel sources and build files point at nothing once /usr/src is gone.
find "$root/lib/modules/$kver" -maxdepth 1 -xtype l -delete
bld depmod -b /image-root "$kver"
# Check the built kernel, not the build host: the prompt needs both input and a framebuffer.
for symbol in VT VT_CONSOLE FRAMEBUFFER_CONSOLE DRM_FBDEV_EMULATION SERIAL_8250_CONSOLE; do
	grep -qx "CONFIG_$symbol=y" "$config" || die "no built-in $symbol for the passphrase console"
done
drivers=
for pair in DRM_I915:i915 BLK_DEV_DM:dm_mod DM_CRYPT:dm_crypt DM_VERITY:dm_verity BTRFS_FS:btrfs \
	BLK_DEV_NVME:nvme VMD:vmd USB_XHCI_HCD:xhci_hcd USB_XHCI_PCI:xhci_pci USB_STORAGE:usb_storage USB_UAS:uas \
	BLK_DEV_SD:sd_mod SERIO_I8042:i8042 KEYBOARD_ATKBD:atkbd HID_GENERIC:hid_generic USB_HID:usbhid \
	VIRTIO_PCI:virtio_pci VIRTIO_BLK:virtio_blk SCSI_VIRTIO:virtio_scsi DRM_VIRTIO_GPU:virtio_gpu \
	VIRTIO_CONSOLE:virtio_console VIRTIO_NET:virtio_net USB4:thunderbolt; do
	symbol=${pair%:*}
	module=${pair#*:}
	case $(sed -n "s/^CONFIG_$symbol=//p" "$config") in
		y) ;;
		m) bld modinfo -b /image-root -k "$kver" "$module" >/dev/null || die "missing $module"
		   drivers="$drivers $module" ;;
		*) die "no $symbol for laptop/QEMU boot" ;;
	esac
done
# Modular console fallbacks, USB/HID variants and the dock's Type-C/I2C/pinctrl path.
# File discovery excludes built-ins; dracut brings each module's dependencies.
extra=$(find "$modules/kernel" -type f -name '*.ko*' | while read -r f; do
	case ${f#"$modules/kernel/"} in
		drivers/hid/* | drivers/input/keyboard/* | drivers/input/serio/* | \
		drivers/usb/core/* | drivers/usb/host/* | drivers/usb/storage/* | drivers/usb/typec/* | \
		drivers/usb/common/* | drivers/usb/roles/* | drivers/usb/misc/onboard_usb* | \
		drivers/thunderbolt/* | drivers/pinctrl/intel/* | drivers/i2c/busses/i2c-designware* | \
		drivers/mfd/intel-lpss* | drivers/platform/x86/intel/pmc/* | drivers/tty/serial/8250/* | \
		drivers/gpu/drm/sysfb/* | \
		drivers/gpu/drm/tiny/simpledrm.ko* | drivers/video/fbdev/efifb.ko* | \
		crypto/* | arch/x86/crypto/*)
			f=${f##*/}; echo "${f%%.ko*}" ;;
	esac
done)
drivers=$(printf '%s\n' $drivers $extra | sort -u)
printf '%s\n' "$drivers" >"$out/initramfs.drivers"
# Firmware is needed even when i915 is built in.
i915_fw=$(find "$root/usr/lib/firmware/i915" -type f | sed "s|^$root||")
bld dracut --quiet --force --no-hostonly --no-early-microcode --tmpdir /tmp --sysroot /image-root \
	--kver "$kver" --kmoddir "/image-root/lib/modules/$kver" --drivers "$drivers" \
	--fwdir /image-root/usr/lib/firmware --filesystems "btrfs erofs" \
	--install "$i915_fw" \
	--modules "base kernel-modules udev-rules rootfs-block dm crypt btrfs convergent" \
	"$rel/initramfs.img"
# Rescue is inside the verity image; no new release files or manifest fields.
profiles=$(bld mktemp -d /tmp/convergent-rescue.XXXXXX)
bld dracut --quiet --force --no-hostonly --no-early-microcode --tmpdir /tmp --sysroot /image-root \
	--kver "$kver" --kmoddir "/image-root/lib/modules/$kver" \
	--modules "base kernel-modules udev-rules dm crypt btrfs convergent convergent-rescue" --add-drivers "$drivers" \
	--fwdir /image-root/usr/lib/firmware --install "$i915_fw" \
	"$profiles/initramfs.img"
printf '%s' "convergent.rescue=1 rd.luks=0 rd.shell=0 rd.emergency=poweroff lockdown=confidentiality" \
	" intel_iommu=on iommu.strict=1 efi=disable_early_pci_dma kvm_intel.nested=0 init_on_alloc=1 slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none debugfs=off quiet" \
	" vfio-pci.ids=$VFIO_IDS" >"$BUILDER$profiles/cmdline"
printf 'ID=convergent\nIMAGE_ID=zz-convergent-rescue\nIMAGE_VERSION=%s\nPRETTY_NAME="Convergent rescue (%s)"\n' \
	"$release" "$release" >"$BUILDER$profiles/os-release"
bld ukify build --linux "$rel/vmlinuz" --initrd "$rel/microcode.cpio" --initrd "$profiles/initramfs.img" \
	--cmdline "@$profiles/cmdline" --os-release "@$profiles/os-release" --uname "$kver" \
	--output /image-root/usr/lib/convergent/rescue.efi >/dev/null
bld ukify inspect /image-root/usr/lib/convergent/rescue.efi >/dev/null || die "invalid rescue UKI"
bld lsinitrd "$profiles/initramfs.img" >"$BUILDER$profiles/contents"
for fw in $i915_fw; do
	awk -v file="${fw#/}" '$NF == file {found=1} END {exit !found}' "$BUILDER$profiles/contents" || die "rescue initramfs lacks $fw"
done
# Merged /usr: /sbin is usr/bin here.
for file in 's?bin/convergent-rescue' 's?bin/slot' lib/convergent-unlock.sh lib/convergent-recovery.sh; do
	grep -Eq " (usr/)?$file$" "$BUILDER$profiles/contents" || die "rescue initramfs lacks $file"
done
! grep -q 'convergent-state.sh' "$BUILDER$profiles/contents" || die "rescue contains the slot mount hook"
if [ -f "$root/etc/convergent/release.pub" ]; then
	grep -q ' etc/convergent/release.pub$' "$BUILDER$profiles/contents" || die "rescue lacks its release key"
fi
echo "image: rescue initramfs $(stat -c %s "$BUILDER$profiles/initramfs.img") bytes; UKI $(stat -c %s "$root/usr/lib/convergent/rescue.efi") bytes"
rm -rf "$BUILDER$profiles"
profiles=
bld lsinitrd "$rel/initramfs.img" >"$out/initramfs.list"
awk '$NF ~ /\/kernel\/.*\.ko(\..*)?$/ {sub(/^.*\/kernel\//, "kernel/", $NF); print $NF}' \
	"$out/initramfs.list" | sort -u >"$out/initramfs.modules"
rm -rf "$root/usr/lib/dracut" "$root/etc/dracut.conf" "$root/etc/dracut.conf.d" \
	"$root"/usr/bin/dracut* "$root/usr/bin/lsinitrd"

# ldd can mistake an ELF with a missing 32-bit loader for a static binary.
bld sh -c 'command -v readelf >/dev/null || exit 1
find /image-root/usr -type f -perm /111 | while read -r f; do
	loader=$(LC_ALL=C readelf -l "$f" 2>/dev/null | sed -n "s/.*Requesting program interpreter: \(.*\)]/\1/p")
	[ -z "$loader" ] || [ -e "/image-root$loader" ] || { echo "$f: missing $loader" >&2; exit 1; }
done' || die 'ELF interpreter missing after trimming'
# Every program and library still finds its libraries after the trimming above (about 30 s).
[ -x "$root/usr/bin/ldd" ] || die "no ldd in the image root for the library check"
missing=$(chroot "$root" /bin/sh -c 'find /usr/bin /usr/sbin /usr/libexec /usr/lib64 /usr/lib -xdev -type f \
	\( -perm -100 -o -name "*.so*" \) | while read -r f; do ldd "$f" | grep "not found" | sed "s|^|$f: |"; done' 2>/dev/null | sort -u)
[ -z "$missing" ] || { printf '%s\n' "$missing" >&2; die "libraries missing in the image (above)"; }
# Releases are published: no private key may be in the image.
! grep -rlIsx -e "-----BEGIN [A-Z ]*PRIVATE KEY-----" "$root" || die "private key material in the image root (above)"

# 4. The EROFS image and its dm-verity hash tree, one after the other in the slot image.
bld mkfs.erofs -zlz4hc "$rel/root.erofs" /image-root >/dev/null
size=$(stat -c %s "$out/root.erofs")
[ $((size % 4096)) = 0 ] || die "EROFS image is not a whole number of 4 KiB blocks"
blocks=$((size / 4096))
verity=$(bld veritysetup format --no-superblock --data-block-size=4096 --hash-block-size=4096 \
	"$rel/root.erofs" "$rel/root.hash")
roothash=$(echo "$verity" | awk '/^Root hash:/ { print $3 }')
salt=$(echo "$verity" | awk '/^Salt:/ { print $2 }')
[ -n "$roothash" ] && [ -n "$salt" ] || die "veritysetup gave no root hash"
cat "$out/root.erofs" "$out/root.hash" >"$out/slot.img"
rm "$out/root.erofs" "$out/root.hash"

# 5. One UKI per slot: the same kernel, initramfs and microcode; the command line names the slot.
for slot in a b; do
	part="PARTLABEL=cv-slot-$slot"
	table="vroot,,,ro,0 $((blocks * 8)) verity 1 $part $part 4096 4096 $blocks $blocks sha256 $roothash $salt"
	printf '%s' "root=/dev/dm-0 rootfstype=erofs ro dm-mod.waitfor=$part dm-mod.create=\"$table\"" \
		" convergent.release=$release rd.luks=0 rd.shell=0 rd.emergency=poweroff lockdown=confidentiality" \
		" intel_iommu=on iommu.strict=1 efi=disable_early_pci_dma kvm_intel.nested=0 init_on_alloc=1 slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none debugfs=off iTCO_wdt.heartbeat=180 quiet" \
		" vfio-pci.ids=$VFIO_IDS init=/sbin/init" >"$out/cmdline-$slot"
	# init= last: dracut hands init every bare word after it, and without it every bare word on
	# the line, so the "1" in the verity table would make sysvinit start in runlevel 1.
	# The stock name plus release and slot: the boot menu tells the two slots apart.
	name=$(sed -n "s/^PRETTY_NAME=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}$/\1/p" "$root/usr/lib/os-release")
	# IMAGE_VERSION orders the boot menu by release, whatever Gentoo's VERSION_ID does.
	{
		sed "/^IMAGE_\(ID\|VERSION\)=/d; s/^PRETTY_NAME=.*/PRETTY_NAME=\"${name:-Linux} $release (slot $slot)\"/" \
			"$root/usr/lib/os-release"
		printf 'IMAGE_ID=convergent\nIMAGE_VERSION=%s\n' "$release"
	} >"$out/os-release-$slot"
	profiles=$(bld mktemp -d /tmp/convergent-profile.XXXXXX)
	sed 's/ init=/ convergent.recovery=1 init=/' "$out/cmdline-$slot" >"$BUILDER$profiles/cmdline"
	grep -q ' convergent\.recovery=1 ' "$BUILDER$profiles/cmdline" || die "the recovery profile's command line lacks convergent.recovery=1"
	bld ukify build --profile 'ID=recovery
TITLE=Recovery' --cmdline "@$profiles/cmdline" --os-release '' --output "$profiles/p1.efi" >/dev/null
	# ukify supplies profile 0 here; joining a p0 fragment would add a third profile.
	bld ukify build --linux "$rel/vmlinuz" --initrd "$rel/microcode.cpio" \
		--initrd "$rel/initramfs.img" --cmdline "@$rel/cmdline-$slot" \
		--os-release "@$rel/os-release-$slot" --uname "$kver" \
		--profile 'ID=main' --join-profile "$profiles/p1.efi" \
		--output "$rel/convergent-$release-$slot.efi" >/dev/null
	rm -rf "$BUILDER$profiles"
	profiles=
	# Kept: build/test makes its UKIs with the same metadata.
done

# 6. The manifest: what the release is made of.
{
	echo "release $release"
	echo "kernel $kver"
	echo "roothash $roothash"
	sha256sum "$out/slot.img" "$out"/convergent-*.efi | sed "s|$out/||"
	# Exact sizes: a download stops at them.
	for f in "$out/slot.img" "$out"/convergent-*.efi; do echo "size ${f##*/} $(stat -c %s "$f")"; done
} >"$out/manifest"
[ ! -f "$keys/$CHANNEL.key" ] || "$here/sign" "$out"
echo "image: release $release in $out"
