#!/bin/sh
# Offline uplink selection and portal publication fixtures.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
sed -n '/^        if diag=/,/^        if wifi=/ { /^        if wifi=/d; p; }' "$repo/tools/check" >"$work/uplink"
sed -n '/^    wait$/,/^    exit \$?$/p' "$repo/tools/check" >"$work/publish"
sed -n '/^    portal_locked=0$/,/^    # Parallel/ { /^    # Parallel/d; p; }' "$repo/tools/check" >"$work/portal-lock"
for part in uplink publish portal-lock; do [ -s "$work/$part" ]; sh -n "$work/$part"; done
status=$work/status
mkdir "$status"
guest_reply() { [ "$*" = '65536 wan_probe diag' ] || return 1; cat "$work/diag"; }
for scenario in wired wifi noaddress nocarrier linkdown internal none; do
    case $scenario in wifi) first=wlan0 second=enp3s0 expected='up wlan' ;;
        *) first=enp3s0 second=wlan0 expected='up eth' ;; esac
    {
        echo '== addresses'
        echo 'eth0 100.80.0.2/24'
        [ "$scenario" = noaddress ] || echo 'enp3s0 192.0.2.2/24'
        echo 'wlan0 198.51.100.2/24'
        echo '== routes'
        [ "$scenario" != internal ] || echo 'default via 100.80.0.1 dev eth0'
        if [ "$scenario" != none ]; then
            suffix=
            [ "$scenario" != linkdown ] || suffix=linkdown
            printf 'default via 192.0.2.1 dev %s metric 203 %s\n' "$first" "$suffix"
            printf 'default via 198.51.100.1 dev %s metric 300\n' "$second"
        fi
        echo '== links'
        echo '2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP>'
        if [ "$scenario" = nocarrier ]; then echo '3: enp3s0: <BROADCAST,MULTICAST,UP>'
        else echo '3: enp3s0: <BROADCAST,MULTICAST,UP,LOWER_UP>'; fi
        echo '4: wlan0: <BROADCAST,MULTICAST,UP,LOWER_UP>'
    } >"$work/diag"
    case $scenario in noaddress|nocarrier|linkdown) expected='up wlan' ;; none) expected='nolink eth' ;; esac
    . "$work/uplink"
    [ "$(cat "$status/.wan")" = "$expected" ]
done
if guest_reply 128 wan_probe diag >/dev/null; then exit 1; fi
echo 'check status: route preference and eligibility passed'
flock() {
    case $* in
        '-s -n 7') [ "$scenario" != guests ] ;;
        # A guests run holds the portal lock for minutes: never wait for it.
        '-w 30 8') [ "$scenario" != guests ] || exit 97; [ "$scenario" != busy ] ;;
        '-n 8') case $scenario in busy|expiry|guests) return 1 ;; *) return 0 ;; esac ;;
        *) echo "unexpected flock: $*" >&2; exit 1 ;;
    esac
}
# Lock contention preserves both the sample and its age; other status still advances.
for scenario in busy guests on off inconsistent failed empty; do
    . "$work/portal-lock" || :
    echo on >"$status/portal"
    touch -t 200001010000 "$status/portal"
    previous=$(stat -c %Y "$status/portal")
    for node in fw1 fw2 wan; do echo on >"$status/.portal-$node"; done
    expected=unknown
    case $scenario in
        busy|guests) expected=on; for node in fw1 fw2 wan; do echo unknown >"$status/.portal-$node"; done ;;
        on) expected=on ;;
        off) expected=off; for node in fw1 fw2 wan; do echo off >"$status/.portal-$node"; done ;;
        inconsistent) echo off >"$status/.portal-wan" ;;
        failed) echo unknown >"$status/.portal-fw1" ;;
        empty) : >"$status/.portal-wan" ;;
    esac
    printf 'true true true true 1 false\n' >"$status/.running"
    echo 'up eth' >"$status/.wan"
    echo master >"$status/.fw1"
    echo backup >"$status/.fw2"
    echo fresh-wifi >"$status/.wifi"
    echo 1234 >"$status/.guestmem"
    for name in topology wifi guestmem; do echo old >"$status/$name"; done
    ( . "$work/publish" )
    [ "$(cat "$status/portal")" = "$expected" ]
    case $scenario in busy|guests) [ "$(stat -c %Y "$status/portal")" = "$previous" ] ;;
    *) [ "$(stat -c %Y "$status/portal")" -gt "$previous" ] ;; esac
    grep -qx 'uplink=eth wan=up fw1=master fw2=backup svc=up browsers=1 remote=off' "$status/topology"
    grep -qx fresh-wifi "$status/wifi"
    grep -qx 1234 "$status/guestmem"
done
echo 'check status: busy portal ages out, a guests run is not waited for; verified results and other status publish'
# Expiry wins four successive minute ticks, then releases within the lock wait.
scenario=expiry
echo on >"$status/portal"
for node in fw1 fw2 wan; do echo on >"$status/.portal-$node"; done
for tick in 1 2 3 4; do
    previous=$(stat -c %Y "$status/portal")
    sleep 1
    cp "$status/wifi" "$status/.wifi"
    cp "$status/guestmem" "$status/.guestmem"
    . "$work/portal-lock" || :
    ( . "$work/publish" )
    [ "$(cat "$status/portal")" = on ]
    [ "$(stat -c %Y "$status/portal")" -gt "$previous" ]
done
echo 'check status: repeated expiry contention refreshes the portal sample'
# The root autostart scan stays bounded: an oversized owner file fails at once, a hang at the deadline.
sed -n '/^autostart() {/,/^}/p' "$repo/tools/check" | sed "s|\([ #]\)/home\([ /]\)|\1$work/home\2|g" >"$work/autostart"
[ -s "$work/autostart" ]; sh -n "$work/autostart"
[ "$(grep -c "$work/home" "$work/autostart")" = 3 ]
grep -q "timeout -k 1 120 find $work/home " "$work/autostart"
sed 's/timeout -k 1 120 find/timeout -k 1 2 find/' "$work/autostart" >"$work/autostart-fast"
grep -q 'timeout -k 1 2 find' "$work/autostart-fast"
owner=$work/home/owner
mkdir -p "$owner/.config/sway" "$work/scan"
printf 'echo hi\n' >"$owner/.bashrc"
printf 'include /etc/sway/config\n' >"$owner/.config/sway/config"
scan() {
    started=$(date +%s) rc=0
    LC_ALL=C timeout -k 1 90 sh -c '. "$1"; work=$2; autostart' sh "$1" "$work/scan" 2>"$work/scan.err" || rc=$?
    elapsed=$(($(date +%s) - started))
}
scan "$work/autostart"
[ "$rc" = 0 ]
# Same lines as sha256sum on the file: accepted baselines stay valid.
sha256sum "$owner/.bashrc" "$owner/.config/sway/config" | LC_ALL=C sort | cmp - "$work/scan/autostart"
# An owner file over the cap is inventoried by size and times, at once.
mkdir -p "$owner/.local/bin"
truncate -s 1T "$owner/.local/bin/tool"
scan "$work/autostart"
[ "$rc" = 0 ] && [ "$elapsed" -lt 30 ] || exit 1
grep -qxF "$(stat -c 'size=1099511627776 mtime=%Y ctime=%Z  %n' "$owner/.local/bin/tool")" "$work/scan/autostart"
[ "$(wc -l <"$work/scan/autostart")" = 3 ]
rm -r "$owner/.local"
# The sway include check reads the same capped copy.
truncate -s 67108865 "$owner/.config/sway/config"
scan "$work/autostart"
[ "$rc" = 1 ] && [ "$elapsed" -lt 30 ] || exit 1
grep -qx "autostart file over 67108864 bytes: $owner/.config/sway/config" "$work/scan.err"
printf 'include /etc/sway/config\n' >"$owner/.config/sway/config"
# A read that never returns ends with the deadline, not with the locks held.
(
    fake=$(mktemp -d /var/tmp/check-fake.XXXXXX)
    trap 'rm -rf "$fake"' 0
    REAL_FIND=$(command -v find); export REAL_FIND
    printf '#!/bin/sh\ncase " $* " in *" -exec "*) exec sleep 20 ;; esac\nexec "$REAL_FIND" "$@"\n' >"$fake/find"
    chmod 755 "$fake/find"
    PATH=$fake:$PATH
    scan "$work/autostart-fast"
    [ "$rc" != 0 ] && [ "$elapsed" -lt 15 ] || exit 1
)
echo 'check: the autostart scan inventories oversized files, fails oversized includes at once and a hang at its deadline'
# Account diffs keep the user and the change, never a hash; other entries stay verbatim.
sed -n '/^# Keep diffs private/,/^done <"\$list"$/p' "$repo/tools/check" | sed "s|\"/etc/|\"$work/etc/|g" >"$work/etc-diff"
[ -s "$work/etc-diff" ]; sh -n "$work/etc-diff"
if grep -q '"/etc/' "$work/etc-diff"; then exit 1; fi
mkdir -p "$work/etc" "$work/accepted/etc" "$work/diff-run"
printf 'shadow\npasswd\n' >"$work/etc-list"
printf 'root:*:19000:0:::::\nowner:$y$j9T$oldsalt$oldhash:19000:0:99999:7:::\nlocked:!$y$j9T$ls$lh:19000::::::\nbin:!:19000::::::\n' >"$work/accepted/etc/shadow"
sed 's/^owner:[^:]*:19000:/owner:$y$j9T$newsalt$newhash:19001:/' "$work/accepted/etc/shadow" >"$work/etc/shadow"
printf 'owner:x:1000:1000::/home/owner:/bin/sh\n' >"$work/accepted/etc/passwd"
printf 'owner:x:1000:1000::/home/owner:/bin/zsh\n' >"$work/etc/passwd"
chmod 600 "$work/etc/shadow" "$work/accepted/etc/shadow"
(
    fixture=$work
    work=$fixture/diff-run baseline=$fixture/accepted list=$fixture/etc-list ok=1
    bad() { ok=0; printf 'FAIL %s\n' "$*" >>"$work/report"; }
    . "$fixture/etc-diff"
    [ "$ok" = 0 ]
    report=$work/report
    if grep -qF '$y$' "$report"; then exit 1; fi
    grep -qxF -- '-owner:<hash>:19000:0:99999:7:::' "$report"
    grep -qxF -- '+owner:<hash>:19001:0:99999:7:::' "$report"
    grep -qxF -- ' locked:!<hash>:19000::::::' "$report"
    grep -qxF -- ' root:*:19000:0:::::' "$report"
    grep -qxF -- ' bin:!:19000::::::' "$report"
    grep -qxF -- '+owner:x:1000:1000::/home/owner:/bin/zsh' "$report"
    grep -qx "FAIL $fixture/etc/shadow differs from last acceptance" "$report"
    grep -qx "FAIL $fixture/etc/passwd differs from last acceptance" "$report"
)
echo 'check: account diffs mask password hashes and keep the user and the change'

