#!/bin/sh
# Offline uplink selection and portal publication fixtures.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
sed -n '/^        if diag=/,/^        if wifi=/ { /^        if wifi=/d; p; }' "$repo/tools/check" >"$work/uplink"
sed -n '/^    wait$/,/^    exit \$?$/p' "$repo/tools/check" >"$work/publish"
sed -n '/^    portal_locked=0$/,/^    # Parallel/ { /^    # Parallel/d; p; }' "$repo/tools/check" >"$work/portal-lock"
for part in uplink publish portal-lock; do [ -s "$work/$part" ]; sh -n "$work/$part"; done
status=$work/status
mkdir "$status"
guest_reply() { [ "$*" = '65536 wan_probe diag' ] || return 1; cat "$work/diag"; }
for scenario in wired wifi noaddress nocarrier linkdown internal none; do
    case $scenario in wifi) first=wlan0 second=enp3s0 expected='up wlan' ;;
        *) first=enp3s0 second=wlan0 expected='up eth' ;; esac
    {
        echo '== addresses'
        echo 'eth0 100.80.0.2/24'
        [ "$scenario" = noaddress ] || echo 'enp3s0 192.0.2.2/24'
        echo 'wlan0 198.51.100.2/24'
        echo '== routes'
        [ "$scenario" != internal ] || echo 'default via 100.80.0.1 dev eth0'
        if [ "$scenario" != none ]; then
            suffix=
            [ "$scenario" != linkdown ] || suffix=linkdown
            printf 'default via 192.0.2.1 dev %s metric 203 %s\n' "$first" "$suffix"
            printf 'default via 198.51.100.1 dev %s metric 300\n' "$second"
        fi
        echo '== links'
        echo '2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP>'
        if [ "$scenario" = nocarrier ]; then echo '3: enp3s0: <BROADCAST,MULTICAST,UP>'
        else echo '3: enp3s0: <BROADCAST,MULTICAST,UP,LOWER_UP>'; fi
        echo '4: wlan0: <BROADCAST,MULTICAST,UP,LOWER_UP>'
    } >"$work/diag"
    case $scenario in noaddress|nocarrier|linkdown) expected='up wlan' ;; none) expected='nolink eth' ;; esac
    . "$work/uplink"
    [ "$(cat "$status/.wan")" = "$expected" ]
done
if guest_reply 128 wan_probe diag >/dev/null; then exit 1; fi
echo 'check status: route preference and eligibility passed'
flock() {
    case $* in
        '-s -n 7') [ "$scenario" != guests ] ;;
        # A guests run holds the portal lock for minutes: never wait for it.
        '-w 30 8') [ "$scenario" != guests ] || exit 97; [ "$scenario" != busy ] ;;
        '-n 8') case $scenario in busy|expiry|guests) return 1 ;; *) return 0 ;; esac ;;
        *) echo "unexpected flock: $*" >&2; exit 1 ;;
    esac
}
# Lock contention preserves both the sample and its age; other status still advances.
for scenario in busy guests on off inconsistent failed empty; do
    . "$work/portal-lock" || :
    echo on >"$status/portal"
    touch -t 200001010000 "$status/portal"
    previous=$(stat -c %Y "$status/portal")
    for node in fw1 fw2 wan; do echo on >"$status/.portal-$node"; done
    expected=unknown
    case $scenario in
        busy|guests) expected=on; for node in fw1 fw2 wan; do echo unknown >"$status/.portal-$node"; done ;;
        on) expected=on ;;
        off) expected=off; for node in fw1 fw2 wan; do echo off >"$status/.portal-$node"; done ;;
        inconsistent) echo off >"$status/.portal-wan" ;;
        failed) echo unknown >"$status/.portal-fw1" ;;
        empty) : >"$status/.portal-wan" ;;
    esac
    printf 'true true true true 1 false\n' >"$status/.running"
    echo 'up eth' >"$status/.wan"
    echo master >"$status/.fw1"
    echo backup >"$status/.fw2"
    echo fresh-wifi >"$status/.wifi"
    echo 1234 >"$status/.guestmem"
    for name in topology wifi guestmem; do echo old >"$status/$name"; done
    ( . "$work/publish" )
    [ "$(cat "$status/portal")" = "$expected" ]
    case $scenario in busy|guests) [ "$(stat -c %Y "$status/portal")" = "$previous" ] ;;
    *) [ "$(stat -c %Y "$status/portal")" -gt "$previous" ] ;; esac
    grep -qx 'uplink=eth wan=up fw1=master fw2=backup svc=up browsers=1 remote=off' "$status/topology"
    grep -qx fresh-wifi "$status/wifi"
    grep -qx 1234 "$status/guestmem"
done
echo 'check status: busy portal ages out, a guests run is not waited for; verified results and other status publish'
# Expiry wins four successive minute ticks, then releases within the lock wait.
scenario=expiry
echo on >"$status/portal"
for node in fw1 fw2 wan; do echo on >"$status/.portal-$node"; done
for tick in 1 2 3 4; do
    previous=$(stat -c %Y "$status/portal")
    sleep 1
    cp "$status/wifi" "$status/.wifi"
    cp "$status/guestmem" "$status/.guestmem"
    . "$work/portal-lock" || :
    ( . "$work/publish" )
    [ "$(cat "$status/portal")" = on ]
    [ "$(stat -c %Y "$status/portal")" -gt "$previous" ]
done
echo 'check status: repeated expiry contention refreshes the portal sample'
# wan-watch's pace: only the applied battery profile reaches the firewalls, and the word is written on change only.
sed -n '/^    power=ac$/,/|| power=battery$/p' "$repo/tools/check" | sed "s|/run/convergent-power.profile|$work/power.profile|" >"$work/power-word"
sed -n '/^            cmd=.*\/var\/run\/convergent-power/p' "$repo/tools/check" | sed "s|/var/run/convergent-power|$work/fw-power|g" >"$work/power-cmd"
for part in power-word power-cmd; do [ -s "$work/$part" ]; sh -n "$work/$part"; done
grep -q "$work/power.profile" "$work/power-word" && [ "$(grep -c "$work/fw-power" "$work/power-cmd")" = 1 ] || exit 1
(
    carp() { . "$work/power-word"; . "$work/power-cmd"; sh -c "ifconfig() { echo \"carp \$*\"; }; date() { echo 1000000; }; $cmd"; }
    [ "$(carp)" = 'carp carp' ] && [ "$(cat "$work/fw-power")" = 'ac 1000000' ] || exit 1
    for profile in battery ac unknown battery; do
        echo "$profile" >"$work/power.profile"
        echo stale >"$work/fw-power"
        [ "$(carp)" = 'carp carp' ] || exit 1
        case $profile in battery) word=battery ;; *) word=ac ;; esac
        [ "$(cat "$work/fw-power")" = "$word 1000000" ] || exit 1
    done
)
echo 'check status: the firewalls learn the battery profile with their own time, every run'
# check auto on battery: a work gate run under 90 s old stands while nothing changed, whatever the minute.
sed -n '/^    # A guest operation may have closed the gate on purpose/,/^    exec 8>&-$/p' "$repo/tools/check" |
    sed -e "s|/run/convergent-power.profile|$work/power.profile|" -e "s|/run/convergent/|$work/run/|g" -e "s|/proc/uptime|$work/uptime|" >"$work/gate-minute"
[ -s "$work/gate-minute" ]; sh -n "$work/gate-minute"
grep -q "$work/run/.firewall-heal" "$work/gate-minute" && grep -q "$work/power.profile" "$work/gate-minute" || exit 1
if grep -q '/proc/uptime' "$work/gate-minute"; then exit 1; fi
(
    state=$work/state
    mkdir -p "$state" "$work/run/status"
    lock=0
    flock() { [ "$*" = '-s -n 8' ] || exit 97; [ "$lock" = 0 ]; }
    sh() { [ "$1" = /usr/lib/convergent/incus/work-gate ] || exit 97; echo run >>"$work/gate-runs"; [ "$gate_ok" = 1 ]; }
    # Every run in an odd minute, as after a heal that crossed the minute.
    date() { echo 07; }
    # $1: uptime, $2: this run's heal output (default: both firewalls healthy, as a quiet heal reports); prints the gate runs.
    quiet='SELF-HEAL fw1: master; peer fw2: backup; no restart
SELF-HEAL fw2: backup; peer fw1: master; no restart
'
    # The block ends by publishing the run's report: the heal output goes into that file, the run has a start.
    gate() { echo "$1.42 7.00" >"$work/uptime"; : >"$work/gate-runs"; printf '%s' "${2-$quiet}" >"$work/run/report"; report=$work/run/report run_now=$1; . "$work/gate-minute"; wc -l <"$work/gate-runs"; }
    closed='SELF-HEAL work access closed: topology mismatch'
    echo "$closed" >"$state/firewall-heal"
    echo 'uplink=eth wan=up fw1=master fw2=backup svc=up browsers=1 remote=off' >"$work/run/status/topology"
    echo battery >"$work/power.profile"
    gate_ok=1 runs=
    for t in 1000 1070 1130 1190 1250; do runs="$runs$(gate "$t")"; done
    [ "$runs" = 10101 ] || { echo "work gate runs on battery: $runs" >&2; exit 1; }
    [ "$(gate 1300)" = 0 ] && grep -qx "$closed" "$work/run/.firewall-heal" || exit 1
    # Heal output (a restart on an odd minute), a CARP or uplink change and a wired outcome change run it.
    [ "$(gate 1310 'SELF-HEAL fw1: restarted 5s ago; waiting for its boot
')" = 1 ] || exit 1
    [ "$(gate 1315 'SELF-HEAL fw1: master; peer fw2: unhealthy; no restart
SELF-HEAL fw2: unhealthy for 60s; peer fw1: master; attempts 0/3 in the last hour
')" = 1 ] || exit 1
    echo 'uplink=eth wan=up fw1=backup fw2=master svc=up browsers=1 remote=off' >"$work/run/status/topology"
    [ "$(gate 1320)" = 1 ] || exit 1
    echo 'uplink=wlan wan=up fw1=backup fw2=master svc=up browsers=1 remote=off' >"$work/run/status/topology"
    [ "$(gate 1330)" = 1 ] || exit 1
    echo 'uplink=wlan wan=up fw1=backup fw2=master svc=up browsers=2 remote=on' >"$work/run/status/topology"
    [ "$(gate 1340)" = 0 ] || exit 1
    echo 'healed 0123' >"$work/run/wired-heal"
    [ "$(gate 1350)" = 1 ] && [ "$(gate 1360)" = 0 ] || exit 1
    rm "$work/run/wired-heal"
    [ "$(gate 1370)" = 1 ] || exit 1
    # A garbled or future record, or no topology, runs it; so does AC.
    { echo 01375; sed 1d "$work/run/work-gate.last"; } >"$work/last" && mv "$work/last" "$work/run/work-gate.last"
    [ "$(gate 1380)" = 1 ] || exit 1
    { echo 9999; sed 1d "$work/run/work-gate.last"; } >"$work/last" && mv "$work/last" "$work/run/work-gate.last"
    [ "$(gate 1390)" = 1 ] || exit 1
    mv "$work/run/status/topology" "$work/topology"
    [ "$(gate 1400)$(gate 1410)" = 11 ] || exit 1
    mv "$work/topology" "$work/run/status/topology"
    echo ac >"$work/power.profile"
    [ "$(gate 1420)$(gate 1430)" = 11 ] || exit 1
    # A held guests lock leaves the gate and records no run; a failed run reports the gate closed.
    echo battery >"$work/power.profile"
    lock=1
    [ "$(gate 1530)" = 0 ] && grep -q '^SELF-HEAL work access left as is' "$work/run/.firewall-heal" || exit 1
    [ "$(sed -n 1p "$work/run/work-gate.last")" = 1430 ] || exit 1
    lock=0 gate_ok=0
    [ "$(gate 1540)" = 1 ] && grep -qx "$closed" "$work/run/.firewall-heal" || exit 1
)
echo 'check auto: on battery a work gate run under 90 s old stands while nothing changed'
# The root autostart scan stays bounded: an oversized owner file fails at once, a hang at the deadline.
sed -n '/^autostart() {/,/^}/p' "$repo/tools/check" | sed "s|\([ #]\)/home\([ /]\)|\1$work/home\2|g" >"$work/autostart"
[ -s "$work/autostart" ]; sh -n "$work/autostart"
[ "$(grep -c "$work/home" "$work/autostart")" = 3 ]
grep -q "timeout -k 1 120 find $work/home " "$work/autostart"
sed 's/timeout -k 1 120 find/timeout -k 1 2 find/' "$work/autostart" >"$work/autostart-fast"
grep -q 'timeout -k 1 2 find' "$work/autostart-fast"
owner=$work/home/owner
mkdir -p "$owner/.config/sway" "$work/scan"
printf 'echo hi\n' >"$owner/.bashrc"
printf 'include /etc/sway/config\n' >"$owner/.config/sway/config"
scan() {
    started=$(date +%s) rc=0
    LC_ALL=C timeout -k 1 90 sh -c '. "$1"; work=$2; autostart' sh "$1" "$work/scan" 2>"$work/scan.err" || rc=$?
    elapsed=$(($(date +%s) - started))
}
scan "$work/autostart"
[ "$rc" = 0 ]
# Same lines as sha256sum on the file: accepted baselines stay valid.
sha256sum "$owner/.bashrc" "$owner/.config/sway/config" | LC_ALL=C sort | cmp - "$work/scan/autostart"
# An owner file over the cap is inventoried by size and times, at once.
mkdir -p "$owner/.local/bin"
truncate -s 1T "$owner/.local/bin/tool"
scan "$work/autostart"
[ "$rc" = 0 ] && [ "$elapsed" -lt 30 ] || exit 1
grep -qxF "$(TZ=UTC0 stat -c 'size=1099511627776 mtime=%y ctime=%z  %n' "$owner/.local/bin/tool")" "$work/scan/autostart"
[ "$(wc -l <"$work/scan/autostart")" = 3 ]
# Times to the nanosecond in UTC: a same-second rewrite shows, a time zone change does not.
grep -Eq '^size=1099511627776 mtime=[0-9-]+ [0-9:]+\.[0-9]{9} \+0000 ctime=[0-9-]+ [0-9:]+\.[0-9]{9} \+0000  ' "$work/scan/autostart"
cp "$work/scan/autostart" "$work/scan/autostart.first"
(TZ=IST-5:30; export TZ; scan "$work/autostart"; [ "$rc" = 0 ])
cmp "$work/scan/autostart.first" "$work/scan/autostart"
# A rewrite that puts the mtime back still shows: the ctime moves.
mtime=$(stat -c %y "$owner/.local/bin/tool")
printf x | dd of="$owner/.local/bin/tool" bs=1 conv=notrunc 2>/dev/null
touch -d "$mtime" "$owner/.local/bin/tool"
scan "$work/autostart"
stamps() { sed -n 's/^size=[0-9]* mtime=\(.*\) ctime=\(.*\)  .*\/tool$/\1|\2/p' "$1"; }
first=$(stamps "$work/scan/autostart.first") now=$(stamps "$work/scan/autostart")
[ -n "$first" ] && [ "${now%|*}" = "${first%|*}" ] && [ "${now#*|}" != "${first#*|}" ] || exit 1
rm -r "$owner/.local"
# The sway include check reads the same capped copy.
truncate -s 67108865 "$owner/.config/sway/config"
scan "$work/autostart"
[ "$rc" = 1 ] && [ "$elapsed" -lt 30 ] || exit 1
grep -qx "autostart file over 67108864 bytes: $owner/.config/sway/config" "$work/scan.err"
printf 'include /etc/sway/config\n' >"$owner/.config/sway/config"
# A read that never returns ends with the deadline, not with the locks held.
(
    fake=$(mktemp -d /var/tmp/check-fake.XXXXXX)
    trap 'rm -rf "$fake"' 0
    REAL_FIND=$(command -v find); export REAL_FIND
    printf '#!/bin/sh\ncase " $* " in *" -exec "*) exec sleep 20 ;; esac\nexec "$REAL_FIND" "$@"\n' >"$fake/find"
    chmod 755 "$fake/find"
    PATH=$fake:$PATH
    scan "$work/autostart-fast"
    [ "$rc" != 0 ] && [ "$elapsed" -lt 15 ] || exit 1
)
echo 'check: the autostart scan inventories oversized files, fails oversized includes at once and a hang at its deadline'
# Account diffs keep the user and the change, never a hash; other entries stay verbatim.
sed -n '/^# Keep diffs private/,/zone in \/etc\/timezone.$/p' "$repo/tools/check" |
    sed -e "s|\"/etc/|\"$work/etc/|g" -e "s|\"/usr/share/zoneinfo|\"$work/zoneinfo|g" >"$work/etc-diff"
[ -s "$work/etc-diff" ]; sh -n "$work/etc-diff"
if grep -q '"/etc/\|"/usr/' "$work/etc-diff"; then exit 1; fi
[ "$(grep -c "$work/zoneinfo" "$work/etc-diff")" = 2 ]
sed -n '/^zone_valid() {/,/^}/p' "$repo/tools/check" >"$work/zone-check"
sed -n '/^zone_valid() {/,/^}/p' "$repo/initramfs/90convergent/convergent-state.sh" | expand -t 4 | cmp - "$work/zone-check"
mkdir -p "$work/etc" "$work/accepted/etc" "$work/diff-run" "$work/zoneinfo/Europe"
printf 'TZif2 bratislava\n' >"$work/zoneinfo/Europe/Bratislava"
printf 'TZif2 utc\n' >"$work/zoneinfo/UTC"
printf 'shadow\npasswd\ngshadow\nlocaltime\ntimezone\n' >"$work/etc-list"
# The zone differs from the accepted one (sys time set): no finding.
echo UTC >"$work/accepted/etc/timezone"
cp "$work/zoneinfo/UTC" "$work/accepted/etc/localtime"
echo Europe/Bratislava >"$work/etc/timezone"
cp "$work/zoneinfo/Europe/Bratislava" "$work/etc/localtime"
chmod 644 "$work/etc/timezone" "$work/etc/localtime"
printf 'root:*:19000:0:::::\nowner:$y$j9T$oldsalt$oldhash:19000:0:99999:7:::\nlocked:!$y$j9T$ls$lh:19000::::::\nstarred:*$y$j9T$ss$sh:19000::::::\nbin:!:19000::::::\n' >"$work/accepted/etc/shadow"
sed 's/^owner:[^:]*:19000:/owner:$y$j9T$newsalt$newhash:19001:/' "$work/accepted/etc/shadow" >"$work/etc/shadow"
printf 'owner:x:1000:1000::/home/owner:/bin/sh\n' >"$work/accepted/etc/passwd"
printf 'owner:x:1000:1000::/home/owner:/bin/zsh\n' >"$work/etc/passwd"
# The changed last line has no newline: diff adds a marker line after it.
printf 'adm:*::\nwheel:!$y$j9T$gs$gh::owner\n' >"$work/accepted/etc/gshadow"
printf 'adm:*::\nwheel:!$y$j9T$ng$nh::owner' >"$work/etc/gshadow"
chmod 600 "$work/etc/shadow" "$work/accepted/etc/shadow" "$work/etc/gshadow" "$work/accepted/etc/gshadow"
(
    fixture=$work
    work=$fixture/diff-run baseline=$fixture/accepted list=$fixture/etc-list ok=1
    bad() { ok=0; printf 'FAIL %s\n' "$*" >>"$work/report"; }
    . "$fixture/zone-check"
    . "$fixture/etc-diff"
    [ "$ok" = 0 ]
    report=$work/report
    if grep -qF '$y$' "$report"; then exit 1; fi
    grep -qxF -- '-owner:<hash>:19000:0:99999:7:::' "$report"
    grep -qxF -- '+owner:<hash>:19001:0:99999:7:::' "$report"
    grep -qxF -- ' locked:!<hash>:19000::::::' "$report"
    grep -qxF -- ' starred:*<hash>:19000::::::' "$report"
    grep -qxF -- ' adm:*::' "$report"
    grep -qxF -- '-wheel:!<hash>::owner' "$report"
    grep -qxF -- '+wheel:!<hash>::owner' "$report"
    grep -qxF -- '\ No newline at end of file' "$report"
    grep -qx "FAIL $fixture/etc/gshadow differs from last acceptance" "$report"
    grep -qxF -- ' root:*:19000:0:::::' "$report"
    grep -qxF -- ' bin:!:19000::::::' "$report"
    grep -qxF -- '+owner:x:1000:1000::/home/owner:/bin/zsh' "$report"
    grep -qx "FAIL $fixture/etc/shadow differs from last acceptance" "$report"
    grep -qx "FAIL $fixture/etc/passwd differs from last acceptance" "$report"
    if grep -q 'timezone\|localtime' "$report"; then exit 1; fi
)
echo 'check: account diffs mask password hashes and keep the user and the change'
# The zone needs no acceptance, but a root 0644 file each, an installed zone and its copy in localtime.
printf 'localtime\ntimezone\n' >"$work/etc-list"
zone_case() {
    (
        fixture=$work
        work=$fixture/diff-run baseline=$fixture/accepted list=$fixture/etc-list ok=1
        rm -f "$work/report"
        bad() { ok=0; printf 'FAIL %s\n' "$*" >>"$work/report"; }
        . "$fixture/zone-check"
        . "$fixture/etc-diff"
        case $1 in
        ok) [ "$ok" = 1 ] && [ ! -e "$work/report" ] || exit 1 ;;
        mode) [ "$ok" = 0 ] && grep -qx "FAIL $fixture/etc/$2 is not a regular root 0644 file" "$work/report" || exit 1 ;;
        zone) [ "$ok" = 0 ] && grep -qx 'FAIL /etc/localtime is not the zoneinfo of the zone in /etc/timezone' "$work/report" || exit 1 ;;
        esac
    )
}
zone_case ok
chmod 664 "$work/etc/timezone"; zone_case mode timezone; chmod 644 "$work/etc/timezone"
mv "$work/etc/localtime" "$work/localtime"; ln -s "$work/localtime" "$work/etc/localtime"; zone_case mode localtime
rm "$work/etc/localtime"; mv "$work/localtime" "$work/etc/localtime"; zone_case ok
cp "$work/zoneinfo/UTC" "$work/etc/localtime"; zone_case zone
cp "$work/zoneinfo/Europe/Bratislava" "$work/etc/localtime"
for z in Mars/Base ../zoneinfo/UTC posix/UTC Europe; do echo "$z" >"$work/etc/timezone"; zone_case zone; done
rm "$work/etc/timezone"; zone_case zone
echo 'check: the time zone needs no acceptance; a non-root file, a bad zone or a stale localtime fails'

