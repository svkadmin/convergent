#!/bin/sh
# Runs inside build/test's guest host, after uplink and browser smoke tests.
# TCP matrix follows guests/fw/site/etc/pf.conf; DNS is the segment-local exception.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
# fw_settled; cv_time and test_start are this test's own.
. /var/lib/convergent/test-release/timing
test_start=$(date +%s)
cv_time() { echo "CV-TIME pf-$1 $(($(date +%s) - test_start))"; }
exec </dev/null
result=0
created=
project() { case $1 in pf-work*) echo owner ;; *) echo default ;; esac; }
ic() {
	case $1 in init) instance=$3 ;; config) instance=$4 ;; *) instance=${2:-} ;; esac
	incus --force-local --project "$(project "$instance")" "$@" </dev/null
}
ssh() { command ssh -n "$@"; }
cleanup() {
	r=$?
	trap - 0
	trap '' HUP INT TERM
	set +e
	cv_time cleanup
	[ -z "${canary_pid:-}" ] || canary_end || r=1
	[ -z "${w1_stopped:-}" ] || { ic start fw1; ic config unset fw1 boot.autorestart
		timeout -k 5 1800 sh -c 'until command ssh -n -F /etc/convergent/ssh_config fw1 "rcctl check dhcpd"; do sleep 5; done'; } || r=1
	# Restore the preferred master if a work probe fails during maintenance. Undo refuses while a firewall
	# fails its health check (the restarted fw1 relinks for 30 minutes), so retry before giving up.
	if [ -n "${w1_maintenance:-}" ]; then
		for try in $(seq 20); do printf 'yes\n' | sys firewall undo && break; sleep 30; done
		[ ! -e /var/lib/convergent/firewall-maintenance ] || r=1
	fi
	# portal retries a node it could not reach; one retry here, as cron would.
	portal off || { sleep 30; portal off; } || r=1
	ic exec svc -- sh -c '
		for p in 3000 8428; do
			[ ! -f /run/cv-pf-$p.pid ] || { kill "$(cat /run/cv-pf-$p.pid)" && rm /run/cv-pf-$p.pid; }
		done
	' || r=1
	[ -z "${rem_started:-}" ] || ic stop remmina --force || r=1
	for name in $created; do ic delete "$name" --force || r=1; done
	[ -z "${work_profile:-}" ] || incus --force-local --project owner profile delete pf-base || r=1
	[ -z "${work_image:-}" ] || incus --force-local --project owner image delete pf-browser || r=1
	echo "CV-PF-RESULT $r"
	exit "$r"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

# A listener on a firewall address, proven from the node itself, held by one plain SSH session
# (no connection sharing: a stale control master once broke it). canary_end checks it survived the
# probes, then ends the session, and the node's HUP ends its nc.
canary_begin() {
	canary_log=$(mktemp) || return 1
	command ssh -n -o ControlMaster=no -o ControlPath=none -F /etc/convergent/ssh_config "$1" "
        nc -kl $2 $3 </dev/null >/dev/null 2>&1 & p=\$!
        trap 'kill \$p 2>/dev/null' 0 HUP TERM
        for i in 1 2 3 4 5; do nc -z -w 2 $2 $3 >/dev/null 2>&1 && { echo CV-LISTENER-READY; break; }; sleep 1; done
        while kill -0 \$p 2>/dev/null; do sleep 1; done
        echo CV-LISTENER-DIED" >"$canary_log" 2>&1 &
	canary_pid=$!
	for i in $(seq 30); do
		grep -qx CV-LISTENER-READY "$canary_log" && return 0
		kill -0 "$canary_pid" 2>/dev/null || break
		sleep 1
	done
	canary_end || :
	return 1
}
canary_end() {
	canary_ok=0
	if kill -0 "$canary_pid" 2>/dev/null && ! grep -q CV-LISTENER-DIED "$canary_log"; then canary_ok=1; fi
	kill "$canary_pid" 2>/dev/null || :
	wait "$canary_pid" 2>/dev/null || :
	canary_pid=
	[ "$canary_ok" = 1 ] || cat "$canary_log" >&2
	rm -f "$canary_log"
	[ "$canary_ok" = 1 ]
}

# The shell reports nc's verdict; a failed Incus exec must never count as a denial.
tcp() {
	if [ "$1" = host ]; then
		connections=$(curl -qs --noproxy '*' --connect-timeout 3 --max-time 4 \
			-o /dev/null -w '%{num_connects}' "http://$2:$3" </dev/null) || :
		case $connections in 1) echo allow ;; 0) echo deny ;; *) return 1 ;; esac
	else
		timeout -k 1 8 incus --force-local --project "$(project "$1")" exec "$1" -- sh -c '
			r=0; nc -z -w 3 "$1" "$2" </dev/null >/dev/null 2>&1 || r=$?
			case $r in 0) echo allow ;; 1) echo deny ;; *) exit 2 ;; esac
		' sh "$2" "$3"
	fi
}
# Evidence for a failed work probe: instance states, the source's view and the masters' view.
work_diag() {
	incus --force-local --project owner list -c ns --format csv 2>&1 | sed 's/^/CV-PF diag: /'
	nft list chain bridge host-l2 work_gate 2>&1 | grep -E 'drop|chain' | sed 's/^/CV-PF diag gate: /'
	ic exec "$1" -- sh -c 'ip -4 addr show eth0 | grep inet; ip -4 route; ip neigh; ping -c 1 -W 2 "$1" >/dev/null && echo ping ok || echo ping failed' sh "$2" 2>&1 |
		sed "s/^/CV-PF diag $1: /"
	# PF's view of the destination: its states, source limits and mismatch counters, and the allocator's log.
	for f in fw1 fw2; do
		timeout 20 /usr/bin/ssh -n -F /etc/convergent/ssh_config "$f" 'ifconfig carp | grep -E "^carp|status"; arp -an | grep "100.80.3\|'"$2"'"; pfctl -ss | grep -c " 100.80.3"; pfctl -ss | grep "'"$2"'"; pfctl -sS; pfctl -si | grep -E "state-mismatch|state-insert|state-limit|src-limit"; grep dhcpd /var/log/daemon | tail -n 6' 2>&1 |
			sed "s/^/CV-PF diag $f: /"
	done
}
probe() { # expectation source destination port [dns]
	got=error
	if [ "${5:-}" = dns ]; then
		# A lost datagram or a slow upstream is not a block: an expected allow gets three tries.
		for attempt in 1 2 3; do
			got=$(timeout -k 1 15 incus --force-local --project "$(project "$2")" exec "$2" -- sh -c '
				r=0; out=$(timeout 4 nslookup codeberg.org "$1" 2>&1) || r=$?
				# Any answer (even SERVFAIL while upstream is slow) proves the path; silence is a block.
				# BusyBox timeout execs nslookup: expiry is SIGTERM (143), not GNU 124.
				case $r in
				0) echo allow ;;
				124|143) echo deny ;;
				1) if printf "%s\n" "$out" | grep -qiE "timed out|no servers could be reached|refused"; then echo deny; else echo allow; fi ;;
				*) exit 2 ;;
				esac
			' sh "$3") || got=error
			[ "$1:$got" = allow:deny ] || break
		done
	else
		# Right after a failover CARP and ARP settle; an expected allow gets three tries too.
		for attempt in 1 2 3; do
			got=$(tcp "$2" "$3" "$4") || got=error
			[ "$1:$got" = allow:deny ] || break
			sleep 2
		done
	fi
	if [ "$got" = "$1" ]; then verdict=ok; else verdict=FAIL; result=1; fi
	case $verdict:$2 in FAIL:pf-work-*|FAIL:remmina|FAIL:pf-remmina) work_diag "$2" "$3" ;; esac
	echo "CV-PF $verdict src=$2 dst=$3 port=$4${5:+/udp} want=$1 got=$got"
}
listen() {
	ic exec "$1" -- sh -c '
		nc -lk -s "$1" -p "$2" -e /bin/true </dev/null >/dev/null 2>&1 &
		echo $! >"/run/cv-pf-$2.pid"
		for i in 1 2 3 4 5; do nc -z -w 1 "$1" "$2" && exit 0; sleep 1; done
		exit 1
	' sh "$2" "$3"
}
start() {
	name=$1; role=$2
	ic init candidate-browser "$name" -p browser-base -p "browser-$role" \
		-c security.protection.delete=false -c limits.memory=512MiB
	created="$name $created"
	ic config device add "$name" render none
	if [ "$name" = pf-portal ]; then
		ic config set "$name" environment.BROWSER_PORTAL=1 environment.BROWSER_IPV4=100.80.3.11
		ic config device override "$name" eth0 ipv4.address=100.80.3.11 hwaddr=00:16:3e:80:03:11
	fi
	ic start "$name"
	timeout -k 1 60 sh -c 'until incus --force-local --project default exec "$1" -- sh -c \
		"test -f /run/browser-ready && ip -4 route show default | grep -q \"^default via \""; do sleep 1; done' sh "$name"
	ic exec "$name" -- sh -c 'command -v nc; command -v nslookup'
}
portal off
for role in def tmp int; do start "pf-$role" "$role"; done
start pf-portal tmp

# Live Incus listener; source restrictions also cover host loopback.
probe allow pf-int 100.80.1.10 8443
for source in pf-def pf-tmp pf-portal svc host; do probe deny "$source" 100.80.1.10 8443; done
probe deny host 127.0.0.1 8443
# The fixed SSH diagnostic probes from the actual agentless WAN VM.
wan_ui=$(timeout -k 1 15 ssh -F /etc/convergent/ssh_config wan diag)
printf '%s\n' "$wan_ui" | grep -qx 'incus-ui-8443: deny'
# Also probe a distinct transit address so the PF ingress policy is exercised independently.
for spec in 'pf-ui-guests guests 100.80.8.10/22 100.80.8.1' 'pf-ui-wan transit 100.80.0.11/28 100.80.0.1'; do
    set -- $spec
    name=$1; bridge=$2; address=$3; gateway=$4
    ic init candidate-browser "$name" -p browser-base -c security.protection.delete=false -c limits.memory=256MiB
    created="$name $created"
    ic config device add "$name" render none
    ic config device add "$name" eth0 nic nictype=bridged parent="$bridge" name=eth0
    ic start "$name"
    timeout -k 1 60 sh -c 'until incus --force-local exec "$1" -- true; do sleep 1; done' sh "$name"
    ic exec "$name" -- sh -eu -c '
        sysctl -qw net.ipv4.conf.eth0.arp_ignore=0
        ip link set eth0 up
        ip addr add "$1" dev eth0
        ip route add default via "$2"
    ' sh "$address" "$gateway"
    if [ "$bridge" = guests ]; then probe allow "$name" "$gateway" 53 dns; fi
    probe deny "$name" 100.80.1.10 8443
    ic exec "$name" -- sh -c 'ip neigh show "$1" | grep -q "lladdr .* \(REACHABLE\|STALE\|DELAY\)"' sh "$gateway"
done
# End Incus UI checks.

# A LAN server on the emulated uplink, outside the host's internal networks.
ic init candidate-browser pf-lan -p browser-base -c security.protection.delete=false -c limits.memory=256MiB
created="pf-lan $created"
ic config device add pf-lan render none
ic config device add pf-lan eth0 nic nictype=bridged parent=cvuplink name=eth0
ic start pf-lan
timeout -k 1 60 sh -c 'until incus --force-local --project default exec pf-lan -- true; do sleep 1; done'
ic exec pf-lan -- sh -eu -c '
	# The host default arp_ignore=8 is inherited by container interfaces.
	# This server must answer WAN ARP; self-connect checks never exercise it.
	sysctl -qw net.ipv4.conf.eth0.arp_ignore=0
	ip addr add 10.0.2.100/24 dev eth0
	ip link set eth0 up
'
for port in 53 80 443 9100; do listen pf-lan 10.0.2.100 "$port"; done
# 8428 is normally loopback-only and Grafana (3000) runs only with an int session: live
# listeners make both allow and deny meaningful.
listen svc 100.80.2.10 8428
listen svc 100.80.2.10 3000
for port in 3000 8428 8880 9428 6514; do probe allow svc 100.80.2.10 "$port"; done
for address in 100.80.1.2 100.80.1.3; do probe allow host "$address" 22; done
for port in 9100 8444; do probe allow host 100.80.1.10 "$port"; done
for port in 53 80 443 9100; do probe allow pf-lan 10.0.2.100 "$port"; done
[ "$result" = 0 ] || exit 1

# Each denied endpoint above has a positive control; public egress uses the test uplink.
for source in pf-def pf-tmp pf-int; do
	case $source in pf-int) internet=deny; dashboard=allow; gateway=100.80.4.1 ;;
	*) internet=allow; dashboard=deny; gateway=100.80.3.1 ;; esac
	probe allow "$source" "$gateway" 53 dns
	for port in 80 443; do probe "$internet" "$source" 1.1.1.1 "$port"; done
	probe "$dashboard" "$source" 100.80.2.10 3000
	for port in 8428 8880 9428 6514; do probe deny "$source" 100.80.2.10 "$port"; done
	for port in 9100 8444; do probe deny "$source" 100.80.1.10 "$port"; done
	for address in 100.80.1.2 100.80.1.3; do probe deny "$source" "$address" 22; done
done

# svc: exactly the five TCP scrape endpoints, plus its gateway's resolver.
probe allow svc 100.80.2.1 53 dns
for address in 100.80.1.10 100.80.0.10 100.80.2.2 100.80.2.3; do probe allow svc "$address" 9100; done
probe allow svc 100.80.1.10 8444
for address in 100.80.1.2 100.80.1.3; do probe deny svc "$address" 22; done
for port in 80 443; do probe deny svc 1.1.1.1 "$port"; done
for entry in pf-def:100.80.3.10 pf-int:100.80.4.10; do
	source=${entry%:*}; address=${entry#*:}
	listen "$source" "$address" 80
	probe allow "$source" "$address" 80
	probe deny svc "$address" 80
done
probe deny pf-int 100.80.3.10 80
for source in pf-def pf-tmp; do probe deny "$source" 100.80.4.10 80; done
for port in 6514 8880 9428; do probe allow host 100.80.2.10 "$port"; done
for port in 3000 8428; do probe deny host 100.80.2.10 "$port"; done

# Real portal commands populate/flush both PF tables and wan's DNS map.
mkdir -p /run/convergent/browser
exec 8>/run/convergent/browser/tmp-portal.lock
flock -n 8
for mode in off on off; do
	# One retry as in cleanup: a loaded nested wan can miss one SSH connect.
	if [ "$mode" = on ]; then portal begin; want=allow; else portal off || { sleep 30; portal off; }; want=deny; fi
	echo "CV-PF portal=$mode"
	for port in 80 443; do probe "$want" pf-portal 10.0.2.100 "$port"; done
	for port in 53 9100; do probe deny pf-portal 10.0.2.100 "$port"; done
	probe "$want" pf-portal 100.80.0.10 53 dns
	# A public address and internal services are outside the portal tables.
	for port in 80 443; do probe deny pf-portal 1.1.1.1 "$port"; done
	for port in 3000 8428 8880 9428 6514; do probe deny pf-portal 100.80.2.10 "$port"; done
	for port in 9100 8444; do probe deny pf-portal 100.80.1.10 "$port"; done
	for address in 100.80.1.2 100.80.1.3; do probe deny pf-portal "$address" 22; done
	for source in pf-def pf-tmp pf-int svc; do probe deny "$source" 10.0.2.100 80; done
done
exec 8>&-
# Work-network matrix: each probe crosses the production trunks and PF.
# The gate opens once both firewalls answer; one still relinking its kernel can take many minutes.
timeout -k 5 1500 sh -c 'until sh /usr/lib/convergent/incus/work-gate; do sleep 10; done'
incus --force-local --project default image copy candidate-browser local: --target-project owner --alias pf-browser
work_image=1
incus --force-local --project owner profile create pf-base
work_profile=1
incus --force-local --project default profile show browser-base |
	incus --force-local --project owner profile edit pf-base
work_rows=/run/convergent/pf-work-segments
awk '$7 == "dev" || $7 == "jhn" {print}' /etc/convergent/segments >"$work_rows"
while read -r iface vhid parent label prefix gateway family <&3; do
	vlan=${parent#vlan}
	name=pf-work-$vlan
	base=${prefix%.0/26}
	ic init pf-browser "$name" -p pf-base -p "work-$label" -c security.protection.delete=false -c limits.memory=256MiB
	created="$name $created"
	ic config device add "$name" render none
	[ "$(incus --force-local query "/1.0/instances/$name?project=owner" | jq -r '.expanded_devices.eth0.vlan')" = "$vlan" ]
	ic start "$name"
	timeout -k 1 60 sh -c 'until incus --force-local --project "$2" exec "$1" -- true; do sleep 1; done' sh "$name" "$(project "$name")"
	ic exec "$name" -- sh -eu -c '
		sysctl -qw net.ipv4.conf.eth0.arp_ignore=0
		ip link set eth0 up
		cat >/run/w1-udhcpc <<'"'"'DHCP'"'"'
#!/bin/sh
[ "$1" = bound ] || [ "$1" = renew ] || exit 0
printf "%s %s %s %s\n" "$ip" "$router" "$dns" "$subnet" >/run/w1-lease
ip addr replace "$ip/26" dev eth0
echo "$1" >>/run/w1-events
DHCP
		chmod 700 /run/w1-udhcpc
		udhcpc -i eth0 -s /run/w1-udhcpc -n -q -t 5 -T 3
		read -r address router dns mask </run/w1-lease
		case $address in "$1".5[1-9]|"$1".6[01]) ;; *) exit 1 ;; esac
		[ "$router" = "$2" ] && [ "$dns" = "$2" ] && [ "$mask" = 255.255.255.192 ] || exit 1
		ip -4 addr flush dev eth0
		ip addr add "$1.10/26" dev eth0
		ip route replace default via "$2" dev eth0
	' sh "$base" "$gateway"
	lease=$(ic exec "$name" -- cat /run/w1-lease)
	address=${lease%% *}
	for f in fw1 fw2; do
		tries=0
		until timeout 10 ssh -F /etc/convergent/ssh_config "$f" "grep -F 'lease $address {' /var/db/dhcpd.leases" >/dev/null; do
			tries=$((tries + 1))
			[ "$tries" -lt 15 ] || { result=1; break; }
			sleep 1
		done
	done
	listen "$name" "$base.10" 8080
done 3<"$work_rows"
# A one-vCPU firewall relinks its kernel for minutes after booting; the L2 storm's PF logging on top
# of that made CARP advertisements late and the pair flap into the first work probes. Let it finish.
cv_time settle
fw_settled -t 3000 fw1:master fw2:backup || { echo 'CV-PF FAIL firewalls not settled after 50 minutes'; exit 1; }
test_start=$(date +%s)
cv_time l2-start
while read -r iface vhid parent label prefix gateway family <&3; do
	created="pf-work-l2-${parent#vlan} $created"
done 3<"$work_rows"
rc=0
timeout -k 5 1140 sh /var/lib/convergent/test-release/fixtures/pf-l2 "$work_rows" || rc=$?
cv_time l2-duration
[ "$rc" = 0 ] || exit "$rc"
home_want=$(awk '
function ip(s,a) {split(s,a,"."); return ((a[1]*256+a[2])*256+a[3])*256+a[4]}
{for(i=1;i<=NF;i++){split($i,c,"/"); size=2^(32-c[2]); if(int(ip("10.0.2.100")/size)==int(ip(c[1])/size)) found=1}}
END {print found ? "allow" : "deny"}' /etc/convergent/home-lan)
# The remmina profile pins the one address PF allows: reuse the installed container when there is one.
# check auto stops a Remmina container whose supervisor lock is free; hold it as the launcher does.
mkdir -p /run/convergent/browser
exec 7>/run/convergent/browser/remmina.lock
flock -w 120 7
if ic info remmina >/dev/null 2>&1; then
	rem=remmina
	[ "$(ic list remmina -c s --format csv)" = RUNNING ] || { rem_started=1; ic start remmina; }
else
	rem=pf-remmina
	ic init candidate-remmina pf-remmina -p remmina -c limits.memory=256MiB -c security.protection.delete=false
	created="pf-remmina $created"
	ic start pf-remmina
fi
timeout -k 1 60 sh -c 'until incus --force-local --project default exec "$1" -- test -f /run/remmina-ready; do sleep 1; done' sh "$rem"
# Keep one TCP connection open across the CARP transition and hard loss of fw1.
# Remmina is the one source PF lets into another work VLAN: the flow crosses the firewall.
flow_source=$rem
flow_target=pf-work-330
flow_address=$(awk '$3 == "vlan330" {sub(/\.0\/26$/, ".10", $5); print $5}' "$work_rows")
ic exec "$flow_target" -- sh -c '
    nc -lk -s "$1" -p 5999 -e /bin/cat </dev/null >/dev/null 2>&1 &
    for i in 1 2 3 4 5; do nc -z -w 1 "$1" 5999 && exit 0; sleep 1; done
    exit 1
' sh "$flow_address"
ic exec "$flow_source" -- sh -c '
    { echo before; while [ ! -f /run/pf-flow-continue ]; do sleep 1; done; echo after; sleep 30; } |
        nc "$1" 5999 >/run/pf-flow-replies 2>/run/pf-flow-error &
' sh "$flow_address"
for i in $(seq 30); do ic exec "$flow_source" -- grep -qx before /run/pf-flow-replies && break; sleep 1; done
ic exec "$flow_source" -- grep -qx before /run/pf-flow-replies
for i in $(seq 30); do
    timeout 10 ssh -n -F /etc/convergent/ssh_config fw2 'pfctl -ss' | grep -F "$flow_address:5999" && break
    sleep 1
done
timeout 10 ssh -n -F /etc/convergent/ssh_config fw2 'pfctl -ss' | grep -F "$flow_address:5999"
for master in fw1 fw2; do
	cv_time "work-$master"
	if [ "$master" = fw2 ]; then
		w1_maintenance=1
		printf 'yes\n' | sys firewall maintenance || {
			for f in fw1 fw2; do
				timeout 20 ssh -n -F /etc/convergent/ssh_config "$f" 'rcctl check unbound dhcpd; ps -axo pid,ppid,etime,wchan,args | grep -E "[p]fctl|[r]cctl|[u]nbound-control|[h]ost -t"; grep dhcpd /var/log/daemon | tail -n 4' 2>&1 | sed "s/^/CV-PF $f: /"
			done
			exit 1
		}
		# The gate keeps work open without fw1 only after it validated both nodes (check auto does this).
		timeout -k 5 300 sh -c 'until sh /usr/lib/convergent/incus/work-gate; do sleep 10; done'
		ic config set fw1 boot.autorestart=false
		w1_stopped=1
		ic stop fw1 --force
		sh /usr/lib/convergent/incus/work-gate
		ic exec "$flow_source" -- touch /run/pf-flow-continue
		for i in $(seq 30); do ic exec "$flow_source" -- grep -qx after /run/pf-flow-replies && break; sleep 1; done
		ic exec "$flow_source" -- grep -qx after /run/pf-flow-replies
	fi
	for f in fw1 fw2; do
		[ "$master:$f" != fw2:fw1 ] || continue
		if [ "$f" = "$master" ]; then want=MASTER; else want=BACKUP; fi
		timeout 30 ssh -F /etc/convergent/ssh_config "$f" ifconfig >"/run/convergent/pf-work-$f"
		awk -v want="$want" -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments "/run/convergent/pf-work-$f" >/dev/null
	done
	while read -r iface vhid parent label prefix gateway family <&3; do
		source=pf-work-${parent#vlan}
		if [ "$master" = fw2 ]; then
			ic exec "$source" -- sh -eu -c '
				: >/run/w1-events
				udhcpc -f -i eth0 -s /run/w1-udhcpc -p /run/w1-dhcp.pid -n -t 5 -T 3 >/run/w1-dhcp.log 2>&1 &
				pid=$!
				trap "kill $pid 2>/dev/null || :" 0
				for i in $(seq 30); do grep -qx bound /run/w1-events && break; sleep 1; done
				grep -qx bound /run/w1-events
				cp /run/w1-lease /run/w1-acquired
				kill -USR1 "$pid"
				for i in $(seq 30); do grep -qx renew /run/w1-events && break; sleep 1; done
				grep -qx renew /run/w1-events
				cmp /run/w1-acquired /run/w1-lease
			' || {
				ic exec "$source" -- cat /run/w1-dhcp.log /run/w1-events 2>&1 | sed "s/^/CV-PF dhcp $source: /"
				work_diag "$source" "$gateway"
				exit 1
			}
			lease=$(ic exec "$source" -- cat /run/w1-lease)
			address=${lease%% *}
			mac=$(ic exec "$source" -- cat /sys/class/net/eth0/address)
			ssh -F /etc/convergent/ssh_config fw2 "sed -n '/^lease $address {/,/^}/p' /var/db/dhcpd.leases" > /run/convergent/pf-dhcp
			grep -q "hardware ethernet $mac;" /run/convergent/pf-dhcp
		fi
		probe allow "$source" "$gateway" 53 dns
		probe allow "$source" "$gateway" 53
		ic exec "$source" -- ping -c 1 -W 3 "$gateway" >/dev/null || result=1
		# Only DNS and ping reach the gateway: a listener on the master's VIP, proven from the master, stays unreachable.
		canary_begin "$master" "$gateway" 8053 || { echo "CV-PF FAIL gateway listener readiness on $master"; exit 1; }
		probe deny "$source" "$gateway" 8053
		canary_end || { echo "CV-PF FAIL gateway canary listener on $master"; result=1; }
		probe allow "$source" 1.1.1.1 443
		probe "$home_want" "$source" 10.0.2.100 80
		for destination in 100.80.1.10 100.80.1.2 100.80.1.3 100.80.0.10; do
			probe deny "$source" "$destination" 22
		done
		probe deny "$source" 100.80.2.10 8880
		probe deny "$source" 100.80.3.10 80
		probe deny "$source" 100.80.4.10 80
		while read -r other ov op ol onet og ofamily <&4; do
			[ "$other" != "$iface" ] || continue
			# Each VLAN is isolated: another work VLAN is never reachable, same domain or not.
			want=deny
			probe "$want" "$source" "${onet%.0/26}.10" 8080
			# A one-way leak would leave the SYN half-open at the receiver: nothing may arrive there.
			half=$(ic exec "pf-work-${op#vlan}" -- awk '$4 == "03" && $2 ~ /:1F90$/ {print}' /proc/net/tcp) || half=error
			[ -z "$half" ] || { echo "CV-PF FAIL half-open at pf-work-${op#vlan} from $source: $half"; result=1; }
		done 4<"$work_rows"
	done 3<"$work_rows"
done
if [ -n "${w1_stopped:-}" ]; then
	ic start fw1
	# Its boot and 30-minute kernel relink slowed every probe and undo below; fw1 is still in maintenance.
	cv_time work-settle-fw1
	fw_settled -t 3600 fw1 fw2 || { echo 'CV-PF FAIL fw1 not settled after its restart'; exit 1; }
	timeout -k 5 1800 sh -c 'until ssh -n -F /etc/convergent/ssh_config fw1 "rcctl check dhcpd"; do sleep 5; done'
	ic config unset fw1 boot.autorestart
	w1_stopped=
	# check auto reopens a gate closed while fw1 booted; do what it does.
	timeout -k 5 300 sh -c 'until sh /usr/lib/convergent/incus/work-gate; do sleep 10; done'
fi
while read -r iface vhid parent label prefix gateway family <&3; do
	source=pf-work-${parent#vlan}
	ic exec "$source" -- udhcpc -i eth0 -s /run/w1-udhcpc -n -q -t 5 -T 3 || {
		nft list chain bridge host-l2 work_gate | sed 's/^/CV-PF gate: /'
		for f in fw1 fw2; do
			timeout 20 ssh -n -F /etc/convergent/ssh_config "$f" 'ifconfig carp | grep -c MASTER; rcctl check dhcpd; grep dhcpd /var/log/daemon | tail -n 6' 2>&1 | sed "s/^/CV-PF $f: /"
		done
		exit 1
	}
	lease=$(ic exec "$source" -- cat /run/w1-lease)
	address=${lease%% *}
	mac=$(ic exec "$source" -- cat /sys/class/net/eth0/address)
	for node in fw1 fw2; do
		for i in $(seq 30); do
			ssh -F /etc/convergent/ssh_config "$node" "sed -n '/^lease $address {/,/^}/p' /var/db/dhcpd.leases" > /run/convergent/pf-dhcp
			grep -q "hardware ethernet $mac;" /run/convergent/pf-dhcp && break
			sleep 1
		done
		grep -q "hardware ethernet $mac;" /run/convergent/pf-dhcp
	done
done 3<"$work_rows"
printf 'yes\n' | sys firewall undo
w1_maintenance=
rm -f "$work_rows" /run/convergent/pf-work-fw1 /run/convergent/pf-work-fw2
# End work-network matrix.
# Undo hands MASTER back to fw1, the pair the Remmina matrix starts from.
cv_time work-settle
fw_settled -t 1800 fw1:master fw2:backup || { echo 'CV-PF FAIL firewalls not settled after the work matrix'; exit 1; }

# Remmina work-network matrix; the topology renderer supplies VLANs and PF tables.
# Delivery, not echo: BusyBox nc (1.10 mode) has no -k, and a UDP listener binds to its first peer.
# The target's own allow probe before each Remmina probe is the listener's control: a bind that failed
# shows there, not as a denial. A sender or receiver that could not run is a test error, never a denial.
udp_remote() {
    for attempt in 1 2 3; do
    ic exec "$target" -- sh -c 'rm -f /run/cv-udp; timeout 20 nc -lu -p "$1" </dev/null >/run/cv-udp 2>/dev/null & echo $! >/run/cv-udp.pid' sh "$4" ||
        { echo "CV-REMOTE ERROR udp listener $target:$4"; result=1; return; }
    sleep 1
    sent=$(timeout -k 1 8 incus --force-local --project "$(project "$2")" exec "$2" -- sh -c \
        'printf "cv-remmina\n" | nc -u -w 1 "$1" "$2"; echo CV-UDP-SENT' sh "$3" "$4" 2>/dev/null) &&
        [ "$sent" = CV-UDP-SENT ] || { echo "CV-REMOTE ERROR udp sender $2"; result=1; return; }
    sleep 1
    delivered=$(ic exec "$target" -- sh -c 'kill "$(cat /run/cv-udp.pid)" && cat /run/cv-udp') || { echo "CV-REMOTE ERROR udp receiver $target"; result=1; return; }
    if printf '%s\n' "$delivered" | grep -qx cv-remmina; then got=allow; else got=deny; fi
    # A CARP flap loses a datagram: an expected allow gets three tries, as the TCP probes do; denies stay single.
    [ "$1:$got" = allow:deny ] || break
    sleep 2
    done
    [ "$got" = "$1" ] || { echo "CV-REMOTE FAIL udp $2 $3:$4 want=$1 got=$got"; result=1; }
}
for master in fw1 fw2; do
	cv_time "remote-$master"
    if [ "$master" = fw2 ]; then
        w1_maintenance=1
        printf 'yes\n' | sys firewall maintenance
        # The failover closes work access until the gate validates the new pair; the first three
        # Remmina probes once landed in that window.
        timeout -k 5 300 sh -c 'until sh /usr/lib/convergent/incus/work-gate; do sleep 10; done'
    fi
    for f in fw1 fw2; do
        if [ "$f" = "$master" ]; then want=MASTER; else want=BACKUP; fi
        timeout 30 ssh -F /etc/convergent/ssh_config "$f" ifconfig >"/run/convergent/pf-remote-$f"
        awk -v want="$want" -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments "/run/convergent/pf-remote-$f" >/dev/null
    done
    echo "CV-REMOTE master=$master"
    for vlan in 320 330 360 370; do
        address=$(ssh -F /etc/convergent/ssh_config "$master" "ifconfig vlan$vlan" |
            awk '$1 == "inet" {sub(/\.[0-9]+$/, "", $2); print $2}') || exit 1
        case $address in 100.80.[0-9]|100.80.[0-9][0-9]|100.80.[0-9][0-9][0-9]) ;; *) exit 1 ;; esac
        target=pf-work$vlan
        if [ "$master" = fw1 ]; then
            label=$(awk -v parent="vlan$vlan" '$3 == parent {print $4}' /etc/convergent/segments)
            ic init pf-browser "$target" -p pf-base -p "work-$label" -c limits.memory=128MiB
            created="$target $created"
            ic config device add "$target" render none
            ic start "$target"
            timeout -k 1 60 sh -c 'until incus --force-local --project "$2" exec "$1" -- true; do sleep 1; done' sh "$target" owner
            ic exec "$target" -- sh -eu -c '
                sysctl -qw net.ipv4.conf.eth0.arp_ignore=0
                ip addr add "$1.1/26" dev eth0
                ip link set eth0 up
                ip route add default via "$1.62"
            ' sh "$address"
        fi
        for port in 22 3389 5900 5999 5899 6000 53 80 443; do
            [ "$master" != fw1 ] || listen "$target" "$address.1" "$port"
            probe allow "$target" "$address.1" "$port"
            case $port in 22|3389|5900|5999) want=allow ;; *) want=deny ;; esac
            probe "$want" "$rem" "$address.1" "$port"
        done
        for port in 3389 3390 53; do
            udp_remote allow "$target" "$address.1" "$port"
            case $port in 3389) want=allow ;; *) want=deny ;; esac
            udp_remote "$want" "$rem" "$address.1" "$port"
        done
        ic exec "$rem" -- ping -c 3 -W 3 "$address.1" || result=1
        # Each denied port answers its own node first.
        for host in 49 50 62; do
            case $host in 49) node=fw1 ;; 50) node=fw2 ;; *) node=$master ;; esac
            for port in 5900 22 3389; do
                canary_begin "$node" "$address.$host" "$port" || { echo "CV-PF FAIL infrastructure listener readiness for $address.$host:$port"; exit 1; }
                probe deny "$rem" "$address.$host" "$port"
                canary_end || { echo "CV-PF FAIL infrastructure listener for $address.$host:$port"; result=1; }
            done
            got=$(ic exec "$rem" -- sh -c 'if ping -c 1 -W 2 "$1" >/dev/null 2>&1; then echo allow; else echo deny; fi' sh "$address.$host") || got=error
            [ "$got" = deny ] || result=1
        done
    done
    for destination in 100.80.3.1 100.80.1.10 100.80.2.10 100.80.4.10 100.80.0.10 10.0.2.100 1.1.1.1; do
        for port in 22 53 80 443 8443 3389 5900; do probe deny "$rem" "$destination" "$port"; done
    done
    probe deny "$rem" 100.80.3.1 53 dns
    [ "$master" != fw1 ] || listen pf-def 100.80.3.10 3389
    probe allow pf-def 100.80.3.10 3389
    probe deny "$rem" 100.80.3.10 3389
    ic exec "$rem" -- sh -c 'test "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" = 1' || result=1
done
printf 'yes\n' | sys firewall undo
w1_maintenance=
rm -f /run/convergent/pf-remote-fw1 /run/convergent/pf-remote-fw2
echo "CV-REMOTE network result=$result"
# End Remmina.
exit "$result"
