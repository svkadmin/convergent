#!/bin/sh
# The unmodified v0.1.3-rc1 fetcher's parsers must accept the published base bundle.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-release-compat: $*" >&2; exit 1; }
# Retrying an installed release must retain a complete stage across every rename.
(
stagework=$work/stage-retry
mkdir "$stagework"
sed -n '/^# Staged before the slot write:/,$p' "$repo/tools/fetch-release" |
    sed "s|/run/convergent/guests.lock|$stagework/lock|g" >"$stagework/publish"
grep -q '^slot write ' "$stagework/publish"
{
    echo 'recover() {'
    sed -n '/^    staged=\/var\/lib\/convergent\/guest-updates$/,/^    # Nothing changes/p' "$repo/tools/guests" |
        sed 's|staged=/var/lib/convergent/guest-updates|staged=$root/stages|'
    sed -n '/^    for entry in "\$staged"\/\* "\$staged"\/\./,/^    done$/p' "$repo/tools/guests"
    echo '}'
    echo 'recover'
} >"$stagework/recover"
grep -q 'maintenance_due || return 0' "$stagework/recover"
grep -q 'rm -rf' "$stagework/recover"
cat >"$stagework/run" <<'STAGE'
set -eu
root=$1 fault=$2 action=$3 booted=${4:-43}
dir=$root/download staged=$root/stages latest=43 changed=remmina rsum=signed sync=
die() { echo "$*" >&2; exit 1; }
flock() { :; }
maintenance_due() { return 1; }
# Only ownership and flushing are simulated; moves and removals use real files.
stat() {
    if [ "$2" = '%u %a %F' ]; then
        [ -d "$3" ] && [ ! -L "$3" ] || return 1
        echo '0 700 directory'
    elif [ "$fault" = stat ]; then return 1
    elif [ "$fault" = cross-device ] && [ "$3" = "$dir/guests" ]; then
        echo other-device
    else command stat "$@"; fi
}
private() { [ ! -L "$1" ] && [ -d "$1" ] || die 'invalid private directory'; }
sync() {
    if [ "$fault" = flush ] && [ -d "$staged/43.old" ] && [ -d "$staged/43" ]; then return 1; fi
}
cp() {
    [ "$fault" != sidecar ] || return 1
    command cp "$@"
}
mv() {
    if [ "$fault" = move ] && [ "$2" = "$dir/guests" ]; then return 1; fi
    command mv "$@"
    if [ "$fault" = cut ] && [ "$3" = "$staged/43.old" ]; then exit 73; fi
}
rm() {
    command rm "$@"
    # The original deletion window must fail the same interruption fixture.
    if [ "$fault" = cut ] && [ "$2" = "$staged/43" ]; then exit 73; fi
}
slot() {
    [ "$*" = "write $dir" ] || die 'unexpected slot call'
    for release in 42 44; do [ -f "$staged/$release/keep" ] || die 'pruned before slot write'; done
    [ "$(cat "$staged/43/remmina/payload")" = new ] || die 'missing replacement'
    for file in remmina.manifest remmina.manifest.sig; do
        [ "$(cat "$staged/43/$file")" = "$file" ] || die 'incomplete replacement'
    done
    [ "$fault" != slot ] || return 1
    touch "$root/accepted"
}
. "$action"
STAGE
for script in publish recover run; do sh -n "$stagework/$script"; done
for fault in none cut move slot sidecar flush cross-device stat; do
    root=$stagework/$fault
    mkdir -p "$root/download/guests/remmina" "$root/stages/43/remmina" "$root/stages/42" "$root/stages/44"
    echo old >"$root/stages/43/remmina/payload"
    echo new >"$root/download/guests/remmina/payload"
    touch "$root/stages/42/keep" "$root/stages/44/keep"
    for file in remmina.manifest remmina.manifest.sig; do echo "$file" >"$root/download/$file"; done
    if sh "$stagework/run" "$root" "$fault" "$stagework/publish" >"$stagework/log" 2>&1; then
        [ "$fault" = none ] || die "accepted $fault stage publication"
        [ -f "$root/accepted" ]
        [ ! -e "$root/stages/42" ] && [ ! -e "$root/stages/44" ]
        [ ! -e "$root/stages/43.old" ]
    else
        [ "$fault" != none ] || { cat "$stagework/log"; exit 1; }
        [ ! -e "$root/accepted" ]
        [ -f "$root/stages/42/keep" ] && [ -f "$root/stages/44/keep" ]
    fi
    # Immediate reboot, including fallback with and without a stage of its own.
    for boot in 43 42 41; do
        reboot=$stagework/$fault-boot-$boot
        mkdir "$reboot"
        cp -R "$root/stages" "$reboot/"
        sh "$stagework/run" "$reboot" none "$stagework/recover" "$boot"
        case $fault in none|slot|flush) want=new ;; *) want=old ;; esac
        [ "$(cat "$reboot/stages/43/remmina/payload")" = "$want" ] || die "lost $fault stage on boot $boot"
        [ ! -d "$reboot/stages/43/guests" ] || die 'nested replacement stage'
    done
    # A fetch retry must also recover an aside without nesting the new directory.
    case $fault in cut|move)
        sh "$stagework/run" "$root" none "$stagework/publish" >"$stagework/log" 2>&1 || { cat "$stagework/log"; exit 1; }
        [ -f "$root/accepted" ] && [ ! -e "$root/stages/43.old" ]
        ;;
    esac
done
echo 'test-release-compat: stage interruption, move failure, reboot recovery and post-slot pruning passed'
)
# USB reads stay bounded even before signatures or artifact hashes are checked.
sed -n '/^usb_copy() {/,/^}/p' "$repo/tools/fetch-release" >"$work/usb-copy"
[ -s "$work/usb-copy" ]
sh -n "$work/usb-copy"
. "$work/usb-copy"
(
usb=$work/copy-source dir=$work/copy-target
mkdir "$usb" "$dir"
head() {
    command head "$@" >"$work/read" || return 1
    stat -c %s "$work/read" >"$work/read-bytes"
    cat "$work/read"
    [ "$fault" != io ]
}
cp() {
    command cp "$@" || return 1
    stat -c %s "$2" >"$work/read-bytes"
    [ "$fault" != io ]
}
for limit in 1024 65536; do
    for fault in none oversized io directory; do
        echo 0 >"$work/read-bytes"
        rm -rf "$usb/input"
        case $fault in
        none|io) command head -c "$limit" /dev/zero >"$usb/input" ;;
        oversized) command head -c "$((limit * 2))" /dev/zero >"$usb/input" ;;
        directory) mkdir "$usb/input" ;;
        esac
        echo partial >"$dir/output"
        if usb_copy input "$dir/output" "$limit"; then
            [ "$fault" = none ] || die "accepted $fault USB metadata"
            cmp "$usb/input" "$dir/output"
        else
            [ "$fault" != none ] || die 'rejected bounded USB metadata'
            [ ! -e "$dir/output" ] || die 'left failed USB output'
        fi
        [ "$(cat "$work/read-bytes")" -le "$((limit + 1))" ] || die 'unbounded USB read'
    done
done
sed -n '/^field()/p; /^have()/p; /^mf()/p; /^download() {/,/^}/p' "$repo/tools/fetch-release" >"$work/download-check"
[ -s "$work/download-check" ] && grep -q '^download()' "$work/download-check"
sh -n "$work/download-check"
. "$work/download-check"
printf good >"$usb/slot.img"
printf 'size slot.img 4\n%s slot.img\n' "$(sha256sum <"$usb/slot.img" | cut -d' ' -f1)" >"$dir/manifest"
for fault in none oversized short hash io directory; do
    echo 0 >"$work/read-bytes"
    rm -rf "$usb/slot.img"
    rm -f "$dir/slot.img"
    case $fault in
    none|io) printf good >"$usb/slot.img" ;;
    oversized) printf oversized >"$usb/slot.img" ;;
    short) printf bad >"$usb/slot.img" ;;
    hash) printf evil >"$usb/slot.img" ;;
    directory) mkdir "$usb/slot.img" ;;
    esac
    if (download slot.img) >"$work/log" 2>&1; then
        [ "$fault" = none ] || die "accepted $fault USB artifact"
        cmp "$usb/slot.img" "$dir/slot.img"
    else
        [ "$fault" != none ] || { cat "$work/log"; exit 1; }
        [ ! -e "$dir/slot.img" ] || die 'left failed USB artifact'
    fi
    [ "$(cat "$work/read-bytes")" -le 5 ] || die 'artifact exceeded signed size plus one'
done
# A dropped online download still keeps its partial file for resumption.
usb= url=https://fixture.invalid latest=43
# Each online file refreshes the opening first, so the 4-hour expiry never cuts a long release.
refresh_src() { touch "$work/refreshed"; }
get() {
    [ "$*" = "--max-time 7200 --max-filesize 4 --retry 5 --retry-max-time 7200 -C - -o $dir/slot.img $url/43/slot.img" ] || exit 97
    [ -f "$work/refreshed" ] || exit 96
    printf go >"$dir/slot.img"
    return 18
}
if (download slot.img) >"$work/log" 2>&1; then die 'accepted dropped online download'; fi
[ -f "$work/refreshed" ] || die 'online download did not refresh the update source'
[ "$(cat "$dir/slot.img")" = go ]
)
# The anti-rollback floor is not evidence that the running release is current.
sed -n '/^uptodate=/,/^# Fail now/p' "$repo/tools/fetch-release" >"$work/current"
[ -s "$work/current" ] && grep -q '^sync=' "$work/current"
sh -n "$work/current"
for mode in check write; do
    for highest in 43 44; do
        if (booted=42 latest=43 floor=$highest current='up to date' signed_ago='signed 0 days ago'; . "$work/current") >"$work/log" 2>&1; then
            die 'accepted older boot as current'
        fi
        grep -q 'booted release 42 is older than newest published 43' "$work/log"
        grep -q "highest good release $highest blocks ordinary reinstallation" "$work/log"
        grep -q 'boot menu.*rescue' "$work/log"
        if grep -q 'up to date' "$work/log"; then die 'reported older boot current'; fi
    done
    (booted=43 latest=43 highest=43 floor=43 current='up to date' signed_ago='signed 0 days ago'; . "$work/current"; [ "$sync" = 1 ])
    (booted=42 latest=44 highest=43 floor=43 current='up to date' signed_ago='signed 0 days ago'; . "$work/current"; [ -z "$sync" ])
done
echo 'test-release-compat: bounded USB copies, online resumption and older boot fixtures passed'
# A failed flush must still kill states, retain tracking and allow cleanup to retry.
(
. "$repo/rootfs/usr/lib/convergent/update.sh"
rsh() { fw=$1; (eval "$2"); }
pfctl() {
    printf '%s %s\n' "$fw" "$*" >>"$work/pf-calls"
    case $* in
    '-t update_src -T flush') op=flush ;;
    '-k label -k update') op='kill' ;;
    '-q -t update_src -T zero') op=zero ;;
    *) exit 97 ;;
    esac
    if [ "$fw" = "$failed_fw" ] && { [ "$fault" = "$op" ] || [ "$fault" = both ]; }; then
        echo "$fw $op failed" >&2
        return 1
    fi
    rm -f "$work/$fw.$op"
}
for failed_fw in fw2 fw1; do
    for fault in none flush kill both; do
        : >"$work/pf-calls"
        : >"$work/pf-want"
        for fw in $fws; do
            touch "$work/$fw.flush" "$work/$fw.kill"
            printf '%s\n' "$fw -t update_src -T flush" "$fw -k label -k update" >>"$work/pf-want"
        done
        src_open=1
        if close_src 2>"$work/pf-error"; then
            [ "$fault" = none ] && [ -z "$src_open" ] || die 'unexpected cleanup status or tracking'
        else
            [ "$fault" != none ] && [ "$src_open" = 1 ] || die 'unexpected cleanup status or tracking'
        fi
        cmp "$work/pf-want" "$work/pf-calls"
        for fw in $fws; do
            for op in flush kill; do
                if [ "$fw" = "$failed_fw" ] && { [ "$fault" = "$op" ] || [ "$fault" = both ]; }; then
                    [ -f "$work/$fw.$op" ]
                    grep -qx "$fw $op failed" "$work/pf-error"
                else
                    [ ! -e "$work/$fw.$op" ]
                fi
            done
        done
        fault=none
        close_src
        [ -z "$src_open" ]
        for fw in $fws; do [ ! -e "$work/$fw.flush" ] && [ ! -e "$work/$fw.kill" ]; done
    done
done
# A refresh clears the expiry stamp on both firewalls; a failed one stops the download.
for failed_fw in none fw2 fw1; do
    : >"$work/pf-calls"
    if (fault=zero; refresh_src) 2>"$work/pf-error"; then
        [ "$failed_fw" = none ] || die "accepted a failed refresh on $failed_fw"
        printf '%s\n' 'fw2 -q -t update_src -T zero' 'fw1 -q -t update_src -T zero' | cmp - "$work/pf-calls"
    else
        [ "$failed_fw" != none ] || { cat "$work/pf-error"; exit 1; }
        grep -q "could not refresh the update source on $failed_fw" "$work/pf-error"
    fi
done
# A manual pfctl -f reloads a file-backed table empty: the opening lives only in the kernel.
grep -Eqx 'table <update_src>[[:space:]]+persist' "$repo/guests/fw/site/etc/pf.conf" || die 'update_src is not a plain persist table'
echo 'test-release-compat: update cleanup failure, retry and refresh fixtures passed'
)
if [ "$#" = 1 ]; then
    bundle=$1
else
    mkdir -p "$work/build" "$work/source" "$work/bundle"
    cp "$here/build.conf" "$work/build/"
    sed '/^\[ "$(id -u)" = 0 \]/d; s|^keys=.*|keys=/nonexistent|' "$here/guests" >"$work/build/guests"
    echo 'release 42' >"$work/bundle/manifest"
    for g in fw wan svc browser remmina; do
        mkdir -p "$work/source/$g"
        echo "$g payload" >"$work/source/$g/rootfs.tar.gz"
        (cd "$work/source/$g" && sha256sum rootfs.tar.gz >SHA256SUMS)
        case $g in
        svc|remmina) echo 'config: {}' >"$work/source/$g/incus.yaml" ;;
        browser) mkdir "$work/source/browser/incus"; echo 'config: {}' >"$work/source/browser/incus/base.yaml" ;;
        esac
    done
    sh "$work/build/guests" "$work/bundle" "$work/source"
    bundle=$work/bundle
fi
# Run the publisher's production manifest path loop on the same bundle.
awk '/^for manifest in guests.manifest remmina.manifest/ {copy=1} copy {print} copy && /^done$/ {exit}' "$here/publish" >"$work/publish-paths"
(dir=$bundle; release=$(awk '$1 == "release" {print $2}' "$bundle/manifest"); manifests=manifest; files=; . "$work/publish-paths")
old=$here/fixtures/fetch-release-0.1.3
awk '/^guest_files=\$\(awk / {copy=1} copy {print} copy && /invalid guest path in guests.manifest/ {exit}' "$old" >"$work/paths"
awk '/^awk .*\$1 == "guest"/ {copy=1} copy {print} copy && /invalid guest identity in guests.manifest/ {exit}' "$old" >"$work/identities"
[ -s "$work/paths" ] && [ -s "$work/identities" ]
dir=$work
gm=$bundle/guests.manifest
. "$work/paths"
. "$work/identities"
[ "$(wc -l <"$dir/guest-ids")" = 4 ]
if grep -q remmina "$gm"; then exit 1; fi
grep -q '^guest remmina ' "$bundle/remmina.manifest"
cp "$gm" "$work/incompatible"
cat "$bundle/remmina.manifest" >>"$work/incompatible"
if (gm=$work/incompatible; . "$work/paths") 2>/dev/null; then die 'old path parser accepted Remmina'; fi
if (gm=$work/incompatible; . "$work/identities") 2>/dev/null; then die 'old identity parser accepted Remmina'; fi
# Exercise the new sidecar reader with real signatures, including rejection paths.
awk '/^# The old fetcher ignores/ {copy=1} copy && /^files=/ {exit} copy {print}' "$repo/tools/fetch-release" |
    sed 's|\[ -e /var/lib/convergent/guests/initialized \]|true|' >"$work/sidecar"
awk '/^field\(\)/ {print}' "$repo/tools/fetch-release" >"$work/field"
. "$work/field"
openssl genpkey -algorithm ed25519 -out "$work/key" 2>/dev/null
openssl pkey -in "$work/key" -pubout -out "$work/pub" 2>/dev/null
verify() { openssl pkeyutl -verify -pubin -inkey "$work/pub" -rawin -in "$1" -sigfile "$1.sig" >/dev/null 2>&1; }
mkdir "$work/usb" "$work/download"
cp "$bundle/remmina.manifest" "$work/usb/"
latest=$(field release '' "$bundle/manifest")
for fault in none tampered wrong-release missing; do
    cp "$bundle/remmina.manifest" "$work/usb/remmina.manifest"
    if [ "$fault" = wrong-release ]; then sed 's/^release .*/release 0/' "$bundle/remmina.manifest" >"$work/usb/remmina.manifest"; fi
    openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$work/usb/remmina.manifest" -out "$work/usb/remmina.manifest.sig"
    rsum=$(sha256sum <"$work/usb/remmina.manifest" | cut -d' ' -f1)
    case $fault in tampered) echo bad >>"$work/usb/remmina.manifest" ;; missing) rm "$work/usb/remmina.manifest" ;; esac
    if (dir=$work/download; gm=$bundle/guests.manifest; usb=$work/usb; . "$work/sidecar") 2>"$work/error"; then
        [ "$fault" = none ] || die "accepted $fault sidecar"
    else
        [ "$fault" != none ] || { cat "$work/error"; exit 1; }
    fi
done
# The installed guest updater rechecks the sidecar before consuming staged Remmina.
awk '/^    if \[ -f "\$staged\/remmina.manifest" \]/ {copy=1} copy && /^    kinds=/ {exit} copy {print}' "$repo/tools/guests" |
    sed "s|/etc/convergent/release.pub|$work/pub|" >"$work/staged-check"
mkdir "$work/staged"
cp -R "$bundle/guests/remmina" "$work/staged/"
cp "$bundle/remmina.manifest" "$work/staged/"
openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$work/staged/remmina.manifest" -out "$work/staged/remmina.manifest.sig"
(staged=$work/staged; booted=$latest; . "$work/staged-check")
echo changed >>"$work/staged/remmina/SHA256SUMS"
if (staged=$work/staged; booted=$latest; . "$work/staged-check") 2>/dev/null; then die 'accepted changed staged identity'; fi
awk '/^read_pointer\(\) \{/ {copy=1} copy {print} copy && /^}/ {exit}' "$old" >"$work/old-pointer"
awk '/^num\(\)|^bytes\(\)/ {print}' "$old" >>"$work/old-pointer"
mkdir "$work/pointer"
if [ -f "$bundle/latest" ]; then cp "$bundle/latest" "$work/pointer/latest"
else
    printf 'release %s\nsigned %s\nguests %s\nremmina %s\n' "$latest" "$(date +%s)" \
        "$(sha256sum <"$bundle/guests.manifest" | cut -d' ' -f1)" \
        "$(sha256sum <"$bundle/remmina.manifest" | cut -d' ' -f1)" >"$work/pointer/latest"
fi
openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$work/pointer/latest" -out "$work/pointer/latest.sig"
(pointer=$work/pointer; usb=; . "$work/old-pointer"; read_pointer)
echo 'test-release-compat: old parsers accept base bundle and latest; signed sidecar and rejection fixtures passed'
# Manual updates authenticate before the first state/recovery operation.
(
manual=$work/manual
mkdir -p "$manual/release/guests"
openssl genpkey -algorithm ed25519 -out "$manual/other-key" 2>/dev/null
printf 'convergent.release=42\n' >"$manual/cmdline"
echo topology >"$manual/topology.sha256"
sed "s|^key=.*|key=$work/pub|" "$repo/rootfs/usr/lib/convergent/update.sh" >"$manual/update.sh"
sed -n '/^verify_image() {/,/^}/p; /^manual_image() (/,/^)/p' "$repo/tools/guests" |
    sed -e "s|/usr/lib/convergent/update.sh|$manual/update.sh|" \
        -e "s|/proc/cmdline|$manual/cmdline|" \
        -e "s|/etc/convergent/topology.sha256|$manual/topology.sha256|" >"$manual/functions"
grep -q '^verify_image()' "$manual/functions"
grep -q '^manual_image()' "$manual/functions"
sed -n '/^case ${1:-}:$# in/,/^mkdir -p "\$state" \/run\/convergent/p' "$repo/tools/guests" |
    sed '$d' | sed -e "s|mkdir -p \"\$state\"\$|mkdir -p \"$manual\"|" \
        -e "s|\"\$state/stage.XXXXXX\"|\"$manual/stage.XXXXXX\"|" >"$manual/entry"
[ -s "$manual/entry" ]
grep -q "$manual/stage.XXXXXX" "$manual/entry" || { echo 'test-release-compat: staging path not mapped'; exit 1; }
sh -n "$manual/update.sh"
sh -n "$manual/functions"
sh -n "$manual/entry"
. "$manual/functions"
sed -n '/^ident() /p' "$here/guests" >"$manual/ident"
[ -s "$manual/ident" ]
sh -n "$manual/ident"
. "$manual/ident"
id() { echo 0; }
sign_manual() {
    printf 'release %s\nguest %s %s\n' "$release_id" "$identity_kind" "$(ident "$image")" >"$manifest"
    openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$manifest" -out "$manifest.sig"
}
for guest in fw wan svc browser def int remmina; do
    kind=$guest
    case $guest in def|int) kind=browser ;; esac
    image=$manual/release/guests/$kind
    mkdir -p "$image"
    case $kind in
    fw) artifacts='fw1.qcow2 fw2.qcow2 fw1.pf.sha256 fw2.pf.sha256 fw1.rules.sha256 fw2.rules.sha256 segments topology.sha256' ;;
    wan) artifacts='wan-metadata.tar.xz wan.qcow2 topology.sha256' ;;
    *) artifacts='metadata.tar.gz rootfs.tar.gz' ;;
    esac
    for artifact in $artifacts; do echo "$artifact" >"$image/$artifact"; done
    case $kind in fw|wan) cp "$manual/topology.sha256" "$image/" ;; esac
    case $kind in
    svc|remmina) echo 'config: {}' >"$image/incus.yaml" ;;
    browser)
        mkdir -p "$image/incus"
        for role in base def tmp int; do echo "description: $role" >"$image/incus/$role.yaml"; done ;;
    esac
    (cd "$image" && sha256sum $artifacts >SHA256SUMS)
    manifest=$manual/release/guests.manifest
    [ "$kind" != remmina ] || manifest=$manual/release/remmina.manifest
    cp -R "$image" "$manual/saved"
    for fault in none substituted missing signature tampered key old future duplicate-release identity duplicate-identity payload recomputed profile missing-profile extra-profile missing-artifact path duplicate-checksum override bad-option; do
        rm -rf "$image"
        cp -R "$manual/saved" "$image"
        release_id=42 identity_kind=$kind
        case $fault in old) release_id=41 ;; future) release_id=43 ;; identity) identity_kind=other ;; esac
        sign_manual
        case $fault in
        none) ;;
        missing|override|bad-option) rm "$manifest" ;;
        signature) rm "$manifest.sig" ;;
        tampered) echo tampered >>"$manifest" ;;
        key) openssl pkeyutl -sign -inkey "$manual/other-key" -rawin -in "$manifest" -out "$manifest.sig" ;;
        duplicate-release|duplicate-identity)
            case $fault in duplicate-release) echo 'release 42' ;; *) echo "guest $kind $(ident "$image")" ;; esac >>"$manifest"
            openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$manifest" -out "$manifest.sig" ;;
        payload|recomputed)
            echo substituted >>"$image/${artifacts%% *}"
            [ "$fault" != recomputed ] || (cd "$image" && sha256sum $artifacts >SHA256SUMS) ;;
        profile|missing-profile)
            case $kind in browser) profile=$image/incus/base.yaml ;; svc|remmina) profile=$image/incus.yaml ;; *) continue ;; esac
            case $fault in profile) echo substituted >>"$profile" ;; *) rm "$profile" ;; esac ;;
        extra-profile) echo substituted >"$image/incus.yaml" ;;
        missing-artifact)
            sed '1d' "$image/SHA256SUMS" >"$manual/sums"
            mv "$manual/sums" "$image/SHA256SUMS"
            sign_manual ;;
        path|duplicate-checksum)
            case $fault in path) printf '%s ../outside\n' "$(sha256sum <"$image/${artifacts%% *}" | cut -d' ' -f1)" ;; *) head -n 1 "$image/SHA256SUMS" ;; esac >"$manual/sum"
            cat "$manual/sum" >>"$image/SHA256SUMS"
            sign_manual ;;
        esac
        rm -f "$manual/mutated"
        if (
            manual_stage=
            trap '[ -z "$manual_stage" ] || rm -rf "$manual_stage"' 0
            set -- update "$guest" "$image"
            case $fault in override) set -- "$@" --trusted-local ;; bad-option) set -- "$@" --trust-local ;; esac
            . "$manual/entry" || exit 1
            if [ "$fault" = substituted ]; then
                # Replace the source after authentication, as during the lock wait.
                echo substituted >"$image/${artifacts%% *}"
                (cd "$image" && sha256sum $artifacts >SHA256SUMS) || exit 1
                case $kind in
                svc|remmina) echo substituted >"$image/incus.yaml" ;;
                browser) echo substituted >"$image/incus/base.yaml" ;;
                esac
                rm "$manifest" "$manifest.sig" || exit 1
            fi
            case $fault in none|substituted)
                image_dir=$3
                verify_image "$guest" || exit 1
                diff -r "$manual/saved" "$image_dir" || exit 1 ;;
            esac
            echo recovery >"$manual/mutated"
        ) >"$manual/log" 2>&1; then
            case $fault in none|substituted|override) [ -s "$manual/mutated" ] ;; *) die "manual $guest accepted $fault" ;; esac
        else
            case $fault in none|substituted|override) cat "$manual/log"; die "manual $guest rejected $fault" ;; esac
            [ ! -e "$manual/mutated" ] || die 'manual rejection mutated state'
        fi
    done
    rm -rf "$manual/saved"
done
echo 'test-release-compat: manual signatures, release binding, identities, profiles, digests, source substitution and explicit local override passed'
)
