#!/bin/sh
# Offline observability fixtures; no guest, network, root or signing key is required.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
# CheckerFailed must name the existing sys handler.
grep -qF 'Inspect sys security check and' "$repo/guests/svc/dashboards/security.py"
grep -qF 'Inspect sys security check and' "$repo/guests/svc/rootfs/usr/share/grafana/dashboards/security.json"
sh "$here/test-observe-privileges"
sh "$here/test-check-status"
sh "$here/test-guest-reply"
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
# A fresh report cannot borrow an older success interval; clock rollback is due.
sed -n '/^if \[ "${1:-}" = auto \] && \[ -f "\$state\/last" \]; then$/,/^fi$/p' "$repo/tools/check" |
    sed "s|/run/convergent/|$work/run/|g" >"$work/throttle"
mkdir "$work/run"
sed -n '/^ok=1$/,/^# The management endpoint/ { /^# The management endpoint/d; p; }' "$repo/tools/check" >"$work/scan-start"
sed -n '/^printf .*cv_checker_success/,/^logger -t check/ { /^logger -t check/d; p; }' "$repo/tools/check" >"$work/scan-end"
for part in throttle scan-start scan-end; do [ -s "$work/$part" ]; sh -n "$work/$part"; done
(
    state=$work/scan-state out=$work/scan-out
    mkdir "$state" "$out" "$work/scan"
    fixture=$work
    work=$fixture/scan
    die() { exit 1; }
    date() { echo "$clock"; }
    stat() { echo 100000; }
    awk() { echo 1; }
    cat() {
        case $1 in /proc/sys/kernel/random/uuid) echo new-scan; return ;; esac
        [ "$fault" != cat ] || return 1
        command cat "$@"
    }
    mktemp() { [ "$fault" != mktemp ] && command mktemp "$@"; }
    chmod() { [ "$fault" != chmod ] && command chmod "$@"; }
    mv() {
        if [ "$fault" = mv ] && [ "$2" = "$out/checker.prom" ]; then return 1; fi
        command mv "$@"
    }
    due() {
        (set +e; set -- auto; net_ok=1; . "$fixture/throttle"; echo run) >"$fixture/due"
        if [ "$1" = yes ]; then grep -qx run "$fixture/due"; else [ ! -s "$fixture/due" ]; fi
    }
    for fault in none mktemp cat chmod mv; do
        for success in 0 1; do
            printf '# scan old-scan\ncv_checker_success 1\ncv_checker_last_run_seconds 100000\n' >"$out/checker.prom"
            cp "$out/checker.prom" "$fixture/previous-metrics"
            clock=100000
            . "$fixture/scan-start"
            ok=$success
            : >"$work/metrics"
            if (set +e; . "$fixture/scan-end"); then [ "$fault" = none ]; else [ "$fault" != none ]; fi
            grep -qx 'Scan: new-scan' "$state/last"
            if [ "$fault" = none ]; then
                grep -qx '# scan new-scan' "$out/checker.prom"
            else cmp "$fixture/previous-metrics" "$out/checker.prom"; fi
            clock=100299; due no
            # A wired re-attach outcome newer than the report gets its scan now.
            command touch -d "@$(($(command stat -c %Y "$state/last") + 60))" "$fixture/run/wired-heal"
            due yes
            rm "$fixture/run/wired-heal"
            clock=100300
            if [ "$fault:$success" = none:1 ]; then due no; else due yes; fi
            clock=186400; due yes
            clock=99999; due yes
        done
    done
    # A pre-upgrade report has no identity; success still gets only five minutes.
    echo old-report >"$state/last"
    echo 'cv_checker_success 1' >"$out/checker.prom"
    clock=100300; due yes
)
# Wired uplink: an allowed NIC wan's QEMU does not hold gets its role re-added once, on the second
# run in a row; never a NIC USBGuard blocks. The scan reports what that leaves, not a pending strike.
sed -n '/^wired_lost() ($/,/^)$/p; /^wired_heal() ($/,/^)$/p' "$repo/tools/check" >"$work/wired-functions"
sed -n '/^# What wired_heal has not fixed/,/^fi$/p' "$repo/tools/check" >"$work/wired-scan"
for part in wired-functions wired-scan; do
    sed -i -e "s|/sys/bus/usb/devices/|$work/wired/sys/|g" -e "s|/run/convergent/|$work/wired/run/|g" \
        -e "s|/proc/uptime|$work/wired/uptime|g" "$work/$part"
    [ -s "$work/$part" ]
    sh -n "$work/$part"
    if grep -q -e /run/convergent -e /sys/bus -e /proc/uptime "$work/$part"; then exit 1; fi
done
grep -q '^wired_heal() ($' "$work/wired-functions"
(
    w=$work/wired
    mkdir -p "$w/sys/1-2/1-2:1.0" "$w/run" "$w/drivers/usbfs" "$w/drivers/r8152"
    printf '0bda\n' >"$w/sys/1-2/idVendor"
    printf '8153\n' >"$w/sys/1-2/idProduct"
    printf 'S1\n' >"$w/sys/1-2/serial"
    role='{"type":"usb","vendorid":"0bda","productid":"8153","serial":"S1","required":"false"}'
    allowed='5: allow id 0bda:8153 serial "S1" name "LAN" hash "h" with-interface { ff:ff:00 }'
    . "$work/wired-functions"
    # wan's read is bounded at 10 s: at 30 s a frozen wan pushed the heal past the next minute run.
    timeout() {
        case "$1 $2 $3 $4" in
        '-k 1 10 incus') [ "$6" = query ] || exit 97 ;;
        '-k 1 30 usbguard') ;;
        '-k 1 120 incus') [ "$8" = config ] || exit 97 ;;
        *) exit 97 ;;
        esac
        shift 3
        "$@"
    }
    incus() {
        case $* in
        '--force-local query /1.0/instances/wan?project=default')
            printf '{"type":"virtual-machine","status":"%s","devices":{"wired-uplink":%s}}\n' "$(cat "$w/status")" "$(cat "$w/role")" ;;
        '--force-local --project default config device remove wan wired-uplink')
            echo remove >>"$w/calls"; echo null >"$w/role" ;;
        '--force-local --project default config device add wan wired-uplink usb vendorid=0bda productid=8153 serial=S1 required=false')
            echo add >>"$w/calls"; [ "$add" = ok ] || return 1; echo "$role" >"$w/role" ;;
        *) echo "unexpected incus: $*" >&2; exit 97 ;;
        esac
    }
    usbguard() { [ "$*" = 'list-devices -a' ] || exit 97; cat "$w/allowed"; }
    heal_allowed() { [ "$inhibit" = 0 ]; }
    # held: wan takes the NIC while the heal waits for the lock.
    flock() { [ "$*" = '-n 8' ] || exit 97; [ "$busy" = 0 ] || return 1; [ "$held" = 0 ] || driver usbfs; }
    logger() { :; }
    bad() { echo "$*" >>"$w/bad"; }
    driver() { rm -f "$w/sys/1-2/1-2:1.0/driver"; [ -z "$1" ] || ln -s "$w/drivers/$1" "$w/sys/1-2/1-2:1.0/driver"; }
    # check runs without errexit.
    run() { echo "$1.50 99.00" >"$w/uptime"; (set +e; wired_heal) >"$w/out" || exit 1; }
    reported() { rm -f "$w/bad"; (set +e; . "$work/wired-scan"); [ -s "$w/bad" ]; }
    is() { [ "$(cat "$1" 2>/dev/null)" = "$2" ] || exit 1; }
    gone() { [ ! -e "$1" ] || exit 1; }
    inhibit=0 busy=0 held=0 add=ok strike=$w/run/wired-strike outcome=$w/run/wired-heal
    echo Running >"$w/status"; echo "$role" >"$w/role"; echo 1 >"$w/sys/1-2/authorized"
    printf '%s\n' "$allowed" >"$w/allowed"; : >"$w/calls"
    # Held: every interface on usbfs.
    driver usbfs; run 1000
    gone "$strike"; is "$w/out" ''
    if reported; then exit 1; fi
    # Lost: a first strike, reported only once the heal has tried.
    driver ''; run 1000
    is "$strike" 'S1 1000'; is "$w/calls" ''
    if reported; then exit 1; fi
    run 1060
    is "$w/calls" "$(printf 'remove\nadd')"; is "$outcome" 'healed S1'; gone "$strike"
    reported
    # A dock that drops the NIC again after a re-attach is a fresh loss.
    run 1120; gone "$outcome"; is "$strike" 'S1 1120'; is "$w/calls" "$(printf 'remove\nadd')"
    run 1180; is "$w/calls" "$(printf 'remove\nadd\nremove\nadd')"; is "$outcome" 'healed S1'
    # Held again ends the loss; a host driver is not wan's.
    driver usbfs; run 1300; gone "$outcome"; gone "$strike"
    driver r8152; run 1360; is "$strike" 'S1 1360'
    driver usbfs; run 1420; gone "$strike"
    : >"$w/calls"; driver ''
    # Never for a NIC the kernel or USBGuard does not allow, nor an odd role, nor a stopped wan.
    for fault in unauthorized disallowed required stopped inhibit busy; do
        case $fault in
        unauthorized) echo 0 >"$w/sys/1-2/authorized" ;;
        disallowed) : >"$w/allowed" ;;
        required) echo "$role" | sed 's/"false"/"true"/' >"$w/role" ;;
        stopped) echo Stopped >"$w/status" ;;
        inhibit) inhibit=1 ;;
        busy) busy=1 ;;
        esac
        run 1500; run 1560; is "$w/calls" ''
        case $fault in
        # Inhibited, the loss stays reported; locked out, the strike waits for the lock.
        inhibit) gone "$strike"; reported ;;
        busy) is "$strike" 'S1 1500'; if reported; then exit 1; fi ;;
        *) gone "$strike"; if reported; then exit 1; fi ;;
        esac
        inhibit=0 busy=0
        echo Running >"$w/status"; echo "$role" >"$w/role"; echo 1 >"$w/sys/1-2/authorized"
        printf '%s\n' "$allowed" >"$w/allowed"
    done
    # Two runs more than 150 s apart are not in a row.
    run 1700; run 1900; is "$strike" 'S1 1900'; is "$w/calls" ''
    # Re-checked under the lock.
    held=1; run 1960; is "$w/calls" ''
    held=0; driver ''
    # A failed re-add keeps reporting while wan has no role.
    run 2100; add=failed; run 2160
    is "$w/calls" "$(printf 'remove\nadd')"; is "$outcome" 'failed S1'; is "$w/role" null
    run 2220; is "$w/calls" "$(printf 'remove\nadd')"
    reported
    # Three re-attaches an hour (1060, 1180, 2160): a flapping NIC's fourth is refused and reported.
    add=ok; echo "$role" >"$w/role"; driver usbfs; run 2280; gone "$outcome"
    : >"$w/calls"; driver ''; run 2300; run 2360; run 2420
    is "$w/calls" ''; is "$outcome" 'failed S1'
    reported
    # An hour after the first two, one more.
    driver usbfs; run 4700; driver ''; run 4720; run 4780
    is "$w/calls" "$(printf 'remove\nadd')"; is "$outcome" 'healed S1'
    is "$w/run/wired-attempts" "$(printf '2160\n4780')"
    # One skipped minute run (a frozen firewall overran it) keeps the strike.
    driver usbfs; run 4840; gone "$outcome"; : >"$w/calls"; driver ''
    run 4900; run 5020
    is "$w/calls" "$(printf 'remove\nadd')"; is "$outcome" 'healed S1'
)
echo 'observability: wired uplink re-attach and report passed'
# A scan killed outright leaves its scratch directory: a later run prunes it a day on, never a live one.
sed -n "/-name '\.run\.??????' -mmin +1440 /p" "$repo/tools/check" >"$work/prune"
[ -s "$work/prune" ]; sh -n "$work/prune"
(
    state=$work/prune-state
    mkdir -p "$state/.run.OLDOLD" "$state/.run.NEWNEW"
    touch -d '2 days ago' "$state/.run.OLDOLD"
    . "$work/prune"
    [ ! -e "$state/.run.OLDOLD" ] && [ -d "$state/.run.NEWNEW" ]
)
sed -n '/^age() /p; /^auto() {/,/^}/p' "$repo/tools/facts" >"$work/facts-auto"
[ -s "$work/facts-auto" ]; sh -n "$work/facts-auto"
(
    . "$work/facts-auto"
    out=$work/daily; mkdir "$out"
    : >"$out/boot.prom"
    storage() { :; }; hourly() { :; }; boot() { :; }
    daily() { echo due >"$out/due"; }
    stat() { echo 100000; }; date() { echo "$clock"; }; awk() { echo 1; }
    for success in 0 1; do
        echo "cv_collector_success{collector=\"daily\"} $success" >"$out/daily.prom"
        for elapsed in -86400 -1 0 3599 3600 71999 72000; do
            clock=$((100000 + elapsed)); rm -f "$out/due"
            auto
            if [ "$elapsed" -lt 0 ] || [ "$elapsed" -ge 72000 ] || { [ "$success" = 0 ] && [ "$elapsed" -ge 3600 ]; }; then
                grep -qx due "$out/due"
            else [ ! -e "$out/due" ]; fi
        done
    done
    # A failed collection from this boot is retried, then a success is kept.
    clock=100000
    boot() {
        echo called >>"$out/boot-calls"
        echo "cv_collector_success{collector=\"boot\"} $success" >"$out/boot.prom"
    }
    success=0; boot
    success=1; auto
    grep -qx 'cv_collector_success{collector="boot"} 1' "$out/boot.prom"
    [ "$(wc -l <"$out/boot-calls")" = 2 ]
    auto
    [ "$(wc -l <"$out/boot-calls")" = 2 ]
    : >"$out/boot.prom"
    auto
    grep -qx 'cv_collector_success{collector="boot"} 1' "$out/boot.prom"
    [ "$(wc -l <"$out/boot-calls")" = 3 ]
)
# auto waits out the per-minute nts lock instead of skipping its hour.
sed -n '/^case \${1:-} in$/,/^esac$/p' "$repo/tools/facts" >"$work/facts-case"
[ -s "$work/facts-case" ]; sh -n "$work/facts-case"
(
    flock() { echo "$*" >"$work/facts-flock"; }
    auto() { echo ran >"$work/facts-ran"; }
    usage() { exit 2; }
    set -- auto
    . "$work/facts-case"
)
[ "$(cat "$work/facts-flock")" = '-w 60 9' ]
grep -qx ran "$work/facts-ran"
# Boot facts wait on bless's OpenRC marker, bounded at 3 minutes, and read the slots once.
sed -n '/^fact_release() {/,/^}/p' "$repo/tools/facts" |
    sed "s|/run/openrc/started/convergent-bless|$work/blessed|" >"$work/facts-release"
[ -s "$work/facts-release" ]; sh -n "$work/facts-release"
grep -qF "$work/blessed" "$work/facts-release"
(
    . "$work/facts-release"
    m() { echo "$*" >>"$work/release.prom"; }
    bad() { echo "$*" >>"$work/release.bad"; }
    cut() { [ "$*" = '-d. -f1 /proc/uptime' ] || exit 97; echo "$uptime"; }
    slot() {
        [ "$*" = status ] || exit 97
        echo status >>"$work/slot-calls"
        printf 'version 0.1.6\nbooted  7  slot a\nslot a  7  good\ngood    %s\nhighest 7\n' "$good"
    }
    sleep() {
        [ "$*" = 5 ] || exit 97
        naps=$((naps + 1))
        [ "$naps" != "$bless_after" ] || { : >"$work/blessed"; good=7; }
    }
    for sample in blessed late never uptime; do
        rm -f "$work/blessed" "$work/slot-calls" "$work/release.prom" "$work/release.bad"
        naps=0 uptime=30 bless_after=0 good=6
        case $sample in
        blessed) : >"$work/blessed"; good=7 ;;
        late) bless_after=4 ;;
        never) bless_after=-1 ;;
        uptime) uptime=600 ;;
        esac
        fact_release
        [ "$(cat "$work/slot-calls")" = status ] || exit 1
        [ ! -e "$work/release.bad" ] || exit 1
        grep -qx 'cv_booted_info{release="7",slot="a"} 1' "$work/release.prom" || exit 1
        case $sample in
        blessed|uptime) [ "$naps" = 0 ] || exit 1 ;;
        late) [ "$naps" = 4 ] && grep -qx 'cv_release_number{which="good"} 7' "$work/release.prom" || exit 1 ;;
        never) [ "$naps" = 36 ] && grep -qx 'cv_release_number{which="good"} 6' "$work/release.prom" || exit 1 ;;
        esac
    done
)
echo 'observability: scan publication failures, retry intervals and backward clocks passed'
# Check every svc reader before parsing; a failed transfer may still return valid JSON.
grep -qx '>=net-misc/curl-8.4.0' "$repo/portage/sets/convergent"
sed -n '/^poll_alerts() {/,/^}/p' "$repo/tools/bar" >"$work/poll-alerts"
sed -n '/^    ok=1$/,/^    dns=0;/ { /^    dns=0;/q; p; }' "$repo/tools/observe" >"$work/rules-read"
sed -n '/^        probe curl .*100\.80\.2\.10:/p' "$repo/tools/guests" >"$work/guest-reads"
for part in poll-alerts rules-read guest-reads; do [ -s "$work/$part" ]; sh -n "$work/$part"; done
(
    . "$repo/rootfs/usr/lib/convergent/sys/80-security"
    . "$work/poll-alerts"
    vmalert=http://100.80.2.10:8880 now=100000 tmp=$work/rules
    noargs() { [ "$#" = 0 ]; }; cached() { echo unknown; }; usb_count() { echo 0; }
    sudo() { :; }; od() { :; }; logger() { :; }; fail() { return 1; }; probe() { "$@"; }
    setpriv() (
        [ "$1:$2:$3:$4" = '--reuid=65534:--regid=65534:--clear-groups:--no-new-privs' ] || exit 90
        shift 4
        dropped=yes
        "$@"
    )
    curl() {
        [ "$reader" != observe ] || [ "${dropped:-}" = yes ] || exit 90
        printf '%s\n' "$@" >"$work/curl-args"
        case " $* " in *' --max-filesize 1048576 '*) ;; *) exit 90 ;; esac
        case " $* " in *' --max-time 8 '*|*' -m 4 '*|*' --max-time 5 '*) ;; *) exit 90 ;; esac
        case $reader in bar|status|list) grep -qx -- --fail-early "$work/curl-args" || exit 90 ;; esac
        echo bounded >>"$work/curl-called"
        printf '%s\n' '{"status":"success","data":{"alerts":[]}}' '{"status":"success","data":{"groups":[]}}'
        return "$reply"
    }
    prlimit() {
        [ "$1" = --as=134217728 ] || exit 90
        shift
        if [ "$reader" = observe ]; then
            [ "$1" = --fsize=1048576 ] || exit 90
            shift
        fi
        if [ "$reader" = observe ]; then expected_command=setpriv; else expected_command=jq; fi
        [ "$1:$2" = "--:$expected_command" ] || exit 90
        echo limited >"$work/limited"
        [ "$fault" != limit ] || return 1
        shift
        "$@"
    }
    timeout() {
        [ "$1:$2:$3:$4" = '-k:1:8:prlimit' ] || exit 90
        shift 3
        echo bounded >"$work/parser-timeout"
        if [ "$fault" = timeout ]; then echo partial; return 124; fi
        "$@"
    }
    jq() {
        [ "$reader" != observe ] || [ "${dropped:-}" = yes ] || exit 90
        [ -s "$work/limited" ] && [ -s "$work/parser-timeout" ] || exit 90
        cat >/dev/null
        echo parsed >"$work/parsed"
        if [ "$fault" = parser ]; then echo partial; return 1; fi
        echo "$expected"
    }
    for reader in observe bar status list guests; do
        for fault in none transfer timeout parser limit; do
            reply=0; [ "$fault" != transfer ] || reply=63
            rm -f "$work/curl-called" "$work/limited" "$work/parser-timeout" "$work/parsed"
            expected='0 0 0'
            case $reader in status) expected='0 critical, 0 other firing' ;; list) expected='No firing alerts.' ;; esac
            case $reader in
            observe) . "$work/rules-read" >"$work/result" ;;
            bar) poll_alerts; cp "$work/alerts" "$work/result" ;;
            status) security_status >"$work/result" ;;
            list) if security_alert_list >"$work/result" 2>&1; then [ "$fault" = none ]; else [ "$fault" != none ]; fi ;;
            guests) if (set +e; . "$work/guest-reads"); then [ "$fault" != transfer ]; else [ "$fault" = transfer ]; fi ;;
            esac
            [ -s "$work/curl-called" ]
            if [ "$reader" = guests ]; then [ "$(wc -l <"$work/curl-called")" = 2 ] || [ "$fault" = transfer ]; continue; fi
            if [ "$fault" = none ]; then
                [ -s "$work/parsed" ]
                case $reader in
                observe)
                    grep -qx 'cv_collector_success{collector="rules"} 1' "$work/result"
                    grep -qxF "$expected" "$work/result" ;;
                *) grep -qF "$expected" "$work/result" ;;
                esac
            else
                case $fault in transfer|limit|timeout) [ ! -e "$work/parsed" ] ;; esac
                case $reader in
                observe)
                    grep -qx 'cv_collector_success{collector="rules"} 0' "$work/result"
                    if grep -qx partial "$work/result"; then exit 1; fi ;;
                bar) grep -qx '?' "$work/result" ;;
                status) grep -qx 'Alerts: unknown' "$work/result" ;;
                list) grep -q 'Alert evaluation failure' "$work/result" ;;
                esac
            fi
            [ ! -e "$tmp.rules" ]
        done
    done
)
echo 'observability: svc response caps, transfer errors and parser limits passed'
# Small rule replies must not amplify into published or unbounded scratch output.
if command -v jq >/dev/null 2>&1 && command -v prlimit >/dev/null 2>&1; then
    sed "s|/usr/lib/convergent/monitoring.jq|$repo/rootfs/usr/lib/convergent/monitoring.jq|" "$work/rules-read" >"$work/rules-real"
    sh -n "$work/rules-real"
    (
        now=100000 tmp=$work/rules
        logger() { :; }
        curl() { cat "$work/reply"; }
        # Privilege ordering is covered above; keep these parser fixtures rootless. prlimit execs
        # setpriv as a program, so the stand-in is an executable outside the noexec /tmp.
        shim=$(mktemp -d /var/tmp/observability-shim.XXXXXX)
        trap 'rm -rf "$shim"' 0
        printf '#!/bin/sh\nshift 4\nexec "$@"\n' >"$shim/setpriv"
        chmod 0755 "$shim/setpriv"
        PATH=$shim:$PATH
        setpriv() { shift 4; "$@"; }
        rm() {
            [ ! -f "$tmp.rules" ] || [ "$(wc -c <"$tmp.rules")" -le 1048576 ] || exit 1
            command rm "$@"
        }
        for sample in valid amplified malformed; do
            jq -n --arg sample "$sample" '
                {status:"success",data:{groups:[{name:(if $sample == "amplified" then "x" * 2048 else "fixture" end),interval:60,
                rules:[{health:"ok",lastEvaluation:"1970-01-02T03:46:40Z",alerts:
                [range(if $sample == "amplified" then 1024 else 1 end) |
                {state:"firing",labels:{alertname:"fixture"},activeAt:"1970-01-02T03:46:40Z"}]}]}]}}' >"$work/reply"
            [ "$sample" != malformed ] || printf '{' >>"$work/reply"
            [ "$(wc -c <"$work/reply")" -lt 1048576 ]
            . "$work/rules-real" >"$work/result"
            [ ! -e "$tmp.rules" ]
            if [ "$sample" = valid ]; then
                grep -qx 'cv_collector_success{collector="rules"} 1' "$work/result"
                grep -q '^cv_alert_active_since_seconds{' "$work/result"
            else
                grep -qx 'cv_collector_success{collector="rules"} 0' "$work/result"
                if grep -q '^cv_rules_\|^cv_alert_' "$work/result"; then exit 1; fi
            fi
        done
    )
    echo 'observability: rule output cap and complete publication passed'
else
    echo 'observability: SKIP rule output cap fixtures (jq or prlimit is unavailable)' >&2
fi
# Maintenance publishes healing even when a full scan owns the report lock.
(
    state=$work/merge
    mkdir "$state" "$state/run"
    sed -n '/^if .*auto.*then ($/,/^); fi$/p' "$repo/tools/check" |
        sed -n '/^    exec 8>&-$/,$p' | sed '$d' |
        sed "s|/run/convergent/|$state/run/|g" >"$work/merge-script"
    [ -s "$work/merge-script" ]
    sh -n "$work/merge-script"
    if grep -q /run/convergent "$work/merge-script"; then exit 1; fi
    die() { echo "$*" >&2; exit 1; }
    flock() {
        [ "$*" = '-n 9' ] || exit 1
        [ -f "$state/firewall-heal" ] || exit 1
        if ( : >&8 ) 2>/dev/null; then exit 1; fi
        [ "$sample" != busy ] || return 1
        : >"$state/locked"
    }
    sed() {
        [ -f "$state/locked" ] || exit 1
        command sed "$@"
    }
    # The audited directory is written only by cp and mv; an unchanged minute writes nothing there.
