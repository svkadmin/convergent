#!/bin/sh
# Offline observability fixtures; no guest, network, root or signing key is required.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
# Maintenance publishes healing even when a full scan owns the report lock.
(
    state=$work/merge
    mkdir "$state"
    sed -n '/^if .*auto.*then ($/,/^); fi$/p' "$repo/tools/check" |
        sed -n '/^    exec 8>&-$/,$p' | sed '$d' |
        sed "s|/run/convergent/check.lock|$state/check.lock|" >"$work/merge-script"
    [ -s "$work/merge-script" ]
    sh -n "$work/merge-script"
    die() { echo "$*" >&2; exit 1; }
    flock() {
        [ "$*" = '-n 9' ] || exit 1
        [ -f "$state/firewall-heal" ] || exit 1
        if ( : >&8 ) 2>/dev/null; then exit 1; fi
        [ "$sample" = free ] || return 1
        : >"$state/locked"
    }
    sed() {
        [ -f "$state/locked" ] || exit 1
        command sed "$@"
    }
    for sample in busy free; do
        printf 'FAIL new scan\nSELF-HEAL old\n' >"$state/last"
        touch -t 202001010000 "$state/last"
        cp -p "$state/last" "$state/before"
        echo 'SELF-HEAL current' >"$state/.firewall-heal"
        (exec 8>"$state/guests.lock"; . "$work/merge-script")
        grep -qx 'SELF-HEAL current' "$state/firewall-heal"
        [ "$(stat -c %Y "$state/last")" = "$(stat -c %Y "$state/before")" ]
        case $sample in
        busy) cmp "$state/before" "$state/last"; [ ! -e "$state/.last" ] ;;
        free)
            printf 'FAIL new scan\nSELF-HEAL current\n' >"$state/expected"
            cmp "$state/expected" "$state/last" ;;
        esac
    done
)
echo 'observability: maintenance report lock and timestamp assertions passed'
# Quotas stay in userspace; the alert reads actual qgroup usage, not statfs.
[ ! -e "$repo/portage/patches/sys-kernel/gentoo-kernel/0001-btrfs-qgroup-statfs.patch" ]
for service in logs metrics; do
    sed -n '/^command_args=/,/"$/p' "$repo/guests/svc/rootfs/etc/init.d/victoria-$service" >"$work/args"
    [ -s "$work/args" ]
    sh -n "$work/args"
    . "$work/args"
    printf '%s\n' $command_args >"$work/flags"
    case $service in logs) days=7d ;; *) days=14d ;; esac
    grep -qxF -- "-retentionPeriod=$days" "$work/flags"
    if [ "$service" = logs ]; then
        grep -qxF -- '-retention.maxDiskSpaceUsageBytes=2GiB' "$work/flags"
        grep -qxF -- '-storage.minFreeDiskSpaceBytes=1GiB' "$work/flags"
    else
        grep -qxF -- '-storage.minFreeDiskSpaceBytes=512MiB' "$work/flags"
    fi
done
sed -n '/^[[:space:]]*for volume in svc-metrics /,/^[[:space:]]*publish storage storage/ {
    /^[[:space:]]*publish storage storage/d; p;
}' "$repo/tools/facts" >"$work/volumes"
[ -s "$work/volumes" ]
sh -n "$work/volumes"
(
    bad() { ok=0; }
    btrfs() {
        case $* in
        'inspect-internal rootid '*) echo 123 ;;
        'qgroup show --raw -r '*)
            [ "$sample" != unavailable ] || return 1
            echo 'qgroupid rfer excl max_rfer'
            echo '0/999 999 999 1000'
            echo "0/123 $used 0 $limit"
            ;;
        *) return 1 ;;
        esac
    }
    for sample in low boundary high malformed unavailable; do
        used=850 limit=1000 ok=1
        case $sample in low) used=849 ;; high) used=851 ;; malformed) limit=none ;; esac
        buf=$work/volumes.prom
        : >"$buf"
        . "$work/volumes"
        case $sample in
        malformed|unavailable) [ "$ok" = 0 ] && [ ! -s "$buf" ] ;;
        *)
            [ "$ok" = 1 ]
            : >"$work/expected"
            for volume in svc-metrics svc-logs svc-grafana; do
                printf 'cv_volume_used_bytes{volume="%s"} %s\ncv_volume_limit_bytes{volume="%s"} 1000\n' \
                    "$volume" "$used" "$volume" >>"$work/expected"
            done
            cmp "$work/expected" "$buf"
            ;;
        esac
    done
)
sed -n '/- alert: VolumeQuotaHigh/{n;p;n;p;}' \
    "$repo/guests/svc/rootfs/etc/vmalert/alerts.yaml" >"$work/quota-rule"
grep -qx '        expr: cv_volume_used_bytes / cv_volume_limit_bytes > 0.85' "$work/quota-rule"
grep -qx '        for: 10m' "$work/quota-rule"
echo 'observability: svc qgroup collection and high-usage alert assertions passed'
# Failed self-heal appends must preserve the complete report and its scan time.
sed -n '/^    if \[ -f "\$state\/last" \]; then$/,/^    fi$/p' "$repo/tools/check" >"$work/report-update"
[ -s "$work/report-update" ]
sh -n "$work/report-update"
mkdir "$work/report-state"
for failed in sed cat touch mv none; do
    (
        state=$work/report-state
        printf 'complete scan\nSELF-HEAL old\n' >"$state/last"
        touch -t 200101010000 "$state/last"
        cp -p "$state/last" "$work/previous"
        echo 'SELF-HEAL new' >"$state/firewall-heal"
        die() { exit 1; }
        sed() { if [ "$failed" = sed ]; then echo partial; return 1; fi; command sed "$@"; }
        cat() { if [ "$failed" = cat ]; then echo partial; return 1; fi; command cat "$@"; }
        touch() { [ "$failed" != touch ] && command touch "$@"; }
        mv() { [ "$failed" != mv ] && command mv "$@"; }
        if (set +e; . "$work/report-update"); then
            [ "$failed" = none ]
            printf 'complete scan\nSELF-HEAL new\n' >"$work/expected"
            cmp "$work/expected" "$state/last"
        else
            [ "$failed" != none ]
            cmp "$work/previous" "$state/last"
        fi
        [ ! -e "$state/.last" ]
        [ "$(stat -c %Y "$state/last")" = "$(stat -c %Y "$work/previous")" ]
    )
done
echo 'observability: failed report writes preserve last and mtime'
# Scrub evidence and its missing-record grace survive short boots.
sed -n '/^[[:space:]]*uuid=$(findmnt/,/^[[:space:]]*for volume / {
    /^[[:space:]]*for volume /d; p;
}' "$repo/tools/facts" | sed "s|/var/lib/btrfs|$work/btrfs|g" >"$work/scrub"
sh -n "$work/scrub"
mkdir "$work/btrfs" "$work/state"
(
    sdir=$work/state
    findmnt() { echo fixture; }
    date() { echo "$clock"; }
    m() { echo "$*" >>"$buf"; }
    bad() { ok=0; }
    collect() {
        (ok=1; buf=$work/scrub.prom; : >"$buf"; . "$work/scrub"; echo "$ok" >"$work/scrub.ok")
    }
    clock=100000
    collect
    grep -qx 'cv_btrfs_scrub_missing_since_seconds 100000' "$work/scrub.prom"
    clock=200000
    collect
    grep -qx 'cv_btrfs_scrub_missing_since_seconds 100000' "$work/scrub.prom"
    [ "$(cat "$work/scrub.ok")" = 1 ]
    for value in bad 0 300000 999999999999999999999; do
        echo "$value" >"$sdir/scrub-missing.fixture"
        collect
        grep -qx 'cv_btrfs_scrub_missing_since_seconds 0' "$work/scrub.prom"
        [ "$(cat "$work/scrub.ok")" = 0 ]
    done
    for value in 0 1 bad missing; do
        row='fs:1|t_start:100000|finished:1|canceled:0|uncorrectable_errors:0|read_errors:0|csum_errors:0|verify_errors:0'
        [ "$value" = missing ] || row="$row|super_errors:$value"
        printf 'scrub status:1\n%s\n' "$row" >"$work/btrfs/scrub.status.fixture"
        collect
        grep -qx 'cv_btrfs_scrub_recorded 1' "$work/scrub.prom"
        [ ! -e "$sdir/scrub-missing.fixture" ]
        case $value in
        0|1) grep -qx "cv_btrfs_scrub_errors $value" "$work/scrub.prom"; [ "$(cat "$work/scrub.ok")" = 1 ] ;;
        *) [ "$(cat "$work/scrub.ok")" = 0 ]; if grep -q '^cv_btrfs_scrub_errors ' "$work/scrub.prom"; then exit 1; fi ;;
        esac
    done
    rm "$work/btrfs/scrub.status.fixture"
    collect
    grep -qx 'cv_btrfs_scrub_missing_since_seconds 200000' "$work/scrub.prom"
)
rules=$repo/guests/svc/rootfs/etc/vmalert/alerts.yaml
sed -n '/- alert: ScrubNeedsAttention/{n;p;}' "$rules" >"$work/scrub-rule"
grep -q 'cv_btrfs_scrub_missing_since_seconds > time() - 86400' "$work/scrub-rule"
if grep -q node_boot_time_seconds "$work/scrub-rule"; then exit 1; fi
sed -n '/- alert: BlocklistStale/{n;p;}' "$rules" >"$work/blocklist-rule"
grep -q 'time() - convergent_dns_source_refreshed_seconds.* > 864000' "$work/blocklist-rule"
grep -q 'unless on(node) convergent_dns_source_refreshed_seconds' "$work/blocklist-rule"
grep -q 'convergent_dns_source_refreshed_seconds.* <= 0' "$work/blocklist-rule"
grep -q 'convergent_dns_source_refreshed_seconds.* > time()' "$work/blocklist-rule"
echo 'observability: scrub superblock, persistent grace and alert assertions passed'
# Run the checker's reads with successful and timed-out replies, including partial output.
sed -n '/^# The management endpoint/,/^\/usr\/local\/sbin\/incus-ui/ {
    /^\/usr\/local\/sbin\/incus-ui/d; p;
}' "$repo/tools/check" >"$work/reads"
sed -n '/^\(timeout -k 1 30 \)\{0,1\}incus --force-local \(list \|query \)/p;
    /^\(timeout -k 1 30 \)\{0,1\}guests status /p' "$repo/tools/check" >>"$work/reads"
sh -n "$work/reads"
(
    bad() { failures=$((failures + 1)); }
    incus() {
        case $* in
        *core.https_address) echo 100.80.1.10:8443 ;;
        *core.metrics_address) echo 100.80.1.10:8444 ;;
        *) echo '[]' ;;
        esac
    }
    guests() { echo 'svc running'; }
    timeout() {
        [ "$1:$2:$3" = '-k:1:30' ] || exit 1
        shift 3
        echo read >>"$work/timeouts"
        "$@"
        return "$reply"
    }
    for reply in 0 124; do
        : >"$work/timeouts"
        failures=0
        . "$work/reads"
        [ "$(wc -l <"$work/timeouts")" = 6 ]
        if [ "$reply" = 0 ]; then [ "$failures" = 0 ]; else [ "$failures" = 6 ]; fi
    done
)
sed -n '/^    kib=0$/,/^    for pid / { /^    for pid /d; p; }' "$repo/tools/check" |
    sed "s|/sys/fs/cgroup|$work/cgroup|g" >"$work/memory"
sh -n "$work/memory"
mkdir -p "$work/cgroup/lxc.payload.def"
echo 10240 >"$work/cgroup/lxc.payload.def/memory.current"
for shared in 0 4096; do
    printf 'file 8192\nanon 2048\nshmem %s\n' "$shared" >"$work/cgroup/lxc.payload.def/memory.stat"
    . "$work/memory"
    [ "$kib" = "$((2 + shared / 1024))" ]
done
echo 17179869184 >"$work/cgroup/lxc.payload.def/memory.current"
printf 'file 12884901888\nshmem 8589934592\n' >"$work/cgroup/lxc.payload.def/memory.stat"
. "$work/memory"
[ "$kib" = 12582912 ]
rm "$work/cgroup/lxc.payload.def/memory.stat"
. "$work/memory"
[ "$kib" = 16777216 ]
echo 'observability: bounded checker reads and shared memory fixtures passed'
# Owner inventory reads must bound partial replies and leave lock fds in the parent.
for tool in devices remote; do
    sed -n '/^[[:space:]]*instances\{0,1\}=$(.*incus --force-local query /p' "$repo/tools/$tool" >"$work/owner-read"
    [ "$(wc -l <"$work/owner-read")" = 1 ]
    sh -n "$work/owner-read"
    for reply in 0 124; do
        rc=0
        cat >"$work/owner-probe" <<'OWNER'
            exec 9>"$work/lock9" 6>"$work/lock6" 8>"$work/lock8"
            die() { exit 1; }
            incus() { echo '{"partial":true}'; }
            timeout() {
                [ "$1:$2:$3" = '-k:1:30' ] || exit 90
                if (: >&9) 2>/dev/null; then exit 90; fi
                if [ "$tool" = remote ]; then
                    if (: >&6) 2>/dev/null; then exit 90; fi
                    if (: >&8) 2>/dev/null; then exit 90; fi
                fi
                shift 3
                echo bounded >"$work/bounded"
                "$@"
                return "$reply"
            }
            . "$work/owner-read"
            echo retained >&9
            echo retained >&6
            echo retained >&8
            echo continued >"$work/continued"
OWNER
        sh -n "$work/owner-probe"
        export work tool reply
        sh -eu "$work/owner-probe" || rc=$?
        [ -f "$work/bounded" ]
        if [ "$reply" = 0 ]; then
            [ "$rc" = 0 ] && [ -f "$work/continued" ]
            for fd in 9 6 8; do grep -qx retained "$work/lock$fd"; done
        else
            [ "$rc" != 0 ] && [ ! -e "$work/continued" ]
        fi
        rm -f "$work/bounded" "$work/continued"
    done
done
echo 'observability: bounded owner reads and lock descriptors passed'
# Exercise Settings' actual formatter with cache-only guest counts.
sed -n '/^	function get(path, value) {/,/^	}'"'"' \/sys/ {
    /^	}'"'"' \/sys/d; p;
}' "$repo/tools/sys" | sed "s|/proc/meminfo|$work/meminfo|g" >"$work/dashboard.awk"
echo '}' >>"$work/dashboard.awk"
mkdir "$work/status" "$work/header"
printf 'MemTotal: 16777216 kB\nMemFree: 1048576 kB\nMemAvailable: 8388608 kB\n' >"$work/meminfo"
echo 'fw1=master fw2=backup' >"$work/status/topology"
format() {
    SYS_GUESTS=unknown SYS_DISK= awk -v st="$work/status" -v out="$work/header" \
        -v now=1000 -v mtime="$1" -v memtime="$1" -v owner=test -v kernel=test -v blessed=good \
        -f "$work/dashboard.awk"
}
echo 4194304 >"$work/status/guestmem"
for remote in true false; do
    printf 'true\ttrue\ttrue\ttrue\t2\t%s\n' "$remote" >"$work/status/.running"
    format 1000
    grep -qx 'RAM: 4.0/16.0 GiB (host)' "$work/header/header"
    count=6
    [ "$remote" != true ] || count=7
    grep -qx "Guests: $count/? running; master: fw1" "$work/header/header"
done
echo 12582912 >"$work/status/guestmem"
format 1000
grep -qx 'RAM: 0.0/16.0 GiB (host)' "$work/header/header"
for stamp in 819 1001; do
    format "$stamp"
    grep -qx 'RAM: ?/16.0 GiB (host)' "$work/header/header"
    grep -qx 'Guests: ?/? running; master: ?' "$work/header/header"
done
for row in 'true true true true 2' 'true true true true bad false'; do
    echo "$row" >"$work/status/.running"
    format 1000
    grep -qx 'Guests: ?/? running; master: fw1' "$work/header/header"
done
echo 'observability: Settings memory and cached guest counts passed'
if command -v jq >/dev/null 2>&1; then
    (
        . "$repo/rootfs/usr/lib/convergent/sys/80-security"
        noargs() { [ "$#" = 0 ]; }
        cached() { echo unknown; }
        usb_count() { echo 0; }
        sudo() { :; }
        od() { :; }
        curl() { printf '%s\n' '{"status":"success","data":{"alerts":[]}}' "$rules"; }
        for sample in fresh stale future missing malformed unhealthy; do
            rules=$(jq -nc --arg sample "$sample" '
                {status:"success",data:{groups:[{interval:30,rules:[{
                    health:(if $sample == "unhealthy" then "err" else "ok" end),
                    lastEvaluation:((now + (if $sample == "stale" then -151 elif $sample == "future" then 120 else 0 end)) | todateiso8601)
                }]}]}} |
                if $sample == "missing" then del(.data.groups[0].rules[0].lastEvaluation)
                elif $sample == "malformed" then .data.groups[0].rules[0].lastEvaluation = "bad" else . end')
            if [ "$sample" = fresh ]; then
                [ "$(security_alert_list)" = 'No firing alerts.' ]
                security_status >"$work/security"
                grep -qx 'Alerts: 0 critical, 0 other firing' "$work/security"
            else
                if security_alert_list >"$work/security" 2>&1; then exit 1; fi
                grep -q 'Alert evaluation failure' "$work/security"
                security_status >"$work/security" 2>/dev/null
                grep -qx 'Alerts: unknown' "$work/security"
            fi
        done
    )
    echo 'observability: owner alert freshness passed'
else
    echo 'observability: SKIP owner alert freshness (jq is unavailable)'
fi
sh "$repo/guests/wan/test-diag"
sh "$repo/guests/fw/test-facts"
# Alpine's sysctl init checks -f before skipping the vendor file.
target=$work/sysctl
root=$target
mkdir -p "$target/etc/sysctl.d"
for guest in wan svc; do
    sed -n '/^: >"\$.*\/etc\/sysctl.d\/00-alpine.conf"$/p' "$repo/guests/$guest/build" >"$work/override"
    [ -s "$work/override" ]
    . "$work/override"
    [ -f "$target/etc/sysctl.d/00-alpine.conf" ] && [ ! -s "$target/etc/sysctl.d/00-alpine.conf" ]
    rm "$target/etc/sysctl.d/00-alpine.conf"
done
python3 - "$repo" "$work" <<'PY'
import contextlib, importlib, io, json, re, shlex, shutil, subprocess, sys
from pathlib import Path
repo, work = map(Path, sys.argv[1:])
source = (repo / 'build/advisories').read_text().split("<<'PY'\n", 1)[1].split('\nPY\n', 1)[0]
scope = {}
exec(compile(source.split('\nmode, *args =', 1)[0], 'advisories', 'exec'), scope)
scope['selftest']()

def awk(path, data):
    result = subprocess.run(['awk', '-f', str(repo / path)], input=data, text=True, capture_output=True, check=True)
    return result.stdout

fw = 'guests/fw/site/usr/local/libexec/convergent/'
output = awk(fw + 'interface-bytes.awk', 'Name Mtu Network Address Ibytes Obytes\n'
             'vio2 1500 <Link> aa:bb 123 456\nvio2 1500 100.80.1/28 100.80.1.2 123 456\n'
             'vlan370* 1500 <Link> aa:bb 789 999\n')
assert output.count('carpdev="vio2"') == 2 and 'carpdev="vlan370"} 789' in output
output = awk(fw + 'wan-probe.awk', '3 packets transmitted, 2 packets received, 33.3% packet loss\n'
             'round-trip min/avg/max/std-dev = 0.300/1.500/2.700/0.100 ms\n')
assert 'loss_ratio 0.333000' in output and 'rtt_seconds 0.001500' in output
assert 'rtt_seconds' not in awk(fw + 'wan-probe.awk', '3 packets transmitted, 0 packets received, 100.0% packet loss\n')
header = 'Oct 26 12:34:56.000001 rule 1/(match) block in on vio4: 100.80.3.10.123 > 1.1.1.1.443: S\n'
output = awk(fw + 'pflog-rate.awk', header * 8 + header.replace('12:34:56', '12:34:57'))
assert output.count('rule 1') == 6 and 'suppressed=3' in output
assert awk(fw + 'pflog-rate.awk', 'unrecognized\n') == ''
output = awk('guests/wan/rootfs/usr/local/lib/wan-radio.awk', '\tsignal: -54 dBm\n\ttx bitrate: 144.4 MBit/s\n\trx bitrate: 72.2 MBit/s\n')
assert 'signal_dbm -54' in output and 'direction="tx"} 144400000' in output
assert awk('guests/wan/rootfs/usr/local/lib/wan-radio.awk', 'Not connected.\n') == ''
capture = (repo / 'tools/firewall-capture').read_text()
registry = capture.split('awk -v segment="$1" \'', 1)[1].split("' \"$registry\"", 1)[0]
for text, code in [('dom-dev-a carp6 vlan320 7\n', 0), ('carp6 7 vlan320 dom-dev-a\n', 0),
                   ('dom-dev-b carp6 vlan320 7\n', 1), ('dom-dev-a carp6 vlan320\ndom-dev-a carp7 vlan330\n', 1)]:
    result = subprocess.run(['awk', '-v', 'segment=dom-dev-a', registry], input=text, text=True, capture_output=True)
    assert result.returncode == code
    if code == 0:
        assert result.stdout.strip() == 'vlan320'
listing = (repo / 'build/advisories-publish').read_text().split("<<'PY'\n", 1)[1].split('\nPY\n', 1)[0]
xml = work / 'list.xml'
xml.write_text('<ListBucketResult xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><IsTruncated>false</IsTruncated>'
               '<Contents><Key>beta/42/manifest</Key></Contents><Contents><Key>beta/42/guests.manifest</Key></Contents>'
               '<Contents><Key>stable/43/manifest</Key></Contents></ListBucketResult>')
result = subprocess.run([sys.executable, '-c', listing, str(xml), 'beta'], text=True, capture_output=True, check=True)
assert result.stdout.strip() == '42 1 0'
valid = xml.read_text()
for extra, expected in [('<Contents><Key>beta/42/remmina.manifest</Key></Contents>', '42 1 1'),
                        ('<Contents><Key>beta/41/manifest</Key></Contents>', '41 0 0\n42 1 0')]:
    xml.write_text(valid.replace('</ListBucketResult>', extra + '</ListBucketResult>'))
    result = subprocess.run([sys.executable, '-c', listing, str(xml), 'beta'], text=True, capture_output=True, check=True)
    assert result.stdout.strip() == expected
for invalid in [valid.replace('false', 'true'),
                valid.replace('beta/42/manifest', 'beta/debug/manifest'),
                valid.replace('beta/42/manifest', 'beta/43/manifest'),
                valid.replace('guests.manifest', 'remmina.manifest')]:
    xml.write_text(invalid)
    assert subprocess.run([sys.executable, '-c', listing, str(xml), 'beta'], capture_output=True).returncode != 0

sys.path.insert(0, str(repo / 'guests/svc/dashboards'))
network = importlib.import_module('network').generate()
security = importlib.import_module('security').generate()
overview = importlib.import_module('overview').generate()
panels = {p['title']: p for p in overview['panels']}
assert 'cv_https_probe_available == 1' in panels['Network']['targets'][0]['expr']
assert '2 * (count(cv_alert_active_since_seconds{alertname="CheckerFailed",severity="critical"}) or vector(0))' in panels['Security / Updates']['targets'][0]['expr']
columns = panels['Active alerts - explanations']['transformations'][1]['options']['includeByName']
assert columns['exported_node'] and 'node' not in columns
dashlib = importlib.import_module('dashlib')
assert 'AND (' + dashlib.QUIET + ' OR _msg:~"key=.(identity|usb|guestkeys).")' in dashlib.SECURITY_EVENTS
if shutil.which('jq'):
    check_data = (repo / 'guests/svc/dashboards/check-data').read_text()
    gate = check_data.split('def_stopped=false\n', 1)[1].split('# A just-restarted', 1)[0]
    query = check_data.split('--argjson def_stopped "$def_stopped" \'', 1)[1].split("' \"$dir/\"", 1)[0]
    for fixture, state, optional in [('guests', 'Stopped', True), ('guests', 'Running', False), ('', 'Stopped', False)]:
        mocks = 'timeout() { shift 3; "$@"; }; incus() { printf \'%s\\n\' \'[{"name":"def","status":"' + state + '"}]\'; };\n'
        result = subprocess.run(['sh', '-s', '--', 'unused', 'unused', fixture],
                                input='set -eu\nwork=' + shlex.quote(work.as_posix()) + '\ndef_stopped=false\n' + mocks + gate + '\necho "$def_stopped"\n',
                                text=True, capture_output=True, check=True)
        rows = subprocess.run(['jq', '-r', '--arg', 'fixture', fixture, '--argjson', 'def_stopped', result.stdout.strip(), query],
                              input=json.dumps(overview), text=True, capture_output=True, check=True).stdout
        fields = next(line.split('\t') for line in rows.splitlines() if line.split('\t')[1] == 'Network')
        assert (fields[3] != 'required') == optional
        if optional:
            assert 'def is not running' in fields[3]
        assert all(line.split('\t')[3] == 'required' for line in rows.splitlines() if line.split('\t')[1] in ('Guests', 'Host', 'Monitoring'))
