#!/bin/sh
# Exercise the production query helper and browser service selection without Incus.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
sh "$here/test-browser-url"
# The default portal URL uses the same uplink as portal_lan.
sed -n '/^net_of() {/,/^}/p; /^upstream_net() {/,/^}/p' "$repo/tools/portal" >"$work/portal-net"
[ -s "$work/portal-net" ]
sh -n "$work/portal-net"
. "$work/portal-net"
# The fixture answers directly; production bounds the reply with guest_reply.
guest_reply() { shift; "$@"; }
net=100.80
rsh() {
    [ "$*" = 'wan diag' ] || return 1
    printf '%s\n' '== addresses' 'eth0 100.80.0.10/24' "eth1 ${eth1:-192.168.1.23/24}" \
        'wlan0 10.20.30.42/24' '== routes' "$routes"
    [ "${diag_fail:-0}" = 0 ]
}
routes='default via 100.80.0.1 dev eth0
default via 10.20.30.1 dev wlan0 linkdown
default via 192.168.1.1 dev eth1'
[ "$(upstream_net)" = 192.168.1.0/24 ]
[ "$(upstream_net gateway)" = 192.168.1.1 ]
routes='default via 10.20.30.1 dev wlan0
default via 192.168.1.1 dev eth1'
[ "$(upstream_net)" = 10.20.30.0/24 ]
[ "$(upstream_net gateway)" = 10.20.30.1 ]
for routes in '' 'default dev eth1' 'default via 192.168.1.1 dev eth1 linkdown' \
    'default via 100.80.0.1 dev eth0' 'default via 203.0.113.1 dev eth1' \
    'default via 192.168.1.999 dev eth1' 'default via invalid dev eth1'; do
    if upstream_net gateway; then exit 1; fi
done
# /8../30 outside the internal /16; a /31 or /32 lease says why.
[ "$(net_of 10.23.7.4/8)" = 10.0.0.0/8 ]
[ "$(net_of 100.128.0.1/9)" = 100.128.0.0/9 ]
[ "$(net_of 100.81.0.1/16)" = 100.81.0.0/16 ]
for lease in 10.0.0.1/7 100.23.7.4/8 100.64.0.1/10 100.80.0.0/16 100.80.3.0/24 192.168.1.1/31 192.168.1.1/32; do
    if net_of "$lease"; then exit 1; fi
done
eth1=10.23.7.4/8 routes='default via 10.0.0.1 dev eth1'
[ "$(upstream_net)" = 10.0.0.0/8 ]
[ "$(upstream_net gateway)" = 10.0.0.1 ]
eth1=203.0.113.7/32 routes='default via 203.0.113.1 dev eth1'
if upstream_net gateway 2>"$work/p2p"; then exit 1; fi
grep -qx 'portal: the uplink lease is a /32 without a subnet; portal mode needs /8 to /30' "$work/p2p"
eth1=
routes='default via 192.168.1.1 dev eth1'
diag_fail=1
if upstream_net gateway; then exit 1; fi
diag_fail=0
sed -n '/^portal_mode=$/,/^for url do /p' "$repo/tools/browser" |
    sed 's|/usr/local/sbin/portal gateway|portal gateway|' >"$work/portal-args"
[ -s "$work/portal-args" ]
sh -n "$work/portal-args"
for sample in default unavailable empty invalid extra local normal; do
    rc=0
    (
        die() { echo "$*" >&2; exit 1; }
        portal() {
            [ "$1" = gateway ] || return 1
            echo gateway >>"$work/gateway-calls"
            upstream_net gateway
        }
        : >"$work/gateway-calls"
        role=tmp
        case $sample in
        default) set -- --portal ;;
        unavailable) routes=; set -- --portal ;;
        empty) set -- --portal '' ;;
        invalid) set -- --portal file:///etc/passwd ;;
        extra) set -- --portal http://192.168.1.1/ extra ;;
        local) set -- --portal 'http://192.168.1.1/login?a=1&b=2' ;;
        normal) set -- ;;
        esac
        if [ "${1:-}" = --portal ]; then
            shift
            printf '%s\n' "$#" >"$work/url-input"
            if [ "$#" != 0 ]; then printf '%s' "$1" >>"$work/url-input"; fi
            [ "$#" -le 1 ] || exit 1
            set -- --portal
        else
            printf '0\n' >"$work/url-input"
        fi
        . "$work/portal-args" <"$work/url-input"
        case $sample in
        default)
            [ "$#" = 1 ] && [ "$1" = 'http://192.168.1.1/' ] || exit 1
            [ "$(wc -l <"$work/gateway-calls")" = 1 ] || exit 1 ;;
        local) [ "$#" = 1 ] && [ "$1" = 'http://192.168.1.1/login?a=1&b=2' ] || exit 1 ;;
        normal) [ "$#" = 0 ] || exit 1 ;;
        esac
        [ "$sample" = default ] || [ ! -s "$work/gateway-calls" ]
    ) >"$work/portal-result" 2>&1 || rc=$?
    case $sample in
    default|local|normal) [ "$rc" = 0 ] ;;
    *) [ "$rc" != 0 ] ;;
    esac
    [ "$sample" != unavailable ] || grep -q 'cannot find the uplink gateway' "$work/portal-result"
done
(
    . "$repo/rootfs/usr/lib/convergent/sys/11-portal"
    noargs() { [ "$#" = 0 ]; }
    ask() { echo 'unexpected prompt' >&2; exit 1; }
    browser_start() { printf '%s\n' "$#" "$@" >"$work/portal-start"; }
    portal_on
    printf '%s\n' 2 tmp --portal >"$work/expected"
    cmp "$work/expected" "$work/portal-start"
)
# End portal argument fixtures.
eval "$(sed -n '/^ic() {/,/^}/p' "$repo/tools/incus-ui")"
timeout() { [ "$1 $2 $3" = '-k 1 30' ] || exit 97; shift 3; "$@"; }
incus() {
    printf '%s\n' "$*" >>"$work/calls"
    [ "$1" = --force-local ]; shift
    case $1 in
    query) [ "$#" = 2 ] && [ "$2" = '/1.0/instances?recursion=1&project=default' ] ;;
    --project) [ "$2 $3 $4" = 'default stop int' ] ;;
    *) return 1 ;;
    esac
}
ic query '/1.0/instances?recursion=1&project=default'
ic stop int
[ "$(wc -l <"$work/calls")" = 2 ]
sed -n '/^if \[ "$role" = int \] \&\& \[ -z "$incus_ui" \]; then/,/^fi/p' "$repo/tools/browser" >"$work/grafana"
[ -s "$work/grafana" ]
ic() { echo "$*" >>"$work/grafana-calls"; return 1; }
role=int incus_ui=1
. "$work/grafana"
[ ! -e "$work/grafana-calls" ]
ic() { echo "$*" >>"$work/grafana-calls"; }
# Grafana start and stop in svc are bounded: a stuck svc must not keep the session locks.
timeout() { echo "timeout $1 $2 $3" >>"$work/grafana-calls"; [ "$1 $2 $3" = '-k 1 60' ]; shift 3; "$@"; }
incus() { [ "$1 $2 $3" = '--force-local --project default' ] || exit 97; shift 3; ic "$@"; }
incus_ui=
. "$work/grafana"
printf '%s\n' 'config set svc limits.memory=768MiB' 'timeout -k 1 60' 'exec svc -- rc-service grafana start' >"$work/expected"
cmp "$work/expected" "$work/grafana-calls"
sed -n '/^    if \[ -n "\$grafana" \]; then$/,/^    fi$/p' "$repo/tools/browser" >"$work/grafana-stop"
[ -s "$work/grafana-stop" ]
sh -n "$work/grafana-stop"
for sample in ok stuck; do
    : >"$work/grafana-calls"
    ic() { echo "$*" >>"$work/grafana-calls"; [ "$sample:$1" != stuck:exec ]; }
    grafana=1 result=0
    . "$work/grafana-stop"
    case $sample in
    ok) [ "$result" = 0 ]
        printf '%s\n' 'timeout -k 1 60' 'exec svc -- rc-service grafana stop' 'config set svc limits.memory=350MiB' >"$work/expected" ;;
    stuck) [ "$result" = 1 ]
        printf '%s\n' 'timeout -k 1 60' 'exec svc -- rc-service grafana stop' >"$work/expected" ;;
    esac
    cmp "$work/expected" "$work/grafana-calls"
done
unset -f timeout incus
# A running int left by a killed Grafana launcher must not block incus-ui open; the role check stops it before unlock.
sed -n '/^if \[ "$role" = int \]; then$/,/^fi$/p' "$repo/tools/browser" |
    sed 's|/usr/local/sbin/incus-ui|incus_ui_call|' >"$work/int-open"
[ -s "$work/int-open" ]
sh -n "$work/int-open"
(
    die() { echo "$*" >&2; exit 1; }
    incus_ui_call() { echo "$*" >>"$work/int-calls"; }
    instances_json() { echo '[{"name":"int","status":"Running","type":"container","profiles":["browser-base","browser-int"]}]'; }
    role=int incus_ui=1
    . "$work/int-open"
    grep -qx -- --close "$work/int-calls"
)
awk '/^    stop_container$/ {stop = NR} /^    \/usr\/local\/sbin\/incus-ui --unlock / {unlock = NR}
    END {exit !(stop && unlock > stop)}' "$repo/tools/browser"
# Incus administration rebuilds an existing int from the installed image before it starts; Grafana does not.
# A rebuild cut off by its timeout keeps the locks until Incus ends it (bounded), then dies.
sed -n '/^if printf .*"\$instances" | jq -e --arg n "\$name" .any/,/^fi$/p' "$repo/tools/browser" >"$work/existing"
grep -qF 'if [ -n "$incus_ui" ] && ! ic rebuild candidate-browser "$name"; then' "$work/existing"
sh -n "$work/existing"
for sample in ui grafana fail stuck; do
    rm -f "$work/existing-calls"
    rc=0
    (
        die() { echo "die $*" >>"$work/existing-calls"; exit 1; }
        timeout() { exit 97; }
        incus() { exit 97; }
        ic() { echo "$*" >>"$work/existing-calls"; case $sample:$1 in fail:rebuild|stuck:rebuild) return 124 ;; esac; }
        operations_done() {
            [ "$1" = int ] || exit 97
            echo ops >>"$work/existing-calls"
            [ "$sample" = fail ] && [ "$(grep -cx ops "$work/existing-calls")" -ge 3 ]
        }
        sleep() { [ "$*" = 5 ] || exit 97; echo sleep >>"$work/existing-calls"; }
        stop_container() { echo stop >>"$work/existing-calls"; }
        instances='[{"name":"int","status":"Running","type":"container","profiles":["browser-base","browser-int"]}]'
        name=int profile_base=browser-base profile_role=browser-int incus_ui=1
        [ "$sample" != grafana ] || incus_ui=
        . "$work/existing"
    ) || rc=$?
    case $sample in
    ui) [ "$rc" = 0 ]; printf 'stop\nrebuild candidate-browser int\n' >"$work/expected" ;;
    grafana) [ "$rc" = 0 ]; printf 'stop\n' >"$work/expected" ;;
    fail) [ "$rc" = 1 ]; printf '%s\n' stop 'rebuild candidate-browser int' ops sleep ops sleep ops \
        'die cannot reset the int browser for Incus administration' >"$work/expected" ;;
    stuck) [ "$rc" = 1 ]
        { printf '%s\n' stop 'rebuild candidate-browser int'
            n=0; while [ "$n" -lt 60 ]; do printf '%s\n' ops sleep; n=$((n + 1)); done
            printf '%s\n' ops 'die cannot reset the int browser for Incus administration'; } >"$work/expected" ;;
    esac
    cmp "$work/expected" "$work/existing-calls"
done
# Only a running operation on that instance (not a namesake prefix) holds the session; no answer is not done.
sed -n '/^operations_done() {/,/^}/p' "$repo/tools/browser" >"$work/operations"
[ -s "$work/operations" ]
sh -n "$work/operations"
(
    . "$work/operations"
    timeout() { [ "$1:$2:$3" = -k:1:30 ] || exit 97; shift 3; "$@"; }
    incus() {
        [ "$*" = '--force-local query /1.0/operations?recursion=1&project=default' ] || exit 97
        [ "$ops" != unanswered ] || return 1
        printf '%s\n' "$ops"
    }
    for sample in running project snapshot namesake success empty none unanswered; do
        case $sample in
        running) ops='{"running":[{"status_code":103,"resources":{"instances":["/1.0/instances/int"]}}]}' ;;
        project) ops='{"running":[{"status_code":105,"resources":{"instances":["/1.0/instances/int?project=default"]}}]}' ;;
        snapshot) ops='{"running":[{"status_code":103,"resources":{"instances":["/1.0/instances/int/snapshots/a"]}}]}' ;;
        namesake) ops='{"running":[{"status_code":103,"resources":{"instances":["/1.0/instances/internal"]}}]}' ;;
        success) ops='{"success":[{"status_code":200,"resources":{"instances":["/1.0/instances/int"]}}]}' ;;
        empty) ops='{}' ;;
        none) ops='{"running":[{"status_code":103,"resources":null}]}' ;;
        unanswered) ops=unanswered ;;
        esac
        if operations_done int; then
            case $sample in namesake|success|empty|none) ;; *) exit 97 ;; esac
        else
            case $sample in running|project|snapshot|unanswered) ;; *) exit 97 ;; esac
        fi
    done
)
# Every browser Incus call is bounded; a first init gets longer.
sed -n '/^ic() {/,/^}/p' "$repo/tools/browser" >"$work/browser-ic"
[ -s "$work/browser-ic" ]
sh -n "$work/browser-ic"
(
    . "$work/browser-ic"
    timeout() { echo "$*" >>"$work/ic-calls"; }
    incus() { exit 97; }
    : >"$work/ic-calls"
    for call in 'init candidate-browser def' 'start def' 'stop def --force' 'rebuild candidate-browser int' 'config set def a=b'; do
        ic $call
    done
    printf '%s\n' '-k 5 300 incus --force-local --project default init candidate-browser def' \
        '-k 5 120 incus --force-local --project default start def' \
        '-k 5 120 incus --force-local --project default stop def --force' \
        '-k 5 120 incus --force-local --project default rebuild candidate-browser int' \
        '-k 5 120 incus --force-local --project default config set def a=b' | cmp - "$work/ic-calls"
)
# Force-close stops only the role's shipped browsers, under the launcher's locks.
sed -n '/^if \[ "\${1:-}" = --close \] && \[ "\$(id -u)" = 0 \]; then$/,/^fi$/p' "$repo/tools/browser" >"$work/close"
[ -s "$work/close" ]
sh -n "$work/close"
cat >"$work/close-instances" <<'JSON'
[
  {"name":"def","status":"Running","type":"container","profiles":["browser-base","browser-def"]},
  {"name":"int","status":"Stopped","type":"container","profiles":["browser-base","browser-int"]},
  {"name":"tmp-20","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-21","status":"Stopped","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-portal","status":"Frozen","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-30","status":"Running","type":"container","profiles":["default"]},
  {"name":"tmp-200","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"def2","status":"Running","type":"container","profiles":["browser-base","browser-def"]}
]
JSON
for sample in def int tmp usage locked failed; do
    : >"$work/close-calls"
    rc=0
    (
        set -- --close "$sample"
        case $sample in usage) set -- --close remmina ;; locked) set -- --close def ;; failed) set -- --close tmp ;; esac
        id() { [ "$*" = -u ] || exit 97; echo 0; }
        die() { echo "die $*" >>"$work/close-calls"; exit 1; }
        browser_locks() { echo locks >>"$work/close-calls"; [ "$sample" != locked ] || die 'guest update in progress'; }
        timeout() { [ "$1:$2:$3" = -k:1:30 ] || exit 97; shift 3; "$@"; }
        incus() { [ "$*" = '--force-local query /1.0/instances?recursion=1&project=default' ] || exit 97; cat "$work/close-instances"; }
        ic() { echo "ic $*" >>"$work/close-calls"; [ "$sample" != failed ]; }
        . "$work/close"
        exit 98
    ) >"$work/close-out" 2>&1 || rc=$?
    case $sample in
    def) [ "$rc" = 0 ]; printf '%s\n' locks 'ic stop def --force' >"$work/expected"; grep -qx 'browser: closed def' "$work/close-out" ;;
    int) [ "$rc" = 0 ]; printf '%s\n' locks >"$work/expected"; grep -qx 'browser: no int browser is running' "$work/close-out" ;;
    tmp) [ "$rc" = 0 ]; printf '%s\n' locks 'ic stop tmp-20 --force' 'ic stop tmp-portal --force' >"$work/expected" ;;
    usage) [ "$rc" = 1 ]; printf '%s\n' 'die usage: browser --close def|tmp|int' >"$work/expected" ;;
    locked) [ "$rc" = 1 ]; printf '%s\n' locks 'die guest update in progress' >"$work/expected" ;;
    failed) [ "$rc" = 1 ]; printf '%s\n' locks 'ic stop tmp-20 --force' 'die cannot stop tmp-20' >"$work/expected" ;;
    esac
    cmp "$work/expected" "$work/close-calls"
done
# Each role waits only for its own interrupted update.
sed -n '/^journal=\/var\/lib\/convergent\/guests$/,/^fi && die /p' "$repo/tools/browser" |
    sed "s|^journal=.*|journal=$work/journal|" >"$work/journal-gate"
grep -q '^fi && die ' "$work/journal-gate"
sh -n "$work/journal-gate"
for sample in none remmina-pending remmina-profile int-pending browser-ready browser-rename browser-profile; do
    rm -rf "$work/journal"
    mkdir -p "$work/journal/profiles.before"
    case $sample in
    remmina-pending) echo 'remmina guests-1 abc' >"$work/journal/pending" ;;
    remmina-profile) : >"$work/journal/profiles.before/remmina.yaml" ;;
    int-pending) echo 'int guests-1 abc' >"$work/journal/pending" ;;
    browser-ready) : >"$work/journal/browser.ready" ;;
    browser-rename) mkdir "$work/journal/browser.rename" ;;
    browser-profile) : >"$work/journal/profiles.before/browser-base.yaml" ;;
    esac
    for role in remmina def tmp; do
        rc=0
        # The launcher continues past a gate whose checks all fail.
        ( die() { exit 1; }; . "$work/journal-gate"; : ) || rc=$?
        case $sample:$role in
        none:*|remmina-*:def|remmina-*:tmp|int-*:remmina|browser-*:remmina) want=0 ;;
        *) want=1 ;;
        esac
        [ "$rc" = "$want" ] || { echo "journal gate: $sample $role returned $rc" >&2; exit 1; }
    done
done
# A UI lock timeout (a passphrase prompt) is busy, not a trust mismatch: check retries instead of failing.
sed -n '/^flock -w 30 7 /p' "$repo/tools/incus-ui" >"$work/ui-lock"
[ "$(wc -l <"$work/ui-lock")" = 1 ]
for held in 0 1; do
    rc=0
    ( flock() { [ "$held" = 0 ]; }; . "$work/ui-lock" ) 2>"$work/error" || rc=$?
    case $held in 0) [ "$rc" = 0 ] ;; 1) [ "$rc" = 75 ]; grep -q 'another UI operation' "$work/error" ;; esac
done
sed -n '/^# A UI lock timeout is not a trust mismatch/,/^esac$/p' "$repo/tools/check" |
    sed 's|/usr/local/sbin/incus-ui|incus_ui_call|' >"$work/audit-call"
[ -s "$work/audit-call" ]
sh -n "$work/audit-call"
for sample in ok busy-auto busy mismatch; do
    : >"$work/audit-report"
    rc=0
    (
        # check runs without -e.
        set +e
        die() { echo "die $*" >>"$work/audit-report"; exit 1; }
        bad() { echo "bad $*" >>"$work/audit-report"; }
        incus_ui_call() {
            [ "$*" = --audit ] || return 1
            case $sample in ok) return 0 ;; mismatch) return 1 ;; *) return 75 ;; esac
        }
        set --
        [ "$sample" != busy-auto ] || set -- auto
        . "$work/audit-call"
        echo continued >>"$work/audit-report"
    ) || rc=$?
    case $sample in
    ok) [ "$rc" = 0 ]; grep -qx continued "$work/audit-report" ;;
    busy-auto) [ "$rc" = 0 ] && [ ! -s "$work/audit-report" ] ;;
    busy) [ "$rc" = 1 ]; grep -qx 'die an Incus UI operation is running' "$work/audit-report" ;;
    mismatch) [ "$rc" = 0 ]; grep -qx 'bad Incus trust differs from metrics and unlocked int session' "$work/audit-report" ;;
    esac
    if grep -q '^bad' "$work/audit-report" && [ "$sample" != mismatch ]; then exit 1; fi
done
# Only the session limit triggers orphan recovery; failures are best-effort.
sed -n '/^reconcile_svc() {/,/^}/p; /^        if \[ "$action" = cleanup \]/,/^        fi$/p' "$repo/tools/incus-ui" >"$work/orphan"
[ -s "$work/orphan" ]
sh -n "$work/orphan"
cat >"$work/orphan-driver" <<'EOF'
ic() {
    echo "$*" >>"$work/orphan-calls"
    case $* in
    'config get svc limits.memory')
        case $sample in
        normal) echo 350MiB ;;
        custom) echo 1GiB ;;
        empty) echo '' ;;
        missing) return 1 ;;
        read-fail) echo 768MiB; return 1 ;;
        *) echo 768MiB ;;
        esac ;;
    'query /1.0/instances/svc/state?project=default')
        case $sample in
        query-fail) return 1 ;;
        stopped) echo '{"status":"Stopped"}' ;;
        *) echo '{"status":"Running"}' ;;
        esac ;;
    'exec svc -- rc-service grafana stop')
        [ "$sample" != stop-fail ] ;;
    'config set svc limits.memory=350MiB')
        [ "$sample" != shrink-fail ] ;;
    *) exit 1 ;;
    esac
}
logger() { echo "$*" >>"$work/orphan-errors"; return 1; }
. "$work/orphan"
EOF
sh -n "$work/orphan-driver"
for action in cleanup --reconcile --close revoke; do
    for sample in normal custom empty missing read-fail running stopped query-fail stop-fail shrink-fail; do
        : >"$work/orphan-calls"
        : >"$work/orphan-errors"
        (export work action sample; sh -eu "$work/orphan-driver")
        : >"$work/expected"
        case $action in
        cleanup|--reconcile)
            echo 'config get svc limits.memory' >"$work/expected"
            case $sample in
            running|stopped|query-fail|stop-fail|shrink-fail)
                echo 'query /1.0/instances/svc/state?project=default' >>"$work/expected" ;;
            esac
            case $sample in
            running|stop-fail|shrink-fail) echo 'exec svc -- rc-service grafana stop' >>"$work/expected" ;;
            esac
            case $sample in
            running|stopped|shrink-fail) echo 'config set svc limits.memory=350MiB' >>"$work/expected" ;;
            esac ;;
        esac
        cmp "$work/expected" "$work/orphan-calls"
        case $action:$sample in
        cleanup:query-fail|--reconcile:query-fail|cleanup:stop-fail|--reconcile:stop-fail|cleanup:shrink-fail|--reconcile:shrink-fail)
            grep -qx -- '-p user.err -t incus-ui svc orphan recovery failed' "$work/orphan-errors" ;;
        *) [ ! -s "$work/orphan-errors" ] ;;
        esac
    done
done
# Reap tmp orphans with a free slot lock, rechecking identity after locking.
(
    sed -n '/^reap_tmp() (/,/^)/p' "$repo/tools/browser" |
        sed "s|/run/convergent/browser|$work/locks|g" >"$work/reap"
    sh -n "$work/reap"
    . "$work/reap"
    mkdir "$work/locks"
    cat >"$work/instances" <<'EOF'
[
  {"name":"tmp-20","status":"Stopped","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-21","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-22","status":"Stopped","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-portal","status":"Stopped","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-23","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-26","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-24","status":"Stopped","type":"virtual-machine","profiles":["browser-base","browser-tmp"]},
  {"name":"tmp-25","status":"Stopped","type":"container","profiles":["default"]},
  {"name":"def","status":"Stopped","type":"container","profiles":["browser-base","browser-def"]},
  {"name":"tmp-200","status":"Stopped","type":"container","profiles":["browser-base","browser-tmp"]}
]
EOF
    instances_json() {
        [ -z "${stale:-}" ] || [ "${locked:-}" = "$stale" ] || return 1
        cat "$work/instances"
        jq 'map(if .name == "tmp-22" then .profiles = ["default"] else . end)' "$work/instances" >"$work/next"
        mv "$work/next" "$work/instances"
    }
    flock() {
        [ "$*" = '-n 7' ] || exit 97
        locked=$stale
        echo attempt >>"$work/lock-attempts"
        [ "$(wc -l <"$work/lock-attempts")" != 2 ]
    }
    ic() {
        [ "$locked" = "$2" ] || return 1
        echo "$*" >>"$work/reaped"
        case $* in
        'stop tmp-23 --force') jq 'map(select(.name != "tmp-23"))' "$work/instances" >"$work/next" ;;
        'stop tmp-26 --force') jq 'map(if .name == "tmp-26" then .status = "Stopped" else . end)' "$work/instances" >"$work/next" ;;
        delete\ *) jq --arg n "$2" 'map(select(.name != $n))' "$work/instances" >"$work/next" ;;
        *) return 1 ;;
        esac
        mv "$work/next" "$work/instances"
    }
    reap_tmp
    printf 'delete tmp-20\ndelete tmp-portal\nstop tmp-23 --force\nstop tmp-26 --force\ndelete tmp-26\n' >"$work/expected"
    cmp "$work/expected" "$work/reaped"
    [ "$(wc -l <"$work/lock-attempts")" = 6 ]
    # Query/stop failures must not fall through to deletion, even in a conditional.
    instances_json() { echo '[{"name":"tmp-20","status":"Running","type":"container","profiles":["browser-base","browser-tmp"]}]'; }
    ic() { echo "$*" >"$work/failed-stop"; return 1; }
    if reap_tmp; then exit 1; fi
    grep -qx 'stop tmp-20 --force' "$work/failed-stop"
    instances_json() { return 1; }
    if reap_tmp; then exit 1; fi
)
# The periodic root-only entry point takes both shared locks before sweeping.
sed -n '/^browser_locks() {/,/^}/p; /^if \[ "${1:-}" = --reap-tmp \]/,/^fi/p' "$repo/tools/browser" |
    sed "s|/run/convergent|$work/run|g" >"$work/sweep"
[ -s "$work/sweep" ]
sh -n "$work/sweep"
for gate in open guests update stopping nonroot arguments; do
    : >"$work/locks-taken"
    rm -f "$work/swept" "$work/run/guests-stopping"
    mkdir -p "$work/run"
    [ "$gate" != stopping ] || touch "$work/run/guests-stopping"
    rc=0
    (
        die() { exit 1; }
        id() { if [ "$gate" = nonroot ]; then echo 1000; else echo 0; fi; }
        flock() {
            echo "$*" >>"$work/locks-taken"
            case $gate:$* in 'guests:-s -n 9'|'update:-s -n 6') return 1 ;; esac
        }
        reap_tmp() { touch "$work/swept"; }
        set -- --reap-tmp
        [ "$gate" != arguments ] || set -- "$@" extra
        . "$work/sweep"
    ) || rc=$?
    case $gate in
    open)
        [ "$rc" = 0 ] && [ -f "$work/swept" ] || exit 1
        printf '%s\n' '-s -n 9' '-s -n 6' >"$work/expected"
        cmp "$work/expected" "$work/locks-taken" ;;
    nonroot) [ ! -e "$work/swept" ] && [ ! -s "$work/locks-taken" ] ;;
    *) [ "$rc" != 0 ] && [ ! -e "$work/swept" ] ;;
    esac
done
grep -Fq 'timeout -k 1 30 /usr/local/sbin/browser --reap-tmp || logger' "$repo/tools/check"
# No sweep before self-heal (a frozen QEMU holds each for its full bound); UI cleanup after it.
awk '/^    firewall_heal >/ {heal = NR} /browser --reap-tmp \|\|/ {sweep = NR} /remote reap \|\|/ {reap = NR}
    /incus-ui cleanup \|\|/ {ui = NR}
    END {exit !(heal && sweep > heal && reap > heal && ui > heal)}' "$repo/tools/check"
# Delayed events must be awaited; a permanently missing event must hit the deadline.
sed -n '/^audit_ready() {/,/^done$/p' "$here/test-incus-ui" |
    sed "s|/var/log/messages|$work/messages|g; s/+ 60/+ 2/" >"$work/audit"
[ -s "$work/audit" ]
: >"$work/messages"
fp=test-fingerprint
(
    sleep 1
    printf '%s\n' 'incus-audit w2-audit-fixture w2-owner' 'incus-audit w2-audit-request w2-owner' \
        'incus-audit profile-created w2-audit-native' 'incus-audit profile-deleted w2-audit-native' \
        'incus-audit "protocol":"unix","method":"DELETE","path":"/1.0/profiles/w2-audit-native"' \
        'incus-audit "event":"request" test-fingerprint' >"$work/messages"
) &
writer=$!
. "$work/audit"
wait "$writer"
: >"$work/messages"
if ( . "$work/audit" ) 2>"$work/error"; then exit 1; fi
grep -q 'timed out' "$work/error"
# New UI passphrases need 12 bytes, like LUKS and the account; unlock takes what setup accepted.
sed -n '/^prompt() {/,/^}/p' "$repo/tools/incus-ui" |
    sed "s|</dev/tty|<$work/tty-in|g; s|>/dev/tty|>$work/tty-out|g" >"$work/prompt"
[ -s "$work/prompt" ]
sh -n "$work/prompt"
if grep -q /dev/tty "$work/prompt"; then exit 1; fi
# Bounded: the browser holds the guest locks during the unlock prompt.
grep -q "password=\$(timeout --foreground -k 1 120 sh -c 'IFS= read -r p <" "$work/prompt"
grep -qxF "        prompt 'New Incus UI passphrase: ' 12" "$repo/tools/incus-ui"
grep -qxF "        prompt 'Incus UI passphrase: '" "$repo/tools/incus-ui"
mkdir "$work/prompt-scratch"
for sample in short exact bytes unlock spaces empty; do
    min=12
    case $sample in
    short) pass='eleven byte' ;;
    exact) pass='twelve bytes' ;;
    bytes) pass=$(printf '\303\251\303\251\303\251345678') ;; # 9 characters, 12 bytes
    unlock) pass=x min= ;;
    spaces) pass=' back\slash  ' min= ;;
    empty) pass= min= ;;
    esac
    printf '%s\n' "$pass" >"$work/tty-in"
    rm -f "$work/prompt-scratch/password"
    rc=0
    (
        export LC_ALL=C
        die() { echo "$*" >&2; exit 1; }
        stty() { :; }
        scratch=$work/prompt-scratch
        . "$work/prompt"
        prompt 'Passphrase: ' ${min:+"$min"}
    ) 2>"$work/prompt-error" || rc=$?
    case $sample in
    short) [ "$rc" = 1 ] && grep -qx 'passphrase must be at least 12 bytes' "$work/prompt-error" ;;
    empty) [ "$rc" = 1 ] && grep -qx 'empty passphrase refused' "$work/prompt-error" ;;
    *) [ "$rc" = 0 ] && [ "$(cat "$work/prompt-scratch/password")" = "$pass" ] ;;
    esac || { cat "$work/prompt-error"; exit 1; }
    case $sample in short|empty) [ ! -e "$work/prompt-scratch/password" ] ;; esac
done
echo 'incus-ui: query, independent launch, bounded audit and passphrase floor fixtures passed'
