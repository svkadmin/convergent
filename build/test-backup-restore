#!/bin/sh
# Run only in the existing disposable guest host; real archives and Incus imports.
set -eu
umask 077
[ -d /var/lib/convergent/test-release ] || exit 1
fixture=$(mktemp -d /var/tmp/backup-restore.XXXXXX)
owner=cv-backup-owner defaults=cv-backup-default
home=/home/.cv-backup-restore
created=
ic() { incus --force-local --project "$project" "$@"; }
cleanup() {
    result=$?
    trap - 0
    trap '' HUP INT TERM
    set +e
    for project in $created; do
        ic delete sample >/dev/null 2>&1
        ic profile delete saved >/dev/null 2>&1
        for volume in state state-restored state-before-restore svc-metrics svc-logs svc-grafana browser-def-state browser-int-state; do
            ic storage volume delete default "$volume" >/dev/null 2>&1
        done
        ic project delete "$project" || result=1
    done
    rm -rf "$home" "$fixture"
    echo "CV-BACKUP-RESTORE result=$result"
    exit "$result"
}
# Refuse collisions before installing cleanup.
for project in "$owner" "$defaults"; do
    if ic project show "$project" >/dev/null 2>&1; then exit 1; fi
done
[ ! -e "$home" ]
trap cleanup 0
trap 'exit 1' HUP INT TERM
for project in "$owner" "$defaults"; do
    ic project create "$project" -c features.profiles=true -c features.storage.volumes=true
    created="$created $project"
done
mkdir -p "$home" "$fixture/media" "$fixture/root/etc" "$fixture/restored"
echo home-marker >"$home/marker"
# Copy only writable /etc files; never restore over the running host's identity.
grep -v '^#' /usr/lib/convergent/etc-state | sed '/^$/d' >"$fixture/etc.list"
while IFS= read -r path; do
    mkdir -p "$fixture/root/etc/$(dirname "$path")"
    cp -a "/etc/$path" "$fixture/root/etc/$path"
done <"$fixture/etc.list"
metadata() {
    chown 1234:2345 "$1"
    chmod 0640 "$1"
    setfacl -m u:3456:r-- "$1"
    setfattr -n user.cv-backup -v retained "$1"
}
check_file() {
    cmp "$1" "$2"
    [ "$(stat -c '%u:%g:%a' "$1")" = "$(stat -c '%u:%g:%a' "$2")" ]
    getfacl -cn "$1" >"$fixture/acl-before"
    getfacl -cn "$2" >"$fixture/acl-after"
    cmp "$fixture/acl-before" "$fixture/acl-after"
    [ "$(getfattr --only-values -n user.cv-backup "$2" 2>/dev/null)" = retained ]
}
metadata "$home/marker"
metadata "$fixture/root/etc/machine-id"
project=$defaults
for volume in svc-metrics svc-logs svc-grafana browser-def-state browser-int-state; do
    ic storage volume create default "$volume"
    path=/var/lib/incus/storage-pools/default/custom/${defaults}_$volume/marker
    echo "$volume-marker" >"$path"
    metadata "$path"
    cp -a "$path" "$fixture/$volume-marker"
done
project=$owner
ic storage volume create default state
volume_path=/var/lib/incus/storage-pools/default/custom/${owner}_state
echo volume-marker >"$volume_path/marker"
metadata "$volume_path/marker"
cp -a "$volume_path/marker" "$fixture/volume-marker"
ic profile create saved
ic profile set saved user.backup=profile-marker
ic profile device add saved root disk path=/ pool=default
ic profile device add saved state disk path=/saved pool=default source=state
ic init sample --empty -p saved
ic config device override sample state path=/local
ic config set sample user.backup=container-marker
container_path=/var/lib/incus/storage-pools/default/containers/${owner}_sample/rootfs
echo container-marker >"$container_path/marker"
metadata "$container_path/marker"
cp -a "$container_path/marker" "$fixture/container-marker"

# Stub only external-media detection and remap default's volume namespace.
# Home snapshot, tar, checksums, publication and all Incus IO remain real.
cat >"$fixture/run-backup" <<'EOF'
set -eu
findmnt() {
    if [ "$*" = "-nro SOURCE --mountpoint $fixture/media" ]; then echo /dev/mapper/cv-backup-fixture
    else command findmnt "$@"; fi
}
cryptsetup() {
    if [ "$*" = 'status /dev/mapper/cv-backup-fixture' ]; then echo 'type: LUKS2'
    else command cryptsetup "$@"; fi
}
lsblk() {
    case $* in
    '-snro TRAN /dev/mapper/cv-backup-fixture') echo usb ;;
    '-snrpo NAME /dev/mapper/cv-backup-fixture') echo /dev/cv-backup-fixture ;;
    *) command lsblk "$@" ;;
    esac
}
incus() {
    if [ "$1:$2:$3" = --force-local:--project:default ]; then
        shift 3
        command incus --force-local --project "$defaults" "$@"
    else command incus "$@"; fi
}
EOF
sed 's|-C / -cpf "$payload/etc.tar"|-C "$fixture/root" -cpf "$payload/etc.tar"|' \
    /usr/local/sbin/backup >>"$fixture/run-backup"
sh -n "$fixture/run-backup"
export fixture defaults
sh "$fixture/run-backup" "$fixture/media" "$owner"
set -- "$fixture/media/convergent-backups"/backup-*
[ "$#" = 1 ] && [ -d "$1" ]
backup=$1
(cd "$backup" && sha256sum -c SHA256SUMS)
[ "$(cat "$backup/machine-id")" = "$(cat /etc/machine-id)" ]
tar --acls --xattrs --numeric-owner -xpf "$backup/home.tar" -C "$fixture/restored"
tar --acls --xattrs --numeric-owner -xpf "$backup/etc.tar" -C "$fixture/restored"
check_file "$home/marker" "$fixture/restored/home/.cv-backup-restore/marker"
check_file "$fixture/root/etc/machine-id" "$fixture/restored/etc/machine-id"
while IFS= read -r path; do
    cmp "$fixture/root/etc/$path" "$fixture/restored/etc/$path"
done <"$fixture/etc.list"

# Recipe 11: profiles, volumes, containers, then reset renamed attachments.
project=$owner
ic delete sample
ic profile delete saved
jq -r '.[].name' "$backup/projects/$project/profiles.json" >"$fixture/profiles"
while IFS= read -r name; do
    ic profile show "$name" >/dev/null 2>&1 || ic profile create "$name"
    jq --arg n "$name" '.[] | select(.name == $n) | {config,description,devices}' \
        "$backup/projects/$project/profiles.json" | ic profile edit "$name"
done <"$fixture/profiles"
ic storage volume import default "$backup/projects/$project/default/state.tar.gz" state-restored
ic storage volume rename default state state-before-restore
ic storage volume rename default state-restored state
ic profile device set saved state source=state
ic import "$backup/projects/$project/instance-sample.tar.gz"
ic config device set sample state source=state
incus --force-local query "/1.0/profiles/saved?project=$project" | jq -e '.config["user.backup"] == "profile-marker" and .devices.state.source == "state"' >/dev/null
incus --force-local query "/1.0/instances/sample?project=$project" | jq -e '
    .config["user.backup"] == "container-marker" and
    .expanded_devices.state.source == "state" and .expanded_devices.state.pool == "default" and .expanded_devices.state.path == "/local"' >/dev/null
incus --force-local query "/1.0/storage-pools/default/volumes/custom/state-before-restore?project=$project" | jq -e '.used_by | length == 0' >/dev/null
incus --force-local query "/1.0/storage-pools/default/volumes/custom/state?project=$project" | jq -e '.used_by | any(.[]; contains("/instances/sample"))' >/dev/null
check_file "$fixture/volume-marker" "$volume_path/marker"
check_file "$fixture/container-marker" "$container_path/marker"
# The default-project archives must also be importable into an empty namespace.
project=$defaults
for volume in svc-metrics svc-logs svc-grafana browser-def-state browser-int-state; do
    ic storage volume delete default "$volume"
    ic storage volume import default "$backup/projects/default/default/$volume.tar.gz" "$volume"
    check_file "$fixture/$volume-marker" "/var/lib/incus/storage-pools/default/custom/${defaults}_$volume/marker"
done
