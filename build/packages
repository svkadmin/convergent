#!/bin/sh
# ARCHITECTURE 6; install release sets into /staging.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
. "$here/chroot.sh"

[ "$(id -u)" = 0 ] || { echo "packages: run as root" >&2; exit 1; }
[ -x "$BUILDER/bin/sh" ] || { echo "packages: no builder; run build/buildenv first" >&2; exit 1; }

# Rebuild image-only Portage configuration.
exec 9>/run/convergent-packages.lock
flock 9
conf="$BUILDER/image-config/etc/portage"
rm -rf "$BUILDER/image-config"
mkdir -p "$conf"
cp -r "$BUILDER/etc/portage/make.conf" "$BUILDER/etc/portage/binrepos.conf" "$BUILDER/etc/portage/gnupg" \
	"$BUILDER/etc/portage/repos.conf" "$conf/"
for d in package.use package.accept_keywords package.license sets profile; do
	mkdir -p "$conf/$d"
	cp -r "$repo/portage/$d/." "$conf/$d/"
done
ln -s "../../../var/db/repos/gentoo/profiles/$PROFILE" "$conf/make.profile"

# The 23.0 profiles are merged-usr: a new root gets the links before its first package.
s="$BUILDER/staging"
if [ ! -e "$s" ]; then
	mkdir -p "$s/usr/bin" "$s/usr/lib" "$s/usr/lib64"
	ln -s usr/bin "$s/bin"; ln -s usr/bin "$s/sbin"; ln -s bin "$s/usr/sbin"
	ln -s usr/lib "$s/lib"; ln -s usr/lib64 "$s/lib64"
fi
for d in bin sbin lib lib64 usr/sbin; do
	[ -L "$s/$d" ] || { echo "packages: $s/$d is not a merged-usr link; remove $s and rerun" >&2; exit 1; }
done

sets="@system @convergent @convergent-apps"
emerge="env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config emerge --root=/staging --update --deep --newuse"
chroot_mount
trap chroot_umount EXIT

if [ "${1:-}" = --pretend ]; then
	chroot "$BUILDER" $emerge --pretend --verbose $sets
else
	chroot "$BUILDER" $emerge --quiet-build=y --keep-going=y $sets
	# Remove packages no longer needed by the sets.
	chroot "$BUILDER" env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config \
		emerge --root=/staging --depclean --quiet
fi
