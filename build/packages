#!/bin/sh
# ARCHITECTURE 6; install release sets into /staging.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
. "$here/chroot.sh"

[ "$(id -u)" = 0 ] || { echo "packages: run as root" >&2; exit 1; }
[ -x "$BUILDER/bin/sh" ] || { echo "packages: no builder; run build/buildenv first" >&2; exit 1; }

# Rebuild image-only Portage configuration.
exec 9>/run/convergent-packages.lock
flock 9
conf="$BUILDER/image-config/etc/portage"
rm -rf "$BUILDER/image-config"
mkdir -p "$conf"
cp -r "$BUILDER/etc/portage/make.conf" "$BUILDER/etc/portage/binrepos.conf" "$BUILDER/etc/portage/gnupg" \
	"$BUILDER/etc/portage/repos.conf" "$conf/"
for d in package.use package.accept_keywords package.license sets profile patches; do
	mkdir -p "$conf/$d"
	cp -r "$repo/portage/$d/." "$conf/$d/"
done
ln -s "../../../var/db/repos/gentoo/profiles/$PROFILE" "$conf/make.profile"
# The local overlay follows this tree too, not the one buildenv copied at setup.
rm -rf "$BUILDER/var/db/repos/convergent"
cp -r "$repo/portage/overlay" "$BUILDER/var/db/repos/convergent"

# The 23.0 profiles are merged-usr: a new root gets the links before its first package.
s="$BUILDER/staging"
if [ ! -e "$s" ]; then
	mkdir -p "$s/usr/bin" "$s/usr/lib" "$s/usr/lib64"
	ln -s usr/bin "$s/bin"; ln -s usr/bin "$s/sbin"; ln -s bin "$s/usr/sbin"
	ln -s usr/lib "$s/lib"; ln -s usr/lib64 "$s/lib64"
fi
for d in bin sbin lib lib64 usr/sbin; do
	[ -L "$s/$d" ] || { echo "packages: $s/$d is not a merged-usr link; remove $s and rerun" >&2; exit 1; }
done

sets="@system @convergent @convergent-apps"
# Patched packages never come from a binary package: one built without the patch would ship.
patched=$(cd "$repo/portage/patches" && ls -d */*)
nobin=$(printf -- '--usepkg-exclude=%s ' $patched)
emerge="env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config emerge --root=/staging --update --deep --newuse $nobin"
chroot_mount
trap chroot_umount EXIT

if [ "${1:-}" = --pretend ]; then
	chroot "$BUILDER" $emerge --pretend --verbose $sets
else
	# The kernel fragment follows this tree, not the copy buildenv made at setup.
	frag=$BUILDER/etc/kernel/config.d/50-convergent.config
	install -D -m 0644 "$here/kernel.config" "$frag"
	chroot "$BUILDER" $emerge --quiet-build=y --keep-going=y $sets
	# A changed kernel fragment needs a rebuilt kernel: its version stays the same, and a
	# cached binary would keep old options. The stamp records which fragment the kernel used.
	stamp=$BUILDER/var/lib/convergent/kernel-fragment.sha256
	want=$(sha256sum <"$frag" | cut -d' ' -f1)
	if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
		chroot "$BUILDER" env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config emerge --root=/staging \
			--oneshot --quiet-build=y --usepkg-exclude=sys-kernel/gentoo-kernel sys-kernel/gentoo-kernel
		mkdir -p "${stamp%/*}" && echo "$want" >"$stamp"
	fi
	# Changed patches rebuild their packages, which keep the same version.
	stamp=$BUILDER/var/lib/convergent/patches.sha256
	want=$(cd "$repo/portage/patches" && find . -type f | LC_ALL=C sort | xargs cat | sha256sum | cut -d' ' -f1)
	if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
		chroot "$BUILDER" env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config emerge --root=/staging \
			--oneshot --quiet-build=y $nobin $patched
		mkdir -p "${stamp%/*}" && echo "$want" >"$stamp"
	fi
	# Remove packages no longer needed by the sets.
	chroot "$BUILDER" env LC_ALL=C.UTF-8 PORTAGE_CONFIGROOT=/image-config \
		emerge --root=/staging --depclean --quiet
	# Cursor themes are data: built in the builder, copied into the image by build/image.
	chroot "$BUILDER" env LC_ALL=C.UTF-8 emerge --noreplace --quiet-build=y x11-themes/vanilla-dmz-xcursors x11-themes/vanilla-dmz-aa-xcursors
fi
