#!/bin/sh
# Run the boot retry loop with a controlled driver; no root or KVM needed.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
# Firewall downloads finish before the bounded VM boots; allow slow large sets.
awk '
    /^[[:space:]]*curl / {
        n++
        if ($0 !~ / --connect-timeout 30 / || $0 !~ / --max-time 3600 /) bad=1
    }
    END {exit (n != 4 || bad)}' "$here/../guests/fw/build"
echo 'test-vm-runner: all four firewall downloads have connection and transfer limits'
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' 0
trap 'exit 1' HUP INT TERM
export fixture
sed -n '/^run_vm()/,/^blessed()/p' "$here/test" | sed '$d' >"$fixture/run-vm"
[ -s "$fixture/run-vm" ]
sh -n "$fixture/run-vm"
cat >"$fixture/driver-check" <<'EOF'
set -eu
die() { echo "$*" >&2; exit 1; }
cv_time() { :; }
. "$fixture/run-vm"
BUILDER= work=$fixture/$mode-$scenario
mkdir "$work"
echo 3 >"$work/loopp1"
attach() { loop=$work/loop; }
detach() { loop=''; }
pass=fixture qemu_id=1:1 runs=0
deadline=$(($(date +%s) + 60))
chroot() {
    cat >/dev/null
    echo "$CVTEST_RUN $CVTEST_GOAL" >>"$work/calls"
    n=$(wc -l <"$work/calls")
    # Model the ESP counter decrement before PID 1 can crash.
    tries=$(cat "$work/loopp1")
    echo "$((tries - 1))" >"$work/loopp1"
    [ ! -e "$CVTEST_LOG" ] || exit 91
    echo blessed >"$work/ended-$CVTEST_RUN"
    case $scenario:$n in
    once:1 | twice:* | driver-crash:1) printf '%s\n' "$signature" >"$CVTEST_LOG" ;;
    other:*) echo 'Kernel panic - not syncing: unrelated failure' >"$CVTEST_LOG"; echo timeout >"$work/ended-$CVTEST_RUN" ;;
    *) echo 'release 42 is good' >"$CVTEST_LOG" ;;
    esac
    case $scenario in driver-fail | driver-crash) return 1 ;; esac
}
run_vm "$goal"
[ "$runs" = 1 ]
case $scenario in
once)
    [ "$(wc -l <"$work/calls")" = 2 ]
    [ "$(cat "$work/calls")" = "1 $goal
1 $goal" ]
    grep -qF "$signature" "$work/console-1-1.log"
    [ "$(readlink "$work/console.log")" = console-1-2.log ]
    case $mode in fallback | interrupt) tries=2 ;; *) tries=1 ;; esac
    [ "$(cat "$work/loopp1")" = "$tries" ]
    run_vm "$goal"
    [ "$runs" = 2 ] && [ "$(wc -l <"$work/calls")" = 3 ]
    grep -qF "$signature" "$work/console-1-1.log"
    [ "$(readlink "$work/console.log")" = console-2-1.log ]
    [ "$(cat "$work/loopp1")" = "$((tries - 1))" ]
    ;;
other) [ "$ended" = timeout ] && [ "$(wc -l <"$work/calls")" = 1 ] ;;
driver-fail | driver-crash) exit 0 ;;
*) exit 92 ;;
esac
EOF
sh -n "$fixture/driver-check"
# Check both budget layers and the generated smoke selection without booting.
sed -n '/^[[:space:]]*cat >"\$var\/lib\/convergent\/test-release\/smoke-test"/,/^[[:space:]]*# Gentoo configures/p' "$here/test" | sed '$d' >"$fixture/smoke"
[ -s "$fixture/smoke" ]
for mode in guests guests-maint guests-update guests-topology online; do
    case $mode in guests) want=12600 ;; guests-maint) want=19800 ;; guests-update) want=23400 ;; guests-topology) want=21600 ;; *) want=14400 ;; esac
    (
        . "$fixture/run-vm"
        BUILDER= work=$fixture/budget-$mode
        mkdir "$work"
        pass=fixture qemu_id=1:1 runs=0
        deadline=$(($(date +%s) + 44000))
        die() { echo "$*" >&2; exit 1; }
        cv_time() { :; }
        # Console links are checked by the retry fixtures below.
        ln() { :; }
        chroot() {
            cat >/dev/null
            [ "$CVTEST_TIMEOUT" = "$want" ] || return 1
            : >"$CVTEST_LOG"
            echo timeout >"$work/ended-$CVTEST_RUN"
        }
        run_vm "$mode"
        [ "$ended" = timeout ]
        budget_case=$(sed -n '/^[[:space:]]*case \$mode in guests) budget=/p' "$here/test")
        [ -n "$budget_case" ]
        eval "$budget_case"
        [ "$budget" = "$want" ]
        var=$work
        mkdir -p "$var/lib/convergent/test-release"
        . "$fixture/smoke"
        smoke=$var/lib/convergent/test-release/smoke-test
        sh -n "$smoke"
        for check in remmina-test pf-test incus-ui-test; do
            case $mode in
            guests | guests-maint) grep -q "\$release/$check" "$smoke" ;;
            *) if grep -q "\$release/$check" "$smoke"; then exit 1; fi ;;
            esac
        done
        for check in browser-test browser-migration-test selftest-test; do
            grep -q "\$release/$check" "$smoke"
        done
        # The backup tool is gone; so is its restore test.
        if grep -q backup-restore "$smoke"; then exit 1; fi
    )
done
echo 'test-vm-runner: guest budgets and smoke selection passed'
# The update flow's halves: each step in exactly one of guests-update and guests-topology, each half
# with its own verdict; guests-maint keeps handoff recovery and the Remmina update.
# Heredoc lines end functions at column 0 too: stop at the next function.
sed -n '/^inject_guest_update() {/,/^inject_online() {/p' "$here/test" | sed '$d' >"$fixture/inject-update"
[ -s "$fixture/inject-update" ]
for mode in guests-maint guests-update guests-topology; do
    (
        var=$fixture/var-$mode broken=$fixture/broken-svc
        mkdir -p "$var/lib/convergent/test-release" "$broken"
        . "$fixture/inject-update"
        inject_guest_update
        script=$var/lib/convergent/test-release/update-test
        sh -n "$script"
        [ "$(tail -n 1 "$script")" = 'echo CV-UPDATE-RESULT "$result"' ]
        sed -n 's/^cv_time \([a-z0-9-]*\)$/\1/p' "$script" | sort >"$fixture/steps-$mode"
        has() { grep -qx "$1" "$fixture/steps-$mode"; }
        timed() { grep -q '>"$release/guests-fw-timed" || bad $LINENO$' "$script"; }
        topology() { grep -qx 'sh "$release/topology-test" || { fw_diag; bad $LINENO; }' "$script"; }
        remmina() { grep -q '^timeout -k 30 600 sh /var/lib/convergent/test-release/remmina-test update ' "$script"; }
        case $mode in
        guests-maint)
            has handoff-recovery && remmina || exit 1
            if timed || topology || has firewall-no-peer || has firewall-update; then exit 1; fi
            ;;
        guests-update)
            for step in firewall-pair-start handoff-recovery certificate-renewal guests-start-stopped firewall-update \
                wan-update svc-preparation svc-broken-rollback dashboard-checks wired-lock-wait \
                firewall-rebuild-interruptions; do
                has "$step"
            done
            timed && [ -d "$var/lib/convergent/test-release/broken-svc" ] || exit 1
            if topology || remmina || has firewall-no-peer || has work-topology-migration; then exit 1; fi
            ;;
        guests-topology)
            for step in topology-setup firewall-no-peer work-topology-migration; do has "$step"; done
            timed && topology && remmina || exit 1
            if has handoff-recovery || has firewall-pair-start || has firewall-update || has firewall-rebuild-interruptions; then exit 1; fi
            if [ -e "$var/lib/convergent/test-release/broken-svc" ]; then exit 1; fi
            ;;
        esac
    )
done
[ "$(comm -12 "$fixture/steps-guests-update" "$fixture/steps-guests-topology" | tr '\n' ' ')" = 'update-done update-test ' ]
# A skipped topology test exits 0: guests-topology requires its own passed line.
passed=$(sed -n "s/^echo '\(CV-TOPOLOGY .* passed\)'\$/\1/p" "$here/test-topology-live")
[ -n "$passed" ] || exit 1
grep -qF "grep -qx '$passed'" "$here/test"
echo 'test-vm-runner: update halves split, verdicts and topology pass line checked'
# Timed firewall waits keep command replies and redirected logs intact.
sed -n '/^# Mark bounded waits/,/^# End bounded waits/p' "$here/test" | sed '$d' |
    sed "s|/usr/local/sbin/guests|$here/../tools/guests|g" >"$fixture/timed"
[ -s "$fixture/timed" ]
(
    release=$fixture
    printf 'cv_time() { echo "CV-TIME $1 0"; }\n' >"$release/timing"
    bad() { exit 1; }
    . "$fixture/timed"
    sh -n "$release/guests-fw-timed"
    sed -n '/^retry() {/,/^}/p' "$release/guests-fw-timed" >"$fixture/retry"
    [ -s "$fixture/retry" ]
    . "$release/timing"
    . "$fixture/retry"
    boot_timeout=0 work=$fixture
    fail() { return 1; }
    reply=$(retry printf reply 3>"$fixture/progress")
    [ "$reply" = reply ]
    grep -qx 'CV-TIME firewall-update-printf 0' "$fixture/progress"
    seed_applied() { printf reply; }
    reply=$(retry seed_applied 3>"$fixture/progress")
    [ "$reply" = reply ]
    grep -qx 'CV-TIME firewall-update-seed-applied 0' "$fixture/progress"
    if retry false 3>"$fixture/progress" >"$fixture/reply" 2>"$fixture/retry-log"; then exit 1; fi
    grep -qx 'CV-TIME firewall-update-false 0' "$fixture/progress"
    [ ! -s "$fixture/reply" ]
)
echo 'test-vm-runner: timed firewall waits preserve replies and failures'
for signature in 'init[1]: segfault' 'Kernel panic - not syncing: Attempted to kill init'; do
    export signature
    for mode in boot fallback interrupt corrupt recovery rescue guests guests-maint guests-update guests-topology online desktop update; do
        goal=$mode
        case $mode in boot | fallback | interrupt | corrupt) goal=bless ;; esac
        export mode goal
        for scenario in once twice other driver-fail driver-crash; do
            export scenario
            # Reuse the fixture path for the second signature only.
            work=$fixture/$mode-$scenario
            if [ -d "$work" ]; then mv "$work" "$work.first"; fi
            rc=0
            sh "$fixture/driver-check" >"$fixture/output" 2>&1 || rc=$?
            case $scenario in
            once | other) [ "$rc" = 0 ] || { cat "$fixture/output"; exit 1; } ;;
            *) [ "$rc" != 0 ] ;;
            esac
            case $scenario in
            once | twice | driver-crash)
                [ "$(grep -c '^CV-TEST nested PID 1 crash; rerunning boot 1$' "$fixture/output")" = 1 ]
                [ -f "$work/console-1-1.log" ] && [ -f "$work/console-1-2.log" ]
                ;;
            *) if grep -q '^CV-TEST nested PID 1 crash' "$fixture/output"; then exit 1; fi ;;
            esac
            case $scenario in
            twice | driver-crash) [ "$(wc -l <"$work/calls")" = 2 ] ;;
            driver-fail) [ "$(wc -l <"$work/calls")" = 1 ] ;;
            esac
        done
    done
done
echo 'test-vm-runner: unique consoles, bounded crash retries and other failures passed'
# Exercise the build-host console parser without QEMU.
python3 - "$here/test" <<'PY'
import pathlib, re, sys, textwrap
source = pathlib.Path(sys.argv[1]).read_text()
driver = source[source.index("import json, os, re, select,"):].split("\nEOF", 1)[0]
compile(driver, "run_vm", "exec")
markers = source[source.index("markers = {"):source.index("\nverdicts = {}")]
start = source.index("                    if guest_test and result is None:")
end = source.index("                    # Releases before", start)
parse = textwrap.dedent(source[start:end])
for guest in (None, 0, 1):
    for online in (None, 0, 1):
        for order in (False, True):
            state = dict(goal="online", guest_test=True, result=None, verdicts={}, re=re)
            exec(markers, state)
            rows = [(b"CV-GUESTS-RESULT", guest), (b"CV-ONLINE-RESULT", online)]
            for marker, value in reversed(rows) if order else rows:
                state["seen"] = b"" if value is None else marker + b" %d\n" % value
                exec(parse, state)
            want = None if guest is None or online is None else max(guest, online)
            assert state["result"] == want, (guest, online, order, state["result"])
print("test-vm-runner: online requires both successful verdicts")
for goal in ("guests-maint", "guests-update", "guests-topology"):
    for guest in (None, 0, 1):
        for update in (None, 0, 1):
            state = dict(goal=goal, guest_test=True, result=None, verdicts={}, re=re)
            exec(markers, state)
            rows = [(b"CV-GUESTS-RESULT", guest), (b"CV-UPDATE-RESULT", update)]
            state["seen"] = b"".join(marker + b" %d\n" % value for marker, value in rows if value is not None)
            exec(parse, state)
            want = None if guest is None or update is None else max(guest, update)
            assert state["result"] == want, (goal, guest, update, state["result"])
print("test-vm-runner: both update halves and guests-maint require both verdicts")

# Use host monotonic time, never the guest's elapsed field or ordinary console output.
start = source.index("                    timing += chunk")
end = source.index("                    seen =", start)
timing = textwrap.dedent(source[start:end])
start = source.index("            left = deadline - time.monotonic()")
end = source.index("            for stream in select.select", start)
wait = "while True:\n" + textwrap.indent(textwrap.dedent(source[start:end]), "    ") + "    break\n"
start = source.index('        if ended == "stopped":')
end = source.index("\nfinally:", start)
finish = textwrap.dedent(source[start:end])
class Clock:
    now = 0
    def monotonic(self):
        return self.now

for goal in ("guests", "guests-maint", "guests-update", "guests-topology", "online", "desktop", "update", "bless"):
    clock = Clock()
    state = dict(time=clock, re=re, timing=b"", last_progress=0, last_step="boot",
                 deadline=20000, ended="stopped", result=0, verdicts={b"result": 0},
                 drain_test=goal in ("guests", "guests-maint", "guests-update", "guests-topology", "online"),
                 print=lambda *args, **kwargs: None)
    def feed(chunk):
        state["chunk"] = chunk
        exec(timing, state)
    def tick(now):
        clock.now = now
        exec(wait, state)
        return state["ended"]
    assert tick(5999) == "stopped"
    feed(b"CV-TIME pf-l2-start -42\r")
    assert state["last_step"] == "boot"  # Partial lines do not count.
    feed(b"\n")
    assert state["last_progress"] == 5999
    clock.now = 6001
    feed(b"CV-DIAG alive\nCV-TIME invalid nope\nnoise CV-TIME fake 1\n")
    assert state["last_progress"] == 5999
    assert tick(11998) == "stopped"
    want = "stalled after pf-l2-start" if state["drain_test"] else "stopped"
    assert tick(11999) == want
    if state["drain_test"]:
        exec(finish, state)  # A stall must not wait again or become a successful poweroff.
        assert state["ended"] == want
    assert state["result"] == 0 and state["verdicts"] == {b"result": 0}
    state.update(ended="stopped", last_progress=0, last_step="boot")
    assert tick(6000) == ("stalled after boot" if state["drain_test"] else "stopped")
    state.update(ended="stopped", deadline=6000)
    assert tick(6000) == "timeout"
    state.update(ended="stopped", deadline=20000)
    feed(b"CV-TIME firewall-update 99999999\nCV-TIME wan-update 1\n")
    assert state["last_step"] == "wan-update" and state["last_progress"] == 6000
    assert tick(11999) == "stopped"
print("test-vm-runner: progress stalls, split markers, noise and deadline precedence passed")
PY
