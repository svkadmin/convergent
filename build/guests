#!/bin/sh
# guests: add guest images to a release for online delivery.
#   build/guests <release-dir> <guests-dir>
set -eu
export LC_ALL=C
umask 077

here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"
keys=/etc/convergent/keys
die() { echo "guests: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"
[ $# = 2 ] || die "usage: build/guests <release-dir> <guests-dir>"
dir=$1
src=$2
[ -f "$dir/manifest" ] || die "no manifest in $dir"
! grep -Eq '^guest([[:space:]]|$)' "$dir/manifest" || die "manifest already has guests"
[ ! -e "$dir/guests" ] && [ ! -L "$dir/guests" ] || die "guests already exists in $dir"
for g in fw wan svc browser; do
	[ -d "$src/$g" ] || continue
	[ ! -L "$src/$g" ] || die "$g is a symlink"
	files=$(awk 'NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-fA-F]/ {exit 1}
		{ sub(/^\*/, "", $2); if ($2 !~ /^[A-Za-z0-9._-]+$/ || $2 == "." || $2 == ".." || seen[$2]++) exit 1; print $2 }' "$src/$g/SHA256SUMS") || die "invalid $g/SHA256SUMS"
	[ -n "$files" ] || die "empty $g/SHA256SUMS"
	case $g in
	svc) files="$files incus.yaml" ;;
	browser)
		[ ! -L "$src/$g/incus" ] || die "browser/incus is a symlink"
		for f in "$src/$g"/incus/*.yaml; do files="$files incus/${f##*/}"; done
		;;
	esac
	files=$(printf '%s\n' $files | sort -u)
	mkdir -p "$dir/guests/$g"
	for f in SHA256SUMS $files; do
		printf '%s\n' "$f" | grep -Eq '^([A-Za-z0-9._-]+|incus/[A-Za-z0-9._-]+\.yaml)$' || die "invalid guest path: $f"
		[ -f "$src/$g/$f" ] && [ ! -L "$src/$g/$f" ] || die "missing $g/$f"
		mkdir -p "$(dirname "$dir/guests/$g/$f")"
		cp "$src/$g/$f" "$dir/guests/$g/$f"
	done
	(cd "$dir/guests/$g" && sha256sum -c SHA256SUMS) || die "$g checksum mismatch"
	echo "guest $g $(sha256sum <"$dir/guests/$g/SHA256SUMS" | cut -d' ' -f1)" >>"$dir/manifest"
	for f in SHA256SUMS $files; do
		path=guests/$g/$f
		case $f in
		*.qcow2)
			echo "unpacked $path $(stat -c %s "$dir/$path")" >>"$dir/manifest"
			zstd -q -T0 -10 --long=27 "$dir/$path" -o "$dir/$path.zst"
			rm "$dir/$path"
			path=$path.zst
			;;
		esac
		printf '%s  %s\n' "$(sha256sum <"$dir/$path" | cut -d' ' -f1)" "$path" >>"$dir/manifest"
		echo "size $path $(stat -c %s "$dir/$path")" >>"$dir/manifest"
	done
done
[ ! -f "$keys/$CHANNEL.key" ] || "$here/sign" "$dir"
