#!/bin/sh
# URL bytes cross sudo, the root re-exec and Incus only on stdin.
set -eu
here=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-browser-url: $*" >&2; exit 1; }
check_script() { [ -s "$1" ] || die "empty extraction: $1"; sh -n "$1"; }
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
sed -n '/^send_url() {/,/^}/p' "$repo/tools/browser" >"$work/send"
sed -n '/^if \[ "$(id -u)" != 0 \]; then$/,/^fi$/p' "$repo/tools/browser" >"$work/owner"
sed -n '/^if \[ "${1:-}" = --session \]; then$/,/^fi$/p' "$repo/tools/browser" |
    sed 's/exec env /mock_env /' >"$work/session"
sed -n '/^\[ "${1:-}" = --privileged \]/,/^uid=\$SUDO_UID$/p' "$repo/tools/browser" |
    sed '$d; s|/usr/local/sbin/portal gateway|portal gateway|' >"$work/privileged"
sed -n '/^send_url "\$@" .*| incus /,/^browser=\$!$/p' "$repo/tools/browser" >"$work/incus"
sed -n '/^url=\$(head -c /,/^\[ -S \/mnt\/browser\/wayland-0 \]/p' \
    "$repo/guests/browser/rootfs/usr/local/bin/browser-launch" |
    sed '$d; s|\[ -f /run/browser-portal \]|[ "$portal_mode" = 1 ]|' >"$work/guest"
for part in send owner session privileged incus guest; do check_script "$work/$part"; done
. "$work/send"
id() { echo 1000; }
swaymsg() { return 1; }
portal() { [ "$*" = gateway ] || exit 97; printf '%s\n' http-gateway; }
sudo() {
    printf '%s\n' "$@" >"$work/sudo-args"
    [ "$1 $2" = '-- /usr/local/sbin/browser' ] || return 1
    shift 2
    . "$work/session"
}
mock_env() {
    printf '%s\n' "$@" >"$work/env-args"
    [ "$#" -ge 9 ] || return 1
    shift 5
    . "$work/privileged"
    send_url "$@" >"$work/host-input"
    name=tmp-20 launcher=/usr/local/bin/browser-launch run=$work
    . "$work/incus"
    wait "$browser"
}
incus() {
    printf '%s\n' "$@" >"$work/incus-args"
    [ "$*" = '--force-local --project default exec tmp-20 --mode non-interactive --user 1000 --group 1000 -- /usr/local/bin/browser-launch' ] || return 1
    cat >"$work/guest-input"
    set --
    . "$work/guest" <"$work/guest-input"
    printf '%s\n' "$#" "$@" >"$work/chromium-input"
}
WAYLAND_DISPLAY=wayland-1 SWAYSOCK=/run/user/1000/sway.sock SUDO_UID=1000
# Quotes, backslashes, whitespace and trailing newlines survive as data.
token='https://example.org/login?token=SECRET&x="quoted"\path
second line
'
for sample in token default grafana incus portal portal_default; do
    (
        case $sample in
            token) set -- tmp "$token" ;;
            default) set -- def ;;
            grafana) set -- int ;;
            incus) set -- int https://100.80.1.10:8443/ui/ ;;
            portal) set -- tmp --portal "$token" ;;
            portal_default) set -- tmp --portal ;;
        esac
        . "$work/owner"
    )
    for args in sudo env incus; do
        if grep -q SECRET "$work/$args-args"; then die "URL leaked to $args"; fi
    done
    cmp "$work/host-input" "$work/guest-input"
    case $sample in
        token) printf '%s\n' 1 "$token" ;;
        default) printf '0\n' ;;
        grafana) printf '%s\n' 1 http://100.80.2.10:3000/ ;;
        incus) printf '%s\n' 1 https://100.80.1.10:8443/ui/ ;;
        portal) printf '%s\n' 2 --disable-gpu "$token" ;;
        portal_default) printf '%s\n' 2 --disable-gpu http://http-gateway/ ;;
    esac >"$work/expected"
    cmp "$work/expected" "$work/chromium-input"
done
# Malformed input, disallowed int URLs and URLs supplied as root arguments fail closed.
for sample in missing count unexpected empty scheme int args remmina oversized; do
    printf '1\nhttps://example.org/?token=SECRET' >"$work/input"
    case $sample in
        missing) : >"$work/input" ;;
        count) printf '2\n' >"$work/input" ;;
        unexpected) printf '0\nhttps://example.org/' >"$work/input" ;;
        empty) printf '1\n' >"$work/input" ;;
        scheme) printf '1\nfile:///etc/passwd' >"$work/input" ;;
        oversized) printf '1\nhttps://' >"$work/input"
            head -c 131072 /dev/zero | tr '\000' x >>"$work/input" ;;
    esac
    rc=0
    (
        set -- --privileged wayland-1 /run/user/1000/sway.sock tmp
        case $sample in
            int) set -- --privileged wayland-1 /run/user/1000/sway.sock int ;;
            args) set -- "$@" https://example.org/ ;;
            remmina) set -- --privileged wayland-1 /run/user/1000/sway.sock remmina ;;
        esac
        . "$work/privileged" <"$work/input"
    ) >"$work/error" 2>&1 || rc=$?
    [ "$rc" != 0 ] || die "accepted $sample"
    # Empty stdin is the legacy no-URL form, checked below.
    [ "$sample" != remmina ] && [ "$sample" != missing ] || continue
    rc=0
    (
        role=tmp portal_mode=
        set --
        case $sample in
            int) role=int ;;
            args) set -- https://example.org/ ;;
        esac
        . "$work/guest" <"$work/input"
    ) >"$work/error" 2>&1 || rc=$?
    [ "$rc" != 0 ] || die "guest accepted $sample"
done
(
    set -- --privileged wayland-1 /run/user/1000/sway.sock remmina
    printf '0\n' >"$work/input"
    . "$work/privileged" <"$work/input"
    [ "$#" = 0 ]
)
# Rollback: a 0.1.5 or older host runs the launcher with --disable-stdin and the URL as an argument.
for sample in token default grafana incus portal; do
    rc=0
    (
        role=tmp portal_mode=
        set --
        case $sample in
            token) set -- "$token" ;;
            default) role=def ;;
            grafana) role=int ;;
            incus) role=int; set -- https://100.80.1.10:8443/ui/ ;;
            portal) portal_mode=1; set -- "$token" ;;
        esac
        . "$work/guest" </dev/null
        printf '%s\n' "$#" "$@" >"$work/chromium-input"
    ) >"$work/error" 2>&1 || rc=$?
    [ "$rc" = 0 ] || die "guest rejected legacy $sample"
    case $sample in
        token) printf '%s\n' 1 "$token" ;;
        default) printf '0\n' ;;
        grafana) printf '%s\n' 1 http://100.80.2.10:3000/ ;;
        incus) printf '%s\n' 1 https://100.80.1.10:8443/ui/ ;;
        portal) printf '%s\n' 2 --disable-gpu "$token" ;;
    esac >"$work/expected"
    cmp "$work/expected" "$work/chromium-input"
done
for sample in count scheme int oversized portal_default; do
    rc=0
    (
        role=tmp portal_mode=
        set --
        case $sample in
            count) set -- https://example.org/ https://example.com/ ;;
            scheme) set -- file:///etc/passwd ;;
            int) role=int; set -- https://example.org/ ;;
            oversized) set -- "https://$(head -c 131072 /dev/zero | tr '\000' x)" ;;
            portal_default) portal_mode=1 ;;
        esac
        . "$work/guest" </dev/null
    ) >"$work/error" 2>&1 || rc=$?
    [ "$rc" != 0 ] || die "guest accepted legacy $sample"
done
# An argv-only installed guest must fail before portal, unlock/import or Grafana.
sed -n '/^# Refuse argv-only guests /,/^\[ -z "\$portal_mode" \]/p' "$repo/tools/browser" |
    sed 's|/usr/local/sbin/incus-ui|service_call|g; s|/usr/local/sbin/portal begin|service_call begin|' >"$work/services"
check_script "$work/services"
guest=$repo/guests/browser/rootfs/usr/local/bin/browser-launch
sed '/^url=\$(head -c /,/^esac$/d' "$guest" >"$work/argv-only"
check_script "$work/argv-only"
# A guest from before the Incus session home: it would hand Grafana's home and caches to the certificate.
sed 's#^\(\[ .* || profile=/run/incus-ui/profile\) home=/run/incus-ui/home$#\1#' "$guest" >"$work/shared"
if cmp -s "$guest" "$work/shared"; then die 'launcher lacks the Incus session home'; fi
for version in current old missing shared; do
    for mode in def tmp portal grafana incus remmina; do
        : >"$work/services-called"
        rc=0
        (
            role=$mode name=$mode portal_mode= incus_ui=
            case $mode in
                portal) role=tmp portal_mode=1 ;;
                grafana) role=int ;;
                incus) role=int incus_ui=1 ;;
            esac
            launcher=$guest
            case $version in old) launcher=$work/argv-only ;; missing) launcher=$work/missing ;; shared) launcher=$work/shared ;; esac
            service_call() { printf '%s\n' "$*" >>"$work/services-called"; }
            portal_on() { return 0; }
            ic() {
                if [ "$1" = exec ] && [ "$2" = "$name" ]; then
                    [ "$3" = -- ] || return 1
                    shift 3
                    case $1 in /usr/local/sbin/browser-setup) service_call "$@" ;; *) "$@" ;; esac
                else
                    service_call "$@"
                fi
            }
            # The bounded probe runs incus through timeout; forward both to the ic mock.
            timeout() { shift 3; "$@"; }
            incus() { [ "$1 $2 $3" = '--force-local --project default' ] && shift 3; ic "$@"; }
            . "$work/services"
        ) >"$work/error" 2>&1 || rc=$?
        if [ "$version" = current ] || [ "$mode" = remmina ] || { [ "$version" = shared ] && [ "$mode" != incus ]; }; then
            [ "$rc" = 0 ] || die "rejected $version $mode"
            case $mode in
                portal) grep -qx begin "$work/services-called" ;;
                # The Incus-only policy is in place before the certificate enters int.
                incus) printf '%s\n' '/usr/local/sbin/browser-setup incus-ui' --unlock --import >"$work/expected"
                    cmp "$work/expected" "$work/services-called" ;;
                grafana) grep -qx 'exec svc -- rc-service grafana start' "$work/services-called" ;;
                *) [ ! -s "$work/services-called" ] ;;
            esac
        else
            [ "$rc" != 0 ] && [ ! -s "$work/services-called" ] || die "opened $version $mode"
            # Only the Incus session line is missing: this release's guests are staged already.
            if [ "$version" = shared ]; then grep -q 'close the browsers, then sys guests update' "$work/error"
            else grep -q 'run sys update install' "$work/error"; fi
        fi
    done
done
# A hostile guest can stall the probe: it must stay bounded.
grep -q 'timeout -k 1 30 incus --force-local --project default exec "\$name" --' "$work/services" ||
    die 'compatibility probe is unbounded'
sed -n '/^attempts=0$/,/^done$/p' "$repo/tools/browser" >"$work/readiness"
check_script "$work/readiness"
grep -qF 'timeout -k 1 30 incus --force-local --project default exec "$name" -- test -f "$ready" 9>&- 8>&- 7>&- 6>&-' "$work/readiness" ||
    die 'readiness probe is unbounded'
for succeed in 1 30 31; do
    : >"$work/attempts"
    rc=0
    (
        name=fixture ready=/run/browser-ready
        timeout() { shift 3; "$@"; }
        incus() {
            [ "$*" = "--force-local --project default exec $name -- test -f $ready" ] || exit 1
            for fd in 6 7 8 9; do
                if (eval ": >&$fd") 2>/dev/null; then die "readiness inherited lock $fd"; fi
            done
            echo probe >>"$work/attempts"
            [ "$(wc -l <"$work/attempts")" -eq "$succeed" ] || return 124
        }
        sleep() { :; }
        exec 6>"$work/lock6" 7>"$work/lock7" 8>"$work/lock8" 9>"$work/lock9"
        . "$work/readiness"
    ) >"$work/error" 2>&1 || rc=$?
    if [ "$succeed" = 31 ]; then
        [ "$rc" != 0 ] || die 'readiness exceeded 30 attempts'
        [ "$(wc -l <"$work/attempts")" -eq 30 ]
        grep -q 'browser setup timed out' "$work/error"
    else
        [ "$rc" = 0 ] || die "readiness rejected attempt $succeed"
        [ "$(wc -l <"$work/attempts")" -eq "$succeed" ]
    fi
done
# Guard placement matters: no earlier service opening may bypass it.
awk '/^# Refuse argv-only guests / {guard = NR}
    /\/usr\/local\/sbin\/portal begin|\/usr\/local\/sbin\/incus-ui --unlock|rc-service grafana start/ {
        if (!guard || NR <= guard) exit 1
    }' "$repo/tools/browser"
# A full pipe must not leave its writer holding session lock descriptors.
(
    sed 's/^send_url()/write_url()/' "$work/send" >"$work/write"
    check_script "$work/write"
    . "$work/write"
    closed() {
        for fd in 6 7 8 9; do
            if (eval ": >&$fd") 2>/dev/null; then die "inherited lock $fd"; fi
        done
    }
    send_url() {
        closed
        : >"$work/writer-ready"
        write_url "$@"
        : >"$work/writer-done"
    }
    incus() {
        closed
        attempts=0
        until [ -f "$work/writer-ready" ]; do
            attempts=$((attempts + 1))
            [ "$attempts" -lt 50 ] || die 'writer did not start'
            sleep .1
        done
        [ ! -e "$work/writer-done" ] || die 'writer did not block'
        cat >"$work/blocked-input"
    }
    exec 6>"$work/lock6" 7>"$work/lock7" 8>"$work/lock8" 9>"$work/lock9"
    name=tmp-20 launcher=/usr/local/bin/browser-launch run=$work
    set -- "https://example.org/$(head -c 131000 /dev/zero | tr '\000' x)"
    . "$work/incus"
    wait "$browser"
    [ -f "$work/writer-done" ]
    write_url "$@" >"$work/expected"
    cmp "$work/expected" "$work/blocked-input"
)
# An Incus session never opens what a Grafana session wrote: int's per-boot tmpfs holds its profile, home and caches.
sed -n '/^profile=\/home\/browser\/profile home=\/home\/browser$/,$p' "$guest" | sed 's/^exec env -i /launch_env /' >"$work/profile"
check_script "$work/profile"
grep -q '^launch_env ' "$work/profile" || die 'unexpected launcher exec'
grep -q '^    mount -t tmpfs -o size=[0-9]*m,mode=0700,nosuid,nodev,noexec tmpfs /run/incus-ui$' \
    "$repo/guests/browser/rootfs/usr/local/sbin/browser-setup" || die 'the Incus profile is not on tmpfs'
launch_env() { printf '%s\n' "$@" >"$work/launch"; }
for sample in grafana incus def; do
    home=/home/browser profile=/home/browser/profile other=/run/incus-ui
    case $sample in
        grafana) role=int; set -- http://100.80.2.10:3000/ ;;
        incus) role=int; set -- https://100.80.1.10:8443/ui/; home=/run/incus-ui/home profile=/run/incus-ui/profile other=/home/browser ;;
        def) role=def; set -- https://100.80.1.10:8443/ui/ ;;
    esac
    (. "$work/profile")
    printf '%s\n' "HOME=$home" "XDG_CACHE_HOME=$home/.cache" "XDG_CONFIG_HOME=$home/.config" "--user-data-dir=$profile" >"$work/expected"
    grep -E '^(HOME|XDG_CACHE_HOME|XDG_CONFIG_HOME)=|^--user-data-dir=' "$work/launch" | cmp -s "$work/expected" - &&
        ! grep -qF "$other" "$work/launch" || die "launcher paths for $sample"
done
# Policies as the image builds them; int boots into Grafana's, an Incus session narrows to its origin.
root=$work/root
mkdir -p "$root/run" "$root/etc/chromium/policies/managed"
sed -n '/^for role in def tmp int; do$/,/^done$/p' "$repo/guests/browser/build" >"$work/policy-build"
check_script "$work/policy-build"
(here=$repo/guests/browser; . "$work/policy-build")
setup=$repo/guests/browser/rootfs/usr/local/sbin/browser-setup
paths="s|/usr/share/convergent-browser/|$root/usr/share/convergent-browser/|g; s|/etc/chromium/|$root/etc/chromium/|g; s|/run/|$root/run/|g"
sed -n '/^mode=normal$/,/managed\/browser\.json$/p' "$setup" | sed "$paths" >"$work/policy-boot"
sed -n '/^if \[ "\$#" = 1 \] && \[ "\$1" = incus-ui \]; then$/,/^fi$/p' "$setup" | sed "$paths" >"$work/policy-incus"
for part in policy-boot policy-incus; do check_script "$work/$part"; done
policy=$root/etc/chromium/policies/managed/browser.json
for role in def tmp int; do
    (unset BROWSER_PORTAL; . "$work/policy-boot")
    case $role in
        def) jq -e 'has("URLAllowlist") | not' "$policy" >/dev/null ;;
        tmp) jq -e '.IncognitoModeAvailability == 2 and .MetricsReportingEnabled == false' "$policy" >/dev/null ;;
        # Grafana's policy names no Incus origin.
        int) jq -e '.URLAllowlist == ["http://100.80.2.10:3000"] and
            .ManagedBookmarks == [{"name": "Grafana", "url": "http://100.80.2.10:3000/"}] and
            ([.. | strings | select(contains("8443"))] | length) == 0 and .DownloadDirectory == "/home/browser/Downloads/int" and
            .RestoreOnStartupURLs == ["http://100.80.2.10:3000/"] and .MetricsReportingEnabled == false' "$policy" >/dev/null ;;
    esac || die "boot policy for $role"
done
cp "$policy" "$work/grafana-policy"
for sample in def unready int; do
    rm -f "$root/run/incus-ui-ready"
    cp "$work/grafana-policy" "$policy"
    case $sample in def) echo def ;; *) echo int ;; esac >"$root/run/browser-role"
    [ "$sample" != int ] || : >"$root/run/incus-ui-ready"
    rc=0
    (set -- incus-ui; . "$work/policy-incus") >"$work/error" 2>&1 || rc=$?
    if [ "$sample" = int ]; then
        [ "$rc" = 0 ] || die 'Incus session policy refused'
        jq -e '.URLAllowlist == ["https://100.80.1.10:8443"] and .URLBlocklist[0] == "*" and
            .RestoreOnStartupURLs == ["https://100.80.1.10:8443/ui/"] and (.ManagedBookmarks | length) == 1 and
            .MetricsReportingEnabled == false and .DeveloperToolsAvailability == 2 and
            .DownloadDirectory == "/run/incus-ui/home/Downloads"' "$policy" >/dev/null ||
            die 'Incus session policy allows more than the Incus origin'
    else
        [ "$rc" != 0 ] && cmp -s "$work/grafana-policy" "$policy" || die "narrowed the policy of a $sample container"
    fi
done
# browser-setup prepares that home, its downloads and the session's nssdb at both NSS paths.
sed -n '/^if \[ "\$role" = int \]; then$/,/^fi$/p' "$setup" |
    sed "s|/home/browser/|$root/home/browser/|g; s|/run/|$root/run/|g" >"$work/setup-int"
check_script "$work/setup-int"
(
    role=int
    mount() { printf '%s\n' "$*" >>"$work/mounts"; }
    certutil() { : >"$root/run/incus-ui/nssdb/cert9.db"; }
    chown() { :; }
    . "$work/setup-int"
)
for nss in .pki/nssdb .local/share/pki/nssdb; do
    [ -d "$root/run/incus-ui/home/$nss" ] && grep -qxF -- "-o bind $root/run/incus-ui/nssdb $root/run/incus-ui/home/$nss" "$work/mounts" ||
        die "Incus session home lacks $nss"
done
[ -d "$root$(jq -r .DownloadDirectory "$policy")" ] || die 'Incus session downloads missing'
echo 'browser-url: stdin boundaries, defaults, portal, allowlist, mixed versions, rollback hosts and writer locks passed'
echo 'browser-url: Incus sessions get a tmpfs profile, home, caches and downloads and the Incus origin alone; Grafana sessions keep theirs'
