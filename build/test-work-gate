#!/bin/sh
# Run the production gate with fake transports and a real N-segment parser.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
mkdir -p "$work/bin" "$work/state"
export GATE_FIXTURE=$work
export PATH=$work/bin:$PATH
sh "$here/networks" registry "$work/registry"
lib=$repo/rootfs/usr/lib/convergent/incus
sed -e "s|^lib=.*|lib=$lib|" -e "s|^state=.*|state=$work/state|" \
	-e "s|/usr/lib/convergent/guest-reply.sh|$lib/../guest-reply.sh|g" \
	-e "s|/run/convergent/work-gate|$work/gate|g" \
	-e "s|/etc/convergent/topology.sha256|$work/expected|g" \
	-e "s|/etc/convergent/segments|$work/registry/etc/convergent/segments|g" "$lib/work-gate" >"$work/gate"
echo expected >"$work/expected"
# down: no answer; unhealthy: answers without a working resolver; pfdown: answers with PF disabled.
cat >"$work/bin/ssh" <<'SSH'
#!/bin/sh
while [ "$#" -gt 2 ]; do shift; done
node=$1 cmd=$2
[ ! -f "$GATE_FIXTURE/$node.down" ] || exit 1
case $cmd in
*topology*|*expected*) cat "$GATE_FIXTURE/$node.hash" ;;
*)
    case $cmd in *'timeout -k 1 5 sh -c'*) ;; *) echo 'resolver check is not bounded' >&2; exit 2 ;; esac
    role=$(cat "$GATE_FIXTURE/$node.role")
    awk -v role="$role" '$1 !~ /^#/ {print $1 ": flags=41<UP,RUNNING>"; print " carp: " role " carpdev " $3 " vhid " $2}' "$GATE_FIXTURE/registry/etc/convergent/segments"
    if [ -f "$GATE_FIXTURE/$node.pfdown" ]; then echo 'Status: Disabled'; else echo 'Status: Enabled'; fi
    [ ! -f "$GATE_FIXTURE/$node.hung" ] || exit 124
    printf 'pfsync0: flags=41<UP,RUNNING>\n defer: on\n'
    [ -f "$GATE_FIXTURE/$node.unhealthy" ] || echo CV-UNBOUND-OK
    if [ -f "$GATE_FIXTURE/$node.liveflood" ]; then head -c 65537 /dev/zero; fi
    ;;
esac
if [ -f "$GATE_FIXTURE/$node.flood" ]; then head -c 65537 /dev/zero; fi
if [ -f "$GATE_FIXTURE/$node.short" ]; then exit 1; fi
SSH
# The exact transactions: an open gate is a flushed chain, a closed one a flush plus the drop rule.
cat >"$work/bin/nft" <<'NFT'
#!/bin/sh
if [ "$*" = 'flush chain bridge host-l2 work_gate' ]; then echo open >"$GATE_FIXTURE/verdict"; exit 0; fi
[ "$*" = '-f -' ] || exit 1
[ "$(cat)" = 'flush chain bridge host-l2 work_gate
add rule bridge host-l2 work_gate drop' ] || exit 1
echo closed >"$GATE_FIXTURE/verdict"
NFT
printf '#!/bin/sh\nexit 0\n' >"$work/bin/flock"
cp "$work/bin/flock" "$work/bin/logger"
chmod +x "$work/bin/ssh" "$work/bin/nft" "$work/bin/flock" "$work/bin/logger"
for node in wan fw1 fw2; do echo expected >"$work/$node.hash"; done
echo MASTER >"$work/fw1.role"
echo BACKUP >"$work/fw2.role"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ]
# Valid prefixes with trailing bytes or failed transfers must not preserve validation.
for node in wan fw1 fw2; do
    for fault in flood short; do
        touch "$work/$node.$fault"
        if sh "$work/gate"; then exit 1; fi
        [ "$(cat "$work/verdict")" = closed ] && [ ! -e "$work/gate.valid" ]
        rm "$work/$node.$fault"
        sh "$work/gate"
    done
done
for node in fw1 fw2; do
    touch "$work/$node.liveflood"
    if sh "$work/gate"; then exit 1; fi
    [ "$(cat "$work/verdict")" = closed ] && [ ! -e "$work/gate.valid" ]
    rm "$work/$node.liveflood"
    sh "$work/gate"
done
touch "$work/fw2.down"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ]
sh "$work/gate" close
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ]
rm "$work/fw2.down"
sh "$work/gate"
echo mismatch >"$work/fw2.hash"
if sh "$work/gate"; then exit 1; fi
[ ! -e "$work/gate.valid" ]
echo expected >"$work/fw2.hash"
sh "$work/gate"
# A standby whose resolver is down is missing, not a mismatch; one that answers without PF closes the gate.
touch "$work/fw2.unhealthy"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ] && [ -e "$work/gate.valid" ] || exit 1
rm "$work/fw2.unhealthy"
touch "$work/fw2.pfdown"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ] && [ ! -e "$work/gate.valid" ] || exit 1
rm "$work/fw2.pfdown"
sh "$work/gate"
touch "$work/fw1.pfdown"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ] && [ ! -e "$work/gate.valid" ] || exit 1
rm "$work/fw1.pfdown"
sh "$work/gate"
# Partial PF output survives a hung resolver or failed transport.
touch "$work/fw1.pfdown" "$work/fw1.hung"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ]
[ ! -e "$work/gate.valid" ]
rm "$work/fw1.pfdown" "$work/fw1.hung"
sh "$work/gate"
# A healthy reply cut off by the timeout is unanswered: a loaded standby keeps a validated gate open.
touch "$work/fw2.hung"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ] && [ -e "$work/gate.valid" ]
rm "$work/fw2.hung"
# Two masters close the gate but keep validation: a failover seen half-way reopens once one remains.
echo MASTER >"$work/fw2.role"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ] && [ -e "$work/gate.valid" ] || exit 1
touch "$work/fw1.down"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ]
rm "$work/fw1.down"
echo BACKUP >"$work/fw2.role"
sh "$work/gate"
# Nobody answers (timeouts): a validated gate keeps its state, an unvalidated one closes.
touch "$work/fw1.down" "$work/fw2.down"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = open ] && [ -e "$work/gate.valid" ] || exit 1
touch "$work/wan.down"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = open ]
sh "$work/gate" close
rm "$work/wan.down"
if sh "$work/gate"; then exit 1; fi
[ "$(cat "$work/verdict")" = closed ]
rm "$work/fw1.down" "$work/fw2.down"
sh "$work/gate"
[ "$(cat "$work/verdict")" = open ]
mkdir "$work/state/fw.topology"
if sh "$work/gate"; then exit 1; fi
[ ! -e "$work/gate.valid" ]
echo 'test-work-gate: standby outage, unanswered probes, PF disabled, two masters, invalidation and mismatch passed'
