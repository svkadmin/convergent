#!/bin/sh
# lint: checks before a push. Run from the repository root; no root needed.
#   build/lint      exit 0 clean, 1 findings
set -u

here=$(cd "$(dirname "$0")" && pwd)
cd "${here%/build}" || exit 1
fail=0
bad() { echo "lint: $*"; fail=1; }
sh build/test --install-options || bad 'install options selftest failed'
sh build/test-vm-runner || bad 'VM runner selftest failed'
offline_start=$(date +%s)
for dependency in python3 jq openssl; do
    command -v "$dependency" >/dev/null 2>&1 || bad "offline preflight requires $dependency"
done
sh build/test --networks || bad 'networks selftest failed'
sh build/test-topology || bad 'topology selftest failed'
sh build/test-leases || bad 'leases selftest failed'
sh build/test-firewall-heal || bad 'firewall self-heal selftest failed'
sh build/test --remmina-unit || bad 'Remmina selftest failed'
sh build/test --observability || bad 'observability selftest failed'
sh build/test-incus-ui --offline || bad 'Incus UI selftest failed'
echo "lint: offline preflight took $(($(date +%s) - offline_start))s"
if command -v python3 >/dev/null 2>&1; then
	python3 -I guests/svc/dashboards/build.py --check || bad 'dashboard JSON drift'
else
	echo 'lint: python3 not installed, dashboard drift check skipped'
fi

# Tracked files; an exported tree (no .git) is checked whole.
files=$(git ls-files 2>/dev/null) || files=$(find . -type f ! -path './.git/*' | sed 's|^\./||')

# Incus 7.0.1 refuses --project with query: the project belongs in the URL.
hits=$(printf '%s\n' $files | grep -v -e '\.md$' -e '^build/lint$' |
	xargs grep -nE -- '--project [^ ]+ query |query --project' 2>/dev/null) &&
	{ printf '%s\n' "$hits" | sed 's/^/lint: /'; bad 'incus query takes its project in the URL, not --project'; }

# Shell: every script, init script and sourced module parses.
scripts=
for f in $files; do
	case $f in rootfs/usr/lib/convergent/sys/*) scripts="$scripts $f"; continue ;; esac
	IFS= read -r first <"$f" 2>/dev/null || continue
	# OpenBSD rc.subr refuses any other interpreter.
	case $f:$first in guests/fw/site/etc/rc.d/*:'#!/bin/ksh') ;; guests/fw/site/etc/rc.d/*) bad "$f: rc.d scripts need #!/bin/ksh" ;; esac
	case $first in '#!'*sh* | '#!/sbin/openrc-run'*) scripts="$scripts $f" ;; esac
done
for f in $scripts; do sh -n "$f" 2>/dev/null || bad "$f: sh -n fails"; done
if command -v shellcheck >/dev/null 2>&1; then
	# POSIX sh is the target; init scripts use OpenRC's dialect.
	for f in $scripts; do
		case $(head -n 1 "$f") in *openrc-run*) continue ;; esac
		# sys modules set title and actions; tools/sys sources them and calls those actions.
		e=; case $f in rootfs/usr/lib/convergent/sys/*) e=,SC2120 ;; esac
		# Not followed: sourced config and helpers (1090, 2154), their variables (2034), a= b= lists (1007).
		shellcheck -s sh -S warning -e "SC1007,SC1090,SC2034,SC2154$e" "$f" >/dev/null 2>&1 || bad "$f: shellcheck (run: shellcheck -s sh $f)"
	done
else
	echo "lint: shellcheck not installed, skipped"
fi

# Leaks: test passwords, private keys, agent session ids or scratch paths, Windows paths.
for f in $files; do
	grep -Iq . "$f" 2>/dev/null || continue
	[ "$f" != build/lint ] || continue
	# Public GUIDs: the EFI global variables and systemd-boot's loader variables.
	grep -nE 'BEGIN [A-Z ]*PRIVATE KEY|AppData|scratchpad|claude/C--|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' "$f" |
		grep -vE '8be4df61-93ca-11d2-aa0d-00e098032b8c|4a67b082-0a4c-41cf-b6c7-440b29bb8c4f' |
		while IFS= read -r hit; do echo "lint: $f:$hit"; done | grep . && fail=1
done

# Line endings: LF only (.gitattributes).
for f in $files; do
	grep -Iq . "$f" 2>/dev/null || continue
	! grep -q "$(printf '\r')" "$f" || bad "$f: CRLF line endings"
done

# Docs: every repository path they name exists.
for d in README.md USAGE.md RECOVERY.md ARCHITECTURE.md; do
	grep -oE '`(build|tools|rootfs|guests|install|initramfs|portage)/[A-Za-z0-9._/-]+`' "$d" | tr -d '`' | sort -u |
		while read -r p; do
			case $p in *'<'* | *'*'*) continue ;; esac
			[ -e "$p" ] || [ -e "${p%/}" ] || echo "lint: $d names $p, which does not exist"
		done | grep . && fail=1
done

[ "$fail" = 0 ] && echo "lint: clean"
exit "$fail"
