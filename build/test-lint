#!/bin/sh
# Text that resembles shell commands is not necessarily executable code.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
mkdir -p "$work/tree/build" "$work/cases"
cp "$here/lint" "$work/tree/build/lint"
# Exercise the exported-tree scan even when TMPDIR is inside a checkout.
GIT_CEILING_DIRECTORIES=$work
export GIT_CEILING_DIRECTORIES
cat >"$work/cases/negation" <<'SH'
#!/bin/sh
if test -f source &&
    ! grep -q allowed source
then :; fi
absent() {
    ! test -f "$1"
}
SH
cat >"$work/cases/source" <<'SH'
#!/bin/sh
cat <<'EXPECTED'
. /usr/lib/convergent/guest-reply.sh
EXPECTED
SH
cat >"$work/cases/query" <<'SH'
#!/bin/sh
# incus query /1.0 --project default
incus query '/1.0/instances?recursion=1&project=default'
SH
cat >"$work/cases/functions" <<'SH'
#!/bin/sh
cat <<'EXPECTED'
unbound-control() { :; }
timeout() { :; }; unbound-control() { :; }
EXPECTED
SH
cat >"$work/cases/sed" <<'SH'
#!/bin/sh
sed -n '/C:\\Users/p' source
sed 's/old/new/' 'C:\Users\source'
SH
for sample in negation source query functions sed; do
    cp "$work/cases/$sample" "$work/tree/build/test-case"
    sh -n "$work/tree/build/test-case"
    dash -n "$work/tree/build/test-case"
    if sh "$work/tree/build/lint" --rules >"$work/output" 2>&1; then :
    else cat "$work/output"; echo "test-lint: rejected $sample"; exit 1; fi
done
# Parse executable mocks after extraction, including inline definitions.
sed -n "/^cat .*<<'SH'/,/^SH$/p" "$here/../guests/fw/test-facts" |
    sed '1d;$d' >"$work/mocks"
[ -s "$work/mocks" ]
sh -n "$work/mocks"
dash -n "$work/mocks"
printf '\ntimeout() { :; }; unbound-control() { :; }\n' >>"$work/mocks"
if dash -n "$work/mocks" >"$work/output" 2>&1; then
    echo 'test-lint: accepted non-POSIX mock'; exit 1
fi
echo 'test-lint: code/data controls and extracted mock syntax passed'
