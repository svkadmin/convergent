#!/bin/sh
# Longest reservations survive divergent peers, rebuilds and repeated recovery.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
lib=$here/../rootfs/usr/lib/convergent/incus
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
cat >"$work/old" <<'LEASES'
lease 100.80.32.51 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 10:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
lease 100.80.36.51 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 10:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:02;
}
LEASES
sed 's/10:00:00/12:00:00/' "$work/old" >"$work/new"
# The merge is told the time: a binding is current only until it ends.
merge() { awk -v now='2026/10/26 09:30:00' -f "$lib/leases.awk" "$@"; }
merge "$work/new" "$work/old" >"$work/merged"
sort "$work/new" >"$work/expected"
sort "$work/merged" >"$work/actual"
cmp "$work/expected" "$work/actual"
merge "$work/old" "$work/merged" >"$work/replay"
cmp "$work/merged" "$work/replay"
sed '$d' "$work/old" >"$work/torn"
if merge "$work/torn" >/dev/null; then exit 1; fi
# An unterminated record is refused before it can grow without bound.
{ sed '$d' "$work/old"; yes '  hardware ethernet 00:16:3e:00:00:09;' | head -n 200; echo '}'; } >"$work/huge"
if merge "$work/huge" >/dev/null; then exit 1; fi
# A released address reassigned later: the newer assignment wins over the old, longer reservation in any file.
cat >"$work/moved" <<'LEASES'
lease 100.80.32.51 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 12:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
lease 100.80.32.51 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 09:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
lease 100.80.32.51 {
  starts 1 2026/10/26 09:00:00 UTC;
  ends 1 2026/10/26 10:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:03;
}
LEASES
for order in "$work/moved $work/new" "$work/new $work/moved"; do
	# shellcheck disable=SC2086
	merge $order >"$work/actual"
	[ "$(grep -c '^lease 100.80.32.51 ' "$work/actual")" = 1 ]
	grep -q '00:16:3e:00:00:03' "$work/actual"
done
# A node that pinged the client its peer had just bound abandons the address later than the ACK: the bound
# record wins in either order. An abandon nothing contradicts is kept (control).
cat >"$work/abandoned" <<'LEASES'
lease 100.80.32.51 {
  starts 1 2026/10/26 11:00:00 UTC;
  ends 1 2026/10/26 13:00:00 UTC;
  abandoned;
}
lease 100.80.32.53 {
  starts 1 2026/10/26 11:00:00 UTC;
  ends 1 2026/10/26 13:00:00 UTC;
  abandoned;
}
LEASES
for order in "$work/abandoned $work/new" "$work/new $work/abandoned"; do
	# shellcheck disable=SC2086
	merge $order >"$work/actual"
	[ "$(grep -c '^lease 100.80.32.51 ' "$work/actual")" = 1 ]
	sed -n '/^lease 100.80.32.51 /,/^}/p' "$work/actual" >"$work/record"
	if grep -q abandoned "$work/record"; then exit 1; fi
	grep -q '00:16:3e:00:00:01' "$work/record"
	sed -n '/^lease 100.80.32.53 /,/^}/p' "$work/actual" | grep -q abandoned
done
# One MAC keeps one address, its newest bound record; another MAC keeps its own (control).
cat >"$work/twice" <<'LEASES'
lease 100.80.32.52 {
  starts 1 2026/10/26 11:00:00 UTC;
  ends 1 2026/10/26 13:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
LEASES
for order in "$work/twice $work/new" "$work/new $work/twice"; do
	# shellcheck disable=SC2086
	merge $order >"$work/actual"
	[ "$(grep -c '00:16:3e:00:00:01' "$work/actual")" = 1 ]
	grep -q '^lease 100.80.32.52 ' "$work/actual"
	if grep -q '^lease 100.80.32.51 ' "$work/actual"; then exit 1; fi
	grep -q '^lease 100.80.36.51 ' "$work/actual"
done
# Within one file the last declaration is current (dhcpd.leases(5)): an expired binding followed by its
# abandon stays abandoned. Across files the binding wins only while current, else the newer record does.
cat >"$work/history" <<'LEASES'
lease 100.80.32.53 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 10:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:04;
}
lease 100.80.32.53 {
  starts 1 2026/10/26 11:00:00 UTC;
  ends 1 2026/10/26 13:00:00 UTC;
  abandoned;
}
LEASES
merge "$work/history" >"$work/actual"
[ "$(grep -c '^lease 100.80.32.53 ' "$work/actual")" = 1 ]
grep -q abandoned "$work/actual"
sed -n '1,5p' "$work/history" >"$work/expired"
sed -n '6,10p' "$work/history" >"$work/abandon"
for order in "$work/expired $work/abandon" "$work/abandon $work/expired"; do
	# shellcheck disable=SC2086
	awk -v now='2026/10/26 11:30:00' -f "$lib/leases.awk" $order >"$work/actual"
	[ "$(grep -c '^lease 100.80.32.53 ' "$work/actual")" = 1 ]
	grep -q abandoned "$work/actual"
	# Still current at 09:30: the binding wins (control).
	# shellcheck disable=SC2086
	merge $order >"$work/actual"
	grep -q '00:16:3e:00:00:04' "$work/actual"
	if grep -q abandoned "$work/actual"; then exit 1; fi
done
# Without the time no binding could be called current: refused.
if awk -f "$lib/leases.awk" "$work/new" >/dev/null; then exit 1; fi
# One address per MAC holds per VLAN subnet: a client moved to another VLAN within lease time keeps both.
cat >"$work/vlans" <<'LEASES'
lease 100.80.36.52 {
  starts 1 2026/10/26 11:00:00 UTC;
  ends 1 2026/10/26 13:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
LEASES
for order in "$work/vlans $work/new" "$work/new $work/vlans"; do
	# shellcheck disable=SC2086
	merge $order >"$work/actual"
	[ "$(grep -c '00:16:3e:00:00:01' "$work/actual")" = 2 ]
	grep -q '^lease 100.80.32.51 ' "$work/actual"
	grep -q '^lease 100.80.36.52 ' "$work/actual"
done
# A MAC's expired later address must not erase its live reservation: the current binding is kept.
cat >"$work/reserved" <<'LEASES'
lease 100.80.32.51 {
  starts 1 2026/10/26 08:00:00 UTC;
  ends 1 2026/10/26 14:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
LEASES
cat >"$work/expired-move" <<'LEASES'
lease 100.80.32.52 {
  starts 1 2026/10/26 10:00:00 UTC;
  ends 1 2026/10/26 11:00:00 UTC;
  hardware ethernet 00:16:3e:00:00:01;
}
LEASES
for order in "$work/reserved $work/expired-move" "$work/expired-move $work/reserved"; do
	# shellcheck disable=SC2086
	awk -v now='2026/10/26 11:30:00' -f "$lib/leases.awk" $order >"$work/actual"
	grep -q '^lease 100.80.32.51 ' "$work/actual"
	if grep -q '^lease 100.80.32.52 ' "$work/actual"; then exit 1; fi
	# Both current at 10:30: the newer assignment wins (control).
	# shellcheck disable=SC2086
	awk -v now='2026/10/26 10:30:00' -f "$lib/leases.awk" $order >"$work/actual"
	grep -q '^lease 100.80.32.52 ' "$work/actual"
	if grep -q '^lease 100.80.32.51 ' "$work/actual"; then exit 1; fi
done
# A record left open at a file's end is refused when another file follows, and so is one cut off by the next
# declaration in the same file.
if merge "$work/torn" "$work/new" >/dev/null; then exit 1; fi
cat "$work/torn" "$work/new" >"$work/torn-inside"
if merge "$work/torn-inside" >/dev/null; then exit 1; fi
state=$work/state
mkdir -p "$state" "$work/live"
cp "$work/old" "$work/live/fw1"
cp "$work/new" "$work/live/fw2"
. "$here/../rootfs/usr/lib/convergent/guest-reply.sh"
. "$lib/fw-leases"
running() { [ -f "$work/live/$1" ]; }
rsh() { echo "${probe_limit:-30}" >>"$work/limits"; case $2 in *'cat /var/db/dhcpd.leases'*) cat "$work/live/$1" ;; *'cat >/var/db/dhcpd.leases.new'*) cat >"$work/live/$1" ;; *) echo "$2" ;; esac; }
leases_hold
cmp "$work/live/fw1" "$work/live/fw2"
sort "$state/leases/saved" >"$work/actual"
cmp "$work/expected" "$work/actual"
rm "$work/live/fw1" "$work/live/fw2"
leases_hold
sort "$state/leases/saved" >"$work/actual"
cmp "$work/expected" "$work/actual"
leases_resume
[ -e "$state/leases/held" ]
cp "$work/old" "$work/live/fw1"
cp "$work/new" "$work/live/fw2"
leases_resume >"$work/resumed"
[ ! -e "$state/leases/held" ]
# Unattended apply logs stdout: the guest's output stays out of it.
[ ! -s "$work/resumed" ]
# A replacement still booting and relinking needed more than the 30 s probe bound for these mutators.
[ -s "$work/limits" ]
if grep -vqx 120 "$work/limits"; then exit 1; fi
# An oversized readback is a failed checkpoint and never replaces the saved copy.
cp "$state/leases/fw2" "$work/fw2.before"
{ cat "$work/new"; head -c 1048576 /dev/zero | tr '\000' '\n'; } >"$work/live/fw2"
if leases_hold; then exit 1; fi
cmp "$work/fw2.before" "$state/leases/fw2"
rm -f "$state/leases/held"
# A silent node fails the checkpoint, except in an uncommitted pair migration that replaces both roots.
(
	rsh() { [ "$1" != fw2 ] || return 255; case $2 in *'cat /var/db/dhcpd.leases'*) cat "$work/live/$1" ;; *'cat >/var/db/dhcpd.leases.new'*) cat >"$work/live/$1" ;; esac; }
	cp "$work/new" "$work/live/fw2"
	if leases_hold; then exit 1; fi
	mkdir "$state/fw.topology"
	touch "$state/fw.topology/committed"
	if leases_hold; then exit 1; fi
	[ ! -e "$state/leases/quiesced" ]
	rm "$state/fw.topology/committed"
	leases_hold
	[ -e "$state/leases/quiesced" ]
)
rm -rf "$state/fw.topology" "$state/leases/quiesced" "$state/leases/held"
# A node not running at the checkpoint but running at the seed (Incus read it late, or restarted it) gets no
# merge that lacks its own leases while it allocates; the held peer is seeded (control).
rm "$work/live/fw2"
printf 'lease 100.80.33.51 {\n  starts 1 2026/10/26 08:00:00 UTC;\n  ends 1 2026/10/26 10:00:00 UTC;\n  hardware ethernet 00:16:3e:00:00:05;\n}\n' >"$work/late"
(
	running() { [ -f "$work/live/$1" ] && return 0; [ "$1" = fw2 ] && cp "$work/late" "$work/live/fw2"; return 1; }
	leases_hold
	[ -e "$state/leases/quiesced" ]
	cmp "$work/late" "$work/live/fw2"
	grep -q '12:00:00' "$work/live/fw1"
)
rm -rf "$state/leases/quiesced" "$state/leases/held"
cp "$work/new" "$work/live/fw2"
cp "$work/old" "$work/live/fw1"
# Nothing read and nothing saved: accepted only when both roots are replaced (a migration cut after its
# holds, or both committed nodes listed as rebuilding), never with one peer's leases left out.
mv "$state/leases/saved" "$work/saved.keep"
(
	running() { return 1; }
	if leases_hold; then exit 1; fi
	if (rebuilding=fw1; leases_hold); then exit 1; fi
	mkdir "$state/fw.topology"
	touch "$state/fw.topology/committed"
	if leases_hold; then exit 1; fi
	(rebuilding='fw1 fw2'; leases_hold)
	[ -e "$state/leases/quiesced" ]
	rm -f "$state/leases/quiesced" "$state/leases/saved" "$state/fw.topology/committed"
	leases_hold
	[ -e "$state/leases/quiesced" ]
)
rm -rf "$state/fw.topology" "$state/leases/quiesced" "$state/leases/held"
mv "$work/saved.keep" "$state/leases/saved"
# Each remote mutation runs on the firewall under one lock and its own bound (100 s, under the host's 120 s),
# so a hold or seed the host gave up on cannot outlive a later resume, and the seed installs nothing short of
# the merge's byte count. The seed script runs here for real, with its paths moved.
(
	rsh() {
		case $2 in *'rcctl disable dhcpd'*) kind=hold ;; *'cat >/var/db/dhcpd.leases.new'*) kind=seed ;; *) kind=resume ;; esac
		printf '%s\n' "$2" >"$work/script.$1.$kind"
		case $kind in hold) cat "$work/live/$1" ;; seed) cat >/dev/null ;; esac
	}
	leases_hold
	leases_resume
	[ "$(ls "$work"/script.* | wc -l)" = 6 ]
	for script in "$work"/script.*; do
		grep -qF 'exec timeout -k 5 100 perl -MFcntl=:flock -e "open(L, q{>>}, q{/var/run/convergent-leases.lock}) or exit 1; flock(L, LOCK_EX) or exit 1; exit(system(q{/bin/sh}, q{-ec}, shift @ARGV) ? 1 : 0)" "' "$script"
	done
	sed -e "s|/var/run/convergent-leases.lock|$work/lock|g" -e "s|/var/db/dhcpd.leases|$work/seeded|g" \
		-e "s|/etc/convergent/dhcpd.flags|$work/flags|g" -e "s|/var/db/convergent-seeded|$work/marker|g" \
		-e 's/timeout -k 5 100 /timeout -k 1 2 /' "$work/script.fw1.seed" >"$work/seed.sh"
	grep -q 'timeout -k 1 2 ' "$work/seed.sh"
	touch "$work/flags" "$work/marker"
	if head -c 20 "$state/leases/saved" | sh "$work/seed.sh"; then exit 1; fi
	[ ! -e "$work/seeded" ]
	sh "$work/seed.sh" <"$state/leases/saved"
	cmp "$work/seeded" "$state/leases/saved"
	# The lock held by another mutation: waited for until the bound ends the seed, and nothing is installed.
	perl -MFcntl=:flock -e 'open(L, ">>", $ARGV[0]) or exit 1; flock(L, LOCK_EX) or exit 1; sleep 30' "$work/lock" &
	holder=$!
	n=0
	until perl -MFcntl=:flock -e 'open(L, ">>", $ARGV[0]) or exit 1; exit(flock(L, LOCK_EX | LOCK_NB) ? 1 : 0)' "$work/lock"; do
		n=$((n += 1)); [ "$n" -lt 100 ] || exit 1; sleep 0.1
	done
	rm "$work/seeded"
	if sh "$work/seed.sh" <"$state/leases/saved"; then exit 1; fi
	[ ! -e "$work/seeded" ]
	kill "$holder" 2>/dev/null || :
	wait "$holder" || :
)
# One node's failed resume must not leave its healthy peer's allocator off: every node is tried, the hold
# stays until all resume, and the failed node is named for the heal's event.
(
	rsh() { case $1:$2 in fw1:*'rcctl enable dhcpd'*) return 1 ;; *'rcctl enable dhcpd'*) echo "resume $1" >>"$work/resumes" ;; esac; }
	touch "$state/leases/held"
	if leases_resume; then exit 1; fi
	[ -e "$state/leases/held" ]
	grep -qx 'resume fw2' "$work/resumes"
	[ "${lease_failed:-}" = ' fw1' ]
)
rm -f "$state/leases/held" "$state/leases/quiesced"
# Replay must resume only the held peer before health, then checkpoint again before rebuilding.
eval "$(sed -n '/^rollback() {/,/^}/p; /^healthy() {/,/^}/p; /^reachable() {/p; /^cleanup() {/,/^}/p' "$here/../tools/guests")"
command -v healthy >/dev/null && command -v cleanup >/dev/null
command -v reachable >/dev/null
keys=$work/keys
mkdir "$keys"
fail() { echo "$*" >&2; return 1; }
volumes() { :; }
autorestart_hold() { :; }
seed_remove() { :; }
image_alias() { :; }
seed_start() { :; }
fw_release() { :; }
# A frozen target: Incus cannot force it off, so rollback ends its QEMU by the verified pid file before rebuilding.
eval "$(sed -n '/^force_stop() {/,/^}/p' "$here/../tools/guests")"
eval "$(sed -e "s|/usr/lib/convergent/guest-reply.sh|$here/../rootfs/usr/lib/convergent/guest-reply.sh|" -e "s|/run/incus|$work/incus|g" -e "s|/proc/|$work/proc/|g" "$lib/firewall-heal")"
mkdir -p "$work/incus/fw1" "$work/proc/4242"
echo 4242 >"$work/incus/fw1/qemu.pid"
printf '%s\0' /usr/bin/qemu-system-x86_64 -S -name fw1 -uuid x -pidfile "$work/incus/fw1/qemu.pid" >"$work/proc/4242/cmdline"
kill() { echo "kill $*" >>"$work/mutations"; killed=1; }
retry() {
    echo "retry $*" >>"$work/retries"
    tries=0
    until "$@"; do [ "$((tries += 1))" -lt 5 ] || return 1; done
}
stopped() { [ -n "${killed:-}" ] || ! running "$1"; }
ic() { echo "$*" >>"$work/mutations"; [ "$scenario:$1" != frozen:stop ]; }
timeout() { [ "$*" = '-k 5 60 incus --force-local --project default stop fw1 --force' ] || return 1; ic stop fw1 --force; }
fw_check() { [ "$scenario" != topology ] && [ -e "$work/dhcp.$1" ]; }
carp() { [ "$scenario" != carp ]; }
rebuild_root() {
    [ -e "$state/leases/held" ] && [ -e "$state/leases/quiesced" ] || return 1
    [ ! -e "$work/dhcp.fw1" ] && [ ! -e "$work/dhcp.fw2" ] || return 1
    echo rebuild >>"$work/mutations"
}
rsh() {
    [ "$scenario:$1" != silent:fw1 ] || return 255
    # booting: Incus restarted the peer (autorestart); its sshd refuses the first connections.
    case $scenario:$1 in booting*:fw2) [ "$((boots += 1))" -gt 2 ] || return 255 ;; esac
    case $2 in
    true) ;;
    *'rcctl disable dhcpd'*) rm -f "$work/dhcp.$1"; cat "$work/live/$1" ;;
    *'cat >/var/db/dhcpd.leases.new'*) cat >"$work/live/$1" ;;
    *'rcctl enable dhcpd'*)
        [ "$1" = fw2 ] && [ "$scenario" != resume-failed ] || return 1
        touch "$work/dhcp.$1"
        ;;
    *) return 1 ;;
    esac
}
# silent: the running target answers no SSH (a killed rebuild's new root); its replacement must still proceed.
# booting-update: the update's own resume already cleared quiesced, so the rollback checkpoints both nodes again.
for scenario in held frozen silent unheld topology carp resume-failed peer-down booting booting-update; do
    mkdir -p "$state/leases"
    touch "$state/leases/held" "$state/leases/quiesced" "$state/known_hosts.before"
    rm -f "$work/dhcp.fw1" "$work/dhcp.fw2"
    cp "$work/new" "$work/live/fw2"
    [ "$scenario" != peer-down ] || rm "$work/live/fw2"
    [ "$scenario" != unheld ] || rm "$state/leases/held"
    snap=test-rebuild
    [ "$scenario" != booting-update ] || { snap=test-update; rm "$state/leases/quiesced"; }
    echo "fw1 $snap old-image" >"$state/pending"
    : >"$work/mutations"; : >"$work/retries"
    killed= boots=0
    if rollback; then
        case $scenario in held|frozen|silent|booting|booting-update) ;; *) exit 1 ;; esac
        case $scenario in booting*) grep -qx 'retry reachable fw2' "$work/retries" ;; esac
        # The peer wait is read-only: it keeps the rollback's step.
        [ "$step" = rollback ]
        grep -qx 'stop fw1 --force' "$work/mutations"
        [ "$scenario" != frozen ] || grep -qx 'kill -KILL 4242' "$work/mutations"
        if [ "$scenario" != frozen ] && grep -q '^kill ' "$work/mutations"; then exit 1; fi
        grep -qx rebuild "$work/mutations"
        [ ! -e "$state/pending" ] && [ -e "$state/leases/held" ]
    else
        case $scenario in held|silent|booting*) exit 1 ;; esac
        [ -e "$state/pending" ] && [ ! -s "$work/mutations" ]
    fi
    if [ "$scenario" = peer-down ] && grep -q '^retry reachable' "$work/retries"; then exit 1; fi
done
# Cleanup waits the same way for a booting peer before it resumes the allocators.
rm -f "$state/pending" "$work/live/fw1" "$work/dhcp.fw2"
cp "$work/new" "$work/live/fw2"
touch "$state/leases/held"
: >"$work/retries"
scenario=booting boots=0
(
    unmount_root() { :; }; clear_probes() { :; }; dns_restore() { :; }; autorestart_clear() { :; }
    rm() { [ "$*" != "-rf $work" ] || return 0; command rm "$@"; }
    manual_stage= recovering= starting= applying= step=test
    cleanup 0
)
grep -qx 'retry reachable fw2' "$work/retries"
[ -e "$work/dhcp.fw2" ] && [ -e "$state/leases/held" ]
# After a timed-out Incus read cleanup skips the clear, keeps its step and names the way out.
eval "$(sed -n '/^autorestart_clear() (/,/^)/p' "$here/../tools/guests")"
command -v autorestart_clear >/dev/null
rm -f "$work/dhcp.fw2"
: >"$work/retries"
boots=0
if (
    unmount_root() { :; }; clear_probes() { :; }; dns_restore() { :; }; logger() { :; }
    fail() { echo "$step: $*" >&2; return 1; }
    rm() { [ "$*" != "-rf $work" ] || return 0; command rm "$@"; }
    manual_stage= recovering= starting= applying= step=test frozen=1
    cleanup 0
) 2>"$work/cleanup.err"; then exit 1; fi
grep -qx 'retry reachable fw2' "$work/retries"
grep -qx 'cleanup: cannot clear autorestart overrides; rerun sys guests update' "$work/cleanup.err"
# A pair rollback that cannot finish ends apply as failed, not running, and names the owner's command.
mkdir "$state/fw.topology"
if (
    unmount_root() { :; }; logger() { :; }
    fail() { echo "$step: $*" >&2; return 1; }
    topology_recover() { return 1; }
    update_status() { echo "$1" >"$work/status"; }
    manual_stage= recovering= starting= applying=1 step=test
    cleanup 1
) 2>"$work/cleanup.err"; then exit 1; fi
grep -qx failed "$work/status"
grep -qx 'cleanup: pair rollback pending; both firewalls held; rerun sys guests update' "$work/cleanup.err"
# A committed one goes forward on running firewalls: no rollback, no holds claimed.
touch "$state/fw.topology/committed"
if (
    unmount_root() { :; }; logger() { :; }
    fail() { echo "$step: $*" >&2; return 1; }
    topology_recover() { return 1; }
    update_status() { :; }
    manual_stage= recovering= starting= applying=1 step=test
    cleanup 1
) 2>"$work/cleanup.err"; then exit 1; fi
grep -qx 'cleanup: pair commit pending; rerun sys guests update' "$work/cleanup.err"
rm "$state/fw.topology/committed"
rmdir "$state/fw.topology"
# Its timeout gives no rebuild advice and no console dump; healthy's does (control).
(
    eval "$(sed -n '/^retry() {/,/^}/p' "$here/../tools/guests")"
    boot_timeout=0 polling= step=rollback
    cut() { echo 100; }
    logger() { :; }
    rsh() { return 255; }
    ic() { echo console; }
    if retry reachable fw2 2>"$work/retry.out"; then exit 1; fi
    grep -q 'reachable fw2 timed out' "$work/retry.out"
    if grep -qE 'next:|console' "$work/retry.out"; then exit 1; fi
    [ "$step" = rollback ]
    if retry healthy fw2 2>"$work/retry.out"; then exit 1; fi
    grep -qx 'guests: next: sys firewall rebuild fw2' "$work/retry.out"
    grep -qx console "$work/retry.out"
)
# A frozen QEMU holds even a graceful stop: it runs under its bound and the forced stop follows.
(
    eval "$(sed -n '/^stop_guest() {/,/^}/p' "$here/../tools/guests")"
    command -v stop_guest >/dev/null
    autorestart_hold() { :; }
    force_stop() { echo "force $1" >>"$work/stops"; }
    ic() { exit 97; }
    incus() { exit 97; }
    timeout() { echo "$*" >>"$work/stops"; return 124; }
    stop_guest wan 2>/dev/null
    printf '%s\n' '-k 5 120 incus --force-local --project default stop wan --timeout 60' 'force wan' >"$work/expected"
    cmp "$work/expected" "$work/stops"
)
# A peer whose dhcpd is off fails its health check with a reason; a rebuild resumes a held peer before it.
(
    eval "$(sed -n '/^fw_check() {/,/^}/p' "$here/../tools/guests" | sed "s|/etc/convergent/topology.sha256|$work/topology|g")"
    command -v fw_check >/dev/null
    echo digest >"$work/topology"
    guest_reply() { echo digest; }
    rsh() { [ "$2" != 'rcctl check dhcpd' ]; }
    fail() { echo "$*" >&2; return 1; }
    if fw_check fw2 2>"$work/fw_check.err"; then exit 1; fi
    grep -qx 'dhcpd is not running' "$work/fw_check.err"
)
sed -n '/^rebuild() {/,/^}/p' "$here/../tools/guests" |
    awk -v resume_line='    [ ! -f "$state/leases/held" ] || leases_resume "$peer" || die "cannot resume work DHCP on $peer"' \
        -v check_line='    fw_check "$peer" || die "$peer must be healthy before rebuilding $1"' \
        '$0 == resume_line {resume=NR} $0 == check_line {check=NR} END {exit !(resume && check > resume)}'
echo 'test-leases: held peer replay, fresh checkpoint, booting peer and failed safety gates passed'
# fw-seed: rcctl refuses flags on a disabled daemon, so a held dhcpd must not get them there.
sed -n '/^services="unbound wan_watch sshd"$/,/^esac$/p' "$here/../guests/fw/site/usr/local/libexec/convergent/fw-seed" |
	sed "s|/etc/convergent/dhcpd.flags|$work/dhcpd.flags|" >"$work/seed-services"
grep -q 'rcctl set dhcpd' "$work/seed-services"
echo '-y vio1 -Y 100.80.0.18 vlan320' >"$work/dhcpd.flags"
rcctl() {
	case $1 in
	enable) shift; enabled="$*" ;;
	set) case " $enabled " in *" $2 "*) flags="$*" ;; *) echo "rcctl: $2 is not enabled" >&2; return 1 ;; esac ;;
	esac
}
seed=$work/seed
mkdir "$seed"
for hold in no yes; do
	enabled= flags=
	[ "$hold" = no ] || : >"$seed/dhcpd.hold"
	(set -e; . "$work/seed-services"; echo "$enabled|$flags") >"$work/seed-$hold"
done
grep -qx 'unbound wan_watch sshd dhcpd|set dhcpd flags -y vio1 -Y 100.80.0.18 vlan320' "$work/seed-no"
grep -qx 'unbound wan_watch sshd|' "$work/seed-yes"
echo 'test-leases: merge, interrupted checkpoint, replay and held seeding passed'
