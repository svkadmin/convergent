#!/bin/sh
# Offline tests of the actual unlock script, with UI/Secret Service commands substituted.
set -eu
here=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
# Cage alone drops supplementary groups; the owner keeps its primary GID.
sed -n '/^owner() {/,/^}/p' "$here/../tools/browser" >"$work/owner"
[ -s "$work/owner" ]; sh -n "$work/owner"
(
    . "$work/owner"
    uid=1000 gid=1001 runtime=/run/user/1000 run=/run/convergent/browser/remmina
    display=restricted ipc=unused
    setpriv() { printf '%s\n' "$@" >"$work/credentials"; }
    for groups in --init-groups --clear-groups; do
        owner_groups=$groups owner true
        grep -qx -- "$groups" "$work/credentials"
        grep -qx -- --no-new-privs "$work/credentials"
        sed -n '1,4p' "$work/credentials" >"$work/ids"
        printf '%s\n' --reuid 1000 --regid 1001 >"$work/expected-ids"
        cmp "$work/ids" "$work/expected-ids"
    done
)
echo 'CV-REMOTE unit Cage credentials ok'
# The compile guard must stop before cmake if encryption survived patching.
sed -n "/^chroot .*<<'COMPILE'/,/^COMPILE$/p" "$here/../guests/remmina/build" |
    sed '1d;$d' >"$work/compile-body"
[ -s "$work/compile-body" ]
sh -n "$work/compile-body"
sh -n "$work/compile-body"
sed -n '/^[!i].*grep -q .*remmina_crypt_encrypt(value)/p' "$work/compile-body" >"$work/compile-guard"
[ "$(wc -l <"$work/compile-guard")" = 1 ]
printf '\necho compiled\n' >>"$work/compile-guard"
sh -n "$work/compile-guard"
sh -n "$work/compile-guard"
mkdir "$work/src"
printf 'remmina_crypt_encrypt(value)\n' >"$work/src/remmina_file.c"
if (cd "$work"; sh -eu ./compile-guard) >"$work/compiled"; then exit 1; fi
[ ! -s "$work/compiled" ]
printf 'secret_service_store(value)\n' >"$work/src/remmina_file.c"
(cd "$work"; sh -eu ./compile-guard) >"$work/compiled"
grep -qx compiled "$work/compiled"
echo 'CV-REMOTE unit compile guard ok'
# Lock descriptors must be closed before the timer's FIFO redirection is evaluated.
(
    run=$work children=
    sed -n '/^mkfifo .*"\$run\/tick"$/,/^children=/p' "$here/../tools/browser" |
        sed '1d; s|>"$run/tick"|>"$(tick_path)"|' >"$work/timer"
    [ -s "$work/timer" ]
    sh -n "$work/timer"
    tick_path() {
        for fd in 6 7 8 9; do
            if (eval ": >&$fd") 2>/dev/null; then return 1; fi
        done
        : >"$work/closed"
        printf '%s\n' "$run/tick"
    }
    owner() { [ "$background" = yes ]; echo tick; }
    exec 6>"$work/lock6" 7>"$work/lock7" 8>"$work/lock8" 9>"$work/lock9"
    . "$work/timer"
    [ -n "$children" ]
    wait $children
    [ -f "$work/closed" ]
    grep -qx tick "$run/tick"
)
echo 'CV-REMOTE unit timer closes locks before FIFO open'
mkdir "$work/bin"
sed 's|exec /usr/bin/remmina|exec remmina-test-app|' \
    "$here/../guests/remmina/rootfs/usr/local/bin/remmina-session" >"$work/session"
cat >"$work/bin/zenity" <<'EOF'
#!/bin/sh
case $1 in --error) echo "$2" >&2; exit 0 ;; esac
case $SAMPLE in
cancel) exit 1 ;;
empty) echo ;;
mismatch) case $2 in *confirm*) echo different ;; *) echo correct ;; esac ;;
wrong) echo wrong ;;
*) echo correct ;;
esac
EOF
cat >"$work/bin/gnome-keyring-daemon" <<'EOF'
#!/bin/sh
password=$(cat)
[ "$password" = correct ] || exit 1
printf 'GnomeKeyring\n\r\000\n' >"$HOME/.local/share/keyrings/login.keyring"
EOF
cat >"$work/bin/gdbus" <<'EOF'
#!/bin/sh
case $SAMPLE in unavailable) exit 1 ;; locked) echo '(<true>,)' ;; *) echo '(<false>,)' ;; esac
EOF
cat >"$work/bin/remmina-test-app" <<'EOF'
#!/bin/sh
touch "$HOME/started"
EOF
chmod +x "$work/bin/"*
PATH="$work/bin:$PATH"
export PATH
for SAMPLE in cancel empty mismatch wrong unavailable locked plaintext success existing; do
    HOME=$work/$SAMPLE
    export HOME SAMPLE
    mkdir -p "$HOME/.local/share/keyrings"
    case $SAMPLE in
    plaintext) printf '[keyring]\n' >"$HOME/.local/share/keyrings/login.keyring" ;;
    existing) printf 'GnomeKeyring\n\r\000\n' >"$HOME/.local/share/keyrings/login.keyring" ;;
    esac
    rc=0
    sh "$work/session" >"$work/log" 2>&1 || rc=$?
    case $SAMPLE in
    success|existing) [ "$rc" = 0 ] && [ -f "$HOME/started" ] ;;
    *) [ "$rc" != 0 ] && [ ! -e "$HOME/started" ] ;;
    esac || { cat "$work/log"; echo "CV-REMOTE unit FAIL $SAMPLE"; exit 1; }
    echo "CV-REMOTE unit ok $SAMPLE"
done
# The manifest path validator must admit only the new flat artifact namespace.
sed -n '/^guest_path() {/,/^}/p' "$here/../tools/fetch-release" >"$work/path"
. "$work/path"
for path in guests/remmina/rootfs.tar.gz guests/remmina/incus.yaml guests/remmina/SHA256SUMS; do guest_path "$path"; done
for path in guests/remmina/../secret guests/remmina/.. guests/remmina/incus/extra.yaml guests/remminax/rootfs.tar.gz; do
    if guest_path "$path"; then echo "CV-REMOTE unsafe path: $path"; exit 1; fi
done
echo 'CV-REMOTE unit paths ok'

grep -qx 'rc_need="sysctl remmina-setup"' "$here/../guests/remmina/rootfs/etc/conf.d/networking"
echo 'CV-REMOTE unit OpenRC dependency ok'

if command -v jq >/dev/null 2>&1; then
    for entry in 'remmina remmina none' 'def browser-base browser-def'; do
        set -- $entry
        role=$3
        [ "$role" != none ] || role=
        case $1 in remmina) profiles='["remmina"]' ;; *) profiles='["browser-base","browser-def"]' ;; esac
        printf '[{"name":"%s","type":"container","profiles":%s}]\n' "$1" "$profiles" >"$work/instances"
        jq -e --arg n "$1" --arg b "$2" --arg r "$role" \
            '.[] | select(.name == $n) | .type == "container" and .profiles == ([$b, $r] | map(select(. != "")))' "$work/instances" >/dev/null
        if jq -e --arg n "$1" --arg b default --arg r "$role" \
            '.[] | select(.name == $n) | .type == "container" and .profiles == ([$b, $r] | map(select(. != "")))' "$work/instances" >/dev/null; then exit 1; fi
    done
    for state in Running Stopped; do
        printf '[{"status":"%s","expanded_devices":{"disk":{"type":"disk","pool":"default","source":"share"}}}]\n' "$state" >"$work/instances"
        rc=0
        jq -e 'all(.[];
            if any(.expanded_devices[]?; .type == "disk" and .pool == "default" and .source == "share")
            then .status == "Stopped" else true end)' "$work/instances" >/dev/null || rc=$?
        case $state in Running) [ "$rc" != 0 ] ;; Stopped) [ "$rc" = 0 ] ;; esac
    done
    echo 'CV-REMOTE unit jq profiles/share ok'
else
    echo 'CV-REMOTE unit SKIP jq (not installed)'
fi

# Exercise the launcher's host/inner socket selection and command boundary.
(
sed -n '/^wayland_socket=/,/^# The container first:/p' "$here/../tools/browser" | sed '$d' >"$work/sockets"
sed -n '/^background=yes owner way-secure /,/^# Only the Pulse socket /p' "$here/../tools/browser" | sed '$d' >"$work/providers"
sh -n "$work/sockets"
sh -n "$work/providers"
install() { for path do :; done; mkdir -p "$path"; }
owner() {
    printf '%s\n' "$*" >>"$run/providers"
    case $* in *' cage')
        [ "${owner_groups:-}" = --clear-groups ] || exit 1
        dd if=/dev/zero bs=1048576 count=2 2>/dev/null || exit 1
        printf 'drained\n' || exit 1
        touch "$run/drained" ;;
    esac
}
wait_socket() {
    wait "$2"
    printf '%s\n' "$1" >>"$run/waits"
    printf 'socket %s\n' "$1" >>"$run/order"
}
chown() { printf 'chown %s\n' "$*" >>"$run/order"; }
chmod() { printf 'chmod %s\n' "$*" >>"$run/order"; }
for role in remmina def; do
    run=$work/launch-$role name=$role uid=1000 gid=1000 children=
    mkdir -p "$run/sockets" "$run/state"
    . "$work/sockets"
    . "$work/providers"
    device() { printf '%s\n' "$*" >"$run/device"; }
    eval "$(sed -n '/^device wayland /p' "$here/../tools/browser")"
    grep -Fxq "wayland source=$wayland_socket required=true" "$run/device"
    if [ "$role" = remmina ]; then
        [ "$wayland_socket" = "$run/cage/wayland-0" ]
        [ "$outer_socket" = "$run/state/wayland-host" ]
        grep -Fxq "env XDG_RUNTIME_DIR=$run/cage WAYLAND_DISPLAY=$outer_socket WLR_BACKENDS=wayland WLR_RENDERER=pixman prlimit --as=2147483648:2147483648 cage" "$run/providers"
        [ "$(wc -l <"$run/waits")" = 2 ]
        printf 'socket %s\nsocket %s\nchown root %s/cage\nchmod 0710 %s/cage\n' \
            "$outer_socket" "$wayland_socket" "$run" "$run" >"$run/expected"
        cmp "$run/expected" "$run/order"
        wait "$cage_capture"
        [ -f "$run/drained" ] && [ "$(wc -c <"$run/cage.log")" = 1048576 ]
        [ "$(tail -c 8 "$run/cage.log")" = drained ]
    else
        [ "$wayland_socket" = "$run/sockets/wayland-0" ] && [ "$outer_socket" = "$wayland_socket" ]
        [ "$(wc -l <"$run/providers")" = 1 ]
    fi
done
)

# Startup failure must flush Cage's tail even while the producer is still alive.
sed -n '/^cleanup() {/,/^}/p' "$here/../tools/browser" >"$work/cleanup"
cat >"$work/cage-producer" <<'EOF'
#!/bin/sh
set -eu
case $sample in
term|collector) trap 'sleep .2; printf "cage shutdown diagnostic\n"; exit 0' TERM ;;
kill) trap '' TERM ;;
esac
printf 'cage startup diagnostic\n'
touch "$run/producer-ready"
while :; do sleep .1; done
EOF
cat >"$work/cage-cleanup" <<'EOF'
#!/bin/sh
set -eu
children= active= grafana= portal= browser= capture= cage= cage_capture=
role=remmina name=remmina uid=1000 gid=1000
mkdir -p "$run/sockets" "$run/state"
. "$work/cleanup"
trap cleanup 0
install() { for path do :; done; mkdir -p "$path"; }
owner() {
    case $* in *' cage') exec sh "$work/cage-producer" ;; esac
}
tail() {
    if [ "$sample:$1" = collector:-c ]; then
        trap '' TERM
        while :; do sleep .1; done
    fi
    command tail "$@"
}
wait_socket() {
    [ "$2" = "$cage" ] || return 0
    attempts=0
    until [ -f "$run/producer-ready" ]; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ] || exit 2
        sleep .1
    done
    kill -0 "$cage"
    kill -0 "$cage_capture"
    # Simulate the socket timeout with the producer still running.
    exit 1
}
. "$work/sockets"
. "$work/providers"
exit 2
EOF
for script in cleanup cage-producer cage-cleanup; do sh -n "$work/$script"; done
for sample in term kill collector; do
    run=$work/cleanup-$sample
    export work run sample
    rc=0
    timeout -k 1 15 sh "$work/cage-cleanup" >"$work/cleanup.log" 2>&1 || rc=$?
    [ "$rc" = 1 ]
    [ ! -e "$run" ]
    if [ "$sample" != collector ]; then grep -qx 'cage startup diagnostic' "$work/cleanup.log"; fi
    if [ "$sample" = term ]; then grep -qx 'cage shutdown diagnostic' "$work/cleanup.log"; fi
done
echo 'CV-REMOTE unit live Cage cleanup ok'

# The actual Pulse command must set both soft and hard address-space limits.
(
    run=$work/pulse runtime=/run/user/1000 children=
    mkdir "$run"
    owner() { printf '%s\n' "$*" >"$run/command"; }
    sed -n '/^background=yes owner env PIPEWIRE_REMOTE=/,/^audio=\$!/p' "$here/../tools/browser" >"$work/audio"
    sh -n "$work/audio"
    . "$work/audio"
    wait "$audio"
    grep -Fq 'prlimit --as=1073741824:1073741824 --fsize=1048576:1048576 /usr/libexec/convergent/pipewire-pulse' "$run/command"
)
grep -qx '    source: /run/convergent/browser/remmina/cage/wayland-0' "$here/../guests/remmina/incus.yaml"
if grep -q 'cage\|WLR_BACKENDS' "$here/../guests/remmina/rootfs/usr/local/bin/remmina-launch"; then exit 1; fi
echo 'CV-REMOTE unit host Cage socket boundary ok'

if command -v jq >/dev/null 2>&1; then
    sed -n '/^jq -S .map(select/,/Incus settings unreadable/p' "$here/../tools/check" >"$work/inventory"
    [ -s "$work/inventory" ]
    bad() { echo "$*" >&2; exit 1; }
    cat >"$work/instances" <<'EOF'
[{"name":"remmina","project":"default","status":"Stopped","profiles":["remmina"],
  "expanded_config":{"security.privileged":"false","volatile.test":"ignored"},
  "expanded_devices":{"wayland":{"source":"/run/convergent/browser/remmina/cage/wayland-0"},
                      "share":{"source":"share"},"eth0":{"security.ipv4_filtering":"true"}}},
 {"name":"remmina","project":"owner","profiles":["other"],"expanded_config":{},"expanded_devices":{}}]
EOF
    . "$work/inventory"
    jq -e 'length == 1 and .[0].name == "remmina" and .[0].profiles == ["remmina"] and
        .[0].config == {"security.privileged":"false"} and
        .[0].devices.eth0["security.ipv4_filtering"] == "true" and
        .[0].devices.wayland.source == "/run/convergent/browser/remmina/cage/wayland-0" and
        .[0].devices.share.source == "share"' "$work/incus.raw" >/dev/null
    echo 'CV-REMOTE unit checker inventory ok'
fi
