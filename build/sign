#!/bin/sh
# sign: sign a release's manifest with the channel key (ARCHITECTURE section 6, step 7).
#   build/sign <release-dir> [key]      key defaults to /etc/convergent/keys/<CHANNEL>.key
# Writes manifest.sig, guests.manifest.sig when there are guests, latest and latest.sig. An
# encrypted key (the offline stable key) asks for its passphrase.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"
die() { echo "sign: $*" >&2; exit 1; }
[ $# -ge 1 ] && [ $# -le 2 ] || die "usage: build/sign <release-dir> [key]"
dir=$1
key=${2:-/etc/convergent/keys/$CHANNEL.key}
pub=/etc/convergent/keys/$CHANNEL.pub
[ -f "$dir/manifest" ] || die "no manifest in $dir"
[ -f "$key" ] || die "no key $key"
[ -f "$pub" ] || die "no public key $pub"
# What the signature vouches for: the manifest and the files it lists.
for f in manifest guests.manifest; do
	[ -f "$dir/$f" ] || continue
	(cd "$dir" && grep -E '^[0-9a-f]{64}  ' "$f" | sha256sum -c --quiet -) || die "the release does not match its $f"
done
release=$(awk '$1 == "release" { print $2 }' "$dir/manifest")
# latest: what build/publish points the channel at; signed, so a mirror cannot pick the release.
# It also names the guests.manifest (or none), which a mirror then cannot withhold or swap.
guests=none
[ ! -f "$dir/guests.manifest" ] || guests=$(sha256sum <"$dir/guests.manifest" | cut -d' ' -f1)
printf 'release %s\nsigned %s\nguests %s\n' "$release" "$(date -u +%s)" "$guests" >"$dir/latest"
# An encrypted key asks once per file; it is never written out decrypted.
for f in manifest guests.manifest latest; do
	[ -f "$dir/$f" ] || continue
	openssl pkeyutl -sign -inkey "$key" -rawin -in "$dir/$f" -out "$dir/$f.sig.new" || die "signing $f failed"
	openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$dir/$f" -sigfile "$dir/$f.sig.new" >/dev/null ||
		die "the signature of $f does not verify with $pub"
	mv "$dir/$f.sig.new" "$dir/$f.sig"
done
echo "sign: $release signed for $CHANNEL"
