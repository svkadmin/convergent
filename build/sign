#!/bin/sh
# sign: sign a release's manifest with the channel key (ARCHITECTURE section 6, step 7).
#   build/sign <release-dir> [key]      key defaults to /etc/convergent/keys/<CHANNEL>.key
#   build/sign --image <image-dir> <release-dir> [key]   only the install image's .sha256
# Writes manifest.sig, packages.sig, guests.manifest.sig when present, latest and latest.sig. An
# encrypted key (the offline stable key) asks for its passphrase.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"
die() { echo "sign: $*" >&2; exit 1; }
image=
if [ "${1:-}" = --image ]; then
	[ $# -ge 2 ] || die "usage: build/sign --image <image-dir> <release-dir> [key]"
	image=$2
	shift 2
fi
[ $# -ge 1 ] && [ $# -le 2 ] || die "usage: build/sign [--image <image-dir>] <release-dir> [key]"
dir=$1
key=${2:-/etc/convergent/keys/$CHANNEL.key}
pub=/etc/convergent/keys/$CHANNEL.pub
[ -f "$dir/manifest" ] || die "no manifest in $dir"
[ -f "$key" ] || die "no key $key"
[ -f "$pub" ] || die "no public key $pub"
release=$(awk '$1 == "release" { print $2 }' "$dir/manifest")
case $release in '' | *[!0-9]* | 0?*) die "invalid release in $dir/manifest" ;; esac
[ "${#release}" -le 12 ] || die "invalid release in $dir/manifest"
. "$here/release-check"
# The install image is not in the manifest: its .sha256 (one line naming the file beside it) is signed.
if [ -n "$image" ]; then
	f=$image/convergent-$release.img.zst.sha256
	awk -v f="convergent-$release.img.zst" '{if (NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-f]/ || $2 != f) bad = 1}
		END {exit bad || NR != 1}' "$f" && (cd "$image" && sha256sum -c --quiet "${f##*/}") ||
		die "the image does not match $f"
	openssl pkeyutl -sign -inkey "$key" -rawin -in "$f" -out "$f.sig.new" || die "signing ${f##*/} failed"
	openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$f" -sigfile "$f.sig.new" >/dev/null ||
		die "the signature of ${f##*/} does not verify with $pub"
	mv "$f.sig.new" "$f.sig"
	echo "sign: the release $release image signed for $CHANNEL"
	exit 0
fi
# What the signature vouches for: the manifest and the files it lists.
for f in manifest guests.manifest remmina.manifest; do
	[ -f "$dir/$f" ] || continue
	(cd "$dir" && grep -E '^[0-9a-f]{64}  ' "$f" | sha256sum -c --quiet -) || die "the release does not match its $f"
done
# latest: what build/publish points the channel at; signed, so a mirror cannot pick the release.
# It also names guests.manifest (or none), so a mirror cannot withhold or swap it.
guests=none
[ ! -f "$dir/guests.manifest" ] || guests=$(sha256sum <"$dir/guests.manifest" | cut -d' ' -f1)
printf 'release %s\nsigned %s\nguests %s\n' "$release" "$(date -u +%s)" "$guests" >"$dir/latest"
remmina=none
[ ! -f "$dir/remmina.manifest" ] || remmina=$(sha256sum <"$dir/remmina.manifest" | cut -d' ' -f1)
printf 'remmina %s\n' "$remmina" >>"$dir/latest"
# An encrypted key asks once per file; it is never written out decrypted.
for f in manifest packages guests.manifest remmina.manifest latest; do
	[ -f "$dir/$f" ] || continue
	openssl pkeyutl -sign -inkey "$key" -rawin -in "$dir/$f" -out "$dir/$f.sig.new" || die "signing $f failed"
	openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$dir/$f" -sigfile "$dir/$f.sig.new" >/dev/null ||
		die "the signature of $f does not verify with $pub"
	mv "$dir/$f.sig.new" "$dir/$f.sig"
done
echo "sign: $release signed for $CHANNEL"
