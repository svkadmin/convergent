#!/bin/sh
# Offline output authentication fixtures; no root or bucket credentials needed.
set -eu
umask 077
here=$(cd "$(dirname "$0")" && pwd)
# Replay history rolls back with /var; expiry and owner consent still apply.
grep -qF 'Expired requests fail. Replay rejection applies to' "$here/../USAGE.md"
grep -qF 'the current `/var` history; rollback can permit a still-valid diagnostic again, with fresh consent.' "$here/../USAGE.md"
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-debug: $*" >&2; exit 1; }
tmp=$work state=$work keys=$work BUILDER=$work
id=00000000000000000000000000000001
mkdir "$work/debug"
openssl genpkey -algorithm ED25519 -out "$state/signing.key"
openssl pkey -in "$state/signing.key" -pubout -out "$BUILDER/debug/$id.pub"
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=test-debug \
	-keyout "$keys/debug.key" -out "$tmp/cert" >/dev/null 2>&1
cp "$tmp/cert" "$keys/debug.crt"
printf 'diagnostic output\n\000binary\n' >"$state/$id.txt"
sed -n '/^{ printf.*"\$id"; cat /,/die "output encryption failed"/p' "$here/../tools/debug" >"$work/encrypt"
sed -n '/^	openssl cms -decrypt/,/^	tail -n +2 /p' "$here/debug" >"$work/decrypt"
[ -s "$work/encrypt" ] && [ -s "$work/decrypt" ]
. "$work/encrypt"
(. "$work/decrypt") >"$work/result"
cmp "$state/$id.txt" "$work/result"
cp "$tmp/output.cms" "$work/good.cms"
refuse() {
	if (. "$work/decrypt") >"$work/result" 2>"$work/error"; then die "accepted $1"; fi
	[ ! -s "$work/result" ] || die "printed unverified $1"
	grep -q "$2" "$work/error" || { cat "$work/error" >&2; die "wrong refusal for $1"; }
}
# A public recipient certificate permits encryption of arbitrary fabricated output.
printf '%064d%s\nforged\n' 0 "$id" >"$tmp/signed"
openssl cms -encrypt -binary -aes-256-gcm -outform DER -in "$tmp/signed" -out "$tmp/output.cms" "$tmp/cert"
refuse forgery 'not signed by the pinned laptop'
# An authentic result is bound to the original request.
cp "$work/good.cms" "$tmp/output.cms"
old=$id
id=00000000000000000000000000000002
cp "$BUILDER/debug/$old.pub" "$BUILDER/debug/$id.pub"
refuse replay 'another request'
id=$old
openssl genpkey -algorithm ED25519 -out "$state/signing.key"
. "$work/encrypt"
refuse 'another laptop' 'not signed by the pinned laptop'
: >"$tmp/output.cms"
refuse corruption 'replaced or corrupt'
echo 'test: debug output authentication passed'

# Fetch withdraws the published request when it is the fetched one, and reports failed deletions.
sed -n '/^	rc=0$/,/^	exit "\$rc"$/p' "$here/debug" >"$work/delete"
grep -q 'debug/\$f"' "$work/delete"; sh -n "$work/delete"
ep=https://bucket.test CHANNEL=beta last=$work/last fail=
s3() {
	[ "$1 $2 $3 $4" = '-o /dev/null -X DELETE' ] || exit 97
	printf '%s\n' "$5" >>"$work/calls"
	[ "$5" != "$fail" ]
}
published="$ep/debug-out/$id
$ep/beta/debug/script
$ep/beta/debug/script.sig"
printf '%s\n' "$id" >"$last"
: >"$work/calls"
(. "$work/delete") || die 'cleanup failed'
printf '%s\n' "$published" | cmp -s - "$work/calls" || die 'left the request published'
printf '%s\n' 00000000000000000000000000000009 >"$last"
: >"$work/calls"
(. "$work/delete") || die 'cleanup failed'
printf '%s\n' "$ep/debug-out/$id" | cmp -s - "$work/calls" || die 'withdrew a later request'
printf '%s\n' "$id" >"$last"
for fail in "$ep/debug-out/$id" "$ep/beta/debug/script" "$ep/beta/debug/script.sig"; do
	: >"$work/calls"
	if (. "$work/delete") 2>"$work/error"; then die "hid a failed deletion of $fail"; fi
	case $fail in */debug-out/*) want="output for $id" ;; *) want=${fail#"$ep/"} ;; esac
	grep -qxF "debug: cannot delete $want" "$work/error" || die "unreported deletion failure: $fail"
	printf '%s\n' "$published" | cmp -s - "$work/calls" || die "stopped after a failed deletion of $fail"
done
echo 'test: debug fetch cleanup passed'

sh "$here/test-diag"
