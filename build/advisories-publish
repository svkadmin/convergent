#!/bin/sh
# Daily re-scan of the channel's published releases, using retained build inventories.
set -eu
export LC_ALL=C
umask 077
here=$(cd "$(dirname "$0")" && pwd)
. "$here/build.conf"
die() { echo "advisories-publish: $*" >&2; exit 1; }
[ "$#" = 0 ] || die 'usage: CHANNEL=beta build/advisories-publish'
[ "$(id -u)" = 0 ] || die 'run as root'
case $CHANNEL in ''|dev|*[!a-z0-9-]*) die 'invalid or unpublished channel' ;; esac
pub=/etc/convergent/keys/$CHANNEL.pub
key=/etc/convergent/keys/$CHANNEL.key
[ -f "$key" ] && [ -f "$pub" ] || die 'channel signing key is required'
. "/etc/convergent/r2-$CHANNEL.env"
ep=${R2_ENDPOINT:-https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com}/$R2_BUCKET
s3() {
	curl -q -fsS --proto =https --retry 3 --connect-timeout 15 --max-time 120 --aws-sigv4 'aws:amz:auto:s3' -K - "$@" <<-EOF
	user = "$R2_ACCESS_KEY_ID:$R2_SECRET_ACCESS_KEY"
	EOF
}
verify() { openssl pkeyutl -verify -pubin -inkey "$pub" -rawin -in "$1" -sigfile "$1.sig" >/dev/null 2>&1; }
exec 9>/run/convergent-publish.lock
flock -n 9 || die 'another publish or advisory scan is running'
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
s3 "$ep?list-type=2&max-keys=1000&prefix=$CHANNEL/" >"$work/list.xml"
python3 - "$work/list.xml" "$CHANNEL" >"$work/releases" <<'PY'
import re, sys, xml.etree.ElementTree as ET
root = ET.parse(sys.argv[1]).getroot()
ns = {'s': 'http://s3.amazonaws.com/doc/2006-03-01/'}
if root.findtext('s:IsTruncated', namespaces=ns) != 'false':
    raise ValueError('incomplete bucket listing')
ids, guests, remmina = set(), set(), set()
for key in root.findall('s:Contents/s:Key', ns):
    match = re.fullmatch(re.escape(sys.argv[2]) + r'/([^/]+)/(manifest|guests\.manifest|remmina\.manifest)', key.text or '')
    if match:
        if not re.fullmatch(r'0|[1-9][0-9]{0,11}', match[1]):
            raise ValueError('invalid release id')
        {'manifest': ids, 'guests.manifest': guests, 'remmina.manifest': remmina}[match[2]].add(match[1])
if not remmina <= guests <= ids:
    raise ValueError('orphan guest manifest')
for release in sorted(ids):
    print(release, int(release in guests), int(release in remmina))
PY
failed=0
while read -r release has_guests has_remmina; do
	[ -n "$release" ] || continue
	dir=$BUILDER/releases/$release
	# A retained signed inventory is checked against the exact published manifests.
	for f in manifest manifest.sig; do s3 -o "$work/$f" "$ep/$CHANNEL/$release/$f"; done
	verify "$work/manifest" && cmp -s "$dir/manifest" "$work/manifest" || die "$release: retained manifest mismatch"
	grep -qx "release $release" "$dir/manifest" || die 'release id mismatch'
	if [ "$has_guests" = 1 ]; then
		for f in guests.manifest guests.manifest.sig; do s3 -o "$work/$f" "$ep/$CHANNEL/$release/$f"; done
		verify "$work/guests.manifest" && cmp -s "$dir/guests.manifest" "$work/guests.manifest" || die "$release: guest manifest mismatch"
		(cd "$dir" && grep -E '^[0-9a-f]{64}  ' guests.manifest | sha256sum -c --quiet -) || die "$release: guest payload mismatch"
		if [ "$has_remmina" = 1 ]; then
			for f in remmina.manifest remmina.manifest.sig; do s3 -o "$work/$f" "$ep/$CHANNEL/$release/$f"; done
			verify "$work/remmina.manifest" && cmp -s "$dir/remmina.manifest" "$work/remmina.manifest" || die "$release: Remmina manifest mismatch"
			(cd "$dir" && grep -E '^[0-9a-f]{64}  ' remmina.manifest | sha256sum -c --quiet -) || die "$release: Remmina payload mismatch"
		else
			[ ! -e "$dir/remmina.manifest" ] && [ ! -e "$dir/guests/remmina" ] || die "$release: unpublished Remmina inventory"
		fi
	else
		[ ! -e "$dir/guests.manifest" ] && [ ! -e "$dir/guests" ] || die "$release: published guest inventory is missing"
	fi
	rm -f "$work/advisories.json"
	rc=0
	"$here/advisories" --status "$work/advisories.json" "$dir" || rc=$?
	case $rc in 0|1) ;; *) failed=1; echo "advisories-publish: $release scan failed; status left unchanged" >&2; continue ;; esac
	[ -s "$work/advisories.json" ] || die 'scanner produced no status'
	[ "$(stat -c %s "$work/advisories.json")" -le 1048576 ] || die 'status exceeds 1 MiB'
	openssl pkeyutl -sign -inkey "$key" -rawin -in "$work/advisories.json" -out "$work/advisories.json.sig"
	verify "$work/advisories.json" || die 'signing key does not match channel'
	digest=$(sha256sum <"$work/advisories.json" | cut -d' ' -f1)
	s3 -o /dev/null -T "$work/advisories.json.sig" "$ep/$CHANNEL/$release/advisories-v2.json.$digest.sig"
	s3 -o /dev/null -H 'Cache-Control: no-store' -T "$work/advisories.json" "$ep/$CHANNEL/$release/advisories-v2.json"
	# Legacy readers still fetch the original pair.
	for f in advisories.json.sig advisories.json; do
		s3 -o /dev/null -H 'Cache-Control: no-store' -T "$work/$f" "$ep/$CHANNEL/$release/$f"
	done
	echo "advisories-publish: refreshed $CHANNEL/$release"
done <"$work/releases"
exit "$failed"
