#!/bin/sh
# Publication and readers against a local bucket.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
die() { echo "test-publish: $*" >&2; exit 1; }
# Archive fixtures must not need repository metadata (or a real clone).
git() { die 'unexpected git invocation'; }
dir=$work/release ep=$work/bucket CHANNEL=beta release=42
export work dir ep CHANNEL release
mkdir -p "$dir" "$ep/beta/42" "$work/pointer"
openssl genpkey -algorithm ed25519 -out "$work/key"
openssl pkey -in "$work/key" -pubout -out "$work/pub"
cat >"$work/stub" <<'SH'
set -eu
die() { echo "$*" >&2; exit 1; }
calls=0
s3() {
    input= output=
    while [ "$#" -gt 1 ]; do
        case $1 in -T) input=$2; shift ;; -o) output=$2; shift ;; esac
        shift
    done
    if [ -z "$input" ]; then cp "$1" "$output"; return; fi
    calls=$((calls + 1))
    printf '%s\n' "$1" >>"$work/uploads"
    [ "$calls" != "${FAIL_AT:-0}" ] || return 1
    cp "$input" "$1.tmp"
    mv "$1.tmp" "$1"
}
SH
for path in beta/latest beta/latest.sig beta/42/advisories.json beta/42/advisories.json.sig; do
    printf 'legacy\n' >"$ep/$path"
done
for publisher in publish advisories-publish; do
    if [ "$publisher" = publish ]; then
        sed -n '/^for f in latest.sig latest; do/,/^echo /p' "$here/$publisher" | sed '$d' >"$work/commit"
        document=$dir/latest remote=$ep/beta/latest
    else
        sed -n '/^[[:space:]]*for f in advisories.json.sig advisories.json; do/,/^[[:space:]]*echo /p' "$here/$publisher" | sed '$d' >"$work/commit"
        document=$work/advisories.json remote=$ep/beta/42/advisories.json
    fi
    [ -s "$work/commit" ] || die 'missing production commit'
    if [ "$publisher" = publish ]; then
        printf 'release 41\nsigned %s\nguests none\n' "$(date +%s)" >"$document"
    else
        printf '{"release":"42","generated":999,"advisories":[],"packages":[]}\n' >"$document"
    fi
    openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$document" -out "$document.sig"
    sh -eu -c '. "$work/stub"; . "$work/commit"'
    cp "$remote" "$work/old"
    cp "$document.sig" "$work/old.sig"
    if [ "$publisher" = publish ]; then
        printf 'release 42\nsigned %s\nguests none\n' "$(date +%s)" >"$document"
    else
        printf '{"release":"42","generated":1000,"advisories":[],"packages":[{"target":"svc","package":"victoria-logs","version":"1.52.1-r0","advisory_coverage":"UNKNOWN","repository":"edge/testing"}]}\n' >"$document"
    fi
    openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$document" -out "$document.sig"
    cp "$document" "$work/new"
    cp "$document.sig" "$work/new.sig"
    for failure in 1 2; do
        cp "$work/old" "$document"
        cp "$work/old.sig" "$document.sig"
        sh -eu -c '. "$work/stub"; . "$work/commit"'
        cp "$work/new" "$document"
        cp "$work/new.sig" "$document.sig"
        : >"$work/uploads"
        if FAIL_AT=$failure sh -eu -c '. "$work/stub"; . "$work/commit"' >"$work/log" 2>&1; then
            die "$publisher ignored failed upload $failure"
        fi
        [ "$(wc -l <"$work/uploads")" -eq "$failure" ] || die 'upload continued after failure'
        cmp "$remote" "$work/old"
        if [ "$failure" = 2 ]; then
            if openssl pkeyutl -verify -pubin -inkey "$work/pub" -rawin -in "$remote" -sigfile "$remote.sig" >/dev/null 2>&1; then
                die 'interrupted pair verified'
            fi
        else
            openssl pkeyutl -verify -pubin -inkey "$work/pub" -rawin -in "$remote" -sigfile "$remote.sig" >/dev/null
        fi
        sh -eu -c '. "$work/stub"; . "$work/commit"'
        cmp "$remote" "$document"
        cmp "$remote.sig" "$document.sig"
        openssl pkeyutl -verify -pubin -inkey "$work/pub" -rawin -in "$remote" -sigfile "$remote.sig" >/dev/null
    done
    [ "$(find "$ep" -type f | wc -l)" -eq 4 ] || die 'publication added objects'
done
get() {
    output= code=
    while [ "$#" -gt 1 ]; do
        case $1 in -o) output=$2; shift ;; -w) code=200; shift ;; esac
        shift
    done
    cp "$1" "$output" || return 1
    printf %s "$code"
}
pointer=$work/pointer url=$ep/beta host=fixture
# Execute the shipped old pointer reader, including signature and grammar checks.
# Frozen sources from v0.1.4-rc1, also available in git-archive tarballs.
old=$here/fixtures/readers-0.1.4
cp "$old/fetch-release" "$work/old-fetch"
sed -n '/^field()/p; /^num()/p; /^bytes()/p; /^read_pointer() {/,/^}/p' "$work/old-fetch" >"$work/old-functions"
sed -n '/^[[:space:]]*code=$(get --max-time 60/,/^fi$/p' "$work/old-fetch" | sed '$d' >"$work/old-read"
key=$work/pub usb=
. "$old/verify.sh"
. "$work/old-functions"
. "$work/old-read"
read_pointer
[ "$latest" = 42 ] || die 'old reader did not discover the new release'
# The old status reader and its original jq validator consume the new publisher's output.
cp "$old/release-status.sh" "$work/old-status-source"
sed -n '/^[[:space:]]*if get /,/^[[:space:]]*verify "\$f"/p' "$work/old-status-source" |
    sed '1s/if get/get/; $s/ &&$//' >"$work/old-status-fetch"
(
    release=42 f=$pointer/advisories.json
    . "$work/old-status-fetch"
    cmp "$f" "$ep/beta/42/advisories.json"
)
if command -v jq >/dev/null 2>&1; then
    cp "$old/release-status.jq" "$work/old-status.jq"
    sed -e "s|/var/lib/node_exporter|$work/metrics|g" \
            -e "s|/var/lib/convergent/release-status|$work/cache|g" \
            -e "s|/usr/lib/convergent/release-status.jq|$work/old-status.jq|g" "$work/old-status-source" >"$work/old-status.sh"
    (
        private() { mkdir -p "$1"; }
        booted=42
        . "$work/old-status.sh"
        release_metrics 1
        for role in installed latest; do
            grep -qx "cv_release_status_verified{role=\"$role\",release=\"42\"} 1" "$work/metrics/release.prom"
        done
        cmp "$work/cache/42.json" "$ep/beta/42/advisories.json"
    )
else
    echo 'test-publish: old status ingestion fixture skipped (jq unavailable)'
fi
# The published sidecar requires retained metadata and payloads.
mkdir -p "$dir/guests/svc" "$dir/guests/remmina"
printf 'payload\n' >"$dir/guests/svc/rootfs.tar.gz"
printf 'payload\n' >"$dir/guests/remmina/rootfs.tar.gz"
printf 'host payload\n' >"$dir/slot.img"
{
    printf 'release 42\nsize slot.img %s\n' "$(stat -c %s "$dir/slot.img")"
    (cd "$dir"; sha256sum slot.img)
} >"$dir/manifest"
cp "$dir/slot.img" "$ep/beta/42/"
for guest in svc remmina; do
    case $guest in svc) manifest=guests.manifest ;; *) manifest=remmina.manifest ;; esac
    (cd "$dir"; printf 'release 42\n'; sha256sum "guests/$guest/rootfs.tar.gz") >"$dir/$manifest"
done
for manifest in manifest guests.manifest remmina.manifest; do
    openssl pkeyutl -sign -inkey "$work/key" -rawin -in "$dir/$manifest" -out "$dir/$manifest.sig"
    cp "$dir/$manifest" "$dir/$manifest.sig" "$ep/beta/42/"
done
sed -n '/^[[:space:]]*# A retained signed inventory/,/^[[:space:]]*rm -f "\$work\/advisories.json"/p' "$here/advisories-publish" | sed '$d' >"$work/retained"
s3() { [ "$1" = -o ]; cp "$3" "$2"; }
verify() { openssl pkeyutl -verify -pubin -inkey "$work/pub" -rawin -in "$1" -sigfile "$1.sig" >/dev/null 2>&1; }
has_guests=1 has_remmina=1
. "$work/retained"
for missing in remmina.manifest guests/remmina/rootfs.tar.gz; do
    mv "$dir/$missing" "$work/saved"
    if (. "$work/retained") >"$work/log" 2>&1; then die "accepted missing $missing"; fi
    mv "$work/saved" "$dir/$missing"
done
# Fetch and verify a host payload using the shipped old manifest/download logic.
(
    latest=42 dir=$work/old-release
    mkdir "$dir"
    sed -n '/^have()/p; /^mf()/p; /^download() {/,/^}/p' "$work/old-fetch" >"$work/old-download"
    . "$work/old-download"
    get -o "$dir/manifest" "$url/$latest/manifest"
    get -o "$dir/manifest.sig" "$url/$latest/manifest.sig"
    verify "$dir/manifest"
    [ "$(field release '' "$dir/manifest")" = "$latest" ]
    download slot.img
    cmp "$dir/slot.img" "$ep/beta/42/slot.img"
    rm "$dir/slot.img"
    printf 'tampered\n' >"$ep/beta/42/slot.img"
    if (download slot.img) >"$work/log" 2>&1; then die 'old reader accepted a corrupt payload'; fi
)
if command -v python3 >/dev/null 2>&1; then
    sed -n '/^import re, sys/,/^PY$/p' "$here/advisories-publish" | sed '$d' >"$work/list.py"
    for id in 0 42 00042 20261031123456; do
        {
            printf '<ListBucketResult xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><IsTruncated>false</IsTruncated>'
            for manifest in manifest guests.manifest remmina.manifest; do
                printf '<Contents><Key>beta/%s/%s</Key></Contents>' "$id" "$manifest"
            done
            printf '</ListBucketResult>\n'
        } >"$work/list.xml"
        case $id in
        0|42)
            python3 "$work/list.py" "$work/list.xml" beta >"$work/list"
            [ "$(cat "$work/list")" = "$id 1 1" ] || die 'lost published Remmina requirement'
            ;;
        *)
            if python3 "$work/list.py" "$work/list.xml" beta >"$work/list" 2>"$work/log"; then die 'accepted noncanonical bucket release'; fi
            ;;
        esac
    done
else
    echo 'test-publish: bucket listing fixtures skipped (python3 unavailable)'
fi
# A timed-out clone retries once from an empty tree, then takes the normal fetch-failure branch, never cached GLSAs.
sed -n '/^glsa_url=/p; /^if .*git clone /,/^branch=/p' "$here/advisories" | sed '$d' >"$work/clone"
grep -q '^glsa_url=https://' "$work/clone" || die 'GLSA URL not extracted'
timeout() {
    [ "$1 $2 $3 $4 $5" = '-k 10 120 git clone' ] || die 'unbounded clone'
    [ ! -e "$glsa/partial" ] || die 'clone retried into a partial tree'
    : >"$glsa/partial"
    echo bounded >>"$work/timeout"
    return 124
}
sleep() { :; }
glsa=$work/glsa
mkdir "$glsa"
. "$work/clone"
printf 'bounded\nbounded\n' | cmp - "$work/timeout"
grep -q 'GLSA HTTPS fetch failed' "$work/host.json"
# Feed fetches retry network failures; a failed one is marked, never served from cache.
sed -n '/^fetch() {$/,/^}$/p' "$here/advisories" >"$work/fetch"
[ -s "$work/fetch" ]
curl() {
    case " $* " in *' --retry 2 --retry-connrefused '*) ;; *) return 1 ;; esac
    while [ "$1" != -o ]; do shift; done
    echo feed >"$2"
}
cache=$work/feeds
mkdir "$cache"
. "$work/fetch"
fetch feed.json https://fixture/feed.json
[ "$(cat "$cache/feed.json")" = feed ]
[ ! -e "$work/feed.json.failed" ]
echo 'test-publish: original layout, interrupted pairs, recovery, readers, Remmina, clone deadline and retries passed'
