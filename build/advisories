#!/bin/sh
# Published fixes for release inputs; publish runs this with --gate.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
die() { echo "advisories: $*" >&2; exit 2; }

python_run() {
	"$@" <<'PY'
import contextlib
import datetime as dt
import functools
import io
import json
import re
import sys
import tarfile
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path


def require(condition, why):
    if not condition:
        raise ValueError(why)


# apk-tools src/version.c: token order, lexical leading zeros, prerelease suffixes.
suffixes = 'alpha beta pre rc NONE cvs svn git hg p'.split()
apk_pattern = (r'[0-9]+(?:\.[0-9]+)*[a-z]?'
               r'(?:_(?:alpha|beta|pre|rc|cvs|svn|git|hg|p)[0-9]*)*'
               r'(?:~[0-9a-fA-F]+)?(?:-r[0-9]+)?')


@functools.lru_cache(maxsize=16384)
def apk_tokens(version):
    require(isinstance(version, str) and re.fullmatch(apk_pattern, version),
            f'invalid apk version: {version!r}')
    result = []
    for part in re.findall(r'-r[0-9]+|~[0-9a-fA-F]+|_[a-z]+|\.?[0-9]+|[a-z]', version):
        if part.startswith('-r'):
            token = (6, int(part[2:]))
        elif part.startswith('~'):
            token = (5, part[1:])
        elif part.startswith('_'):
            token = (3, suffixes.index(part[1:]))
        elif part.isalpha():
            token = (2, part)
        elif not result:
            token = (0, int(part))
        elif result[-1][0] == 3:
            token = (4, int(part))
        else:
            token = (1, part.lstrip('.'))
        result.append(token)
    return result + [(7, 0)]


def apk_cmp(a, b):
    for (at, av), (bt, bv) in zip(apk_tokens(a), apk_tokens(b)):
        if at != bt:
            if at == 3 and av < 4:
                return -1
            if bt == 3 and bv < 4:
                return 1
            return (bt > at) - (bt < at)
        if at == 1 and not (av.startswith('0') or bv.startswith('0')):
            av, bv = int(av), int(bv)
        if av != bv:
            return (av > bv) - (av < bv)
    return 0


def installed_apk(text):
    packages = []
    for record in re.split(r'\n\s*\n', text.strip()):
        fields = dict(line.split(':', 1) for line in record.splitlines()
                      if line.startswith(('P:', 'V:', 'o:')))
        require(fields.get('P') and fields.get('V'), 'malformed apk installed record')
        apk_tokens(fields['V'])
        packages.append((fields['P'], fields['V'], fields.get('o', fields['P'])))
    require(packages, 'empty apk installed database')
    return packages


def wan_packages(text):
    packages = []
    for line in text.splitlines():
        if line.startswith('package='):
            match = re.fullmatch(r'package=([A-Za-z0-9+_.-]+)-(' + apk_pattern +
                                r') origin=([A-Za-z0-9+_.-]+)', line)
            require(match, f'invalid wan package record (rebuild WAN with origins): {line}')
            packages.append(match.groups())
    require(packages, 'wan.manifest has no package inventory')
    return packages


def glsa_scan(manifest, directory):
    from portage.dep import Atom, match_from_list
    from portage.versions import _pkg_str, vercmp

    packages = {}
    for line in manifest.read_text().splitlines():
        if line.startswith('package '):
            _, cpv, slot = line.split()
            Atom(f'={cpv}:{slot}')
            package = _pkg_str(cpv, metadata={'SLOT': slot})
            packages.setdefault(package.cp, []).append(package)
    require(packages, f'no package inventory in {manifest}; rebuild the host image')
    files = sorted(directory.glob('glsa-*.xml'))
    require(files, f'no GLSA XML in {directory}')
    items, errors = [], []
    operators = {'lt': '<', 'le': '<=', 'eq': '=', 'ge': '>=', 'gt': '>'}

    def atom(name, node):
        kind, version = node.attrib['range'], (node.text or '').strip()
        op = '~' if kind.startswith('r') else operators[kind]
        if kind.startswith('r'):
            require(kind[1:] in ('lt', 'le', 'ge', 'gt'), f'invalid range {kind}')
        slot = node.get('slot', '*').strip() or '*'
        return Atom(f'{op}{name}-{version}' + (f':{slot}' if slot != '*' else ''))

    def matches(package, node):
        if not match_from_list(atom(package.cp, node), [package]):
            return False
        kind = node.attrib['range']
        if not kind.startswith('r'):
            return True
        comparison = vercmp(package.version, node.text.strip())
        return {'rlt': comparison < 0, 'rle': comparison <= 0,
                'rge': comparison >= 0, 'rgt': comparison > 0}[kind]

    for file in files:
        try:
            advisory = ET.parse(file).getroot()
            require(advisory.tag == 'glsa' and advisory.get('id'), 'invalid GLSA root/id')
            affected = advisory.find('affected')
            require(affected is not None, 'missing affected element')
            if affected.get('type') == 'infrastructure':
                continue
            # Some old GLSAs name no package or range, so they match nothing installed.
            for node in affected.findall('package'):
                name, arches = node.attrib['name'], node.attrib['arch']
                require(re.fullmatch(r'\*|[-_a-z0-9 ]+', arches), 'invalid architecture list')
                vulnerable, safe = node.findall('vulnerable'), node.findall('unaffected')
                if not vulnerable:
                    continue
                for rule in vulnerable + safe:
                    atom(name, rule)
                if arches != '*' and 'amd64' not in arches.split():
                    continue
                for package in packages.get(name, []):
                    if (any(matches(package, rule) for rule in vulnerable)
                            and not any(matches(package, rule) for rule in safe)):
                        fixed = ', '.join(f"{operators[rule.attrib['range'].lstrip('r')]}{rule.text.strip()}"
                                          + (' (same upstream version)' if rule.attrib['range'].startswith('r') else '')
                                          + (f":{rule.get('slot')}" if rule.get('slot') else '')
                                          for rule in safe) or 'not published'
                        items.append((name, f'GLSA-{advisory.attrib["id"]}',
                                      f'{name}:{package.slot} installed {package.version}; fixed {fixed}',
                                      dict(package=name, installed_version=package.version,
                                           fixed_in=None if fixed == 'not published' else fixed,
                                           severity=advisory.find('impact').get('type') if advisory.find('impact') is not None else None)))
        except Exception as error:
            errors.append(f'{file.name}: {error}')
    return items, errors


def glsa_selftest():
    # The release inventory, never the builder's installed database.
    with tempfile.TemporaryDirectory(prefix='advisories-test-') as temporary:
        base = Path(temporary)
        manifest, directory = base / 'manifest', base / 'other-glsa'
        directory.mkdir()
        manifest.write_text('package app-test/example-1.0-r1 0/1\n'
                            'package app-test/example-1.0-r2 1\npackage app-test/example-2.0 2\n')
        xml = ('<glsa id="209901-01"><affected><package name="app-test/example" arch="amd64">'
               '<vulnerable range="rlt">1.0-r3</vulnerable>'
               '<unaffected range="rge" slot="1">1.0-r2</unaffected>'
               '</package></affected></glsa>')
        file = directory / 'glsa-209901-01.xml'
        file.write_text(xml)
        items, errors = glsa_scan(manifest, directory)
        require(not errors and len(items) == 1 and 'installed 1.0-r1;' in items[0][2],
                'Portage release inventory/GLSA directory selftest failed')
        file.write_text(xml.replace('arch="amd64"', 'arch="arm64"'))
        require(glsa_scan(manifest, directory) == ([], []), 'GLSA architecture selftest failed')


def selftest():
    pairs = [('1.9', '1.10'), ('1.01', '1.1'), ('1.01', '1.010'),
             ('1.0_alpha', '1.0_beta'), ('1.0_beta', '1.0_pre'),
             ('1.0_pre', '1.0_rc'), ('1.0_rc9', '1.0'), ('1.0', '1.0_p1'),
             ('1.0_p2', '1.0_p10'), ('1.0', '1.0a'), ('1.0a', '1.0b'),
             ('1.0', '1.0.0'), ('1.0', '1.0-r0'), ('1.0-r2', '1.0-r10'),
             ('1.0_rc1-r9', '1.0-r0'), ('1.0_git1', '1.0_p1')]
    for a, b in pairs:
        require(apk_cmp(a, b) == -1 and apk_cmp(b, a) == 1, f'apk comparison: {a}, {b}')
        require(apk_cmp(a, a) == 0, f'apk equality: {a}')
    require(apk_cmp('01.2', '1.2') == 0, 'apk initial digits')
    require(wan_packages('package=linux-lts-6.18.9-r0 origin=linux-lts\n'
                         'package=libssl3-3.5.1-r0 origin=openssl\n') ==
            [('linux-lts', '6.18.9-r0', 'linux-lts'),
             ('libssl3', '3.5.1-r0', 'openssl')], 'wan inventory origins')
    try:
        wan_packages('package=libssl3-3.5.1-r0\n')
    except ValueError:
        pass
    else:
        raise ValueError('WAN inventory without origins was accepted')
    require(installed_apk('P:libssl3\nV:3.5.1-r0\no:openssl\n') ==
            [('libssl3', '3.5.1-r0', 'openssl')], 'apk origin')
    gate_selftest()
    print('advisories: selftest ok (versions, inventories, gate and exceptions)')


def exceptions(path):
    result = {}
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        fields = line.split(None, 3)
        require(len(fields) == 4 and fields[0] in ('host', 'wan', 'svc', 'browser', 'remmina', 'fw1', 'fw2'),
                f'invalid exception (target package advisory reason): {line}')
        key = tuple(fields[:3])
        require(key not in result and not any('*' in part for part in key), f'invalid/duplicate exception: {line}')
        result[key] = fields[3]
    return result


def archive_text(archive, name):
    members = [member for member in archive if member.name.removeprefix('./') == name]
    require(len(members) == 1 and members[0].isfile(), f'missing/ambiguous {name}')
    return archive.extractfile(members[0]).read().decode()


def alpine_inventory(guests, guest):
    if guest == 'wan':
        text = (guests / 'wan/wan.manifest').read_text()
        versions = re.findall(r'^alpine=(3\.[0-9]+)$', text, re.M)
        packages = wan_packages(text)
    else:
        with tarfile.open(guests / guest / 'rootfs.tar.gz', 'r:gz') as archive:
            version = archive_text(archive, 'etc/alpine-release').strip()
            require(re.fullmatch(r'3\.[0-9]+\.[0-9]+', version), 'invalid Alpine release')
            versions = [version.rsplit('.', 1)[0]]
            packages = installed_apk(archive_text(archive, 'lib/apk/db/installed'))
    require(len(versions) == 1, f'{guest}: missing/ambiguous Alpine branch')
    return 'v' + versions[0], packages


def firewall_version(guests):
    version = (guests / 'fw/openbsd.version').read_text().strip()
    require(re.fullmatch(r'[0-9]+\.[0-9]+', version), 'invalid OpenBSD release')
    return version


def targets(release, gate):
    if not gate:
        return ['fw', 'wan', 'svc', 'browser', 'remmina']
    manifest = Path(release) / 'guests.manifest'
    if not manifest.exists():
        require(not (Path(release) / 'guests').exists(), 'guests without guests.manifest')
        return []
    text = manifest.read_text()
    selected = re.findall(r'^guest (\S+) [0-9a-f]{64}$', text, re.M)
    require(len(selected) == len(set(selected)) and
            all(g in ('fw', 'wan', 'svc', 'browser', 'remmina') for g in selected), 'invalid guest list')
    # The inventory must be a payload publish verifies, not a local sidecar.
    payloads = set(re.findall(r'^[0-9a-f]{64}  (guests/\S+)$', text, re.M))
    require(set(p.split('/')[1] for p in payloads) == set(selected), 'guest payload/list mismatch')
    for guest in selected:
        needed = {'fw': ['fw1.syspatch', 'fw2.syspatch', 'openbsd.version',
                         'fw1.qcow2.zst', 'fw2.qcow2.zst'],
                  'wan': ['wan.manifest', 'wan.qcow2.zst'],
                  'svc': ['rootfs.tar.gz'], 'browser': ['rootfs.tar.gz'], 'remmina': ['rootfs.tar.gz']}[guest]
        require(all(f'guests/{guest}/{name}' in payloads for name in needed),
                f'{guest}: release lacks signed inventory/image; rebuild guest and run build/guests')
    return selected


def sources(guests, selected):
    feeds = {}
    for guest in selected:
        if guest == 'fw':
            version = firewall_version(guests)
            feeds[f'errata-{version}.html'] = f'https://www.openbsd.org/errata{version.replace(".", "")}.html'
        else:
            branch, _ = alpine_inventory(guests, guest)
            for repository in ('main', 'community'):
                feeds[f'{repository}-{branch}.json'] = f'https://secdb.alpinelinux.org/{branch}/{repository}.json'
    return feeds


def gate_selftest():
    with tempfile.TemporaryDirectory(prefix='advisories-test-') as temporary:
        work = Path(temporary)
        guests = work / 'guests'
        exempt = work / 'exceptions'
        exempt.write_text('')
        (work / 'host.json').write_text('[[], []]')
        payloads = {'fw': ['fw1.syspatch', 'fw2.syspatch', 'openbsd.version',
                           'fw1.qcow2.zst', 'fw2.qcow2.zst'],
                    'wan': ['wan.manifest', 'wan.qcow2.zst'],
                    'svc': ['rootfs.tar.gz'], 'browser': ['rootfs.tar.gz'], 'remmina': ['rootfs.tar.gz']}
        manifest = ''
        for guest, files in payloads.items():
            (guests / guest).mkdir(parents=True)
            manifest += f'guest {guest} {"a" * 64}\n'
            manifest += ''.join(f'{"b" * 64}  guests/{guest}/{name}\n' for name in files)
        (work / 'guests.manifest').write_text(manifest)
        (work / 'manifest').write_text('release 42\nversion 0.1.4\nkernel 6.18.9\n')
        (work / 'packages').write_text('package app-containers/incus-7.0.1-r2 0\n')
        (guests / 'fw/openbsd.version').write_text('7.9\n')
        for machine in ('fw1', 'fw2'):
            (guests / f'fw/{machine}.syspatch').write_text('002_later\n')
        errata = 'OpenBSD 7.9 Errata <a href="/002_later.patch.sig">'
        (work / 'errata-7.9.html').write_text(errata)
        (guests / 'wan/wan.manifest').write_text('alpine=3.24\npackage=libssl3-3.5.1-r2 origin=openssl\n')
        for guest in ('svc', 'browser', 'remmina'):
            with tarfile.open(guests / guest / 'rootfs.tar.gz', 'w:gz') as archive:
                for name, text in [('etc/alpine-release', '3.24.2\n'),
                                   ('lib/apk/db/installed', 'P:libssl3\nV:3.5.1-r2\no:openssl\n')]:
                    data = text.encode()
                    member = tarfile.TarInfo('./' + name)
                    member.size = len(data)
                    archive.addfile(member, io.BytesIO(data))

        def secdb(fixed):
            database = {'distroversion': 'v3.24', 'packages': [
                {'pkg': {'name': 'openssl', 'secfixes': {fixed: ['CVE-2099-0001', 'CVE-2099-0002']}}}]}
            for repository in ('main', 'community'):
                (work / f'{repository}-v3.24.json').write_text(json.dumps(database))

        def check(expected):
            output = io.StringIO()
            with contextlib.redirect_stdout(output):
                status = report(work, str(work), guests, '20000101', 'v3.99', 'unused', str(exempt), gate=True)
            require(status == expected, f'gate status {status}, expected {expected}: {output.getvalue()}')
            return output.getvalue()

        secdb('3.5.1-r2')
        check(0)
        require('main-v3.24.json' in sources(guests, targets(work, True)), 'release branch selection')
        secdb('3.5.1-r10')
        output = check(1)
        require(all(f'{g}: libssl3 installed' in output for g in ('wan', 'svc', 'browser', 'remmina')), 'origin match')
        exempt.write_text(''.join(f'{g} openssl CVE-2099-0001 Unused affected feature.\n'
                                 for g in ('wan', 'svc', 'browser', 'remmina')))
        check(1)  # The second advisory still blocks.
        exempt.write_text(exempt.read_text() + ''.join(
            f'{g} openssl CVE-2099-0002 Unused affected feature.\n' for g in ('wan', 'svc', 'browser', 'remmina')))
        require('EXCEPTED:' in check(0), 'exception audit output')
        # W4: daily status retains excepted findings and never publishes a partial scan.
        status = work / 'advisories.json'
        with contextlib.redirect_stdout(io.StringIO()):
            result = report(work, str(work), guests, '20000101', 'v3.99', 'unused', str(exempt), gate=True, status=status)
        data = json.loads(status.read_text())
        require(result == 0 and data['release'] == '42' and len(data['advisories']) == 6,
                'signed status lost excepted or duplicate-feed findings')
        require(all(a['installed_version'] == '3.5.1-r2' and a['fixed_in'] == '3.5.1-r10'
                    and a['severity'] is None for a in data['advisories']), 'structured advisory versions')
        require(any(p['package'] == 'app-containers/incus' and p['version'] == '7.0.1-r2'
                    for p in data['packages']), 'key package inventory')
        status.unlink()
        (work / 'main-v3.24.json.failed').touch()
        with contextlib.redirect_stdout(io.StringIO()):
            result = report(work, str(work), guests, '20000101', 'v3.99', 'unused', str(exempt), gate=True, status=status)
        require(result == 2 and not status.exists(), 'partial daily scan was publishable')
        (work / 'main-v3.24.json.failed').unlink()
        # End W4 status fixtures.
        secdb('invalid')
        check(2)  # Exceptions cannot waive a broken feed.
        secdb('3.5.1-r2')
        (work / 'main-v3.24.json.failed').touch()
        check(2)  # Never use cached data on a fetch failure.
        (work / 'main-v3.24.json.failed').unlink()
        (work / 'errata-7.9.html').write_text(errata + '<a href="/001_older.patch.sig">')
        require('001_older' in check(1), 'older missing syspatch')
        exempt.write_text('fw1 base OPENBSD-7.9-001_older No affected set.\n')
        check(1)  # fw2 must be checked independently.
        exempt.write_text(exempt.read_text() + 'fw2 base OPENBSD-7.9-001_older No affected set.\n')
        check(0)
        (work / 'host.json').write_text(json.dumps([[['app-test/example', 'GLSA-209901-01', 'affected']], []]))
        check(1)
        exempt.write_text(exempt.read_text() + 'host app-test/example GLSA-209901-01 Removed affected binary.\n')
        check(0)
        (work / 'host.json').write_text('[[], ["bad GLSA"]]')
        check(2)
        for broken in ('wan openssl CVE-2099-0001\n', 'wan * CVE-2099-0001 Reason\n'):
            exempt.write_text(broken)
            try:
                exceptions(exempt)
            except ValueError:
                pass
            else:
                raise ValueError('invalid exception accepted')
        (work / 'guests.manifest').write_text(manifest.replace('  guests/wan/wan.manifest', '  guests/wan/other'))
        try:
            targets(work, True)
        except ValueError:
            pass
        else:
            raise ValueError('unsigned inventory accepted')
        (work / 'guests.manifest').write_text('')
        require(targets(work, True) == [], 'host-only release')


def report(work, release, guests, snapshot, branch, minirootfs, exception_file, gate=False, status=None):
    actions, unknown = [], []
    findings = []
    allowed = exceptions(Path(exception_file))
    selected = targets(release, gate)

    def section(name, checks):
        print(f'{name}:')
        items, errors = [], []
        for target, check in checks:
            try:
                for detail in check():
                    if isinstance(detail, (list, tuple)):
                        package, advisory, message, *metadata = detail
                        detail = message
                        if status:
                            require(metadata, 'advisory lacks structured inventory')
                            finding = dict(metadata[0], target=target, advisory=advisory)
                            if finding not in findings:
                                findings.append(finding)
                        reason = allowed.get((target, package, advisory))
                        if reason:
                            print(f'  EXCEPTED: {target} {package} {advisory}: {reason}')
                            continue
                        detail += '; ' + advisory
                    items.append(f'{target}: {detail}')
                    if target not in actions:
                        actions.append(target)
            except Exception as error:
                errors.append(f'{target}: {error}')
        targets = list(dict.fromkeys(item.split(':', 1)[0] for item in items))
        if items:
            print('  ACTION: rebuild ' + ', '.join(targets))
        elif not errors:
            print('  ok')
        for item in items:
            print('  ' + item)
        for error in errors:
            print('  UNKNOWN: ' + error)
        if errors:
            unknown.append(name)

    def source(name):
        require(not (work / (name + '.failed')).exists(), f'{name}: fetch failed')
        return (work / name).read_text()

    def host():
        result = json.loads(source('host.json'))
        yield from result[0]
        require(not result[1], '; '.join(result[1]))

    def kernel():
        require(release, 'no release directory')
        versions = re.findall(r'^kernel\s+(\S+)\s*$', (Path(release) / 'manifest').read_text(), re.M)
        require(len(versions) == 1, 'missing/ambiguous manifest kernel')
        installed = re.fullmatch(r'6\.18\.([0-9]+)(?:-.*)?', versions[0])
        require(installed, f'expected 6.18.x kernel, got {versions[0]}')
        releases = json.loads(source('kernel.json'))['releases']
        latest = [int(row['version'].split('.')[2]) for row in releases
                  if row['moniker'] == 'longterm' and re.fullmatch(r'6\.18\.[0-9]+', row['version'])]
        require(latest, 'no 6.18.x longterm in releases.json')
        behind = max(latest) - int(installed[1])
        if behind > 0:
            yield f'installed {versions[0]}; fixed 6.18.{max(latest)}; {behind} releases behind'

    def firewall(machine):
        openbsd = firewall_version(guests)
        text = source(f'errata-{openbsd}.html')
        require(re.search(r'OpenBSD\s+' + re.escape(openbsd) + r'\s+Errata', text, re.I),
                'wrong/unrecognized OpenBSD errata page')
        ids = set(re.findall(r'/([0-9]{3}_[a-zA-Z0-9_]+)\.patch(?:\.sig)?', text))
        require(ids or re.search(r'no errata', text, re.I), 'no recognizable errata patch links')
        applied = set((guests / 'fw' / f'{machine}.syspatch').read_text().split())
        require(all(re.fullmatch(r'[0-9]{3}_[a-zA-Z0-9_]+', item) for item in applied),
                f'{machine}: invalid syspatch list')
        for missing in sorted(ids - applied):
            yield ('base', f'OPENBSD-{openbsd}-{missing}', f'OpenBSD {openbsd}; missing fix {missing}',
                   dict(package='base', installed_version=openbsd, fixed_in=missing, severity=None))

    def alpine(guest):
        guest_branch, packages = alpine_inventory(guests, guest)
        errors = []
        for repository in ('main', 'community'):
            try:
                database = json.loads(source(f'{repository}-{guest_branch}.json'))
                require(database['distroversion'] == guest_branch, f'{repository}: wrong secdb branch')
                require(isinstance(database['packages'], list) and database['packages'],
                        f'{repository}: empty/invalid secdb packages')
                for entry in database['packages']:
                    package = entry['pkg']
                    relevant = [(name, version, origin) for name, version, origin in packages
                                if package['name'] in (name, origin)]
                    if not relevant:
                        continue
                    for fixed, ids in package['secfixes'].items():
                        require(isinstance(ids, list) and ids and all(isinstance(i, str) and i.strip() for i in ids)
                                and re.fullmatch(apk_pattern, fixed), f'{package["name"]}: malformed secfix')
                        for name, version, origin in relevant:
                            if apk_cmp(version, fixed) < 0:
                                for advisory in ids:
                                    yield (origin, advisory, f'{name} installed {version}; fixed {fixed}',
                                           dict(package=name, installed_version=version, fixed_in=fixed, severity=None))
            except Exception as error:
                errors.append(f'{repository}: {error}')
        require(not errors, '; '.join(errors))

    def snapshot_age():
        date = dt.datetime.strptime(snapshot, '%Y%m%d').date()
        age = (dt.datetime.now(dt.timezone.utc).date() - date).days
        require(age >= 0, 'SNAPSHOT_DATE is in the future')
        print(f'  SNAPSHOT_DATE={snapshot} ({age} days old)')
        if age > 30:
            yield f'Portage snapshot {snapshot}, {age} days old (limit 30); refresh pin'

    def alpine_pin():
        match = re.fullmatch(r'alpine-minirootfs-(3\.[0-9]+\.[0-9]+)-x86_64\.tar\.gz', minirootfs)
        require(match and match[1].rsplit('.', 1)[0] == branch.lstrip('v'), 'invalid minirootfs pin/branch')
        # Read the scalar version fields of the published YAML; no YAML library needed.
        versions = re.findall(r'^\s*version:\s*[\'\"]?(3\.[0-9]+\.[0-9]+)[\'\"]?\s*$',
                              source('latest-releases.yaml'), re.M)
        require(versions and all(v.rsplit('.', 1)[0] == branch.lstrip('v') for v in versions),
                'missing/wrong-branch release versions in latest-releases.yaml')
        latest = max(versions, key=lambda v: tuple(map(int, v.split('.'))))
        if apk_cmp(match[1], latest) < 0:
            yield f'Alpine minirootfs installed {match[1]}; fixed {latest}; refresh pin'

    section('host', [('host', host)])
    if 'fw' in selected:
        section('firewalls', [(machine, lambda machine=machine: firewall(machine)) for machine in ('fw1', 'fw2')])
    section('Alpine guests', [(guest, lambda guest=guest: alpine(guest)) for guest in selected if guest != 'fw'])
    if not gate:
        section('kernel', [('kernel', kernel)])
        section('pins', [('host', snapshot_age), ('guests', alpine_pin)])
    summary = 'rebuild ' + ', '.join(actions) if actions else 'unknown' if unknown else 'nothing to rebuild'
    if unknown:
        summary += '; UNKNOWN: ' + ', '.join(unknown)
    print('advisories: ' + summary)
    if status:
        if unknown:
            return 2
        manifest = (Path(release) / 'manifest').read_text()
        ids = re.findall(r'^release ([0-9]+)$', manifest, re.M)
        require(len(ids) == 1, 'invalid release id')
        versions = []
        for key in ('version', 'kernel'):
            for version in re.findall(r'^' + key + r' (\S+)$', manifest, re.M):
                versions.append(dict(target='host', package=key, version=version))
        for line in (Path(release) / 'packages').read_text().splitlines():
            match = re.fullmatch(r'package (\S+)-([0-9][^ ]*) \S+', line)
            if match and match[1].split('/')[-1] in ('incus', 'openssl', 'systemd-utils', 'openrc'):
                versions.append(dict(target='host', package=match[1], version=match[2]))
        for guest in selected:
            if guest == 'fw':
                versions.append(dict(target='fw', package='OpenBSD', version=firewall_version(guests)))
            else:
                _, packages = alpine_inventory(guests, guest)
                for name, version, _ in packages:
                    if name in ('linux-lts', 'openssl', 'chromium', 'grafana', 'victoria-metrics', 'victoria-logs', 'remmina'):
                        versions.append(dict(target=guest, package=name, version=version))
        Path(status).write_text(json.dumps(dict(release=ids[0], generated=int(dt.datetime.now(dt.timezone.utc).timestamp()),
                                               advisories=findings, packages=versions), sort_keys=True) + '\n')
    return 1 if actions else 2 if unknown else 0


mode, *args = sys.argv[1:]
if mode == '--selftest':
    selftest()
elif mode == 'host':
    try:
        glsa_selftest()
        result = glsa_scan(Path(args[0]), Path(args[1]))
    except Exception as error:
        result = ([], [str(error)])
    print(json.dumps(result))
elif mode == 'sources':
    for name, url in sources(Path(args[1]), targets(args[0], args[2] in ('gate', 'status'))).items():
        print(name, url)
else:
    try:
        sys.exit(report(Path(args[0]), args[1], Path(args[2]), *args[3:7], gate=args[7] in ('gate', 'status'),
                        status=args[8] if args[7] == 'status' else None))
    except Exception as error:
        print(f'advisories: UNKNOWN: {error}', file=sys.stderr)
        sys.exit(2)
PY
}

if [ "${1:-}" = --selftest ]; then
	[ "$#" = 1 ] || die "usage: build/advisories --selftest"
	python_run python3 - --selftest
	exit
fi
mode=report
status=
if [ "${1:-}" = --status ]; then
	[ "$#" = 3 ] || die 'usage: build/advisories --status <output.json> <release-dir>'
	mode=status
	status=$2
	shift 2
fi
if [ "${1:-}" = --gate ]; then
	mode=gate
	shift
	[ "$#" = 1 ] || die "usage: build/advisories --gate <release-dir>"
fi
[ "$#" -le 2 ] || die "usage: build/advisories [release-dir] [guests-dir]"
[ "$(id -u)" = 0 ] || die "run as root"
command -v python3 >/dev/null || die "python3 is required"
. "$repo/guests/alpine.conf"

release=${1:-}
if [ -z "$release" ]; then
	# Release names are UTC timestamps; files in releases/ do not count.
	for directory in "$BUILDER"/releases/*; do
		[ ! -d "$directory" ] || release=$directory
	done
fi
guests=${2:-$BUILDER/stick/guests}
[ "$mode" = report ] || guests=$release/guests
[ -f "$release/manifest" ] || die "no release manifest"
[ -s "$release/packages" ] || die "no package inventory in $release; rebuild the host image"
openssl pkeyutl -verify -pubin -inkey "/etc/convergent/keys/$CHANNEL.pub" -rawin \
	-in "$release/packages" -sigfile "$release/packages.sig" >/dev/null 2>&1 ||
	die 'package inventory signature does not verify with the channel key'
cache=/var/cache/convergent/advisories
mkdir -p "$cache"
work=$(mktemp -d "$cache/.run.XXXXXX")
glsa=
inside=
cleanup() {
	rm -rf "$work"
	[ -z "$glsa" ] || rm -rf "$glsa"
	[ -z "$inside" ] || rm -rf "$inside"
}
trap cleanup 0
trap 'exit 2' HUP INT TERM

fetch() {
	if curl -q -fsSL --proto =https --proto-redir =https --max-time 60 "$2" -o "$work/$1.part"; then
		mv "$work/$1.part" "$cache/$1"
		cp "$cache/$1" "$work/$1"
	else
		rm -f "$work/$1.part"
		: > "$work/$1.failed"
	fi
}

python_run python3 - sources "$release" "$guests" "$mode" >"$work/sources" || die "invalid release inventories"
while read -r name url; do fetch "$name" "$url"; done <"$work/sources"

# Publish a complete GLSA set; a failed sync must not replace the last fetch.
glsa=$(mktemp -d "$cache/.glsa.XXXXXX")
if git clone --quiet --depth 1 https://anongit.gentoo.org/git/data/glsa.git "$glsa"; then
	previous=$(readlink "$cache/glsa" 2>/dev/null || true)
	ln -s "${glsa##*/}" "$work/glsa-link"
	mv -Tf "$work/glsa-link" "$cache/glsa"
	glsa=
	case "$previous" in .glsa.*) case "$previous" in */*) ;; *) rm -rf "${cache:?}/$previous" ;; esac ;; esac
	# Portage matching needs no proc or dev mounts and never reads the builder's VDB.
	if inside=$(mktemp -d "$BUILDER/tmp/advisories.XXXXXX") &&
		cp -R "$cache/glsa/." "$inside/" &&
		cp "$release/packages" "$inside/manifest" &&
		python_run chroot "$BUILDER" /usr/bin/python3 - host "${inside#"$BUILDER"}/manifest" "${inside#"$BUILDER"}" > "$work/host.json"; then
		:
	else
		printf '%s\n' '[[], ["builder chroot/Portage check failed"]]' > "$work/host.json"
	fi
else
	printf '%s\n' '[[], ["GLSA HTTPS fetch failed"]]' > "$work/host.json"
fi
branch=v${ALPINE_BRANCH#v}
if [ "$mode" = report ]; then
	fetch kernel.json https://www.kernel.org/releases.json
	fetch latest-releases.yaml "https://dl-cdn.alpinelinux.org/alpine/$branch/releases/x86_64/latest-releases.yaml"
fi
python_run python3 - report "$work" "$release" "$guests" "$SNAPSHOT_DATE" "$branch" "$MINIROOTFS" "$here/advisories.exceptions" "$mode" "$status"
