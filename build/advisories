	mv -Tf "$work/glsa-link" "$cache/glsa"
	glsa=
	case "$previous" in .glsa.*) case "$previous" in */*) ;; *) rm -rf "${cache:?}/$previous" ;; esac ;; esac
	# Portage matching needs no proc or dev mounts and never reads the builder's VDB.
	if inside=$(mktemp -d "$BUILDER/tmp/advisories.XXXXXX") &&
		cp -R "$cache/glsa/." "$inside/" &&
		cp "$release/packages" "$inside/manifest" &&
		python_run chroot "$BUILDER" /usr/bin/python3 - host "${inside#"$BUILDER"}/manifest" "${inside#"$BUILDER"}" > "$work/host.json"; then
		:
	else
		printf '%s\n' '[[], ["builder chroot/Portage check failed"]]' > "$work/host.json"
	fi
else
	printf '%s\n' '[[], ["GLSA HTTPS fetch failed"]]' > "$work/host.json"
fi
branch=v${ALPINE_BRANCH#v}
if [ "$mode" = report ]; then
	fetch kernel.json https://www.kernel.org/releases.json
	fetch latest-releases.yaml "https://dl-cdn.alpinelinux.org/alpine/$branch/releases/x86_64/latest-releases.yaml"
fi
python_run python3 - report "$work" "$release" "$guests" "$SNAPSHOT_DATE" "$branch" "$MINIROOTFS" "$here/advisories.exceptions" "$mode" "$status"
