#!/bin/sh
# Published fixes for release inputs; publish runs this with --gate.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
. "$here/build.conf"
die() { echo "advisories: $*" >&2; exit 2; }

python_run() {
	"$@" <<'PY'
import contextlib
import datetime as dt
import email.utils
import fcntl
import functools
import gzip
import hashlib
import io
import json
import re
import subprocess
import sys
import tarfile
import tempfile
import xml.etree.ElementTree as ET
from unittest.mock import patch
from pathlib import Path


def require(condition, why):
    if not condition:
        raise ValueError(why)


# apk-tools src/version.c: token order, lexical leading zeros, prerelease suffixes.
suffixes = 'alpha beta pre rc NONE cvs svn git hg p'.split()
apk_pattern = (r'[0-9]+(?:\.[0-9]+)*[a-z]?'
               r'(?:_(?:alpha|beta|pre|rc|cvs|svn|git|hg|p)[0-9]*)*'
               r'(?:~[0-9a-fA-F]+)?(?:-r[0-9]+)?')


@functools.lru_cache(maxsize=16384)
def apk_tokens(version):
    require(isinstance(version, str) and re.fullmatch(apk_pattern, version),
            f'invalid apk version: {version!r}')
    result = []
    for part in re.findall(r'-r[0-9]+|~[0-9a-fA-F]+|_[a-z]+|\.?[0-9]+|[a-z]', version):
        if part.startswith('-r'):
            token = (6, int(part[2:]))
        elif part.startswith('~'):
            token = (5, part[1:])
        elif part.startswith('_'):
            token = (3, suffixes.index(part[1:]))
        elif part.isalpha():
            token = (2, part)
        elif not result:
            token = (0, int(part))
        elif result[-1][0] == 3:
            token = (4, int(part))
        else:
            token = (1, part.lstrip('.'))
        result.append(token)
    return result + [(7, 0)]


def apk_cmp(a, b):
    for (at, av), (bt, bv) in zip(apk_tokens(a), apk_tokens(b)):
        if at != bt:
            if at == 3 and av < 4:
                return -1
            if bt == 3 and bv < 4:
                return 1
            return (bt > at) - (bt < at)
        if at == 1 and not (av.startswith('0') or bv.startswith('0')):
            av, bv = int(av), int(bv)
        if av != bv:
            return (av > bv) - (av < bv)
    return 0


def installed_apk(text):
    packages = []
    for record in re.split(r'\n\s*\n', text.strip()):
        fields = dict(line.split(':', 1) for line in record.splitlines()
                      if line.startswith(('P:', 'V:', 'o:')))
        require(fields.get('P') and fields.get('V'), 'malformed apk installed record')
        apk_tokens(fields['V'])
        packages.append((fields['P'], fields['V'], fields.get('o', fields['P'])))
    require(packages, 'empty apk installed database')
    return packages


def wan_packages(text):
    packages = []
    for line in text.splitlines():
        if line.startswith('package='):
            match = re.fullmatch(r'package=([A-Za-z0-9+_.-]+)-(' + apk_pattern +
                                r') origin=([A-Za-z0-9+_.-]+)', line)
            require(match, f'invalid wan package record (rebuild WAN with origins): {line}')
            packages.append(match.groups())
    require(packages, 'wan.manifest has no package inventory')
    return packages


def glsa_scan(manifest, directory):
    from portage.dep import Atom, match_from_list
    from portage.versions import _pkg_str, vercmp

    packages = {}
    for line in manifest.read_text().splitlines():
        if line.startswith('package '):
            _, cpv, slot = line.split()
            Atom(f'={cpv}:{slot}')
            package = _pkg_str(cpv, metadata={'SLOT': slot})
            packages.setdefault(package.cp, []).append(package)
    require(packages, f'no package inventory in {manifest}; rebuild the host image')
    files = sorted(directory.glob('glsa-*.xml'))
    require(files, f'no GLSA XML in {directory}')
    items, errors = [], []
    operators = {'lt': '<', 'le': '<=', 'eq': '=', 'ge': '>=', 'gt': '>'}

    def atom(name, node):
        kind, version = node.attrib['range'], (node.text or '').strip()
        op = '~' if kind.startswith('r') else operators[kind]
        if kind.startswith('r'):
            require(kind[1:] in ('lt', 'le', 'ge', 'gt'), f'invalid range {kind}')
        slot = node.get('slot', '*').strip() or '*'
        return Atom(f'{op}{name}-{version}' + (f':{slot}' if slot != '*' else ''))

    def matches(package, node):
        if not match_from_list(atom(package.cp, node), [package]):
            return False
        kind = node.attrib['range']
        if not kind.startswith('r'):
            return True
        comparison = vercmp(package.version, node.text.strip())
        return {'rlt': comparison < 0, 'rle': comparison <= 0,
                'rge': comparison >= 0, 'rgt': comparison > 0}[kind]

    for file in files:
        try:
            advisory = ET.parse(file).getroot()
            require(advisory.tag == 'glsa' and advisory.get('id'), 'invalid GLSA root/id')
            affected = advisory.find('affected')
            require(affected is not None, 'missing affected element')
            if affected.get('type') == 'infrastructure':
                continue
            # Some old GLSAs name no package or range, so they match nothing installed.
            for node in affected.findall('package'):
                name, arches = node.attrib['name'], node.attrib['arch']
                require(re.fullmatch(r'\*|[-_a-z0-9 ]+', arches), 'invalid architecture list')
                vulnerable, safe = node.findall('vulnerable'), node.findall('unaffected')
                if not vulnerable:
                    continue
                for rule in vulnerable + safe:
                    atom(name, rule)
                if arches != '*' and 'amd64' not in arches.split():
                    continue
                for package in packages.get(name, []):
                    if (any(matches(package, rule) for rule in vulnerable)
                            and not any(matches(package, rule) for rule in safe)):
                        fixed = ', '.join(f"{operators[rule.attrib['range'].lstrip('r')]}{rule.text.strip()}"
                                          + (' (same upstream version)' if rule.attrib['range'].startswith('r') else '')
                                          + (f":{rule.get('slot')}" if rule.get('slot') else '')
                                          for rule in safe) or 'not published'
                        items.append((name, f'GLSA-{advisory.attrib["id"]}',
                                      f'{name}:{package.slot} installed {package.version}; fixed {fixed}',
                                      dict(package=name, installed_version=package.version,
                                           fixed_in=None if fixed == 'not published' else fixed,
                                           severity=advisory.find('impact').get('type') if advisory.find('impact') is not None else None)))
        except Exception as error:
            errors.append(f'{file.name}: {error}')
    return items, errors


def glsa_selftest():
    # The release inventory, never the builder's installed database.
    with tempfile.TemporaryDirectory(prefix='advisories-test-') as temporary:
        base = Path(temporary)
        manifest, directory = base / 'manifest', base / 'other-glsa'
        directory.mkdir()
        manifest.write_text('package app-test/example-1.0-r1 0/1\n'
                            'package app-test/example-1.0-r2 1\npackage app-test/example-2.0 2\n')
        xml = ('<glsa id="209901-01"><affected><package name="app-test/example" arch="amd64">'
               '<vulnerable range="rlt">1.0-r3</vulnerable>'
               '<unaffected range="rge" slot="1">1.0-r2</unaffected>'
               '</package></affected></glsa>')
        file = directory / 'glsa-209901-01.xml'
        file.write_text(xml)
        items, errors = glsa_scan(manifest, directory)
        require(not errors and len(items) == 1 and 'installed 1.0-r1;' in items[0][2],
                'Portage release inventory/GLSA directory selftest failed')
        file.write_text(xml.replace('arch="amd64"', 'arch="arm64"'))
        require(glsa_scan(manifest, directory) == ([], []), 'GLSA architecture selftest failed')


def selftest():
    pairs = [('1.9', '1.10'), ('1.01', '1.1'), ('1.01', '1.010'),
             ('1.0_alpha', '1.0_beta'), ('1.0_beta', '1.0_pre'),
             ('1.0_pre', '1.0_rc'), ('1.0_rc9', '1.0'), ('1.0', '1.0_p1'),
             ('1.0_p2', '1.0_p10'), ('1.0', '1.0a'), ('1.0a', '1.0b'),
             ('1.0', '1.0.0'), ('1.0', '1.0-r0'), ('1.0-r2', '1.0-r10'),
             ('1.0_rc1-r9', '1.0-r0'), ('1.0_git1', '1.0_p1')]
    for a, b in pairs:
        require(apk_cmp(a, b) == -1 and apk_cmp(b, a) == 1, f'apk comparison: {a}, {b}')
        require(apk_cmp(a, a) == 0, f'apk equality: {a}')
    require(apk_cmp('01.2', '1.2') == 0, 'apk initial digits')
    require(wan_packages('package=linux-lts-6.18.9-r0 origin=linux-lts\n'
                         'package=libssl3-3.5.1-r0 origin=openssl\n') ==
            [('linux-lts', '6.18.9-r0', 'linux-lts'),
             ('libssl3', '3.5.1-r0', 'openssl')], 'wan inventory origins')
    try:
        wan_packages('package=libssl3-3.5.1-r0\n')
    except ValueError:
        pass
    else:
        raise ValueError('WAN inventory without origins was accepted')
    require(installed_apk('P:libssl3\nV:3.5.1-r0\no:openssl\n') ==
            [('libssl3', '3.5.1-r0', 'openssl')], 'apk origin')
    incus_ui_selftest()
    gate_selftest()
    print('advisories: selftest ok (versions, inventories, gate and exceptions)')


def exceptions(path):
    result = {}
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        fields = line.split(None, 3)
        require(len(fields) == 4 and fields[0] in ('host', 'wan', 'svc', 'browser', 'remmina', 'fw1', 'fw2'),
                f'invalid exception (target package advisory reason): {line}')
        key = tuple(fields[:3])
        require(key not in result and not any('*' in part for part in key), f'invalid/duplicate exception: {line}')
        result[key] = fields[3]
    return result


def archive_text(archive, name):
    members = [member for member in archive if member.name.removeprefix('./') == name]
    require(len(members) == 1 and members[0].isfile(), f'missing/ambiguous {name}')
    return archive.extractfile(members[0]).read().decode()


def alpine_inventory(guests, guest):
    if guest == 'wan':
        text = (guests / 'wan/wan.manifest').read_text()
        versions = re.findall(r'^alpine=(3\.[0-9]+)$', text, re.M)
        packages = wan_packages(text)
    else:
        with tarfile.open(guests / guest / 'rootfs.tar.gz', 'r:gz') as archive:
            version = archive_text(archive, 'etc/alpine-release').strip()
            require(re.fullmatch(r'3\.[0-9]+\.[0-9]+', version), 'invalid Alpine release')
            versions = [version.rsplit('.', 1)[0]]
            packages = installed_apk(archive_text(archive, 'lib/apk/db/installed'))
    require(len(versions) == 1, f'{guest}: missing/ambiguous Alpine branch')
    return 'v' + versions[0], packages


def firewall_version(guests):
    version = (guests / 'fw/openbsd.version').read_text().strip()
    require(re.fullmatch(r'[0-9]+\.[0-9]+', version), 'invalid OpenBSD release')
    return version


def legacy_release(release):
    versions = re.findall(r'^version (\S+)$', (Path(release) / 'manifest').read_text(), re.M)
    return len(versions) == 1 and re.fullmatch(r'0\.(0\.[0-9]+|1\.[0-6])(-rc[0-9]+)?', versions[0]) is not None


def alpine_coverage(guests, guest, legacy=False):
    imports = {}
    if guest == 'svc':
        with tarfile.open(guests / guest / 'rootfs.tar.gz', 'r:gz') as archive:
            if legacy and not any(m.name.removeprefix('./') == 'etc/convergent/apk-imports' for m in archive):
                return None
            text = archive_text(archive, 'etc/convergent/apk-imports')
        for line in text.splitlines():
            fields = line.split()
            require(len(fields) == 3, 'invalid imported package provenance')
            name, version, repository = fields
            require(name not in imports and repository in ('edge/main', 'edge/community', 'edge/testing'),
                    'invalid/duplicate imported package provenance')
            imports[name] = (version, repository)
    return imports


def targets(release, gate):
    if not gate:
        return ['fw', 'wan', 'svc', 'browser', 'remmina']
    manifest = Path(release) / 'guests.manifest'
    if not manifest.exists():
        require(not (Path(release) / 'guests').exists(), 'guests without guests.manifest')
        return []
    text = manifest.read_text()
    sidecar = Path(release) / 'remmina.manifest'
    if sidecar.exists():
        text += sidecar.read_text()
    selected = re.findall(r'^guest (\S+) [0-9a-f]{64}$', text, re.M)
    require(len(selected) == len(set(selected)) and
            all(g in ('fw', 'wan', 'svc', 'browser', 'remmina') for g in selected), 'invalid guest list')
    # The inventory must be a payload publish verifies, not a local sidecar.
    payloads = set(re.findall(r'^[0-9a-f]{64}  (guests/\S+)$', text, re.M))
    require(set(p.split('/')[1] for p in payloads) == set(selected), 'guest payload/list mismatch')
    for guest in selected:
        needed = {'fw': ['fw1.syspatch', 'fw2.syspatch', 'openbsd.version',
                         'fw1.qcow2.zst', 'fw2.qcow2.zst'],
                  'wan': ['wan.manifest', 'wan.qcow2.zst'],
                  'svc': ['rootfs.tar.gz'], 'browser': ['rootfs.tar.gz'], 'remmina': ['rootfs.tar.gz']}[guest]
        require(all(f'guests/{guest}/{name}' in payloads for name in needed),
                f'{guest}: release lacks signed inventory/image; rebuild guest and run build/guests')
    return selected


def sources(guests, selected):
    feeds = {}
    for guest in selected:
        if guest == 'fw':
            version = firewall_version(guests)
            feeds[f'errata-{version}.html'] = f'https://www.openbsd.org/errata{version.replace(".", "")}.html'
        else:
            branch, _ = alpine_inventory(guests, guest)
            for repository in ('main', 'community'):
                feeds[f'{repository}-{branch}.json'] = f'https://secdb.alpinelinux.org/{branch}/{repository}.json'
    return feeds


def incus_ui_version(version, debian=False):
    pattern = r'(7\.0\.[0-9]+)-debian12-([0-9]{12})' if debian else r'(7\.0\.[0-9]+)_p([0-9]{12})(?:-r[0-9]+)?'
    match = re.fullmatch(pattern, version)
    require(match, f'unsupported Incus UI version: {version}')
    return tuple(map(int, match[1].split('.'))), int(match[2])


def incus_ui_packages(release, compressed):
    checksums = re.findall(r'^SHA256:\n((?:[ \t]+[^\n]+\n)+)', release, re.M)
    require(len(checksums) == 1, 'missing/ambiguous Zabbly SHA256 section')
    entries = [line.split() for line in checksums[0].splitlines()]
    entries = [entry for entry in entries if len(entry) == 3 and entry[2] == 'main/binary-amd64/Packages.gz']
    require(len(entries) == 1, 'missing/ambiguous Zabbly Packages.gz checksum')
    digest, size, _ = entries[0]
    require(size.isdigit() and int(size) == len(compressed) and
            hashlib.sha256(compressed).hexdigest() == digest, 'Zabbly Packages.gz checksum/size mismatch')
    versions = []
    for record in re.split(r'\n\s*\n', gzip.decompress(compressed).decode().strip()):
        fields = dict(line.split(': ', 1) for line in record.splitlines() if line and not line[0].isspace() and ': ' in line)
        if fields.get('Package') != 'incus-ui-canonical' or fields.get('Architecture') != 'amd64':
            continue
        version = fields.get('Version', '')
        incus_ui_version(version, debian=True)
        versions.append(version)
    require(versions, 'Zabbly index has no amd64 incus-ui-canonical')
    return max(versions, key=lambda version: incus_ui_version(version, debian=True))


def incus_ui_generation(release, now):
    def signed_date(field, optional=False):
        values = re.findall(r'^' + field + r':[^\S\n]*(.*)$', release, re.M)
        if optional and not values:
            return None
        require(len(values) == 1, f'missing/ambiguous Zabbly {field}')
        value = email.utils.parsedate_to_datetime(values[0])
        require(value.tzinfo is not None, f'invalid Zabbly {field} timezone')
        return int(value.timestamp())

    generated = signed_date('Date')
    expires = signed_date('Valid-Until', optional=True)
    # Cap index age at seven days, even without Valid-Until.
    require(0 <= now - generated <= 7 * 86400, 'stale/future Zabbly Date')
    require(expires is None or generated <= now < expires, 'expired Zabbly index')
    return generated


def incus_ui_latest(work):
    for name in ('zabbly-key.asc', 'zabbly-InRelease', 'zabbly-Packages.gz'):
        require(not (work / (name + '.failed')).exists(), f'{name}: fetch failed')
    with tempfile.TemporaryDirectory(prefix='zabbly-gpg-', dir=work) as home:
        command = ['gpg', '--homedir', home, '--batch', '--no-options']
        subprocess.run(command + ['--import', str(work / 'zabbly-key.asc')], check=True,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        verified = subprocess.run(command + ['--status-fd', '2', '--decrypt', str(work / 'zabbly-InRelease')],
                                  check=True, capture_output=True, text=True)
        signatures = [line.split() for line in verified.stderr.splitlines() if line.startswith('[GNUPG:] VALIDSIG ')]
        require(len(signatures) == 1 and signatures[0][-1] == '4EFC590696CB15B87C73A3AD82CC8797C838DCFD',
                'Zabbly InRelease signed by an unexpected key')
        latest = incus_ui_packages(verified.stdout, (work / 'zabbly-Packages.gz').read_bytes())
        generated = incus_ui_generation(verified.stdout, int(dt.datetime.now(dt.timezone.utc).timestamp()))
        floor = work.parent / 'zabbly.generated'
        with (work.parent / 'zabbly.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            previous = floor.read_text().strip() if floor.exists() else '0'
            require(re.fullmatch(r'[0-9]+', previous) and generated >= int(previous), 'Zabbly Date regressed')
            pending = floor.with_suffix('.generated.new')
            pending.write_text(str(generated) + '\n')
            pending.replace(floor)
        return latest


def incus_ui_selftest():
    version = '7.0.1-debian12-202609250207'
    records = ('Package: incus-ui-canonical\nArchitecture: amd64\nVersion: ' + version + '\n\n'
               'Package: incus-ui-canonical\nArchitecture: arm64\nVersion: 7.0.9-debian12-209901010000\n\n'
               'Package: incus\nArchitecture: amd64\nVersion: 7.0.9-debian12-209901010000\n')
    compressed = gzip.compress(records.encode())
    release = ('SHA256:\n ' + hashlib.sha256(compressed).hexdigest() + ' ' + str(len(compressed)) +
               ' main/binary-amd64/Packages.gz\n')
    require(incus_ui_packages(release, compressed) == version, 'wrong UI package/architecture')
    require(incus_ui_version('7.0.1_p202609250207-r1') == incus_ui_version(version, True), 'UI version mapping')
    require(incus_ui_version('7.0.1_p202609250206') < incus_ui_version(version, True), 'UI build comparison')
    require(incus_ui_version('7.0.2_p202601010000') > incus_ui_version(version, True), 'UI release comparison')
    for bad_release, bad_data in ((release, compressed + b'x'), (release.replace('SHA256:', 'MD5Sum:'), compressed),
                                  (release + release, compressed), (release.replace('amd64', 'arm64'), compressed)):
        try:
            incus_ui_packages(bad_release, bad_data)
        except ValueError:
            pass
        else:
            raise ValueError('invalid UI index was accepted')
    with tempfile.TemporaryDirectory(prefix='incus-ui-test-') as temporary:
        work = Path(temporary) / 'run'
        work.mkdir()
        (work / 'zabbly-Packages.gz').write_bytes(compressed)
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        date = email.utils.format_datetime(dt.datetime.fromtimestamp(now, dt.timezone.utc))
        dated = 'Date: ' + date + '\n' + release
        verified = subprocess.CompletedProcess([], 0, dated,
            '[GNUPG:] VALIDSIG 4EFC590696CB15B87C73A3AD82CC8797C838DCFD 0 0 0 4 0 1 10 01 '
            '4EFC590696CB15B87C73A3AD82CC8797C838DCFD\n')
        with patch.object(subprocess, 'run', return_value=verified) as run:
            verified.stdout = 'Date: ' + email.utils.format_datetime(
                dt.datetime.fromtimestamp(now - 1, dt.timezone.utc)) + '\n' + release
            require(incus_ui_latest(work) == version, 'initial UI generation')
            verified.stdout = dated
            require(incus_ui_latest(work) == version, 'verified UI index')
            require('--import' in run.call_args_list[0].args[0] and '--decrypt' in run.call_args.args[0] and
                    run.call_args.kwargs['check'], 'UI signature verification is not required')
            floor = work.parent / 'zabbly.generated'
            require(floor.read_text().strip() == str(now), 'UI generation not persisted')
            for bad in (release, dated + 'Date: ' + date + '\n',
                        'Date: invalid\n' + release,
                        'Date: ' + email.utils.format_datetime(dt.datetime.fromtimestamp(now - 7 * 86400 - 1, dt.timezone.utc)) + '\n' + release,
                        'Date: ' + email.utils.format_datetime(dt.datetime.fromtimestamp(now + 3600, dt.timezone.utc)) + '\n' + release,
                        dated + 'Valid-Until: ' + date + '\n', dated + 'Valid-Until: invalid\n',
                        dated + 'Valid-Until: ' + date + '\nValid-Until: ' + date + '\n',
                        'Date: ' + email.utils.format_datetime(dt.datetime.fromtimestamp(now - 1, dt.timezone.utc)) + '\n' + release):
                verified.stdout = bad
                try:
                    incus_ui_latest(work)
                except ValueError:
                    pass
                else:
                    raise ValueError('stale/invalid/regressing UI index was accepted')
                require(floor.read_text().strip() == str(now), 'rejected UI index changed floor')
            verified.stdout = dated + 'Valid-Until: ' + email.utils.format_datetime(
                dt.datetime.fromtimestamp(now + 86400, dt.timezone.utc)) + '\n'
            require(incus_ui_latest(work) == version, 'valid UI expiry rejected')
            verified.stderr = verified.stderr.replace('4EFC590696CB15B87C73A3AD82CC8797C838DCFD', '0' * 40)
            try:
                incus_ui_latest(work)
            except ValueError:
                pass
            else:
                raise ValueError('wrong UI signing key was accepted')
        with patch.object(subprocess, 'run', side_effect=subprocess.CalledProcessError(1, 'gpg')):
            try:
                incus_ui_latest(work)
            except subprocess.CalledProcessError:
                pass
            else:
                raise ValueError('invalid UI signature was accepted')
        (work / 'zabbly-InRelease.failed').touch()
        try:
            incus_ui_latest(work)
        except ValueError:
            pass
        else:
            raise ValueError('cached UI index used after fetch failure')


def gate_selftest():
    with tempfile.TemporaryDirectory(prefix='advisories-test-') as temporary:
        work = Path(temporary)
        guests = work / 'guests'
        exempt = work / 'exceptions'
        exempt.write_text('')
        (work / 'host.json').write_text('[[], []]')
        payloads = {'fw': ['fw1.syspatch', 'fw2.syspatch', 'openbsd.version',
                           'fw1.qcow2.zst', 'fw2.qcow2.zst'],
                    'wan': ['wan.manifest', 'wan.qcow2.zst'],
                    'svc': ['rootfs.tar.gz'], 'browser': ['rootfs.tar.gz'], 'remmina': ['rootfs.tar.gz']}
        manifest = ''
        for guest, files in payloads.items():
            (guests / guest).mkdir(parents=True)
            manifest += f'guest {guest} {"a" * 64}\n'
            manifest += ''.join(f'{"b" * 64}  guests/{guest}/{name}\n' for name in files)
        (work / 'guests.manifest').write_text(manifest)
        (work / 'manifest').write_text('release 42\nversion 0.1.7\nkernel 6.18.9\n')
