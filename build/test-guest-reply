#!/bin/sh
# Guest readbacks must reject valid prefixes with excess bytes or failed transfers.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
mkdir "$scratch/tmp"
TMPDIR=$scratch/tmp; export TMPDIR
reply=$scratch/reply
result=0
transport() { cat "$reply"; return "$result"; }
refuse() {
    if "$@" >"$scratch/output"; then echo "accepted: $*" >&2; exit 1; fi
    [ ! -s "$scratch/output" ]
}
for limit in 128 4096 65536 1048576; do
    head -c "$limit" /dev/zero >"$reply"
    guest_reply "$limit" transport >"$scratch/output"
    cmp "$reply" "$scratch/output"
    printf '\n' >>"$reply"
    refuse guest_reply "$limit" transport
done
printf 'valid\n' >"$reply"
result=7
refuse guest_reply 128 transport
code=0
guest_reply --display 128 transport >"$scratch/output" || code=$?
[ "$code" = 7 ]
cmp "$reply" "$scratch/output"
head -c 129 /dev/zero >"$reply"
refuse guest_reply --display 128 transport
: >"$reply"
code=0
guest_reply 128 transport || code=$?
[ "$code" = 7 ]
result=0
# A streaming producer stops at the pipe limit, without filling shell memory.
cat >"$scratch/stream" <<'STREAM'
#!/bin/sh
set -eu
. "$1"
guest_reply 128 yes valid
STREAM
sh -n "$scratch/stream"
code=0
timeout -k 1 5 sh "$scratch/stream" "$repo/rootfs/usr/lib/convergent/guest-reply.sh" >"$scratch/output" || code=$?
[ "$code" = 125 ]
[ ! -s "$scratch/output" ]
[ -z "$(find "$TMPDIR" -mindepth 1 -print)" ]

# Exercise the production assignments, not copies of their byte limits.
rsh() { transport; }
ic() { transport; }
ssh() { transport; }
wan_probe() { transport; }
timeout() { shift 3; "$@"; }
bad() { return 1; }
fail() { return 1; }
die() { exit 1; }
node=fw1 cmd=true kind=pf fw=fw1 rdir=/unused file=fixture want=valid
work=$scratch
sed -n '/^[[:space:]]*\(if \)\{0,1\}\(carp\|diag\|wifi\|portal\|actual\)=.*\$(/p' "$repo/tools/check" |
    sed 's/^[[:space:]]*if / /; s/; then$//' >"$scratch/check-reads"
[ "$(wc -l <"$scratch/check-reads")" = 5 ]
sed -n '/^[[:space:]]*have=\$(guest_reply /p' "$repo/tools/dns-push" >>"$scratch/check-reads"
[ "$(wc -l <"$scratch/check-reads")" = 6 ]
while IFS= read -r line; do
    printf '%s\n' "$line" >"$scratch/read"
    sh -n "$scratch/read"
    printf 'valid\n' >"$reply"
    result=0
    (. "$scratch/read")
    for fault in overflow transfer; do
        printf 'valid\n' >"$reply"
        result=0
        case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) result=7 ;; esac
        if (. "$scratch/read"); then echo "accepted $fault: $line" >&2; exit 1; fi
    done
done <"$scratch/check-reads"
# A failed hash readback names its transfer status; only an answered hash can differ.
die() { echo "dns-push: $*" >&2; exit 1; }
sed -n '/^[[:space:]]*have=\$(guest_reply /,/stage hash differs on/p' "$repo/tools/dns-push" >"$scratch/hash"
[ "$(wc -l <"$scratch/hash")" = 2 ]
sh -n "$scratch/hash"
for fault in transfer differs; do
    case $fault in transfer) : >"$reply"; result=7 ;; differs) printf 'other\n' >"$reply"; result=0 ;; esac
    if (. "$scratch/hash") 2>"$scratch/error"; then echo "accepted $fault hash" >&2; exit 1; fi
    case $fault in
    transfer) grep -qx 'dns-push: cannot hash fixture on fw1 (status 7)' "$scratch/error" ;;
    differs) grep -qx 'dns-push: stage hash differs on fw1' "$scratch/error" ;;
    esac
done
result=0

sed -n '/^seed_applied() {/,/^}/p' "$repo/tools/guests" >"$scratch/seed"
[ -s "$scratch/seed" ]; sh -n "$scratch/seed"; . "$scratch/seed"
state=$scratch/state
mkdir -p "$state/seeds"
for node in fw1 wan svc; do
    echo valid >"$state/seeds/$node.id"
    echo valid >"$reply"
    result=0
    seed_applied "$node"
    # Command substitution drops newlines: an uncapped read would still match.
    head -c 129 /dev/zero | tr '\000' '\n' >>"$reply"
    if seed_applied "$node"; then exit 1; fi
    echo valid >"$reply"
    result=7
    if seed_applied "$node"; then exit 1; fi
done

# Full default-topology ifconfig + pfctl -si, with at least 48 KiB spare.
cp "$here/fixtures/firewall-reply" "$reply"
result=0
[ "$(grep -c '^carp[0-9]*:' "$reply")" = 10 ]
[ "$(grep -c '^vlan[0-9]*:' "$reply")" = 4 ]
[ "$((65536 - $(wc -c <"$reply")))" -ge 49152 ]
guest_reply 65536 transport >"$scratch/output"
cmp "$reply" "$scratch/output"
: >"$scratch/no-config"
CONVERGENT_CONFIG=$scratch/no-config sh "$here/networks" registry "$scratch/registry"
sed -n '/^heal_probe() {/,/^}/p' "$repo/rootfs/usr/lib/convergent/incus/firewall-heal" |
    sed -e "s|/usr/lib/convergent/incus/carp.awk|$repo/rootfs/usr/lib/convergent/incus/carp.awk|g" \
        -e "s|/etc/convergent/segments|$scratch/registry/etc/convergent/segments|g" >"$scratch/probe"
[ -s "$scratch/probe" ]; sh -n "$scratch/probe"; . "$scratch/probe"
[ "$(heal_probe fw1)" = master ]

for module in 10-wifi 14-firewall; do
    sed -e "s|/usr/lib/convergent/guest-reply.sh|$repo/rootfs/usr/lib/convergent/guest-reply.sh|" \
        -e "s|/usr/lib/convergent/incus/|$repo/rootfs/usr/lib/convergent/incus/|g" \
        -e "s|registry=/etc/convergent/segments|registry=$scratch/registry/etc/convergent/segments|" \
        "$repo/rootfs/usr/lib/convergent/sys/$module" >"$scratch/module"
    sh -n "$scratch/module"; . "$scratch/module"
done
# firewall_role reads the host registry: the firewall answers only data (ifconfig, legacy probe); a hostile
# reply never reaches awk's argument list.
(
    awk() {
        # Refuse unexpected operands before a regression could open /dev/zero.
        [ "$#" = 6 ] && [ "$5" = "$scratch/registry/etc/convergent/segments" ] || {
            echo unsafe >"$scratch/role-operand"; return 1;
        }
        command awk "$1" "$2" "$3" "$repo/rootfs/usr/lib/convergent/incus/carp.awk" \
            "$scratch/registry/etc/convergent/segments" "$6"
    }
    # A current firewall answers the legacy probe with nothing.
    firewall_rsh() { printf '%s\n' "$2" >>"$scratch/role-calls"; [ "$2" = ifconfig ] || return 0; cat "$reply"; }
    for sample in good device; do
        : >"$scratch/role-calls"
        case $sample in
        good) cp "$here/fixtures/firewall-reply" "$reply" ;;
        device) printf '/dev/zero\n' >"$reply" ;;
        esac
        if firewall_role fw1 MASTER; then [ "$sample" = good ]; else [ "$sample" = device ]; fi
        [ "$(tail -n 1 "$scratch/role-calls")" = ifconfig ]
        [ ! -e "$scratch/role-operand" ]
    done
)
# firewall_role reads only host registries: a hostile reply never reaches awk's argument list.
: >"$scratch/role-calls"
firewall_rsh() { printf '%s\n' "$2" >>"$scratch/role-calls"; printf '%s\n' "-eBEGIN{system(\"touch $scratch/pwned\")}"; }
firewall_role fw1 MASTER >/dev/null 2>&1 || :
[ "$(tail -n 1 "$scratch/role-calls")" = ifconfig ] && [ ! -e "$scratch/pwned" ] ||
    { echo 'test-guest-reply: firewall_role trusts a firewall-supplied path'; exit 1; }
# A firewall from before the registry is held to the six system segments, a current one to all.
awk '/^carp[6-9]:/ {skip=1; next} /^[a-z]/ {skip=0} !skip' "$here/fixtures/firewall-reply" >"$scratch/legacy-reply"
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$scratch/legacy-reply"; else echo legacy; fi; }
firewall_role fw1 MASTER
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$scratch/legacy-reply"; fi; }
if firewall_role fw1 MASTER; then echo 'test-guest-reply: six segments passed a current firewall'; exit 1; fi
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$here/fixtures/firewall-reply"; fi; }
firewall_role fw1 MASTER
run() { transport; }
firewall_rsh() { transport; }
# Ordinary failures retain both the guest's text and its status for UI advice.
for failure in 'Operation failed' 'Authentication failed' 'No network found'; do
    printf '%s\n' "$failure" >"$reply"
    result=7 code=0
    wifi_join_reply connect >"$scratch/output" 2>"$scratch/error" || code=$?
    [ "$code" = 7 ]
    cmp "$reply" "$scratch/output"
    case $failure in
    'Operation failed') grep -q 'Wi-Fi association failed:' "$scratch/error" ;;
    'Authentication failed') grep -q 'Wi-Fi authentication failed:' "$scratch/error" ;;
    'No network found') grep -q 'Wi-Fi has no signal' "$scratch/error" ;;
    esac
done
printf 'Scan failed\n' >"$reply"
code=0
wifi_wan scan >"$scratch/output" || code=$?
[ "$code" = 7 ]
cmp "$reply" "$scratch/output"
printf 'Status: Enabled\nRUNNING defer: on\nhas address 100.80.2.10\n' >"$reply"
result=0
wifi_reply status >"$scratch/output"
cmp "$reply" "$scratch/output"
firewall_healthy fw1
for fault in overflow transfer; do
    case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) echo valid >"$reply"; result=7 ;; esac
    if wifi_reply status >/dev/null; then exit 1; fi
    if firewall_healthy fw1; then exit 1; fi
done

for check in wifi uplink; do
    sed -n "/check $check [0-9][0-9]* <<'CHECK'/,/^CHECK$/p" \
        "$repo/rootfs/usr/lib/convergent/sys/99-selftest" | sed '1d;$d' |
        sed "s|/usr/lib/convergent/guest-reply.sh|$repo/rootfs/usr/lib/convergent/guest-reply.sh|" >"$scratch/selftest-body"
    [ -s "$scratch/selftest-body" ]; sh -n "$scratch/selftest-body"
    printf 'sudo() { cat "$REPLY"; return "$RESULT"; }\n' >"$scratch/selftest"
    cat "$scratch/selftest-body" >>"$scratch/selftest"
    for fault in none overflow transfer; do
        printf 'State connected\ndefault via 192.168.1.1\n' >"$reply"
        result=0
        case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) result=7 ;; esac
        if REPLY=$reply RESULT=$result sh -eu "$scratch/selftest" >"$scratch/output"; then
            [ "$fault" = none ]
        else [ "$fault" != none ]; fi
    done
done

# Console and keyscan readbacks are parsed from files before entering shell variables.
sed -n '/^    .*ic console "\$1" --show-log >/p; /^    .*probe ssh-keyscan /p' \
    "$repo/tools/guests" >"$scratch/pin-reads"
[ "$(wc -l <"$scratch/pin-reads")" = 2 ]
probe() { transport; }
address=127.0.0.1
read_pin() { set -- fw1; . "$scratch/read"; }
while IFS= read -r line; do
    printf '%s\n' "$line" >"$scratch/read"
    sh -n "$scratch/read"
    echo valid >"$reply"
    result=0
    read_pin
    head -c 1048577 /dev/zero >>"$reply"
    if read_pin; then exit 1; fi
done <"$scratch/pin-reads"

sed -n '/^upstream_net() {/,/^}/p; /^status_side() {/,/^}/p' "$repo/tools/portal" >"$scratch/portal"
[ -s "$scratch/portal" ]; sh -n "$scratch/portal"; . "$scratch/portal"
net_of() { printf '%s\n' "$1"; }
result=0
printf '== addresses\nwlan0 192.168.1.2/24\n== routes\ndefault via 192.168.1.1 dev wlan0\n' >"$reply"
[ "$(upstream_net)" = 192.168.1.2/24 ]
head -c 65537 /dev/zero >>"$reply"
if upstream_net; then exit 1; fi
echo on >"$reply"
[ "$(status_side wan)" = on ]
head -c 129 /dev/zero >>"$reply"
if status_side wan; then exit 1; fi
echo on >"$reply"
result=7
if status_side wan; then exit 1; fi
sed -n '/^status() {/,/^}/p' "$repo/tools/portal" >"$scratch/portal-status"
[ -s "$scratch/portal-status" ]; sh -n "$scratch/portal-status"
(
    . "$scratch/portal-status"
    run=$scratch stamp=$scratch/no-stamp reason=$scratch/no-reason
    expire() { :; }
    rsh() {
        head -c 131072 /dev/zero | tr '\000' x >&2
        case $1 in wan) echo off ;; *) echo 'dns 0 lan 0' ;; esac
        [ "$1" != "$failed" ]
    }
    for failed in none wan fw1 fw2; do
        code=0
        status >"$scratch/output" 2>"$scratch/error" || code=$?
        [ ! -e "$run/portal.err" ]
        [ ! -s "$scratch/error" ]
        if [ "$failed" = none ]; then
            [ "$code" = 0 ]; grep -qx 'portal: off' "$scratch/output"
        else
            [ "$code" = 1 ]; grep -qx 'portal: unknown' "$scratch/output"
            grep -qx "$failed  unreachable: status probe failed" "$scratch/output"
        fi
    done
)
echo 'test-guest-reply: byte limits, transfer failures, cleanup and production readbacks passed'
