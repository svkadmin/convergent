#!/bin/sh
# Guest readbacks must reject valid prefixes with excess bytes or failed transfers.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=${here%/build}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
mkdir "$scratch/tmp"
TMPDIR=$scratch/tmp; export TMPDIR
reply=$scratch/reply
result=0
transport() { cat "$reply"; return "$result"; }
refuse() {
    if "$@" >"$scratch/output"; then echo "accepted: $*" >&2; exit 1; fi
    [ ! -s "$scratch/output" ]
}
for limit in 128 4096 65536 1048576; do
    head -c "$limit" /dev/zero >"$reply"
    guest_reply "$limit" transport >"$scratch/output"
    cmp "$reply" "$scratch/output"
    printf '\n' >>"$reply"
    refuse guest_reply "$limit" transport
done
printf 'valid\n' >"$reply"
result=7
refuse guest_reply 128 transport
code=0
guest_reply --display 128 transport >"$scratch/output" || code=$?
[ "$code" = 7 ]
cmp "$reply" "$scratch/output"
head -c 129 /dev/zero >"$reply"
refuse guest_reply --display 128 transport
: >"$reply"
code=0
guest_reply 128 transport || code=$?
[ "$code" = 7 ]
result=0
# A streaming producer stops at the pipe limit, without filling shell memory.
cat >"$scratch/stream" <<'STREAM'
#!/bin/sh
set -eu
. "$1"
guest_reply 128 yes valid
STREAM
sh -n "$scratch/stream"
code=0
timeout -k 1 5 sh "$scratch/stream" "$repo/rootfs/usr/lib/convergent/guest-reply.sh" >"$scratch/output" || code=$?
[ "$code" = 125 ]
[ ! -s "$scratch/output" ]
[ -z "$(find "$TMPDIR" -mindepth 1 -print)" ]
# Guest text for the owner keeps newline and tab, never a control byte; stdout and the status stay raw.
ctl=$(printf '[\001-\010\013-\037\177]')
shown() { if LC_ALL=C grep -q "$ctl" "$1"; then echo "test-guest-reply: control bytes shown by $2" >&2; exit 1; fi; }
printf 'a\tb\033]52;c;eA==\007\r\177\nc\n' | guest_text >"$scratch/output"
printf 'a\tb]52;c;eA==\nc\n' | cmp - "$scratch/output"
hostile() { printf 'out\033[2J\n'; printf 'err\033]52;c;eA==\007\n' >&2; return 7; }
raw_out() { printf 'out\033[2J\n' | cmp - "$scratch/output"; }
code=0
guest_stderr hostile >"$scratch/output" 2>"$scratch/error" || code=$?
[ "$code" = 7 ]; raw_out; grep -qx 'err]52;c;eA==' "$scratch/error"; shown "$scratch/error" guest_stderr
guest_stderr true
flood() { head -c 131072 /dev/zero | tr '\000' x >&2; }
guest_stderr flood 2>"$scratch/error" || :
[ "$(wc -c <"$scratch/error")" = 65536 ]
# Remote stderr of dns-push and portal SSH calls, and of check's into its audited report.
{ sed -n '/^rsh\(_in\|_wait\)\{0,1\}() {/p' "$repo/tools/dns-push"; sed -n '/^rsh() {/p' "$repo/tools/portal" "$repo/tools/check"; } >"$scratch/rsh"
[ "$(wc -l <"$scratch/rsh")" = 5 ]
(
    conf=unused ssh_conf=unused
    timeout() { shift; "$@"; }
    while IFS= read -r line; do
        printf '%s\n' "$line" >"$scratch/read"; sh -n "$scratch/read"; . "$scratch/read"
        ssh() { hostile; }
        code=0
        ${line%%(*} fw1 true </dev/null >"$scratch/output" 2>"$scratch/error" || code=$?
        [ "$code" = 7 ]; raw_out; grep -qx 'err]52;c;eA==' "$scratch/error"; shown "$scratch/error" "${line%%(*}"
        ssh() { flood; }
        ${line%%(*} fw1 true </dev/null >/dev/null 2>"$scratch/error" || :
        [ "$(wc -c <"$scratch/error")" = 65536 ]
    done <"$scratch/rsh"
)
# guests SSH probes and mutators: remote stderr bounded and filtered, mutator stdout dropped.
sed -n '/^rsh() {/,/^}/p; /^locked() (/,/^)/p; /^fw_mutate() {/,/^}/p' "$repo/tools/guests" >"$scratch/guests-rsh"
[ "$(grep -c '^[a-z_]*() [{(]$' "$scratch/guests-rsh")" = 3 ]; sh -n "$scratch/guests-rsh"
(
    . "$scratch/guests-rsh"
    conf=unused
    fail() { return 1; }
    probe() { "$@"; }
    timeout() { shift 3; "$@"; }
    for call in rsh fw_mutate; do
        ssh() { hostile; }
        code=0
        $call fw1 true </dev/null >"$scratch/output" 2>"$scratch/error" || code=$?
        [ "$code" = 7 ]; grep -qx 'err]52;c;eA==' "$scratch/error"; shown "$scratch/error" "$call"
        case $call in rsh) raw_out ;; *) [ ! -s "$scratch/output" ] ;; esac
        ssh() { flood; }
        $call fw1 true </dev/null >/dev/null 2>"$scratch/error" || :
        [ "$(wc -c <"$scratch/error")" = 65536 ]
    done
)
# guests failure diagnostics: remote stderr and the console tail.
sed -n '/^retry() {/,/^}/p' "$repo/tools/guests" >"$scratch/retry"
[ -s "$scratch/retry" ]; sh -n "$scratch/retry"
(
    . "$scratch/retry"
    boot_timeout=0 work=$scratch polling=
    fail() { return 1; }
    cut() { echo 100; }
    logger() { :; }
    healthy() { hostile >/dev/null; }
    ic() { printf 'console\033[2J\n'; }
    if retry healthy fw1 2>"$scratch/error"; then exit 1; fi
    grep -qx 'err]52;c;eA==' "$scratch/error"; grep -Fqx 'console[2J' "$scratch/error"; shown "$scratch/error" retry
)
# The svc TLS failure shows what the peer's certificate chose (s_client prints its subject).
sed -n '/^healthy() {/,/^}/p' "$repo/tools/guests" >"$scratch/healthy"
[ -s "$scratch/healthy" ]; sh -n "$scratch/healthy"
(
    . "$scratch/healthy"
    work=$scratch tls=/unused step=test
    fail() { echo "guests: $step: $*" >&2; return 1; }
    probe() { [ "$1" != openssl ] || { printf 'depth=0 CN = \033]52;c;eA==\007\n'; return 1; }; }
    if healthy svc 2>"$scratch/error"; then exit 1; fi
    grep -q 'syslog TLS check failed: depth=0 CN = ]52;c;eA==' "$scratch/error"; shown "$scratch/error" 'healthy svc'
)

# Exercise the production assignments, not copies of their byte limits.
rsh() { transport; }
ic() { transport; }
ssh() { transport; }
wan_probe() { transport; }
timeout() { shift 3; "$@"; }
bad() { return 1; }
fail() { return 1; }
die() { exit 1; }
node=fw1 cmd=true kind=pf fw=fw1 rdir=/unused file=fixture want=valid
work=$scratch
sed -n '/^[[:space:]]*\(if \)\{0,1\}\(carp\|diag\|wifi\|portal\|actual\)=.*\$(/p' "$repo/tools/check" |
    sed 's/^[[:space:]]*if / /; s/; then$//' >"$scratch/check-reads"
[ "$(wc -l <"$scratch/check-reads")" = 5 ]
sed -n '/^[[:space:]]*have=\$(guest_reply /p' "$repo/tools/dns-push" >>"$scratch/check-reads"
[ "$(wc -l <"$scratch/check-reads")" = 6 ]
# Replies redirected into scratch files are bounded too.
sed -n '/rsh "\$node" ifconfig >"\$work\/\$node"/p' "$repo/tools/check" >>"$scratch/check-reads"
sed -n '/rsh "\$fw" "cat \$rdir\/local-names.conf" >/p' "$repo/tools/dns-push" >>"$scratch/check-reads"
[ "$(wc -l <"$scratch/check-reads")" = 8 ]
while IFS= read -r line; do
    printf '%s\n' "$line" >"$scratch/read"
    sh -n "$scratch/read"
    printf 'valid\n' >"$reply"
    result=0
    (. "$scratch/read")
    for fault in overflow transfer; do
        printf 'valid\n' >"$reply"
        result=0
        case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) result=7 ;; esac
        if (. "$scratch/read"); then echo "accepted $fault: $line" >&2; exit 1; fi
    done
done <"$scratch/check-reads"
# An unanswered CARP query (a loaded or relinking firewall) is no reason to rebuild it.
sed -n '/rsh "\$node" ifconfig >"\$work\/\$node"/p' "$repo/tools/check" >"$scratch/carp-query"
[ -s "$scratch/carp-query" ]
(bad() { echo "$*" >"$scratch/bad"; }; result=7; . "$scratch/carp-query")
grep -qx 'fw1 CARP query failed' "$scratch/bad"
# A failed hash readback names its transfer status; only an answered hash can differ.
die() { echo "dns-push: $*" >&2; exit 1; }
sed -n '/^[[:space:]]*have=\$(guest_reply /,/stage hash differs on/p' "$repo/tools/dns-push" >"$scratch/hash"
[ "$(wc -l <"$scratch/hash")" = 2 ]
sh -n "$scratch/hash"
for fault in transfer differs; do
    case $fault in transfer) : >"$reply"; result=7 ;; differs) printf 'other\n' >"$reply"; result=0 ;; esac
    if (. "$scratch/hash") 2>"$scratch/error"; then echo "accepted $fault hash" >&2; exit 1; fi
    case $fault in
    transfer) grep -qx 'dns-push: cannot hash fixture on fw1 (status 7)' "$scratch/error" ;;
    differs) grep -qx 'dns-push: stage hash differs on fw1' "$scratch/error" ;;
    esac
done
result=0
# Update and topology probes write firewall replies to state-disk scratch files.
{
    sed -n '/rsh "\$1" .ifconfig. >"\$work\/carp"/p; /rsh "\$1" .ifconfig pfsync0. >/p' "$repo/tools/guests"
    sed -n '/rsh "\$peer" ifconfig >"\$work\/carp" && awk /s/ && awk .*//p' "$repo/tools/guests"
    sed -n '/rsh "\$1" ifconfig >"\$work\/carp"/p; /rsh "\$node" .if test -f \/etc\/convergent\/segments; then cat/p
        /rsh "\$node" ifconfig >"\$work\/carp"/p' "$repo/rootfs/usr/lib/convergent/incus/fw-topology"
} >"$scratch/file-reads"
[ "$(wc -l <"$scratch/file-reads")" = 6 ]
(
    set -- fw1
    peer=fw2
    while IFS= read -r line; do
        printf '%s\n' "$line" >"$scratch/read"
        sh -n "$scratch/read"
        case $line in *segments*) bound=4096 ;; *) bound=65536 ;; esac
        printf 'valid\n' >"$reply"
        result=0
        (. "$scratch/read")
        for fault in overflow transfer; do
            printf 'valid\n' >"$reply"
            result=0
            case $fault in overflow) head -c "$bound" /dev/zero >>"$reply" ;; transfer) result=7 ;; esac
            if (. "$scratch/read"); then echo "accepted $fault: $line" >&2; exit 1; fi
        done
    done <"$scratch/file-reads"
)
# Unattended apply and init log only bounded diagnostics: probes and mutators keep guest stdout out.
(
    sed -n '/rsh "\$1" .pfctl -nf \/etc\/pf\.conf./p' "$repo/tools/guests" >"$scratch/quiet"
    [ "$(wc -l <"$scratch/quiet")" = 1 ]
    sed -n '/^healthy() {/,/^}/p; /^locked() (/,/^)/p; /^fw_mutate() {/,/^}/p' "$repo/tools/guests" >"$scratch/quiet-functions"
    [ -s "$scratch/quiet-functions" ]; sh -n "$scratch/quiet-functions"; . "$scratch/quiet-functions"
    set -- fw1
    conf=/unused
    printf 'valid\n' >"$reply"
    result=0
    (. "$scratch/quiet") >"$scratch/output"
    healthy fw1 >>"$scratch/output"
    healthy wan >>"$scratch/output"
    fw_mutate fw1 true >>"$scratch/output"
    [ ! -s "$scratch/output" ]
)

sed -n '/^seed_applied() {/,/^}/p' "$repo/tools/guests" >"$scratch/seed"
[ -s "$scratch/seed" ]; sh -n "$scratch/seed"; . "$scratch/seed"
state=$scratch/state
mkdir -p "$state/seeds"
for node in fw1 wan svc; do
    echo valid >"$state/seeds/$node.id"
    echo valid >"$reply"
    result=0
    seed_applied "$node"
    # Command substitution drops newlines: an uncapped read would still match.
    head -c 129 /dev/zero | tr '\000' '\n' >>"$reply"
    if seed_applied "$node"; then exit 1; fi
    echo valid >"$reply"
    result=7
    if seed_applied "$node"; then exit 1; fi
done

# Full default-topology ifconfig + pfctl -si, with at least 48 KiB spare.
cp "$here/fixtures/firewall-reply" "$reply"
result=0
[ "$(grep -c '^carp[0-9]*:' "$reply")" = 10 ]
[ "$(grep -c '^vlan[0-9]*:' "$reply")" = 4 ]
[ "$((65536 - $(wc -c <"$reply")))" -ge 49152 ]
guest_reply 65536 transport >"$scratch/output"
cmp "$reply" "$scratch/output"
: >"$scratch/no-config"
CONVERGENT_CONFIG=$scratch/no-config sh "$here/networks" registry "$scratch/registry"
sed -n '/^heal_probe() {/,/^}/p' "$repo/rootfs/usr/lib/convergent/incus/firewall-heal" |
    sed -e "s|/usr/lib/convergent/incus/carp.awk|$repo/rootfs/usr/lib/convergent/incus/carp.awk|g" \
        -e "s|/etc/convergent/segments|$scratch/registry/etc/convergent/segments|g" >"$scratch/probe"
[ -s "$scratch/probe" ]; sh -n "$scratch/probe"; . "$scratch/probe"
[ "$(heal_probe fw1)" = master ]

for module in 10-wifi 14-firewall; do
    sed -e "s|/usr/lib/convergent/guest-reply.sh|$repo/rootfs/usr/lib/convergent/guest-reply.sh|" \
        -e "s|/usr/lib/convergent/incus/|$repo/rootfs/usr/lib/convergent/incus/|g" \
        -e "s|registry=/etc/convergent/segments|registry=$scratch/registry/etc/convergent/segments|" \
        "$repo/rootfs/usr/lib/convergent/sys/$module" >"$scratch/module"
    sh -n "$scratch/module"; . "$scratch/module"
done
(
    run() { shift 2; [ "$1" = ssh ] || return 97; hostile; }
    code=0
    firewall_rsh fw1 true >"$scratch/output" 2>"$scratch/error" || code=$?
    [ "$code" = 7 ]; raw_out; grep -qx 'err]52;c;eA==' "$scratch/error"; shown "$scratch/error" firewall_rsh
    run() { shift 4; [ "$1" = ssh ] || exit 97; hostile; }
    code=0
    firewall_mutate fw1 true >"$scratch/output" 2>"$scratch/error" || code=$?
    [ "$code" = 7 ]; [ ! -s "$scratch/output" ]; grep -qx 'err]52;c;eA==' "$scratch/error"; shown "$scratch/error" firewall_mutate
)
# firewall_role reads the host registry: the firewall answers only data (ifconfig, legacy probe); a hostile
# reply never reaches awk's argument list.
(
    awk() {
        # Refuse unexpected operands before a regression could open /dev/zero.
        [ "$#" = 6 ] && [ "$5" = "$scratch/registry/etc/convergent/segments" ] || {
            echo unsafe >"$scratch/role-operand"; return 1;
        }
        command awk "$1" "$2" "$3" "$repo/rootfs/usr/lib/convergent/incus/carp.awk" \
            "$scratch/registry/etc/convergent/segments" "$6"
    }
    # A current firewall answers the legacy probe with nothing.
    firewall_rsh() { printf '%s\n' "$2" >>"$scratch/role-calls"; [ "$2" = ifconfig ] || return 0; cat "$reply"; }
    for sample in good device; do
        : >"$scratch/role-calls"
        case $sample in
        good) cp "$here/fixtures/firewall-reply" "$reply" ;;
        device) printf '/dev/zero\n' >"$reply" ;;
        esac
        if firewall_role fw1 MASTER; then [ "$sample" = good ]; else [ "$sample" = device ]; fi
        [ "$(tail -n 1 "$scratch/role-calls")" = ifconfig ]
        [ ! -e "$scratch/role-operand" ]
    done
)
# firewall_role reads only host registries: a hostile reply never reaches awk's argument list.
: >"$scratch/role-calls"
firewall_rsh() { printf '%s\n' "$2" >>"$scratch/role-calls"; printf '%s\n' "-eBEGIN{system(\"touch $scratch/pwned\")}"; }
firewall_role fw1 MASTER >/dev/null 2>&1 || :
[ "$(tail -n 1 "$scratch/role-calls")" = ifconfig ] && [ ! -e "$scratch/pwned" ] ||
    { echo 'test-guest-reply: firewall_role trusts a firewall-supplied path'; exit 1; }
# A firewall from before the registry is held to the six system segments, a current one to all.
awk '/^carp[6-9]:/ {skip=1; next} /^[a-z]/ {skip=0} !skip' "$here/fixtures/firewall-reply" >"$scratch/legacy-reply"
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$scratch/legacy-reply"; else echo legacy; fi; }
firewall_role fw1 MASTER
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$scratch/legacy-reply"; fi; }
if firewall_role fw1 MASTER; then echo 'test-guest-reply: six segments passed a current firewall'; exit 1; fi
firewall_rsh() { if [ "$2" = ifconfig ]; then cat "$here/fixtures/firewall-reply"; fi; }
firewall_role fw1 MASTER
run() { transport; }
firewall_rsh() { transport; }
# Ordinary failures retain both the guest's text and its status for UI advice.
for failure in 'Operation failed' 'Authentication failed' 'No network found'; do
    printf '%s\n' "$failure" >"$reply"
    result=7 code=0
    wifi_join_reply connect >"$scratch/output" 2>"$scratch/error" || code=$?
    [ "$code" = 7 ]
    cmp "$reply" "$scratch/output"
    case $failure in
    'Operation failed') grep -q 'Wi-Fi association failed:' "$scratch/error" ;;
    'Authentication failed') grep -q 'Wi-Fi authentication failed:' "$scratch/error" ;;
    'No network found') grep -q 'Wi-Fi has no signal' "$scratch/error" ;;
    esac
done
printf 'Scan failed\n' >"$reply"
code=0
wifi_wan scan >"$scratch/output" || code=$?
[ "$code" = 7 ]
cmp "$reply" "$scratch/output"
printf 'net\033]52;c;eA==\007\n' >"$reply"
result=0
wifi_reply status >"$scratch/output"
grep -qx 'net]52;c;eA==' "$scratch/output"; shown "$scratch/output" wifi_reply
printf 'Status: Enabled\nRUNNING defer: on\nhas address 100.80.2.10\n' >"$reply"
result=0
wifi_reply status >"$scratch/output"
cmp "$reply" "$scratch/output"
firewall_healthy fw1
for fault in overflow transfer; do
    case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) echo valid >"$reply"; result=7 ;; esac
    if wifi_reply status >/dev/null; then exit 1; fi
    if firewall_healthy fw1; then exit 1; fi
done
# Status bounds both replies and tells a silent node from a bad reply before advising a rebuild.
(
    id() { echo 0; }
    noargs() { [ "$#" = 0 ]; }
    firewall_rsh() {
        case $2 in
        ifconfig) [ "$fault" = bad ] || return 124; head -c 65537 /dev/zero ;;
        *) echo 'Status: Enabled'
            case $fault in silent) ;; escape) printf 'pwn\033]52;c;eA==\007\n' ;; *) head -c 131072 /dev/zero | tr '\000' x ;; esac ;;
        esac
    }
    for fault in silent bad escape; do
        code=0
        FIREWALL_SSH_TIMEOUT=30 firewall_status >"$scratch/output" || code=$?
        [ "$code" = 1 ]
        [ "$(wc -c <"$scratch/output")" -lt 4096 ]
        [ "$(grep -c '^retry, check sys guests status and /var/log/incus/fw[12]/console.log before sys firewall rebuild fw[12]$' "$scratch/output")" = 2 ]
        case $fault in
        silent) grep -qx 'fw1: no answer within 30 s' "$scratch/output"; grep -qx 'Status: Enabled' "$scratch/output" ;;
        escape) grep -qx 'pwn]52;c;eA==' "$scratch/output"; shown "$scratch/output" firewall_status ;;
        bad) grep -qx 'fw1 sent a bad (oversized or malformed) reply' "$scratch/output"
            if grep -q 'Status: Enabled' "$scratch/output"; then exit 1; fi ;;
        esac
    done
)

for check in wifi uplink; do
    sed -n "/check $check [0-9][0-9]* <<'CHECK'/,/^CHECK$/p" \
        "$repo/rootfs/usr/lib/convergent/sys/99-selftest" | sed '1d;$d' |
        sed "s|/usr/lib/convergent/guest-reply.sh|$repo/rootfs/usr/lib/convergent/guest-reply.sh|" >"$scratch/selftest-body"
    [ -s "$scratch/selftest-body" ]; sh -n "$scratch/selftest-body"
    printf 'sudo() { cat "$REPLY"; return "$RESULT"; }\n' >"$scratch/selftest"
    cat "$scratch/selftest-body" >>"$scratch/selftest"
    for fault in none overflow transfer; do
        printf 'State connected\ndefault via 192.168.1.1\n' >"$reply"
        result=0
        case $fault in overflow) head -c 65537 /dev/zero >>"$reply" ;; transfer) result=7 ;; esac
        if REPLY=$reply RESULT=$result sh -eu "$scratch/selftest" >"$scratch/output"; then
            [ "$fault" = none ]
        else [ "$fault" != none ]; fi
    done
done

# Console and keyscan readbacks are parsed from files before entering shell variables.
sed -n '/^    .*ic console "\$1" --show-log >/p; /^    .*probe ssh-keyscan /p' \
    "$repo/tools/guests" >"$scratch/pin-reads"
[ "$(wc -l <"$scratch/pin-reads")" = 2 ]
probe() { transport; }
address=127.0.0.1
read_pin() { set -- fw1; . "$scratch/read"; }
while IFS= read -r line; do
    printf '%s\n' "$line" >"$scratch/read"
    sh -n "$scratch/read"
    echo valid >"$reply"
    result=0
    read_pin
    head -c 1048577 /dev/zero >>"$reply"
    if read_pin; then exit 1; fi
done <"$scratch/pin-reads"

sed -n '/^upstream_net() {/,/^}/p; /^status_side() {/,/^}/p' "$repo/tools/portal" >"$scratch/portal"
[ -s "$scratch/portal" ]; sh -n "$scratch/portal"; . "$scratch/portal"
net_of() { printf '%s\n' "$1"; }
result=0
printf '== addresses\nwlan0 192.168.1.2/24\n== routes\ndefault via 192.168.1.1 dev wlan0\n' >"$reply"
[ "$(upstream_net)" = 192.168.1.2/24 ]
head -c 65537 /dev/zero >>"$reply"
if upstream_net; then exit 1; fi
echo on >"$reply"
[ "$(status_side wan)" = on ]
head -c 129 /dev/zero >>"$reply"
if status_side wan; then exit 1; fi
echo on >"$reply"
result=7
if status_side wan; then exit 1; fi
sed -n '/^status() {/,/^}/p' "$repo/tools/portal" >"$scratch/portal-status"
[ -s "$scratch/portal-status" ]; sh -n "$scratch/portal-status"
(
    . "$scratch/portal-status"
    run=$scratch stamp=$scratch/no-stamp reason=$scratch/no-reason
    expire() { :; }
    rsh() {
        head -c 131072 /dev/zero | tr '\000' x >&2
        case $1 in wan) echo off ;; *) echo 'dns 0 lan 0' ;; esac
        [ "$1" != "$failed" ]
    }
    for failed in none wan fw1 fw2; do
        code=0
        status >"$scratch/output" 2>"$scratch/error" || code=$?
        [ ! -e "$run/portal.err" ]
        [ ! -s "$scratch/error" ]
        if [ "$failed" = none ]; then
            [ "$code" = 0 ]; grep -qx 'portal: off' "$scratch/output"
        else
            [ "$code" = 1 ]; grep -qx 'portal: unknown' "$scratch/output"
            grep -qx "$failed  unreachable: status probe failed" "$scratch/output"
        fi
    done
)
# Mutators keep guest stdout off the owner's terminal and keep their status.
sed -n '/^open_side() {/,/^}/p' "$repo/tools/portal" >"$scratch/open-side"
[ -s "$scratch/open-side" ]; sh -n "$scratch/open-side"
(
    . "$scratch/open-side"
    wan_addr=192.0.2.1 lan=192.0.2.0/24
    rsh() { printf 'out\033[2J\n'; return 7; }
    for side in wan fw1; do
        code=0
        open_side "$side" >"$scratch/output" || code=$?
        [ "$code" = 7 ]; [ ! -s "$scratch/output" ]
    done
)
sed -n '/^# Stage, hash and validate/,/^cp "\$work\/list\.raw" "\$state\/list\.rpz\.new"$/p' "$repo/tools/dns-push" |
    sed '$d' >"$scratch/dns-mutators"
[ "$(grep -c 'rsh_in\|rsh_wait' "$scratch/dns-mutators")" = 4 ]; sh -n "$scratch/dns-mutators"
(
    die() { echo "dns-push: $*" >&2; exit 1; }
    fws=fw1 rdir=/unused durable=: lock=: unlock=: restore=: selftest=probe selftest_addr=192.0.2.53
    state=$scratch/dns-state work=$scratch/dns-work
    mkdir -p "$state" "$work"
    : >"$work/blocklist.rpz"; : >"$work/local-owner.conf"
    rsh() { sha256sum <"$work/$file" | cut -d' ' -f1; }
    rsh_in() { cat >/dev/null; echo rsh_in >>"$scratch/dns-calls"; printf 'out\033[2J\n'; }
    rsh_wait() { echo rsh_wait >>"$scratch/dns-calls"; printf 'out\033[2J\n'; }
    : >"$scratch/dns-calls"
    (. "$scratch/dns-mutators") >"$scratch/output"
    [ ! -s "$scratch/output" ]; [ "$(wc -l <"$scratch/dns-calls")" = 5 ]
    rsh_wait() { return 7; }
    if (. "$scratch/dns-mutators") >/dev/null 2>"$scratch/error"; then exit 1; fi
    grep -qx 'dns-push: candidate check failed on fw1 (status 7)' "$scratch/error"
)
# Browser launch failures: the guest's log tails, sys browser's reason and incus-ui's int commands reach
# the owner's terminal bounded and filtered.
sed -n '/^        for log in "\$run"\/\*\.log; do /p' "$repo/tools/browser" >"$scratch/tails"
[ "$(wc -l <"$scratch/tails")" = 1 ]; sh -n "$scratch/tails"
(
    run=$scratch/browser-run
    mkdir "$run"
    printf 'browser: \033]52;c;eA==\007 spoofed\n' >"$run/browser.log"
    head -c 131072 /dev/zero | tr '\000' x >"$run/wayland.log"
    . "$scratch/tails" 2>"$scratch/error"
    grep -qx 'browser: ]52;c;eA== spoofed' "$scratch/error"; shown "$scratch/error" 'browser log tails'
    [ "$(wc -c <"$scratch/error")" -le 65600 ]
)
sed "s|/usr/lib/convergent/guest-reply.sh|$repo/rootfs/usr/lib/convergent/guest-reply.sh|" \
    "$repo/rootfs/usr/lib/convergent/sys/70-browser" >"$scratch/browser-module"
sh -n "$scratch/browser-module"
(
    . "$scratch/browser-module"
    die() { echo "$*" >&2; exit 1; }
    trace() { :; }
    setsid() { printf 'browser: \033]52;c;eA==\007 spoofed\n' >&2; return 1; }
    XDG_RUNTIME_DIR=$scratch/xdg
    mkdir "$XDG_RUNTIME_DIR"
    if browser_start def 2>"$scratch/error"; then exit 1; fi
    grep -qx 'browser: ]52;c;eA== spoofed' "$scratch/error"; shown "$scratch/error" 'sys browser'
)
{
    sed -n '/^int_exec() {/p; /^int_exec_raw() {/p' "$repo/tools/incus-ui"
    sed -n '/^    --import)$/,/unlocked full-administration session in int/p' "$repo/tools/incus-ui" | sed '1d; s/ ;;$//'
} >"$scratch/import"
[ "$(grep -c '^int_exec' "$scratch/import")" = 2 ] || exit 1
grep -q '^ *int_exec ' "$scratch/import"
if grep 'ic exec int' "$scratch/import" | grep -qv '^int_exec_raw() {'; then exit 1; fi
sh -n "$scratch/import"
cat >"$scratch/import-driver" <<'DRIVER'
set -eu
. "$repo/rootfs/usr/lib/convergent/guest-reply.sh"
run=$scratch/ui-run
logger() { :; }
die() { echo "$*" >&2; exit 1; }
ic() {
    case $1 in
    exec) printf 'out\033[2J\n'; printf 'err\033]52;c;eA==\007\n' >&2; return "$exec_rc" ;;
    config) : >"$scratch/ui-trusted" ;;
    *) exit 97 ;;
    esac
}
. "$scratch/import"
DRIVER
for exec_rc in 0 7; do
    rm -rf "$scratch/ui-run" "$scratch/ui-trusted"
    mkdir "$scratch/ui-run"
    for file in import.p12 ca.crt client.crt; do echo fixture >"$scratch/ui-run/$file"; done
    code=0
    (export repo scratch exec_rc; sh "$scratch/import-driver") </dev/null >"$scratch/output" 2>"$scratch/error" || code=$?
    [ ! -s "$scratch/output" ]; shown "$scratch/error" 'incus-ui import'
    case $exec_rc in
    0) [ "$code" = 0 ] && [ -f "$scratch/ui-trusted" ] && [ -f "$scratch/ui-run/trusted" ] || exit 1
        [ "$(grep -cx 'out\[2J' "$scratch/error")" = 4 ] && [ "$(grep -cx 'err]52;c;eA==' "$scratch/error")" = 4 ] || exit 1 ;;
    7) [ "$code" = 7 ] && [ ! -e "$scratch/ui-trusted" ] && [ ! -e "$scratch/ui-run/trusted" ] || exit 1 ;;
    esac
done
# Browser readiness and session probes: guest stdout dropped, stderr bounded and filtered.
sed -n '/^attempts=0$/,/^done$/p; /^# Refuse argv-only guests /,/^if \[ -n "\$portal_mode" \]; then$/p' "$repo/tools/browser" |
    sed '$d' >"$scratch/probes"
[ "$(grep -c 'incus --force-local --project default exec "\$name" --' "$scratch/probes")" = 4 ]; sh -n "$scratch/probes"
(
    role=int incus_ui=1 name=int ready=/run/browser-ready launcher=/usr/local/bin/browser-launch
    die() { echo "$*" >&2; exit 1; }
    sleep() { :; }
    timeout() { shift 3; "$@"; }
    incus() { echo call >>"$scratch/probe-calls"; hostile || :; }
    . "$scratch/probes"
) >"$scratch/output" 2>"$scratch/error"
[ "$(wc -l <"$scratch/probe-calls")" = 4 ] && [ ! -s "$scratch/output" ] || exit 1
[ "$(grep -cx 'err]52;c;eA==' "$scratch/error")" = 4 ] || exit 1; shown "$scratch/error" 'browser probes'
# A wan replacement carries only short iwd profiles with what iwd writes; the rest stays behind.
sed -n '/^wan_debugfs() (/,/^)/p; /^wan_listing() {/,/^}/p; /^wan_extract() {/,/^}/p' "$repo/tools/guests" >"$scratch/wan"
[ "$(grep -c '^wan_[a-z]*() [{(]$' "$scratch/wan")" = 3 ]; sh -n "$scratch/wan"
(
    LC_ALL=C; export LC_ALL
    . "$scratch/wan"
    work=$scratch/wan-work profiles=$scratch/wan-profiles
    mkdir -p "$work/wan-read/out" "$work/iwd" "$profiles"
    die() { echo "die $*" >&2; exit 1; }
    logger() { echo "logger $*" >>"$scratch/wan-log"; }
    setpriv() { shift 4; "$@"; }
    ulimit() { :; }
    pt=$(head -c 128 /dev/zero | tr '\000' a)
    printf '[Security]\nPassphrase=convergent-test-only\nSAE-PT-Group19=%s\n\n[Settings]\nAutoConnect=false\nHidden=true\n' "$pt" >"$profiles/good.psk"
    printf '[Settings]\nAutoConnect=false\nTransitionDisable=true\nDisabledTransitionModes=personal,open\n' >"$profiles/=43562074657374.open"
    : >"$profiles/empty.open"
    printf '[Security]\nPassphrase=convergent-test-only\n[IPv4]\nSendHostname=true\n' >"$profiles/foreign.psk"
    { printf '[Security]\nPassphrase='; head -c 61440 /dev/zero | tr '\000' x; printf '\n'; } >"$profiles/long.psk"
    printf '[Security]\nEAP-Method=TLS\n' >"$profiles/eap.8021x"
    printf '[Security]\nPassphrase=abc\033]52;c;eA==\007defgh\n' >"$profiles/control.psk"
    printf '[Security]\nPassphrase=convergent-test-only\nPassphrase=convergent-test-two\n' >"$profiles/twice.psk"
    printf '[Security]\nPreSharedKey=xyz\n' >"$profiles/key.psk"
    printf '[Security]\nPassphrase=convergent-test-only\n' >"$profiles/secret.open"
    printf 'Passphrase=convergent-test-only\n' >"$profiles/bare.psk"
    n=10
    for p in "$profiles"/*; do
        printf '/%s/100600/0/0/%s/%s/\n' "$n" "${p##*/}" "$(stat -c %s "$p")" >>"$scratch/wan-list"
        printf '%s %s\n' "$n" "${p##*/}" >>"$scratch/wan-map"
        n=$((n + 1))
    done
    debugfs() {
        case $2 in
        'ls -p /var/lib') printf '/5/040700/0/0/.//\n/4/040755/0/0/..//\n/6/040700/0/0/iwd//\n' ;;
        'ls -p <6>') printf '/6/040700/0/0/.//\n/5/040755/0/0/..//\n'; cat "$scratch/wan-list" ;;
        'dump <'*'> out/profile')
            inode=${2#dump <}; inode=${inode%%>*}
            cp "$profiles/$(awk -v n="$inode" '$1 == n {print $2}' "$scratch/wan-map")" out/profile ;;
        *) return 1 ;;
        esac
    }
    wan_extract 2>"$scratch/error"
    for name in good.psk =43562074657374.open empty.open; do cmp "$profiles/$name" "$work/iwd/$name"; done
    [ "$(ls -A "$work/iwd" | wc -l)" = 3 ]
    [ "$(grep -c 'not carried over: unexpected content$' "$scratch/error")" = 8 ]
    [ "$(grep -c 'not carried over' "$scratch/wan-log")" = 8 ]
    shown "$scratch/error" wan_extract
)
echo 'test-guest-reply: byte limits, transfer failures, cleanup and production readbacks passed'
echo 'test-guest-reply: browser tails and probes, sys browser reasons, incus-ui imports and wan profiles are bounded and filtered'
