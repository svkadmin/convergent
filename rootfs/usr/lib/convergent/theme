theme_bg='#0b0b0b'
theme_surface='#202020'
theme_dim='#999999'
theme_text='#dddddd'
theme_accent='#78a9ff'
# Existing bar status colours; critical text uses theme_bg, not theme_surface.
theme_ok='#00cc00'
theme_warn='#ff8c00'
theme_crit='#ff0000'
theme_master='#00ff00'
theme_backup='#5f8f5f'
theme_alert_warn='#ffd700'
# Terminal colours; even ANSI black remains readable on theme_bg.
theme_ansi_black='#888888'
theme_ansi_magenta='#c49acb'
theme_ansi_cyan='#82b8ad'
theme_ansi_white='#ffffff'
