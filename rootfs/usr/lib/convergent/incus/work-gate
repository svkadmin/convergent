#!/bin/sh
# A previously validated topology survives loss of its standby while a healthy MASTER serves.
set -eu
. /usr/lib/convergent/guest-reply.sh
lib=/usr/lib/convergent/incus
state=/var/lib/convergent/guests
valid=/run/convergent/work-gate.valid
# The drop rule first; a stalled syslog must not delay it. keep: a transient verdict leaves validation in place.
close_gate() {
	nft -f - <<'NFT'
flush chain bridge host-l2 work_gate
add rule bridge host-l2 work_gate drop
NFT
	[ ! -f "$valid" ] || timeout -k 1 5 logger -t work-gate "work access closed: $1" 5>&- 2>/dev/null || :
	[ "${2:-}" = keep ] || rm -f "$valid"
}
# A node that cannot answer is no evidence of a mismatch: a validated gate keeps its state.
undecided() {
	[ -f "$valid" ] && [ "$(cat "$valid")" = "$expected" ] || close_gate "$1"
	exit 1
}
exec 5>/run/convergent/work-gate.lock
flock -w 60 5 || exit 1
[ "${1:-}" != close ] || { close_gate requested; exit; }
[ ! -e "$state/fw.topology" ] || { close_gate 'topology change in progress'; exit 1; }
expected=$(cat /etc/convergent/topology.sha256)
remote() { timeout -k 1 10 ssh -F /etc/convergent/ssh_config -o ControlMaster=no -o ControlPath=none "$@" </dev/null 9>&- 8>&- 7>&- 6>&- 5>&-; }
# Sets reply. A reply our own timeout cut off (124, 137 after -k) is unanswered, as no reply is: a loaded
# firewall must not invalidate the gate. Any other failure that sent data, or an oversized reply, is 125.
node_reply() {
	reply=$(guest_reply --display "$@") && return 0
	rc=$?
	case $rc in 124|137) return 1 ;; 125) return 125 ;; esac
	[ -z "$reply" ] || return 125
	return 1
}
if node_reply 128 remote wan topology; then actual=$reply; else
	[ "$?" != 125 ] || { close_gate 'wan reply rejected'; exit 1; }
	undecided 'wan unreachable'
fi
[ "$actual" = "$expected" ] || { close_gate 'wan topology differs'; exit 1; }
missing=0 masters=0
for node in fw1 fw2; do
	if node_reply 128 remote "$node" 'cat /etc/convergent/topology.sha256'; then actual=$reply; else
		[ "$?" != 125 ] || { close_gate "$node reply rejected"; exit 1; }
		missing=$((missing + 1))
		continue
	fi
	[ "$actual" = "$expected" ] || { close_gate "$node topology differs"; exit 1; }
	# Every answer carries PF's own verdict: a node forwarding without PF closes the gate at once.
	answered=1
	if node_reply 65536 remote "$node" 'ifconfig; pfctl -si; timeout -k 1 5 sh -c "rcctl check unbound >/dev/null && unbound-control status >/dev/null" && echo CV-UNBOUND-OK; :'; then live=$reply; else
		[ "$?" != 125 ] || { close_gate "$node reply rejected"; exit 1; }
		live=$reply answered=0
	fi
	if printf '%s\n' "$live" | awk '/^Status:/ && $2 != "Enabled" {bad=1} END {exit !bad}'; then
		close_gate "$node PF not enabled"; exit 1
	fi
	[ "$answered" = 1 ] || { missing=$((missing + 1)); continue; }
	printf '%s\n' "$live" | grep -q '^Status: Enabled' || { close_gate "$node PF not enabled"; exit 1; }
	# A booting or failing-over node has CARP states in flux: count it as missing, not as a mismatch.
	if printf '%s\n' "$live" | grep -qx CV-UNBOUND-OK &&
		role=$(printf '%s\n' "$live" | awk -v health=1 -f "$lib/carp.awk" /etc/convergent/segments -); then
		[ "$role" != master ] || masters=$((masters + 1))
	else
		missing=$((missing + 1))
	fi
done
# Two answers seconds apart can both say MASTER across a failover: closed now, reopened once one remains.
[ "$masters" -le 1 ] || { close_gate 'two masters' keep; exit 1; }
[ "$masters" = 1 ] || [ "$missing" = 0 ] || undecided 'no firewall answered as master'
[ "$masters" = 1 ] || { close_gate 'no master'; exit 1; }
if [ "$missing" != 0 ]; then
	[ -f "$valid" ] && [ "$(cat "$valid")" = "$expected" ] || { close_gate 'standby missing before validation'; exit 1; }
else
	printf '%s\n' "$expected" >"$valid"
fi
nft flush chain bridge host-l2 work_gate
