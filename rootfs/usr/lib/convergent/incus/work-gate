#!/bin/sh
# A previously validated topology survives loss of its standby while a healthy MASTER serves.
set -eu
lib=/usr/lib/convergent/incus
state=/var/lib/convergent/guests
valid=/run/convergent/work-gate.valid
close_gate() {
	rm -f "$valid"
	nft -f - <<'NFT'
flush chain bridge host-l2 work_gate
add rule bridge host-l2 work_gate drop
NFT
}
exec 5>/run/convergent/work-gate.lock
flock -w 60 5 || exit 1
[ "${1:-}" != close ] || { close_gate; exit; }
[ ! -e "$state/fw.topology" ] || { close_gate; exit 1; }
expected=$(cat /etc/convergent/topology.sha256)
remote() { timeout -k 1 10 ssh -F /etc/convergent/ssh_config -o ControlMaster=no -o ControlPath=none "$@" </dev/null 9>&- 8>&- 7>&- 6>&- 5>&-; }
actual=$(remote wan topology) || { close_gate; exit 1; }
[ "$actual" = "$expected" ] || { close_gate; exit 1; }
missing=0 masters=0
for node in fw1 fw2; do
	if ! actual=$(remote "$node" 'cat /etc/convergent/topology.sha256'); then
		missing=$((missing + 1))
		continue
	fi
	[ "$actual" = "$expected" ] || { close_gate; exit 1; }
	if live=$(remote "$node" 'set -e; rcctl check unbound >/dev/null; unbound-control status >/dev/null; ifconfig; pfctl -si'); then
		role=$(printf '%s\n' "$live" | awk -v health=1 -f "$lib/carp.awk" /etc/convergent/segments -) || { close_gate; exit 1; }
		[ "$role" != master ] || masters=$((masters + 1))
	else
		missing=$((missing + 1))
	fi
done
[ "$masters" = 1 ] || { close_gate; exit 1; }
if [ "$missing" != 0 ]; then
	[ -f "$valid" ] && [ "$(cat "$valid")" = "$expected" ] || { close_gate; exit 1; }
else
	printf '%s\n' "$expected" >"$valid"
fi
nft flush chain bridge host-l2 work_gate
