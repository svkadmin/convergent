#!/bin/sh
# Wait for Incus without delaying the net provider it needs.
set -eu

die() { logger -p user.err -t host-net "$*"; echo "host-net: $*" >&2; exit 1; }
vfio_bind() {
	for address do
		device=/sys/bus/pci/devices/$address
		[ -d "$device/iommu_group" ] || die "$address has no IOMMU group"
		for peer in "$device"/iommu_group/devices/*; do
			case " $* " in *" ${peer##*/} "*) continue ;; esac
			# The kernel's own rule: root ports (pcieport) and pci-stub may share the group.
			[ ! -L "$peer/driver" ] && continue
			case $(basename "$(readlink "$peer/driver")") in vfio-pci | pcieport | pci-stub) continue ;; esac
			die "$address shares its IOMMU group with host device ${peer##*/}; no ACS override"
		done
	done
	# Reserve all selected functions before releasing any current driver.
	for address do printf '%s\n' vfio-pci >"/sys/bus/pci/devices/$address/driver_override"; done
	for address do
		device=/sys/bus/pci/devices/$address
		if [ -L "$device/driver" ] && [ "$(basename "$(readlink "$device/driver")")" != vfio-pci ]; then
			printf '%s\n' "$address" >"$device/driver/unbind"
		fi
	done
	for address do
		printf '%s\n' "$address" >/sys/bus/pci/drivers_probe
		[ "$(basename "$(readlink "/sys/bus/pci/devices/$address/driver")")" = vfio-pci ] ||
			die "$address did not bind to vfio-pci"
	done
}

case ${1:-} in
repair) ip -4 address show dev host 2>/dev/null | grep -q 'inet 100.80.1.10/28 ' || exit 0 ;;
vfio) shift; vfio_bind "$@"; exit ;;
nvidia)
	set --
	for device in /sys/bus/pci/devices/*; do
		[ "$(cat "$device/vendor")" = 0x10de ] || continue
		case $(cat "$device/class") in 0x03*|0x040300) set -- "$@" "${device##*/}" ;; esac
	done
	vfio_bind "$@"
	# The kernel default "on" keeps the idle card powered (about 20 W).
	for address do
		printf auto >"/sys/bus/pci/devices/$address/power/control" || die "$address: runtime PM"
	done
	exit
	;;
esac

if [ "${1:-}" != repair ]; then
	until ip -4 address show dev host 2>/dev/null | grep -q 'inet 100.80.1.10/28 '; do sleep 1; done
fi
for key in net.ipv4.conf.host.arp_ignore net.ipv4.ip_forward; do
	[ "$(sysctl -n "$key")" = 0 ] || sysctl -qw "$key=0"
done
ip -4 route show default dev host | grep -Eq '^default via 100\.80\.1\.1 dev host( |$)' ||
	ip route replace default via 100.80.1.1 dev host
