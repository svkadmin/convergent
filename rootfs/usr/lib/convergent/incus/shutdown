#!/bin/sh
# ARCHITECTURE 5.2; drain guests before OpenRC sends SIGPWR to incusd.
set -eu
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 077
ic() { timeout -k 1 10 incus --force-local --project "$project" "$@" 9>&-; }
note() { logger -t guests "shutdown: $*" 2>/dev/null || :; }
stop_one() (
    project=$1 node=$2 old_auto=$3 old_hold=$4 ephemeral=$5 group=$6 remember=$7
    if [ "$group" = 0 ] && [ "$ephemeral" = true ]; then
        ic config set "$node" ephemeral=false --property || exit 1
        trap 'ic config set "$node" ephemeral=true --property || exit 1' 0
        ephemeral=false
    fi
    ic config set "$node" boot.autorestart=false user.convergent.autorestart=true || exit 1
    note "stopping $project/$node"
    if ! timeout -k 5 25 incus --force-local --project "$project" stop "$node" --timeout 20 9>&-; then
        note "forcing $project/$node off after graceful stop failed"
        timeout -k 5 40 incus --force-local --project "$project" stop "$node" --force 9>&- || :
    fi
    instances=$(timeout -k 1 10 incus --force-local query "/1.0/instances?recursion=1&project=$project" 9>&-) || exit 1
    printf '%s\n' "$instances" | jq -e --arg n "$node" --arg e "$ephemeral" '
        [.[] | select(.name == $n)] |
        if length == 0 then $e == "true" else length == 1 and .[0].status == "Stopped" end' >/dev/null ||
        { note "$project/$node did not stop; autorestart hold retained"; exit 1; }
    [ "$ephemeral" != true ] || exit 0
    if [ "$remember" = true ]; then
        ic config set "$node" volatile.last_state.power=RUNNING || exit 1
    fi
    # Restore only our override; an interrupted update may already own a hold.
    if [ "$old_auto" = - ]; then ic config unset "$node" boot.autorestart
    else ic config set "$node" boot.autorestart="$old_auto"; fi
    if [ "$old_hold" = - ]; then ic config unset "$node" user.convergent.autorestart
    else ic config set "$node" user.convergent.autorestart="$old_hold"; fi
)
mkdir -p /run/convergent
touch /run/convergent/guests-stopping
exec 9>/run/convergent/guests.lock
flock -w 30 9 || { note 'guest operation still running; leaving final shutdown to Incus'; exit 1; }
trap '' HUP INT TERM
work=$(mktemp -d /run/convergent/shutdown.XXXXXX)
trap 'rm -rf "$work"' 0
timeout -k 1 10 incus --force-local query '/1.0/instances?recursion=1&all-projects=true' 9>&- >"$work/instances"
jq -r '.[] | select(.status != "Stopped") | (.project // "default") as $project |
    (if $project == "default" and (.name | test("^(def|int|remmina|web|admin|tmp-(portal|[0-9]+))$")) then 1
     elif $project == "default" and .name == "svc" then 2
     elif $project == "default" and .name == "wan" then 3
     elif $project == "default" and (.name == "fw1" or .name == "fw2") then 4
     elif any(.expanded_devices[]?; .type == "nic" and (.network == "work" or .parent == "work")) then 0
     else empty end) as $stage |
    [$stage, $project, .name, (.config["boot.autorestart"] // "-"),
     (.config["user.convergent.autorestart"] // "-"), .ephemeral,
     ($stage == 0 and .status == "Running" and
      ((.expanded_config["boot.autostart"] // "") | . == "" or . == "last-state"))] | @tsv' "$work/instances" >"$work/order"
result=0
for stage in 0 1 2 3 4; do
    pids=
    while read -r group project node old_auto old_hold ephemeral remember; do
        [ "$group" = "$stage" ] || continue
        stop_one "$project" "$node" "$old_auto" "$old_hold" "$ephemeral" "$group" "$remember" &
        pids="$pids $!"
    done <"$work/order"
    for pid in $pids; do wait "$pid" || result=1; done
done
note "guest drain completed (status $result)"
exit "$result"
