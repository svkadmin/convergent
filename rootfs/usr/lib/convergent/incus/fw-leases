#!/bin/sh
# Quiesce both allocators while checkpointing and seeding a replacement. A replacement still booting and
# relinking took over 30 s for the rcctl calls below. A node being replaced (listed in rebuilding; an
# uncommitted pair migration replaces both) may stay silent: its root and leases come from the saved copy.
lease_replaced() {
    case " ${rebuilding:-} " in *" $1 "*) return 0 ;; esac
    [ -d "$state/fw.topology" ] && [ ! -e "$state/fw.topology/committed" ]
}
# Each mutation runs on the firewall under one lock and its own bound, shorter than the host's 120 s: a hold
# or seed the host gave up on (ssh killed; the remote script runs on) ends there before a later resume, never
# after it. The lock stays in perl, so a daemon started under it does not inherit it. The body is a ksh
# double-quoted string: no quote, and \$ for what the locked sh must expand.
lease_guard='exec timeout -k 5 100 perl -MFcntl=:flock -e "open(L, q{>>}, q{/var/run/convergent-leases.lock}) or exit 1; flock(L, LOCK_EX) or exit 1; exit(system(q{/bin/sh}, q{-ec}, shift @ARGV) ? 1 : 0)"'
# A leases file's abandoned declarations, one line each (address and start): the heal's probe runs it on the
# firewall (no quote in it: the remote ksh gets it single-quoted) and the seed runs it over what it wrote.
lease_abandoned='/^lease /{a=$2; s=""} /^[ \t]*starts /{sub(/;$/, "", $4); s=$3 "/" $4} /^[ \t]*abandoned;/{print "abandoned", a, s}'
leases_hold() {
    [ ! -f "$state/leases/quiesced" ] || return 0
    mkdir -p "$state/leases" || return
    touch "$state/leases/held" && sync || return
    lease_sources=0 lease_held=
    for lease_node in fw1 fw2; do
        running "$lease_node" || continue
        # A few KB per pair: an oversized reply is a failed checkpoint and never replaces the saved copy.
        if probe_limit=120 guest_reply 1048576 rsh "$lease_node" 'set -e
if test -f /etc/convergent/dhcpd.flags && test -f /var/db/convergent-seeded; then
    '"$lease_guard"' "rcctl disable dhcpd
if rcctl check dhcpd >/dev/null 2>&1; then rcctl stop dhcpd; fi
sync
cat /var/db/dhcpd.leases"
fi' >"$work/leases.$lease_node"; then
            mv "$work/leases.$lease_node" "$state/leases/$lease_node" && sync || return
            lease_sources=$((lease_sources + 1)) lease_held="$lease_held $lease_node"
        else
            lease_replaced "$lease_node" || return 1
        fi
    done
    # Nothing read and nothing saved (a migration cut after its holds, both committed nodes silent): only
    # when both roots are replaced, so no peer keeps leases the replacement would not know.
    [ "$lease_sources" != 0 ] || [ -f "$state/leases/saved" ] || { lease_replaced fw1 && lease_replaced fw2; } || return 1
    # The heal's reconcile needs both: a node Incus could not read is held by no one and merged into nothing.
    for lease_node in ${lease_required:-}; do
        case " $lease_held " in *" $lease_node "*) ;; *) return 1 ;; esac
    done
    for lease_node in fw1 fw2 saved; do
        [ -f "$state/leases/$lease_node" ] || : >"$state/leases/$lease_node" || return
    done
    lease_now=$(date -u '+%Y/%m/%d %H:%M:%S') || return
    awk -v now="$lease_now" -f "$lib/leases.awk" "$state/leases/fw1" "$state/leases/fw2" "$state/leases/saved" >"$work/leases.saved" || return
    mv "$work/leases.saved" "$state/leases/saved" && sync || return
    # The byte count travels with the merge: a transfer the host's bound cut (the remote cat reads EOF and
    # exits 0) installs nothing.
    lease_bytes=$(wc -c <"$state/leases/saved" | tr -d ' ') || return
    case $lease_bytes in '' | *[!0-9]*) return 1 ;; esac
    for lease_node in fw1 fw2; do
        # Only a node held above: one Incus read late gets no merge that lacks its own leases while it allocates.
        case " $lease_held " in *" $lease_node "*) ;; *) continue ;; esac
        # A held node Incus cannot read now keeps its own leases: no reconcile is done with half its write-back.
        running "$lease_node" || { case " ${lease_required:-} " in *" $lease_node "*) return 1 ;; esac; continue; }
        if ! probe_limit=120 rsh "$lease_node" 'set -e
if test -f /etc/convergent/dhcpd.flags && test -f /var/db/convergent-seeded; then
    '"$lease_guard"' "umask 077
cat >/var/db/dhcpd.leases.new
test \$(wc -c </var/db/dhcpd.leases.new) -eq '"$lease_bytes"'
mv /var/db/dhcpd.leases.new /var/db/dhcpd.leases
sync"
fi' <"$state/leases/saved"; then
            lease_replaced "$lease_node" || return 1
        fi
    done
    # What the seed wrote, as the probe lists it, stored as each node's last seen set (heal_abandoned): a
    # record the merge carried over from the peer is no rise there.
    awk "$lease_abandoned" "$state/leases/saved" | sort -u | head -n 1000 >"$work/leases.abandoned" || return
    for lease_node in fw1 fw2; do
        cp "$work/leases.abandoned" "$state/leases/abandoned.$lease_node" || return
    done
    touch "$state/leases/quiesced" && sync
}
leases_resume() {
    [ -f "$state/leases/held" ] || return 0
    rm -f "$state/leases/quiesced" && sync || return
    lease_waiting= lease_failed=
    for lease_node in ${1:-fw1 fw2}; do
        running "$lease_node" || { lease_waiting=1; continue; }
        # Every node is tried: one that fails must not leave its healthy peer's allocator off until it recovers.
        probe_limit=120 rsh "$lease_node" 'set -e
if test -f /etc/convergent/dhcpd.flags && test -f /var/db/convergent-seeded; then
    '"$lease_guard"' "rcctl enable dhcpd
rcctl set dhcpd flags \$(cat /etc/convergent/dhcpd.flags)
rcctl check dhcpd >/dev/null 2>&1 || rcctl start dhcpd"
fi' >/dev/null || lease_failed="$lease_failed $lease_node"
    done
    [ -z "$lease_failed" ] || return 1
    # A peer-only recovery keeps the hold until both allocators have resumed.
    [ -z "$lease_waiting" ] && [ "$#" = 0 ] || return 0
    rm -f "$state/leases/held" && sync
}
