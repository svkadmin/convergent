#!/bin/sh
# install-stub: the install image's placeholder until the installer's questions land. Shows the
# hardware and what the image mounted, writes nothing, then waits.
export LC_ALL=C
release=$(cat /usr/lib/convergent/release 2>/dev/null) || release=unknown
version=$(cat /usr/lib/convergent/version 2>/dev/null) || version=unknown
printf 'Convergent installer: release %s (%s)\n' "$release" "$version"
vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) || vendor=unknown
product=$(cat /sys/class/dmi/id/product_name 2>/dev/null) || product=unknown
printf 'Hardware: %s %s\n' "$vendor" "$product"
gpu=$(cat /sys/class/drm/renderD128/device/vendor 2>/dev/null) || gpu=none
printf 'Render node vendor: %s\n' "$gpu"
printf 'Disks:\n'
lsblk -dpno NAME,SIZE,TRAN,MODEL,SERIAL 2>/dev/null | sed 's/^/  /' || :
for path in /run/convergent-install /var /home /tmp; do
	printf 'Mounted: %s %s\n' "$path" "$(findmnt -no FSTYPE,OPTIONS "$path" 2>/dev/null || echo none)"
done
# The install runlevel's sysctl service: the kernel defaults sysrq to 0 already, kptr_restrict to 0.
printf 'Hardening: sysrq %s kptr_restrict %s\n' "$(cat /proc/sys/kernel/sysrq 2>/dev/null || echo unknown)" \
	"$(cat /proc/sys/kernel/kptr_restrict 2>/dev/null || echo unknown)"
printf 'Manifests:%s\n' "$(ls /run/convergent-install-manifests 2>/dev/null | tr '\n' ' ')"
printf 'Install data: %s\n' "$(ls /run/convergent-install 2>/dev/null | tr '\n' ' ')"
printf 'This test build installs nothing. Press Ctrl-Alt-Del to restart.\n'
while :; do sleep 3600; done
