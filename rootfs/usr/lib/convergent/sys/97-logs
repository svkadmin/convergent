title=Logs
actions='host	Read host logs	root
debug	Run a signed diagnostic and send encrypted output	root
services	Show OpenRC services	'

logs_state() { echo 'Host logs / OpenRC services'; }
logs_host() { noargs "$@"; root_page /var/log/messages; }
logs_debug() { noargs "$@"; [ -x /usr/local/sbin/debug ] || die 'sys debug is only in beta builds'; run sudo /usr/local/sbin/debug; }
logs_services() { noargs "$@"; page run rc-status -a; }
