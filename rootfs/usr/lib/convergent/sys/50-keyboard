title=Keyboard
actions='layouts	Show active and configured layouts	
set	Apply and save comma-separated LAYOUTS	
next	Switch to the next keyboard layout	'

keyboard_state() {
	[ -n "${SWAYSOCK:-}" ] || { echo 'needs the sway session'; return; }
	value=$(timeout -k 0.2 1 swaymsg -r -t get_inputs 2>/dev/null) || { echo unknown; return; }
	printf '%s\n' "$value" | jq -er '[.[] | select(.type == "keyboard") | .xkb_active_layout_name] | unique | if length > 0 then join(", ") else "unknown" end' || echo unknown
}
keyboard_layouts() {
	noargs "$@"; sway
	json=$(run swaymsg -r -t get_inputs) || return
	printf '%s\n' "$json" | page jq -r '.[] | select(.type == "keyboard") | "\(.identifier): active=\(.xkb_active_layout_name); configured=\(.xkb_layout_names | join(", "))"'
}
keyboard_set() {
	sway; onearg 'Layouts (for example us,hu)' "$@"; layouts=$answer
	printf '%s\n' "$layouts" | LC_ALL=C awk -F, 'NR != 1 {exit 1} {
		for (i=1;i<=NF;i++) if ($i !~ /^[a-z]{2,3}(\([a-z0-9_-]+\))?$/) exit 1
		if (!NF) exit 1
	}' || die 'invalid layout list'
	variants=$(printf '%s\n' "$layouts" | sed 's/[a-z][a-z]*\((\([^)]*\))\)\{0,1\}/\2/g')
	layouts=$(printf '%s\n' "$layouts" | sed 's/([^)]*)//g')
	if [ -r /usr/share/X11/xkb/rules/evdev.lst ]; then
		for layout in $(printf '%s' "$layouts" | tr , ' '); do
			awk -v code="$layout" '$1 == "!" {section=$2} section == "layout" && $1 == code {found=1} END {exit !found}' /usr/share/X11/xkb/rules/evdev.lst || die "unknown layout: $layout"
		done
	fi
	swayrun input type:keyboard xkb_layout "\"$layouts\"" || return
	swayrun input type:keyboard xkb_variant "\"$variants\"" || return
	printf 'input type:keyboard xkb_layout "%s"\ninput type:keyboard xkb_variant "%s"\n' "$layouts" "$variants" | save_config input
}
keyboard_next() { noargs "$@"; sway; swayrun input type:keyboard xkb_switch_layout next; }
