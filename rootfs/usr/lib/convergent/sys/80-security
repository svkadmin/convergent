title=Security
alias=sec
actions="status	Show lockdown, boot, verity, USB and alerts	root
alerts	List firing alerts
check	Run the host security check	root
report	Read the last security report	root
password	Change the owner's login password	root"

security_state() { printf 'Lockdown: %s\n' "$(cached /sys/kernel/security/lockdown)"; }
security_status() {
	noargs "$@"
	printf 'Lockdown: %s\n' "$(cached /sys/kernel/security/lockdown)"
	efi=/sys/firmware/efi/efivars
	guid=8be4df61-93ca-11d2-aa0d-00e098032b8c
	sb=$(od -An -tu1 -j4 -N1 "$efi/SecureBoot-$guid" 2>/dev/null | tr -d ' \n')
	setup=$(od -An -tu1 -j4 -N1 "$efi/SetupMode-$guid" 2>/dev/null | tr -d ' \n')
	case $sb:$setup in 1:0) echo 'Secure Boot: enabled' ;; 0:0|0:1|1:1) echo 'Secure Boot: disabled or setup mode' ;; *) echo 'Secure Boot: unknown' ;; esac
	printf 'Verity: '
	sudo dmsetup status vroot || echo unknown
	printf 'Blocked USB: %s\n' "$(usb_count)"
	alerts=$(curl -sf --connect-timeout 2 -m 4 http://100.80.2.10:8880/api/v1/alerts 'http://100.80.2.10:8880/api/v1/rules?type=alert' |
		jq -ser 'select(length == 2 and all(.[]; .status == "success")) |
		select(.[0].data.alerts | type == "array") |
		select(.[1].data.groups | type == "array") |
		select(all(.[1].data.groups[].rules[]; .health == "ok")) |
		[.[0].data.alerts[] | select(.state == "firing")] |
		(map(select(.labels.severity == "critical")) | length) as $c |
		"\($c) critical, \(length - $c) other firing"') || alerts=unknown
	printf 'Alerts: %s\n' "$alerts"
}
security_check() { noargs "$@"; page run sudo /usr/local/sbin/check; }
security_alerts() { noargs "$@"; page security_alert_list; }
security_alert_list() {
	alerts=$(curl -sf --connect-timeout 2 -m 4 http://100.80.2.10:8880/api/v1/alerts) ||
		{ echo 'Alerts unavailable: cannot reach vmalert.' >&2; return 1; }
	printf '%s\n' "$alerts" | jq -er '
		def text: tostring | gsub("[\u0000-\u001f\u007f-\u009f]"; " ");
		select(.status == "success" and (.data.alerts | type == "array")) |
		[.data.alerts[] | select(.state == "firing")] |
		sort_by(if .labels.severity == "critical" then 0 elif .labels.severity == "warning" then 1 else 2 end, .labels.alertname) |
		if length == 0 then "No firing alerts."
		else .[] |
			"\((.labels.severity // "info") | text): \((.labels.alertname // "unnamed") | text)\n  \((.annotations.summary // .annotations.description // "-") | text)\n  Active since: \((.activeAt // "unknown") | text)\n"
		end' || { echo 'Alerts unavailable: invalid vmalert response.' >&2; return 1; }
}
security_report() { noargs "$@"; root_page /var/lib/convergent/check/last; }
security_password() { noargs "$@"; run sudo /usr/local/sbin/account password; }
