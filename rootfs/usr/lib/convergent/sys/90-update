title=Update
alias=up
actions='status	Show release slots	root
check	Check for a newer release online	root
install	Download and write the newest release	root confirm
usb	Write a release from USB [MOUNTPOINT|DEVICE]	root confirm'

update_state() {
	value=$(timeout -k 0.2 1 cat /proc/cmdline 2>/dev/null) || value=
	release=$(printf '%s\n' "$value" | awk '{for (i=1;i<=NF;i++) if ($i ~ /^convergent.release=/) {sub(/^[^=]*=/,"",$i); print $i; exit}}')
	printf 'Release: %s\n' "${release:-unknown}"
}
update_status() { noargs "$@"; page run sudo /usr/local/sbin/slot status; }
# Opens the firewalls' update path while it runs: never part of status.
update_check() { noargs "$@"; run sudo /usr/local/sbin/fetch-release check; }
update_media() (
	onearg 'USB mountpoint or block device' "$@"; path "$answer"
	source=$(realpath -e -- "$answer") || die 'source does not exist'
	path "$source"
	if [ -d "$source" ]; then
		source=$(findmnt -nro SOURCE --mountpoint "$source") || die 'source must be a mountpoint'
	fi
	path "$source"
	[ -b "$source" ] || die 'source must be a block device or its mountpoint'
	lsblk -snro TRAN -- "$source" | grep -qx usb || die 'source must be on USB'
	target=/run/sys-update
	[ ! -L "$target" ] || die 'update mountpoint is a symlink'
	if mountpoint -q "$target"; then
		confirm "Unmount existing $target" || exit 1
		run sudo umount -- "$target" || exit 1
	fi
	mounted=0
	list=$(mktemp) || exit 1
	cleanup() {
		result=$?
		trap - 0
		trap 'exit 1' HUP INT TERM
		if [ "$mounted" = 1 ]; then
			run sudo -v && run sudo umount -- "$target" || result=1
		fi
		rm -f "$list"
		exit "$result"
	}
	trap cleanup 0
	trap 'exit 1' HUP INT TERM
	run sudo mkdir -p "$target" || exit 1
	(umask 022; run sudo mount -o ro,nodev,nosuid,noexec -- "$source" "$target") || exit 1
	mounted=1
	run find "$target" -xdev -type f -name manifest >"$list" || exit 1
	[ -s "$list" ] || die 'no release directories containing manifest'
	# Select by number so a directory name never becomes shell syntax.
	sed 's|/manifest$||' "$list" | awk '{printf "%d  %s\n", NR, $0}' | pager
	ask 'Release number'; number "$answer"
	[ "$answer" -gt 0 ] && [ "$answer" -le "$(wc -l <"$list")" ] || die 'invalid release number'
	release=$(sed -n "${answer}p" "$list"); release=${release%/manifest}
	path "$release"
	release=$(realpath -e -- "$release") || exit 1
	case $release in "$target"|"$target"/*) ;; *) die 'release escapes USB mount' ;; esac
	[ -f "$release/manifest" ] && [ ! -L "$release/manifest" ] || die 'invalid manifest'
	# An image with a release key takes only signed releases from here.
	if [ -f "$release/manifest.sig" ] || [ -f /etc/convergent/release.pub ]; then
		run sudo /usr/local/sbin/slot write "$release"
	else
		confirm "Release $release is not signed. Write it anyway" || exit 1
		run sudo env CONVERGENT_UNSIGNED=1 /usr/local/sbin/slot write "$release"
	fi
)
# Offer the reboot only when a release waits in the other slot.
reboot_new() {
	run sudo /usr/local/sbin/slot status | grep -q ' +[0-9]$' || return 0
	if confirm 'Reboot into the new release'; then run sudo reboot; fi
}
update_install() { noargs "$@"; run sudo /usr/local/sbin/fetch-release && reboot_new; }
update_usb() {
	[ "$#" -le 1 ] || usage
	update_media "$@" && reboot_new
}
