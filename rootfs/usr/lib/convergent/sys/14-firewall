. /usr/lib/convergent/guest-reply.sh
title=Firewalls
alias=fw
actions='status	Show both firewalls and DNS push status	root
capture	Capture MASTER traffic [interface-or-segment seconds]	root
rebuild	Recreate a firewall from the installed release [fw1|fw2]	root confirm
maintenance	Move all segments to the healthy peer	root
undo	End maintenance demotion	root'

firewall_state() { echo 'fw1 / fw2: CARP, PF, DNS'; }
firewall_rsh() {
	host=$1; shift
	run timeout "${FIREWALL_SSH_TIMEOUT:-30}" ssh -F /etc/convergent/ssh_config -o ControlMaster=no -o ControlPath=none -n "$host" "$@" 9>&- 8>&-
}
firewall_mutate() (
	# Keep host locks until SSH/timeout returns, even if sys is killed.
	# The remote lock and journal protect commands that outlive SSH.
	trap '' HUP INT TERM
	set +e
	script=$(printf '%s\n' "$2" | sed "s/'/'\\\\''/g")
	(run timeout -k 5 30 ssh -F /etc/convergent/ssh_config -o ControlMaster=no -o ControlPath=none -n "$1" 'exec /usr/bin/perl -MFcntl=:DEFAULT,:flock -e '\''
sysopen(my $lock, "/var/run/convergent-maintenance.lock", O_WRONLY|O_CREAT|O_NOFOLLOW, 0600) or exit 1;
flock($lock, LOCK_EX|LOCK_NB) or exit 1;
# Keep the lock across exec and in mutation children.
fcntl($lock, F_SETFD, 0) or exit 1;
truncate($lock, 0) or exit 1;
syswrite($lock, "$$\n") == length("$$\n") or exit 1;
exec "/bin/sh", "-ec", $ARGV[0];
exit 1;
'\'' '\''trap "exit 1" HUP INT TERM
'"$script""'" 9>&- 8>&-)
	code=$?
	exit "$code"
)
firewall_role() {
	# The host's own registry: a path from the firewall reached awk's argument list (a reply of
	# "-e..." ran as host root).
	output=$(guest_reply 65536 firewall_rsh "$1" ifconfig) || return
	printf '%s\n' "$output" | awk -v want="$2" -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments - >/dev/null
}
firewall_pair() { firewall_role "$1" MASTER && firewall_role "$2" BACKUP; }
firewall_healthy() {
	output=$(guest_reply 65536 firewall_rsh "$1" 'ifconfig pfsync0') || return
	printf '%s\n' "$output" | grep -q RUNNING && printf '%s\n' "$output" | grep -q 'defer: on' || return 1
	output=$(guest_reply 65536 firewall_rsh "$1" 'pfctl -si') || return
	printf '%s\n' "$output" | grep -q '^Status: Enabled' || return 1
	firewall_rsh "$1" 'pfctl -nf /etc/pf.conf && rcctl check unbound && unbound-control status && { test ! -f /etc/convergent/dhcpd.flags || rcctl check dhcpd; }' >/dev/null || return
	output=$(guest_reply 65536 firewall_rsh "$1" 'host -t A svc.convergent.internal 127.0.0.1') || return
	printf '%s\n' "$output" | grep -q 'has address 100.80.2.10'
}
firewall_status() (
	noargs "$@"
	[ "$(id -u)" = 0 ] || { page run sudo sys firewall status; exit $?; }
	result=0
	for fw in fw1 fw2; do
		echo "$fw:"
		if output=$(guest_reply 65536 firewall_rsh "$fw" ifconfig); then
			printf '%s\n' "$output" | awk -v mode=status -f /usr/lib/convergent/incus/carp.awk /etc/convergent/segments - || result=1
		else echo "$fw unreachable; recovery: sys firewall rebuild $fw"; result=1; fi
		firewall_rsh "$fw" 'set -e; info=$(pfctl -si); printf "%s\n" "$info" | sed -n "/^Status:/p; /current entries/p"; rcctl check unbound; unbound-control status' || result=1
	done
	printf 'Last successful DNS push to both (UTC): '
	cat /var/lib/convergent/dns/last-push 2>/dev/null || echo unknown
	[ ! -e /var/lib/convergent/dns/pending ] || echo 'DNS rollback pending: run sudo dns-push local'
	if [ -e /var/lib/convergent/firewall-maintenance ]; then
		printf 'Maintenance demotion (sys firewall undo): '; cat /var/lib/convergent/firewall-maintenance
	fi
	exit "$result"
)
firewall_release() {
	# Removing our group removes only our demotion, even after an uncertain SSH result.
	firewall_mutate "$master" '
rm -f /etc/convergent/seeded/maintenance
sync
if [ -f /etc/convergent/segments ]; then
    interfaces=$(awk -v mode=interfaces -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments) || exit 1
else
    interfaces="carp0 carp1 carp2 carp3 carp4 carp5"
fi
for i in $interfaces; do
    info=$(ifconfig "$i")
    groups=$(printf "%s\n" "$info" | sed -n "s/^[[:space:]]*groups: //p")
    case " $groups " in *" sysmaint "*) ifconfig "$i" -group sysmaint ;; esac
    info=$(ifconfig "$i")
    groups=$(printf "%s\n" "$info" | sed -n "s/^[[:space:]]*groups: //p")
    case " $groups " in *" sysmaint "*) exit 1 ;; esac
done
test ! -e /etc/convergent/seeded/maintenance' || return
	rm -f "$journal" && sync
}
firewall_wait() {
	for attempt in 1 2 3 4 5 6; do
		firewall_pair "$1" "$2" && return 0
		sleep 2
	done
	return 1
}
firewall_change() (
	op=$1; shift; noargs "$@"
	[ "$(id -u)" = 0 ] || { run sudo sys firewall "$op"; exit $?; }
	mkdir -p /run/convergent /var/lib/convergent || exit 1
	exec 9>/run/convergent/guests.lock
	# The minute check holds this lock briefly.
	flock -w 120 9 || die 'another guest operation is running'
	exec 8>/run/convergent/dns-push.lock
	flock -w 120 8 || die 'DNS push in progress'
	[ ! -e /var/lib/convergent/guests/fw.topology ] || die 'recover the firewall topology transaction first with guests apply'
	journal=/var/lib/convergent/firewall-maintenance
	if [ "$op" = undo ]; then
		[ -f "$journal" ] || die 'no maintenance demotion recorded'
		master=$(cat "$journal")
		case $master in fw1) peer=fw2 ;; fw2) peer=fw1 ;; *) die 'invalid maintenance journal' ;; esac
		firewall_healthy "$master" && firewall_healthy "$peer" || die 'both firewalls must be healthy before undo'
		confirm "Release $master maintenance demotion" || exit 1
		firewall_release || die 'undo failed; journal retained, retry sys firewall undo'
		firewall_wait fw1 fw2 || die 'demotion removed but normal fw1 MASTER / fw2 BACKUP roles not restored; inspect sys fw status'
		echo 'Maintenance ended; fw1 is master on all registered segments.'
		logger -t sys-firewall 'maintenance ended: fw1 took over all registered segments' || :
		exit 0
	fi
	[ ! -e "$journal" ] || die 'maintenance already recorded; use sys firewall undo'
	[ ! -e /var/lib/convergent/dns/pending ] || die 'recover the pending DNS push first'
	# A role change settles within seconds; wait for it before refusing.
	for attempt in 1 2 3 4 5 6; do
		if firewall_pair fw1 fw2; then master=fw1 peer=fw2; break
		elif firewall_pair fw2 fw1; then master=fw2 peer=fw1; break; fi
		[ "$attempt" = 6 ] && die 'need one master and one backup across all registered segments'
		sleep 2
	done
	firewall_healthy "$peer" && firewall_healthy "$master" || die 'peer or master is unhealthy; no failover attempted'
	confirm "Demote $master and move all registered segments to $peer until sys firewall undo" || exit 1
	printf '%s\n' "$master" >"$journal.new" && mv "$journal.new" "$journal" || exit 1
	sync
	settled=
	trap 'rc=$?; trap - 0; trap "" HUP INT TERM; [ -n "$settled" ] && firewall_release || echo "Undo pending: run sys firewall undo" >&2; exit "$rc"' 0
	trap 'exit 1' HUP INT TERM
	firewall_mutate "$master" '
touch /etc/convergent/seeded/maintenance
sync
if [ -f /etc/convergent/segments ]; then
    interfaces=$(awk -v mode=interfaces -f /usr/local/libexec/convergent/carp.awk /etc/convergent/segments) || exit 1
else
    interfaces="carp0 carp1 carp2 carp3 carp4 carp5"
fi
for i in $interfaces; do ifconfig "$i" group sysmaint; done
ifconfig -g sysmaint carpdemote 128' || die 'demotion uncertain; run sys firewall undo'
	settled=1
	firewall_wait "$peer" "$master" && firewall_healthy "$peer" || die 'peer did not take over healthily; undoing'
	trap - 0 HUP INT TERM
	logger -t sys-firewall "$peer took over all registered segments; $master in maintenance" || :
	echo "$peer is master on all registered segments; $master is in maintenance. Run sys firewall undo when finished."
)
firewall_maintenance() { firewall_change maintenance "$@"; }
firewall_undo() { firewall_change undo "$@"; }
firewall_rebuild() {
	onearg 'Firewall to rebuild (fw1/fw2)' "$@"
	case $answer in fw1|fw2) ;; *) die 'rebuild accepts fw1 or fw2' ;; esac
	run sudo /usr/local/sbin/guests rebuild "$answer"
}

# Owner-side output keeps privileged writes out of the owner's directory.
firewall_capture() (
	[ "$#" = 2 ] || die 'usage: sys firewall capture <interface-or-segment> <seconds>'
	if [ "$(id -u)" = 0 ]; then
		[ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] || die 'run sys firewall capture from the owner login'
		exec sudo -u "$SUDO_USER" sys firewall capture "$@"
	fi
	umask 077
	mkdir -p "$HOME/captures" || exit 1
	file=$(mktemp "$HOME/captures/$(date -u +%Y%m%dT%H%M%SZ).XXXXXX.pcap") || exit 1
	trap 'rm -f "$file"' 0
	trap 'exit 1' HUP INT TERM
	run sudo /usr/local/sbin/firewall-capture "$1" "$2" >"$file" || exit 1
	trap - 0
	echo "$file"
)
