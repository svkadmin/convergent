. /usr/lib/convergent/guest-reply.sh
title=Browser
alias=br
actions='status	Show running browsers	root
def	Open the default browser
tmp	Open a temporary browser
int	Open the internal browser
incus	Unlock Incus management
close	Force-close a frozen browser (def, tmp or int)	root'

browser_state() { echo 'def / tmp / int'; }
browser_start() (
	[ -n "${XDG_RUNTIME_DIR:-}" ] || die 'XDG_RUNTIME_DIR is not set'
	# One log per browser or remote: drop its older launches' logs.
	rm -f "$XDG_RUNTIME_DIR/sys-browser-$1".??????
	log=$(mktemp "$XDG_RUNTIME_DIR/sys-browser-$1.XXXXXX") || exit 1
	trace setsid -f -w /usr/local/sbin/browser "$@"
	setsid -f -w /usr/local/sbin/browser "$@" </dev/null >"$log" 2>&1 &
	pid=$!
	for attempt in 1 2 3; do
		sleep 1
		kill -0 "$pid" 2>/dev/null || break
	done
	if ! kill -0 "$pid" 2>/dev/null; then
		wait "$pid"; result=$?
		if [ "$result" != 0 ]; then
			# The log holds guest output too (launcher, cleanup tails): bounded and filtered.
			reason=$(awk '/browser: / {reason=$0} {last=$0} END {print (reason != "" ? reason : last)}' "$log" |
				head -c 65536 | guest_text)
			rm -f "$log"
			die "${reason:-browser exited ($result)}"
		fi
	fi
	# It can still fail later (portal begin, profile lock): the log keeps the reason.
	if [ "$1" = remmina ]; then name=Remote; else name=Browser; fi
	echo "$name is starting; if it does not open, see $log"
)
browser_def() { noargs "$@"; browser_start def; }
browser_tmp() { noargs "$@"; browser_start tmp; }
browser_int() { noargs "$@"; browser_start int; }
# The window stays open on a failure: it holds the reason (incus-ui, the unlock prompt or the browser).
browser_incus() {
	noargs "$@"
	run foot -T 'Incus management' -e sh -c '"$@" || { result=$?; printf "\nFailed (exit %s). Press Enter to close " "$result"; IFS= read -r answer; exit "$result"; }' \
		incus-ui /usr/local/sbin/incus-ui open
}
browser_close() {
	onearg 'Browser to close (def, tmp or int)' "$@"
	case $answer in def|tmp|int) ;; *) die 'expected def, tmp or int' ;; esac
	run sudo /usr/local/sbin/browser --close "$answer"
}

browser_status() {
	noargs "$@"
	instances=$(run sudo /usr/local/sbin/guests status) || return
	printf '%s\n' "$instances" | page awk '$1 ~ /^(def|int|tmp-(portal|[0-9]+))$/ && $2 == "running" {print; n++} END {if (!n) print "No running browsers"}'
}
