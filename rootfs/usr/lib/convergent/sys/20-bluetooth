title=Bluetooth
alias=bt
actions='status	Show Bluetooth power and known devices	
on	Turn Bluetooth on	
off	Turn Bluetooth off	
scan	Scan Bluetooth for 10 seconds	
pair	Scan and pick a device to pair [MAC]	
connect	Pick a device to connect [MAC]	
disconnect	Pick a device to disconnect [MAC]	
forget	Pick a device to forget [MAC]	confirm'

bluetooth_state() {
	value=$(timeout -k 1 10 bluetoothctl show 2>/dev/null) || { result=$?; echo 'Bluetooth: unknown'; return "$result"; }
	value=$(printf '%s\n' "$value" | awk '$1 == "Powered:" {if ($2 == "yes") print "on"; else if ($2 == "no") print "off"; exit}')
	printf 'Bluetooth: %s\n' "${value:-unknown}"
}
bluetooth_status() { noargs "$@"; page bluetooth_show; }
bluetooth_show() { run timeout -k 1 10 bluetoothctl show && run timeout -k 1 10 bluetoothctl devices; }
bluetooth_on() { noargs "$@"; run timeout -k 1 10 bluetoothctl power on; }
bluetooth_off() { noargs "$@"; run timeout -k 1 10 bluetoothctl power off; }
bluetooth_scan() {
	noargs "$@"
	reply=$(run timeout -k 1 15 bluetoothctl --timeout 10 scan on); result=$?
	printf '%s\n' "$reply" | tr -d '\000-\010\013-\037\177'
	return "$result"
}
bluetooth_pick() {
	devices=$(run timeout -k 1 10 bluetoothctl devices) || return
	devices=$(printf '%s\n' "$devices" | tr -d '\000-\010\013-\037\177' | sed -n 's/^Device //p')
	[ -n "$devices" ] || die 'no devices; turn Bluetooth on and scan first'
	if [ -t 0 ]; then
		choice=$(printf '%s\n' "$devices" | FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= fzf --no-multi --prompt 'Bluetooth: ') || return 1
	else
		sway
		choice=$(printf '%s\n' "$devices" | bemenu -i -l 15 -p Bluetooth \
			--tb '#005577' --tf '#eeeeee' --fb '#222222' --ff '#bbbbbb' \
			--nb '#222222' --nf '#bbbbbb' --ab '#222222' --af '#bbbbbb' \
			--hb '#005577' --hf '#eeeeee') || return 1
	fi
	[ -n "$choice" ] || return 1
	text_valid "$choice"
	printf '%s\n' "$devices" | grep -Fx -- "$choice" >/dev/null || die 'pick a listed device'
	answer=${choice%% *}
}
bluetooth_device() {
	operation=$1; shift
	[ "$#" -le 1 ] || usage
	if [ "$#" = 0 ]; then
		[ "$operation" != pair ] || bluetooth_scan >&2 || return
		bluetooth_pick || return
	else
		answer=$1
	fi
	mac "$answer"
	if [ "$operation" = pair ]; then
		# The interactive agent waits forever for an absent daemon.
		run timeout -k 1 10 bluetoothctl show >/dev/null || return
		[ -t 0 ] || die 'Bluetooth pairing needs a terminal; run sys bluetooth pair there'
		printf 'After Agent registered, enter: pair %s\nAnswer the PIN/passkey prompts, then enter quit.\n' "$answer"
		run bluetoothctl --agent KeyboardDisplay || return
		reply=$(run timeout -k 1 10 bluetoothctl info "$answer") || return
		printf '%s\n' "$reply" | grep -Eq '^[[:space:]]*Paired: yes$' || die 'device is not paired'
	else
		run timeout -k 1 10 bluetoothctl "$operation" "$answer"
	fi
}
bluetooth_pair() { bluetooth_device pair "$@" && run timeout -k 1 10 bluetoothctl trust "$answer"; }
bluetooth_connect() { bluetooth_device connect "$@"; }
bluetooth_disconnect() { bluetooth_device disconnect "$@"; }
bluetooth_forget() { bluetooth_device remove "$@"; }
