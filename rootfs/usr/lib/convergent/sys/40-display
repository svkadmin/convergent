title=Display
alias=disp
actions='status	List output modes, scale and position	
bright	Set panel brightness PERCENT, +N or -N	
set	Preview OUTPUT mode|scale|position|enable|disable [VALUE] for 15 seconds
save	Save this connected monitor set
reset	Remove the profile for this connected monitor set	confirm
watch	Apply monitor profiles at login and on hotplug (session hook)	'

# The udev rule gives group video (the owner) write access to the backlight.
display_bright() {
	onearg 'Brightness percent, +N or -N' "$@"
	case $answer in [+-][0-9]|[+-][0-9][0-9]|[0-9]|[0-9][0-9]|100) ;; *) die 'use 0-100, +N or -N' ;; esac
	case $answer in
	[+-]0[0-9]) answer=${answer%??}${answer#??} ;;
	0[0-9]) answer=${answer#0} ;;
	esac
	for d in /sys/class/backlight/*; do
		[ -w "$d/brightness" ] || continue
		max=$(cat "$d/max_brightness") && now=$(cat "$d/brightness") || return
		case $answer in
		[+-]*) value=$(( now + ${answer%%[0-9]*}1 * ((${answer#?} * max + 99) / 100) )) ;;
		*) value=$(( answer * max / 100 )) ;;
		esac
		# Never fully dark: the panel would look dead.
		[ "$value" -ge $(( (max + 19) / 20 )) ] || value=$(( (max + 19) / 20 ))
		[ "$value" -le "$max" ] || value=$max
		echo "$value" >"$d/brightness" && echo "brightness $(( value * 100 / max ))%"
		return
	done
	die 'no writable backlight (group video, udev rule)'
}

display_state() {
	[ -n "${SWAYSOCK:-}" ] || { echo 'needs the sway session'; return; }
	value=$(timeout -k 0.2 1 swaymsg -r -t get_outputs 2>/dev/null) || { echo unknown; return; }
	printf '%s\n' "$value" | jq -er '[.[] | select(.active) | .name] | if length > 0 then join(", ") else "no active outputs" end' || echo unknown
}
display_json() { sway; run timeout -k 1 3 swaymsg -r -t get_outputs; }
display_status() {
	noargs "$@"
	json=$(display_json) || return
	printf '%s\n' "$json" | page jq -r '.[] | "\(.name): enabled=\(.active) mode=\(if .active then "\(.current_mode.width)x\(.current_mode.height)@\((.current_mode.refresh // 0)/1000)Hz" else "-" end) scale=\(if .active then (.scale // 1) else "-" end) position=\(.rect.x),\(.rect.y)\n  modes: \([.modes[] | "\(.width)x\(.height)@\(.refresh/1000)Hz"] | join(" "))"'
}
display_value() {
	text_valid "$2"
	case $1 in
	mode) printf '%s\n' "$2" | grep -Eq '^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}(@[0-9]{1,3}(\.[0-9]{1,3})?(Hz)?)?$' || die 'invalid mode' ;;
	scale) printf '%s\n' "$2" | grep -Eq '^[0-9](\.[0-9]{1,3})?$' && awk -v n="$2" 'BEGIN {exit !(n >= 0.25 && n <= 8)}' || die 'scale must be 0.25-8' ;;
	position) printf '%s\n' "$2" | grep -Eq '^-?[0-9]{1,6},-?[0-9]{1,6}$' || die 'position must be X,Y' ;;
	*) usage ;;
	esac
}
display_set() (
	sway
	if [ "$#" = 0 ]; then
		display_status || return
		# One screen: Enter picks it.
		only=$(display_json | jq -r 'if length == 1 then .[0].name else empty end') || only=
		ask "Output${only:+ [$only]}"; output=${answer:-$only}
		[ -n "$output" ] || die 'name an output from the list'
		ask 'Setting (mode/scale/position/enable/disable)'; setting=$answer
		case $setting in
		enable|disable) set -- "$output" "$setting" ;;
		mode|scale|position) ask Value; set -- "$output" "$setting" "$answer" ;;
		*) usage ;;
		esac
	fi
	[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
	output=$1; setting=$2; token "$output"
	display_lock
	json=$(display_json) || return
	printf '%s\n' "$json" | jq -e --arg name "$output" 'any(.[]; .name == $name)' >/dev/null || die 'unknown output'
	case $setting in
	enable|disable)
		[ "$#" = 2 ] || usage
		if [ "$setting" = disable ]; then
			printf '%s\n' "$json" | jq -e --arg name "$output" 'any(.[]; .name != $name and .active)' >/dev/null || die 'another output must stay active'
		fi
		command="output $output $setting" ;;
	mode|scale|position)
		[ "$#" = 3 ] || usage
		display_value "$setting" "$3"
		if [ "$setting" = mode ]; then
			mode=$(printf '%s\n' "$json" | jq -er --arg name "$output" --arg mode "${3%Hz}" '
				($mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)(@(?<r>[0-9.]+))?$")) as $m |
				[.[] | select(.name == $name) | .modes[] |
					select(.width == ($m.w | tonumber) and .height == ($m.h | tonumber) and
						($m.r == null or .refresh == ($m.r | tonumber * 1000 | round)))] | max_by(.refresh) // empty |
				"\(.width)x\(.height)@\(.refresh/1000)Hz"') || die 'mode not advertised; see sys display status'
			command="output $output mode $mode"
		elif [ "$setting" = position ]; then
			command="output $output position ${3%,*} ${3#*,}"
		else
			command="output $output $setting $3"
		fi ;;
	*) usage ;;
	esac
	work=$(mktemp -d "$XDG_RUNTIME_DIR/display-preview.XXXXXX") || exit 1
	printf '%s\n' "$json" | display_snapshot preview >"$work/before" || exit 1
	printf 'keep\n' >"$work/keep"; printf 'revert\n' >"$work/revert"
	timer=
	display_cleanup() {
		trap - 0
		if ln "$work/revert" "$work/decision" 2>/dev/null; then
			[ -z "$timer" ] || kill "$timer" 2>/dev/null || :
			display_restore "$work/before" preview
		elif [ "$(cat "$work/decision")" = keep ]; then
			[ -z "$timer" ] || kill "$timer" 2>/dev/null || :
		fi
		# If the timer claimed the rollback, wait for it before releasing the lock.
		[ -z "$timer" ] || wait "$timer" 2>/dev/null || :
		rm -rf "$work"
	}
	trap display_cleanup 0
	trap 'exit 1' HUP INT TERM
	# A separate rollback worker survives loss of the terminal or caller.
	(
		trap - 0 INT TERM
		trap '' HUP
		sleep 15 & sleeper=$!
		trap 'kill "$sleeper" 2>/dev/null || :; exit 0' TERM
		wait "$sleeper" || exit 0
		trap - TERM
		if ln "$work/revert" "$work/decision" 2>/dev/null; then display_restore "$work/before" preview; fi
	) </dev/null >"$work/rollback.log" 2>&1 &
	timer=$!
	display_command "$command" || exit 1
	if [ "$setting" = mode ]; then
		actual=$(display_json | jq -er --arg name "$output" '.[] | select(.name == $name and .active) |
			.current_mode | "\(.width)x\(.height)@\(.refresh/1000)Hz"') || exit 1
		[ "$actual" = "$mode" ] || die "requested $mode, compositor selected $actual; reverting"
	fi
	printf 'Preview: %s\nKeep this layout? Type yes within 15 seconds: ' "$command"
	if timeout --foreground -k 1 15 sh -c 'IFS= read -r a && [ "$a" = yes ]' && ln "$work/keep" "$work/decision" 2>/dev/null; then
		echo 'Kept. Use sys display save to remember this monitor set.'
	else
		echo 'Reverting display preview.'
		exit 1
	fi
)

display_lock() {
	path "$HOME"; path "${XDG_RUNTIME_DIR:-}"
	exec 9>"$XDG_RUNTIME_DIR/convergent-display.lock"
	flock -x 9 || die 'cannot lock display settings'
	profiles=$HOME/.config/convergent/displays
}
display_key() {
	identities=$(jq -ce '[.[] | [.make // "", .model // "", .serial // ""]] | sort |
		if length > 0 and length == (unique | length) then . else error("ambiguous monitor identities") end') || return 1
	printf '%s\n' "$identities" | sha256sum | cut -d ' ' -f 1
}
display_snapshot() {
	jq -e --arg kind "${1:-}" '[.[] | {id: ([.make // "", .model // "", .serial // ""] +
		(if $kind == "preview" then [.name] else [] end)), active,
		mode: (if .active then "\(.current_mode.width)x\(.current_mode.height)@\(.current_mode.refresh/1000)Hz" else "" end),
		scale: ((.scale // 1)*1000 | round/1000), position: "\(.rect.x),\(.rect.y)", transform: (.transform // "normal")}]'
}
display_command() {
	reply=$(run timeout -k 1 3 swaymsg -r -- "$1") || return 1
	printf '%s\n' "$reply" | jq -e 'length > 0 and all(.[]; .success == true)' >/dev/null || {
		printf '%s\n' "$reply" >&2; return 1;
	}
}
display_apply() (
	current=$(display_json) || exit 1
	# Only temporary rollbacks qualify identities with connectors.
	rows=$(jq -er --argjson current "$current" --arg kind "${2:-}" '
		if type != "array" or length == 0 or (all(.[]; (.id | type == "array" and length == (if $kind == "preview" then 4 else 3 end)) and (.active | type == "boolean")) | not)
		then error("invalid display profile") else . end |
		[.[] as $s | $current[] | select(([.make // "", .model // "", .serial // ""] +
			(if $kind == "preview" then [.name] else [] end)) == $s.id) |
		[$s.active, .name, $s.mode, $s.scale, $s.position, $s.transform]] |
		sort_by(.[0]) | reverse | .[] | @tsv' "$1") || exit 1
	# Validate the whole profile before changing any output. Enable survivors before disabling others.
	commands=$(printf '%s\n' "$rows" | while IFS="$tab" read -r active name mode scale position transform; do
		token "$name"
		if [ "$active" = false ]; then
			printf 'output %s disable\n' "$name"; continue
		fi
		display_value mode "$mode"; display_value scale "$scale"; display_value position "$position"
		case $transform in normal|90|180|270|flipped|flipped-90|flipped-180|flipped-270) ;; *) die 'invalid transform' ;; esac
		printf 'output %s enable mode %s scale %s position %s %s transform %s\n' "$name" "$mode" "$scale" "${position%,*}" "${position#*,}" "$transform"
	done) || exit 1
	printf '%s\n' "$rows" | grep -q '^true' || exit 1
	printf '%s\n' "$commands" | while IFS= read -r command; do display_command "$command" || exit 1; done
)
display_defaults() {
	json=$(display_json) || return
	names=$(printf '%s\n' "$json" | jq -r '.[].name') || return
	for name in $names; do
		token "$name"
		case $name in eDP-*|LVDS-*) scale=1.3 ;; *) scale=1 ;; esac
		display_command "output $name enable scale $scale" || return
	done
}
display_restore() { display_apply "$1" "${2:-}" || display_defaults; }
display_save() (
	noargs "$@"
	display_lock
	json=$(display_json) || return
	key=$(printf '%s\n' "$json" | display_key) || exit 1
	run mkdir -p "$profiles" || exit 1
	file=$(mktemp "$profiles/.profile.XXXXXX") || exit 1
	trap 'rm -f "$file"' 0
	trap 'exit 1' HUP INT TERM
	printf '%s\n' "$json" | display_snapshot >"$file" && run mv -f "$file" "$profiles/$key.json" || exit 1
	# Retire the old connector-based startup file after the new profile is saved.
	run rm -f "$HOME/.config/sway/config.d/outputs" || exit 1
	echo 'Saved for this monitor set, at login and on dock/undock.'
)
display_reset() (
	noargs "$@"; display_lock
	json=$(display_json) || exit 1
	key=$(printf '%s\n' "$json" | display_key) || exit 1
	# Only this set's profile: a hand-written outputs file stays until the first save.
	[ -f "$profiles/$key.json" ] || { echo 'No profile saved for this monitor set.'; exit 0; }
	run rm -f "$profiles/$key.json" || exit 1
	echo 'Profile removed for this monitor set; the live layout is unchanged.'
)
display_watch() (
	noargs "$@"; sway; path "${XDG_RUNTIME_DIR:-}"
	exec 8>"$XDG_RUNTIME_DIR/convergent-display-watch.lock"
	flock -n 8 || exit 0
	# Sway's initial tick, sent after subscribing, closes the login/hotplug race.
	swaymsg -m -r -t subscribe '["output","tick"]' | (
		previous=
		while IFS= read -r event; do
			next=$(
				display_lock
				json=$(display_json) || exit 1
				key=$(printf '%s\n' "$json" | display_key) || exit 1
				# Connector changes trigger remapping too; layout changes do not.
				stamp=$(printf '%s\n' "$json" | jq -c 'sort_by(.name) | map([.name,.make,.model,.serial])') || exit 1
				if [ "$stamp" != "$previous" ]; then
					if [ -f "$profiles/$key.json" ]; then display_restore "$profiles/$key.json"
					elif [ ! -f "$HOME/.config/sway/config.d/outputs" ]; then display_defaults; fi || exit 1
				fi
				printf '%s\n' "$stamp"
			) || continue
			previous=$next
		done
	)
)
