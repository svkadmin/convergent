title=USB
actions='status	List blocked USB and Thunderbolt devices	root
allow	Allow USB number or Thunderbolt ID	root'

usb_state() { echo 'USB / Thunderbolt'; }
usb_status() { noargs "$@"; page run sudo /usr/local/sbin/devices list; }
usb_allow() {
	onearg 'USB number or Thunderbolt ID' "$@"
	case $answer in
	''|*[!0-9]*)
		printf '%s\n' "$answer" | grep -Eq '^[[:xdigit:]]{8}(-[[:xdigit:]]{4}){3}-[[:xdigit:]]{12}$' || die 'invalid Thunderbolt ID'
		run sudo /usr/local/sbin/devices allow tb "$answer" ;;
	*)
		number "$answer"
		run sudo /usr/local/sbin/devices allow "$answer" ;;
	esac
}
