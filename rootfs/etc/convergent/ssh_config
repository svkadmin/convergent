# ARCHITECTURE 3.2, 3.3, 4.2
# Pin host keys by the aliases below.
Host fw1 fw2 wan
	User root
	IdentityFile /var/lib/convergent/ssh/id_ed25519
	IdentitiesOnly yes
	UserKnownHostsFile /var/lib/convergent/ssh/known_hosts
	GlobalKnownHostsFile /dev/null
	StrictHostKeyChecking yes
	HashKnownHosts no
	HostKeyAlgorithms ssh-ed25519
	PasswordAuthentication no
	KbdInteractiveAuthentication no
	BatchMode yes
	# Callers bound their calls (timeout, mostly 10-30 s); these must not cut first. ConnectTimeout also
	# bounds the banner and key exchange: half the common 30 s. A silent server ends after ~30 s.
	# Writers with longer bounds pass their own (tools/guests, dns-push, update.sh).
	ConnectTimeout 15
	ServerAliveInterval 10
	ServerAliveCountMax 3
	ForwardAgent no
	ForwardX11 no
	# One connection per guest for a minute: the per-minute status checks would otherwise fill pf's
	# 100 states per source for host SSH. tools/guests turns this off: it replaces guests.
	ControlMaster auto
	ControlPath /run/ssh-%C
	ControlPersist 60
	LogLevel ERROR

Host fw1
	HostName 100.80.1.2
	HostKeyAlias fw1

Host fw2
	HostName 100.80.1.3
	HostKeyAlias fw2

Host wan
	HostName 100.80.0.10
	HostKeyAlias wan
