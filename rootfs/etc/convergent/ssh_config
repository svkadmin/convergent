# ARCHITECTURE 3.2, 3.3, 4.2
# Pin host keys by the aliases below.
Host fw1 fw2 wan
	User root
	IdentityFile /var/lib/convergent/ssh/id_ed25519
	IdentitiesOnly yes
	UserKnownHostsFile /var/lib/convergent/ssh/known_hosts
	GlobalKnownHostsFile /dev/null
	StrictHostKeyChecking yes
	HashKnownHosts no
	HostKeyAlgorithms ssh-ed25519
	PasswordAuthentication no
	KbdInteractiveAuthentication no
	BatchMode yes
	ConnectTimeout 5
	ServerAliveInterval 5
	ServerAliveCountMax 2
	ForwardAgent no
	ForwardX11 no
	ControlMaster no
	LogLevel ERROR

Host fw1
	HostName 100.80.1.2
	HostKeyAlias fw1

Host fw2
	HostName 100.80.1.3
	HostKeyAlias fw2

Host wan
	HostName 100.80.0.10
	HostKeyAlias wan
