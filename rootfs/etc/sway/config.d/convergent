# ARCHITECTURE 9; the stock /etc/sway/config includes this directory last, so lines here win.
# Stock Sway on black: the background and the bar, nothing else restyled.
output * bg #000000 solid_color

# Bar: tools/bar speaks the i3bar protocol with pango markup and click events.
bar bar-0 {
    status_command /usr/local/sbin/bar
    colors {
        background #000000
    }
}

# Launcher picker: a centred box in wmenu's stock colours.
set $menu_colors --tb "#005577" --tf "#eeeeee" --fb "#222222" --ff "#bbbbbb" --nb "#222222" --nf "#bbbbbb" --ab "#222222" --af "#bbbbbb" --hb "#005577" --hf "#eeeeee" -c -W 0.4 -B 2 --bdr "#005577"
set $pick bemenu -i -l 15 $menu_colors
unbindsym Mod4+d
bindsym Mod4+d exec apps -i -l 15 $menu_colors
bindsym Mod4+m exec foot -T sys -e sys
# One sys action by name, run in its own terminal.
unbindsym Mod4+a
bindsym Mod4+a exec sh -c 'a=$(sys --pick | $pick -p action | cut -f1) && [ -n "$a" ] && sys --pick "$a"'

# Browser keys.
# A failed start says why instead of vanishing: the launcher's reason, not the logs it prints after.
unbindsym Mod4+b
for_window [sandbox_engine="^convergent$"] title_format "[browser] %title"
for_window [sandbox_engine="^convergent$" sandbox_app_id="^def$" sandbox_instance_id="^def$"] title_format "[def] %title"
for_window [sandbox_engine="^convergent$" sandbox_app_id="^tmp$" sandbox_instance_id="^tmp-([2-9][0-9]|portal)$"] title_format "[tmp] %title"
for_window [sandbox_engine="^convergent$" sandbox_app_id="^int$" sandbox_instance_id="^int$"] title_format "[int] %title"
bindsym Mod4+b exec sh -c 'l=$(mktemp "$XDG_RUNTIME_DIR/browser-def.XXXXXX.log") || exit 1; browser def 2>"$l" || swaynag -t warning -m "$(grep "^browser: " "$l" | tail -n 1 | grep . || tail -n 1 "$l" | grep . || echo browser def failed)"'
bindsym Mod4+Shift+t exec sh -c 'l=$(mktemp "$XDG_RUNTIME_DIR/browser-tmp.XXXXXX.log") || exit 1; browser tmp 2>"$l" || swaynag -t warning -m "$(grep "^browser: " "$l" | tail -n 1 | grep . || tail -n 1 "$l" | grep . || echo browser tmp failed)"'

# Brightness keys: the stock bindings call brightnessctl, which Gentoo does not have.
unbindsym --locked XF86MonBrightnessDown
unbindsym --locked XF86MonBrightnessUp
bindsym --locked XF86MonBrightnessDown exec sys display bright -5
bindsym --locked XF86MonBrightnessUp exec sys display bright +5

# Lock now; after 10 minutes idle unless the bar's NL holds it off (nolock file); lid close.
# No before-sleep: without logind swayidle exits on it.
bindsym Mod4+Escape exec swaylock -f
# A minute after locking the screen goes dark; any input wakes it (NL keeps it on too).
exec swayidle -w timeout 600 '[ -e "$XDG_RUNTIME_DIR/nolock" ] || swaylock -f' timeout 660 '[ -e "$XDG_RUNTIME_DIR/nolock" ] || swaymsg "output * power off"' resume 'swaymsg "output * power on"'
bindswitch --locked lid:on exec swaylock -f
mode "resize" {
    bindsym Mod4+Escape exec swaylock -f
    bindswitch --locked lid:on exec swaylock -f
}

# Screenshots saved and copied: an area, or the focused output.
# Escape in slurp leaves the clipboard alone.
unbindsym Print
bindsym Print exec sys screenshot area
bindsym Shift+Print exec sys screenshot screen

# The stock volume keys call pactl, which is not installed; wpctl comes with WirePlumber.
unbindsym --locked XF86AudioMute
unbindsym --locked XF86AudioLowerVolume
unbindsym --locked XF86AudioRaiseVolume
unbindsym --locked XF86AudioMicMute
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
# Sway prefers the unlocked binding when unlocked; the locked binding can only mute.
bindsym XF86AudioMicMute exec sys audio micmute
bindsym --locked XF86AudioMicMute exec sys audio mic off

# Session services: audio (Gentoo's launcher starts WirePlumber once PipeWire is up), notifications.
exec gentoo-pipewire-launcher
# Wait for WirePlumber's default source; run once per login, not on config reload.
# No source after about two minutes (none yet, or no audio hardware): logged once, then polled every 30 s
# for the session, so a late headset still starts muted.
exec sh -c 'n=0; while [ -S "$SWAYSOCK" ]; do timeout -k 1 2 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 && break; n=$((n + 1)); if [ "$n" -lt 120 ]; then sleep 1; else [ "$n" -gt 120 ] || logger -t sway "no default audio source after $n attempts; still trying every 30 s"; sleep 30; fi; done'
# Stock look; an owner config in ~/.config/mako applies on its own.
exec mako
# DMZ-Black cursors: without a theme Sway falls back to bare built-in shapes (a blob for the link hand).
seat * xcursor_theme DMZ-Black 24

# The owner's settings: sys display save, keyboard set and touchpad set.
input type:keyboard xkb_layout "us"
input type:keyboard xkb_variant ""
input type:touchpad accel_profile adaptive
input type:touchpad pointer_accel 1
input type:touchpad scroll_factor 3
include ~/.config/sway/config.d/*

# One subscriber per session; profiles follow monitor identities across connector changes.
exec sys display watch

for_window [sandbox_engine="^convergent$" sandbox_app_id="^remmina$" sandbox_instance_id="^remmina$"] title_format "[remote] %title"
