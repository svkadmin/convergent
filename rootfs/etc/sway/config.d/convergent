# ARCHITECTURE 9; the stock /etc/sway/config includes this directory last, so lines here win.
# Stock Sway on black: the background and the bar, nothing else restyled.
output * bg #000000 solid_color

# Bar: tools/bar speaks the i3bar protocol with pango markup and click events.
bar bar-0 {
    status_command /usr/local/sbin/bar
    colors {
        background #000000
    }
}

# Launcher and the sys tool; wmenu's stock colours, which the stock config's launcher has.
set $menu_colors --tb "#005577" --tf "#eeeeee" --fb "#222222" --ff "#bbbbbb" --nb "#222222" --nf "#bbbbbb" --ab "#222222" --af "#bbbbbb" --hb "#005577" --hf "#eeeeee"
set $pick bemenu -i -l 15 $menu_colors
unbindsym Mod4+d
bindsym Mod4+d exec apps -i -l 15 $menu_colors
bindsym Mod4+m exec foot -T sys -e sys
# One sys action by name, run in its own terminal.
unbindsym Mod4+a
bindsym Mod4+a exec sh -c 'a=$(sys --pick | $pick -p action | cut -f1) && [ -n "$a" ] && sys --pick "$a"'

# Browsers (Archer's keys).
# A failed start says why instead of vanishing: the launcher's reason, not the logs it prints after.
unbindsym Mod4+b
bindsym Mod4+b exec sh -c 'l=$XDG_RUNTIME_DIR/browser.log; browser web 2>"$l" || swaynag -t warning -m "$(grep "^browser: " "$l" | tail -n 1 | grep . || tail -n 1 "$l" | grep . || echo browser web failed)"'
bindsym Mod4+Shift+t exec sh -c 'l=$XDG_RUNTIME_DIR/browser.log; browser tmp 2>"$l" || swaynag -t warning -m "$(grep "^browser: " "$l" | tail -n 1 | grep . || tail -n 1 "$l" | grep . || echo browser tmp failed)"'

# Brightness keys: the stock bindings call brightnessctl, which Gentoo does not have.
unbindsym --locked XF86MonBrightnessDown
unbindsym --locked XF86MonBrightnessUp
bindsym --locked XF86MonBrightnessDown exec sys display bright -5
bindsym --locked XF86MonBrightnessUp exec sys display bright +5

# Lock now; after 10 minutes idle unless the bar's NL holds it off (nolock file); lid close.
# No before-sleep: without logind swayidle exits on it.
bindsym Mod4+Escape exec swaylock -f
# A minute after locking the screen goes dark; any input wakes it (NL keeps it on too).
exec swayidle -w timeout 600 '[ -e "$XDG_RUNTIME_DIR/nolock" ] || swaylock -f' timeout 660 '[ -e "$XDG_RUNTIME_DIR/nolock" ] || swaymsg "output * power off"' resume 'swaymsg "output * power on"'
bindswitch --locked lid:on exec swaylock -f

# Screenshots to the clipboard: an area, or the focused output.
# Escape in slurp leaves the clipboard alone.
unbindsym Print
bindsym Print exec sh -c 'g=$(slurp) && grim -g "$g" - | wl-copy -t image/png'
bindsym Shift+Print exec sh -c 'grim -o "$(swaymsg -t get_outputs | jq -r ".[] | select(.focused).name")" - | wl-copy -t image/png'

# The stock volume keys call pactl, which is not installed; wpctl comes with WirePlumber.
unbindsym --locked XF86AudioMute
unbindsym --locked XF86AudioLowerVolume
unbindsym --locked XF86AudioRaiseVolume
unbindsym --locked XF86AudioMicMute
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Session services: audio (Gentoo's launcher starts WirePlumber once PipeWire is up), notifications.
exec gentoo-pipewire-launcher
# Stock look; an owner config in ~/.config/mako applies on its own.
exec mako

# The owner's own settings, written by `sys display save` and `sys keyboard set`.
input type:keyboard xkb_layout "us"
input type:keyboard xkb_variant ""
include ~/.config/sway/config.d/*

# One subscriber per session; profiles follow monitor identities across connector changes.
exec sys display watch
