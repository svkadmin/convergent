# ARCHITECTURE 9; the stock /etc/sway/config includes this directory last.
# Reconfigures the stock bar-0 (or creates it) and binds the menu.
bar bar-0 {
    position top
    status_command /usr/local/sbin/bar
}
bindsym Mod4+m exec /usr/local/sbin/menu
exec pipewire
exec wireplumber
exec pipewire-pulse
exec swayidle -w timeout 600 'swaylock -f' before-sleep 'swaylock -f'
bindswitch --locked lid:on exec swaylock -f
