# ARCHITECTURE 9; the stock /etc/sway/config includes this directory last.
# Reconfigures the stock bar-0 (or creates it) and binds the menu.
bar bar-0 {
    position top
    status_command /usr/local/sbin/bar
}
bindsym Mod4+m exec /usr/local/sbin/menu
# The stock volume keys call pactl, which is not installed; wpctl comes with WirePlumber.
unbindsym --locked XF86AudioMute
unbindsym --locked XF86AudioLowerVolume
unbindsym --locked XF86AudioRaiseVolume
unbindsym --locked XF86AudioMicMute
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
# Gentoo's launcher starts WirePlumber and pipewire-pulse once PipeWire is up.
exec gentoo-pipewire-launcher
exec swayidle -w timeout 600 'swaylock -f' before-sleep 'swaylock -f'
bindswitch --locked lid:on exec swaylock -f
