abi <abi/3.0>,
include <tunables/global>

profile bluetoothd /usr/{bin,sbin,libexec/bluetooth,lib/bluetooth,lib64/bluetooth}/bluetoothd {
  include <abstractions/base>
  include <abstractions/dbus-strict>

  capability net_admin,
  # Standard Bluetooth service PSMs require privileged binds.
  capability net_bind_service,
  capability net_raw,
  # HCI management, L2CAP, RFCOMM and SCO for input and audio.
  network bluetooth raw,
  network bluetooth seqpacket,
  network bluetooth stream,
  network netlink raw,

  dbus bind bus=system name=org.bluez,
  dbus (send, receive) bus=system interface=org.bluez.*,
  dbus (send, receive) bus=system interface=org.freedesktop.DBus.{ObjectManager,Properties,Introspectable,Peer},
  dbus send bus=system peer=(name=org.freedesktop.hostname1),

  /usr/{bin,sbin,libexec/bluetooth,lib/bluetooth,lib64/bluetooth}/bluetoothd mr,
  /etc/bluetooth/{,*.conf} r,
  /etc/machine-info r,
  /proc/sys/kernel/hostname r,
  /var/lib/bluetooth/ rw,
  /var/lib/bluetooth/** rw,
  /run/sdp rw,
  /dev/rfkill rw,
  /dev/uhid rw,
  /sys/class/bluetooth/{,**} r,
  /sys/devices/**/bluetooth/{,**} r,
  /run/udev/data/{+bluetooth:*,c[0-9]*:[0-9]*} r,
}
