abi <abi/3.0>,
include <tunables/global>

# complain until the laptop runs clean (denials show in sys security events); then enforce.
profile way-secure /usr/bin/way-secure flags=(complain) {
  include <abstractions/base>

  /usr/bin/way-secure mr,
  owner /run/user/[0-9]*/wayland-[0-9]* rw,
  # tools/browser gives the listener to Sway through security-context-v1.
  owner /run/convergent/browser/{def,int,remmina,tmp-portal,tmp-[2-9][0-9]}/sockets/wayland-0 rw,
  /run/convergent/browser/{def,int,remmina,tmp-portal,tmp-[2-9][0-9]}/wayland.log w,
}
