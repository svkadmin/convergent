abi <abi/4.0>,
include <tunables/global>

profile chronyd /usr/{bin,sbin}/chronyd {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  capability chown,
  capability setuid,
  capability setgid,
  capability net_bind_service,
  capability sys_time,

  network inet dgram,
  network inet6 dgram,
  # NTS key exchange.
  network inet stream,
  network inet6 stream,

  /usr/{bin,sbin}/chronyd mr,
  /etc/chrony/chrony.{conf,keys} r,
  /dev/rtc{,[0-9]*} rw,
  /run/chrony/ rw,
  /run/chrony/chronyd.{pid,sock} rw,
  /run/chronyd.pid rw,
  /var/lib/chrony/ rw,
  /var/lib/chrony/{drift,*.nts,*.tmp,ntskeys} rw,
}
