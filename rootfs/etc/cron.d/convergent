# ARCHITECTURE 12; auto retries overdue work hourly.
MAILTO=""
PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
@reboot root facts boot
@reboot root power
17 * * * * root facts auto
# cronie's 0anacron skips the daily jobs on battery: rotation must not depend on being plugged in at :01.
23 * * * * root umask 077; /usr/bin/logrotate /etc/logrotate.conf
* * * * * root facts nts
* * * * * root observe
42 * * * * root dns-push auto
* * * * * root [ -e /run/convergent/portal ] && portal expire
* * * * * root check auto
* * * * * root check status
