# The host's own log files; syslog-ng's messages file has the package's rule.
/var/log/sudo.log /var/log/guests-setup.log /var/log/guests-update.log {
	weekly
	rotate 4
	compress
	missingok
	notifempty
}
# Incus appends up to the 1 MiB console ring to console.log on every read and rotates it only at VM start.
/var/log/incus/*/console.log {
	size 4M
	rotate 1
	compress
	copytruncate
	missingok
	notifempty
}
