# The host's own log files; syslog-ng's messages file has the package's rule.
# Writers keep them open for a whole guests run: a rename would send the rest of that run to a deleted file.
/var/log/sudo.log /var/log/guests-setup.log /var/log/guests-update.log {
	weekly
	copytruncate
	rotate 4
	compress
	missingok
	notifempty
}
# The Incus package ships no rule; incusd keeps its log open.
/var/log/incus/incusd.log {
	weekly
	rotate 4
	compress
	copytruncate
	missingok
	notifempty
}
# Incus appends up to the 1 MiB console ring to console.log on every read and rotates it only at VM start.
/var/log/incus/*/console.log {
	size 4M
	rotate 1
	compress
	copytruncate
	missingok
	notifempty
}
