#!/sbin/openrc-run
# Create guests once, or apply downloaded guests after the host is marked good.

description="Creates guests or applies downloaded guest updates"

depend() {
	# Not need: guests init stops and starts Incus, which would stop this service too.
	use incus
	after incus
}

start() {
	src=/var/lib/convergent/release-guests
	st=/run/convergent/status
	if [ -e /var/lib/convergent/guests/initialized ]; then
		release=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^convergent\.release=//p')
		case $release in ''|*[!0-9]*) return 0 ;; esac
		[ -d "/var/lib/convergent/guest-updates/$release" ] || return 0
		[ ! -e /run/convergent/guests-update-started ] || return 0
		ebegin "Updating downloaded guests in the background; the bar shows GUESTS until done"
		mkdir -p "$st"
		(umask 077; touch /run/convergent/guests-update-started)
		echo running >"$st/guests-update"
		nohup sh -c '
			n=0
			until [ -e /run/openrc/started/convergent-bless ]; do
				[ $((n += 1)) -le 360 ] || { echo failed >"$1/guests-update"; exit 1; }
				sleep 5
			done
			umask 077
			/usr/local/sbin/guests apply >>/var/log/guests-update.log 2>&1 || echo failed >"$1/guests-update"' sh "$st" </dev/null >/dev/null 2>&1 &
		eend 0
		return 0
	fi
	[ ! -e /var/lib/convergent/guests/initialized ] && [ -d "$src/guests" ] || return 0
	ebegin "Creating the guests in the background; the bar shows SETUP until done"
	mkdir -p "$st"
	echo running >"$st/setup"
	# After the release is marked good (30 min at most); a second try resumes where the first stopped.
	nohup sh -c '
		n=0
		until [ -e /run/openrc/started/convergent-bless ]; do
			[ $((n += 1)) -le 360 ] || { echo failed >"$2/setup"; exit 1; }
			sleep 5
		done
		for try in 1 2; do
			/usr/local/sbin/guests init "$1" >>/var/log/guests-setup.log 2>&1 && { echo done >"$2/setup"; exit 0; }
		done
		echo failed >"$2/setup"' sh "$src" "$st" </dev/null >/dev/null 2>&1 &
	eend 0
}
