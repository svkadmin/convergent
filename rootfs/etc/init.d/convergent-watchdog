#!/sbin/openrc-run
# ARCHITECTURE 5.2; bless disarms, deadline leaves watchdog armed.

description="Feeds the hardware watchdog until the boot is blessed"
command=/bin/sh
pidfile=/run/convergent-watchdog.pid

# 20 feeds, 30 s apart: ten minutes from the start of this service.
loop='
s=
trap "printf V >&3; kill \$s 2>/dev/null; exit 0" TERM
n=0
while [ "$n" -lt 20 ]; do
	printf . >&3
	sleep 30 & s=$!
	wait "$s"
	n=$((n + 1))
done
logger -t convergent-watchdog "no bless within ten minutes, the watchdog is left to reset the board"
'

depend() {
	after devfs
}

start() {
	ebegin "Feeding the watchdog"
	if [ ! -c /dev/watchdog ] || ! command exec 3>/dev/watchdog; then
		logger -t convergent-watchdog "cannot open /dev/watchdog; continuing without a watchdog"
		ewarn "No usable hardware watchdog"
		return 0
	fi
	nohup "$command" -c "$loop" </dev/null >/dev/null 2>&1 &
	printf '%s\n' "$!" >"$pidfile"
	exec 3>&-
	eend 0
}

stop() {
	# No --oknodo: in OpenRC it reports failure when the feeder exits during the retry.
	start-stop-daemon --stop --quiet --retry TERM/5 --pidfile "$pidfile"
}
