#!/sbin/openrc-run
# ARCHITECTURE 4.4; Incus owns the bridges.
description="The host's network before Incus: loopback and the host firewall"

depend() {
	need loopback convergent-firewall
	provide net
}

start() {
	# A failed bind leaves the card powered, not the host without Incus.
	/bin/sh /usr/lib/convergent/incus/host-net nvidia || ewarn "NVIDIA functions not on vfio-pci; see /var/log/messages"
	nohup /bin/sh /usr/lib/convergent/incus/host-net </dev/null >/dev/null 2>&1 &
}

stop() {
	return 0
}
