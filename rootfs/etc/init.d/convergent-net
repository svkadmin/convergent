#!/sbin/openrc-run
# ARCHITECTURE 4.4; Incus owns the bridges.
description="The host's network before Incus: loopback and the host firewall"

depend() {
	need loopback convergent-firewall
	provide net
}

start() {
	start-stop-daemon --start --background --make-pidfile --pidfile /run/convergent-net.pid \
		--exec /bin/sh -- /usr/lib/convergent/incus/host-net
}
