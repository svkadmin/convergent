#!/sbin/openrc-run
# Convergent: once the default runlevel is up, marks the booted slot good if it is healthy
# (tools/slot, ARCHITECTURE section 7.2, step 5). Runs once per boot and exits.

description="Marks the booted release good after the health checks"

depend() {
	need localmount
	after *
}

start() {
	ebegin "Checking the booted release"
	/usr/local/sbin/slot bless
	eend $?
}
