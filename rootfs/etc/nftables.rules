#!/usr/sbin/nft -f
# ARCHITECTURE 4.2, 4.4
# Replace only inet host; preserve Incus tables.
table inet host
delete table inet host

table inet host {
	chain input {
		type filter hook input priority filter; policy drop;
		iif lo accept
		ct state invalid drop
		ct state established,related accept
		iifname != "host" drop
		ip saddr { 100.80.1.2, 100.80.1.3 } udp dport 123 accept       comment "fw1, fw2: time"
		ip saddr 100.80.2.10 tcp dport { 9100, 8444 } ct state new accept comment "svc: metrics"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
}
