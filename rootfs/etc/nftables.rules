#!/usr/sbin/nft -f
# ARCHITECTURE 4.2, 4.4
# Replace only inet host; preserve Incus tables.
table inet host
delete table inet host

table inet host {
	chain input {
		type filter hook input priority filter; policy drop;
		iif lo accept
		ct state invalid drop
		ct state established,related accept
		iifname != "host" drop
		ip saddr { 100.80.1.2, 100.80.1.3 } udp dport 123 accept       comment "fw1, fw2: time"
		ip saddr 100.80.2.10 tcp dport { 9100, 8444 } ct state new accept comment "svc: metrics"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
}

# No IPv6 on any bridge: guests cannot reach each other over IPv6 past the firewalls.
table bridge host-l2
delete table bridge host-l2

table bridge host-l2 {
	chain work_gate { drop; }
	set work_infra { type ipv4_addr; elements = { @WORK_INFRA@ }; }
	chain forward {
		type filter hook forward priority filter; policy accept;
		ibrname "work" iifname != { "fw1work", "fw2work" } jump work_gate
		obrname "work" oifname != { "fw1work", "fw2work" } jump work_gate
		ether type ip6 drop
		ether type vlan vlan type ip6 drop
		ether type 8021ad drop
		ibrname "work" ether type vlan vlan type vlan drop
		ibrname "work" ether type vlan vlan type 8021ad drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ip saddr @work_infra drop
		ibrname "work" iifname != { "fw1work", "fw2work" } arp saddr ip @work_infra drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ip protocol 112 drop
		ibrname "work" iifname != { "fw1work", "fw2work" } udp sport 67 drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ether type vlan vlan type ip ip saddr @work_infra drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ether type vlan vlan type arp arp saddr ip @work_infra drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ether type vlan vlan type ip ip protocol 112 drop
		ibrname "work" iifname != { "fw1work", "fw2work" } ether type vlan vlan type ip udp sport 67 drop
	}
}
